            sgpl:text_context "kleine watersport Biesbosch. grote watersport Hindeloopen/Stavoren. Combinaties Terschelling/Texel." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749336 ;
            sgpl:spatialText "Oostvaardersplassen" ;
            sgpl:text_context "Op bovenstaande wijze is tabel 3.1 tot stand gekomen. tabel 3.1 Overzicht case-gebieden Natuurtoerisme: Oostvaardersplassen. Hoevetoerisme: Beilen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745663 ;
            sgpl:spatialText "Veluwemeer" ;
            sgpl:text_context "vissen Nieuwkoopse Plassen. zwemmen Veluwemeer. kleine watersport Biesbosch." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746414 ;
            sgpl:spatialText "Terschelling" ;
            sgpl:text_context "grote watersport Hindeloopen/Stavoren. Combinaties Terschelling/Texel. HOOFDSTUK 4 DE ECONOMISCHE BETEKENIS VAN PLATTELANDSTOERISME." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept682 ;
            sgpl:subjectText "werkgelegenheid" ;
            sgpl:text_context "Juist in de werkgelegenheid wordt de economische en sociale indicator gevonden waarin het belang van de toeristisch-recreatieve sector sterk tot uitdrukking komt (ten aanzien van inkomensvorming en creatie van banen). Voor het empirische deel van \"probleemstelling c\" wordt de bijdrage van plattelandstoerisme aan plattelandsontwikkeling daarom beperkt tot de bijdrage aan de werkgelegenheid. Om de werkgelegenheid te bepalen is in plaats van de vraagzijdebenadering gebruik gemaakt van de aanbodzijdebenadering." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "plattelandstoerisme" ;
            sgpl:text_context "Hierin heb ik mij gespecialiseerd op het gebied van Stads- en plattelandsgeografie. In mijn doctoraalscriptie heb ik beide disciplines gecombineerd door de rol van plattelandstoerisme in plattelandsontwikkeling te bestuderen. Mijn begeleiding heb ik ontvangen van professor P.P.P. Huigen en dr. F. van Dam." ],
        [ sgpl:refersToConcept unesco:concept446 ;
            sgpl:subjectText "plattelandsontwikkeling" ;
            sgpl:text_context "In deze gebieden wordt gewerkt aan de opstelling van op uitvoering gerichte Regionale Ontwikkelingsplannen (ROP’s). De aanleiding tot onderhavig onderzoek is dat in deze plannen voor plattelandsontwikkeling een grote rol wordt weggelegd voor plattelandstoerisme. In de aandachtsgebieden wordt het zoeken naar nieuwe perspectieven in de sfeer van werkgelegenheid sterk centraal gesteld." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "plattelandstoerisme" ;
            sgpl:text_context "Hierin heb ik mij gespecialiseerd op het gebied van Stads- en plattelandsgeografie. In mijn doctoraalscriptie heb ik beide disciplines gecombineerd door de rol van plattelandstoerisme in plattelandsontwikkeling te bestuderen. Mijn begeleiding heb ik ontvangen van professor P.P.P. Huigen en dr. F. van Dam." ],
        [ sgpl:refersToConcept unesco:concept446 ;
            sgpl:subjectText "plattelandsontwikkeling" ;
            sgpl:text_context "In deze gebieden wordt gewerkt aan de opstelling van op uitvoering gerichte Regionale Ontwikkelingsplannen (ROP’s). De aanleiding tot onderhavig onderzoek is dat in deze plannen voor plattelandsontwikkeling een grote rol wordt weggelegd voor plattelandstoerisme. In de aandachtsgebieden wordt het zoeken naar nieuwe perspectieven in de sfeer van werkgelegenheid sterk centraal gesteld." ],
        [ sgpl:refersToConcept unesco:concept682 ;
            sgpl:subjectText "werkgelegenheid" ;
            sgpl:text_context "Juist in de werkgelegenheid wordt de economische en sociale indicator gevonden waarin het belang van de toeristisch-recreatieve sector sterk tot uitdrukking komt (ten aanzien van inkomensvorming en creatie van banen). Voor het empirische deel van \"probleemstelling c\" wordt de bijdrage van plattelandstoerisme aan plattelandsontwikkeling daarom beperkt tot de bijdrage aan de werkgelegenheid. Om de werkgelegenheid te bepalen is in plaats van de vraagzijdebenadering gebruik gemaakt van de aanbodzijdebenadering." ] ;
    sgpl:thesisID 310 .

