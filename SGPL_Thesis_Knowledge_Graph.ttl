        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751316 ;
            sgpl:spatialText "Gemeente Maarssen" ;
            sgpl:text_context "Hierbij wil ik de onderstaande personen bedanken voor de beschik- baar gestelde informatie en tijd: Gemeente Houten. Gemeente Maarssen. Gemeente Nieuwegein." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept15295 ;
            sgpl:subjectText "lokatiebeleid" ;
            sgpl:text_context "In deze nota's wordt ingegaan op de noodzaak tot beperking van de groei van de automobiliteit. Vanuit de ruimtelijke ordening wordt als instrument het lokatiebeleid naar voren gedragen: bereiken dat bedrijvigheid met een hoog potentieel OV-gebruik van werknemers en bezoekers zich vestigt op lokaties die goed met het OV ontsloten zijn. Bij lokaties die goed met de auto bereikbaar zijn ligt de nadruk op het weren van arbeidsintensieve werkgelegenheid en het stimuleren van extensieve bedrijvigheid (zoals transport en opslag)." ],
        [ sgpl:refersToConcept unesco:concept17185 ;
            sgpl:subjectText "bereikbaarheidsprofiel" ;
            sgpl:text_context "Deze twee recente publikaties zijn de aanleiding geweest tot het starten van deze scriptie. Het bereikbaarheidsprofiel van een lokatie geeft de kwaliteit aan van de bereikbaarheid per openbaar vervoer en auto. Het is een weergave van de nabijheid van NS-stations en andere haltes van het openbaar vervoer, de ligging ten opzichte van belangrijke verkeersaders en de parkeerbeperkingen." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "mobiliteitsprofiel" ;
            sgpl:text_context "Het is een weergave van de nabijheid van NS-stations en andere haltes van het openbaar vervoer, de ligging ten opzichte van belangrijke verkeersaders en de parkeerbeperkingen. Het mobiliteitsprofiel is een weergave van de eigenschappen van bedrijven en voorzieningen die van belang zijn voor verkeer en vervoer, zowel van mensen als van goederen. Het is de tegenhanger van het bereikbaarheidsprofiel; ze verhouden zich tot elkaar als vraag en aanbod." ],
        [ sgpl:refersToConcept unesco:concept17185 ;
            sgpl:subjectText "bereikbaarheidsprofiel" ;
            sgpl:text_context "Deze twee recente publikaties zijn de aanleiding geweest tot het starten van deze scriptie. Het bereikbaarheidsprofiel van een lokatie geeft de kwaliteit aan van de bereikbaarheid per openbaar vervoer en auto. Het is een weergave van de nabijheid van NS-stations en andere haltes van het openbaar vervoer, de ligging ten opzichte van belangrijke verkeersaders en de parkeerbeperkingen." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "mobiliteitsprofiel" ;
            sgpl:text_context "Het is een weergave van de nabijheid van NS-stations en andere haltes van het openbaar vervoer, de ligging ten opzichte van belangrijke verkeersaders en de parkeerbeperkingen. Het mobiliteitsprofiel is een weergave van de eigenschappen van bedrijven en voorzieningen die van belang zijn voor verkeer en vervoer, zowel van mensen als van goederen. Het is de tegenhanger van het bereikbaarheidsprofiel; ze verhouden zich tot elkaar als vraag en aanbod." ],
        [ sgpl:refersToConcept unesco:concept15295 ;
            sgpl:subjectText "lokatiebeleid" ;
            sgpl:text_context "In deze nota's wordt ingegaan op de noodzaak tot beperking van de groei van de automobiliteit. Vanuit de ruimtelijke ordening wordt als instrument het lokatiebeleid naar voren gedragen: bereiken dat bedrijvigheid met een hoog potentieel OV-gebruik van werknemers en bezoekers zich vestigt op lokaties die goed met het OV ontsloten zijn. Bij lokaties die goed met de auto bereikbaar zijn ligt de nadruk op het weren van arbeidsintensieve werkgelegenheid en het stimuleren van extensieve bedrijvigheid (zoals transport en opslag)." ] ;
    sgpl:thesisID 247 .

sgpl:Thesis248 a sgpl:SGPLThesis ;
    dcterms:creator "ing. F.B.M. Solleveld" ;
    dcterms:issued 1992 ;
    dcterms:title "HET LOCATIEBELEID",
        "IN DE MIDDELGROTE STAD" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "doctoraalscriptie economische geografie onder begeleiding van Dr. R. Scheele Rijksuniversiteit Utrecht ing. F.B.M. Solleveld Utrecht, mei 1992." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "De Gelderse Poort" ;
            sgpl:text_context "De locaties zijn A station Arnhem en omgeving, B Rijnkade en omgeving, C Stadsblokken, D De Gelderse Poort en E Het Broek. De prioriteit wordt tussen 1991 en 1996 gelegd bij de Rijncity-locaties en de Gelderse Poort. Met name de locatie Gelderse Poort in Arnhem zuid ziet men als een belangrijke ontwikkeling, terwijl voor wat betreft het locatiebeleid er nogal vaag wordt gesproken over 'plannen voor een NS halte'." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Rijnkade en omgeving" ;
            sgpl:text_context "De in de kantorennota van de gemeente Arnhem genoemde vijf te ontwikkelen locaties zijn in het kader van deze scriptie allen op bereikbaarheid onderzocht. De locaties zijn A station Arnhem en omgeving, B Rijnkade en omgeving, C Stadsblokken, D De Gelderse Poort en E Het Broek. De prioriteit wordt tussen 1991 en 1996 gelegd bij de Rijncity-locaties en de Gelderse Poort." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759661 ;
            sgpl:spatialText "Arnhem" ;
            sgpl:text_context "De gemeente Arnhem is als case nader onderzocht, om een verdere invulling te kunnen geven aan een dergelijk model. Arnhem is gekozen omdat deze middelgrote stad buiten de Randstad voor kantorenlocaties zeer in trek is. De in de kantorennota van de gemeente Arnhem genoemde vijf te ontwikkelen locaties zijn in het kader van deze scriptie allen op bereikbaarheid onderzocht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750053,
                geonames:2759661 ;
            sgpl:spatialText "stedelijk knooppunt Arnhem-Nijmegen" ;
            sgpl:text_context "Arnhem is gekozen omdat deze middelgrote stad buiten de Randstad voor kantorenlocaties zeer in trek is. In de Atlas Stedelijke Knooppunten wordt melding gemaakt van het stedelijk knooppunt Arnhem-Nijmegen. Arnhem-Nijmegen is een voorbeeldregio voor dit OVx2-project, dat op landelijk niveau betekenis moet gaan krijgen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Stadsblokken" ;
            sgpl:text_context "De locaties zijn A station Arnhem en omgeving, B Rijnkade en omgeving, C Stadsblokken, D De Gelderse Poort en E Het Broek. C Rijnoever zuid (Stadsblokken); nader uit te werken, kleine en middelgrote kantoren. Stadsblokken ligt ten opzichte van de stations aan de 'andere kant' van de Rijn, maar hier komen veel buslijnen samen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754296 ;
            sgpl:spatialText "Het Broek" ;
            sgpl:text_context "De locaties zijn A station Arnhem en omgeving, B Rijnkade en omgeving, C Stadsblokken, D De Gelderse Poort en E Het Broek. Na 1996 komt de nadruk te liggen op Rijnoever zuid en Het Broek en ook het continueren van de eerdergenoemde locaties. Het Broek komt er voor wat betreft de fiets zeer gunstig uit, maar de bereikbaarheid per openbaar vervoer is relatief ongunstig." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De wisselwerking tussen mijn studie aan de Rijksuniversiteit Utrecht en mijn werk bij mijn vorige werkgever Zandvoort Ordening & Advies leidde tot de keuze van het onderwerp van deze scriptie. In de praktijk bleek mij dat er nog heel wat moet veranderen in kennisontwikkeling en samenwerking, voordat er in Nederland goed geïntegreerde (ruimtelijk-economisch en verkeers- en vervoerskundig) plannen effectief tot stand zullen worden gebracht. Met deze scriptie heb ik een bijdrage willen leveren aan het verbreden van het draagvlak en de verdere ontwikkeling in het denken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Door de te eenvoudige ABC-typologie, gecombineerd met te ingewikkelde en te verschillende ambtelijke soms bureaucratische interpretaties, lijkt effectiviteit van het rijksbeleid op een te laag niveau te komen. Buiten de Randstad zal juist bij deze steden veel succes behaald moeten worden. De interpretatieruimte van het beleid is in de praktijk nog ruim." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Provincie Noord-Brabant" ;
            sgpl:text_context "Het in praktijk brengen van het rijkslocatiebeleid is geen gemakkelijke aangelegenheid. De provincie Noord-Brabant bijvoorbeeld, wilt gericht gemeentelijke plannen kunnen toetsen. Bij de gemeenten zal uiteindelijk het beleid in praktijk gebracht moeten worden, in samenwerking met hogere overheden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept539 ;
            sgpl:subjectText "vervoerswijzekeuze" ;
            sgpl:text_context "Om te komen tot een voor middelgrote gemeenten hanteerbaar beleidsmodel is dit onderzoek als volgt opgebouwd. Allereerst wordt na dit hoofdstuk een theoretisch kader beschreven over vervoerswijzekeuze in het woon-werkverkeer op het niveau van het individuele gedrag. Daarbij wordt de vervoerswijzekeuze gekoppeld aan individuele beslissingen op langere termijn." ],
        [ sgpl:refersToConcept unesco:concept15295 ;
            sgpl:subjectText "locatiebeleid" ;
            sgpl:text_context "Tegelijk zullen andere maatregelen genomen moeten worden die ertoe bijdragen dat de vervoers-consument zelf deze keuze ook steeds meer gaat maken. Het locatiebeleid kan hiertoe bijdragen door het realiseren van een betere afstemming van nieuwe bedrijvenlocaties op de openbaar vervoers- en fietsinfrastructuur. Het locatiebeleid dient een duidelijke bijdrage te leveren aan de geleiding van mobiliteit door het vestigen van bedrijven met een hoge arbeidsplaatsdichtheid en/of een hoge bezoekersintensiteit op de best per openbaar vervoer en fiets bereikbare locaties." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "mobiliteitseffecten" ;
            sgpl:text_context "Locatie-beslissingen moeten op zinvolle en verantwoorde wijze worden genomen, zodanig dat het autogebruik relatief laag, en het fiets- en openbaar vervoergebruik relatief zo hoog mogelijk is. Om deze beslissingen te ondersteunen is het noodzakelijk dat mobiliteitseffecten van potentiële locaties worden bepaald. Het kan daarbij niet de bedoeling zijn om nieuwe bureaucratie in het leven te roepen die leidt tot stagnatie van economische ontwikkelingen." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "mobiliteitseffecten" ;
            sgpl:text_context "Locatie-beslissingen moeten op zinvolle en verantwoorde wijze worden genomen, zodanig dat het autogebruik relatief laag, en het fiets- en openbaar vervoergebruik relatief zo hoog mogelijk is. Om deze beslissingen te ondersteunen is het noodzakelijk dat mobiliteitseffecten van potentiële locaties worden bepaald. Het kan daarbij niet de bedoeling zijn om nieuwe bureaucratie in het leven te roepen die leidt tot stagnatie van economische ontwikkelingen." ],
        [ sgpl:refersToConcept unesco:concept539 ;
            sgpl:subjectText "vervoerswijzekeuze" ;
            sgpl:text_context "Om te komen tot een voor middelgrote gemeenten hanteerbaar beleidsmodel is dit onderzoek als volgt opgebouwd. Allereerst wordt na dit hoofdstuk een theoretisch kader beschreven over vervoerswijzekeuze in het woon-werkverkeer op het niveau van het individuele gedrag. Daarbij wordt de vervoerswijzekeuze gekoppeld aan individuele beslissingen op langere termijn." ],
        [ sgpl:refersToConcept unesco:concept15295 ;
            sgpl:subjectText "locatiebeleid" ;
            sgpl:text_context "Tegelijk zullen andere maatregelen genomen moeten worden die ertoe bijdragen dat de vervoers-consument zelf deze keuze ook steeds meer gaat maken. Het locatiebeleid kan hiertoe bijdragen door het realiseren van een betere afstemming van nieuwe bedrijvenlocaties op de openbaar vervoers- en fietsinfrastructuur. Het locatiebeleid dient een duidelijke bijdrage te leveren aan de geleiding van mobiliteit door het vestigen van bedrijven met een hoge arbeidsplaatsdichtheid en/of een hoge bezoekersintensiteit op de best per openbaar vervoer en fiets bereikbare locaties." ] ;
    sgpl:thesisID 248 .

sgpl:Thesis249 a sgpl:SGPLThesis ;
    dcterms:creator "Bart L. Vink",
        "Theo J. Stauttener" ;
    dcterms:issued 1992 ;
    dcterms:title "(en de rol en betekenis van location leaders in Frankfurt)",
        "Beslissers in een wereldstad aan de Main" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Rijn/Main-gebied" ;
            sgpl:text_context "De regio Rijn/Main strekt zich uit over meerdere deelstaten (Hessen, Rijnland-Palts en Beieren). De regio heeft een oost-west-as, waarin langs de Main de steden Mainz, Rüsselsheim, Offenbach, Hanau en Aschaffenburg als voorname produktiecentra min of meer op een lijn gesitueerd zijn, en een noord-zuid-as (Bad Homburg-Darmstadt), welke iets minder ontwikkeld is. In het midden bevindt zich het kristallisatiepunt Frankfurt met zwaartepunten ten aanzien van 'stuur-' en beslissingsfunkties." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Na veel denken en praten met verschillende personen binnen en buiten de Fakulteit der Ruimtelijke Wetenschappen over ons onderwerp van onderzoek, zijn wij eind 1990 bard aan de slag gegaan om in januari 91 naar Frankfurt te kunnen gaan. De samenwerking (in zowel Frankfurt als Utrecht) heeft öns gesterkt. Het zal dan ook naar wij hopen niet de laatste samenwerking geweest zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2810538 ;
            sgpl:spatialText "Westend" ;
            sgpl:text_context "In zijn algemeenheid hebben de banken zich dicht bij elkaar gevestigd op mooie lokaties in of dichtbij het goed bereikbare centrum en in Westend (zie fig.3.4 en 4.1). De hoofdzetel van de centrale bank komt voort uit het feit dat Frankfurt in de eerste plaats een historisch bankencentrum is met een centrale ligging. De 'Bank der deutschen Landem' was hier hier gevestigd, evenals de bi-zonale Wirtschaftsrat van de geallieerden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2905330 ;
            sgpl:spatialText "Hessen" ;
            sgpl:text_context "De stad Frankfort ligt in het zuiden van de bondsstaat Hessen, dat in 1945 zijn huidige grenzen kreeg. In het zuiden van Hessen bevindt zich een natuurlijke barrière, de Vogelsberg. Deze wordt aan de oost- en westkant door gebergten omgeven (Pletsch, 1991)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2925533 ;
            sgpl:spatialText "Frankfurt" ;
            sgpl:text_context "Een verblijf van drie maanden in Frankfurt/M bood ons o.a. de mogelijkheid bibliotheken te bezoeken en een échte indruk te krijgen van stad, regio en kontext. Ook was het mogelijk met een aantal personen van de Johann- Wolfgang-Goethe Universiteit en enkele instituten te praten en zowel banken als andere ondernemingen te enquêteren. Vele telefoontjes en bezoeken waren hiervoor nodig." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2925533 ;
            sgpl:spatialText "het centrum van Frankfurt" ;
            sgpl:text_context "Aangezien de 'marges' van vestigingsplaatsfaktoren steeds kleiner worden, gaan wensen van het moeilijk aan te trekken personeel een belangrijke rol spelen. De leefkwaliteit die een stad als Frankfurt aanbiedt, wordt meer en meer vanuit dit gezichtspunt bepaald. Als woonomgeving is vooral het Taunusgebied attraktief, al wordt langzaamaan ook het centrum van Frankfurt weer aantrekkelijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol Airport" ;
            sgpl:text_context "Samen met de luchthavens van Londen en Parijs zal Frankfurt één van de mainports van Europa worden in de visie van Schiphol en de Nederlandse overheid. Met mainport wordt bedoeld 'een belangrijk knooppunt van intercontinentale en Europese vervoersstromen' (Hereijgers en Maalderink, 1991, p.121). Met het oog op de ontwikkelingen in Zuid-Europa (Milaan, Barcelona, Madrid en andere Zuideuropese groeisteden) en de potentiële ontwikkelingen in Oost-Duitsland en Oost-Europa ligt de luchthaven Frankfurt Main geografisch gezien zeer gunstig." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "Londen" ;
            sgpl:text_context "Dit leidde tot de groei van financiële centra als bijvoorbeeld Londen, Parijs, Frankfort en Amsterdam. Bovengenoemde ontwikkelingen leid(d)en tot koncentratie van management en kapitaal in slechts enkele steden. Friedmann heeft geprobeerd de vorming van wereldsteden te analyseren aan de hand van de 'linkages' tussen urbanisatieprocessen en de wereldekonomie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Duitsland" ;
            sgpl:text_context "Hoofdstuk 2 staat in het teken van het geografische kader voor Frankfurt en Rijn/Main: Duitsland. De plaats van het land in Europa en de wereld en de interne geleding worden nader bekeken. Door intemationaliseringsprocessen en de ontwikkelingen binnen de EG krijgt een internationale vergelijking tussen regio’s hier ook een plaats." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Er is dan ook gekozen voor Duitsland en Europa als geografisch kader waarbinnen Frankfurt verder onderzocht wordt. Allereerst wordt in hoofdstuk 1 de theoretische achtergrond van het onderzoek behandeld. Hierin wordt met behulp van begrippen van Johnston en theorie van Friedmann de onderzoeksopzet gevormd en wordt het begrip location leader gedefinieerd." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7576 ;
            sgpl:subjectText "Location leaders" ;
            sgpl:text_context "Daarna wordt een specifiek op (internationale) koncentratieprocessen in steden gerichte theorie nader uitgewerkt om het theoretische kader te vervolmaken. Elementen binnen het regionaal milieu die een grote aantrekkingskracht uitoefenen, worden door Dwarkasing e.a. (1989) 'location leaders' genoemd. Als location leaders zien zij de Duitse centrale bank, de effekten-beurs, de Duitse spoorwegen en de luchthaven Frankfurt Main." ],
        [ sgpl:refersToConcept unesco:concept10861 ;
            sgpl:subjectText "Financiële sektor" ;
            sgpl:text_context "Daar kan de jaarbeurs aan toegevoegd worden. De rol van deze location leaders op de gehele ekonomische ontwikkeling van de stad Frankfurt en die op de groei van de financiële sektor in het bijzonder maakt deel uit van het onderzoek. Hoe het internationale financiële centrum in samenhang met location leaders en het regionaal milieu leidt tot de vorming van een wereldstad is het uiteindelijke doel van dit onderzoek." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Wereldstadhypothese" ;
            sgpl:text_context "Over het begrip wereldstad is al veel geschreven, echter een allesomvattende definitie is nog niet gevonden. Wel heeft Friedmann (1986) met de door hem ontwikkelde wereldstadhypothese een vorm gevonden, waardoor onderzoek naar de rol en de vorming van wereldsteden mogelijk wordt. Voordat deze hypothese wordt uitgewerkt, worden in het kort kenmerken van wereldsteden behandeld aan de hand van verschillende ideeën hierover." ],
        [ sgpl:refersToConcept unesco:concept7576 ;
            sgpl:subjectText "Location leaders" ;
            sgpl:text_context "Daarna wordt een specifiek op (internationale) koncentratieprocessen in steden gerichte theorie nader uitgewerkt om het theoretische kader te vervolmaken. Elementen binnen het regionaal milieu die een grote aantrekkingskracht uitoefenen, worden door Dwarkasing e.a. (1989) 'location leaders' genoemd. Als location leaders zien zij de Duitse centrale bank, de effekten-beurs, de Duitse spoorwegen en de luchthaven Frankfurt Main." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Wereldstadhypothese" ;
            sgpl:text_context "Over het begrip wereldstad is al veel geschreven, echter een allesomvattende definitie is nog niet gevonden. Wel heeft Friedmann (1986) met de door hem ontwikkelde wereldstadhypothese een vorm gevonden, waardoor onderzoek naar de rol en de vorming van wereldsteden mogelijk wordt. Voordat deze hypothese wordt uitgewerkt, worden in het kort kenmerken van wereldsteden behandeld aan de hand van verschillende ideeën hierover." ],
        [ sgpl:refersToConcept unesco:concept10861 ;
            sgpl:subjectText "Financiële sektor" ;
            sgpl:text_context "Daar kan de jaarbeurs aan toegevoegd worden. De rol van deze location leaders op de gehele ekonomische ontwikkeling van de stad Frankfurt en die op de groei van de financiële sektor in het bijzonder maakt deel uit van het onderzoek. Hoe het internationale financiële centrum in samenhang met location leaders en het regionaal milieu leidt tot de vorming van een wereldstad is het uiteindelijke doel van dit onderzoek." ] ;
    sgpl:thesisID 249 .

sgpl:Thesis25 a sgpl:SGPLThesis ;
    dcterms:creator "A. Damen",
        "N. Hoeberichts" ;
    dcterms:issued 1960 ;
    dcterms:title "HINZENBURG",
        "sociaal-geografische struktuuranalyse van een Hunsrückdorp." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2821164 ;
            sgpl:spatialText "Trier" ;
            sgpl:text_context "De invoering van tractoren biedt vele bedrijven de mogelijkheid hiertoe. Door de nabijheid van Trier neemt de afzetmogelijkheid voor melk nog steeds toe en de opbrengsten van de melkleveranties vormen dan ook een groeiend deel van de inkomsten uit de agrarische bedrijven. Binnen het agrarisch bedrijf wordt de positie van de veeteelt t.o.v. de akkerbouw sterker." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "West-Brabant" ;
            sgpl:text_context "Maar ook nu nog blijven de opbrengsten vergeleken bij een Westbrabants bedrijf bijvoorbeeld sterk ten achter. Ze bedragen ongeveer de helft van de opbrengsten in West-Brabant, terwijl in ons onderzoekgebied veel meer kunstmest gebruikt moet worden om het huidige resultaat te bereiken. De veeteelt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Jtrecht" ;
            sgpl:text_context "Een gebied, waarin een herorintatie plaatsvindt van de agrarische naar de industrieel-ambachtelijke sector, een proces, dat reeds zo ver gevorderd is, dat de landbouw voor de bewoners van Hinzenburg niet meer het belangrijkste middel van bestaan is. Jtrecht, 1 oktober 190.  5-z? 'meente HINZENBURG, ( Kreis Trien W.D uitsland ) 99'ng en bodem gebr uik van de percelen" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "West-Duitsland" ;
            sgpl:text_context "Rapport van het sociaal-geografisch veldv/erk, verricht te Hinzenburg, Landkreis Trier (West-Duitsland), in juli 1960 door A. Damen en N. Hoeberichts. Inhoud." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2903874 ;
            sgpl:spatialText "Hinzenburg" ;
            sgpl:text_context "Inleiding. Het dorp Hinzenburg wekt, wanneer men het binnenkomt, een agrarische indruk. Overal bemerkt men een bedrijvigheid, die voor een agrarische samenleving kenmerkend is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6554291 ;
            sgpl:spatialText "Kreis Trier" ;
            sgpl:text_context "Ook de afstand blijkt een rol te spelen. Dat de tendens om van veeras te veranderen nog niet sterk is moge ook blijken uit het feit, dat de iokstieren, die door de Kreis Trier aan de dorpen worden verhuurd, meestal Glajin-stieren zijn. Hinzenburg is in het bezit van een Glas-fokstier." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2903874 ;
            sgpl:spatialText "het grondgebied van de gemeente" ;
            sgpl:text_context "Het dorpje vlijt zich als het ware tegen de rechterdalwand - gericht naar 1t westen en zuid-westen - van een zijriviertje van de Ruwer, de Rauruwer. Het grondgebied van de gemeente ligt aldus gevat tussen een hoogte van ongeveer 280 en 450 m. Enkele delen van het betrokken gebied vertonen een vrij sterk relif." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Gustenrath" ;
            sgpl:text_context "De weduwe en de jongste dochter werken het hele jaar door in de landbouw, terwijl de oudste dochter het gehele jaar werkt op de schoenfabriek \"Romika\" te Gustenrath. Gustenrath, een dorp + 5 km. van Hinzenburg gelegen. ad 6) Landw. Nebenerwerbsbetriebe." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6554291 ;
            sgpl:spatialText "Landkreis Trier" ;
            sgpl:text_context "Rapport van het sociaal-geografisch veldv/erk, verricht te Hinzenburg, Landkreis Trier (West-Duitsland), in juli 1960 door A. Damen en N. Hoeberichts. Inhoud." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Hunsrück" ;
            sgpl:text_context "Dit is zeer duidelijk gebleken uit het veldwerk, dat in juni/juli 1960 verricht werd in 't dorpje Hinzenburg. Hinzenburg, 12 km ten z.o. van Trier gelegen, maakt deel uit van  der Duitse Middelgebergten t.w. de Hunsrck. Zijn naam dankt het dorpje, aldus de traditie, aan een laat-Middeleeuwse burcht, die bewoond werd door het adellijke geslacht Von Heinz." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2960316 ;
            sgpl:spatialText "Luxemburg" ;
            sgpl:text_context "Al de andere beroepspersonen werken buiten de gemeente, zoals blijkt uit tabel ?. Tabel 7. Overzicht van de aantallen pendelaars naar de verschillende werkgebieden en de beroepen, waarin ze werkzaam zijn. Van de 3^ pendelaars zijn 29 mannelijke personen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2821164 ;
            sgpl:spatialText "12 km ten z.o. van Trier" ;
            sgpl:text_context "Dit is zeer duidelijk gebleken uit het veldwerk, dat in juni/juli 1960 verricht werd in 't dorpje Hinzenburg. Hinzenburg, 12 km ten z.o. van Trier gelegen, maakt deel uit van  der Duitse Middelgebergten t.w. de Hunsrck. Zijn naam dankt het dorpje, aldus de traditie, aan een laat-Middeleeuwse burcht, die bewoond werd door het adellijke geslacht Von Heinz." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Schöndorf" ;
            sgpl:text_context "Bovendien oefent de vader de functie van postagentschaphouder uit. Verder behoort de enige winkel van het dorp, een dependance van een winkel in Schndorf, aan deze huishouding toe. ad 4) Teilbauernbetriebe." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2423 ;
            sgpl:subjectText "Veeteelt" ;
            sgpl:text_context "Reeds werd geduid op de rol, die de veeteelt speelt bij de leverantie van stalmest. Natuurlijk vervult de veeteelt enkele andere functies, die in het geheel van de huidige agrarische struktuur veel belangrijker zijn. Vooral sinds de sterke mechanisatie valt er in de veeteelt een verandering te bemerken." ],
        [ sgpl:refersToConcept unesco:concept3418 ;
            sgpl:subjectText "Mechanisatie" ;
            sgpl:text_context "Op de 9 overige agrarische bedrijven zijn de vrouwen dus de voornaamste arbeidskrachten. O.a. ter verlichting en versnelling van de arbeid op de agrarische bedrijven en om deze bedrijfjes toch nog te kunnen handhaven, is men sinds 1959 vooral begonnen met een waarlijk grootscheepse mechanisatie d. m. v. aanschaffing van tractoren. Was er in 1959 nog slechts een tractor in geheel Hinzenburg, per 1 juli 1960 bedroeg dit aantal reeds 6." ],
        [ sgpl:refersToConcept unesco:concept5884 ;
            sgpl:subjectText "Forensisme" ;
            sgpl:text_context "Dit pleit dan weer voor het zien van de vermelde correlatie tussen het ongeschoold zijn en het behoren tot een huishouding, die beschikt over inkomsten uit een agrarisch bedrijf. De landbouw en het forensisme, nauw mes elkaar verbonden, vormen de beide factoren, die de huidige sociaal-economische struktuur in grote mate bepalen. Eamenvattend kan men zeggen, dat het onderzoekingsgebied behoort tot een marginaal, wellicht zelfs sub-marginaal landbouwgebied." ],
        [ sgpl:refersToConcept unesco:concept2423 ;
            sgpl:subjectText "Veeteelt" ;
            sgpl:text_context "Reeds werd geduid op de rol, die de veeteelt speelt bij de leverantie van stalmest. Natuurlijk vervult de veeteelt enkele andere functies, die in het geheel van de huidige agrarische struktuur veel belangrijker zijn. Vooral sinds de sterke mechanisatie valt er in de veeteelt een verandering te bemerken." ],
        [ sgpl:refersToConcept unesco:concept5884 ;
            sgpl:subjectText "Forensisme" ;
            sgpl:text_context "Dit pleit dan weer voor het zien van de vermelde correlatie tussen het ongeschoold zijn en het behoren tot een huishouding, die beschikt over inkomsten uit een agrarisch bedrijf. De landbouw en het forensisme, nauw mes elkaar verbonden, vormen de beide factoren, die de huidige sociaal-economische struktuur in grote mate bepalen. Eamenvattend kan men zeggen, dat het onderzoekingsgebied behoort tot een marginaal, wellicht zelfs sub-marginaal landbouwgebied." ],
        [ sgpl:refersToConcept unesco:concept3418 ;
            sgpl:subjectText "Mechanisatie" ;
            sgpl:text_context "Op de 9 overige agrarische bedrijven zijn de vrouwen dus de voornaamste arbeidskrachten. O.a. ter verlichting en versnelling van de arbeid op de agrarische bedrijven en om deze bedrijfjes toch nog te kunnen handhaven, is men sinds 1959 vooral begonnen met een waarlijk grootscheepse mechanisatie d. m. v. aanschaffing van tractoren. Was er in 1959 nog slechts een tractor in geheel Hinzenburg, per 1 juli 1960 bedroeg dit aantal reeds 6." ] ;
    sgpl:thesisID 25 .

sgpl:Thesis250 a sgpl:SGPLThesis ;
    dcterms:creator "C.M.M.D. Peletier",
        "N.T. Sijtsma" ;
    dcterms:issued 1992,
        1993 ;
    dcterms:title "Een studie naar de bereikbaarheid van vier Europese luchthavens",
        "VLIEGEN OP GEGIST BESTEK?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Gezien het stadium waarin de onderhandelingen tussen de vier betrokken luchtvaartmaatschappijen zich momenteel bevinden is het wenselijk de positie van de nationale luchthavens op basis van de kortste reistijd uiteen te zetten. Van de zeven relevante nationale luchthavens (Amsterdam, Genève, Kopenhagen, Oslo, Stockholm, Wenen en Zürich) zijn in deze analyse Amsterdam, Kopenhagen, Wenen en Zürich gekozen als uitgangspunt. Bij het schrijven van deze scriptie is de deskundige inbreng van veel mensen op het gebied van zowel de luchtvaart als de geografie heel waardevol geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Parijs" ;
            sgpl:text_context "Zowel Bruinsma & Rietveld (Stedelijke Netwerken, 1992) als Kramer (1990) gaan ervan uit dat Parijs, Londen en Frank- fort hun positie als mainport kunnen behouden. De strijd speelt zich momenteel voornamelijk af tussen Amsterdam, Brussel, Zürich, Rome en Madrid. Schiphol bereidt zich al helemaal voor om een positie als mainport in te nemen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2614165 ;
            sgpl:spatialText "Scandinavische herkomstgebieden" ;
            sgpl:text_context "Naar de bestemming Tokyo zien we voor wat betreft de hub Amsterdam een zelfde spreidingspatroon van herkomstgebieden zij het dat de Scandinavische herkomstgebieden nu via Kopenhagen verlopen. De Zuid-Europese herkomstge- bieden hebben binnen de maximale overstaptijd geen aansluiting op een vlucht naar Tokyo via Zürich, deze functie wordt door geen van de andere hubs overgenomen. Bangkok is de enige van de acht geselecteerde ICA-bestemmingen waarbij Amsterdam als hub geen dominante positie heeft." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2657896 ;
            sgpl:spatialText "Zürich" ;
            sgpl:text_context "Gezien het stadium waarin de onderhandelingen tussen de vier betrokken luchtvaartmaatschappijen zich momenteel bevinden is het wenselijk de positie van de nationale luchthavens op basis van de kortste reistijd uiteen te zetten. Van de zeven relevante nationale luchthavens (Amsterdam, Genève, Kopenhagen, Oslo, Stockholm, Wenen en Zürich) zijn in deze analyse Amsterdam, Kopenhagen, Wenen en Zürich gekozen als uitgangspunt. Bij het schrijven van deze scriptie is de deskundige inbreng van veel mensen op het gebied van zowel de luchtvaart als de geografie heel waardevol geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Verenigde Staten" ;
            sgpl:text_context "In het theoretische deel van dit onderzoek wordt ingegaan op de liberalisering en deregulering van de luchtvaart en op het hub & spoke principe. Overeenkomsten en verschillen tussen de ontwikkelingen in de Verenigde Staten en Europa komen daarbij aan de orde. In de trend tot schaalvergroting zoekt ook de flagcarrier van Nederland, KLM, naarstig naar nieuwe partners die moeten voorkomen dat deze luchtvaartmaatschappij een regionale carrier zal worden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "vier Europese luchthavens" ;
            sgpl:text_context "VLIEGEN OP GEGIST BESTEK? een studie naar de bereikbaarheid van vier Europese luchthavens augustus 1992. VAKGROEP TOEGEPASTE GEOGRAFIE EN PLANOLOGIE Faculteit der Ruimtelijke Wetenschappen. Rijksuniversiteit Utrecht Heidelberglaan 2, 3584 CS Utrecht, 030 - 531399 / 532044." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2761369 ;
            sgpl:spatialText "Wenen" ;
            sgpl:text_context "Gezien het stadium waarin de onderhandelingen tussen de vier betrokken luchtvaartmaatschappijen zich momenteel bevinden is het wenselijk de positie van de nationale luchthavens op basis van de kortste reistijd uiteen te zetten. Van de zeven relevante nationale luchthavens (Amsterdam, Genève, Kopenhagen, Oslo, Stockholm, Wenen en Zürich) zijn in deze analyse Amsterdam, Kopenhagen, Wenen en Zürich gekozen als uitgangspunt. Bij het schrijven van deze scriptie is de deskundige inbreng van veel mensen op het gebied van zowel de luchtvaart als de geografie heel waardevol geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Zuid-Europese landen" ;
            sgpl:text_context "Heel kenmerkend voor het intra-Europees chartervervoer is de seizoengebondenheid (juni tot en met september) en de charterstromen die veelal langs de noord-zuidas lopen. Hiermee wordt bedoeld van West-Europese naar Zuid-Europese landen. De passagiersmarkt wordt ook sterk beïnvloed door de exploitatiekosten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europese" ;
            sgpl:text_context "Heel kenmerkend voor het intra-Europees chartervervoer is de seizoengebondenheid (juni tot en met september) en de charterstromen die veelal langs de noord-zuidas lopen. Hiermee wordt bedoeld van West-Europese naar Zuid-Europese landen. De passagiersmarkt wordt ook sterk beïnvloed door de exploitatiekosten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2618425 ;
            sgpl:spatialText "Kopenhagen" ;
            sgpl:text_context "Gezien het stadium waarin de onderhandelingen tussen de vier betrokken luchtvaartmaatschappijen zich momenteel bevinden is het wenselijk de positie van de nationale luchthavens op basis van de kortste reistijd uiteen te zetten. Van de zeven relevante nationale luchthavens (Amsterdam, Genève, Kopenhagen, Oslo, Stockholm, Wenen en Zürich) zijn in deze analyse Amsterdam, Kopenhagen, Wenen en Zürich gekozen als uitgangspunt. Bij het schrijven van deze scriptie is de deskundige inbreng van veel mensen op het gebied van zowel de luchtvaart als de geografie heel waardevol geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "In het theoretische deel van dit onderzoek wordt ingegaan op de liberalisering en deregulering van de luchtvaart en op het hub & spoke principe. Overeenkomsten en verschillen tussen de ontwikkelingen in de Verenigde Staten en Europa komen daarbij aan de orde. In de trend tot schaalvergroting zoekt ook de flagcarrier van Nederland, KLM, naarstig naar nieuwe partners die moeten voorkomen dat deze luchtvaartmaatschappij een regionale carrier zal worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Overeenkomsten en verschillen tussen de ontwikkelingen in de Verenigde Staten en Europa komen daarbij aan de orde. In de trend tot schaalvergroting zoekt ook de flagcarrier van Nederland, KLM, naarstig naar nieuwe partners die moeten voorkomen dat deze luchtvaartmaatschappij een regionale carrier zal worden. Het vinden van een krachtige partner op de Europese markt is voor de KLM van groot belang." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "De strijd speelt zich momenteel voornamelijk af tussen Amsterdam, Brussel, Zürich, Rome en Madrid. Schiphol bereidt zich al helemaal voor om een positie als mainport in te nemen. Belangrijk voor het voeren van een goede mainportstrategie is een juiste afweging tussen de belangen van de luchtvaartmaatschappijen, de overheid en de luchthaven Schiphol." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:4990729 ;
            sgpl:spatialText "Detroit" ;
            sgpl:text_context "Passagiers kunnen vanaf Amsterdam naar bijvoorbeeld Detroit vliegen en vandaar met NWA doorreizen naar kleinere bestem min gen in de Verenigde Staten. Bovendien kunnen beide maatschappijen verschillende vluchten onder hetzelfde vluchtnummer aanprijzen (het zogenaamde codesharing). Dus bij het overstappen van een KLM-vlucht op een NWA-vlucht vliegt de reiziger op één ticket." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Zuid-Europa" ;
            sgpl:text_context "In Europa is het aandeel van het charterpersonenvervoer de afgelopen tien jaar gestegen van 38% naar 57% (Van der Velden, 1989). De oorzaken van deze groei waren: sterke prijsdaling van vakanties in Zuid-Europa recessie in combinatie met de sterke Amerikaanse dollar waardoor het aantal intercontinentale vluchten (veelal lijnvluchten) afnam. Heel kenmerkend voor het intra-Europees chartervervoer is de seizoengebondenheid (juni tot en met september) en de charterstromen die veelal langs de noord-zuidas lopen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2800866 ;
            sgpl:spatialText "Brussel" ;
            sgpl:text_context "De strijd speelt zich momenteel voornamelijk af tussen Amsterdam, Brussel, Zürich, Rome en Madrid. Schiphol bereidt zich al helemaal voor om een positie als mainport in te nemen. Belangrijk voor het voeren van een goede mainportstrategie is een juiste afweging tussen de belangen van de luchtvaartmaatschappijen, de overheid en de luchthaven Schiphol." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7121 ;
            sgpl:subjectText "Wisconsinmodel" ;
            sgpl:text_context "Hierbij is: R = totale reistijd o = herkomst d = bestemming h = hub T = reistijd W = wachttijd M = MCT. Om de bereikbaarheid op basis van de kortste reistijd weer te geven hebben we in dit onderzoek gebruik gemaakt van een eigen interpretatie van het Wisconsinmodel. Op het oorspronkelijke model is een aanpassing noodzakelijk omdat dit model uitgaat van een sommering van de reistijden uit de door ons geselecteerde herkomstgebieden." ],
        [ sgpl:refersToConcept unesco:concept13199 ;
            sgpl:subjectText "hub & spoke principe" ;
            sgpl:text_context "In maart 1993 zijn wij bij de Rijksluchtvaartdienst in het kader van onze doctoraalscriptie economische geografie een onderzoek gestart. In het theoretische deel van dit onderzoek wordt ingegaan op de liberalisering en deregulering van de luchtvaart en op het hub & spoke principe. Overeenkomsten en verschillen tussen de ontwikkelingen in de Verenigde Staten en Europa komen daarbij aan de orde." ],
        [ sgpl:refersToConcept unesco:concept17185 ;
            sgpl:subjectText "bereikbaarheid" ;
            sgpl:text_context "Voor langere afstanden is dit 70% (Philip A. Holt, Coopers and Lybrand, 1990). Haggett (1969) ontwikkelde een model om het begrip bereikbaarheid, de zogenaamde accessibility, vorm te geven. Het model is niet beschrijvend, maar berust op keuzen of preferenties." ],
        [ sgpl:refersToConcept unesco:concept17185 ;
            sgpl:subjectText "bereikbaarheid" ;
            sgpl:text_context "Voor langere afstanden is dit 70% (Philip A. Holt, Coopers and Lybrand, 1990). Haggett (1969) ontwikkelde een model om het begrip bereikbaarheid, de zogenaamde accessibility, vorm te geven. Het model is niet beschrijvend, maar berust op keuzen of preferenties." ],
        [ sgpl:refersToConcept unesco:concept7121 ;
            sgpl:subjectText "Wisconsinmodel" ;
            sgpl:text_context "Hierbij is: R = totale reistijd o = herkomst d = bestemming h = hub T = reistijd W = wachttijd M = MCT. Om de bereikbaarheid op basis van de kortste reistijd weer te geven hebben we in dit onderzoek gebruik gemaakt van een eigen interpretatie van het Wisconsinmodel. Op het oorspronkelijke model is een aanpassing noodzakelijk omdat dit model uitgaat van een sommering van de reistijden uit de door ons geselecteerde herkomstgebieden." ],
        [ sgpl:refersToConcept unesco:concept13199 ;
            sgpl:subjectText "hub & spoke principe" ;
            sgpl:text_context "In maart 1993 zijn wij bij de Rijksluchtvaartdienst in het kader van onze doctoraalscriptie economische geografie een onderzoek gestart. In het theoretische deel van dit onderzoek wordt ingegaan op de liberalisering en deregulering van de luchtvaart en op het hub & spoke principe. Overeenkomsten en verschillen tussen de ontwikkelingen in de Verenigde Staten en Europa komen daarbij aan de orde." ] ;
    sgpl:thesisID 250 .

sgpl:Thesis252 a sgpl:SGPLThesis ;
    dcterms:creator "Karin van der Woude" ;
    dcterms:issued 1992 ;
    dcterms:title "VERBROKKELING OF INTEGRATIE: Kennisgebruik bij een projectgewijze aanpak in de ruimtelijke planning" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Badhoevedorp, internat businesscentrum v.4. Ideeën om een werkstad te ontwikkelen bij Schiphol met goede openbaar vervoerverbindingen zoals een automatisch personen vervoerssysteem. Transferium Drechtstad v.4 1.1 Inrichting van een plek om de verech. vervoersstromen te regelen (geen nieuw idee maar uitvoering zou Innovatief zijn)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Opzetten van een autoverhuursysteem in een wijk in het centrum van Amsterdam, (uitvoering zou nieuw zijn). De auto-vrije woonwijk. Ontwerp van auto-vrije woonwijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Van september 1991 tot en met februari 1992 heb ik stage gelopen bij de Rijksplanologische Dienst in Den Haag. Het onderzoek dat hier is verricht, vond plaats in het kader van de doctoraal-studie Sociale Geografie met als specialisatie Planologie aan de Rijksuniversiteit te Utrecht. Ik hoop dat dit onderzoeksverslag inzicht biedt voor oplossing van twee problemen die kunnen resulteren als gevolg van de projectgewijze aanpak in de huidige ruimtelijke planning." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756669 ;
            sgpl:spatialText "Dordrecht" ;
            sgpl:text_context "De gemeenten Breda, Zwolle en Dordrecht zijn gekozen aangezien hier de problematiek voldoende complex is terwijl de drie verschillende situaties voldoende contrast vertonen. De projectgroep (zonder vertegenwoordigers van de gemeenten) komt ongeveer tweemaandelijks bijeen om de vorderingen te bespreken en kennis uit te wisselen. Vertrekpunt vormde een indeling van onderzoeksvragen naar een ecologisch verantwoorde stedelijke ontwikkeling." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758998 ;
            sgpl:spatialText "Beverwijk" ;
            sgpl:text_context "Dat vormde de reden dat in hoofdstuk vijf een drietal geselecteerde voorbeeldplannen in Beverwijk, Dordrecht en Maastricht verder zijn uitgewerkt om te leren van ervaringen met betrekking tot de integrale projectgewijze aanpak. Bij de drie planuitwerkingen is sprake van een projectgroep, dan wel werkgroep waarin meerdere disciplines vertegenwoordigd zijn. De multidisciplinaire samenwerking verliep redelijk tot goed." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Faculteit der Ruimtelijke Wetenschappen, Rijksuniversiteit Utrecht Heidelberglaan 2, 3584 CS Utrecht, 030- 531399/532044. Vakgroep Toegepaste Geografie en Planologie Karin van der Woude Begeleiders: Prof. Dr. H. ter Heide en Drs. G. Borgman Utrecht, april 1992." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "De gemeenten Breda, Zwolle en Dordrecht zijn gekozen aangezien hier de problematiek voldoende complex is terwijl de drie verschillende situaties voldoende contrast vertonen. De projectgroep (zonder vertegenwoordigers van de gemeenten) komt ongeveer tweemaandelijks bijeen om de vorderingen te bespreken en kennis uit te wisselen. Vertrekpunt vormde een indeling van onderzoeksvragen naar een ecologisch verantwoorde stedelijke ontwikkeling." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751282 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "En tot slot de geïnterviewden die betrokken zijn bij de uitwerking van drie geselecteerde voorbeeldplannen. Deze voorbeeldplannen worden uitgewerkt in de gemeenten Maastricht, Dordrecht en Beverwijk. Karin van der Woude Utrecht, maart 1992." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Een voorbeeld is het plan voor het Tussengebied tussen Den Haag en Rotterdam. Deze verkennende studie werd in projectverband uitgevoerd met een ruim mandaat. Analyse- en ontwerpcycli wisselden elkaar snel af." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743476 ;
            sgpl:spatialText "Zwolle" ;
            sgpl:text_context "De gemeenten Breda, Zwolle en Dordrecht zijn gekozen aangezien hier de problematiek voldoende complex is terwijl de drie verschillende situaties voldoende contrast vertonen. De projectgroep (zonder vertegenwoordigers van de gemeenten) komt ongeveer tweemaandelijks bijeen om de vorderingen te bespreken en kennis uit te wisselen. Vertrekpunt vormde een indeling van onderzoeksvragen naar een ecologisch verantwoorde stedelijke ontwikkeling." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10614 ;
            sgpl:subjectText "kennismanagement" ;
            sgpl:text_context "Wel is duidelijk dat dit probleem zich in de toekomst sterker zal manifesteren gezien de toename van het aantal projecten dat wordt opgezet. Een goed kennismanagement van de kennishuishouding is essentieel. Kennismanagement richt zich op een juiste ordening, vertaling en verspreiding van kennis binnen organisaties." ],
        [ sgpl:refersToConcept unesco:concept4191 ;
            sgpl:subjectText "verbrokkeling van kennis" ;
            sgpl:text_context "Ten eerste bestaat het gevaar van onvoldoende afstemming tussen disciplines (kennis) en tussen onderzoek en ontwerp (kunde) binnen projecten. Ten tweede blijkt in de praktijk tussen projecten een verbrokkeling van kennis op te treden. Doelstelling van deze scriptie is het verlenen van inzichten en aandragen van mogelijkheden, oftewel wegwijzers, om tot een integrale projectgewijze aanpak van problemen te komen." ],
        [ sgpl:refersToConcept unesco:concept111 ;
            sgpl:subjectText "ontwerpend onderzoek" ;
            sgpl:text_context "In Maastricht en Beverwijk was meer sprake van een begeleidingsgroep. In Dordrecht en Beverwijk was het planproces te kenschetsen als een vorm van ontwerpend onderzoek, waarmee men goede ervaringen heeft opgedaan. Beide studies zijn verkennend van aard in tegenstelling tot het project in Maastricht dat sterk uitvoeringsgericht is." ],
        [ sgpl:refersToConcept unesco:concept111 ;
            sgpl:subjectText "ontwerpend onderzoek" ;
            sgpl:text_context "In Maastricht en Beverwijk was meer sprake van een begeleidingsgroep. In Dordrecht en Beverwijk was het planproces te kenschetsen als een vorm van ontwerpend onderzoek, waarmee men goede ervaringen heeft opgedaan. Beide studies zijn verkennend van aard in tegenstelling tot het project in Maastricht dat sterk uitvoeringsgericht is." ],
        [ sgpl:refersToConcept unesco:concept4191 ;
            sgpl:subjectText "verbrokkeling van kennis" ;
            sgpl:text_context "Ten eerste bestaat het gevaar van onvoldoende afstemming tussen disciplines (kennis) en tussen onderzoek en ontwerp (kunde) binnen projecten. Ten tweede blijkt in de praktijk tussen projecten een verbrokkeling van kennis op te treden. Doelstelling van deze scriptie is het verlenen van inzichten en aandragen van mogelijkheden, oftewel wegwijzers, om tot een integrale projectgewijze aanpak van problemen te komen." ],
        [ sgpl:refersToConcept unesco:concept10614 ;
            sgpl:subjectText "kennismanagement" ;
            sgpl:text_context "Wel is duidelijk dat dit probleem zich in de toekomst sterker zal manifesteren gezien de toename van het aantal projecten dat wordt opgezet. Een goed kennismanagement van de kennishuishouding is essentieel. Kennismanagement richt zich op een juiste ordening, vertaling en verspreiding van kennis binnen organisaties." ] ;
    sgpl:thesisID 252 .

sgpl:Thesis253 a sgpl:SGPLThesis ;
    dcterms:creator "Désirée Barendregt",
        "Karin Gybels" ;
    dcterms:issued 1993 ;
    dcterms:title "DE GRENS VOORBIJ",
        "De invloed van de grens op de regionale ontwikkeling en de grensoverschrijdende interactie in Noordoost-Nederland en Noordwest-Duitsland" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Noordwest-Duitsland" ;
            sgpl:text_context "De probleemstelling voor dit onderzoek luidt: Wat is de betekenis van de grens voor de regionale ontwikkeling van de grensgebieden in Noordoost-Nederland en Noordwest-Duitsland en de grensoverschrijdende interactie tussen deze gebieden? Het is moeilijk de invloed van de grens afzonderlijk te behandelen, aangezien er natuurlijk een groot aantal factoren een rol speelt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7535498 ;
            sgpl:spatialText "Oldambt" ;
            sgpl:text_context "In het onderzoeksgebied maken het Nederlandse Oldambt en het Duitse Rheiderland er deel van uit. Het zeekleigebied heeft zich in beide landen globaal hetzelfde ontwikkeld. Het landschap is gevormd door een eeuwenlang proces van aanlanding en afslag vanuit de zee en bedijkingen en inpolderingen door de mens." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756631 ;
            sgpl:spatialText "Zuidoost-Drenthe" ;
            sgpl:text_context "Het is op te delen in vier deelgebieden: de COROP-gebieden Oost-Groningen en Zuidoost-Drenthe en de Landkreise Leer en Emsland. Er is bewust gekozen voor het gebruik van deze (in statistisch en bestuurlijk opzicht) 'bestaande' regio’s, omdat na een eerste inventarisatie bleek dat er ook in de realiteit een samenhang binnen deze gebieden bestaat. Dit is niet verwonderlijk, omdat bij de afbakening van zowel de Kreise als de COROP-gebieden rekening is gehouden met de historische en economische ontwikkeling van de betreffende gemeenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755249 ;
            sgpl:spatialText "Oost-Groningen" ;
            sgpl:text_context "Het is op te delen in vier deelgebieden: de COROP-gebieden Oost-Groningen en Zuidoost-Drenthe en de Landkreise Leer en Emsland. Er is bewust gekozen voor het gebruik van deze (in statistisch en bestuurlijk opzicht) 'bestaande' regio’s, omdat na een eerste inventarisatie bleek dat er ook in de realiteit een samenhang binnen deze gebieden bestaat. Dit is niet verwonderlijk, omdat bij de afbakening van zowel de Kreise als de COROP-gebieden rekening is gehouden met de historische en economische ontwikkeling van de betreffende gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Deze scriptie is het resultaat van het doctoraalonderzoek voor de studie sociale geografie, met als specialisatierichting regionale geografie, aan de Faculteit der Ruimtelijke Wetenschappen te Utrecht. Het onderzoek heeft plaatsgevonden in de periode maart 1992 tot en met augustus 1993. Tijdens deze periode hebben ook andere studieactiviteiten onze aandacht gevraagd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2879697 ;
            sgpl:spatialText "Landkreis Leer" ;
            sgpl:text_context "Het is op te delen in vier deelgebieden: de COROP-gebieden Oost-Groningen en Zuidoost-Drenthe en de Landkreise Leer en Emsland. Er is bewust gekozen voor het gebruik van deze (in statistisch en bestuurlijk opzicht) 'bestaande' regio’s, omdat na een eerste inventarisatie bleek dat er ook in de realiteit een samenhang binnen deze gebieden bestaat. Dit is niet verwonderlijk, omdat bij de afbakening van zowel de Kreise als de COROP-gebieden rekening is gehouden met de historische en economische ontwikkeling van de betreffende gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "de Nederlandse grens-regio’s" ;
            sgpl:text_context "Keuze van het onderzoeksgebied: Noordoost-Nederland en Noordwest-Duitsland. Binnen het regionaal geografische onderzoek naar de Nederlandse grens-regio’s is voornamelijk aandacht besteed aan gebieden waar sprake is van relatief veel interactie, bijvoorbeeld het grensgebied tussen Nederland en België (Hoekveld e.a., 1988; Van Doom e.a., 1990). Bij de bestudering van de mogelijkheden voor een onderzoek naar grensgebieden met beperkte interactie, viel het grensgebied in Noordoost-Nederland op." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Eems Dollard Regio" ;
            sgpl:text_context "In de oriënterende fase van het onderzoek werd duidelijk dat er in dit gebied een grensoverschrijdende samenwerkingsverband actief is, de Eems Dollard Regio (EDR, zie ook de kaart in bijlage C). Een gesprek met de EDR bevestigde het beeld dat het gebied een interessant kader bood voor een onderzoek naar grensoverschrijdende interactie. Zowel het Nederlandse als het Duitse gebied is dunbevolkt en ze kennen een gelijksoortige problematiek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3221073 ;
            sgpl:spatialText "Landkreis Emsland" ;
            sgpl:text_context "Het is op te delen in vier deelgebieden: de COROP-gebieden Oost-Groningen en Zuidoost-Drenthe en de Landkreise Leer en Emsland. Er is bewust gekozen voor het gebruik van deze (in statistisch en bestuurlijk opzicht) 'bestaande' regio’s, omdat na een eerste inventarisatie bleek dat er ook in de realiteit een samenhang binnen deze gebieden bestaat. Dit is niet verwonderlijk, omdat bij de afbakening van zowel de Kreise als de COROP-gebieden rekening is gehouden met de historische en economische ontwikkeling van de betreffende gemeenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Noordoost-Nederland" ;
            sgpl:text_context "De probleemstelling voor dit onderzoek luidt: Wat is de betekenis van de grens voor de regionale ontwikkeling van de grensgebieden in Noordoost-Nederland en Noordwest-Duitsland en de grensoverschrijdende interactie tussen deze gebieden? Het is moeilijk de invloed van de grens afzonderlijk te behandelen, aangezien er natuurlijk een groot aantal factoren een rol speelt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2847676 ;
            sgpl:spatialText "Rheiderland" ;
            sgpl:text_context "In het onderzoeksgebied maken het Nederlandse Oldambt en het Duitse Rheiderland er deel van uit. Het zeekleigebied heeft zich in beide landen globaal hetzelfde ontwikkeld. Het landschap is gevormd door een eeuwenlang proces van aanlanding en afslag vanuit de zee en bedijkingen en inpolderingen door de mens." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2802361 ;
            sgpl:spatialText "België" ;
            sgpl:text_context "Binnen het regionaal geografische onderzoek naar de Nederlandse grens-regio’s is voornamelijk aandacht besteed aan gebieden waar sprake is van relatief veel interactie, bijvoorbeeld het grensgebied tussen Nederland en België (Hoekveld e.a., 1988; Van Doom e.a., 1990). Bij de bestudering van de mogelijkheden voor een onderzoek naar grensgebieden met beperkte interactie, viel het grensgebied in Noordoost-Nederland (Groningen en Drenthe) en Noordwest-Duitsland (Niedersachsen) op. De eerste indruk van dit gebied was dat er, in vergelijking met andere grensgebieden, nauwelijks een traditie lijkt te bestaan van intensieve contacten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2855525 ;
            sgpl:spatialText "Papenburg" ;
            sgpl:text_context "De oudste Fehnkolonie, Papenburg, ligt echter in het noorden van Emsland en vormde ook in andere opzichten een uitzondering. De kolonie is in 1630 opgezet naar Hollands voorbeeld (Nitz, 1993, p. 18) en was voor Duitse begrippen zeer succesvol. In tegenstelling tot veel andere Duitse Fehnkolonien werd er veel geïnvesteerd in de aanleg van kanalen, een binnenhaven en een verbinding met de Ems." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756136 ;
            sgpl:spatialText "Emmen" ;
            sgpl:text_context "Onder andere Stadskanaal, Ter Apel en Emmen werden bestempeld als industrialisatiekernen. Vooral Emmen groeide enorm door de komst van nieuwe bedrijven. Hoewel het regionaal beleid in de jaren ’50 en ’60 de werkgelegenheid wel zeker stimuleerde, was dit onvoldoende om een structurele autonome economische ontwikkeling op gang te krijgen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4271 ;
            sgpl:subjectText "Grensoverschrijdende interactie" ;
            sgpl:text_context "In dit onderzoek richten wij ons op grensgebieden die gekenmerkt worden door een beperkte interactie over de grens. De probleemstelling voor dit onderzoek luidt: Wat is de betekenis van de grens voor de regionale ontwikkeling van de grens-gebieden in Noordoost-Nederland en Noordwest-Duitsland en de grensoverschrijdende interactie tussen deze gebieden? Het is moeilijk de invloed van de grens afzonderlijk te behandelen, aangezien er natuurlijk een groot aantal factoren een rol speelt." ],
        [ sgpl:refersToConcept unesco:concept5884 ;
            sgpl:subjectText "Grensforensisme" ;
            sgpl:text_context "Het geeft aan dat mensen bekend zijn met de situatie in het buurland en dat men deze positief beoordeelt. Voor grensforensisme is een structurele vorm van contact eveneens noodzakelijk. Woon-werk-relaties hebben over het algemeen een constant (niet incidenteel) karakter." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "Regionale ontwikkeling" ;
            sgpl:text_context "Door de achterliggende algemene en unieke processen en structuren te analyseren, wordt het mogelijk de regionale ontwikkeling van een gebied te verklaren. Bij de analyse van regionale ontwikkeling worden regionaal geografen voortdurend geconfronteerd met het afbakenen van regio's. Soms is deze afbakening een door de onderzoeker gevormde constructie, vaak wordt echter gebruik gemaakt van een bestaande regionale indeling en begrenzing." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "Regionale ontwikkeling" ;
            sgpl:text_context "Door de achterliggende algemene en unieke processen en structuren te analyseren, wordt het mogelijk de regionale ontwikkeling van een gebied te verklaren. Bij de analyse van regionale ontwikkeling worden regionaal geografen voortdurend geconfronteerd met het afbakenen van regio's. Soms is deze afbakening een door de onderzoeker gevormde constructie, vaak wordt echter gebruik gemaakt van een bestaande regionale indeling en begrenzing." ],
        [ sgpl:refersToConcept unesco:concept5884 ;
            sgpl:subjectText "Grensforensisme" ;
            sgpl:text_context "Het geeft aan dat mensen bekend zijn met de situatie in het buurland en dat men deze positief beoordeelt. Voor grensforensisme is een structurele vorm van contact eveneens noodzakelijk. Woon-werk-relaties hebben over het algemeen een constant (niet incidenteel) karakter." ],
        [ sgpl:refersToConcept unesco:concept4271 ;
            sgpl:subjectText "Grensoverschrijdende interactie" ;
            sgpl:text_context "In dit onderzoek richten wij ons op grensgebieden die gekenmerkt worden door een beperkte interactie over de grens. De probleemstelling voor dit onderzoek luidt: Wat is de betekenis van de grens voor de regionale ontwikkeling van de grens-gebieden in Noordoost-Nederland en Noordwest-Duitsland en de grensoverschrijdende interactie tussen deze gebieden? Het is moeilijk de invloed van de grens afzonderlijk te behandelen, aangezien er natuurlijk een groot aantal factoren een rol speelt." ] ;
    sgpl:thesisID 253 .

sgpl:Thesis254 a sgpl:SGPLThesis ;
    dcterms:creator "Paul van Beijnum",
        "Ronald H. Kranenburg" ;
    dcterms:issued 1993 ;
    dcterms:title "De effecten van buurtverbetering in El Alto, Bolivia.",
        "De zone 16 de Julio na het HAM-BIRF-Project.",
        "LA ZONA 16 DE JULIO DESPUES DEL PROYECTO HAM-BIRF.",
        "Los efectos de un programa de mejoramiento urbano en El Alto, Bolivia." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3923057 ;
            sgpl:spatialText "Bolivia" ;
            sgpl:text_context "INLEIDING. Bolivia bezit een bruto-nationaal produkt per hoofd van de bevolking dat vergelijkbaar is met dat van de allerarmste landen ter wereld. Sinds het begin van de jaren '80 bevindt het land zich in een vrijwel permanente staat van economische crisis." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Alto Sur" ;
            sgpl:text_context "In 1952 waren er zes wijken: Dolores, 12 de Octubre en Bolivar \"A\" in Alto Sur, 16 de Julio, Ballividn en Alto Lima in Alto Norte (Sandoval en Sostres, 1989 p.21). De Revolución Nacional (1952 - 1956) heeft voor geheel Bolivia maar zeker ook voor El Alto een grote impact gehad. De revolutie werd ondersteund door een brede volksbeweging waarbij de emancipatie van de indiaanse bevolking een belangrijk thema vormde." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Avenida Juan Pablo II" ;
            sgpl:text_context "De diverse economische activiteiten en hoogbouw blijken zich voornamelijk langs de grote assen te concentreren zoals de Avenida 16 de Julio, de Avenida Alfonso Ugarte en de Avenida Juan Pablo II. De concentratie van economische activiteiten in de zone 16 de Julio is het gevolg van de aanwezigheid van de periodieke markt. Deze markt behoort samen met die van Cochabamba tot de allergrootste van Bolivia." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "El Alto" ;
            sgpl:text_context "Hier heeft zich vanaf de jaren '50 een stad gevormd die in 1992 ongeveer 400.000 inwoners telde. Deze stad, El Alto, groeit jaarlijks met zo'n 10 procent en is daarmee de snelst groeiende stad van Bolivia. El Alto wordt van oudsher voornamelijk bewoond door lage-inkomensgroepen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Avenida Alfonso Ugarte" ;
            sgpl:text_context "De diverse economische activiteiten en hoogbouw blijken zich voornamelijk langs de grote assen te concentreren zoals de Avenida 16 de Julio, de Avenida Alfonso Ugarte en de Avenida Juan Pablo II. De concentratie van economische activiteiten in de zone 16 de Julio is het gevolg van de aanwezigheid van de periodieke markt. Deze markt behoort samen met die van Cochabamba tot de allergrootste van Bolivia." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Villa Los Andes" ;
            sgpl:text_context "De meest in het oog springende kenmerken van de wijken die in deze studie centraal staan (Villa 16 de Julio, Villa Los Andes en Villa Ballivian) en die samen de zone 16 de Julio vormen, zullen in deze paragraaf kort worden beschreven. Er zal tevens een beschrijving van de bewoners van de zone 16 de Julio worden gegeven. Er zal daarbij worden ingegaan op hun demografische kenmerken en op de plaats van herkomst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "LA ZONA 16 DE JÜLIO DESPUES DEL PROYECTO HAM-BIRF. Los efectos de un programa de mejoramiento urbano en El Alto, Bolivia. (con un resumen en espanol) Rijksuniversiteit te Utrecht Paul van Beijnum Ronald H. Kranenburg." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:11508096 ;
            sgpl:spatialText "Villa 16 de Julio" ;
            sgpl:text_context "De meest in het oog springende kenmerken van de wijken die in deze studie centraal staan (Villa 16 de Julio, Villa Los Andes en Villa Ballivian) en die samen de zone 16 de Julio vormen, zullen in deze paragraaf kort worden beschreven. Er zal tevens een beschrijving van de bewoners van de zone 16 de Julio worden gegeven. Er zal daarbij worden ingegaan op hun demografische kenmerken en op de plaats van herkomst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Om een volgende fase in dit longitudinaal onderzoekproject een solide basis te verschaffen hebben we deze studie voorzien van een veelheid aan tabellen. Bij de totstandkoming van deze studie is de hulp en steun van een groot aantal personen, zowel in Nederland als in Bolivia, onmisbaar gebleken. Terug in Nederland leerde Pieter van Teeffelen ons hoe met behulp van ATLAS*GIS het benodigde kaartmateriaal kon worden vervaardigd en vonden wij in hem een grote steun bij het oplossen van automatiseringsproblemen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Rio Seco" ;
            sgpl:text_context "De installatie van een rioleringssysteem bestaande uit 33.000 meter leiding en een zuiveringsstation in Rio Seco. De installatie van een waterleiding met een totale lengte van 25.000 meter. Het realiseren van perceelsaansluitingen op beide leidingnetten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3911925 ;
            sgpl:spatialText "La Paz" ;
            sgpl:text_context "Gebrek aan bestaansmiddelen op het platteland en een langdurige crisis in de mijnbouwsector zorgen jaarlijks voor een grote stroom migranten in de richting van de grootste stad van Bolivia, La Paz. De hellingen van het keteldal waarin La Paz ligt, zijn de laatste decennia vrijwel volledig volgebouwd, zodat de meeste migranten zich tegenwoordig op het aangrenzend gebied van de hoogvlakte vestigen. Hier heeft zich vanaf de jaren '50 een stad gevormd die in 1992 ongeveer 400.000 inwoners telde." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Alto Norte" ;
            sgpl:text_context "In 1952 waren er zes wijken: Dolores, 12 de Octubre en Bolivar \"A\" in Alto Sur, 16 de Julio, Ballividn en Alto Lima in Alto Norte (Sandoval en Sostres, 1989 p.21). De Revolución Nacional (1952 - 1956) heeft voor geheel Bolivia maar zeker ook voor El Alto een grote impact gehad. De revolutie werd ondersteund door een brede volksbeweging waarbij de emancipatie van de indiaanse bevolking een belangrijk thema vormde." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3923387 ;
            sgpl:spatialText "Villa Ballivian" ;
            sgpl:text_context "De meest in het oog springende kenmerken van de wijken die in deze studie centraal staan (Villa 16 de Julio, Villa Los Andes en Villa Ballivian) en die samen de zone 16 de Julio vormen, zullen in deze paragraaf kort worden beschreven. Er zal tevens een beschrijving van de bewoners van de zone 16 de Julio worden gegeven. Er zal daarbij worden ingegaan op hun demografische kenmerken en op de plaats van herkomst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3911559 ;
            sgpl:spatialText "Plaza Libertad" ;
            sgpl:text_context "Lopend vanaf het zogenaamde Complejo Fabril (een sportcentrum gelegen aan de rand van Los Andes) via de Avenida 16 de Julio in de richting van het Plaza Libertad in Villa 16 de Julio neemt de bouwhoogte en de bebouwingsdichtheid toe. Ook de percelen worden in oostwaartse richting aanmerkelijk kleiner. Rond het Plaza Libertad zijn tevens meer stenen gebouwen waar te nemen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:12512091 ;
            sgpl:spatialText "zone 16 de Julio" ;
            sgpl:text_context "In deze studie staan de ontwikkelingen binnen een drietal, meer geconsolideerde, wijken van El Alto centraal. De infrastructuur van deze wijken, die samen de zone 16 de Julio vormen, is als gevolg van buurtverbetering - de aanleg van ondermeer waterleiding en riolering - aanmerkelijk verbeterd. Maar hebben alle bewoners van de upgrading van hun buurt kunnen profiteren?" ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "Huishoudensmobiliteit" ;
            sgpl:text_context "Hoofdstuk zes vormt het zwaartepunt van deze studie. In dit hoofdstuk zal de omvang van de huishoudensmobiliteit en de aard van de verhuisstromen worden geïdentificeerd en geanalyseerd. Hieraan voorafgaand zal een kort overzicht van de belangrijkste intra-stedelijke verhuismodellen worden gegeven." ],
        [ sgpl:refersToConcept unesco:concept8813 ;
            sgpl:subjectText "Verdichtingsprocessen" ;
            sgpl:text_context "Aan de hand van drie aspecten zal de woningmarkt worden geanalyseerd: de omvang en groei van de woningvoorraad, de eigendomsverhoudingen en de grond- en huurprijzen. Wat betreft het eerste aspect ligt het accent met name op de verdichtingsprocessen in het onderzoeksgebied. De ontwikkelingen met betrekking tot de eigendomsverhoudingen zullen een licht moeten werpen op de vraag of de woningmarkt in de zone 16 de Julio sinds 1984 verder is gecommercialiseerd." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Buurtverbetering" ;
            sgpl:text_context "In deze studie staan de ontwikkelingen binnen een drietal, meer geconsolideerde, wijken van El Alto centraal. De infrastructuur van deze wijken, die samen de zone 16 de Julio vormen, is als gevolg van buurtverbetering - de aanleg van ondermeer waterleiding en riolering - aanmerkelijk verbeterd. Maar hebben alle bewoners van de upgrading van hun buurt kunnen profiteren?" ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Buurtverbetering" ;
            sgpl:text_context "In deze studie staan de ontwikkelingen binnen een drietal, meer geconsolideerde, wijken van El Alto centraal. De infrastructuur van deze wijken, die samen de zone 16 de Julio vormen, is als gevolg van buurtverbetering - de aanleg van ondermeer waterleiding en riolering - aanmerkelijk verbeterd. Maar hebben alle bewoners van de upgrading van hun buurt kunnen profiteren?" ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "Huishoudensmobiliteit" ;
            sgpl:text_context "Hoofdstuk zes vormt het zwaartepunt van deze studie. In dit hoofdstuk zal de omvang van de huishoudensmobiliteit en de aard van de verhuisstromen worden geïdentificeerd en geanalyseerd. Hieraan voorafgaand zal een kort overzicht van de belangrijkste intra-stedelijke verhuismodellen worden gegeven." ],
        [ sgpl:refersToConcept unesco:concept8813 ;
            sgpl:subjectText "Verdichtingsprocessen" ;
            sgpl:text_context "Aan de hand van drie aspecten zal de woningmarkt worden geanalyseerd: de omvang en groei van de woningvoorraad, de eigendomsverhoudingen en de grond- en huurprijzen. Wat betreft het eerste aspect ligt het accent met name op de verdichtingsprocessen in het onderzoeksgebied. De ontwikkelingen met betrekking tot de eigendomsverhoudingen zullen een licht moeten werpen op de vraag of de woningmarkt in de zone 16 de Julio sinds 1984 verder is gecommercialiseerd." ] ;
    sgpl:thesisID 254 .

sgpl:Thesis255 a sgpl:SGPLThesis ;
    dcterms:creator "Peter Bronsgeest" ;
    dcterms:issued 1993 ;
    dcterms:title "EEN NIEUWE BEZEM DOOR DE BUURT?",
        "Een onderzoek naar de meerwaarde van sociale vernieuwing inzake het beheer van stadsbuurten" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750053,
                geonames:7648380 ;
            sgpl:spatialText "Oud-West" ;
            sgpl:text_context "5. Haarlem, ’Meerwijk-Oost, Project C240’. 6. Nijmegen, ’Oud-West’. 7. Rotterdam, 'Nieuw Engeland’." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755420 ;
            sgpl:spatialText "Korte Akkeren" ;
            sgpl:text_context "2. Amsterdam, ’Spaarndammer-/Zeeheldenbuurt’. 3. Gouda, ’Korte Akkeren’. 4. Groningen, 'Tuinwijk’." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6954190 ;
            sgpl:spatialText "Hoogvliet" ;
            sgpl:text_context "5.5.7 Rotterdam - Nieuw Engeland. A. Nieuw Engeland is een buurt uit het begin van de jaren vijftig in de Rotterdamse deelgemeente Hoogvliet. Als belangrijkste werkgever had Shell destijds behoefte aan woningen nabij de Petroleumhaven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Votulast" ;
            sgpl:text_context "5.5.8 Utrecht - Vogelenbuurt. A. De Utrechtse Vogelenbuurt is gebouwd tussen 1880 en 1920. Het vormt samen met de buurten Tuinwijk, Lauwerecht en de Staatsliedenbuurt de wijk ’Votulast’." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Vogelenbuurt" ;
            sgpl:text_context "7. Rotterdam, 'Nieuw Engeland’. 8. Utrecht, ’Vogelenbuurt’. Hierbij dienen twee kanttekeningen te worden geplaatst:" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Meerwijk-Oost" ;
            sgpl:text_context "4. Groningen, 'Tuinwijk’. 5. Haarlem, ’Meerwijk-Oost, Project C240’. 6. Nijmegen, ’Oud-West’." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751639,
                geonames:2759821 ;
            sgpl:spatialText "Liendert" ;
            sgpl:text_context "Een derde hiervan is uiteindelijk gekozen als onderzoeksgebied. Daarbij is gekozen voor di projecten waarbij buurtbeheer nadrukkelijk centraal staat: 1. Amersfoort, ’Liendert’. 2. Amsterdam, ’Spaarndammer-/Zeeheldenbuurt’." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Nieuw Engeland" ;
            sgpl:text_context "6. Nijmegen, ’Oud-West’. 7. Rotterdam, 'Nieuw Engeland’. 8. Utrecht, ’Vogelenbuurt’." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Spaarndammer-/Zeeheldenbuurt" ;
            sgpl:text_context "1. Amersfoort, ’Liendert’. 2. Amsterdam, ’Spaarndammer-/Zeeheldenbuurt’. 3. Gouda, ’Korte Akkeren’." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "Tuinwijk" ;
            sgpl:text_context "3. Gouda, ’Korte Akkeren’. 4. Groningen, 'Tuinwijk’. 5. Haarlem, ’Meerwijk-Oost, Project C240’." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederlandse steden" ;
            sgpl:text_context "Door middel van dit onderzoek heb ik getracht een antwoord te geven op de vraag wat 'sociale vernieuwing’, kernbegrip in het regeerakkoord van het kabinet Lubbers-Kok (1989), heeft toegevoegd aan het beheer van een aantal buurten in Nederlandse steden. Mijn dank gaat in de eerste plaats uit naar mevr. drs. J.G.P. ter Welle voor de plezierige en constructieve begeleiding bij het onderzoek. Met het schrijven van dit verslag sluit ik een voor mij zeer belangrijke en waardevolle periode af." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept195 ;
            sgpl:subjectText "dagelijkse leefomgeving" ;
            sgpl:text_context "Voor de duidelijkheid volgt hieronder eerst een korte beschrijving en vergelijking van een aantal begrippen met betrekking tot de zorg voor de kwaliteit van de dagelijkse leefomgeving. Naast stadsvernieuwing is er de laatste jaren een aantal begrippen gangbaar geworden, die allen hetzelfde doel lijken te beogen, namelijk de zorg voor de kwaliteit van de dagelijkse leefomgeving, maar die toch verschillend zijn. Zo is er naast stadsvernieuwing sprake van stedelijke vernieuwing, stedelijk beheer, buurtbeheer en sociale vernieuwing." ],
        [ sgpl:refersToConcept unesco:concept396 ;
            sgpl:subjectText "sociale vernieuwing" ;
            sgpl:text_context "Als theoretische basis van dit onderzoek dient een literatuurstudie naar de problematiek van de stadsbuurten en de begrippen buurtbeheer en sociale vernieuwing (hoofdstuk 2, 3 en 4). Dit onderzoek wil een antwoord geven op de vraag wat sociale vernieuwing heeft bijgedragen aan het beheer van stadsbuurten met een concentratie van (fysieke en sociale) problemen. Voor het uiteindelijke onderzoek is een achttal stadsbuurten geselecteerd en zijn gesprekken gevoerd met projectcoördinatoren en wijkbeheerders." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "buurtbeheer" ;
            sgpl:text_context "Soms is beheer slechts een synoniem voor onderhoud. In brede zin kan buurtbeheer echter als volgt worden gedefinieerd: \"Het beheer van een buurt (buurtbeheer) omvat activiteiten van gemeente, overige beheerders en gebruikers van het gebied, gericht op het in een zo vroeg mogelijk stadium tegengaan van ongewenste en het stimuleren van gewenste ontwikkelingen met als doel het behoud en verbeteren van de kwaliteit van het woon- en leefmilieu in dat gebied\" (Van Haeften en Van Os, 1988, p.13). Stadsvernieuwing valt als zodanig niet onder buurtbeheer." ],
        [ sgpl:refersToConcept unesco:concept195 ;
            sgpl:subjectText "dagelijkse leefomgeving" ;
            sgpl:text_context "Voor de duidelijkheid volgt hieronder eerst een korte beschrijving en vergelijking van een aantal begrippen met betrekking tot de zorg voor de kwaliteit van de dagelijkse leefomgeving. Naast stadsvernieuwing is er de laatste jaren een aantal begrippen gangbaar geworden, die allen hetzelfde doel lijken te beogen, namelijk de zorg voor de kwaliteit van de dagelijkse leefomgeving, maar die toch verschillend zijn. Zo is er naast stadsvernieuwing sprake van stedelijke vernieuwing, stedelijk beheer, buurtbeheer en sociale vernieuwing." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "buurtbeheer" ;
            sgpl:text_context "Soms is beheer slechts een synoniem voor onderhoud. In brede zin kan buurtbeheer echter als volgt worden gedefinieerd: \"Het beheer van een buurt (buurtbeheer) omvat activiteiten van gemeente, overige beheerders en gebruikers van het gebied, gericht op het in een zo vroeg mogelijk stadium tegengaan van ongewenste en het stimuleren van gewenste ontwikkelingen met als doel het behoud en verbeteren van de kwaliteit van het woon- en leefmilieu in dat gebied\" (Van Haeften en Van Os, 1988, p.13). Stadsvernieuwing valt als zodanig niet onder buurtbeheer." ],
        [ sgpl:refersToConcept unesco:concept396 ;
            sgpl:subjectText "sociale vernieuwing" ;
            sgpl:text_context "Als theoretische basis van dit onderzoek dient een literatuurstudie naar de problematiek van de stadsbuurten en de begrippen buurtbeheer en sociale vernieuwing (hoofdstuk 2, 3 en 4). Dit onderzoek wil een antwoord geven op de vraag wat sociale vernieuwing heeft bijgedragen aan het beheer van stadsbuurten met een concentratie van (fysieke en sociale) problemen. Voor het uiteindelijke onderzoek is een achttal stadsbuurten geselecteerd en zijn gesprekken gevoerd met projectcoördinatoren en wijkbeheerders." ] ;
    sgpl:thesisID 255 .

sgpl:Thesis256 a sgpl:SGPLThesis ;
    dcterms:creator "Peije Bruil" ;
    dcterms:issued 1993 ;
    dcterms:title "DE GRENZELOZE DYNAMIEK VAN DE NEDERLANDSE TOPBANKEN",
        "GROTE NEDERLANDSE ONDERNEMINGEN IN INTERNATIONALE CONTEXT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757345 ;
            sgpl:spatialText "Delft" ;
            sgpl:text_context "Het onderzoek van Peije Bruil over de grootste banken in Nederland past uitstekend hierin. Het voor u liggende rapport is de vierde in een serie, die gaat over de grootste Nederlandse ondernemingen in de transportsector, elektrotechnische industrie, de bouwnijverheid, de chemische industrie, de voedings- en genotmiddelenindustrie en de bankensector. Delft, september 1993 Drs. H.P. Krolis VOORWOORD." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:4896861 ;
            sgpl:spatialText "Illinois" ;
            sgpl:text_context "La Salie is inmiddels uitgegroeid tot één van de grootste banken in die staat, mede door acquisities van Bank of Lisle, Lane Financial en de Exchange Bancorp Ine. In 1991 investeerde de ABN-AMRO bijna 430 miljoen dollar om de grootste spaarbank van Illinois (Talman Federal) over te nemen. Het bedrijf leunt op het eigen net van ’corporate banking offices’ en op regionale bankbedrijven rond de steden Chicago en New York." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "Het gedrag van grote ondernemingen ten aanzien van hun activiteiten in bepaalde regio’s vormt namelijk een belangrijk element van de toenemende internationale competitie tussen regio’s in West-Europa. Dit is de aanleiding van een onderzoekprogramma, dat INRO-TNO in samenwerking met de Geografische Faculteit van de Rijksuniversiteit Utrecht uitvoert. Het onderzoek van Peije Bruil over de grootste banken in Nederland past uitstekend hierin." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Midden- en Oost-Europa" ;
            sgpl:text_context "De verwachting is dat de internationale economische ontwikkelingen, zoals de verdere integratie en uitbreiding van de Europese gemeenschap en de ontwikkeling van Midden- en Oost-Europa, in het lopende decennium van grote invloed blijven op de strategie van de grootste Nederlandse ondernemingen, zoals dit reeds sedert het einde van de jaren tachtig het geval is. Aan deze strategieën zijn vele aspecten verbonden, waarvan onze interesse met name uitgaat naar de ontwikkelingen in de aard, omvang en lokaties van de activiteiten van de grootste ondernemingen binnen Nederland zelf. Daarmee verwachten wij een relatie te kunnen leggen met de kansen en de bedreigingen waaraan de vestigingsmilieus van de regio’s in Nederland onderworpen zijn." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Ook in deze sector zorgen technologische ontwikkelingen en toenemende concurrentie voor een hevige kostenstrijd en verlies van arbeidsplaatsen. De probleemstelling van dit onderzoek kan worden omschreven als: 'wat zijn de gevolgen van de door de grote Nederlandse banken gehanteerde concurrentie- strategieën in een internationaal concurrentieveld voor de lokaties en functies van vestigingen van deze banken in Nederland?' Uit de probleemstelling zijn de volgende onderzoeksvragen afgeleid:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Peije Bruil heeft in het kader van zijn afstudeerrichting Economische Geografie aan de Universiteit Utrecht een onderzoek verricht naar de strategieën van internationaal opererende banken en gevolgen hiervan op het lokatiepatroon in Nederland. Peije Bruil is in de gelegenheid gesteld dit projekt in stageverband bij het Instituut voor Ruimtelijke Organisatie van TNO uit te voeren. De omgeving van een professionele onderzoekorganisatie als INRO-TNO heeft Peije mede gestimuleerd tot het voor u liggende rapport." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "de regio’s in Nederland" ;
            sgpl:text_context "Aan deze strategieën zijn vele aspecten verbonden, waarvan onze interesse met name uitgaat naar de ontwikkelingen in de aard, omvang en lokaties van de activiteiten van de grootste ondernemingen binnen Nederland zelf. Daarmee verwachten wij een relatie te kunnen leggen met de kansen en de bedreigingen waaraan de vestigingsmilieus van de regio’s in Nederland onderworpen zijn. Het gedrag van grote ondernemingen ten aanzien van hun activiteiten in bepaalde regio’s vormt namelijk een belangrijk element van de toenemende internationale competitie tussen regio’s in West-Europa." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Verenigde Staten" ;
            sgpl:text_context "Onderzoek naar concurrentie-strategieën en organisatieveranderingen die samenhangen met internationalisering van dienstverleners heeft nog geen grote proporties aangenomen. Ondanks het feit dat de moderne economiën van de Verenigde Staten en E.G. landen voor een belangrijk deel drijven op de dienstenactiviteiten, blijft veel onderzoek en daaruit voortvloeiend overheidsbeleid gericht op de industrie of grote industriële ondernemingen. Terwijl een sterke dienstensector bovendien voor een grote invloed heeft op de concurrentie-positie van de industrie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "De vestiging van de top-bestuurders functies van multinationals neigt dan ook naar concentratie in een beperkt aantal grootstedelijke gebieden, zoals New York, Tokio, Londen, Parijs en de Randstad. De voordelen van deze lokaties zijn volgens Pred (in: Dicken en Lloyd,- 1990,p.308): l)een grotere mogelijkheid tot interorganisatorische ’face-to-face’ contacten; 2)de beschikbaarheid van gespecialiseerde diensten; 3)een hoge mate van toegankelijkheid tot andere grootstedelijke gebieden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Daarnaast is veelvuldig gebruik gemaakt van vakliteratuur (o.m. Economisch Statistische Berichten, The Banker, Euromoney), waartoe diverse (gespecialiseerde) bibliotheken bezocht zijn, zoals bijvoorbeeld de bibliotheek van het Nederlands Instituut voor het Bank- en Effectenbedrijf (NIBE) in Amsterdam en het archief van de bank Pierson, Heldring & Pierson. Vervolgens trad fase drie in werking. Het raamwerk van de case-studies (hoofdstuk 4) diende gevormd te worden door een uitgebreid schema waarin per bank de kernactiviteiten en de concurrentie-strategieën op deelmarkten in kaart gebracht moesten worden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12783 ;
            sgpl:subjectText "Internationalisering" ;
            sgpl:text_context "Ondanks het feit dat de moderne economiën van de Verenigde Staten en E.G. landen voor een belangrijk deel drijven op de dienstenactiviteiten, blijft veel onderzoek en daaruit voortvloeiend overheidsbeleid gericht op de industrie of grote industriële ondernemingen. Onderzoek naar concurrentie-strategieën en organisatieveranderingen die samenhangen met internationalisering van dienstverleners heeft nog geen grote proporties aangenomen. Terwijl een sterke dienstensector bovendien voor een grote invloed heeft op de concurrentie-positie van de industrie." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Locatiepatroon" ;
            sgpl:text_context "De hausse aan fusies, overnames en andere samenwerkingsverbanden die rond 1990 heeft plaatsgevonden, heeft zonder enige twijfel onder invloed gestaan van de toenemende internationalisering van deze bedrijfstak. Welke gevolgen heeft deze hausse voor de werkgelegenheid en het lokatiepatroon van diverse bancaire activiteiten in Nederland? Het behoud van werkgelegenheid is één van de heikele thema's in de hedendaagse nationale politiek." ],
        [ sgpl:refersToConcept unesco:concept1382 ;
            sgpl:subjectText "Organisatie-structuur" ;
            sgpl:text_context "Paragraaf 2.3.1 gaat in op factoren die de structuur van een organisatie beïnvloeden en geeft daarnaast de verschillende mogelijkheden die voorhanden zijn om een organisatie of deel van een organisatie te structureren. Mintzberg (1983,p.2) omschrijft organisatie-structuur als 'de som van het totaal aantal manieren waarop arbeids-verdeling en coördinatie van deze taken plaats vindt'. De structuur van een organisatie heeft verschillende functies te vervullen." ],
        [ sgpl:refersToConcept unesco:concept1382 ;
            sgpl:subjectText "Organisatie-structuur" ;
            sgpl:text_context "Paragraaf 2.3.1 gaat in op factoren die de structuur van een organisatie beïnvloeden en geeft daarnaast de verschillende mogelijkheden die voorhanden zijn om een organisatie of deel van een organisatie te structureren. Mintzberg (1983,p.2) omschrijft organisatie-structuur als 'de som van het totaal aantal manieren waarop arbeids-verdeling en coördinatie van deze taken plaats vindt'. De structuur van een organisatie heeft verschillende functies te vervullen." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Locatiepatroon" ;
            sgpl:text_context "De hausse aan fusies, overnames en andere samenwerkingsverbanden die rond 1990 heeft plaatsgevonden, heeft zonder enige twijfel onder invloed gestaan van de toenemende internationalisering van deze bedrijfstak. Welke gevolgen heeft deze hausse voor de werkgelegenheid en het lokatiepatroon van diverse bancaire activiteiten in Nederland? Het behoud van werkgelegenheid is één van de heikele thema's in de hedendaagse nationale politiek." ],
        [ sgpl:refersToConcept unesco:concept12783 ;
            sgpl:subjectText "Internationalisering" ;
            sgpl:text_context "Ondanks het feit dat de moderne economiën van de Verenigde Staten en E.G. landen voor een belangrijk deel drijven op de dienstenactiviteiten, blijft veel onderzoek en daaruit voortvloeiend overheidsbeleid gericht op de industrie of grote industriële ondernemingen. Onderzoek naar concurrentie-strategieën en organisatieveranderingen die samenhangen met internationalisering van dienstverleners heeft nog geen grote proporties aangenomen. Terwijl een sterke dienstensector bovendien voor een grote invloed heeft op de concurrentie-positie van de industrie." ] ;
    sgpl:thesisID 256 .

sgpl:Thesis257 a sgpl:SGPLThesis ;
    dcterms:creator "J.C.M. van Middelaar",
        "T.J. Haberland" ;
    dcterms:issued 1993 ;
    dcterms:title "Een vergelijking van de vormgeving van het ruimtelijk, milieu-, verkeers- en groenbeleid voor de lange termijn in vier middelgrote steden",
        "OMGEVINGSBELEID",
        "OP ZOEK NAAR INTEGRATIE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745706 ;
            sgpl:spatialText "Veldhoven" ;
            sgpl:text_context "Zowel Eindhoven als Groningen, Maastricht en Utrecht -de in dit rapport behandelde steden- bezitten een project dat als sleutelproject aangewezen kan gaan worden. In Eindhoven betreft dit de Westcorridor (de Corridor Eindhoven-Veldhoven-Welschap), in Groningen het Stationsgebied Noord-West Groningen, in Maastricht het Sphinx-Céramique-terrein en in Utrecht het Utrecht City Project. Hiermee leveren deze steden een belangrijke bijdrage aan de realisatie van de hoofdlijnen van het onder andere in de Vierde Nota (Extra) en in het NMP(+) verwoorde beleid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Deze vier beleidsvelden bepalen het beleid ten aanzien van het stedelijk leefmilieu. Als case-studies zijn vier middelgrote steden gekozen, te weten Eindhoven, Groningen, Maastricht en Utrecht. Nadat de ruimtelijke ordening decennia lang alleenheerser was over het omgevingsbeleid, dient nu ook milieubeleid zich steeds nadrukkelijker aan als belangenbehartiger van de omgevingskwaliteit." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De nota geeft vijf basiswaarden die voor de dagelijkse leefomgeving van mensen ruimtelijk gezien van groot belang zijn (Vierde Nota RO, deel A, 1988, p.38): een goed onderhouden fysieke omgeving; een schoon milieu; een veilige omgeving; ruimtelijke keuzevrijheid; ruimtelijke verscheidenheid. De andere manier gaat uit van de positie van Nederland in zijn internationale omgeving en richt zich op een ruimtelijk ontwikkelingsperspectief voor Nederland als geheel. De nota noemt zeven elementen die samen dit ruimtelijk ontwikkelingsperspectief vormen (Vierde Nota RO, deel A, 1988, p.92): stedelijke knooppunten; regio’s op eigen kracht; stedenring Centraal-Nederland; de Randstad; Nederland-Waterland; behoud en vernieuwing in het landelijk gebied; ondersteunend milieubeleid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "Gemeente Utrecht" ;
            sgpl:text_context "4.7.3 De afstemming gewaardeerd 81. 5. GEMEENTE UTRECHT. 5.1 Korte karakteristiek 84." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "Deze vier beleidsvelden bepalen het beleid ten aanzien van het stedelijk leefmilieu. Als case-studies zijn vier middelgrote steden gekozen, te weten Eindhoven, Groningen, Maastricht en Utrecht. Nadat de ruimtelijke ordening decennia lang alleenheerser was over het omgevingsbeleid, dient nu ook milieubeleid zich steeds nadrukkelijker aan als belangenbehartiger van de omgevingskwaliteit." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Gemeente Maastricht" ;
            sgpl:text_context "3.7.3 De afstemming gewaardeerd 60. 4. GEMEENTE MAASTRICHT. 4.1 Korte karakteristiek 63." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "provincie Limburg" ;
            sgpl:text_context "De internationale oriëntatie van het knooppunt Maastricht-Heerlen heeft ertoe geleid dat op verschillende niveaus samenwerkingsverbanden zijn ontstaan. Zo zijn afspraken gemaakt tussen de steden Aken, Luik, Maastricht, Heerlen en Hasselt en wordt er samengewerkt tussen de provincies Limburg en Luik. In 1979 is een structuurplan verschenen voor het gebied van Maastricht buiten de binnenstad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Gemeente Eindhoven" ;
            sgpl:text_context "1.5 Werkwijze en indeling van het rapport 15. 2. GEMEENTE EINDHOVEN. 2.1 Korte karakteristiek 17." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Deze studie is verricht in het kader van ons afstudeerproject planologie bij de Vakgroep Toegepaste Geografie en Planologie (G & P), behorend bij de Faculteit der Ruimtelijke Wetenschappen van de Universiteit Utrecht. We hebben in de periode oktober 1992 - augustus 1993 met tussenpozen aan dit onderzoek gewerkt. Beleidsstukken die na 1 juli 1993 zijn verschenen zijn in het rapport niet meegenomen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "Gemeente Groningen" ;
            sgpl:text_context "2.7.3 De afstemming gewaardeerd 37. 3. GEMEENTE GRONINGEN. 3.1 Korte karakteristiek 39." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "Deze vier beleidsvelden bepalen het beleid ten aanzien van het stedelijk leefmilieu. Als case-studies zijn vier middelgrote steden gekozen, te weten Eindhoven, Groningen, Maastricht en Utrecht. Nadat de ruimtelijke ordening decennia lang alleenheerser was over het omgevingsbeleid, dient nu ook milieubeleid zich steeds nadrukkelijker aan als belangenbehartiger van de omgevingskwaliteit." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "de binnenstad van Maastricht" ;
            sgpl:text_context "In 1979 is een structuurplan verschenen voor het gebied van Maastricht buiten de binnenstad. Daarnaast is er sinds het begin van de jaren tachtig met tussenpozen gewerkt aan een structuurplan voor de binnenstad van Maastricht. Dit resulteerde na het verschijnen van allerlei tussenrapportages in het 'Structuurplan Binnenstad Maastricht 1982'." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "de Randstad" ;
            sgpl:text_context "De andere manier gaat uit van de positie van Nederland in zijn internationale omgeving en richt zich op een ruimtelijk ontwikkelingsperspectief voor Nederland als geheel. De nota noemt zeven elementen die samen dit ruimtelijk ontwikkelingsperspectief vormen (Vierde Nota RO, deel A, 1988, p.92): stedelijke knooppunten; regio’s op eigen kracht; stedenring Centraal-Nederland; de Randstad; Nederland-Waterland; behoud en vernieuwing in het landelijk gebied; ondersteunend milieubeleid. Uit het laatste punt blijkt dat aan een goede milieukwaliteit een grote waarde wordt toegekend." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "Groningen" ;
            sgpl:text_context "Deze vier beleidsvelden bepalen het beleid ten aanzien van het stedelijk leefmilieu. Als case-studies zijn vier middelgrote steden gekozen, te weten Eindhoven, Groningen, Maastricht en Utrecht. Nadat de ruimtelijke ordening decennia lang alleenheerser was over het omgevingsbeleid, dient nu ook milieubeleid zich steeds nadrukkelijker aan als belangenbehartiger van de omgevingskwaliteit." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744849 ;
            sgpl:spatialText "Welschap" ;
            sgpl:text_context "Zowel Eindhoven als Groningen, Maastricht en Utrecht -de in dit rapport behandelde steden- bezitten een project dat als sleutelproject aangewezen kan gaan worden. In Eindhoven betreft dit de Westcorridor (de Corridor Eindhoven-Veldhoven-Welschap), in Groningen het Stationsgebied Noord-West Groningen, in Maastricht het Sphinx-Céramique-terrein en in Utrecht het Utrecht City Project. Hiermee leveren deze steden een belangrijke bijdrage aan de realisatie van de hoofdlijnen van het onder andere in de Vierde Nota (Extra) en in het NMP(+) verwoorde beleid." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8769 ;
            sgpl:subjectText "externe integratie" ;
            sgpl:text_context "Met nadruk wordt er in het NMP gewezen op de noodzaak tot integratie. Het gaat daarbij om zowel interne integratie -het waarborgen van de onderlinge samenhang tussen de verschillende milieucompartimenten binnen de milieusector- als externe integratie -het tot stand brengen van samenhang van het milieubeleid met andere beleidsterreinen (zie ook § 1.3.3). In figuur 1 is de werking van externe integratie van milieubeleid weergegeven." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "stedelijk leefmilieu" ;
            sgpl:text_context "De indeling van het rapport is als volgt: begonnen wordt met een algemeen gedeelte over beleid op de verschillende overheidsniveaus en vervolgens worden de drie fasen van ons onderzoek -inventarisatie, vergelijking en conclusies/aanbevelingen- behandeld. Hoofdstuk 1 behandelt vier voor het stedelijk leefmilieu relevante beleidsterreinen, te weten ruimtelijke ordening, milieu, verkeer en groen. Achtereenvolgens komen het Rijks-, provinciaal en gemeentelijk beleid aan bod." ],
        [ sgpl:refersToConcept unesco:concept7888 ;
            sgpl:subjectText "omgevingsbeleid" ;
            sgpl:text_context "Deze vier beleidsvelden bepalen het beleid ten aanzien van het stedelijk leefmilieu. Nadat de ruimtelijke ordening decennia lang alleenheerser was over het omgevingsbeleid, dient nu ook milieubeleid zich steeds nadrukkelijker aan als belangenbehartiger van de omgevingskwaliteit. Beide beleidsvelden hebben immers als uitgangspunt de zorg voor een goede kwaliteit van de leefomgeving." ],
        [ sgpl:refersToConcept unesco:concept7888 ;
            sgpl:subjectText "omgevingsbeleid" ;
            sgpl:text_context "Deze vier beleidsvelden bepalen het beleid ten aanzien van het stedelijk leefmilieu. Nadat de ruimtelijke ordening decennia lang alleenheerser was over het omgevingsbeleid, dient nu ook milieubeleid zich steeds nadrukkelijker aan als belangenbehartiger van de omgevingskwaliteit. Beide beleidsvelden hebben immers als uitgangspunt de zorg voor een goede kwaliteit van de leefomgeving." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "stedelijk leefmilieu" ;
            sgpl:text_context "De indeling van het rapport is als volgt: begonnen wordt met een algemeen gedeelte over beleid op de verschillende overheidsniveaus en vervolgens worden de drie fasen van ons onderzoek -inventarisatie, vergelijking en conclusies/aanbevelingen- behandeld. Hoofdstuk 1 behandelt vier voor het stedelijk leefmilieu relevante beleidsterreinen, te weten ruimtelijke ordening, milieu, verkeer en groen. Achtereenvolgens komen het Rijks-, provinciaal en gemeentelijk beleid aan bod." ],
        [ sgpl:refersToConcept unesco:concept8769 ;
            sgpl:subjectText "externe integratie" ;
            sgpl:text_context "Met nadruk wordt er in het NMP gewezen op de noodzaak tot integratie. Het gaat daarbij om zowel interne integratie -het waarborgen van de onderlinge samenhang tussen de verschillende milieucompartimenten binnen de milieusector- als externe integratie -het tot stand brengen van samenhang van het milieubeleid met andere beleidsterreinen (zie ook § 1.3.3). In figuur 1 is de werking van externe integratie van milieubeleid weergegeven." ] ;
    sgpl:thesisID 257 .

sgpl:Thesis258 a sgpl:SGPLThesis ;
    dcterms:creator "Hans van Hastenberg" ;
    dcterms:issued 1993 ;
    dcterms:title "Nederlandse directe investeringen in Hongarije, Polen en Tsjecho-Slowakije",
        "VERSLAGEN VAN LEERONDERZOEK G&I" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:719819,
                geonames:798544,
                geonames:8505031 ;
            sgpl:spatialText "de drie onderzoekslanden" ;
            sgpl:text_context "In de eerste plaats is er een schriftelijke enquête gehouden in Nederland bij de moederbedrijven. Daarnaast werd gevraagd hoe men het investeringsklimaat in de drie onderzoekslanden beoordeelt. Het tweede deel van het onderzoek bestaat uit een serie interviews met Nederlandse investeerders in Hongarije, Polen en Tsjecho-Slowakije." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:719819 ;
            sgpl:spatialText "Hongarije" ;
            sgpl:text_context "In een tijdsbestek van slechts enkele maanden was de politieke en economische omwenteling in Hongarije, Polen, Tsjecho-Slowakije, Roemenië, Bulgarije en de DDR een feit. Deze scriptie richt zich uitsluitend op de Nederlandse directe investeringen in de landen Hongarije, Polen en Tsjecho-Slowakije. Het primaire doel van de scriptie is om meer inzicht te krijgen in de Nederlandse investeringen in deze landen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3054643,
                geonames:3067696,
                geonames:756135 ;
            sgpl:spatialText "de drie hoofdsteden" ;
            sgpl:text_context "Om praktische redenen zijn de interviews met de Nederlandse investeerders alleen in de drie hoofdsteden afgenomen. De Nederlandse investeringen in de drie onderzoekslanden zijn sterk geconcentreerd in de drie hoofdsteden Boedapest, Praag, en Warschau. Door het onderzoek tot deze drie plaatsen te beperken, was het mogelijk om binnen een vrij korte tijd veel bedrijven te interviewen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het primaire doel van de scriptie is om meer inzicht te krijgen in de Nederlandse investeringen in deze landen. In de eerste plaats is er een schriftelijke enquête gehouden in Nederland bij de moederbedrijven. Het doel van de enquête was om te achterhalen wat voor soort bedrijven in Centraal-Europa investeren en wat de achtergronden zijn voor de investering." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Centraal-Europa" ;
            sgpl:text_context "Het onderzoek beperkt zich tot de Nederlandse directe investeringen in Hongarije, Polen en Tsjecho-Slowakije. Het primaire doel van het onderzoek is om meer inzicht te krijgen in de Nederlandse investeringen in Centraal-Europa. Ten eerste meer inzicht in het investeren zelf en ten tweede meer inzicht in de manier waarop de Nederlandse investeerders het investeringsklimaat in de drie Centraaleuropese landen beoordelen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:756135 ;
            sgpl:spatialText "NMB Bank in Warschau" ;
            sgpl:text_context "Goede kantoorruimte is zowel in Boedapest, Praag en Warschau erg moeilijk te vinden. Volgens de NMB Bank in Warschau is uit onderzoek gebleken dat er in Warschau een tekort van 150.000 m2 aan kantoorruimte is. Daarnaast voldoet kantoorruimte, afgezien van de pas nieuw gebouwde hypermoderne complexen, vaak niet aan de eisen die westerse bedrijven eraan stellen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:722437 ;
            sgpl:spatialText "Békéscsaba" ;
            sgpl:text_context "Békéscsaba en Lodz zijn alleen bezocht omdat daar connecties zijn met zusteruniversiteiten. Het bezoek aan deze plaatsen is dus alleen gedaan voor de aanvullende informatie voor het onderzoek (zie onder). De bedrijven die voor een interview benaderd zijn, zijn over het algemeen niet dezelfde bedrijven als die waar een enquêteformulier naar toe is gestuurd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:756135 ;
            sgpl:spatialText "Warschau" ;
            sgpl:text_context "Om praktische redenen zijn de interviews met de Nederlandse investeerders alleen in de drie hoofdsteden afgenomen. De Nederlandse investeringen in de drie onderzoekslanden zijn sterk geconcentreerd in de drie hoofdsteden Boedapest, Praag, en Warschau. Door het onderzoek tot deze drie plaatsen te beperken, was het mogelijk om binnen een vrij korte tijd veel bedrijven te interviewen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3093133 ;
            sgpl:spatialText "Lodz" ;
            sgpl:text_context "Békéscsaba en Lodz zijn alleen bezocht omdat daar connecties zijn met zusteruniversiteiten. Het bezoek aan deze plaatsen is dus alleen gedaan voor de aanvullende informatie voor het onderzoek (zie onder). De bedrijven die voor een interview benaderd zijn, zijn over het algemeen niet dezelfde bedrijven als die waar een enquêteformulier naar toe is gestuurd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3057568 ;
            sgpl:spatialText "Slowakije" ;
            sgpl:text_context "Terwijl er in veel andere ex-communistische landen problemen zijn met etnische minderheden, is de kans hierop in de drie onderzoekslanden door de homogene bevolking vrijwel nihil. Het land waar op dit moment wel enige problemen zijn is Tsjecho-Slowakije. Het gaat hier echter niet om een etnisch probleem, maar om twee deelrepublieken, waarvan het economisch zwakkere Slowakije niet langer wil samenwerken onder de huidige federatie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:798544 ;
            sgpl:spatialText "Polen" ;
            sgpl:text_context "In een tijdsbestek van slechts enkele maanden was de politieke en economische omwenteling in Hongarije, Polen, Tsjecho-Slowakije, Roemenië, Bulgarije en de DDR een feit. Deze scriptie richt zich uitsluitend op de Nederlandse directe investeringen in de landen Hongarije, Polen en Tsjecho-Slowakije. Het primaire doel van de scriptie is om meer inzicht te krijgen in de Nederlandse investeringen in deze landen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7531926 ;
            sgpl:spatialText "provincie Warschau" ;
            sgpl:text_context "In Tgecho-Slowakije en Polen is de concentratie van de investeringen in de hoofdstad minder dan in Hongarije. In Polen was eind 1991 51% van de buitenlandse investeringen geconcentreerd in de provincies Warschau, Poznan, Szczecin en Katowice (Moskwa, 1991). In deze paragraaf zal de geografie van de investeringen op internationale en nationale schaal aan de orde komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3054643 ;
            sgpl:spatialText "Boedapest" ;
            sgpl:text_context "Om praktische redenen zijn de interviews met de Nederlandse investeerders alleen in de drie hoofdsteden afgenomen. De Nederlandse investeringen in de drie onderzoekslanden zijn sterk geconcentreerd in de drie hoofdsteden Boedapest, Praag, en Warschau. Door het onderzoek tot deze drie plaatsen te beperken, was het mogelijk om binnen een vrij korte tijd veel bedrijven te interviewen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:8505031 ;
            sgpl:spatialText "Tsjecho-Slowakije" ;
            sgpl:text_context "In een tijdsbestek van slechts enkele maanden was de politieke en economische omwenteling in Hongarije, Polen, Tsjecho-Slowakije, Roemenië, Bulgarije en de DDR een feit. Deze scriptie richt zich uitsluitend op de Nederlandse directe investeringen in de landen Hongarije, Polen en Tsjecho-Slowakije. Het primaire doel van de scriptie is om meer inzicht te krijgen in de Nederlandse investeringen in deze landen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3067696 ;
            sgpl:spatialText "Praag" ;
            sgpl:text_context "Om praktische redenen zijn de interviews met de Nederlandse investeerders alleen in de drie hoofdsteden afgenomen. De Nederlandse investeringen in de drie onderzoekslanden zijn sterk geconcentreerd in de drie hoofdsteden Boedapest, Praag, en Warschau. Door het onderzoek tot deze drie plaatsen te beperken, was het mogelijk om binnen een vrij korte tijd veel bedrijven te interviewen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4619 ;
            sgpl:subjectText "investeringsklimaat" ;
            sgpl:text_context "Het primaire doel van het onderzoek is om meer inzicht te krijgen in de Nederlandse investeringen in Centraal-Europa. Ten eerste meer inzicht in het investeren zelf en ten tweede meer inzicht in de manier waarop de Nederlandse investeerders het investeringsklimaat in de drie Centraaleuropese landen beoordelen. Voor het onderzoek naar de Nederlandse directe investeringen in Hongarije, Polen en Tsjecho-Slowakije ben ik dan ook tot de volgende probleemstelling gekomen:" ],
        [ sgpl:refersToConcept unesco:concept8813 ;
            sgpl:subjectText "privatisering" ;
            sgpl:text_context "Ook zal in dit hoofdstuk besproken worden waarom de drie onderzoekslanden vanaf de revolutie zo fanatiek zijn in het aantrekken van buitenlandse investeringen. Tot slot zal apart worden ingegaan op de privatisering van de staatsbedrijven. Dit vanwege het belang van de privatisering voor het omvormingsproces en het verband tussen privatisering en buitenlandse investeringen." ],
        [ sgpl:refersToConcept unesco:concept11040 ;
            sgpl:subjectText "directe investeringen" ;
            sgpl:text_context "Het aantal westerse bedrijven dat in de voormalige communistische landen geïnvesteerd heeft, is in korte tijd dan ook sterk toegenomen. Deze scriptie richt zich uitsluitend op de Nederlandse directe investeringen in de landen Hongarije, Polen en Tsjecho-Slowakije. Het primaire doel van de scriptie is om meer inzicht te krijgen in de Nederlandse investeringen in deze landen." ],
        [ sgpl:refersToConcept unesco:concept4619 ;
            sgpl:subjectText "investeringsklimaat" ;
            sgpl:text_context "Het primaire doel van het onderzoek is om meer inzicht te krijgen in de Nederlandse investeringen in Centraal-Europa. Ten eerste meer inzicht in het investeren zelf en ten tweede meer inzicht in de manier waarop de Nederlandse investeerders het investeringsklimaat in de drie Centraaleuropese landen beoordelen. Voor het onderzoek naar de Nederlandse directe investeringen in Hongarije, Polen en Tsjecho-Slowakije ben ik dan ook tot de volgende probleemstelling gekomen:" ],
        [ sgpl:refersToConcept unesco:concept11040 ;
            sgpl:subjectText "directe investeringen" ;
            sgpl:text_context "Het aantal westerse bedrijven dat in de voormalige communistische landen geïnvesteerd heeft, is in korte tijd dan ook sterk toegenomen. Deze scriptie richt zich uitsluitend op de Nederlandse directe investeringen in de landen Hongarije, Polen en Tsjecho-Slowakije. Het primaire doel van de scriptie is om meer inzicht te krijgen in de Nederlandse investeringen in deze landen." ],
        [ sgpl:refersToConcept unesco:concept8813 ;
            sgpl:subjectText "privatisering" ;
            sgpl:text_context "Ook zal in dit hoofdstuk besproken worden waarom de drie onderzoekslanden vanaf de revolutie zo fanatiek zijn in het aantrekken van buitenlandse investeringen. Tot slot zal apart worden ingegaan op de privatisering van de staatsbedrijven. Dit vanwege het belang van de privatisering voor het omvormingsproces en het verband tussen privatisering en buitenlandse investeringen." ] ;
    sgpl:thesisID 258 .

sgpl:Thesis259 a sgpl:SGPLThesis ;
    dcterms:creator "Ruud Jansen Venneboer" ;
    dcterms:issued 1993 ;
    dcterms:title "WELKOM OP DE WONINGMARKT!",
        "woonruimteverdeling in beweging" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Noord-Holland" ;
            sgpl:text_context "Zetten we de bekendheid met model Delft af tegen de regionale situering van de corporaties, dan ontstaat het volgende beeld: Heel duidelijk is het verschil tussen het Westen van het land (Noord- en Zuid-Holland en Utrecht) en de overige provincies, waarbij het Noorden het laagst scoort. De verklaring hiervoor is waarschijnlijk het feit dat we in het Noorden (en in mindere mate ook in het Oosten en Zuiden) te maken met veel (relatief kleine) plattelandsgemeenten waar kleine corporaties opereren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743608 ;
            sgpl:spatialText "Zutphen" ;
            sgpl:text_context "Daarnaast is er nog een groep mensen zonder wiens medewerking deze scriptie niet eens geschreven had kunnen worden, namelijk de medewerkers van de 120 woning- bouwverenigingen die zo vriendelijk waren mee te werken aan het onderzoek. Heel veel dank hiervoor! Ruud Jansen Venneboer, augustus 1993 Eventuele vragen of opmerkingen zijn van harte welkom op het volgende adres: van Essenstraat 89, 7203 DK, Zutphen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Dit rapport is tot stand gekomen in het kader van mijn doctoraal- onderzoek Stad- en Plattelandsgeografie aan de Rijks Universiteit Utrecht. De begeleider van het onderzoek is Drs. R.B. Jobse, aan wie ik veel dank verschuldigd ben. Zonder zijn kennis, adviezen en stimulering, had deze scriptie niet de kwaliteit gehad die het nu heeft." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Is men bekend met het model, heeft men er een mening over en, tot slot, heeft men zelf plannen voor een andere manier van woonruimteverdeling. Deze vragen zijn nader uitgewerkt en als zodanig voorgelegd aan 120 woningcorporaties verspreid over heel Nederland. De analyse van de resultaten vindt u in dit rapport." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Woonruimteverdeling hoeft echter niet op exact dezelfde manier te geschieden als in Delft, om het predikaat \"marktgericht\" te verkrijgen. De gemeente Utrecht bijvoorbeeld, heeft dit recent ingevoerd. De belangrijkste reden voor deze nuance is dat een urgentiepuntenlijst zou leiden tot een rechtvaardiger toewijzing dan bij het beperkte aantal criteria dat in Delft wordt gebruikt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757345 ;
            sgpl:spatialText "gemeente Delft" ;
            sgpl:text_context "De aanleiding tot het doen van dit onderzoek was een artikel in de Volkskrant van 28 december '91, waarin melding werd gemaakt van een nieuwe manier van woonruimteverdeling. Een model dat werd betiteld als \"marktgericht\", en als zodanig ontwikkeld en uitgeprobeerd was door de gemeente Delft en de aldaar samenwerkende woningcorporaties. Een model dat op het eerste oog het ei van Columbus lijkt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757344 ;
            sgpl:spatialText "Delft" ;
            sgpl:text_context "De aanleiding tot het doen van dit onderzoek was een artikel in de Volkskrant van 28 december '91, waarin melding werd gemaakt van een nieuwe manier van woonruimteverdeling. Een model dat werd betiteld als \"marktgericht\", en als zodanig ontwikkeld en uitgeprobeerd was door de gemeente Delft en de aldaar samenwerkende woningcorporaties. Een model dat op het eerste oog het ei van Columbus lijkt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756644 ;
            sgpl:spatialText "Drachten" ;
            sgpl:text_context "Voor de eerste gelden de oude regels, voor de tweede zal men op een andere manier te werk moeten gaan wil men leegstand voorkomen. Onder andere Deventer, Enschede en Drachten (Woningraad 10/11, 1992, p.4/40), werken op een dergelijke manier. Omdat er een steeds duidelijker onderscheid valt te maken tussen urgent woningzoekenden en personen die wel voor (vaak andere en betere) woonruimte staan ingeschreven maar niet urgent zijn, gaan een aantal gemeenten en corporaties (Deventer, Den Bosch) ertoe over het woningzoekendenbestand als zodanig in tweeën te splitsen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756987 ;
            sgpl:spatialText "Deventer" ;
            sgpl:text_context "Voor de eerste gelden de oude regels, voor de tweede zal men op een andere manier te werk moeten gaan wil men leegstand voorkomen. Onder andere Deventer, Enschede en Drachten (Woningraad 10/11, 1992, p.4/40), werken op een dergelijke manier. Omdat er een steeds duidelijker onderscheid valt te maken tussen urgent woningzoekenden en personen die wel voor (vaak andere en betere) woonruimte staan ingeschreven maar niet urgent zijn, gaan een aantal gemeenten en corporaties (Deventer, Den Bosch) ertoe over het woningzoekendenbestand als zodanig in tweeën te splitsen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756071 ;
            sgpl:spatialText "Enschede" ;
            sgpl:text_context "Voor de eerste gelden de oude regels, voor de tweede zal men op een andere manier te werk moeten gaan wil men leegstand voorkomen. Onder andere Deventer, Enschede en Drachten (Woningraad 10/11, 1992, p.4/40), werken op een dergelijke manier. Omdat er een steeds duidelijker onderscheid valt te maken tussen urgent woningzoekenden en personen die wel voor (vaak andere en betere) woonruimte staan ingeschreven maar niet urgent zijn, gaan een aantal gemeenten en corporaties (Deventer, Den Bosch) ertoe over het woningzoekendenbestand als zodanig in tweeën te splitsen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Van de overige bijna 50% springen twee concepten eruit. Zo adverteert een corporatie in Friesland al in de landelijke media, in de hoop bewoners te trekken die de combinatie rust, ruimte, groen en (relatief) goedkoop wonen een aanvaardbaar alternatief vinden voor het wonen in bijvoorbeeld de drukke en dure Randstad. Ook het inschakelen van makelaars voor het verhuren van door hun prijs moeilijk verhuurbare woningen, gebeurt reeds in de praktijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "In Den Haag is sinds enige tijd een variant op bovengenoemde maatregel ingevoerd (Woningraad 1, 1991, p.34). Ook daar geldt een splitsing tussen urgenten en woonwensers (A en B compartiment). A-kandidaten krijgen de garantie dat ze binnen een jaar aan woonruimte worden geholpen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743698 ;
            sgpl:spatialText "Zuid-Holland" ;
            sgpl:text_context "Zetten we de bekendheid met model Delft af tegen de regionale situering van de corporaties, dan ontstaat het volgende beeld: Heel duidelijk is het verschil tussen het Westen van het land (Noord- en Zuid-Holland en Utrecht) en de overige provincies, waarbij het Noorden het laagst scoort. De verklaring hiervoor is waarschijnlijk het feit dat we in het Noorden (en in mindere mate ook in het Oosten en Zuiden) te maken met veel (relatief kleine) plattelandsgemeenten waar kleine corporaties opereren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747351 ;
            sgpl:spatialText "Den Bosch" ;
            sgpl:text_context "Onder andere Deventer, Enschede en Drachten (Woningraad 10/11, 1992, p.4/40), werken op een dergelijke manier. Omdat er een steeds duidelijker onderscheid valt te maken tussen urgent woningzoekenden en personen die wel voor (vaak andere en betere) woonruimte staan ingeschreven maar niet urgent zijn, gaan een aantal gemeenten en corporaties (Deventer, Den Bosch) ertoe over het woningzoekendenbestand als zodanig in tweeën te splitsen. De eerstgenoemde groep zal met voorrang worden geholpen, zij het dat zij minder eisen mogen stellen en hun urgentie zullen verliezen wanneer na enkele aanbiedingen nog steeds geen woning is geaccepteerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Friesland" ;
            sgpl:text_context "Van de overige bijna 50% springen twee concepten eruit. Zo adverteert een corporatie in Friesland al in de landelijke media, in de hoop bewoners te trekken die de combinatie rust, ruimte, groen en (relatief) goedkoop wonen een aanvaardbaar alternatief vinden voor het wonen in bijvoorbeeld de drukke en dure Randstad. Ook het inschakelen van makelaars voor het verhuren van door hun prijs moeilijk verhuurbare woningen, gebeurt reeds in de praktijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743476 ;
            sgpl:spatialText "gemeente Zwolle" ;
            sgpl:text_context "Vandaar dat gemeenten meer en meer overwegen deze parkeerstand op te heffen, danwel aan regels te binden. Zo is de gemeente Zwolle ertoe overgegaan een maximum van twee jaar aan deze parkeerstand te verbinden. Men kan aldus nog maximaal 30 punten verzamelen (SWZ, 1991, p.35)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept13608 ;
            sgpl:subjectText "marktgericht" ;
            sgpl:text_context "De aanleiding tot het doen van dit onderzoek was een artikel in de Volkskrant van 28 december '91, waarin melding werd gemaakt van een nieuwe manier van woonruimteverdeling. Een model dat werd betiteld als 'marktgericht', en als zodanig ontwikkeld en uitgeprobeerd was door de gemeente Delft en de aldaar samenwerkende woningcorporaties. Een model dat op het eerste oog het ei van Columbus lijkt." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "woonruimteverdeling" ;
            sgpl:text_context "Deze stelling geeft goed weer waarmee ik mij, tijdens het doen van dit onderzoek, heb beziggehouden. Zoeken naar de waarheid omtrent vernieuwingen in de woonruimteverdeling, zonder deze te vinden. Dé waarheid vinden kan namelijk alleen als deze bestaat." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "woningcorporaties" ;
            sgpl:text_context "Is men bekend met het model, heeft men er een mening over en, tot slot, heeft men zelf plannen voor een andere manier van woonruimteverdeling. Deze vragen zijn nader uitgewerkt en als zodanig voorgelegd aan 120 woningcorporaties verspreid over heel Nederland. De analyse van de resultaten vindt u in dit rapport." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "woonruimteverdeling" ;
            sgpl:text_context "Deze stelling geeft goed weer waarmee ik mij, tijdens het doen van dit onderzoek, heb beziggehouden. Zoeken naar de waarheid omtrent vernieuwingen in de woonruimteverdeling, zonder deze te vinden. Dé waarheid vinden kan namelijk alleen als deze bestaat." ],
        [ sgpl:refersToConcept unesco:concept13608 ;
            sgpl:subjectText "marktgericht" ;
            sgpl:text_context "De aanleiding tot het doen van dit onderzoek was een artikel in de Volkskrant van 28 december '91, waarin melding werd gemaakt van een nieuwe manier van woonruimteverdeling. Een model dat werd betiteld als 'marktgericht', en als zodanig ontwikkeld en uitgeprobeerd was door de gemeente Delft en de aldaar samenwerkende woningcorporaties. Een model dat op het eerste oog het ei van Columbus lijkt." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "woningcorporaties" ;
            sgpl:text_context "Is men bekend met het model, heeft men er een mening over en, tot slot, heeft men zelf plannen voor een andere manier van woonruimteverdeling. Deze vragen zijn nader uitgewerkt en als zodanig voorgelegd aan 120 woningcorporaties verspreid over heel Nederland. De analyse van de resultaten vindt u in dit rapport." ] ;
    sgpl:thesisID 259 .

sgpl:Thesis26 a sgpl:SGPLThesis ;
    dcterms:creator "J.T. Bergstra",
        "K. Dokter" ;
    dcterms:issued 1960 ;
    dcterms:title "ONDERZOEK FORENSENKAMPEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744042 ;
            sgpl:spatialText "Zandvoort" ;
            sgpl:text_context "Lage Vuursche ” 80 huisjes. Zandvoort 780 huisjes. Meer dan de helft arbeiders. Oostvoorne l$00 huisjes." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2752018 ;
            sgpl:spatialText "Lage Vuursche" ;
            sgpl:text_context "Doorn ” 12 huisjes. Lage Vuursche ” 80 huisjes. Zandvoort 780 huisjes." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747492 ;
            sgpl:spatialText "Schoorl" ;
            sgpl:text_context "2 zouden in hoofdzaak uit arbeider— kampeerders bestaan. Dit zijn: Schoorl middenstandskamp 50 huisjes. Doorn ” 12 huisjes." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Deze drie factoren samengenomen, erden 5 kampen uitgezocht in overleg met de Nederlandse Kampeerraad. Alleen de Kampen die betrekking hadden op de Randstad .erden onderzocht, covendien werden doelbewust geen''slechte \"kampen onderzocht. Onder slecnte kampen • erden dan verstaan, kampen ra r antoestanden zouden bestaan uit een oogpunt van hygiene, en wat r de beheerder een totalitaire macht heeft over de kampeerders in die zin, dut de kampeerJ.er niet -oker is van zijn plat ts, ieder juar bv." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755457 ;
            sgpl:spatialText "hot Gooi" ;
            sgpl:text_context "Het zomerverblijf in tont, tenthuisje en zomerhuisje werd geaccepteerd docr alle lagen van de bevolking, ook deer de middenstand. Pe grote conglomeraties tenthuisjes langs de Noordzeekust on in hot Gooi werden aanvankelijk volkstentenkampen genoemd, dit als gevolg van het feit dat vooral de arbeiders deze terreinen bevolkten. Het tenthuisjo verschafte do mogelijkheid on met hot helo gezin relatief goedkoop met vacantie te gaan, of elk weekend naar buiten to trekken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Zeer duidelijk blijkt dus het belang van Rotterdam voor dit forensonkum . Bovendien tolt het kamp buiten de agglomeratie van do Kaasstad bijna in het geheel geen kampeerders.-eigenaars. Binnen de gemeente Rotterdam kun men de eigenaars verder differentiëren naar woonplaats." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Op vele kampeerterreinen rond de grote steden zal een analoge ontwikkeling hebben plaats gevonden. Reeds in 1039 'eikte do \"invloedsfeer\" van het Amstordamse tenthuis jeswo zen tot Fchocrl n Lage Vuurse. Pat dit door do tentkampeerders net lede ogen werd aan- jozien behoeft geen betoog: zij vonden \"hun\" terreinen vclgopakt staan act de gehele zoner overblijvende tenthuisjos." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756686 ;
            sgpl:spatialText "Doorn" ;
            sgpl:text_context "Dit zijn: Schoorl middenstandskamp 50 huisjes. Doorn ” 12 huisjes. Lage Vuursche ” 80 huisjes." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Het Kruininger Gors" ;
            sgpl:text_context "Algemeen beeld van het kamp te üostvoorne: d t Krniiiin.r.ar Gors. Het recreaticcóntrum \"Het Kruininger Gors\" is een publiekrechtelijk lichaam mot de gemeenten Rotterdam en üostvoorne als geïnteresseerden. 'Raad von Bestuur en Dagelijks Bestuur worden aan? awezen door do beide gemeunterdfilen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749330 ;
            sgpl:spatialText "Oostvoorne" ;
            sgpl:text_context "Zandvoort 780 huisjes. Oostvoorne l$00 huisjes. idem. Een vragenslijst werd opgesteld voor te bezoeken kampeerders." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "Tenthuisjes" ;
            sgpl:text_context "Reeds in 1039 'eikte do \"invloedsfeer\" van het Amstordamse tenthuis jeswo zen tot Fchocrl >n Lage Vuurse. Pat dit door do tentkampeerders net lede ogen werd aan- jozien behoeft geen betoog: zij vonden \"hun\" terreinen vclgopakt staan act de gehele zoner overblijvende tenthuisjos. Po terreinoxplcitanten javen de voorkeur aan de huisjes: deze verzekerden oen moer stabiel in- ternen." ],
        [ sgpl:refersToConcept unesco:concept367 ;
            sgpl:subjectText "Recreatiegebieden" ;
            sgpl:text_context "Is de woonsituatie in de woongemeente te veranderen, zodat de be- hoefte wordt afgeremd. Is het mogelijk de forensenkampen zodanig te vestigen, dat zij niet de meest attractieve recreatiegebieden in beslag nemen. Het vooronderzoek richtte zich voornamelijk op: êj groei van de forensenkampen en het forensenkamperen." ],
        [ sgpl:refersToConcept unesco:concept16136 ;
            sgpl:subjectText "Forensenkamperen" ;
            sgpl:text_context "Pa afwezigheid van allorlei maatschappelijke apolro- els heeft grote bekoring, al krijgt men in voel gevallen eon niet nis ,e verstane hoeveelheid kampregols, waar men zich stipt aan hooft te hou- ten, ervoer in de plaats. In het voorga nde is reeds het begrip forensenkamjeren ter sprake gekenen. Dit verbond tussen tenthuisjos en foronsonkamperen lag in het beginsta- ,um v/ellicht moer voer de hand dan de hedendaagse toestand dit doet i erkomen." ],
        [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "Tenthuisjes" ;
            sgpl:text_context "Reeds in 1039 'eikte do \"invloedsfeer\" van het Amstordamse tenthuis jeswo zen tot Fchocrl >n Lage Vuurse. Pat dit door do tentkampeerders net lede ogen werd aan- jozien behoeft geen betoog: zij vonden \"hun\" terreinen vclgopakt staan act de gehele zoner overblijvende tenthuisjos. Po terreinoxplcitanten javen de voorkeur aan de huisjes: deze verzekerden oen moer stabiel in- ternen." ],
        [ sgpl:refersToConcept unesco:concept16136 ;
            sgpl:subjectText "Forensenkamperen" ;
            sgpl:text_context "Pa afwezigheid van allorlei maatschappelijke apolro- els heeft grote bekoring, al krijgt men in voel gevallen eon niet nis ,e verstane hoeveelheid kampregols, waar men zich stipt aan hooft te hou- ten, ervoer in de plaats. In het voorga nde is reeds het begrip forensenkamjeren ter sprake gekenen. Dit verbond tussen tenthuisjos en foronsonkamperen lag in het beginsta- ,um v/ellicht moer voer de hand dan de hedendaagse toestand dit doet i erkomen." ],
        [ sgpl:refersToConcept unesco:concept367 ;
            sgpl:subjectText "Recreatiegebieden" ;
            sgpl:text_context "Is de woonsituatie in de woongemeente te veranderen, zodat de be- hoefte wordt afgeremd. Is het mogelijk de forensenkampen zodanig te vestigen, dat zij niet de meest attractieve recreatiegebieden in beslag nemen. Het vooronderzoek richtte zich voornamelijk op: êj groei van de forensenkampen en het forensenkamperen." ] ;
    sgpl:thesisID 26 .

sgpl:Thesis260 a sgpl:SGPLThesis ;
    dcterms:creator "Muriël Pels",
        "Taco Jansonius" ;
    dcterms:issued 1993 ;
    dcterms:title "Lokale ontwikkelingsinitiatieven",
        "in Noordwest-Tarn" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3028342 ;
            sgpl:spatialText "Castelnau-de-Montmirail" ;
            sgpl:text_context "4.1 Inleiding. In het uiterste noordwesten van het departement Tarn, op zo'n 60 kilometer ten noordoosten van Toulouse, liggen de 3 cantons Castelnau-de-Montmirail, Cordes en Vaour die tezamen de microregio Noordwest-Tarn vormen (zie figuur 4.1). Dit gebied beslaat 538 km2 en telt 8.786 inwoners (1990)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Faculteit der Ruimtelijke Wetenschappen. Universiteit Utrecht. BIBLIOTHEEKCENTRUM UITHOF RIJKSUNIVERSITEIT TE UTRECHT." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2972315 ;
            sgpl:spatialText "Toulouse" ;
            sgpl:text_context "4.1 Inleiding. In het uiterste noordwesten van het departement Tarn, op zo'n 60 kilometer ten noordoosten van Toulouse, liggen de 3 cantons Castelnau-de-Montmirail, Cordes en Vaour die tezamen de microregio Noordwest-Tarn vormen (zie figuur 4.1). Dit gebied beslaat 538 km2 en telt 8.786 inwoners (1990)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6444977 ;
            sgpl:spatialText "Vaour" ;
            sgpl:text_context "4.1 Inleiding. In het uiterste noordwesten van het departement Tarn, op zo'n 60 kilometer ten noordoosten van Toulouse, liggen de 3 cantons Castelnau-de-Montmirail, Cordes en Vaour die tezamen de microregio Noordwest-Tarn vormen (zie figuur 4.1). Dit gebied beslaat 538 km2 en telt 8.786 inwoners (1990)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Cordes" ;
            sgpl:text_context "4.1 Inleiding. In het uiterste noordwesten van het departement Tarn, op zo'n 60 kilometer ten noordoosten van Toulouse, liggen de 3 cantons Castelnau-de-Montmirail, Cordes en Vaour die tezamen de microregio Noordwest-Tarn vormen (zie figuur 4.1). Dit gebied beslaat 538 km2 en telt 8.786 inwoners (1990)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3017382 ;
            sgpl:spatialText "Frankrijk" ;
            sgpl:text_context "1.1 Inleiding. In het zuidwesten van Frankrijk ligt een kleine rurale regio, Noordwest-Tarn, die al meer dan honderd jaar deelt in het lot van het grootste deel van het Franse platteland: stagnatie en achteruitgang. Centraal element in deze problematiek is het massaal wegtrekken van de bevolking, de zogenaamde \"exode rural\"." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2993955 ;
            sgpl:spatialText "Midi-Pyrénées" ;
            sgpl:text_context "3.1 Inleiding. Midi-Pyrénées (zie figuur 3.1) is met een oppervlakte van 45.000 km2 iets groter dan Nederland. Het is de grootste van de 22 planregio's (régions de programme) in Frankrijk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2973362 ;
            sgpl:spatialText "Noordwest-Tarn" ;
            sgpl:text_context "Recentelijk staan de termen \"lokale ontwikkeling\" en \"lokale ontwikkelingsinitiatieven\" centraal in de strategieën die de verschillende regio's in stelling brengen. In deze scriptie zal onderzocht worden wat lokale ontwikkelingsinitiatieven betekenen voor de regio Noordwest-Tarn. De probleemstelling luidt: Wat is de rol van lokale ontwikkelingsinitiatieven in regionale ontwikkeling?" ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionale ontwikkeling" ;
            sgpl:text_context "Als onderzoeksregio is gekozen voor een kleine rurale regio in Zuidwest-Frankrijk: de regio Noordwest-Tam. Wat is de rol van lokale ontwikkelingsinitiatieven in regionale ontwikkeling? Operationalisering in onderzoeksvragen: 1. Hoe ontstaan en functioneren lokale ontwikkelingsinitiatieven?" ],
        [ sgpl:refersToConcept unesco:concept3621 ;
            sgpl:subjectText "lokale ontwikkelingsinitiatieven" ;
            sgpl:text_context "Met dit handelen van mensen komen we uit bij een begrip dat centraal staat in deze scriptie én in de regionale geografie van dit moment: lokale ontwikkelingsinitiatieven. Wat is nu eigenlijk precies het effect van lokale ontwikkelingsinitiatieven voor de ontwikkeling van een regio? Het is deze vraag die in deze scriptie centraal zal staan." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "ruraal toerisme" ;
            sgpl:text_context "Het toerisme is misschien de sector van de toekomst in Noordwest-Tam. Het gaat hierbij om het ontwikkelen van het ruraal toerisme, gebaseerd op landschap, natuur, rust, cultuurgoed en openluchtrecreatie. De laatste jaren zijn er diverse initiatieven op dit gebied ondernomen." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "ruraal toerisme" ;
            sgpl:text_context "Het toerisme is misschien de sector van de toekomst in Noordwest-Tam. Het gaat hierbij om het ontwikkelen van het ruraal toerisme, gebaseerd op landschap, natuur, rust, cultuurgoed en openluchtrecreatie. De laatste jaren zijn er diverse initiatieven op dit gebied ondernomen." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionale ontwikkeling" ;
            sgpl:text_context "Als onderzoeksregio is gekozen voor een kleine rurale regio in Zuidwest-Frankrijk: de regio Noordwest-Tam. Wat is de rol van lokale ontwikkelingsinitiatieven in regionale ontwikkeling? Operationalisering in onderzoeksvragen: 1. Hoe ontstaan en functioneren lokale ontwikkelingsinitiatieven?" ],
        [ sgpl:refersToConcept unesco:concept3621 ;
            sgpl:subjectText "lokale ontwikkelingsinitiatieven" ;
            sgpl:text_context "Met dit handelen van mensen komen we uit bij een begrip dat centraal staat in deze scriptie én in de regionale geografie van dit moment: lokale ontwikkelingsinitiatieven. Wat is nu eigenlijk precies het effect van lokale ontwikkelingsinitiatieven voor de ontwikkeling van een regio? Het is deze vraag die in deze scriptie centraal zal staan." ] ;
    sgpl:thesisID 260 .

sgpl:Thesis261 a sgpl:SGPLThesis ;
    dcterms:creator "André Knulst",
        "Kees Jobse" ;
    dcterms:issued 1993 ;
    dcterms:title "De winst van ecologische verstedelijking",
        "Een bijdrage aan de discussie rond \"Utrecht-West\"" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Vleuten-De Meern" ;
            sgpl:text_context "Het in 1991 opgerichte Regionaal Beraad Utrecht (RBU), bestaande uit vertegenwoordigers van de gemeenten binnen het stadsgewest Utrecht, nam de taak tot uitvoering op zich. In de Nota Hoofdlijnen Intergemeentelijk Structuurplan presenteerde het RBU haar ruimtelijke visie, op de locaties Vleuten-De Meern en Rijnenburg zullen 32.500 woningen worden gebouwd. Volgens plan zal het bestuur van het RBU de Nota Hoofdlijnen eind 1993 aannemen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Rijnenburg" ;
            sgpl:text_context "Het in 1991 opgerichte Regionaal Beraad Utrecht (RBU), bestaande uit vertegenwoordigers van de gemeenten binnen het stadsgewest Utrecht, nam de taak tot uitvoering op zich. In de Nota Hoofdlijnen Intergemeentelijk Structuurplan presenteerde het RBU haar ruimtelijke visie, op de locaties Vleuten-De Meern en Rijnenburg zullen 32.500 woningen worden gebouwd. Volgens plan zal het bestuur van het RBU de Nota Hoofdlijnen eind 1993 aannemen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "De SMF is de doctoraal studenten sociale geografie, Andre Knuist en Kees Jobse veel dank verschuldigd voor hun grote en deskundige inzet in het afgelopen jaar. Tevens wil zij Professor Dr. Ter Heijde en Drs. Peter Donkersloot bedanken voor de begeleiding van het afstudeerproject vanuit de Universiteit Utrecht. Nico Papineau Salm directeur" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754602 ;
            sgpl:spatialText "Heicopse polder" ;
            sgpl:text_context "In het in de EHS aangewezen kerngebied Haarzuilens is het beleid gericht op duurzame instandhouding door bescherming, beheer en de instelling van bufferzones. Als natuurontwikkelingsgebieden zijn de polders Haarrijn en Lage Weide n de Heicopse polder aangewezen. De keuze voor deze gebieden is gemaakt op basis van de aanwezige natuurlijke en landschappelijke potenties, de samenhang met de kerngebieden en de mogelijkheden tot versterking van de waarden door koppeling aan de daar geplande bossen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht-West" ;
            sgpl:text_context "Hierbij gaat het om verantwoord gebruik van bouwmateriaal, zodanig bouwen dat er minder energie en water verbruikt wordt. Van het onderzoek is in brochurevorm een publieksversie verschenen, die een duidelijke bijdrage heeft geleverd aan de meningsvorming bij bestuurders inzake Utrecht-West. De SMF is de doctoraal studenten sociale geografie, Andre Knuist en Kees Jobse veel dank verschuldigd voor hun grote en deskundige inzet in het afgelopen jaar." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Polder Haarrijn" ;
            sgpl:text_context "Dit deelgebied is verder een belangrijk weidevogelgebied. De polder Haarrijn, een restontginning, is minder open door de geringe diepte, veroorzaakt door de A2. De opgaande beplanting van een aantal bosstroken heeft een positief effect op de ruimtebeleving." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754981 ;
            sgpl:spatialText "Haarzuilens" ;
            sgpl:text_context "In de regeringsbeslissing Visie Landschap (LNV 1992) wordt, naast het streven naar behoud van cultuurhistorische elementen, ook gepleit voor het benadrukken van de kenmerkende verschillen tussen de besloten stroomruggen en de open komgronden. In het in de EHS aangewezen kerngebied Haarzuilens is het beleid gericht op duurzame instandhouding door bescherming, beheer en de instelling van bufferzones. Als natuurontwikkelingsgebieden zijn de polders Haarrijn en Lage Weide n de Heicopse polder aangewezen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stadsgewest Utrecht" ;
            sgpl:text_context "In de aanloop voor het werkplan 1993 kwam de vraag naar voren hoe de Stichtse Milieufederatie zou gaan reageren op de grootschalige nieuwbouwplannen in het stadsgewest Utrecht. Op een afstand volgen, kritiek leveren vanuit de zijlijn of een eigen visie voor de inrichting en de bouw van het stadsgewest uitwerken. Er is gekozen voor het laatste." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Stedelijke milieudifferentiatie" ;
            sgpl:text_context "De kommen spelen dan ook een belangrijke rol als natuurontwikkelingsgebieden en verbindingszones in de ecologische hoofdstructuur. Voor toepassing van het principe van stedelijke milieudifferentiatie dienen verschillende stedelijke milieus te worden onderscheiden. In deze milieus worden diverse stedelijke functies gemengd zodat geen uniforme stadsdelen ontstaan, maar leefbare wijken waarin uiteenlopende functies in harmonie naast elkaar voorkomen." ],
        [ sgpl:refersToConcept unesco:concept5925 ;
            sgpl:subjectText "Ecopolis-strategie" ;
            sgpl:text_context "Om tot de bovengenoemde doelstelling te komen is in dit onderzoek de strategie van het rapport Ecologisch Verantwoord Stedelijke Ontwikkeling (EVSO) gehanteerd. Het EVSO-rapport draagt het ecopolis-strategiekader aan als algemeen kader voor ecologisch verantwoorde, dus milieuvriendelijke, stedelijke ontwikkeling. Eén van de drie aandachtsvelden van dit kader is gericht op het vormen van een levende stad." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Ecologische verstedelijking" ;
            sgpl:text_context "Het resultaat van deze studie ligt nu voor u. Het onderzoek dat op een voortreffelijke wijze is verricht laat zien dat ecologische verstedelijking mogelijk is en duidelijke milieuwinst kan opleveren. Het onderzoek heeft de bestaande natuur- en landschappelijke waarden in kaart gebracht en vervolgens aangegeven hoe deze bij de inrichting van de stad behouden en versterkt kunnen worden." ],
        [ sgpl:refersToConcept unesco:concept5925 ;
            sgpl:subjectText "Ecopolis-strategie" ;
            sgpl:text_context "Om tot de bovengenoemde doelstelling te komen is in dit onderzoek de strategie van het rapport Ecologisch Verantwoord Stedelijke Ontwikkeling (EVSO) gehanteerd. Het EVSO-rapport draagt het ecopolis-strategiekader aan als algemeen kader voor ecologisch verantwoorde, dus milieuvriendelijke, stedelijke ontwikkeling. Eén van de drie aandachtsvelden van dit kader is gericht op het vormen van een levende stad." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Ecologische verstedelijking" ;
            sgpl:text_context "Het resultaat van deze studie ligt nu voor u. Het onderzoek dat op een voortreffelijke wijze is verricht laat zien dat ecologische verstedelijking mogelijk is en duidelijke milieuwinst kan opleveren. Het onderzoek heeft de bestaande natuur- en landschappelijke waarden in kaart gebracht en vervolgens aangegeven hoe deze bij de inrichting van de stad behouden en versterkt kunnen worden." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Stedelijke milieudifferentiatie" ;
            sgpl:text_context "De kommen spelen dan ook een belangrijke rol als natuurontwikkelingsgebieden en verbindingszones in de ecologische hoofdstructuur. Voor toepassing van het principe van stedelijke milieudifferentiatie dienen verschillende stedelijke milieus te worden onderscheiden. In deze milieus worden diverse stedelijke functies gemengd zodat geen uniforme stadsdelen ontstaan, maar leefbare wijken waarin uiteenlopende functies in harmonie naast elkaar voorkomen." ] ;
    sgpl:thesisID 261 .

sgpl:Thesis262 a sgpl:SGPLThesis ;
    dcterms:creator "Ton Kruyshoop" ;
    dcterms:issued 1993 ;
    dcterms:title "BASISVOORZIENINGEN IN NIEUWE WOONGEBIEDEN",
        "KENNISGEBRUIK BIJ DE PLANNING VAN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Deze scriptie is het verslag van een onderzoek naar kennisgebruik bij de planning van basisvoorzieningen dat verricht is als onderdeel van het doctoraalexamen sociale geografie, specialisatie planologie, bij de Faculteit der Ruimtelijke Wetenschappen van de Universiteit Utrecht. Het onderzoek vond plaats in de periode november 1992 - augustus 1993 en is gedeeltelijk uitgevoerd in stageverband bij de afdeling Regionaal Ontwikkelingsbeleid van de Rijksplanologische Dienst in Den Haag. Op deze plaats wil ik mijn beide begeleiders, prof. dr. H. ter Heide (UU/RPD) en drs. Nico Tetteroo (RPD) bedanken voor de goede begeleiding van het onderzoek en voor de nuttige tips en hulp die ze mij gegeven hebben." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755420 ;
            sgpl:spatialText "Gouda Goverwelle" ;
            sgpl:text_context "5.3.3 Zoetermeer Rokkeveen. 5.3.4 Gouda Goverwelle. Algemene informatie De uitbreidingswijk Goverwelle is gelegen aan de oostzijde van Gouda." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In de beleidsvoornemens van de Vierde nota extra (1990, p. 25) wordt de totale uitbreidingsbehoefte van de woningvoorraad van de vier Randstadprovincies voor de periode 1995-2015 gesteld op circa 485.000 woningen. In het eind 1992 verschenen Trendrapport Volkshuisvesting wordt de uitbreidingsbehoefte van de woningvoorraad in geheel Nederland zelfs geschat op 800.000 woningen (VROM 1992, p. 92, middenvariant). Om dit te verwezenlijken worden een aantal nieuwe bouwlokaties voorgesteld, de meeste in de nabijheid van de grote steden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743477 ;
            sgpl:spatialText "Zwolle-zuid" ;
            sgpl:text_context "5.3 Beschrijving van de cases. 5.3.1 Zwolle-zuid. Algemene informatie Het plangebied Zwolle-zuid bestaat uit de wijken Schelle en Ittersum-Windesheim." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747890 ;
            sgpl:spatialText "Rotterdam Prinsenland" ;
            sgpl:text_context "5.3.1 Zwolle-zuid. 5.3.2 Rotterdam Prinsenland. Algemene informatie De wijk Prinsenland is gelegen aan de oostzijde van Rotterdam." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743856 ;
            sgpl:spatialText "Zoetermeer Rokkeveen" ;
            sgpl:text_context "5.3.2 Rotterdam Prinsenland. 5.3.3 Zoetermeer Rokkeveen. Algemene informatie Rokkeveen is een grote bouwlokatie ten zuiden van de rijksweg A-12 en de spoorbaan Den Haag-Gouda." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "VOORWOORD. Deze scriptie is het verslag van een onderzoek naar kennisgebruik bij de planning van basisvoorzieningen dat verricht is als onderdeel van het doctoraalexamen sociale geografie, specialisatie planologie, bij de Faculteit der Ruimtelijke Wetenschappen van de Universiteit Utrecht. Het onderzoek vond plaats in de periode november 1992 - augustus 1993 en is gedeeltelijk uitgevoerd in stageverband bij de afdeling Regionaal Ontwikkelingsbeleid van de Rijksplanologische Dienst in Den Haag." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "de vier Randstadprovincies" ;
            sgpl:text_context "In het kader van het in de Vierde nota over de ruimtelijke ordening uitgestippelde beleid ten aanzien van de dagelijkse leefomgeving speelt de planning van basisvoorzieningen, voor- zieningen met een wijkverzorgend karakter, een niet onbelangrijke rol. In de beleidsvoornemens van de Vierde nota extra (1990, p. 25) wordt de totale uitbreidingsbehoefte van de woningvoorraad van de vier Randstadprovincies voor de periode 1995-2015 gesteld op circa 485.000 woningen. In het eind 1992 verschenen Trendrapport Volkshuisvesting wordt de uitbreidingsbehoefte van de woningvoorraad in geheel Nederland zelfs geschat op 800.000 woningen (VROM 1992, p. 92, middenvariant)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "basisvoorzieningen" ;
            sgpl:text_context "Om dit te verwezenlijken worden een aantal nieuwe bouwlokaties voorgesteld, de meeste in de nabijheid van de grote steden. Tot die kwaliteit van de woonomgeving behoort ook de beschikbaarheid van een pakket van basisvoorzieningen, als winkels voor de dagelijkse goederen, een school, een bibliotheek en een huisarts. Ruimtelijke kwaliteit wordt bepaald door drie voorwaarden in onderlinge samenhang: toekomstwaarde, gebruikswaarde en belevingswaarde (Vierde nota 1988, p. 9)." ],
        [ sgpl:refersToConcept unesco:concept10989 ;
            sgpl:subjectText "functionele hiërarchie" ;
            sgpl:text_context "In deze gebieden werd voor het eerst wonen aan een eigen pakket geplande dienstverlening gerelateerd, zoals scholen, gezondheidszorg, sociaal-culturele voorzieningen en niet in de laatste plaats winkels. Het planningsconcept (inrichtingsprincipe) dat hierbij werd geïntroduceerd is dat van de functionele hiërarchie, dat wil zeggen dat de voorzieningen op hiërarchische wijze volgens hun functie en omvang in de ruimte worden gespreid. Een concept dat terug te voeren is op de ideeën van de geograaf Christaller en zijn centrale plaatsen theorie." ],
        [ sgpl:refersToConcept unesco:concept4191 ;
            sgpl:subjectText "kennisgebruik" ;
            sgpl:text_context "Kengetallen bieden geen pasklare oplossing voor elk probleem. Na in dit hoofdstuk de nadruk te hebben gelegd op kennis en kennisgebruik wordt in het volgende hoofdstuk ingegaan op de voorzieningen: de opbouw van het voorzieningenapparaat en de belangrijkste ontwikkelingen die zich met betrekking tot deze voorzieningen voordoen en hebben voorgedaan. In de eerste paragraaf wordt de opbouw van het voorzieningenapparaat behandeld." ],
        [ sgpl:refersToConcept unesco:concept10989 ;
            sgpl:subjectText "functionele hiërarchie" ;
            sgpl:text_context "In deze gebieden werd voor het eerst wonen aan een eigen pakket geplande dienstverlening gerelateerd, zoals scholen, gezondheidszorg, sociaal-culturele voorzieningen en niet in de laatste plaats winkels. Het planningsconcept (inrichtingsprincipe) dat hierbij werd geïntroduceerd is dat van de functionele hiërarchie, dat wil zeggen dat de voorzieningen op hiërarchische wijze volgens hun functie en omvang in de ruimte worden gespreid. Een concept dat terug te voeren is op de ideeën van de geograaf Christaller en zijn centrale plaatsen theorie." ],
        [ sgpl:refersToConcept unesco:concept4191 ;
            sgpl:subjectText "kennisgebruik" ;
            sgpl:text_context "Kengetallen bieden geen pasklare oplossing voor elk probleem. Na in dit hoofdstuk de nadruk te hebben gelegd op kennis en kennisgebruik wordt in het volgende hoofdstuk ingegaan op de voorzieningen: de opbouw van het voorzieningenapparaat en de belangrijkste ontwikkelingen die zich met betrekking tot deze voorzieningen voordoen en hebben voorgedaan. In de eerste paragraaf wordt de opbouw van het voorzieningenapparaat behandeld." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "basisvoorzieningen" ;
            sgpl:text_context "Om dit te verwezenlijken worden een aantal nieuwe bouwlokaties voorgesteld, de meeste in de nabijheid van de grote steden. Tot die kwaliteit van de woonomgeving behoort ook de beschikbaarheid van een pakket van basisvoorzieningen, als winkels voor de dagelijkse goederen, een school, een bibliotheek en een huisarts. Ruimtelijke kwaliteit wordt bepaald door drie voorwaarden in onderlinge samenhang: toekomstwaarde, gebruikswaarde en belevingswaarde (Vierde nota 1988, p. 9)." ] ;
    sgpl:thesisID 262 .

sgpl:Thesis263 a sgpl:SGPLThesis ;
    dcterms:creator "Eefke Langendonk" ;
    dcterms:issued 1993 ;
    dcterms:title "FICTIE OF WERKELIJKHEID?",
        "WINKELEN OP DE UITHOF!" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Het voor u liggende rapport is het resultaat van mijn afstudeeronderzoek ten behoeve van de studie Economische Geografie. Het betreft een onderzoek naar de haalbaarheid van een supermarktvestiging op het Universiteitscomplex 'De Uithof te Utrecht. Het onderzoek is uitgevoerd in opdracht van de afdeling Huisvesting van de Universiteit Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743976,
                geonames:2745912,
                geonames:2757782 ;
            sgpl:spatialText "gemeenten Utrecht, Zeist en De Bilt" ;
            sgpl:text_context "In de periode 1960-1962 werd aan het gebied aan de oostelijke rand van Utrecht, op het grondgebied van de gemeenten Utrecht, Zeist en De Bilt, een universitaire bestemming gegeven. Een woonfunctie heeft het gebied tot op heden niet. De Uithof is daarmee uitsluitend een werkgebied geworden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757015 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "Al jarenlang gaan er vanuit de 'Uithof-bevolking' stemmen op voor de vestiging van een (kleine) supermarkt op het universiteits-complex De Uithof. Winkelvoorzieningen zijn niet binnen bereik en vooral de medewerkers ervaren dit als een probleem. De Universiteit Utrecht heeft naar aanleiding van de verscheidene in het Universiteitsblad verschenen opmerkingen omtrent dit onderwerp, getracht hier een oplossing voor te zoeken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Centrumgebouw Zuid" ;
            sgpl:text_context "Indien de supermarkt rendabel blijkt te zijn, zal hij gevestigd worden in de huidige fietsenstalling onder het Centrumgebouw Zuid met een maximale vloeroppervlakte van 600 m2. De 'Dagmarkt' zal beheerd worden door een zelfstandige ondernemer die op franchisebasis werkt. Op last van het universiteitsbestuur wordt er bij de supermarkt geen ruimte gereserveerd voor parkeerplaatsen en zal deze op zaterdag niet geopend zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "oostelijke rand van Utrecht" ;
            sgpl:text_context "De reden voor deze voorgenomen verplaatsing was het ruimtegebrek in de binnenstad. In de periode 1960-1962 werd aan het gebied aan de oostelijke rand van Utrecht, op het grondgebied van de gemeenten Utrecht, Zeist en De Bilt, een universitaire bestemming gegeven. Een woonfunctie heeft het gebied tot op heden niet." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "Koopgedrag" ;
            sgpl:text_context "De attractiviteit van de supermarkt en de persoonlijke factoren van de consument zijn samen bepalend voor de constraints die men kan ondervinden bij het doen van de dagelijkse boodschappen. Uit deze constraints volgt het koopgedrag van de consument ten aanzien van de Uithof-supermarkt. Dit koopgedrag uit zich in de gebruiksfrequentie enerzijds en de aankoophoeveelheid anderzijds." ],
        [ sgpl:refersToConcept unesco:concept12334 ;
            sgpl:subjectText "Supermarktvestiging" ;
            sgpl:text_context "Het betreft een onderzoek naar de haalbaarheid van een supermarktvestiging op het Universiteitscomplex ’De Uithof te Utrecht. Het onderzoek is uitgevoerd in opdracht van de afdeling Huisvesting van de Universiteit Utrecht. Naast de Universiteit heeft de Vendex Food Groep in dit onderzoek geparticipeerd." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "Werkconsumenten" ;
            sgpl:text_context "De literatuurstudie was gericht op het belang van werkconsumenten voor de omzet van de detailhandel nabij kantoorlokaties. De gebruikte literatuur besloeg voornamelijk onderzoeken die gedaan zijn onder kantoorpersoneel. Om een goed beeld te verkrijgen van de Uithof-bevolking en hun winkelgedrag ten aanzien van dagelijkse produkten, is gebruik gemaakt van een enquête-onderzoek." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "Werkconsumenten" ;
            sgpl:text_context "De literatuurstudie was gericht op het belang van werkconsumenten voor de omzet van de detailhandel nabij kantoorlokaties. De gebruikte literatuur besloeg voornamelijk onderzoeken die gedaan zijn onder kantoorpersoneel. Om een goed beeld te verkrijgen van de Uithof-bevolking en hun winkelgedrag ten aanzien van dagelijkse produkten, is gebruik gemaakt van een enquête-onderzoek." ],
        [ sgpl:refersToConcept unesco:concept12334 ;
            sgpl:subjectText "Supermarktvestiging" ;
            sgpl:text_context "Het betreft een onderzoek naar de haalbaarheid van een supermarktvestiging op het Universiteitscomplex ’De Uithof te Utrecht. Het onderzoek is uitgevoerd in opdracht van de afdeling Huisvesting van de Universiteit Utrecht. Naast de Universiteit heeft de Vendex Food Groep in dit onderzoek geparticipeerd." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "Koopgedrag" ;
            sgpl:text_context "De attractiviteit van de supermarkt en de persoonlijke factoren van de consument zijn samen bepalend voor de constraints die men kan ondervinden bij het doen van de dagelijkse boodschappen. Uit deze constraints volgt het koopgedrag van de consument ten aanzien van de Uithof-supermarkt. Dit koopgedrag uit zich in de gebruiksfrequentie enerzijds en de aankoophoeveelheid anderzijds." ] ;
    sgpl:thesisID 263 .

sgpl:Thesis264 a sgpl:SGPLThesis ;
    dcterms:creator "Anita van der lee" ;
    dcterms:issued 1993 ;
    dcterms:title "IN HET STEDELIJK GROENBELEID",
        "RECREATIEVE MOBILITEIT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751792 ;
            sgpl:spatialText "Leeuwarden" ;
            sgpl:text_context "De onderzoeken in Spaarnwoude (1991) en Madenstein geven namelijk aan dat respectievelijk 50 % en 85 % van de bezoekers minder dan 5 km af legt. Voor De Groene Ster van Leeuwarden geldt dat zo'n 30 è 40 % van de bezoekers uit de aangrenzende wijk afkomstig is. Als we dit laatste vergelijken met de gegevens uit het onderzoek in Madenstein dan blijkt slechts 11 % van de recreanten minder dan 800 m af te leggen en eveneens 11 % tussen de 800 en 1600 m." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Bij de analyse van groennota's zijn, zoals reeds vermeld, alle steden met 100.000 of meer inwoners betrokken. Dit zijn: Amsterdam, Apeldoorn, Arnhem, Breda, Dordrecht, Eindhoven, Enschede, Groningen, Den Haag, Haarlem, Leiden, Maastricht, Nijmegen, Rotterdam, Tilburg en Utrecht. Alleen de gemeente Zaanstad is weggelaten, omdat hier niet echt sprake is van een stad die één geheel vormt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Mogelijk is dit te wijten aan het feit dat het onderzoek van iets eerdere datum is. De percentages voor de verschillende vervoermiddelen lopen bij de stadsparken nogal uiteen, maar dit is waarschijnlijk aan de verschillen in onderzoeksmethoden te wijten. De parken in Den Haag worden vaker met de auto bezocht dan in Utrecht, maar er moet hierbij rekening worden gehouden met het feit dat de cijfers van Utrecht het door de respondent meest bezochte park betreffen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdamse bos" ;
            sgpl:text_context "De twee bossen bij Breda geven duidelijke verschillen in de gebruikte vervoermiddelen te zien. De verdeling naar vervoermiddelen in de beide onderzoeken naar het Amsterdamse bos is ongeveer dezelfde. De kleine verschillen zijn waarschijnlijk veroorzaakt door een verschillende onderzoeksperiode." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "Zowel de gegevens van het groen in en rond Utrecht, als die van de bossen bij Breda zijn uit één onderzoek afkomstig. Het onderzoek naar het groen in en rond Utrecht en dat over de Haagse parken zijn beide niet op één groen-object gericht, maar bekijken de verschillende parken in die steden samengenomen. Door het ontbreken van gegevens over gebruikte vervoermiddelen in de onderzoeken van de Groene Ster van Leeuwarden en het Zuiderpark in Den Haag zijn deze groen-objecten niet opgenomen in het betreffende deel van de analyse." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Dit verslag van mijn leeronderzoek vormt de afsluiting van mijn studie Sociale Geografie aan de Universiteit Utrecht. Doel van het onderzoek is het verkrijgen van inzicht in hoe het rijksbeleid van beperking van de recreatieve automobiliteit en bevordering van langzaam verkeer en openbaar vervoer wordt uitgewerkt in het stedelijk beleid ten aanzien van groen voor recreatie. Hierbij wil ik iedereen bedanken die op een of andere wijze bij heeft gedragen aan mijn onderzoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746983 ;
            sgpl:spatialText "Spaarnwoude" ;
            sgpl:text_context "Qua afstand zijn voor de verschillende typen groen voor recreatie in beperkte mate verschillen te onderscheiden. De onderzoeken in Spaarnwoude (1991) en Madenstein geven namelijk aan dat respectievelijk 50 % en 85 % van de bezoekers minder dan 5 km af legt. Voor De Groene Ster van Leeuwarden geldt dat zo'n 30 è 40 % van de bezoekers uit de aangrenzende wijk afkomstig is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "In de steden betreft het voorstadshaltes van het spoorwegennet of andere knooppunten van het metro- en (snel)tramnet. Belangrijke punten van dit thema zijn de Randstadgroenstructuur, het Groene Hart en de Utrechtse Heuvelrug. Daarnaast komen er in de Randstad een aantal grote groene gebieden bij, waar voor nu plannen worden gemaakt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "In Nijmegen is het groenstructuurplan nog in ontwikkeling. Rotterdam heeft voor groen geen aparte beleidsnota, maar bekijkt de buitenruimte als één geheel. En in Amsterdam tenslotte ligt de verantwoordelijkheid van het groen bij de stadsdelen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Zowel de gegevens van het groen in en rond Utrecht, als die van de bossen bij Breda zijn uit één onderzoek afkomstig. Het onderzoek naar het groen in en rond Utrecht en dat over de Haagse parken zijn beide niet op één groen-object gericht, maar bekijken de verschillende parken in die steden samengenomen. Door het ontbreken van gegevens over gebruikte vervoermiddelen in de onderzoeken van de Groene Ster van Leeuwarden en het Zuiderpark in Den Haag zijn deze groen-objecten niet opgenomen in het betreffende deel van de analyse." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "recreatieve mobiliteit" ;
            sgpl:text_context "Om deze doelstelling te bereiken, is een drietal probleemstellingen geformuleerd, die samen het inzicht in het beleid zullen moeten verschaffen. Bij de opbouw hiervan is er vanuit gegaan dat de ontwikkeling van het beleid voor recreatieve mobiliteit binnen het gemeentelijk groenbeleid zou moeten steunen op twee peilers namelijk: — De mobiliteitswensen van de recreant tot uitdrukking komend in zijn gedrag. - De richtlijnen voor recreatieve mobiliteit van hogerhand." ],
        [ sgpl:refersToConcept unesco:concept660 ;
            sgpl:subjectText "langzaam verkeer" ;
            sgpl:text_context "Het is slecht voor het milieu, de economie, de energievoorraden en dus ook voor de Nederlandse bevolking in het algemeen. Om de beperking van de mobiliteit van de burger in het algemeen niet te veel te beperken, moeten de mogelijkheden voor het langzaam verkeer en het openbaar vervoer volgens het rijk zoveel mogelijk worden bevorderd. Dit onderzoek richt zich op de mobiliteit in het stedelijk beleid ten aanzien van groen met een recreatieve functie voor alle stedelingen." ],
        [ sgpl:refersToConcept unesco:concept17097 ;
            sgpl:subjectText "stedelijk groenbeleid" ;
            sgpl:text_context "De richtlijnen die door rijk en provincies worden gegeven voor het stedelijk beleid ten aanzien van recreatieve mobiliteit komen in het volgende hoofdstuk aan bod. In hoofdstuk vier komt de rol die mobiliteit in het stedelijk groenbeleid speelt naar voren. En het laatste hoofdstuk geeft de conclusies die kunnen worden getrokken uit de eerdere fasen van het onderzoek." ],
        [ sgpl:refersToConcept unesco:concept17097 ;
            sgpl:subjectText "stedelijk groenbeleid" ;
            sgpl:text_context "De richtlijnen die door rijk en provincies worden gegeven voor het stedelijk beleid ten aanzien van recreatieve mobiliteit komen in het volgende hoofdstuk aan bod. In hoofdstuk vier komt de rol die mobiliteit in het stedelijk groenbeleid speelt naar voren. En het laatste hoofdstuk geeft de conclusies die kunnen worden getrokken uit de eerdere fasen van het onderzoek." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "recreatieve mobiliteit" ;
            sgpl:text_context "Om deze doelstelling te bereiken, is een drietal probleemstellingen geformuleerd, die samen het inzicht in het beleid zullen moeten verschaffen. Bij de opbouw hiervan is er vanuit gegaan dat de ontwikkeling van het beleid voor recreatieve mobiliteit binnen het gemeentelijk groenbeleid zou moeten steunen op twee peilers namelijk: — De mobiliteitswensen van de recreant tot uitdrukking komend in zijn gedrag. - De richtlijnen voor recreatieve mobiliteit van hogerhand." ],
        [ sgpl:refersToConcept unesco:concept660 ;
            sgpl:subjectText "langzaam verkeer" ;
            sgpl:text_context "Het is slecht voor het milieu, de economie, de energievoorraden en dus ook voor de Nederlandse bevolking in het algemeen. Om de beperking van de mobiliteit van de burger in het algemeen niet te veel te beperken, moeten de mogelijkheden voor het langzaam verkeer en het openbaar vervoer volgens het rijk zoveel mogelijk worden bevorderd. Dit onderzoek richt zich op de mobiliteit in het stedelijk beleid ten aanzien van groen met een recreatieve functie voor alle stedelingen." ] ;
    sgpl:thesisID 264 .

sgpl:Thesis265 a sgpl:SGPLThesis ;
    dcterms:creator "Roel van de Loo" ;
    dcterms:issued 1993 ;
    dcterms:title "Onderzoek naar de kans van intergemeentelijke samenwerking op het gebied",
        "duurzame samenwerking?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Haarlem" ;
            sgpl:text_context "Ten slotte gaat mijn waardering uit naar de notulist en mede-analist Tarcis Schipper die vooral bij de interviews een onmisbare rol heeft gespeeld. Haarlem, oktober 1993 Roel van de Loo RIMH-NH Postbus 1182 2001 BD Haarlem 023-154451." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Gezien de aard van het onderwerp is de keuze gemaakt om een enigszins experimentele, niet strak gestructureerde, methode toe te passen. De gebruikte methode is gebaseerd op het onderzoek \"RO zonder poppenkast\" van het bureau Cebeon te Amsterdam. Dit onderzoek had betrekking op de toepassing door gebruikers van bepaalde ruimtelijke ordeningsinstrumenten (Cebeon, 1990)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Het onderzoek is mede verricht in het kader van de afronding van de studie Sociale Geografie van ondergetekende aap de Rijksuniversiteit Utrecht. De RIMH-NH/F is als oog en oor van de minister van VROM in de regio sterk betrokken bij de ontwikkelingen in de samenwerking tussen gemeenten. Volgens het Ministerie van VROM is samenwerking op milieugebied een absolute voorwaarde om de milieudoelstellingen uit onder andere het Nationale Milieubeleidsplan (NMP) te bereiken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In dit rapport staan twee zaken centraal: \"samenwerking tussen gemeenten\" en \"milieu\". Samenwerking tussen gemeenten is een thema dat al veelvuldig in bestuurlijk Nederland op de agenda heeft gestaan. Terwijl die discussie voortduurt vraagt op milieugebied een groot aantal problemen om een bovengemeentelijke oplossing." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Noord-Holland" ;
            sgpl:text_context "Inspectie van de Volksgezondheid voor de hygiëne van het milieu voor Noord-Holland en Flevoland rT' m VOORWOORD Dit rapport is het resultaat van een onderzoek dat door de Regionale Inspectie Milieuhygiëne Noord-Holland en Flevoland (RIMH-NH/F) is verricht naar de ophouw en duurzaamheid van de regionale samenwerking tussen gemeenten op milieugebied. Het onderzoek is mede verricht in het kader van de afronding van de studie Sociale Geografie van ondergetekende aap de Rijksuniversiteit Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3319179 ;
            sgpl:spatialText "Flevoland" ;
            sgpl:text_context "Inspectie van de Volksgezondheid voor de hygiëne van het milieu voor Noord-Holland en Flevoland rT' m VOORWOORD Dit rapport is het resultaat van een onderzoek dat door de Regionale Inspectie Milieuhygiëne Noord-Holland en Flevoland (RIMH-NH/F) is verricht naar de ophouw en duurzaamheid van de regionale samenwerking tussen gemeenten op milieugebied. Het onderzoek is mede verricht in het kader van de afronding van de studie Sociale Geografie van ondergetekende aap de Rijksuniversiteit Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "10 WGR-gebieden in Noord-Holland" ;
            sgpl:text_context "Dit gegeven is voor de Regionale Inspectie Milieuhygiëne Noord-Holland en Flevoland (RIMH-NH/F) aanleiding geweest om te evalueren of en in welke mate de stimulans voor IGS op milieugebied gewerkt heeft. In de praktijk van de afgelopen jaren is veelvuldig gebleken dat de huidige samenwerking in de 10 WGR-gebieden in Noord-Holland te wensen overlaat. Aangezien de RIMH-NH/F zeer nauw betrokken is bij de ontwikkelingen in de WGR-regio' s is een onderzoek naar de samenwerkingspraktijk van belang." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept197 ;
            sgpl:subjectText "Milieutaken" ;
            sgpl:text_context "Dit rapport brengt het spanningsveld tussen de bestuurlijke structuur, de bestuurlijke veranderingen en de regionale samenwerkingspraktijk op milieugebied met elkaar in verband. Sinds 1990 bestaan er twee tijdelijke financiële regelingen die tot doel hebben om de gemeenten te stimuleren om milieutaken adequater op te pakken en uit te voeren. De regelingen zijn het Bijdragenbesluit Uitvoering Gemeentelijk Milieubeleid (BUGM) en Financiering Uitvoering NMP+ (FUN)." ],
        [ sgpl:refersToConcept unesco:concept6587 ;
            sgpl:subjectText "Intergemeentelijke samenwerking" ;
            sgpl:text_context "Het doel van de regelingen is dat alle gemeenten in Nederland voor 1995 een zogenaamd adequaat uitvoeringsniveau bereiken. Naast een specifieke milieu-uitkering aan de gemeente bevatten beide regelingen tevens een financiële stimuleringscomponent voor Intergemeentelijke Samenwerking (IGS) op milieugebied. Volgens de visie van VROM is IGS onontbeerlijk om de milieudoelstellingen uit het NMP en NMP+ te halen." ],
        [ sgpl:refersToConcept unesco:concept7888 ;
            sgpl:subjectText "Nationaal Milieubeleidsplan" ;
            sgpl:text_context "Volgens de visie van VROM is IGS onontbeerlijk om de milieudoelstellingen uit het NMP en NMP+ te halen. In het Nationaal Milieubeleidsplan Plus (NMP+, 1991) werd bepaald dat een verdere intensivering van de uitvoering van het milieubeleid noodzakelijk is om de milieudoelstellingen te halen. Veel van genoemde taken hadden betrekking op de uitvoering van het milieubeleid door de lagere overheden." ],
        [ sgpl:refersToConcept unesco:concept197 ;
            sgpl:subjectText "Milieutaken" ;
            sgpl:text_context "Dit rapport brengt het spanningsveld tussen de bestuurlijke structuur, de bestuurlijke veranderingen en de regionale samenwerkingspraktijk op milieugebied met elkaar in verband. Sinds 1990 bestaan er twee tijdelijke financiële regelingen die tot doel hebben om de gemeenten te stimuleren om milieutaken adequater op te pakken en uit te voeren. De regelingen zijn het Bijdragenbesluit Uitvoering Gemeentelijk Milieubeleid (BUGM) en Financiering Uitvoering NMP+ (FUN)." ],
        [ sgpl:refersToConcept unesco:concept6587 ;
            sgpl:subjectText "Intergemeentelijke samenwerking" ;
            sgpl:text_context "Het doel van de regelingen is dat alle gemeenten in Nederland voor 1995 een zogenaamd adequaat uitvoeringsniveau bereiken. Naast een specifieke milieu-uitkering aan de gemeente bevatten beide regelingen tevens een financiële stimuleringscomponent voor Intergemeentelijke Samenwerking (IGS) op milieugebied. Volgens de visie van VROM is IGS onontbeerlijk om de milieudoelstellingen uit het NMP en NMP+ te halen." ],
        [ sgpl:refersToConcept unesco:concept7888 ;
            sgpl:subjectText "Nationaal Milieubeleidsplan" ;
            sgpl:text_context "Volgens de visie van VROM is IGS onontbeerlijk om de milieudoelstellingen uit het NMP en NMP+ te halen. In het Nationaal Milieubeleidsplan Plus (NMP+, 1991) werd bepaald dat een verdere intensivering van de uitvoering van het milieubeleid noodzakelijk is om de milieudoelstellingen te halen. Veel van genoemde taken hadden betrekking op de uitvoering van het milieubeleid door de lagere overheden." ] ;
    sgpl:thesisID 265 .

sgpl:Thesis266 a sgpl:SGPLThesis ;
    dcterms:creator "Kees Jan Snoei" ;
    dcterms:issued 1993 ;
    dcterms:title "Accent op de Romolenpolder",
        "Een evaluatieonderzoek naar de totstandkoming van een bijzondere nieuwbouwwijk in Haarlem." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745528 ;
            sgpl:spatialText "Vijfhuizen" ;
            sgpl:text_context "Het woningtekort kon de gemeente ten dele opvangen door aanspraak te maken op de NORON-lokaties Hoofddorp en Vijfhuizen. Het gemeentelijk beleid was er echter op gericht deze suburbanisatie juist zoveel mogelijk te beperken en te streven naar uitbreidingen aan of in het stedelijk gebied (Struktuurplan gem. Haarlem, 1985). Met deze minimalisering van de suburbanisatie werd er naar gestreefd de bevolking van Haarlem op peil te houden en daaraan gekoppeld het voorzieningenniveau van de stad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Haarlem" ;
            sgpl:text_context "Kwalitatief gezien is het succes soms minder groot. In een recente nieuwbouwwijk in Haarlem, de Romolenpolder, is de ontwikkeling van de wijk anders benaderd dan doorgaans het geval is. Bij de totstandkoming van deze wijk wordt er aandacht gegeven aan een aantal bijzondere aspecten t.w.: participatie van de toekomstige bewoners in de plannen, milieuvriendelijk bouwen en wonen, verscheidenheid van de buurt en beheer op buurtniveau." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Romolenpolder" ;
            sgpl:text_context "Kwalitatief gezien is het succes soms minder groot. In een recente nieuwbouwwijk in Haarlem, de Romolenpolder, is de ontwikkeling van de wijk anders benaderd dan doorgaans het geval is. Bij de totstandkoming van deze wijk wordt er aandacht gegeven aan een aantal bijzondere aspecten t.w.: participatie van de toekomstige bewoners in de plannen, milieuvriendelijk bouwen en wonen, verscheidenheid van de buurt en beheer op buurtniveau." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "de oude binnenstad van Haarlem" ;
            sgpl:text_context "De Romolenpolder ligt tussen de wijk \"Schalkwijk\" en de oude binnenstad van Haarlem. Schalkwijk werd in de jaren zestig gebouwd en bestaat uit veel hoogbouw. In deze wijk is de zogenaamde stempelstedebouw toegepast waardoor de wijk een vrij monotoon karakter heeft gekregen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Provincie Noord-Holland" ;
            sgpl:text_context "Dit rapport is geschreven als doctoraalscriptie van de studie sociale geografie (specialisatie planologie) aan de Universiteit Utrecht. Het onderzoek wat aan dit uiteindelijke resultaat vooraf is gegaan is grotendeels uitgevoerd vanuit de Dienst Ruimte en Groen van de Provincie Noord-Holland in Haarlem. Bij deze dienst heb ik zes maanden gebruik kunnen maken van de beschikbare faciliteiten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747703 ;
            sgpl:spatialText "Schalkwijk" ;
            sgpl:text_context "De Romolenpolder ligt tussen de wijk \"Schalkwijk\" en de oude binnenstad van Haarlem. Schalkwijk werd in de jaren zestig gebouwd en bestaat uit veel hoogbouw. In deze wijk is de zogenaamde stempelstedebouw toegepast waardoor de wijk een vrij monotoon karakter heeft gekregen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Europawijk" ;
            sgpl:text_context "Het verzet tegen deze plannen kwam met name tot uiting door leden van de wijkraad Europawijk (deze wijk van Schalkwijk grenst aan de Romolenpolder) en leden van de Schalkwijkse werkgroep Stad en Land (zie figuur 3). De gemeenteraad gaf de voorgenomen plannen om de polder te bebouwen niet op. Bij dit gemeentelijke standpunt speelde namelijk de Nota \"duizend woningen\", welke door het college van B en W op 23 oktober 1985 was aanvaard, een belangrijke rol (zie figuur 4)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Gemeente Haarlem" ;
            sgpl:text_context "Zo'n evaluatie zou te kort doen aan de context waarin de deze doelstellingen een rol hebben gespeeld. In de Romolenpolder kunnen de volgende partijen tot de betrokkenen worden gerekend: de gemeente Haarlem, de financiers (beleggers, woningcorporaties, projectontwikkelaars), de stichting MW2-Romolenpolder, de architecten, de aannemers, enkele adviesbureaus en de bewoners. Het is, naast het weergeven van de ervaringen van deze betrokkenen, ook van belang te achterhalen welke aspecten van de planbenadering in de Romolenpolder bij nieuwe stedelijke uitbreidingen kunnen worden gebruikt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "de Groene Zoom" ;
            sgpl:text_context "In deze wijk is de zogenaamde stempelstedebouw toegepast waardoor de wijk een vrij monotoon karakter heeft gekregen. Rondom Schalkwijk ligt een \"Groene Zoom\" waarvan de Romolenpolder jarenlang een onderdeel van uit heeft gemaakt (zie figuur 1). De \"Groene Zoom\", bestaande uit polderlandschap, parkjes en dergelijke, was een aangename aanvulling op de monotonie van Schalkwijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753801 ;
            sgpl:spatialText "Hoofddorp" ;
            sgpl:text_context "Het woningtekort kon de gemeente ten dele opvangen door aanspraak te maken op de NORON-lokaties Hoofddorp en Vijfhuizen. Het gemeentelijk beleid was er echter op gericht deze suburbanisatie juist zoveel mogelijk te beperken en te streven naar uitbreidingen aan of in het stedelijk gebied (Struktuurplan gem. Haarlem, 1985). Met deze minimalisering van de suburbanisatie werd er naar gestreefd de bevolking van Haarlem op peil te houden en daaraan gekoppeld het voorzieningenniveau van de stad." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5339 ;
            sgpl:subjectText "bewonersparticipatie" ;
            sgpl:text_context "In een recente nieuwbouwwijk in Haarlem, de Romolenpolder, is de ontwikkeling van de wijk anders benaderd dan doorgaans het geval is. Bij de totstandkoming van deze wijk wordt er aandacht gegeven aan een aantal bijzondere aspecten t.w.: participatie van de toekomstige bewoners in de plannen, milieuvriendelijk bouwen en wonen, verscheidenheid van de buurt en beheer op buurtniveau. Deze vier bijzondere aspecten zijn door de stichting MW2-Romolenpolder geïnitieerd in het planproces." ],
        [ sgpl:refersToConcept unesco:concept7775 ;
            sgpl:subjectText "milieuvriendelijk bouwen" ;
            sgpl:text_context "De steeds verdere verslechtering van het milieu moet in de omgeving van de woning worden aangepakt. Zo kan het huis, als essentieel onderdeel van de dagelijkse leefomgeving, milieuvriendelijker worden gebouwd. Dit geldt ook voor de inrichting van de omgeving van de woning; de wijk." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "buurtbeheer" ;
            sgpl:text_context "Door de participatie is er een betrokkenheid met de wijk ontstaan die gehandhaafd moet blijven. Door het oprichten van een beheerinstelling op buurtniveau moet worden geprobeerd deze betrokkenheid vast te houden. Deze thema's, en tevens doelstellingen van de stichting MW2, hebben in het planproces een grote rol gespeeld." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "buurtbeheer" ;
            sgpl:text_context "Door de participatie is er een betrokkenheid met de wijk ontstaan die gehandhaafd moet blijven. Door het oprichten van een beheerinstelling op buurtniveau moet worden geprobeerd deze betrokkenheid vast te houden. Deze thema's, en tevens doelstellingen van de stichting MW2, hebben in het planproces een grote rol gespeeld." ],
        [ sgpl:refersToConcept unesco:concept5339 ;
            sgpl:subjectText "bewonersparticipatie" ;
            sgpl:text_context "In een recente nieuwbouwwijk in Haarlem, de Romolenpolder, is de ontwikkeling van de wijk anders benaderd dan doorgaans het geval is. Bij de totstandkoming van deze wijk wordt er aandacht gegeven aan een aantal bijzondere aspecten t.w.: participatie van de toekomstige bewoners in de plannen, milieuvriendelijk bouwen en wonen, verscheidenheid van de buurt en beheer op buurtniveau. Deze vier bijzondere aspecten zijn door de stichting MW2-Romolenpolder geïnitieerd in het planproces." ],
        [ sgpl:refersToConcept unesco:concept7775 ;
            sgpl:subjectText "milieuvriendelijk bouwen" ;
            sgpl:text_context "De steeds verdere verslechtering van het milieu moet in de omgeving van de woning worden aangepakt. Zo kan het huis, als essentieel onderdeel van de dagelijkse leefomgeving, milieuvriendelijker worden gebouwd. Dit geldt ook voor de inrichting van de omgeving van de woning; de wijk." ] ;
    sgpl:thesisID 266 .

sgpl:Thesis267 a sgpl:SGPLThesis ;
    dcterms:creator "M. Soeters",
        "R. de Niet" ;
    dcterms:issued 1993 ;
    dcterms:title "Een vergelijkend onderzoek naar veranderingen in grondgebruik in zes provincies en het provinciaal ruimtelijk beleid aangaande grondgebruiksveranderingen",
        "GRONDGEBRUIK IN LANDELIJKE GEBIEDEN: VERANDERINGEN EN BELEID",
        "VERSLAGEN VAN LEERONDERZOEK G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Friesland" ;
            sgpl:text_context "Deze scriptie is het resultaat van een ruraal-geografisch leeronderzoek, dat onderdeel uitmaakt van de studie Sociale Geografie aan de Universiteit Utrecht. In het onderzoek hebben we een beeld geschetst van de veranderingen die vanaf 1980 hebben plaatsgevonden in landelijke gebieden van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland. Daarnaast is gekeken hoe bij deze zes provincies en met name in het ruimtelijk beleid wordt omgegeaan met veranderingen in grondgebruik in landelijke gebieden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7535498 ;
            sgpl:spatialText "Oldambt" ;
            sgpl:text_context "In Drenthe heeft reeds een kleine uitbreiding op landbouwgrond plaatsgevonden (Evaluatienota Structuurschema Militaire Terreinen 1991). Ook de Staatssecretaris van Defensie Van Voorst tot Voorst heeft laatst nog gewezen op de mogelijkheid om het Oldambt in Groningen in te richten als oefenterrein met een omvang van circa 2500 hectare (Volkskrant 28-10-1992). Gesteld kan worden dat de oppervlakte militaire terreinen de afgelopen jaren een afname heeft ondergaan in Nederland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Kop van Noord-Holland" ;
            sgpl:text_context "Niet in alle gebieden zullen de gevolgen van het milieubeleid even sterk gevoeld worden. Om de omvang van milieuproblemen op het gebied van de landbouw te verminderen, is het naast extensivering in bepaalde gebieden gewenst dat intensieve (rund-) veehouderijbedrijven in mestoverschotgebieden geleidelijk worden verplaatst naar gebieden met een lagere veebezetting, zoals de Fries-Groningse kleigebieden, het Oldambt, de Gronings-Drentse Veenkoloniën (tesamen de zogenaamde Noordelijke Schil) en gebieden in de Kop van Noord-Holland (Structuurschema Groene Ruimte 1992). De milieubelasting neemt hierdoor af, er ontstaan minder mestoverschotten en de druk op de grond vermindert." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Noord-Holland" ;
            sgpl:text_context "Deze scriptie is het resultaat van een ruraal-geografisch leeronderzoek, dat onderdeel uitmaakt van de studie Sociale Geografie aan de Universiteit Utrecht. In het onderzoek hebben we een beeld geschetst van de veranderingen die vanaf 1980 hebben plaatsgevonden in landelijke gebieden van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland. Daarnaast is gekeken hoe bij deze zes provincies en met name in het ruimtelijk beleid wordt omgegeaan met veranderingen in grondgebruik in landelijke gebieden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755249 ;
            sgpl:spatialText "Groningen" ;
            sgpl:text_context "Deze scriptie is het resultaat van een ruraal-geografisch leeronderzoek, dat onderdeel uitmaakt van de studie Sociale Geografie aan de Universiteit Utrecht. In het onderzoek hebben we een beeld geschetst van de veranderingen die vanaf 1980 hebben plaatsgevonden in landelijke gebieden van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland. Daarnaast is gekeken hoe bij deze zes provincies en met name in het ruimtelijk beleid wordt omgegeaan met veranderingen in grondgebruik in landelijke gebieden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746058 ;
            sgpl:spatialText "Twente" ;
            sgpl:text_context "Problemen doen zich vooral voor in de zandgebieden waar sprake is van een mestoverschot. In dit onderzoek zijn dat de Achterhoek, Veluwe en Gelderse Vallei in Gelderland en Twente in Overijssel. Door concentratie van weinig duurzame, veelal zeer concurrerende intensieve veehouderij- en rundveehouderijbedrijven zijn problemen als verzuring en eutrofiëring van het milieu in deze gebieden het grootst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755622 ;
            sgpl:spatialText "Gelderse Vallei" ;
            sgpl:text_context "Problemen doen zich vooral voor in de zandgebieden waar sprake is van een mestoverschot. In dit onderzoek zijn dat de Achterhoek, Veluwe en Gelderse Vallei in Gelderland en Twente in Overijssel. Door concentratie van weinig duurzame, veelal zeer concurrerende intensieve veehouderij- en rundveehouderijbedrijven zijn problemen als verzuring en eutrofiëring van het milieu in deze gebieden het grootst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745666 ;
            sgpl:spatialText "Veluwe" ;
            sgpl:text_context "Problemen doen zich vooral voor in de zandgebieden waar sprake is van een mestoverschot. In dit onderzoek zijn dat de Achterhoek, Veluwe en Gelderse Vallei in Gelderland en Twente in Overijssel. Door concentratie van weinig duurzame, veelal zeer concurrerende intensieve veehouderij- en rundveehouderijbedrijven zijn problemen als verzuring en eutrofiëring van het milieu in deze gebieden het grootst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Opgemerkt dient te worden dat er geen onderscheid is gemaakt tussen overnachtingen in stedelijke en in landelijke gebieden. De toename in Noord-Holland zal voor een groot gedeelte plaats hebben gevonden in Amsterdam. De oppervlakte recreatieterrein (dag- en verblijfsrecreatief terrein) is in de zes provincies en in Nederland in omvang toegenomen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "Overijssel" ;
            sgpl:text_context "Deze scriptie is het resultaat van een ruraal-geografisch leeronderzoek, dat onderdeel uitmaakt van de studie Sociale Geografie aan de Universiteit Utrecht. In het onderzoek hebben we een beeld geschetst van de veranderingen die vanaf 1980 hebben plaatsgevonden in landelijke gebieden van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland. Daarnaast is gekeken hoe bij deze zes provincies en met name in het ruimtelijk beleid wordt omgegeaan met veranderingen in grondgebruik in landelijke gebieden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "VOORWOORD. Deze scriptie is het resultaat van een ruraal-geografisch leeronderzoek, dat onderdeel uitmaakt van de studie Sociale Geografie aan de Universiteit Utrecht. In het onderzoek hebben we een beeld geschetst van de veranderingen die vanaf 1980 hebben plaatsgevonden in landelijke gebieden van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Lage Midden" ;
            sgpl:text_context "Aan de andere kant zal door het toekomstige mest- en ammoniakbeleid (aanscherping van de normen) de concurrentiepositie van veenweidegebieden met een relatief lage veebezetting en voor deze gebieden goede produktie-omstandigheden juist verbeteren. Dit geldt dan met name voor de Friese veenweidegebieden (Zuid-West Friesland en het Lage Midden). In de veenweidegebieden in Groningen (Veenkoloniën) en Overijssel (Noord-West Overijssel), met matige produktie-omstandigheden, zal een tussenoplossing in de vorm van landbouw verweven met natuur een mogelijke uitkomst kunnen bieden aan eventuele problemen (Structuurschema Groene Ruimte 1992)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "1.1 Landelijke gebieden in Nederland. In dit hoofdstuk zal een korte beschrijving van de situatie in het landelijk gebied van Nederland gegeven worden en zullen de probleemstelling, de onderzoeksvragen, de onderzoeksopzet, het conceptueel model en de wijze van uitvoering van het onderzoek nader worden toegelicht. Het grootste gedeelte van Nederland is aan te merken als landelijk gebied." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756631 ;
            sgpl:spatialText "Drenthe" ;
            sgpl:text_context "Deze scriptie is het resultaat van een ruraal-geografisch leeronderzoek, dat onderdeel uitmaakt van de studie Sociale Geografie aan de Universiteit Utrecht. In het onderzoek hebben we een beeld geschetst van de veranderingen die vanaf 1980 hebben plaatsgevonden in landelijke gebieden van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland. Daarnaast is gekeken hoe bij deze zes provincies en met name in het ruimtelijk beleid wordt omgegeaan met veranderingen in grondgebruik in landelijke gebieden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelderland" ;
            sgpl:text_context "Deze scriptie is het resultaat van een ruraal-geografisch leeronderzoek, dat onderdeel uitmaakt van de studie Sociale Geografie aan de Universiteit Utrecht. In het onderzoek hebben we een beeld geschetst van de veranderingen die vanaf 1980 hebben plaatsgevonden in landelijke gebieden van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland. Daarnaast is gekeken hoe bij deze zes provincies en met name in het ruimtelijk beleid wordt omgegeaan met veranderingen in grondgebruik in landelijke gebieden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Zuid-West Friesland" ;
            sgpl:text_context "Aan de andere kant zal door het toekomstige mest- en ammoniakbeleid (aanscherping van de normen) de concurrentiepositie van veenweidegebieden met een relatief lage veebezetting en voor deze gebieden goede produktie-omstandigheden juist verbeteren. Dit geldt dan met name voor de Friese veenweidegebieden (Zuid-West Friesland en het Lage Midden). In de veenweidegebieden in Groningen (Veenkoloniën) en Overijssel (Noord-West Overijssel), met matige produktie-omstandigheden, zal een tussenoplossing in de vorm van landbouw verweven met natuur een mogelijke uitkomst kunnen bieden aan eventuele problemen (Structuurschema Groene Ruimte 1992)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2760027 ;
            sgpl:spatialText "Achterhoek" ;
            sgpl:text_context "Problemen doen zich vooral voor in de zandgebieden waar sprake is van een mestoverschot. In dit onderzoek zijn dat de Achterhoek, Veluwe en Gelderse Vallei in Gelderland en Twente in Overijssel. Door concentratie van weinig duurzame, veelal zeer concurrerende intensieve veehouderij- en rundveehouderijbedrijven zijn problemen als verzuring en eutrofiëring van het milieu in deze gebieden het grootst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Veenkoloniën" ;
            sgpl:text_context "Aan de andere kant zal door het toekomstige mest- en ammoniakbeleid (aanscherping van de normen) de concurrentiepositie van veenweidegebieden met een relatief lage veebezetting en voor deze gebieden goede produktie-omstandigheden juist verbeteren. In de veenweidegebieden in Groningen (Veenkoloniën) en Overijssel (Noord-West Overijssel), met matige produktie-omstandigheden, zal een tussenoplossing in de vorm van landbouw verweven met natuur een mogelijke uitkomst kunnen bieden aan eventuele problemen (Structuurschema Groene Ruimte 1992). Deze korte uiteenzetting over de situatie in landelijke gebieden van Nederland maakt duidelijk dat het landelijk gebied in het algemeen aan veranderingen onderhevig is." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7879 ;
            sgpl:subjectText "Provinciaal ruimtelijk beleid" ;
            sgpl:text_context "In het eerste deel richt zich op de vraag welke kwantitatieve veranderingen in het grondgebruik die vanaf 1980 hebben plaatsgevonden in het landelijk gebied van de zes genoemde provincies. In het tweede deel staat het actuele provinciaal ruimtelijk beleid centraal. Er zal gekeken worden hoe de zes provincies beleidsmatig reageren op de veranderingen in grondgebruik en welke visie de zes provincies hebben op ruimtelijke ontwikkelingen in landelijke gebieden, nu en in de toekomst." ],
        [ sgpl:refersToConcept unesco:concept442 ;
            sgpl:subjectText "Grondgebruiksveranderingen" ;
            sgpl:text_context "Deze veranderingen vormen samen met de manier waarop het provinciaal ruimtelijk beleid omgaat met de daarbij optredende spanningen en inspeelt op verschuivingen in het grondgebruik het uitgangspunt van dit onderzoek. Welke grondgebruiksveranderingen in het landelijk gebied van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland hebben vanaf 1980 plaatsgevonden en zullen plaatsvinden op het gebied van landbouw, natuur, bos, recreatie (en toerisme), wonen, verkeer en militaire terreinen en hoe wordt daar door de desbetreffende provincies op ingespeeld in het ruimtelijk beleid? Gezien de tijd die voor het onderzoek beschikbaar was diende het aantal provincies tot zes beperkt te worden." ],
        [ sgpl:refersToConcept unesco:concept3964 ;
            sgpl:subjectText "Ecologische Hoofdstructuur" ;
            sgpl:text_context "Door de grondgebruiksvorm natuur wordt in toenemende mate aanspraak gemaakt op de ruimte in het landelijk gebied. Een van de meest ingrijpende veranderingen in het landelijk gebied wordt dan ook veroorzaakt door de realisatie van de ecologische hoofdstructuur (EHS), zoals die in het Natuurbeleidsplan (NBP) staat aangegeven. De ontwikkeling van een EHS is ingegeven door het feit dat de achteruitgang van het aantal planten en dieren in Nederland blijkt door te zetten." ],
        [ sgpl:refersToConcept unesco:concept7879 ;
            sgpl:subjectText "Provinciaal ruimtelijk beleid" ;
            sgpl:text_context "In het eerste deel richt zich op de vraag welke kwantitatieve veranderingen in het grondgebruik die vanaf 1980 hebben plaatsgevonden in het landelijk gebied van de zes genoemde provincies. In het tweede deel staat het actuele provinciaal ruimtelijk beleid centraal. Er zal gekeken worden hoe de zes provincies beleidsmatig reageren op de veranderingen in grondgebruik en welke visie de zes provincies hebben op ruimtelijke ontwikkelingen in landelijke gebieden, nu en in de toekomst." ],
        [ sgpl:refersToConcept unesco:concept3964 ;
            sgpl:subjectText "Ecologische Hoofdstructuur" ;
            sgpl:text_context "Door de grondgebruiksvorm natuur wordt in toenemende mate aanspraak gemaakt op de ruimte in het landelijk gebied. Een van de meest ingrijpende veranderingen in het landelijk gebied wordt dan ook veroorzaakt door de realisatie van de ecologische hoofdstructuur (EHS), zoals die in het Natuurbeleidsplan (NBP) staat aangegeven. De ontwikkeling van een EHS is ingegeven door het feit dat de achteruitgang van het aantal planten en dieren in Nederland blijkt door te zetten." ],
        [ sgpl:refersToConcept unesco:concept442 ;
            sgpl:subjectText "Grondgebruiksveranderingen" ;
            sgpl:text_context "Deze veranderingen vormen samen met de manier waarop het provinciaal ruimtelijk beleid omgaat met de daarbij optredende spanningen en inspeelt op verschuivingen in het grondgebruik het uitgangspunt van dit onderzoek. Welke grondgebruiksveranderingen in het landelijk gebied van de provincies Groningen, Friesland, Drenthe, Overijssel, Gelderland en Noord-Holland hebben vanaf 1980 plaatsgevonden en zullen plaatsvinden op het gebied van landbouw, natuur, bos, recreatie (en toerisme), wonen, verkeer en militaire terreinen en hoe wordt daar door de desbetreffende provincies op ingespeeld in het ruimtelijk beleid? Gezien de tijd die voor het onderzoek beschikbaar was diende het aantal provincies tot zes beperkt te worden." ] ;
    sgpl:thesisID 267 .

sgpl:Thesis268 a sgpl:SGPLThesis ;
    dcterms:creator "Victor Klein" ;
    dcterms:issued 1992 ;
    dcterms:title "Een onderzoek naar het koopgedrag van huishoudens in Spijkenisse en de gevolgen van veranderingen in de huishoudensopbouw voor het winkelapparaat.",
        "Huishoudensdifferentiatie en koopgedrag." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Naar aanleiding van deze uitgangspunten is een beleidsuitspraak geformuleerd ten aanzien van de Randstad (vinex deel 3, p. 168): Het kabinet zal zich inzetten voor de aansluiting van de Randstad op het Westeuropese net van hogesnelheidsverbindingcn. Hierbij is zowel de relatie in zuidelijke richting met Brussel, Parijs, Londen en Frankfurt aan de orde als in oostelijke richting de mogelijke snelle railverbinding van de Randstad met het Rurhgebied en Zuid-Duitsland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Voor U ligt het verslag van het onderzoek naar het kooppatronen van huishoudens in de gemeente Spijkenisse. Het onderzoek is verricht in het kader van het doktoraalprogramma van de vakgroep Toegepaste Geografie en Planologie van de faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit te Utrecht. De uitvoering vond plaats in de periode september 1990 - juli 1991." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Rijksplanologische Dienst in Den Haag" ;
            sgpl:text_context "Verschillende instanties deden er lang over om te beslissen dat er voor ons helaas toch geen plaats was. Uiteindelijk konden we in februari ’93 beginnen op de afdeling Planning van de Rijksplanologische Dienst in Den Haag. Wegens gebrek aan studietijd was augustus ’93 de limiet." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746931 ;
            sgpl:spatialText "gemeente Spijkenisse" ;
            sgpl:text_context "Voorwoord. Voor U ligt het verslag van het onderzoek naar het kooppatronen van huishoudens in de gemeente Spijkenisse. Het onderzoek is verricht in het kader van het doktoraalprogramma van de vakgroep Toegepaste Geografie en Planologie van de faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit te Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3017382 ;
            sgpl:spatialText "Frankrijk" ;
            sgpl:text_context "5.3 HET HSL-PROJECT IN VOGELVLUCHT De ontwikkelingen rond het Nederlandse deel van de Hoge SnelheidsLijn (HSL) moeten gezien worden in het kader van Europese ontwikkelingen. In Frankrijk blijkt de eerste tgv verbinding tussen Parijs en Lyon een groot succes te zijn. Er worden bezettingsgraadpercentages gehaald van 72% en luchtvaartmaatschappijen constateren een afname van het passagiersaanbod op het traject (Visser & Bentvelsen, 1991)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "1. INLEIDING. De ruimtelijke planvorming in Nederland is aan verandering onderhevig. Het lijkt erop dat er gezocht wordt naar een nieuw besluitvormingsperspectief met een veranderde balans tussen de invloed van overheid en maatschappij." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2802361 ;
            sgpl:spatialText "België" ;
            sgpl:text_context "Het optimale tracé volgens de rpd’ van Rotterdam naar de Belgische grens loopt via Breda. Dit alternatief is echter niet uitgewerkt omdat België de HSL niet bij Breda over de grens wilde laten komen. De reden hiervoor was dat de HSL in België dan door een villawijk zou lopen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Groene Hart" ;
            sgpl:text_context "Een voorbeeld van het algemene beleid (niet specifiek op de HSL gericht) is het ontzien van natuurgebieden en open ruimtes in Nederland. Het Groene Hart zou dus niet doorsneden mogen worden door nieuwe infrastructuur. Allereerst valt op dat alle tracévarianten ten noorden van Rotterdam in meerdere of mindere mate het Groene Hart doorsnijden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755622 ;
            sgpl:spatialText "Gelderse Vallei" ;
            sgpl:text_context "De visievorming voor strategische gebieden wordt met name vastgelegd in: ROM’s en NU’s en sleutelprojecten. Een voorbeeld van een ROM-gebied is de Gelderse Vallei, waarbij het verminderen van de milieubelasting centraal staat. Een nieuwe werkwijze is de gebiedsgerichte Nadere Uitwerking (nu) van het ruimtelijk ontwikkelingsperspectief." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "Een ander voorbeeld van een mogelijke terugkoppeling is de afweging over het aansluitpunt met België. Het optimale tracé volgens de rpd’ van Rotterdam naar de Belgische grens loopt via Breda. Dit alternatief is echter niet uitgewerkt omdat België de HSL niet bij Breda over de grens wilde laten komen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "Koopgedrag" ;
            sgpl:text_context "Vooral voor (voormalige) groeigemeenten is dergelijke kennis interessant, omdat daar de diversiteit van het aantal groepen consumenten als gevolg van onder meer relatief snelle vergrijzing, ontgroening en huishoudensverdunning een grote vlucht zal nemen in de komende decennia. Doel van het onderzoek is inzicht te verkrijgen in het koopgedrag van huishoudens, zodat in de toekomst rekening kan worden gehouden met veranderingen in het voorzieningengebruik als gevolg van de huishoudensdifferentiatie. Op deze plaats wil ik de personen bedanken die me geholpen hebben dit onderzoek te verwezenlijken." ],
        [ sgpl:refersToConcept unesco:concept10702 ;
            sgpl:subjectText "Huishoudensdifferentiatie" ;
            sgpl:text_context "Vooral voor (voormalige) groeigemeenten is dergelijke kennis interessant, omdat daar de diversiteit van het aantal groepen consumenten als gevolg van onder meer relatief snelle vergrijzing, ontgroening en huishoudensverdunning een grote vlucht zal nemen in de komende decennia. Doel van het onderzoek is inzicht te verkrijgen in het koopgedrag van huishoudens, zodat in de toekomst rekening kan worden gehouden met veranderingen in het voorzieningengebruik als gevolg van de huishoudensdifferentiatie. Op deze plaats wil ik de personen bedanken die me geholpen hebben dit onderzoek te verwezenlijken." ],
        [ sgpl:refersToConcept unesco:concept6904 ;
            sgpl:subjectText "Mixed Scanning" ;
            sgpl:text_context "De discussie is echter in volle gang. Mixed Scanning is een besluitvormingstechniek die hier mogelijk behulpzaam bij kan zijn. Door Amitai Etzioni (1968) wordt deze besluitvormingstechniek omschreven als een mix van rationele en incrementele besluitvormingsmethoden." ],
        [ sgpl:refersToConcept unesco:concept10702 ;
            sgpl:subjectText "Huishoudensdifferentiatie" ;
            sgpl:text_context "Vooral voor (voormalige) groeigemeenten is dergelijke kennis interessant, omdat daar de diversiteit van het aantal groepen consumenten als gevolg van onder meer relatief snelle vergrijzing, ontgroening en huishoudensverdunning een grote vlucht zal nemen in de komende decennia. Doel van het onderzoek is inzicht te verkrijgen in het koopgedrag van huishoudens, zodat in de toekomst rekening kan worden gehouden met veranderingen in het voorzieningengebruik als gevolg van de huishoudensdifferentiatie. Op deze plaats wil ik de personen bedanken die me geholpen hebben dit onderzoek te verwezenlijken." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "Koopgedrag" ;
            sgpl:text_context "Vooral voor (voormalige) groeigemeenten is dergelijke kennis interessant, omdat daar de diversiteit van het aantal groepen consumenten als gevolg van onder meer relatief snelle vergrijzing, ontgroening en huishoudensverdunning een grote vlucht zal nemen in de komende decennia. Doel van het onderzoek is inzicht te verkrijgen in het koopgedrag van huishoudens, zodat in de toekomst rekening kan worden gehouden met veranderingen in het voorzieningengebruik als gevolg van de huishoudensdifferentiatie. Op deze plaats wil ik de personen bedanken die me geholpen hebben dit onderzoek te verwezenlijken." ],
        [ sgpl:refersToConcept unesco:concept6904 ;
            sgpl:subjectText "Mixed Scanning" ;
            sgpl:text_context "De discussie is echter in volle gang. Mixed Scanning is een besluitvormingstechniek die hier mogelijk behulpzaam bij kan zijn. Door Amitai Etzioni (1968) wordt deze besluitvormingstechniek omschreven als een mix van rationele en incrementele besluitvormingsmethoden." ] ;
    sgpl:thesisID 268 .

sgpl:Thesis269 a sgpl:SGPLThesis ;
    dcterms:creator "Erwin van Klaveren",
        "Richard van Dipten" ;
    dcterms:issued 1993 ;
    dcterms:title "Een studie naar de morfologische verstedelijking van de regio Amsterdam van 1950 tot 1985 met behulp van een GIS",
        "Mate(n) van verstedelijking" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "regio Amsterdam" ;
            sgpl:text_context "MATE(N) VAN VERSTEDELIJKING. Een studie naar de morfologische verstedelijking van de regio Amsterdam van 1950 tot 1985 met behulp van een GIS. Doctoraalscriptie Geografische Informatie Systemen Vakgroep G & P Faculteit der Ruimtelijke Wetenschappen Rijksuniversiteit Utrecht September 1993." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759798 ;
            sgpl:spatialText "Amstelveen" ;
            sgpl:text_context "De wens werd geuit dat deze niet te veel mocht groeien, en zeker niet in oost-west richting, omdat dit ten koste zou gaan van de groenstroken aan weerszijde van dit stadje. De lob ‘Zuid’ omvatte de kernen Buitenveldert en Amstelveen, waarvan de kern Amstelveen alléén al circa 90.000 inwoners telde, met een gemiddelde woningdichtheid van 40 woningen per hectare. De lob ’Zuid-Oost’, aan de westzijde begrensd door de spoorlijn Amsterdam-Utrecht, omvatte in zijn totaliteit Duivendrecht, Diemen, de Bijlmermeer, alsmede een gedeelte van de Oost-Bijlmermeerpolder, de polder Gein en Gaasp, de Nieuwe Bullewijkerpolder, de Bullewijker en Holendrechterpolder." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748413 ;
            sgpl:spatialText "Purmerend" ;
            sgpl:text_context "In de andere kwadranten zijn naast het olievlek- model geen noemenswaardige andere ontwikkelingen te zien. De laatste periode kent ook een duidelijke satellietontwikkeling in het noordoostelijke en zuidwestelijke kwadrant; namelijk die delen van de regio waar Purmerend respectievelijk Hoofddorp zijn gelegen. Voor de overige kwadranten blijft alleen het olievlekmodel opgaan, hetzij in mindere mate dan in de twee voorafgaande perioden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Noordvleugel van de Randstad" ;
            sgpl:text_context "Het onderzoek poogt dan ook niet zo zeer nieuwe invalshoeken met betrekking tot de recente urbanisatie van de regio te bieden doch meer een aantal voorzetten te geven tot de manier waarop verstedelijking in een GIS geanalyseerd kan worden. Mede daarom is deze scriptie een voorstudie tot het promotie-onderzoek van onze begeleider Fred Toppen, die met behulp van GIS een vergelijkend onderzoek doet in de verstedelijking van Toronto (Canada) en de Noordvleugel van de Randstad. Ook de gemeente Amsterdam was geïnteresseerd in de resultaten daar het in kaart brengen van de verstedelijking slechts op beperkte schaal is gebeurd en niet verder reikte dan 1970." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "In het kader van onze specialisatie Geografische Informatie Systemen aan de faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht hebben wij een onderzoek uitgevoerd waarvan de resultaten in dit verslag zijn neergelegd. De verstedelijking van Amsterdam is een onderwerp wat door de jaren heen reeds breed is uitgemeten. Het gebruik van een Geografisch Informatie Systeem in deze is echter nog betrekkelijk nieuw." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Industriële schaalvergroting leidde tot een westelijke uitbreiding van het havengebied. Ook Schiphol werd aan het eind van de jaren vijftig steeds belangrijker voor handel en industrie. De centrale stad werd in de vijftiger jaren echter nog steeds gezien als voornaamste bron van werkgelegenheid; de zogeheten cityfunctie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753801 ;
            sgpl:spatialText "Hoofddorp" ;
            sgpl:text_context "In de andere kwadranten zijn naast het olievlek- model geen noemenswaardige andere ontwikkelingen te zien. De laatste periode kent ook een duidelijke satellietontwikkeling in het noordoostelijke en zuidwestelijke kwadrant; namelijk die delen van de regio waar Purmerend respectievelijk Hoofddorp zijn gelegen. Voor de overige kwadranten blijft alleen het olievlekmodel opgaan, hetzij in mindere mate dan in de twee voorafgaande perioden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6167865,
                geonames:6251999 ;
            sgpl:spatialText "Toronto (Canada)" ;
            sgpl:text_context "Het onderzoek poogt dan ook niet zo zeer nieuwe invalshoeken met betrekking tot de recente urbanisatie van de regio te bieden doch meer een aantal voorzetten te geven tot de manier waarop verstedelijking in een GIS geanalyseerd kan worden. Mede daarom is deze scriptie een voorstudie tot het promotie-onderzoek van onze begeleider Fred Toppen, die met behulp van GIS een vergelijkend onderzoek doet in de verstedelijking van Toronto (Canada) en de Noordvleugel van de Randstad. Ook de gemeente Amsterdam was geïnteresseerd in de resultaten daar het in kaart brengen van de verstedelijking slechts op beperkte schaal is gebeurd en niet verder reikte dan 1970." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "het centraal station van Amsterdam" ;
            sgpl:text_context "Dit uit zich tevens in de hoge, maar steeds lager wordende, scores van het olie- vlekmodel. Ten behoeve van het tweede analysedeel is het onderzoeksgebied verdeeld in een viertal deelgebieden waarbij gekozen is voor het centraal station van Amsterdam als middelpunt. Het havengebied vormt dan de scheiding tussen noord en zuid, waarmee het Noordzeekanaal als geografische maar toch ook als psychologische grens als scheiding tussen noord en zuid gehandhaafd blijft." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "gemeente Amsterdam" ;
            sgpl:text_context "Wat is en was het ruimtelijk beeld van het successievelijk aanwenden van ruraal gebied voor stedelijk grondgebruik in de regio Amsterdam vanaf 1950 tot op heden, en welke ruimtelijke factoren zijn van invloed geweest op dit proces? Wat is en was het ruimtelijk beeld van de gewenste richting van verstedelijking voor de gemeente Amsterdam en de omliggende gemeenten en hoe verhoudt de onderzochte ver- stedelijkingstrend zich tot dit beleid? Onderzoeksvragen aan de hand van de tweede probleemstelling: 1 Heeft het verstedelijkingsproces zich conform de ruimtelijke beleidsplannen van de verschillende bestuursniveaus voltrokken?" ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Morfologische verstedelijking" ;
            sgpl:text_context "De morfologie van een verschijnsel kan worden omschreven als de vorm(en) welke zij in het verleden en heden heeft aangenomen ten gevolge van achterliggende proces(sen). Morfologische verstedelijking heeft dan ook betrekking op het geheel van bebouwde en onbebouwde ruimten, de spreiding van individuen, groepen en instituties, en hun activiteiten en interacties. De achterliggende processen van de morfologische verstedelijking zijn complex van aard, en vaak in tegenovergesteld richting werkend." ],
        [ sgpl:refersToConcept unesco:concept17000 ;
            sgpl:subjectText "Geografisch Informatie Systeem" ;
            sgpl:text_context "Per model zijn ten behoeve van de analyses hypothesen opgesteld die, conform de theoretische veronderstellingen achter de modellen, aangeven welke scenario’s van urbane groei worden verondersteld. De operationalisatie van de modellen is zo opgezet dat ze 'gebruiksklaar’ zijn voor analyse met behulp van een Geografisch Informatie Systeem. Toetsing van de hypothesen geschiedt door het uitdrukken van de modellen in een bepaalde maat van verstedelijking." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Verstedelijkingsmodel" ;
            sgpl:text_context "In Hoofdstuk 2 wordt het gebruik van de modellen verantwoord en tevens duidelijk gemaakt welke modellen en analysemethoden in dit onderzoek gebruikt worden. Voorts wordt elk verstedelijkingsmodel in afzonderlijke paragrafen behandeld, waarin ondermeer aandacht voor de theoretische achtergronden, werking en wijze van analyse van de modellen. Aan het eind van elke paragraaf wordt voor alle duidelijkheid alles nog eens in schema weergegeven." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Verstedelijkingsmodel" ;
            sgpl:text_context "In Hoofdstuk 2 wordt het gebruik van de modellen verantwoord en tevens duidelijk gemaakt welke modellen en analysemethoden in dit onderzoek gebruikt worden. Voorts wordt elk verstedelijkingsmodel in afzonderlijke paragrafen behandeld, waarin ondermeer aandacht voor de theoretische achtergronden, werking en wijze van analyse van de modellen. Aan het eind van elke paragraaf wordt voor alle duidelijkheid alles nog eens in schema weergegeven." ],
        [ sgpl:refersToConcept unesco:concept17000 ;
            sgpl:subjectText "Geografisch Informatie Systeem" ;
            sgpl:text_context "Per model zijn ten behoeve van de analyses hypothesen opgesteld die, conform de theoretische veronderstellingen achter de modellen, aangeven welke scenario’s van urbane groei worden verondersteld. De operationalisatie van de modellen is zo opgezet dat ze 'gebruiksklaar’ zijn voor analyse met behulp van een Geografisch Informatie Systeem. Toetsing van de hypothesen geschiedt door het uitdrukken van de modellen in een bepaalde maat van verstedelijking." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Morfologische verstedelijking" ;
            sgpl:text_context "De morfologie van een verschijnsel kan worden omschreven als de vorm(en) welke zij in het verleden en heden heeft aangenomen ten gevolge van achterliggende proces(sen). Morfologische verstedelijking heeft dan ook betrekking op het geheel van bebouwde en onbebouwde ruimten, de spreiding van individuen, groepen en instituties, en hun activiteiten en interacties. De achterliggende processen van de morfologische verstedelijking zijn complex van aard, en vaak in tegenovergesteld richting werkend." ] ;
    sgpl:thesisID 269 .

sgpl:Thesis270 a sgpl:SGPLThesis ;
    dcterms:creator "Maarten van Oostveen",
        "Marcel de Hoogt" ;
    dcterms:issued 1993 ;
    dcterms:title "GROTE NEDERLANDSE TRANSPORTONDERNEMINGEN IN INTERNATIONALE CONTEXT",
        "ONDERNEMINGSSTRATEGIE, ORGANISATIESTRUCTUUR, INTERNATIONALISERING EN LOKATIEPATROON VAN VIJF GROTE NEDERLANDSE TRANSPORTONDERNEMINGEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Binnen Europa lopen de omvangrijkste goederenstromen via Nederland. Naast een centrale ligging heeft Nederland natuurlijke voordelen. Het ligt direct aan zee en via de grote rivieren zijn de belangrijkste industriegebieden van NW-Europa eenvoudig te bereiken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751280 ;
            sgpl:spatialText "de Maasvlakte" ;
            sgpl:text_context "De Maasvlakte biedt voldoende ruimte en diepgang om de grotere containerschepen te lossen. Onder druk van de containerrederijen en de gemeente Rotterdam, werden Unitcentre en ECT gedwongen tot een dialoog. Uitbreidingen op de Maasvlakte voor containeroverslag is van levensbelang voor Rotterdam." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6692168 ;
            sgpl:spatialText "Benelux" ;
            sgpl:text_context "De distributieactiviteiten van Van Ommeren zijn voornamelijk geconcentreerd op de Benelux. De distributiecentra in Engeland, Duitsland en Frankrijk zijn bestemd voor lokale klanten en zijn niet te beschouwen als een netwerk. In Nederland en Belgi+ wordt vanuit een netwerk ge+ksploiteerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "Het gedrag van grote ondernemingen ten aanzien van hun activiteiten in bepaalde regio’s vormt namelijk een belangrijk element van de toenemende internationale competitie tussen regio’s in West-Europa. Dit is de aanleiding van een onderzoekprogramma, dat INRO-TNO in samenwerking met de Geografische Faculteit van de Rijksuniversiteit Utrecht uitvoert. Het onderzoek van Marcel de Hoogt en Maarten van Oostveen over de grootste transportondernemingen in Nederland past uitstekend hierin." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Dit is de aanleiding van een onderzoekprogramma, dat INRO-TNO in samenwerking met de Geografische Faculteit van de Rijksuniversiteit Utrecht uitvoert. Het onderzoek van Marcel de Hoogt en Maarten van Oostveen over de grootste transportondernemingen in Nederland past uitstekend hierin. Het voor u liggende rapport is de eerste van een serie, die gaan over de grootste Nederlandse ondernemingen in de transportsector, elektrotechnische industrie, de bouwnijverheid, de chemische industrie, de voedings- en genotmiddelenindustrie en de bankensector." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "De mainport Schiphol is de vierde luchtvrachthaven van Europa, na Frankfurt, Londen en Parijs. Net als bij het spoorvervoer ligt bij het luchtvervoer het accent op het passagiervervoer. De opbrengsten uit het passagiervervoer zijn bijna vier maal groter dan uit het vrachtvervoer." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745641 ;
            sgpl:spatialText "Venlo" ;
            sgpl:text_context "De decentralisatie van bepaalde terminals vanuit de mainports naar de logistieke knooppunten is zichtbaar in Venlo en Twente. Opgemerkt dient te worden dat de mainports nog altijd streven naar de concentratie van aanverwante activiteiten (depotfunctie, strippen & stuffen, reparatie) rond deze internationale hoofdknooppunten. De decentralisatie van de ECT-terminal in Venlo moet worden beschouwd als een ‘verlengde kade’ in het directe achterland van de mainport Rotterdam." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "In Nederland zijn Rotterdam en Amsterdam de internationale logistieke knooppunten. Meer dan de helft van de toegevoegde waarde van de Nederlandse transportsector wordt gerealiseerd in deze mainports. Er zijn een aantal voor- en nadelen te noemen voor de concentratie van logistieke functies in de mainport." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:11524800 ;
            sgpl:spatialText "het Botlekgebied" ;
            sgpl:text_context "In Nederland zijn de tankopslagactiviteiten van Van Ommeren geconcentreerd in de mainports. In het Botlekgebied, Europoort, Vlaardingen (allen in regio Rotterdam) en Amsterdam staan terminals van Van Ommeren. De concurrentiepositie van Rotterdam als vestigingsplaats voor tankopslagterminals zal in toenemende mate bepaald worden door factoren als: kwaliteit infrastructuur (goede bereikbaarheid en diepe vaarwegen), hoog gekwalificeerd personeel, aanwezigheid van petrochemische industrie, milieu-aspecten, goede laad- en losfaciliteiten en aansluiting op (internationale pijpleidingssystemen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "In Nederland zijn de tankopslagactiviteiten van Van Ommeren geconcentreerd in de mainports. In het Botlekgebied, Europoort, Vlaardingen (allen in regio Rotterdam) en Amsterdam staan terminals van Van Ommeren. De concurrentiepositie van Rotterdam als vestigingsplaats voor tankopslagterminals zal in toenemende mate bepaald worden door factoren als: kwaliteit infrastructuur (goede bereikbaarheid en diepe vaarwegen), hoog gekwalificeerd personeel, aanwezigheid van petrochemische industrie, milieu-aspecten, goede laad- en losfaciliteiten en aansluiting op (internationale pijpleidingssystemen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "ondernemingsstrategie" ;
            sgpl:text_context "Door het formuleren van een ondernemingsstrategie reageert een onderneming op ontwikkelingen en tendensen uit de omgeving. De ondernemingsstrategie staat aan de basis van veranderingen in de organisatiestructuur, internationalisering en het lokatiepatroon van de onderneming. Er is gekozen voor een onderzoeksopzet die uit drie delen bestaat." ],
        [ sgpl:refersToConcept unesco:mt7.35 ;
            sgpl:subjectText "lokatiepatroon" ;
            sgpl:text_context "Om hierop te kunnen reageren of anticiperen wordt de ondernemingsstrategie bepaald. Het formuleren van de ondernemingsstrategie is de feitelijke basis voor de verandering van het lokatiepatroon. Dicken (1986) onderscheidt twee groepen factoren die het veranderen van een lokatiepatroon veroorzaken: externe en interne factoren." ],
        [ sgpl:refersToConcept unesco:concept12783 ;
            sgpl:subjectText "internationalisering" ;
            sgpl:text_context "Ten slotte zal in het kort worden ingegaan op de vestigingsplaatstheorie en het intemationaliseringsproces van ondernemingen. Internationalisatie verandert de context van het handelen voor de onderneming. De onderneming betreedt onbekende markten en tracht zich daar een positie te verwerven." ],
        [ sgpl:refersToConcept unesco:concept12783 ;
            sgpl:subjectText "internationalisering" ;
            sgpl:text_context "Ten slotte zal in het kort worden ingegaan op de vestigingsplaatstheorie en het intemationaliseringsproces van ondernemingen. Internationalisatie verandert de context van het handelen voor de onderneming. De onderneming betreedt onbekende markten en tracht zich daar een positie te verwerven." ],
        [ sgpl:refersToConcept unesco:mt7.35 ;
            sgpl:subjectText "lokatiepatroon" ;
            sgpl:text_context "Om hierop te kunnen reageren of anticiperen wordt de ondernemingsstrategie bepaald. Het formuleren van de ondernemingsstrategie is de feitelijke basis voor de verandering van het lokatiepatroon. Dicken (1986) onderscheidt twee groepen factoren die het veranderen van een lokatiepatroon veroorzaken: externe en interne factoren." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "ondernemingsstrategie" ;
            sgpl:text_context "Door het formuleren van een ondernemingsstrategie reageert een onderneming op ontwikkelingen en tendensen uit de omgeving. De ondernemingsstrategie staat aan de basis van veranderingen in de organisatiestructuur, internationalisering en het lokatiepatroon van de onderneming. Er is gekozen voor een onderzoeksopzet die uit drie delen bestaat." ] ;
    sgpl:thesisID 270 .

sgpl:Thesis271 a sgpl:SGPLThesis ;
    dcterms:creator "Marco van Zwetselaar" ;
    dcterms:issued 1992,
        1993 ;
    dcterms:title "Agrarische commercialisatie in wereldcontext",
        "Katoen in Noord-Kameroen" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:11257194 ;
            sgpl:spatialText "arrondissement Pitoa" ;
            sgpl:text_context "Mijn onderzoek zou zich, zoals eerdere onderzoeken (Hoogstraten 1977, Laval 1977, Levrat 1984, Bergsma 1991), richten op de betekenis van de katoenverbouw voor Noord-Kameroen. Het onderzoek zou vergelijkbaar zijn met dat van Anke Bergsma, die een jaar eerder onderzoek deed in het aangrenzende arrondissement Pitoa. In het onderzoeksplan werden twee aspecten onderscheiden aan de betekenis van de katoen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2228373 ;
            sgpl:spatialText "Maroua" ;
            sgpl:text_context "In 1927 werd in Garoua de SCNCT (Société Cotonnière du Nord-Cameroun et du Tchad) opgericht, onder directie van een oud-militair. Na twee proefnemingen in Maroua en Garoua bleek dat men kon rekenen op rendementen tussen 300 en 600 kg/ha. Hoewel het rendement in Maroua hoger was, koos men toch voor Garoua, waarschijnlijk vanwege haar betere toegankelijkheid (rivierhaven)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2233387 ;
            sgpl:spatialText "Kameroen" ;
            sgpl:text_context "Het wordt wel aangeduid met ‘de agrarische crisis’ of ‘de schuldencrisis’. De prijsdaling in Kameroen is feitelijk een voorbeeld van de manier waarop dit proces zich in een rurale, perifere, agrarisch en economisch eenzijdige regio kan manifesteren. Wanneer de gevolgen van de internationale vervlechting negatief uitpakken, is men al snel geneigd tot ‘afhankelijkheidsdenken’." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2235957 ;
            sgpl:spatialText "Adoumri" ;
            sgpl:text_context "Na Bibémi, dat 4389 inwoners telt, is Houla met 2731 inwoners het grootste dorp van het arrondissement (zie kaart 3-3). Binnen het onderzoeksgebied is alleen Adoumri qua grootte vergelijkbaar met Houla (2169 inwoners). Alle overige dorpen hebben een omvang van minder dan 1200 inwoners." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2234802,
                geonames:8667760 ;
            sgpl:spatialText "Pomla-Bantadje" ;
            sgpl:text_context "Pomla en Bantadje zijn eigenlijk twee afzonderlijke dorpjes die ongeveer P/2 kilometer uiteen liggen. Door de grote instroom van migranten zijn ze echter aan elkaar vastgegroeid, zoals goed te zien is op kaart 3-4. Om deze reden zijn ze samengenomen in dit onderzoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Het onderzoek maakt deel uit van een meerjarig sociaal-economiscn onderzoeksprogramma in Noord-Kameroen. Dit onderzoeksprogramma is opgezet in een samenwerkingsverband van het Institut des Sciences Humaines te Kameroen (ISH), een afdeling van het Kameroense ministerie van hoger onderwijs en wetenschappelijk onderzoek (MESIRES), het Afrika Studiecentrum (ASC) te Leiden, en de vakgroep Sociale Geografie van Ontwikkelingslanden (SGO) van de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. De probleemstelling van deze scriptie, die in paragraaf 1.3 geformuleerd wordt, wijkt op belangrijke punten af van hetgeen oorspronkelijk de bedoeling was." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "provincie Nord" ;
            sgpl:text_context "Zoals afbeelding 3-2 laat zien nemen de regionale verschillen in deze periode toe. In de provincie Extrême-Nord breidt het areaal onder katoen zich snel uit, in de provincie Nord gaat dit veel langzamer. Bovendien liggen de rendementen in Extrême-Nord veel hoger en nemen ze veel sneller toe dan in Nord." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1814991 ;
            sgpl:spatialText "China" ;
            sgpl:text_context "De internationale katoenprijs wordt bepaald door het spel van vraag en aanbod. Bij verre de grootste consument is China, dat bijna 23% van de wereldproduktie gebruikt, daarna volgen de USSR met 13%, India met 10%, de USA met 9% en West-Europa met 8.5%. Op een gedeelde 6e plaats volgen Brazilië, Japan en het continent Afrika, ieder met een aandeel van 4%." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2231755 ;
            sgpl:spatialText "provincie Extrême-Nord" ;
            sgpl:text_context "Zoals afbeelding 3-2 laat zien nemen de regionale verschillen in deze periode toe. In de provincie Extrême-Nord breidt het areaal onder katoen zich snel uit, in de provincie Nord gaat dit veel langzamer. Bovendien liggen de rendementen in Extrême-Nord veel hoger en nemen ze veel sneller toe dan in Nord." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2328926 ;
            sgpl:spatialText "Nigeria" ;
            sgpl:text_context "Wanneer we deze correctie uitvoeren, wordt de prijsdaling nog schrijnender*. Het gemiddelde rendement daalt mede door de smokkel van vele tonnen katoen naar Nigeria en Tsjaad. (Hetgeen weer een effect heeft op de sociaal-ruimtelijke differentiatie.)" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Houla" ;
            sgpl:text_context "Na Bibémi, dat 4389 inwoners telt, is Houla met 2731 inwoners het grootste dorp van het arrondissement (zie kaart 3-3). Binnen het onderzoeksgebied is alleen Adoumri qua grootte vergelijkbaar met Houla (2169 inwoners). Alle overige dorpen hebben een omvang van minder dan 1200 inwoners." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Gore Gaska" ;
            sgpl:text_context "Houla is gelegen aan de Mayo Kébi, een rivier die in de natte tijd een enorm areaal onder water zet — in de breedte bestrijkt hij dan verscheidene kilometers. Gore Gaska is het kleinste dorpje van de drie. Het telt 75 gezinnen en 340 inwoners." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751773 ;
            sgpl:spatialText "Afrika Studiecentrum (ASC) te Leiden" ;
            sgpl:text_context "Het onderzoek maakt deel uit van een meerjarig sociaal-economiscn onderzoeksprogramma in Noord-Kameroen. Dit onderzoeksprogramma is opgezet in een samenwerkingsverband van het Institut des Sciences Humaines te Kameroen (ISH), een afdeling van het Kameroense ministerie van hoger onderwijs en wetenschappelijk onderzoek (MESIRES), het Afrika Studiecentrum (ASC) te Leiden, en de vakgroep Sociale Geografie van Ontwikkelingslanden (SGO) van de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. De probleemstelling van deze scriptie, die in paragraaf 1.3 geformuleerd wordt, wijkt op belangrijke punten af van hetgeen oorspronkelijk de bedoeling was." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2233387 ;
            sgpl:spatialText "Noord-Kameroen" ;
            sgpl:text_context "Agrarische commercialisatie, kort gedefinieerd als 'toenemende produktie bestemd voor de verkoop', wordt hierbij gezien als een noodzakelijke (maar niet voldoende) voorwaarde voor regionale ontwikkeling. In deze scriptie staat agrarische commercialisatie centraal, en wel in de vorm van de verbouw van katoen in Noord-Kameroen. Katoen wordt in Noord-Kameroen niet ‘zomaar’ verbouwd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2234272 ;
            sgpl:spatialText "arrondissement Bibémi" ;
            sgpl:text_context "De commercialisatie van katoen in Noord-Kameroen heeft als uiteindelijk doel rurale ontwikkeling, ofwel het doen stijgen van het economisch draagvlak van de regio en het verbeteren van de levensstandaard van de bevolking. Meer specifiek houdt deze scriptie zich bezig met de betekenis van de katoenverbouw (in termen van landgebruik, arbeids- en kapitaalinput en opbrengsten) voor de boerenhuishoudens in het arrondissement Bibémi. Het belang van de katoenverbouw wordt bezien in het licht van de recente keldering van de producentenprijs van de katoen, die het gevolg is van een veelheid aan regio-externe factoren." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1744 ;
            sgpl:subjectText "agrarische commercialisatie" ;
            sgpl:text_context "Een belangrijk speerpunt in het SOREGIO-programma is het onderzoek naar agrarische commercialisatie. Agrarische commercialisatie, kort gedefinieerd als \"toenemende produktie bestemd voor de verkoop\", wordt hierbij gezien als een noodzakelijke (maar niet voldoende) voorwaarde voor regionale ontwikkeling. In deze scriptie staat agrarische commercialisatie centraal, en wel in de vorm van de verbouw van katoen in Noord-Kameroen." ],
        [ sgpl:refersToConcept unesco:concept1777 ;
            sgpl:subjectText "katoenverbouw" ;
            sgpl:text_context "Na de Tweede Wereldoorlog werd de plantage in Pitoa weer in gebruik genomen door de Compagnie Cotonnière Equatoriale Franqaise, maar de Noord-Kameroense katoenexporten bleven tussen 1945 en 1951 beperkt tot de overschotten die niet opgekocht werden door lokale handwerkslieden. Zo kwam de katoenverbouw in Kameroen niet alleen op een andere manier, maar ook veel later op gang dan in de rest van franstalig Afrika. De CFDT (Compagnie Franqaise pour le Développement des fibres Textiles') werd opgericht in 1949 als een para-publieke onderneming die tot doel had de verbouw van textielgewassen (en dan met name de katoen) in de Franse koloniën te commercialiseren." ],
        [ sgpl:refersToConcept unesco:concept11559 ;
            sgpl:subjectText "wereldsysteem" ;
            sgpl:text_context "Waar de oorzaken van ongelijke ontwikkeling ook mogen liggen, de totale omvang van de internationale handel, en het aantal participanten daarin, is overal in de wereld verder toegenomen. Dit verschijnsel wordt wel aangeduid met ‘toenemende integratie in het wereldsysteem’. De belangrijkste theoreticus die regionale ontwikkeling verklaart vanuit de integratie in het wereldsysteem is de historicus I. Wallerstein." ],
        [ sgpl:refersToConcept unesco:concept1744 ;
            sgpl:subjectText "agrarische commercialisatie" ;
            sgpl:text_context "Een belangrijk speerpunt in het SOREGIO-programma is het onderzoek naar agrarische commercialisatie. Agrarische commercialisatie, kort gedefinieerd als \"toenemende produktie bestemd voor de verkoop\", wordt hierbij gezien als een noodzakelijke (maar niet voldoende) voorwaarde voor regionale ontwikkeling. In deze scriptie staat agrarische commercialisatie centraal, en wel in de vorm van de verbouw van katoen in Noord-Kameroen." ],
        [ sgpl:refersToConcept unesco:concept11559 ;
            sgpl:subjectText "wereldsysteem" ;
            sgpl:text_context "Waar de oorzaken van ongelijke ontwikkeling ook mogen liggen, de totale omvang van de internationale handel, en het aantal participanten daarin, is overal in de wereld verder toegenomen. Dit verschijnsel wordt wel aangeduid met ‘toenemende integratie in het wereldsysteem’. De belangrijkste theoreticus die regionale ontwikkeling verklaart vanuit de integratie in het wereldsysteem is de historicus I. Wallerstein." ],
        [ sgpl:refersToConcept unesco:concept1777 ;
            sgpl:subjectText "katoenverbouw" ;
            sgpl:text_context "Na de Tweede Wereldoorlog werd de plantage in Pitoa weer in gebruik genomen door de Compagnie Cotonnière Equatoriale Franqaise, maar de Noord-Kameroense katoenexporten bleven tussen 1945 en 1951 beperkt tot de overschotten die niet opgekocht werden door lokale handwerkslieden. Zo kwam de katoenverbouw in Kameroen niet alleen op een andere manier, maar ook veel later op gang dan in de rest van franstalig Afrika. De CFDT (Compagnie Franqaise pour le Développement des fibres Textiles') werd opgericht in 1949 als een para-publieke onderneming die tot doel had de verbouw van textielgewassen (en dan met name de katoen) in de Franse koloniën te commercialiseren." ] ;
    sgpl:thesisID 271 .

sgpl:Thesis273 a sgpl:SGPLThesis ;
    dcterms:creator "R. Vermeulen" ;
    dcterms:issued 1993 ;
    dcterms:title "Een onderzoek naar de haalbaarheid van een HOV busverbinding",
        "HOOGWAARDIG OPENBAAR VERVOER TUSSEN UTRECHT CS EN OVERVECHT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748815 ;
            sgpl:spatialText "Overvecht" ;
            sgpl:text_context "1.3 HET VERKEER EN VERVOERBELEID Zoals te zien in figuur 1.2 is Overvecht gelegen aan de noord- kant van Utrecht. In dit gebied wonen ruim 30.000 mensen en bevinden zich belangrijke werklocaties." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "HOOFDSTUK 1. INLEIDING 1.1 INTRODUCTIE Sinds de ]aren vijftig is de mobiliteit in Nederland sterk toegenomen. Deze toegenomen mobiliteit uit zich vooral door een sterk toegenomen automobiliteit, met als gevolg nadelige effecten voor het milieu en congestieverschijselen in de Randstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Gemeente Utrecht" ;
            sgpl:text_context "Ten aanzien van het Rijksbeleid kunnen de volgende doelstellingen worden geformuleerd: 1. Verbetering van de bereikbaarheid over de weg. 2. Verbetering van de bereikbaarheid per openbaar vervoer. 3. Geleiding van de mobiliteit. 4. Verbetering van de leefbaarheid. De gemeente Utrecht schaart zich achter de doelstellingen zoals deze door het Rijk zijn geformuleerd (HWU, 1991, p.11). Dit betekent dat het Rijksbeleid vertaald moet worden naar de lokale en regionale situatie in Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht CS" ;
            sgpl:text_context "De doelstelling van dit rapport kan als volgt worden ontschre- ven: Wat is de potentie van een Hoogwaardig Openbaar Vervoer- verbinding tussen Utrecht CS en Overvecht? In de studie zal worden bekeken of de bestaande woon- en werkgebieden voldoende draagvlak bieden.voor een HOV—buslijn. De probleemstelling van het onderzoek is als volgt geformu- leerd: is er voor de realisatie van een Hoogwaardig Openbaar Busvervoer lijn tussen Utrecht CS en Overvecht voldoende draagvlak aanwezig, waarbij rekening wordt gehouden met de (kwaliteits) eisen zoals deze door de potentiële reizigers zijn geformuleerd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "de noord- kant van Utrecht" ;
            sgpl:text_context "1.3 HET VERKEER EN VERVOERBELEID Zoals te zien in figuur 1.2 is Overvecht gelegen aan de noord- kant van Utrecht. In dit gebied wonen ruim 30.000 mensen en bevinden zich belangrijke werklocaties." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912,
                geonames:2748815 ;
            sgpl:spatialText "station Utrecht Overvecht" ;
            sgpl:text_context "In dit gebied wonen ruim 30.000 mensen en bevinden zich belangrijke werklocaties. Verder vinden we hier een groot stadswinkelcentrum Utrecht Overvecht en als belang- rijk openbaar vervoer knooppunt station Utrecht Overvecht. Het rijksbeleid zoals geformuleerd in de Vierde Nota over de Ruimtelijke Ordening, de Vierde Nota Extra en de Tweede Struc- tuurschema Verkeer en Vervoer is gericht op het terugdringen van het autoverkeer en het bevorderen van het gebruik van Openbaar Vervoer." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743977,
                geonames:2745431,
                geonames:2745912,
                geonames:2757014,
                geonames:2757783 ;
            sgpl:spatialText "de as Vleuten - Utrecht CS - Rijnsweerd - De Uithof - (Zeist/De Bilt)" ;
            sgpl:text_context "Deze snelle en directe verbindingen zouden moeten kunnen concurreren met de auto. Concrete plannen voor Hoog- vaardig Openbaar Vervoer bestaan er al voor de as Vleuten - Utrecht CS - Rijnsweerd - De Uithof - (Zeist/De Bilt) in de vorm van een nieuw aan te leggen sneltram. De doelstelling van dit rapport kan als volgt worden ontschre- ven: Wat is de potentie van een Hoogwaardig Openbaar Vervoer- verbinding tussen Utrecht CS en Overvecht?" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Vervoerregio Utrecht" ;
            sgpl:text_context "Het GVU staat nu voor de taak om te komen tot een (meer) marktgerichte benadering in het stadsvervoer zonder dat dit ten koste gaat van het voorzieningenniveau. Tegelijkertijd heeft de vervoerregio Utrecht in het kader van de Vierde Nota Extra (Vinex) een investeringsbod gekregen van 600 miljoen gulden voor het creëren van Hoogwaardig Openbaar Vervoer (HOV). Dit openbaarvervoersysteem kenmerkt zich vooral door een hoge betrouwbaarheid, snelheid en comfort (Nota HWU, 1991, p.41)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "De gemeente Utrecht schaart zich achter de doelstellingen zoals deze door het Rijk zijn geformuleerd (HWU, 1991, p.11). Dit betekent dat het Rijksbeleid vertaald moet worden naar de lokale en regionale situatie in Utrecht. Voor het aantal voertuigkilometers betreffende het woon-werk verkeer gelden binnen de stad tot 2015 de taakstellingen zoals deze in figuur 1.3 worden weergegeven (HWU, 1991, p.14)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Sinds de ]aren vijftig is de mobiliteit in Nederland sterk toegenomen. Deze toegenomen mobiliteit uit zich vooral door een sterk toegenomen automobiliteit, met als gevolg nadelige effecten voor het milieu en congestieverschijselen in de Randstad. In de jaren zestig en zeventig wordt het snel groeiende autoverkeer opgevangen door een snelle uitbreiding van het wegennet (Hakkesteegt, 1991, p.2)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept661 ;
            sgpl:subjectText "Reissnelheid" ;
            sgpl:text_context "Een eerste selectie van de verschillende alternatieven zal plaatsvinden op basis van de criteria reissnelheid en het aantal inwoners dat binnen het invloedsgebied van een HOV halte woont. Alvorens te beginnen met het vergelijken van de verschillende alternatieven op basis van de reissnelheid moeten er eerst een aantal veronderstellingen worden geformuleerd. Bij de berekening van de reissnelheid wordt uitgegaan van: een maximum snelheid van de HOV bus van 50 kilometer per uur (Vt=14m/s);" ],
        [ sgpl:refersToConcept unesco:concept2842 ;
            sgpl:subjectText "Kringentheorie" ;
            sgpl:text_context "Van de overgebleven alternatieven wordt de omvang van de vervoervraag verfijnd door middel van toepassing van de kringentheorie. Uitgangspunt bij de kringentheorie is dat de bereidheid om naar een HOV-halte te lopen afneemt naarmate de afstand tot een halte toeneemt. Vervolgens wordt er gekeken naar hoeveel mensen in Overvecht binnen het invloedsgebied van een HOV-voorziening wonen, en dus daadwerkelijk gebruik van de HOV-bus zouden kunnen maken." ],
        [ sgpl:refersToConcept unesco:concept15714 ;
            sgpl:subjectText "Hoogwaardig Openbaar Vervoer" ;
            sgpl:text_context "Een toename van het aantal reizigers in het openbaar vervoer, die volgens de taakstellingen noodzakelijk zijn, wordt alleen realiseerbaar geacht indien er een grote kwaliteits- en capaciteitssprong wordt gemaakt (Nota HWU, 1991, p.17). Hiervoor is het noodzakelijk dat er een netwerk van Hoogwaardig Openbaar Vervoer wordt gerealiseerd. Ook binnen Utrecht wordt gestreefd naar een dergelijk HOV systeem." ],
        [ sgpl:refersToConcept unesco:concept661 ;
            sgpl:subjectText "Reissnelheid" ;
            sgpl:text_context "Een eerste selectie van de verschillende alternatieven zal plaatsvinden op basis van de criteria reissnelheid en het aantal inwoners dat binnen het invloedsgebied van een HOV halte woont. Alvorens te beginnen met het vergelijken van de verschillende alternatieven op basis van de reissnelheid moeten er eerst een aantal veronderstellingen worden geformuleerd. Bij de berekening van de reissnelheid wordt uitgegaan van: een maximum snelheid van de HOV bus van 50 kilometer per uur (Vt=14m/s);" ],
        [ sgpl:refersToConcept unesco:concept2842 ;
            sgpl:subjectText "Kringentheorie" ;
            sgpl:text_context "Van de overgebleven alternatieven wordt de omvang van de vervoervraag verfijnd door middel van toepassing van de kringentheorie. Uitgangspunt bij de kringentheorie is dat de bereidheid om naar een HOV-halte te lopen afneemt naarmate de afstand tot een halte toeneemt. Vervolgens wordt er gekeken naar hoeveel mensen in Overvecht binnen het invloedsgebied van een HOV-voorziening wonen, en dus daadwerkelijk gebruik van de HOV-bus zouden kunnen maken." ],
        [ sgpl:refersToConcept unesco:concept15714 ;
            sgpl:subjectText "Hoogwaardig Openbaar Vervoer" ;
            sgpl:text_context "Een toename van het aantal reizigers in het openbaar vervoer, die volgens de taakstellingen noodzakelijk zijn, wordt alleen realiseerbaar geacht indien er een grote kwaliteits- en capaciteitssprong wordt gemaakt (Nota HWU, 1991, p.17). Hiervoor is het noodzakelijk dat er een netwerk van Hoogwaardig Openbaar Vervoer wordt gerealiseerd. Ook binnen Utrecht wordt gestreefd naar een dergelijk HOV systeem." ] ;
    sgpl:thesisID 273 .

sgpl:Thesis274 a sgpl:SGPLThesis ;
    dcterms:creator "Carla Vermunt" ;
    dcterms:issued 1993 ;
    dcterms:title "KANTOREN IN MONUMENTEN: EEN KANS OF EEN BEDREIGING?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Om na te gaan of er een overeenkomst is tussen regeltoepassing en gemeentegrote ben ik uiteindelijk tot de keuze gekomen van twee grote (Amsterdam, Utrecht), twee middelgrote (Maastricht, Leiden) en twee kleinere (Bergen op Zoom, Middelburg) gemeenten. Daarna zullen interviews afgenomen worden met projectontwikkelaars/aannemers en particuliere organisaties die in de geselecteerde gemeenten actief zijn. Hoofdstuk 2 behandelt de algemene juridische aspecten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747372 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Den Haag wordt nu waarschijnlijk ook artikel 12 gemeente, waardoor het voor dit aannemersbedrijf interessant wordt om hier restauratie activiteiten te gaan ondernemen. 5.6 Conclusies Ten aanzien van de vier aspecten zijn de resultaten uit de interviews als volgt samen te vatten. In de praktijk blijken er door gemeenten nog andere juridische constructies te worden toegepast in de privaatrechtelijke sfeer." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750896 ;
            sgpl:spatialText "de binnenstad van Middelburg" ;
            sgpl:text_context "In bepaalde gevallen kan de gemeente vrijstelling verlenen van verbodsbepalingen in de bouwverordening. Met name in dicht bebouwde historische stadskernen met veel beschermde monumenten, zoals de binnenstad van Middelburg, zal veelal de mogelijkheid ontbreken te bouwen in overeenstemming met technische bepalingen omtrent het bouwen van hoofdstuk 3, afdeling A, van de bouwverordening. Hoewel aan de bepalingen van deze afdeling een zwaarwegende betekenis moet worden toegekend, kan het bij verbouwing van beschermde monumenten, die niet in overeenstemming is met deze bepalingen, geboden zijn de belangen die met zodanige verbouwing zijn gediend zwaarder te laten wegen dan het belang dat gebouwd wordt overeenkomstig deze bepalingen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Om na te gaan of er een overeenkomst is tussen regeltoepassing en gemeentegrote ben ik uiteindelijk tot de keuze gekomen van twee grote (Amsterdam, Utrecht), twee middelgrote (Maastricht, Leiden) en twee kleinere (Bergen op Zoom, Middelburg) gemeenten. Daarna zullen interviews afgenomen worden met projectontwikkelaars/aannemers en particuliere organisaties die in de geselecteerde gemeenten actief zijn. Hoofdstuk 2 behandelt de algemene juridische aspecten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751773 ;
            sgpl:spatialText "Leiden" ;
            sgpl:text_context "Om na te gaan of er een overeenkomst is tussen regeltoepassing en gemeentegrote ben ik uiteindelijk tot de keuze gekomen van twee grote (Amsterdam, Utrecht), twee middelgrote (Maastricht, Leiden) en twee kleinere (Bergen op Zoom, Middelburg) gemeenten. Daarna zullen interviews afgenomen worden met projectontwikkelaars/aannemers en particuliere organisaties die in de geselecteerde gemeenten actief zijn. Hoofdstuk 2 behandelt de algemene juridische aspecten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759145 ;
            sgpl:spatialText "Bergen op Zoom" ;
            sgpl:text_context "Om na te gaan of er een overeenkomst is tussen regeltoepassing en gemeentegrote ben ik uiteindelijk tot de keuze gekomen van twee grote (Amsterdam, Utrecht), twee middelgrote (Maastricht, Leiden) en twee kleinere (Bergen op Zoom, Middelburg) gemeenten. Daarna zullen interviews afgenomen worden met projectontwikkelaars/aannemers en particuliere organisaties die in de geselecteerde gemeenten actief zijn. Hoofdstuk 2 behandelt de algemene juridische aspecten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Allereerst zal aan de hand van een literatuurstudie bekeken worden welke regels door de overheid gesteld zijn ten aanzien van beschermde monumenten. Nederland kent een groot_aantal.,m.onumentale panden. In totaal staan er ongeveer 43.000 objecten geregistreerd als beschermd rijksmonument." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "‘ ’teit der Ruimtelijke Wetenschappen, Rijksuniversiteit Utrecht Iberglaan 2, .3584 CS Utrecht, 030-531399/532044 IV B.a. 682 v1993/4) Carla Vermunt KANTOREN IN MONUMENTEN: EEN KANS OF EEN BEDREIGING?" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "Om na te gaan of er een overeenkomst is tussen regeltoepassing en gemeentegrote ben ik uiteindelijk tot de keuze gekomen van twee grote (Amsterdam, Utrecht), twee middelgrote (Maastricht, Leiden) en twee kleinere (Bergen op Zoom, Middelburg) gemeenten. Daarna zullen interviews afgenomen worden met projectontwikkelaars/aannemers en particuliere organisaties die in de geselecteerde gemeenten actief zijn. Hoofdstuk 2 behandelt de algemene juridische aspecten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750896 ;
            sgpl:spatialText "Middelburg" ;
            sgpl:text_context "Om na te gaan of er een overeenkomst is tussen regeltoepassing en gemeentegrote ben ik uiteindelijk tot de keuze gekomen van twee grote (Amsterdam, Utrecht), twee middelgrote (Maastricht, Leiden) en twee kleinere (Bergen op Zoom, Middelburg) gemeenten. Daarna zullen interviews afgenomen worden met projectontwikkelaars/aannemers en particuliere organisaties die in de geselecteerde gemeenten actief zijn. Hoofdstuk 2 behandelt de algemene juridische aspecten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Ceramiqueterrein" ;
            sgpl:text_context "Andere monumenten kunnen aangepast worden aan nieuwe functies mits de nodige terughoudendheid en behoedzaamheid betracht wordt ten aanzien van wijzigingen. Kantoorvestiging wil de gemeente zoveel mogelijk concentreren op nieuwbouwlocaties die voor deze bestemmingen gebouwd worden in Randwijck en op het Ceramiqueterrein. Maastricht kent een zeer karakteristiek dakenplan, dat beschermenswaard is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Randwijck" ;
            sgpl:text_context "Andere monumenten kunnen aangepast worden aan nieuwe functies mits de nodige terughoudendheid en behoedzaamheid betracht wordt ten aanzien van wijzigingen. Kantoorvestiging wil de gemeente zoveel mogelijk concentreren op nieuwbouwlocaties die voor deze bestemmingen gebouwd worden in Randwijck en op het Ceramiqueterrein. Maastricht kent een zeer karakteristiek dakenplan, dat beschermenswaard is." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept274 ;
            sgpl:subjectText "Monumentenzorg" ;
            sgpl:text_context "Het grootste deel van deze panden zijn woonhuismonumenten, maar ook zijn zij in'gebruik als winkel of kantoor. De decentralisatie van de monumentenzorg heeft ertoe geleid dat gemeenten meer belangstelling hebben voor het behoud van hun culturele erfgoed. Vooral de herbestemming van monumenten krijgt steeds meer aandacht." ],
        [ sgpl:refersToConcept unesco:concept2695 ;
            sgpl:subjectText "Herbestemming van monumenten" ;
            sgpl:text_context "Zo is de Martinuskerk in Utrecht ingericht tot appartementencomplex en zijn de Amstelkerk en de Vondelkerk in Amsterdam in gebruik genomen als kantoor. Het herbestemmen van monumenten zal leiden tot behoud van deze panden, maar het is de vraag of het ook leidt tot behoud van het historische karakter. Om een monument voor een andere dan de oorspronkelijke functie geschikt te maken zullen een groot aantal aanpassingen nodig zijn." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "Kantoorvestiging" ;
            sgpl:text_context "Hierin moet een balans gevonden worden. De vraag die in dit onderzoek onder de loep wordt genomen is, of het mogelijk is dit door middel van kantoorvestiging te bewerkstelligen. Kantoorvestiging in monumenten in de binnenstad zou om twee redenen interessant kunnen zijn." ],
        [ sgpl:refersToConcept unesco:concept2695 ;
            sgpl:subjectText "Herbestemming van monumenten" ;
            sgpl:text_context "Zo is de Martinuskerk in Utrecht ingericht tot appartementencomplex en zijn de Amstelkerk en de Vondelkerk in Amsterdam in gebruik genomen als kantoor. Het herbestemmen van monumenten zal leiden tot behoud van deze panden, maar het is de vraag of het ook leidt tot behoud van het historische karakter. Om een monument voor een andere dan de oorspronkelijke functie geschikt te maken zullen een groot aantal aanpassingen nodig zijn." ],
        [ sgpl:refersToConcept unesco:concept274 ;
            sgpl:subjectText "Monumentenzorg" ;
            sgpl:text_context "Het grootste deel van deze panden zijn woonhuismonumenten, maar ook zijn zij in'gebruik als winkel of kantoor. De decentralisatie van de monumentenzorg heeft ertoe geleid dat gemeenten meer belangstelling hebben voor het behoud van hun culturele erfgoed. Vooral de herbestemming van monumenten krijgt steeds meer aandacht." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "Kantoorvestiging" ;
            sgpl:text_context "Hierin moet een balans gevonden worden. De vraag die in dit onderzoek onder de loep wordt genomen is, of het mogelijk is dit door middel van kantoorvestiging te bewerkstelligen. Kantoorvestiging in monumenten in de binnenstad zou om twee redenen interessant kunnen zijn." ] ;
    sgpl:thesisID 274 .

sgpl:Thesis275 a sgpl:SGPLThesis ;
    dcterms:creator "Piet Boerefijn",
        "Sigurd Hauwert" ;
    dcterms:issued 1994 ;
    dcterms:title "DE OLIFANT IS GESTORVEN, DE MUIS SPRINGLEVEND",
        "De economische en ruimtelijke gevolgen.",
        "Estland in de overgang naar een nieuwe samenleving." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:590062 ;
            sgpl:spatialText "Muuga Sadam" ;
            sgpl:text_context "Naast het masterplan heeft Logion ook een concurrentiestudie tussen de Baltische havens uitgevoerd. Hierin springt Muuga Sadam er positief uit. Deze haven, destijds ’Novotallinski’ geheten, is in 1986 gebouwd met hulp van Duitse en Finse bedrijven als belangrijkste haven voor graanimport voor de Sovjet-Unie, met een jaarlijkse capaciteit van 5,5 miljoen ton graan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:588335 ;
            sgpl:spatialText "de Universiteit van Tartu" ;
            sgpl:text_context "Speciale dank gaat uit naar Ulo Mander, Garri Raagmaa, Ülari Alamets en Jaak Klimask, medewerkers aan de Faculteit Geografie aan de Universiteit van Tartu en onze begeleiders in Utrecht, Leo Paul en Ton van Rietbergen. Piet Boerefijn Sigurd Hauwert Utrecht, juni 1994. Afbeelding omslag: Het vijf kroon biljet met daarop afgebeeld de grens tussen Estland en Rusland in Narva." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het is opvallend dat een land met zo veel ruimte zulke hoge bevolkingsconcentraties kent. Voorzieningen die in Nederland heel normaal zijn zoals warm water, bestrating en een hygiënische afvalverwerking ontbreken vaak. In de oude stadscentra zijn de gebouwen verveloos en bouwvallig." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:588409 ;
            sgpl:spatialText "de haven van Tallinn" ;
            sgpl:text_context "Paragraaf twee vertelt iets over de problemen en de mogelijkheden die de nieuwe privé-boeren hebben. Paragraaf drie gaat over de haven van Tallinn en een van de nieuwe bedrijven die zich hier hebben gevestigd. De toekomst van grootschalige industriële bedrijven die voorheen onder een Unie-ministerie in Moskou vielen komt aan bod in paragraaf vier." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:588335 ;
            sgpl:spatialText "Tartu" ;
            sgpl:text_context "Als men bedenkt dat bijna een derde van de bevolking in de hoofdstad Tallinn woont en meer dan de helft in de vijf grootste steden Tallinn, Tartu, Narva, Kohtla-Jarve en Pamu wordt duidelijk hoe dun bevolkt de rest van het land is. Tallinn ligt - door de Finse Golf gescheiden - slechts tachtig kilometer van Helsinki en had hiermee binnen de Sovjet-Unie een unieke positie omdat het zo dicht bij een Westerse stad lag. Ook St-Petersburg ligt dichtbij, ongeveer 350 kilometer vanaf Tallinn en 150 kilometer vanaf Narva." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:588334 ;
            sgpl:spatialText "Tartumaa" ;
            sgpl:text_context "In Tartu is sinds kort een boerenbond opgericht voor de maakond Tartu, welke onderdeel is van een landelijke organisatie van boerenbonden. In Tartumaa zijn momenteel 1200 privé-boeren actief, waarvan er 850 lid zijn van deze bond. De meeste bedrijven zijn pas begonnen na de ontmanteling van de sovchozen en kolchozen in het onafhankelijke Estland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:588409 ;
            sgpl:spatialText "Tallinn" ;
            sgpl:text_context "Estland is dan ook een erg dunbevolkt land. Een uitzondering op deze rust vormt de hoofdstad Tallinn. Alhoewel alles toch nog redelijk kleinschalig is, merk je hier toch al sterk de invloed van de nieuwe openheid: een toenemend aantal toeristen, (Westerse) auto’s, reclame, enz." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:590031 ;
            sgpl:spatialText "Narva" ;
            sgpl:text_context "In de geschiedenis is deze plek altijd een van de duidelijkste contact/conflictpunten geweest tussen de westers-christelijke cultuur en de slavisch-orthodoxe cultuur. Ten tijde van de Hanze was Narva een belangrijk overslagpunt tussen de Nederlanden en Duitsland enerzijds en Rusland anderzijds. Ook zijn hier vele oorlogen uitgevochten met de laatste als hoogtepunt toen in 1944 de hele dubbelstad Narva-Ivangorod werd platgegooid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:453733 ;
            sgpl:spatialText "Estland" ;
            sgpl:text_context "Slechts af en toe kom je een dorpje tegen en op de wegen bevindt zich weinig verkeer. Estland is dan ook een erg dunbevolkt land. Een uitzondering op deze rust vormt de hoofdstad Tallinn." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:592075 ;
            sgpl:spatialText "de noordoostelijke maakond Ida-Viru" ;
            sgpl:text_context "Doordat de Esten moesten worden omgevormd tot een Homo Sovieticus werden veel boeren gedwongen te verhuizen naar de standaardflats in dorpen en steden. Door de aanwezigheid van oliehoudende leisteen en de ligging ten opzichte van Leningrad werd de noordoostelijke maakond Ida-Viru na de oorlog in korte tijd omgevormd tot een belangrijk industrieel centrum. Dit ging gepaard met gigantische milieuvervuiling, een steeds verdere produktspecialisatie en schaalvergroting en een vergaande integratie in de economie van de gehele Unie." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8754 ;
            sgpl:subjectText "Economische transitie" ;
            sgpl:text_context "Er is nu al 1,5 miljoen dollar geïnvesteerd in nieuwe machines. In een transitie van een plan- naar een markteconomie heeft Pölva Piim precies op het goede moment op een slimme manier via enkele mazen in de wet een nieuwe markt weten aan te boren. Voor planeconomische begrippen heeft men ongewoon veel initiatief en risico genomen, maar de fabriek is hierdoor nu wel erg succesvol." ],
        [ sgpl:refersToConcept unesco:concept8813 ;
            sgpl:subjectText "Privatisering" ;
            sgpl:text_context "Begin 1989 kwam er een wet waarin privé-bezit van grond werd geregeld. In december 1990 kwam er een wet aangaande privatisering van kleine bedrijven (met een boekwaarde tot 500.000 roebel). Hierdoor werden er tot maart 1992 400 bedrijfjes geprivatiseerd die vooral door de werknemers werden overgenomen die een voorkeursbehandeling kregen bij verkoop." ],
        [ sgpl:refersToConcept unesco:concept5448 ;
            sgpl:subjectText "Regionale differentiatie" ;
            sgpl:text_context "Ondertussen raakte de rest van het land steeds meer achterop. Na de Tweede Wereldoorlog is er als het ware een noord-zuid continuüm in regionale differentiatie ontstaan. Het noorden met Tallinn en Ida-Virumaa ontwikkelde zich door de hoge mate van integratie met de Sovjet-economie veel sterker dan de rest van het land." ],
        [ sgpl:refersToConcept unesco:concept5448 ;
            sgpl:subjectText "Regionale differentiatie" ;
            sgpl:text_context "Ondertussen raakte de rest van het land steeds meer achterop. Na de Tweede Wereldoorlog is er als het ware een noord-zuid continuüm in regionale differentiatie ontstaan. Het noorden met Tallinn en Ida-Virumaa ontwikkelde zich door de hoge mate van integratie met de Sovjet-economie veel sterker dan de rest van het land." ],
        [ sgpl:refersToConcept unesco:concept8754 ;
            sgpl:subjectText "Economische transitie" ;
            sgpl:text_context "Er is nu al 1,5 miljoen dollar geïnvesteerd in nieuwe machines. In een transitie van een plan- naar een markteconomie heeft Pölva Piim precies op het goede moment op een slimme manier via enkele mazen in de wet een nieuwe markt weten aan te boren. Voor planeconomische begrippen heeft men ongewoon veel initiatief en risico genomen, maar de fabriek is hierdoor nu wel erg succesvol." ],
        [ sgpl:refersToConcept unesco:concept8813 ;
            sgpl:subjectText "Privatisering" ;
            sgpl:text_context "Begin 1989 kwam er een wet waarin privé-bezit van grond werd geregeld. In december 1990 kwam er een wet aangaande privatisering van kleine bedrijven (met een boekwaarde tot 500.000 roebel). Hierdoor werden er tot maart 1992 400 bedrijfjes geprivatiseerd die vooral door de werknemers werden overgenomen die een voorkeursbehandeling kregen bij verkoop." ] ;
    sgpl:thesisID 275 .

sgpl:Thesis276 a sgpl:SGPLThesis ;
    dcterms:creator "Evelien Wierts",
        "Mariken Broekhoven" ;
    dcterms:issued 1994 ;
    dcterms:title "Nieuwe sunbelt van Europa?",
        "Ojo a Málaga" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2510850 ;
            sgpl:spatialText "Costa del Sol" ;
            sgpl:text_context "De bestemmingen van de migranten zijn vooral de kustplaatsen aan de Costa del Sol en Malaga-stad zelf. De groep migranten uit Andalusië is het grootst. Het aandeel van de buitenlanders op het totaal van de bevolking was in 1991 2,1%, terwijl dat cijfer voor Andalusië en Spanje respectievelijk op 0,7% en 0,9% lag." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Mediterrane as" ;
            sgpl:text_context "Is er sprake van een regionaal-economische dynamiek, een zgn. Mediterrane as ontwikkeling langs de Spaanse kust van Catalonië tot en met Andalusië? Hoe is de regionale ontwikkeling van de provincie Malaga gerelateerd aan de ontwikkeling van de Mediterrane as? Het begrip Mediterrane as lijkt enige haken en ogen te hebben." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2593109 ;
            sgpl:spatialText "Andalusië" ;
            sgpl:text_context "Is er sprake van een regionaal-economische dynamiek, een zgn. Mediterrane as ontwikkeling langs de Spaanse kust van Catalonië tot en met Andalusië? Hoe is de regionale ontwikkeling van de provincie Malaga gerelateerd aan de ontwikkeling van de Mediterrane as? Het begrip Mediterrane as lijkt enige haken en ogen te hebben." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2514254 ;
            sgpl:spatialText "provincie Malaga" ;
            sgpl:text_context "Is er sprake van een regionaal-economische dynamiek, een zgn. Mediterrane as ontwikkeling langs de Spaanse kust van Catalonië tot en met Andalusië? Hoe is de regionale ontwikkeling van de provincie Malaga gerelateerd aan de ontwikkeling van de Mediterrane as? Het begrip Mediterrane as lijkt enige haken en ogen te hebben." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3336901 ;
            sgpl:spatialText "Catalonië" ;
            sgpl:text_context "Is er sprake van een regionaal-economische dynamiek, een zgn. Mediterrane as ontwikkeling langs de Spaanse kust van Catalonië tot en met Andalusië? Hoe is de regionale ontwikkeling van de provincie Malaga gerelateerd aan de ontwikkeling van de Mediterrane as? Het begrip Mediterrane as lijkt enige haken en ogen te hebben." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2510769 ;
            sgpl:spatialText "Zuid Spanje" ;
            sgpl:text_context "In het kader van de specialisatierichting regionale geografie hebben wij ons afstudeeronderzoek gedaan in de provincie Mdlaga in Zuid Spanje. Deze scriptie is het resultaat hiervan. In de literatuur over Zuid Europa wordt veel gesproken over de Mediterrane as ontwikkeling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "In de literatuur over regionale ontwikkeling in Europa is sprake van een as van regio’s langs de Mediterrane kust van Spanje, Frankrijk en Noordwest-Italië, waar zich dynamiek en groei voordoen die zou berusten op flexibele specialisatie en endogene ontwikkeling. In hoofdstuk 1 komen deze laatste begrippen uitgebreid aan bod. Deze as wordt Mediterrane as genoemd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3017382 ;
            sgpl:spatialText "Frankrijk" ;
            sgpl:text_context "In de literatuur over regionale ontwikkeling in Europa is sprake van een as van regio’s langs de Mediterrane kust van Spanje, Frankrijk en Noordwest-Italië, waar zich dynamiek en groei voordoen die zou berusten op flexibele specialisatie en endogene ontwikkeling. In hoofdstuk 1 komen deze laatste begrippen uitgebreid aan bod. Deze as wordt Mediterrane as genoemd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2514256 ;
            sgpl:spatialText "Malaga-stad" ;
            sgpl:text_context "De bestemmingen van de migranten zijn vooral de kustplaatsen aan de Costa del Sol en Malaga-stad zelf. De groep migranten uit Andalusië is het grootst. Het aandeel van de buitenlanders op het totaal van de bevolking was in 1991 2,1%, terwijl dat cijfer voor Andalusië en Spanje respectievelijk op 0,7% en 0,9% lag." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Bij de totstandkoming van de scriptie in Utrecht heeft Rob van der Vaart ons begeleid. Met veel belangstelling en de nodige opbouwende kritiek heeft hij dit gedaan. Aan de lunch in Sevilla hebben wij goede herinneringen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4300 ;
            sgpl:subjectText "Flexibele specialisatie" ;
            sgpl:text_context "Gediversificeerde en endogene ontwikkeling waarborgen een evenwichtige regionaal-economische groei. Voor de huidige wereldeconomie blijkt flexibele specialisatie hét middel om tot economische groei te komen. In de volgende twee paragrafen komt eerst aan de orde waarom veel semi-perifere regio’s het laatste decennium groei genereren en welke vorm endogene groei kan aannemen." ],
        [ sgpl:refersToConcept unesco:concept2599 ;
            sgpl:subjectText "Endogene ontwikkeling" ;
            sgpl:text_context "Sinds begin jaren zeventig werd duidelijk dat extern tegenereerde ontwikkeling in tijden van economische recessie niet werkt. Om het hoofd te bieden aan de ernstige problemen in veel regio’s, met name rurale en traditionele industrie regio’s, ontstond het idee van endogene ontwikkeling. Lokale ontwikkelingsstrategieën hebben een voordeel boven centraal opgezette strategieën: via lokale initiatieven in het herstructureringsproces van regio’s zouden ze beter lokale mogelijkheden kunnen identificeren en mobiliseren." ],
        [ sgpl:refersToConcept unesco:concept954 ;
            sgpl:subjectText "Mediterrane as ontwikkeling" ;
            sgpl:text_context "Deze as wordt Mediterrane as genoemd. Het geheel van achterliggende mechanismen van dynamiek en groei van de Mediterrane as wordt ook wel Mediterrane as ontwikkeling genoemd. De omvang van de Mediterrane as wordt verschillend ingeschat." ],
        [ sgpl:refersToConcept unesco:concept4300 ;
            sgpl:subjectText "Flexibele specialisatie" ;
            sgpl:text_context "Gediversificeerde en endogene ontwikkeling waarborgen een evenwichtige regionaal-economische groei. Voor de huidige wereldeconomie blijkt flexibele specialisatie hét middel om tot economische groei te komen. In de volgende twee paragrafen komt eerst aan de orde waarom veel semi-perifere regio’s het laatste decennium groei genereren en welke vorm endogene groei kan aannemen." ],
        [ sgpl:refersToConcept unesco:concept2599 ;
            sgpl:subjectText "Endogene ontwikkeling" ;
            sgpl:text_context "Sinds begin jaren zeventig werd duidelijk dat extern tegenereerde ontwikkeling in tijden van economische recessie niet werkt. Om het hoofd te bieden aan de ernstige problemen in veel regio’s, met name rurale en traditionele industrie regio’s, ontstond het idee van endogene ontwikkeling. Lokale ontwikkelingsstrategieën hebben een voordeel boven centraal opgezette strategieën: via lokale initiatieven in het herstructureringsproces van regio’s zouden ze beter lokale mogelijkheden kunnen identificeren en mobiliseren." ],
        [ sgpl:refersToConcept unesco:concept954 ;
            sgpl:subjectText "Mediterrane as ontwikkeling" ;
            sgpl:text_context "Deze as wordt Mediterrane as genoemd. Het geheel van achterliggende mechanismen van dynamiek en groei van de Mediterrane as wordt ook wel Mediterrane as ontwikkeling genoemd. De omvang van de Mediterrane as wordt verschillend ingeschat." ] ;
    sgpl:thesisID 276 .

sgpl:Thesis277 a sgpl:SGPLThesis ;
    dcterms:creator "P.A. Duijf" ;
    dcterms:issued 1994 ;
    dcterms:title "IS REGIONALISERING VAN AMBULANCEHULPVERLENING IN NEDERLAND NODIG?",
        "een studie naar interregionale verschillen in effectiviteit en efficiency" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755249 ;
            sgpl:spatialText "provincie Groningen" ;
            sgpl:text_context "Dit laatste niveau bevindt zich in wezen op een hoger plan en kan worden betiteld als een deel van de institutionele omgeving van ambulancehulpverlening. Om de in het aanbiedersmodel te operationaliseren (on-)afhankelijke variabelen te kunnen meten, is uitgegaan van de onderzoeksmethode die de Man (1992) hanteert in zijn proefschrift over spoedeisende medische hulpverlening in de provincie Groningen. In het niet-medische deel van het proefschrift, dat gaat over de organisationele effectiviteit van spoedeisende medische hulpverlening, maakt hij op zijn beurt gebruik van het theoretische beoordelingsmodel van Jansen en Jagers." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Dit advies werd gezamenlijk uitgebracht door de Nationale Raad voor de Volksgezondheid (NRV) en het Centraal Orgaan Tarieven Gezondheidszorg (COTG). Algemeen wordt het beschouwd als een belangrijke bijdrage aan een al decennialang durende discussie over de organisatie van de ambulancehulpverlening in Nederland. Met name gaat het dan om het spanningsveld tussen kwaliteit, planning en financiering." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Tijdens het verrichten van dit onderzoek is de inbreng van een aantal mensen op het gebied van zowel de geografie als de ambulancehulpverlening erg zinvol geweest. Ik noem met name Dr. T.J.M. Spit, mijn studiebegeleider van de Universiteit Utrecht, faculteit Ruimtelijke Wetenschappen, vakgroep Toegepaste Geografie en Ruimtelijke Planning en van VZA de heren W.F. Botter, drs. E.P. Cassee en J.A. Veenstra (directie). Daarnaast wil ik vooral mijn vrouw Tine en mijn kinderen Rick, Tim, Tessa en Rens bedanken voor hun geduld en stimulerende inbreng gedurende mijn studie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744011 ;
            sgpl:spatialText "Zeeland" ;
            sgpl:text_context "De kostenstijging in de periode 1980-1992 loopt per provincie sterk uiteen: in Noord-Holland is er sprake van een beperkte stijging (2,7 % per jaar) terwijl in Zeeland de kosten meer dan verdubbeld zijn. Figuur 2: Ambulance-exploitatiekosten, in 1980, 1990, 1991 en 1992 per provincie, absoluut. Naast de problematiek van afstemming van planning en financiering op regionale schaal is er een ander probleem te voorzien." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Noord-Holland" ;
            sgpl:text_context "Daarnaast maakt figuur 2, duidelijk dat de regionale verschillen in exploitatiekosten in 1980 en 1992 opmerkelijk zijn. De kostenstijging in de periode 1980-1992 loopt per provincie sterk uiteen: in Noord-Holland is er sprake van een beperkte stijging (2,7 % per jaar) terwijl in Zeeland de kosten meer dan verdubbeld zijn. Figuur 2: Ambulance-exploitatiekosten, in 1980, 1990, 1991 en 1992 per provincie, absoluut." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "regio Amsterdam" ;
            sgpl:text_context "Daarbij valt op dat er een probleemveld met ruimtelijke differentiatie is ontstaan in de relatie effectiviteit, efficiency en kwaliteit van het ambulancevervoer (1.2). De doelstelling van dit onderzoek is er op gericht om op regionale schaal verschillen in effectiviteit en efficiency te meten en te beoordelen met de regio Amsterdam als vergelijkingsbasis (1.3). Vervolgens wordt de probleemstelling geconcretiseerd (1.4) en in een conceptueel model gevisualiseerd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "CPA-regio Amsterdam en Omstreken" ;
            sgpl:text_context "De laatste vijf jaar is met name in de CPA-regio Amsterdam en Omstreken evenwel het een en ander bereikt. Zo werd het verzorgingsgebied door het samengaan van drie CPA-regio’s in 1989 uitgebreid naar meer dan 1.000 KM2 met ruim 1 miljoen inwoners. Daarnaast spelen twee grote en vijf kleinere ambulancediensten eveneens een voorname rol." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6707 ;
            sgpl:subjectText "efficiency" ;
            sgpl:text_context "Effectiviteit van de organisatie is de mate waarin de organisatie bijdraagt aan de verwezenlijking van het beoogde doel; Van efficiency is sprake wanneer er een optimale verhouding bestaat tussen de kosten van de organisatie en de daadwerkelijk verleende hulp. Met effectiviteit van de organisatie hangen een aantal aspecten van de zorg samen." ],
        [ sgpl:refersToConcept unesco:concept14468 ;
            sgpl:subjectText "regionalisering" ;
            sgpl:text_context "Samenwerking en fusie van diverse ambulancediensten (overheid en particulier), mogelijk na privatisering, staan hierbij voorop. De hierdoor te bewerkstelligen schaalvergroting en basisverbreding maken dat bij realisering ervan gesproken kan worden van een geslaagde regionalisering. Ook de betrokkenheid van de patiënt/consument kan veel meer dan nu het geval is in aanmerking te worden genomen." ],
        [ sgpl:refersToConcept unesco:concept412 ;
            sgpl:subjectText "ambulancehulpverlening" ;
            sgpl:text_context "Vooral aspecten als effectiviteit, efficiency en kostenbeheersing treden hierin nadrukkelijk op de voorgrond. Algemeen wordt het beschouwd als een belangrijke bijdrage aan een al decennialang durende discussie over de organisatie van de ambulancehulpverlening in Nederland. Met name gaat het dan om het spanningsveld tussen kwaliteit, planning en financiering." ],
        [ sgpl:refersToConcept unesco:concept6707 ;
            sgpl:subjectText "efficiency" ;
            sgpl:text_context "Effectiviteit van de organisatie is de mate waarin de organisatie bijdraagt aan de verwezenlijking van het beoogde doel; Van efficiency is sprake wanneer er een optimale verhouding bestaat tussen de kosten van de organisatie en de daadwerkelijk verleende hulp. Met effectiviteit van de organisatie hangen een aantal aspecten van de zorg samen." ],
        [ sgpl:refersToConcept unesco:concept412 ;
            sgpl:subjectText "ambulancehulpverlening" ;
            sgpl:text_context "Vooral aspecten als effectiviteit, efficiency en kostenbeheersing treden hierin nadrukkelijk op de voorgrond. Algemeen wordt het beschouwd als een belangrijke bijdrage aan een al decennialang durende discussie over de organisatie van de ambulancehulpverlening in Nederland. Met name gaat het dan om het spanningsveld tussen kwaliteit, planning en financiering." ],
        [ sgpl:refersToConcept unesco:concept14468 ;
            sgpl:subjectText "regionalisering" ;
            sgpl:text_context "Samenwerking en fusie van diverse ambulancediensten (overheid en particulier), mogelijk na privatisering, staan hierbij voorop. De hierdoor te bewerkstelligen schaalvergroting en basisverbreding maken dat bij realisering ervan gesproken kan worden van een geslaagde regionalisering. Ook de betrokkenheid van de patiënt/consument kan veel meer dan nu het geval is in aanmerking te worden genomen." ] ;
    sgpl:thesisID 277 .

sgpl:Thesis278 a sgpl:SGPLThesis ;
    dcterms:creator "Jorien Elenbaas" ;
    dcterms:issued 1994 ;
    dcterms:title "VERSLAGEN VAN LEERONDERZOEK G&P",
        "WONEN IN DE BINNENSTAD VAN WOERDEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Als tweede submilieu wordt het nieuwe centrummilieu genoemd. Naast de grote vemieuwingscomplexen uit de jaren zestig en zeventig, die vooral uit een combinatie van appartementen met kantoren en/of winkels bestonden (bijvoorbeeld Hoog Catharijne in Utrecht), worden hiermee ook de kleinschaligere (woon) projecten uit latere jaren aangeduid. Het nieuwe centrummilieu wordt als apart woonmilieu onderscheiden omdat het over het algemeen een lagere status heeft dan het oudere centrummilieu." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744248 ;
            sgpl:spatialText "overgangsmilieu'" ;
            sgpl:text_context "Door samenvoeging met het noordoostelijke deel van de vijfhoek ontstaat een heterogeen gebied, maar dat was ook het geval wanneer het noordoostelijk deel afzonderlijk beschouwd zou worden. Het ’overgangsmilieu’ is een benaming die goed bij dit gebied past aangezien het type woning niet als typisch stedelijk is aan te merken, maar meer als dat van een overgangsgebied. Het overgangsmilieu is in figuur 4.1 het gebied III." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744248 ;
            sgpl:spatialText "stedelijk woonmilieu'" ;
            sgpl:text_context "Het andere deel van de schil, ten zuiden en zuidwesten van de vijfhoek, kent een meer stedelijk karakter. Het tweede woonmilieu zou het 'stedelijk woonmilieu’ genoemd kunnen worden. Dit is het woongebied aan de zuid- en zuidwestkant van de vijfhoek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744248 ;
            sgpl:spatialText "hart' van de binnenstad" ;
            sgpl:text_context "Door deze concentratie van verschillende activiteiten is de benaming 'winkelgebied’ te beperkt. Het ’hart’ van de binnenstad past beter bij dit gebied. Voor het aspect wonen in het ’hart’ betekent bovenstaande niet alleen het gemak van allerlei voorzieningen op loopafstand." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744248 ;
            sgpl:spatialText "gemeente Woerden" ;
            sgpl:text_context "SAMENVATTING Wonen in de binnenstad van Woerden. In de gemeente Woerden wordt momenteel gewerkt aan een integrale visie voor de binnenstad. Hiermee dient richting te worden gegeven aan de ontwikkeling van de binnenstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750653 ;
            sgpl:spatialText "wijk Molenvliet" ;
            sgpl:text_context "Het merendeel van de respondenten blijkt uit Woerden zelf te komen (69%). Er zijn met name veel respondenten uit de wijk Molenvliet (33% van de respondenten uit Woerden). Aangezien dit een vrij grote wijk is (schatting: ongeveer 10.000 inwoners), is dit verder niet afwijkend." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744248 ;
            sgpl:spatialText "Woerdense binnenstad" ;
            sgpl:text_context "1. INLEIDING 1.1 Kort overzicht van de stedelijke problematiek. Zoals uit het voorwoord reeds is gebleken maakt het woonfunctie-onderzoek deel uit van de vorming van een integrale visie op de ontwikkeling van de Woerdense binnenstad. De behoefte van de gemeente om een dergelijke visie te ontwikkelen zal met name voort zijn gekomen uit een verlangen greep te houden op de situatie in de binnenstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Bomen- en bloemenkwartier" ;
            sgpl:text_context "Slechts 17 van de 49 huishoudens met kinderen jonger dan 6 jaar maakt gebruik van een kinderopvang voorziening (35%). Het meest wordt gebruik gemaakt van ’t Haventje, een kinderopvangvoorziening in het Bomen- en bloemenkwartier. Van de huishoudens met kinderen jonger dan 6 jaar mist 35% een kinderopvangvoorziening in de binnenstad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744248 ;
            sgpl:spatialText "Woerden" ;
            sgpl:text_context "Het laatste onderscheiden probleemveld is op het gebied van de stedelijke voorzieningen. Deze problemen doen zich met name voor in de grote steden, maar kunnen zich ook voordoen in kleinere steden zoals Woerden. Manifestatie van deze problemen zou zich waarschijnlijk allereerst voordoen in de binnenstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "stad Rotterdam" ;
            sgpl:text_context "Een merendeel hiervan is echter toegespitst op een specifieke stad. Een voorbeeld hiervan is de indeling gebruikt in 'Vernieuwing van de stadsvernieuwing’ (1988). Hierin worden 11 woonmilieus onderscheiden specifiek voor de stad Rotterdam." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Stedelijke problematiek" ;
            sgpl:text_context "Binnensteden zijn dynamische en complexe gebieden waar probleemsituaties niet ondenkbaar zijn. In een VNG-studie uit 1984 wordt een overzicht gegeven van de stedelijke problematiek aan de hand van zes probleemvelden. Ten eerste onderscheidt de VNG de problematiek met betrekking tot de stedeljjke bevolking." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Woningzoekenden" ;
            sgpl:text_context "In het centraal woningzoekendenbestand stonden op het moment van het onderzoek ongeveer 2.500 mensen als woningzoekend ingeschreven. Omdat bekend is dat in de woningzoekendenregistratie de jonge woningzoekenden oververtegenwoordigd zijn, is een gestratificeerde steekproef naar leeftijd getrokken. Hierdoor kunnen per leeftijdsgroep representatieve uitspraken worden gedaan." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Woonmilieus" ;
            sgpl:text_context "Als er vanuit deze drie invalshoeken geredeneerd wordt, kan gesteld worden dat deze scriptie in te delen is bij de eerste groep auteurs die het woonmilieu definiëren als fysiek-ruimtelijke eenheid. In hoofdstuk 4 zullen namelijk fysieke kenmerken van de zogenaamde aanbodzijde van de woningmarkt belangrijk zijn bij de onderscheiding van een drietal woonmilieus in de Woerdense binnenstad. Er wordt echter met meer aspecten rekening gehouden bij de indeling van de woonmilieus." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Woonmilieus" ;
            sgpl:text_context "Als er vanuit deze drie invalshoeken geredeneerd wordt, kan gesteld worden dat deze scriptie in te delen is bij de eerste groep auteurs die het woonmilieu definiëren als fysiek-ruimtelijke eenheid. In hoofdstuk 4 zullen namelijk fysieke kenmerken van de zogenaamde aanbodzijde van de woningmarkt belangrijk zijn bij de onderscheiding van een drietal woonmilieus in de Woerdense binnenstad. Er wordt echter met meer aspecten rekening gehouden bij de indeling van de woonmilieus." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Woningzoekenden" ;
            sgpl:text_context "In het centraal woningzoekendenbestand stonden op het moment van het onderzoek ongeveer 2.500 mensen als woningzoekend ingeschreven. Omdat bekend is dat in de woningzoekendenregistratie de jonge woningzoekenden oververtegenwoordigd zijn, is een gestratificeerde steekproef naar leeftijd getrokken. Hierdoor kunnen per leeftijdsgroep representatieve uitspraken worden gedaan." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Stedelijke problematiek" ;
            sgpl:text_context "Binnensteden zijn dynamische en complexe gebieden waar probleemsituaties niet ondenkbaar zijn. In een VNG-studie uit 1984 wordt een overzicht gegeven van de stedelijke problematiek aan de hand van zes probleemvelden. Ten eerste onderscheidt de VNG de problematiek met betrekking tot de stedeljjke bevolking." ] ;
    sgpl:thesisID 278 .

sgpl:Thesis279 a sgpl:SGPLThesis ;
    dcterms:creator "Anne Marie Gout" ;
    dcterms:issued 1994 ;
    dcterms:title "Een onderzoek naar de ruimtelijk gedifferentieerde uitwerking van postmoderne Sunbelt-ontwikkelingen in Zuid-Frankrijk",
        "High tech industrie en regionale ontwikkeling in het departement Bouches-du-Rhône" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2985244 ;
            sgpl:spatialText "het economisch hart van de Région" ;
            sgpl:text_context "De Région Provence-Alpes-Cóte d’Azur maakt deel uit van de Franse Sunbelt. Het eigenlijke onderzoek is uitgevoerd in het economisch hart van de Région, het departement Bouches-du-Rhóne. Om de ruimtelijke differentiatie in de Bouches-du-Rhóne te kunnen onderzoeken is allereerst in hoofdstuk één aan de hand van een aantal theorieën een typologie van postmoderne Sunbelt gebieden opgesteld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3031359 ;
            sgpl:spatialText "departement Bouches-du-Rhóne" ;
            sgpl:text_context "Anne Marie Gout High tech industrie en regionale ontwikkeling in het departement Bouches-du-Rhóne. Een onderzoek naar de ruimtelijk gedifferentieerde uitwerking van postmoderne Sunbelt-ontwikkelingen in Zuid-Frankrijk. Utrecht, april 1994." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2985244 ;
            sgpl:spatialText "Région Provence-Alpes-Cóte d’Azur" ;
            sgpl:text_context "Er is voor gekozen deze probleemstelling te onderzoeken in Zuid-Frankrijk, het Franse deel van de Europese Sunbelt. De Région Provence-Alpes-Cóte d’Azur maakt deel uit van de Franse Sunbelt. Het eigenlijke onderzoek is uitgevoerd in het economisch hart van de Région, het departement Bouches-du-Rhóne." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3016667 ;
            sgpl:spatialText "Gardanne" ;
            sgpl:text_context "4.1 Venelles 99. 4.2 Gardanne 102. 4.3 Aix-en-Provence 106." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2995469 ;
            sgpl:spatialText "Marseille" ;
            sgpl:text_context "4.3 Aix-en-Provence 106. 4.4 Marseille 110. 4.5 Conclusie 117." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3038354 ;
            sgpl:spatialText "Aix-en-Provence" ;
            sgpl:text_context "De steden rond het Etang-de-Berre 77. 3.5.3 Marseille, de oostelijke banlieu en de Cóte Bleu 81. 3.5.1 Aix-en-Provence en het Pays d’Aix 73." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3038354 ;
            sgpl:spatialText "het Pays d’Aix" ;
            sgpl:text_context "3.5 De ontwikkelingen in de verschillende deelgebieden 73. 3.5.1 Aix-en-Provence en het Pays d’Aix 73. 3.5.2 De steden rond het Etang-de-Berre 77." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2970092 ;
            sgpl:spatialText "Venelles" ;
            sgpl:text_context "In hoofdstuk vier wordt aan de hand van een viertal casestudies getracht inzicht te krijgen in deze regionale verschillen. 4.1 Venelles 99. 4.2 Gardanne 102." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3017382 ;
            sgpl:spatialText "Zuid-Frankrijk" ;
            sgpl:text_context "RG Publicatiereeks nr. 6 High tech industrie en regionale ontwikkeling in het departement Bouches-du-Rhóne. Een onderzoek naar de ruimtelijk gedifferentieerde uitwerking van postmoderne Sunbelt-ontwikkelingen in Zuid-Frankrijk. Anne Marie Gout Utrecht, april 1994." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "RG/ASG Faculteit Ruimtelijke Wetenschappen Universiteit Utrecht RIJKSUNIVERSITEIT TE UTRECHT. 2512 841 8 RG Publicatiereeks. Inlichtingen en bestellingen: ASG secretariaat Faculteit der Ruimtelijke Wetenschappen Universiteit Utrecht." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept9588 ;
            sgpl:subjectText "Technopolen" ;
            sgpl:text_context "De functies van deze stad kunnen leiden tot regionale polarisatie, wat potenties biedt voor innovatie en regionale ontwikkeling (Benko 1991, p. 10-11). Concluderend kan gezegd worden dat technopolen gezien worden als een middel tot regionale ontwikkeling en economische groei. Een andere zeer belangrijke vraag is waarom technopolen ontstaan waar zij ontstaan, ofwel waarom high tech activiteiten zich op deze plaatsen vestigen." ],
        [ sgpl:refersToConcept unesco:concept12382 ;
            sgpl:subjectText "Postmodernisme" ;
            sgpl:text_context "Over deze groeizone zijn een aantal theorieën in omloop. Een algemene, maatschappelijk theorie is het postmodernisme. Dit idee fungeert als een overkoepelende theorie voor meer concrete geografische theorieën." ],
        [ sgpl:refersToConcept unesco:concept17170 ;
            sgpl:subjectText "Innovatieve milieus" ;
            sgpl:text_context "In de volgende paragraaf wordt nader ingegaan op deze theorie, die evenals de New Industrial Spaces op meerdere schaalniveaus toepasbaar is. De theorie van innovatieve milieus heeft betrekking op de geografische condities (economisch, sociaal, fysiek) van de produktie. Zij bestudeert de problemen van technologische innovatie in regionale milieus." ],
        [ sgpl:refersToConcept unesco:concept9588 ;
            sgpl:subjectText "Technopolen" ;
            sgpl:text_context "De functies van deze stad kunnen leiden tot regionale polarisatie, wat potenties biedt voor innovatie en regionale ontwikkeling (Benko 1991, p. 10-11). Concluderend kan gezegd worden dat technopolen gezien worden als een middel tot regionale ontwikkeling en economische groei. Een andere zeer belangrijke vraag is waarom technopolen ontstaan waar zij ontstaan, ofwel waarom high tech activiteiten zich op deze plaatsen vestigen." ],
        [ sgpl:refersToConcept unesco:concept12382 ;
            sgpl:subjectText "Postmodernisme" ;
            sgpl:text_context "Over deze groeizone zijn een aantal theorieën in omloop. Een algemene, maatschappelijk theorie is het postmodernisme. Dit idee fungeert als een overkoepelende theorie voor meer concrete geografische theorieën." ],
        [ sgpl:refersToConcept unesco:concept17170 ;
            sgpl:subjectText "Innovatieve milieus" ;
            sgpl:text_context "In de volgende paragraaf wordt nader ingegaan op deze theorie, die evenals de New Industrial Spaces op meerdere schaalniveaus toepasbaar is. De theorie van innovatieve milieus heeft betrekking op de geografische condities (economisch, sociaal, fysiek) van de produktie. Zij bestudeert de problemen van technologische innovatie in regionale milieus." ] ;
    sgpl:thesisID 279 .

sgpl:Thesis28 a sgpl:SGPLThesis ;
    dcterms:creator "P.J. Groenenboom" ;
    dcterms:issued 1960 ;
    dcterms:title "Verreries de Moussans" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Galinié" ;
            sgpl:text_context "In het westen van de gemeente, rondom de kern Galinié, nemen de akkerbouwgronden een belangrijke plaats in. Het merkwaardige van uit gebied is nu dat, terwijl de akkerbouw overal terrein prijs moet geven in de volgende ^5 jaar, (kaart II) hier weinig verandering plaatsvindt. Ook vandaag treffen we hier nog het grootste deel van de akkerbouw gronden van Verreries aan (zie foto)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2990228 ;
            sgpl:spatialText "noord-oostelijke deel van de Montagne Noire" ;
            sgpl:text_context "Toch hebben wij getracht in ons verdere betoog de Montagne Noire als achtergrond^ te nemen, waar mogelijk liet noord-oostelijke deel ervan. Dat wij hiein dikwijls niet geslaagd zijn zij bij voorbaat vastgesteld. Wat nu de factor tijd betreft,zouden wij onze uiteen- zetting kunnen beperken tot de huidige periode,te beginnen bijvoorbeeld banaf het einde der tweede wereldoorlog." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3013501 ;
            sgpl:spatialText "departement Hérault" ;
            sgpl:text_context "Men zou uit louter pragmatische overwegingen (het statistische materiaal) het departement,waarin het dorp ligt als basis kun- nen nemen,in ons geval het departement Hérault» De grote divergentie zo- wel vanuit fysisch als sociaal oogpunt,welke de verschillende franse departementen kenmerkt,maakt het ons duidelijk dat een dergelijke aanpak volkomen zinloos te noemen is» Wij zullen daarom naar een kleinere meer uniforme regio moeten omzien»" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2969718 ;
            sgpl:spatialText "Verreries de Moussans" ;
            sgpl:text_context "Laten wij Verreries de Moussans, als vertegentegenwoordiger van de streek waaraan het een deel van zijn naam ontleent, eens nader bekijken. HOOFDSTUK I Met demografisch verloop vanaf 1865. Het constateren van een voortdurend teruglopen van de bevolking, ook in het noord- oostelijke deel van de lïontagne Noire,, is weinig spectaculair." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:12313244 ;
            sgpl:spatialText "het centrum van de Thoré vallex" ;
            sgpl:text_context "Zeer globaal kan men zeggen, dat de aanzienlijke hoeveelheden praktisch kalkvrij water, waarover het bescniict (zeer belangrijk bij de vervaardiging van lakenstoffen) en de gunstige verkeers- geografische ligging, in het centrum van de Thoré vallex, m positieve zin de keuze van Labastide beïnvloed hebben. Het zou onjuist zijn reeds onmiddellijk na de vestiging van de lakenindustrie te Labastiue het wankele bestaan voor veel inwoners van Verreries als verleden tijd te beschouwen. De plotselinge uitbreiding van de werkgelegenheid kwam m de eerste plaats ten goede aan Labastide zelf, dat, als iedere plaats in de Montagne Moiré in die periode, een aanzienlijk,, arbeidersoverschot gehad moet hebben." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Moussans" ;
            sgpl:text_context "Een bochtige weg leidt ons naar het gebied dat bekend staat als \"Moussans\". Dit gebieden de vorm van een driehoek met als punten Courniou, Labastide-Rouairoux en Eerrals varieert in hoogte van 500 tot 1000meter boven de zeespiegel. Het is één van de meerdere kleinere natuurlijke regio’s binnen de Montagne Noire en vormt in vele opzichten een tegenstelling met de Minervois (z/uiden) of de Cabardesstreek.(zuid-oosten)" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2990228 ;
            sgpl:spatialText "Montagne Noire" ;
            sgpl:text_context "Indien men zich beperkt tot enkele globale criteria, zou de Montagne Noire waarschijnlijk wel als een natuurlijke regio zijn op te vatten» Dit impliceert geenszins dat ook de sociale verschijnselen, zoals die tot uiting komen door de menselijke activiteit eveneens overeen- stemmen» Er zijn wat het laatste betreft in het oog springende verschillen die reeds na een oppervlakkige doorkruising van het gebied te onderkennen zijn." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4116 ;
            sgpl:subjectText "Ontvolking" ;
            sgpl:text_context "Ten tweede,bovendien de grootste handicap,weet men op grond van de onvoldoende kennis geen uitgesproken richting te geven aan de vragen. Het was ons van \"huis uit\" bekend dat de Montagne Noire in zijn totaliteit geteisterd werd ,en in mindere mate wordt,door een enorme ontvolking. Een aanzienlijk deel der vragen heeft om die reden betrekking op de ontvolking en de problemen die er mee samen hangen(migratie,forensisme, extensivering van het bodemgebruik)en-de." ],
        [ sgpl:refersToConcept unesco:concept5884 ;
            sgpl:subjectText "Forensisme" ;
            sgpl:text_context "Het langzaam op gang komen van het pendelverkeer waq/te wijten aan de prioriteitspositie die de potentiële werkers van Labastide genoten. In 1936 is de situatie zodanig, dat gezegd kan worden, dat het dorp slechts bestaansrechten heeft, dank zij de mogelijkheid van het forensisme. Niet dat de landbouw dan volledig verdwenen is, maar de nieuwe generatie wordt voor afvloeien behoed door het absorptievermogen van Labastide’s textielindustrie." ],
        [ sgpl:refersToConcept unesco:concept2956 ;
            sgpl:subjectText "Glasindustrie" ;
            sgpl:text_context "We lezen uit dezelfde grafiek een herstel van de stabiliteit rond 1900, even wel bij een veel geringer inwonertal. Het bestaansmiddel waaraan velen reeds eeuwen een bestaan te danken hadden was de glasindustrie. Het werd door de betrokkenen als een kunst beschouwd en daarom is de naam glasambacht misschien wel beter." ],
        [ sgpl:refersToConcept unesco:concept2956 ;
            sgpl:subjectText "Glasindustrie" ;
            sgpl:text_context "We lezen uit dezelfde grafiek een herstel van de stabiliteit rond 1900, even wel bij een veel geringer inwonertal. Het bestaansmiddel waaraan velen reeds eeuwen een bestaan te danken hadden was de glasindustrie. Het werd door de betrokkenen als een kunst beschouwd en daarom is de naam glasambacht misschien wel beter." ],
        [ sgpl:refersToConcept unesco:concept4116 ;
            sgpl:subjectText "Ontvolking" ;
            sgpl:text_context "Ten tweede,bovendien de grootste handicap,weet men op grond van de onvoldoende kennis geen uitgesproken richting te geven aan de vragen. Het was ons van \"huis uit\" bekend dat de Montagne Noire in zijn totaliteit geteisterd werd ,en in mindere mate wordt,door een enorme ontvolking. Een aanzienlijk deel der vragen heeft om die reden betrekking op de ontvolking en de problemen die er mee samen hangen(migratie,forensisme, extensivering van het bodemgebruik)en-de." ],
        [ sgpl:refersToConcept unesco:concept5884 ;
            sgpl:subjectText "Forensisme" ;
            sgpl:text_context "Het langzaam op gang komen van het pendelverkeer waq/te wijten aan de prioriteitspositie die de potentiële werkers van Labastide genoten. In 1936 is de situatie zodanig, dat gezegd kan worden, dat het dorp slechts bestaansrechten heeft, dank zij de mogelijkheid van het forensisme. Niet dat de landbouw dan volledig verdwenen is, maar de nieuwe generatie wordt voor afvloeien behoed door het absorptievermogen van Labastide’s textielindustrie." ] ;
    sgpl:thesisID 28 .

sgpl:Thesis280 a sgpl:SGPLThesis ;
    dcterms:creator "Mechteld Gravendeel" ;
    dcterms:issued 1994 ;
    dcterms:title "Perceptie van het Hollandse landschap in de 18e eeuw: een vergelijkend onderzoek van vijf Hollandse reisteksten" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753919 ;
            sgpl:spatialText "Holland" ;
            sgpl:text_context "Hoofdstuk 1 Inleiding 1.1 Probleemstelling. Dit onderzoek gaat over de perceptie van het Hollandse landschap door Hollanders gedurende de 18e eeuw. Er wordt geprobeerd tot een reconstructie van de beeldvorming van het ruimtelijke landschap te komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Mechteld Gravendeel. Utrecht, Augustus 1994. Universitc: l trecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Amsterdam: Visscher 1716. Claas Bruin, Noord-Hollandsche Arkadia, verrijkt met aantekeningen van Gerrit Schoemaker. Amsterdam: Visscher 1732." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Noord-Holland" ;
            sgpl:text_context "Niet in werkelijkheid plaatsgevonden reizen zijn het onderwerp van imaginaire reisverhalen. Omdat het in deze studie gaat om 18e-eeuws materiaal dat geschreven is om gedrukt te worden en verslag doet van reisjes binnen Noord- en/of Zuid-Holland, blijkt, na bibliografisch onderzoek dat een tiental titels ons ter beschikking staat. Bij inzage van het materiaal bleek al snel dat een groot deel ervan voor dit onderzoek van minder waarde zou zijn." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743698 ;
            sgpl:spatialText "Zuid-Holland" ;
            sgpl:text_context "Niet in werkelijkheid plaatsgevonden reizen zijn het onderwerp van imaginaire reisverhalen. Omdat het in deze studie gaat om 18e-eeuws materiaal dat geschreven is om gedrukt te worden en verslag doet van reisjes binnen Noord- en/of Zuid-Holland, blijkt, na bibliografisch onderzoek dat een tiental titels ons ter beschikking staat. Bij inzage van het materiaal bleek al snel dat een groot deel ervan voor dit onderzoek van minder waarde zou zijn." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8566 ;
            sgpl:subjectText "Hollandse landschap" ;
            sgpl:text_context "1.1 Probleemstelling. Dit onderzoek gaat over de perceptie van het Hollandse landschap door Hollanders gedurende de 18e eeuw. Er wordt geprobeerd tot een reconstructie van de beeldvorming van het ruimtelijke landschap te komen." ],
        [ sgpl:refersToConcept unesco:concept17177 ;
            sgpl:subjectText "reisteksten" ;
            sgpl:text_context "Het gaat om de termen landschap, landschapsperceptie en reisteksten. Een reistekst omvat het schriftelijk verslag, in welke vorm dan ook, van een door de auteur (al dan niet werkelijk) ondernomen reis door de geografische ruimte. In welke vorm dan ook, want reisteksten kennen vele verschijningsvormen." ],
        [ sgpl:refersToConcept unesco:concept13188 ;
            sgpl:subjectText "landschapsperceptie" ;
            sgpl:text_context "Ik ben zo’n studente. Landschapsperceptie, zoals die blijkt uit reisteksten, is een nog grotendeels onbekend onderzoeksgebied in zowel de geografische als de letterkundige wetenschap. Ik hoop met deze studie daarin verandering te kunnen brengen." ],
        [ sgpl:refersToConcept unesco:concept8566 ;
            sgpl:subjectText "Hollandse landschap" ;
            sgpl:text_context "1.1 Probleemstelling. Dit onderzoek gaat over de perceptie van het Hollandse landschap door Hollanders gedurende de 18e eeuw. Er wordt geprobeerd tot een reconstructie van de beeldvorming van het ruimtelijke landschap te komen." ],
        [ sgpl:refersToConcept unesco:concept13188 ;
            sgpl:subjectText "landschapsperceptie" ;
            sgpl:text_context "Ik ben zo’n studente. Landschapsperceptie, zoals die blijkt uit reisteksten, is een nog grotendeels onbekend onderzoeksgebied in zowel de geografische als de letterkundige wetenschap. Ik hoop met deze studie daarin verandering te kunnen brengen." ],
        [ sgpl:refersToConcept unesco:concept17177 ;
            sgpl:subjectText "reisteksten" ;
            sgpl:text_context "Het gaat om de termen landschap, landschapsperceptie en reisteksten. Een reistekst omvat het schriftelijk verslag, in welke vorm dan ook, van een door de auteur (al dan niet werkelijk) ondernomen reis door de geografische ruimte. In welke vorm dan ook, want reisteksten kennen vele verschijningsvormen." ] ;
    sgpl:thesisID 280 .

sgpl:Thesis281 a sgpl:SGPLThesis ;
    dcterms:creator "WILLIAM VAN DE HEL" ;
    dcterms:issued 1994 ;
    dcterms:title "IN PERSPECTIEF",
        "MEERLAAGSE WINKELCENTRA" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751792 ;
            sgpl:spatialText "het Zaailand Leeuwarden" ;
            sgpl:text_context "Bovendien naar MABON BV, in het bijzonder naar drs. I.K.L. de Jong en drs. T. Liebe voor de inhoudelijke en financiële ondersteuning van het onderzoek. Daarnaast ben ik dank verschuldigd aan de personen en bedrijven die het veldwerk in de vier onderzochte winkelcentra hebben mogelijk gemaakt: Mw. M. de Kovel (WPM) en ing. L.M. Dorigo (Centraal Beheer) m.b.t. De Drievriendenhof Dordrecht; Dhr. Abels (Magna Plaza bv) m.b.t. Magna Plaza Amsterdam; Drs. P.J.H. van de Ven (bv Beleggingsmaatschappij Stadscentrum Zoetermeer) m.b.t. Passage Stadshart Zoetermeer; Dhr. J. Smink (Hoekstra Vastgoedbeheer) en dhr. P. Kortekaas (winkeliersvereniging Zaailand) m.b.t. het Zaailand Leeuwarden. Mijn dank gaat tevens uit naar de deelnemers aan het deskundigen-interview : Mw. drs. M.F. Vrins (Mab), drs. E.J. Bolt (ABP), drs. E. Nozeman (MBO) en drs. J.K.C. Vries (Rodamco Continental Europe b.v.)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743856 ;
            sgpl:spatialText "Passage Stadshart Zoetermeer" ;
            sgpl:text_context "Bovendien naar MABON BV, in het bijzonder naar drs. I.K.L. de Jong en drs. T. Liebe voor de inhoudelijke en financiële ondersteuning van het onderzoek. Daarnaast ben ik dank verschuldigd aan de personen en bedrijven die het veldwerk in de vier onderzochte winkelcentra hebben mogelijk gemaakt: Mw. M. de Kovel (WPM) en ing. L.M. Dorigo (Centraal Beheer) m.b.t. De Drievriendenhof Dordrecht; Dhr. Abels (Magna Plaza bv) m.b.t. Magna Plaza Amsterdam; Drs. P.J.H. van de Ven (bv Beleggingsmaatschappij Stadscentrum Zoetermeer) m.b.t. Passage Stadshart Zoetermeer; Dhr. J. Smink (Hoekstra Vastgoedbeheer) en dhr. P. Kortekaas (winkeliersvereniging Zaailand) m.b.t. het Zaailand Leeuwarden. Mijn dank gaat tevens uit naar de deelnemers aan het deskundigen-interview : Mw. drs. M.F. Vrins (Mab), drs. E.J. Bolt (ABP), drs. E. Nozeman (MBO) en drs. J.K.C. Vries (Rodamco Continental Europe b.v.)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "de Nederlandse binnensteden" ;
            sgpl:text_context "In deze paragraaf worden bovendien de mogelijke benaderingswijzen en houdingen ten opzichte van meerlaagse winkelcentra belicht. De redenen om in de Nederlandse binnensteden tot meerlaagse winkelcentra te komen liggen voor de hand. Ruimtegebrek, hoge grondprijzen en hoge ontwikkelingskosten staan daarbij centraal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "De afstudeerscriptie \"Meerlaagse Winkelcentra in Perspectief\" is tot stand gekomen in het kader van het doctoraalonderzoek binnen de specialisatie Planologie van de vakgroep \"Toegepaste Geografie en Planologie\" aan de Rijksuniversiteit Utrecht. Daarnaast is het onderzoek inhoudelijk en financieel ondersteund door MABON BV uit Rijswijk. Ik wens van deze gelegenheid gebruik te maken om personen en bedrijven te bedanken die hebben bijgedragen aan het onderzoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2945024 ;
            sgpl:spatialText "Braunschweig (Dld.)" ;
            sgpl:text_context "Magna Plaza is één van de vier centra waar in het onderzoek gestructureerde tellingen zijn uitgevoerd. Bij tellingen in een vierlaags centrum in Braunschweig (Dld.) lag de passantenverhouding 20-100-60-45 indien de begane grond op 100 wordt gesteld. Hierbij staat de 20% voor het aantal passanten in het souterrain dat niet aansloot op het overige centrum." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Magna Plaza Amsterdam" ;
            sgpl:text_context "Bovendien naar MABON BV, in het bijzonder naar drs. I.K.L. de Jong en drs. T. Liebe voor de inhoudelijke en financiële ondersteuning van het onderzoek. Daarnaast ben ik dank verschuldigd aan de personen en bedrijven die het veldwerk in de vier onderzochte winkelcentra hebben mogelijk gemaakt: Mw. M. de Kovel (WPM) en ing. L.M. Dorigo (Centraal Beheer) m.b.t. De Drievriendenhof Dordrecht; Dhr. Abels (Magna Plaza bv) m.b.t. Magna Plaza Amsterdam; Drs. P.J.H. van de Ven (bv Beleggingsmaatschappij Stadscentrum Zoetermeer) m.b.t. Passage Stadshart Zoetermeer; Dhr. J. Smink (Hoekstra Vastgoedbeheer) en dhr. P. Kortekaas (winkeliersvereniging Zaailand) m.b.t. het Zaailand Leeuwarden. Mijn dank gaat tevens uit naar de deelnemers aan het deskundigen-interview : Mw. drs. M.F. Vrins (Mab), drs. E.J. Bolt (ABP), drs. E. Nozeman (MBO) en drs. J.K.C. Vries (Rodamco Continental Europe b.v.)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Illustratief is de opmerking uit een Amerikaans handboek voor winkelplanning waarin met betrekking tot meerlaagse winkelcentra wordt gesteld dat \"Ground floors are rented, second floors and basements are given away\"! Gestructureerd onderzoek naar het functioneren van meerlaagse winkelcentra in Nederland is tot nu toe nog niet gedaan, dan wel gepubliceerd. Het doel van de afstudeerscriptie is dan ook het leveren van praktische inzichten in het functioneren van meerlaagse winkelcentra in Nederland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Hoog Catharijne in Utrecht" ;
            sgpl:text_context "Een goede mix van huurders, trekkers en een koopkrachtig verzorgingsgebied staan ondanks het matige design garant voor commercieel succes. Ook voor Hoog Catharijne in Utrecht is het matige design geen belemmering voor goed functioneren. The Pavillions in Birmingham daarentegen is een voorbeeld van een schitterend winkelcentrum dat ondanks de luxe aankleding onder de maat functioneert." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754064 ;
            sgpl:spatialText "Hilvertshof in Hilversum" ;
            sgpl:text_context "Een mogelijke verklaring hiervoor is dat als bezoekers eenmaal de moeite hebben genomen om de tweede verdieping te bezoeken, de drempel voor een bezoek aan een derde en eventuele volgende verdieping lager wordt. Dat de passantenverhoudingen sterk centrum-specifiek zijn blijkt wel uit de tellingen die zijn gehouden in het winkelcentrum Hilvertshof in Hilversum waar sprake was van een gelijke passantenverhouding (100%-100%). Ook voor de tweelaagse Passage in het Stadshart van Zoetermeer wordt een ideale verdeling van passanten over de verdiepingen geclaimd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756669 ;
            sgpl:spatialText "De Drievriendenhof Dordrecht" ;
            sgpl:text_context "Bovendien naar MABON BV, in het bijzonder naar drs. I.K.L. de Jong en drs. T. Liebe voor de inhoudelijke en financiële ondersteuning van het onderzoek. Daarnaast ben ik dank verschuldigd aan de personen en bedrijven die het veldwerk in de vier onderzochte winkelcentra hebben mogelijk gemaakt: Mw. M. de Kovel (WPM) en ing. L.M. Dorigo (Centraal Beheer) m.b.t. De Drievriendenhof Dordrecht; Dhr. Abels (Magna Plaza bv) m.b.t. Magna Plaza Amsterdam; Drs. P.J.H. van de Ven (bv Beleggingsmaatschappij Stadscentrum Zoetermeer) m.b.t. Passage Stadshart Zoetermeer; Dhr. J. Smink (Hoekstra Vastgoedbeheer) en dhr. P. Kortekaas (winkeliersvereniging Zaailand) m.b.t. het Zaailand Leeuwarden. Mijn dank gaat tevens uit naar de deelnemers aan het deskundigen-interview : Mw. drs. M.F. Vrins (Mab), drs. E.J. Bolt (ABP), drs. E. Nozeman (MBO) en drs. J.K.C. Vries (Rodamco Continental Europe b.v.)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "Consumentengedrag" ;
            sgpl:text_context "Als aanzet voor de consumentenenquête en ter algemene beeldvorming is de sleutelfiguren gevraagd hun inzichten rond meerlaags winkelgedrag weer te geven. In algemene zin wordt gesteld dat consumentengedrag in meerlaagse winkelcentra niet afwijkt van consumentengedrag in normale winkelcentra. Naarmate de aantrekkelijkheid qua aanbod, bereikbaarheid en sfeer toeneemt zal de consument eerder geneigd zijn om een willekeurig winkelgebied te bezoeken." ],
        [ sgpl:refersToConcept unesco:concept7814 ;
            sgpl:subjectText "Verticale ongelijkheid" ;
            sgpl:text_context "In hoeverre blijft het functioneren van boven- en kelderverdiepingen inderdaad achter op de begane grond? Welke factoren dragen bij aan het ontstaan van deze verticale ongelijkheid en op welke wijze is verticale ongelijkheid te verminderen? Kortom Meerlaagse Winkelcentra in Perspectief." ],
        [ sgpl:refersToConcept unesco:concept1499 ;
            sgpl:subjectText "Meerlaagse winkelcentra" ;
            sgpl:text_context "De (her)ontwikkeling van nog beschikbare lokaties wordt dan ook gekenmerkt door efficiënte vormen van invulling. De realisatie van winkelcentra met meerdere winkelverdiepingen is zo'n vorm van efficiënte invulling waarbij op een beperkte lokatie een relatief groot aanbod wordt gecreëerd. De meningen van de deskundigen op het gebied van winkelvastgoed lopen nogal uiteen wat betreft de wenselijkheid van meerlaagse winkelcentra." ],
        [ sgpl:refersToConcept unesco:concept7814 ;
            sgpl:subjectText "Verticale ongelijkheid" ;
            sgpl:text_context "In hoeverre blijft het functioneren van boven- en kelderverdiepingen inderdaad achter op de begane grond? Welke factoren dragen bij aan het ontstaan van deze verticale ongelijkheid en op welke wijze is verticale ongelijkheid te verminderen? Kortom Meerlaagse Winkelcentra in Perspectief." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "Consumentengedrag" ;
            sgpl:text_context "Als aanzet voor de consumentenenquête en ter algemene beeldvorming is de sleutelfiguren gevraagd hun inzichten rond meerlaags winkelgedrag weer te geven. In algemene zin wordt gesteld dat consumentengedrag in meerlaagse winkelcentra niet afwijkt van consumentengedrag in normale winkelcentra. Naarmate de aantrekkelijkheid qua aanbod, bereikbaarheid en sfeer toeneemt zal de consument eerder geneigd zijn om een willekeurig winkelgebied te bezoeken." ],
        [ sgpl:refersToConcept unesco:concept1499 ;
            sgpl:subjectText "Meerlaagse winkelcentra" ;
            sgpl:text_context "De (her)ontwikkeling van nog beschikbare lokaties wordt dan ook gekenmerkt door efficiënte vormen van invulling. De realisatie van winkelcentra met meerdere winkelverdiepingen is zo'n vorm van efficiënte invulling waarbij op een beperkte lokatie een relatief groot aanbod wordt gecreëerd. De meningen van de deskundigen op het gebied van winkelvastgoed lopen nogal uiteen wat betreft de wenselijkheid van meerlaagse winkelcentra." ] ;
    sgpl:thesisID 281 .

sgpl:Thesis282 a sgpl:SGPLThesis ;
    dcterms:creator "Francine Hijmans van den Bergh" ;
    dcterms:issued 1994 ;
    dcterms:title "De bijdrage van de aanleg van bossen aan regionale ontwikkeling in Nederland",
        "The contribution of afforestation to regional rural development in Britain" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753815 ;
            sgpl:spatialText "de Hondsrug" ;
            sgpl:text_context "Veel nadruk ligt er op het tot stand brengen van een recreatie-as tussen Westerwolde en de Hondsrug waar de Oostermoer precies tussenin ligt. Westerwolde en de Hondsrug zijn twee populaire recreatiegebieden. De Oostermoer kan van hun positieve imago profiteren door een recreatie-as te creëren van het ene naar het andere gebied." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7535498 ;
            sgpl:spatialText "het Oldambt" ;
            sgpl:text_context "Voor deze zogenaamde 'aandachtsgebieden’ worden afzonderlijke regionale ontwikkelingsplannen gemaakt die zijn toegesneden op de specifieke situatie in de gebieden. Twee van de Vinex-aandachtsgebieden zijn het Oldambt en de Oostermoer. In de ontwikkelingsplannen van deze gebieden speelt de aanleg van bossen een rol." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744668 ;
            sgpl:spatialText "Westerwolde" ;
            sgpl:text_context "Veel nadruk ligt er op het tot stand brengen van een recreatie-as tussen Westerwolde en de Hondsrug waar de Oostermoer precies tussenin ligt. Westerwolde en de Hondsrug zijn twee populaire recreatiegebieden. De Oostermoer kan van hun positieve imago profiteren door een recreatie-as te creëren van het ene naar het andere gebied." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de Oostermoer" ;
            sgpl:text_context "Voor deze zogenaamde 'aandachtsgebieden’ worden afzonderlijke regionale ontwikkelingsplannen gemaakt die zijn toegesneden op de specifieke situatie in de gebieden. Twee van de Vinex-aandachtsgebieden zijn het Oldambt en de Oostermoer. In de ontwikkelingsplannen van deze gebieden speelt de aanleg van bossen een rol." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Utrechtse Heuvelrug" ;
            sgpl:text_context "Het bosareaal is in Nederland sterk verspreid over verschillende regio’s. De enige wat grotere oppervlakten bos zijn de Veluwe en de Utrechtse Heuvelrug. In bijlage 2 is de ligging te zien van de bosoppervlakten die groter zijn dan 10 hectare." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Drentse veenkoloniën" ;
            sgpl:text_context "In de regio Oostermoer krijgt de ontwikkeling van het zogenaamde \"boerenbosbedrijf\" veel aandacht. Het \"boerenbosbedrijf' ligt in de Drentse veenkoloniën, tussen Stadskanaal en Gasseltemijveen (zie bijlage 5). Als bosgebied vormt het een belangrijke verbinding voor de recreatie-as tussen Westerwolde en de Hondsrug (zie bijlage 6)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In dit onderzoek zal bekeken worden wat de achterliggende redenen zijn van het streven naar meer bos. In dit onderzoek worden de situaties in Nederland en Groot-Brittannië geanalyseerd. De (veronderstelde) invloed van bossen op regionale ontwikkeling wordt in de twee landen bekeken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "regio Oostermoer" ;
            sgpl:text_context "Daarna wordt in hoofdstuk 3 bekeken of er een verband bestaat tussen enerzijds de aanleg (aanwezigheid) van bossen en anderzijds regionale ontwikkeling. Daartoe wordt de rol van bosaanleg binnen het Regionale Ontwikkelingsplan voor de regio Oostermoer geanalyseerd. In de conclusie worden de resultaten van het Nederlandse en het Britse onderzoeksgedeelte samengebracht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745666 ;
            sgpl:spatialText "Veluwe" ;
            sgpl:text_context "Het bosareaal is in Nederland sterk verspreid over verschillende regio’s. De enige wat grotere oppervlakten bos zijn de Veluwe en de Utrechtse Heuvelrug. In bijlage 2 is de ligging te zien van de bosoppervlakten die groter zijn dan 10 hectare." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2635167 ;
            sgpl:spatialText "Groot-Brittannië" ;
            sgpl:text_context "In dit onderzoek zal bekeken worden wat de achterliggende redenen zijn van het streven naar meer bos. In dit onderzoek worden de situaties in Nederland en Groot-Brittannië geanalyseerd. De (veronderstelde) invloed van bossen op regionale ontwikkeling wordt in de twee landen bekeken." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1853 ;
            sgpl:subjectText "bosaanleg" ;
            sgpl:text_context "Twee van de Vinex-aandachtsgebieden zijn het Oldambt en de Oostermoer. In de ontwikkelingsplannen van deze gebieden speelt de aanleg van bossen een rol. Kennelijk wordt gedacht dat bossen een bijdrage kunnen leveren aan een grotere leefbaarheid en zo een rol kunnen spelen in de regionale ontwikkeling van gebieden." ],
        [ sgpl:refersToConcept unesco:concept603 ;
            sgpl:subjectText "boerenbosbedrijf" ;
            sgpl:text_context "Bos moet ook gezien worden als alternatief voor het bestaande landbouwbedrijf. In de regio Oostermoer krijgt de ontwikkeling van het zogenaamde 'boerenbosbedrijf' veel aandacht. Het 'boerenbosbedrijf' ligt in de Drentse veenkoloniën, tussen Stadskanaal en Gasseltemijveen (zie bijlage 5)." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionale ontwikkeling" ;
            sgpl:text_context "Het gaat in dit onderzoek dus om het verband tussen de aanleg van bossen en regionale ontwikkeling, zowel in Groot-Brittannië als in Nederland. De probleemstelling van dit onderzoek wordt dan: In hoeverre draagt de aanleg van bossen in Groot-Brittannië en in Nederland bij aan regionale ontwikkeling? Om het verband tussen de aanleg van bossen en regionale ontwikkeling te ontdekken is het nodig om eerst de twee onderdelen, bos en regionale ontwikkeling nader te bekeken." ],
        [ sgpl:refersToConcept unesco:concept1853 ;
            sgpl:subjectText "bosaanleg" ;
            sgpl:text_context "Twee van de Vinex-aandachtsgebieden zijn het Oldambt en de Oostermoer. In de ontwikkelingsplannen van deze gebieden speelt de aanleg van bossen een rol. Kennelijk wordt gedacht dat bossen een bijdrage kunnen leveren aan een grotere leefbaarheid en zo een rol kunnen spelen in de regionale ontwikkeling van gebieden." ],
        [ sgpl:refersToConcept unesco:concept603 ;
            sgpl:subjectText "boerenbosbedrijf" ;
            sgpl:text_context "Bos moet ook gezien worden als alternatief voor het bestaande landbouwbedrijf. In de regio Oostermoer krijgt de ontwikkeling van het zogenaamde 'boerenbosbedrijf' veel aandacht. Het 'boerenbosbedrijf' ligt in de Drentse veenkoloniën, tussen Stadskanaal en Gasseltemijveen (zie bijlage 5)." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionale ontwikkeling" ;
            sgpl:text_context "Het gaat in dit onderzoek dus om het verband tussen de aanleg van bossen en regionale ontwikkeling, zowel in Groot-Brittannië als in Nederland. De probleemstelling van dit onderzoek wordt dan: In hoeverre draagt de aanleg van bossen in Groot-Brittannië en in Nederland bij aan regionale ontwikkeling? Om het verband tussen de aanleg van bossen en regionale ontwikkeling te ontdekken is het nodig om eerst de twee onderdelen, bos en regionale ontwikkeling nader te bekeken." ] ;
    sgpl:thesisID 282 .

sgpl:Thesis283 a sgpl:SGPLThesis ;
    dcterms:creator "Henderijn Heldens",
        "Nathalie Schutjens" ;
    dcterms:issued 1994 ;
    dcterms:title "Mallorca, het beste onder de zon?",
        "een onderzoek naar regionale ontwikkeling en leefbaarheid" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2521384 ;
            sgpl:spatialText "Balearen" ;
            sgpl:text_context "Toename van het aantal bedden in appartementen en hotels op de Balearen in indexcijfers in de periode 1980-1990 (1980 = 100). Het aandeel van Mallorca in aantal appartementen en hotels is ongeveer 61%. De bijdrage van de tertiaire sector aan de bruto toegevoegde waarde voor de Balearen is zeer hoog (79,85%), hoger nog dan het cijfer voor heel Spanje dat 69,5% bedraagt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2516452 ;
            sgpl:spatialText "Inca" ;
            sgpl:text_context "Met uitzondering van enkele grotere kernen als Palma, Inca en Manacor heeft het eiland een sterk ruraal karakter. De landbouw is zeer traditioneel en in hoge mate zelfvoorzienend gezien de moeizame communicatie met het vasteland. De secundaire en tertiaire sector zijn nog nauwelijks vertegenwoordigd en concentreren zich in Palma, Inca en Manacor." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2518723 ;
            sgpl:spatialText "El Arenal" ;
            sgpl:text_context "Bahia de Palma, het uitgestrekte zandstrand rond de hoofdstad Pahna, vormt het eerste massa-toeristische \"resort\". Magalluf, El Arenal, Palma Nova etc. zijn door snelle en chaotische verstedelijking versmolten tot een gordel van toeristische industrie. In de gemeente Calvip kan de toename van de bevolking grotendeels worden toegeschreven aan een enorme immigratie vanuit de armere delen van Spanje." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6355015 ;
            sgpl:spatialText "Magalluf" ;
            sgpl:text_context "Bahia de Palma, het uitgestrekte zandstrand rond de hoofdstad Pahna, vormt het eerste massa-toeristische \"resort\". Magalluf, El Arenal, Palma Nova etc. zijn door snelle en chaotische verstedelijking versmolten tot een gordel van toeristische industrie. In de gemeente Calvip kan de toename van de bevolking grotendeels worden toegeschreven aan een enorme immigratie vanuit de armere delen van Spanje." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "gemeente Pollenqa" ;
            sgpl:text_context "De gemeente Pollenfa vormt het meest noordelijke schiereiland van Mallorca met een oppervlak van 14.600 ha. De grootste kern in de gemeente, Pollenfa, ligt landinwaarts aan de voet van Serra Tramuntana. Vanuit de Serra Tramuntana is, vanwege de gevaarlijke wegen, slecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2512989 ;
            sgpl:spatialText "Palma" ;
            sgpl:text_context "Met uitzondering van enkele grotere kernen als Palma, Inca en Manacor heeft het eiland een sterk ruraal karakter. De landbouw is zeer traditioneel en in hoge mate zelfvoorzienend gezien de moeizame communicatie met het vasteland. De secundaire en tertiaire sector zijn nog nauwelijks vertegenwoordigd en concentreren zich in Palma, Inca en Manacor." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2514216 ;
            sgpl:spatialText "Manacor" ;
            sgpl:text_context "Met uitzondering van enkele grotere kernen als Palma, Inca en Manacor heeft het eiland een sterk ruraal karakter. De landbouw is zeer traditioneel en in hoge mate zelfvoorzienend gezien de moeizame communicatie met het vasteland. De secundaire en tertiaire sector zijn nog nauwelijks vertegenwoordigd en concentreren zich in Palma, Inca en Manacor." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2514239 ;
            sgpl:spatialText "Mallorca" ;
            sgpl:text_context "De regionale ontwikkeling van Mallorca is in hoge mate bepaald door de tegenstelling tussen binnenland en kustzone. Het binnenland heeft sinds het begin van deze eeuw een geringe ruimtelijke ontwikkeling doorgemaakt. De agrarische structuur is kleinschaliger geworden onder invloed van interne en externe factoren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6355010 ;
            sgpl:spatialText "Palma Nova" ;
            sgpl:text_context "Bahia de Palma, het uitgestrekte zandstrand rond de hoofdstad Pahna, vormt het eerste massa-toeristische \"resort\". Magalluf, El Arenal, Palma Nova etc. zijn door snelle en chaotische verstedelijking versmolten tot een gordel van toeristische industrie. In de gemeente Calvip kan de toename van de bevolking grotendeels worden toegeschreven aan een enorme immigratie vanuit de armere delen van Spanje." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2510769 ;
            sgpl:spatialText "Spanje" ;
            sgpl:text_context "Ligging van Mallorca ten opzichte van Spanje. In de eerste plaats is er sprake van een sterke economische groei in de westerse wereld na een periode van wederopbouw in de na-oorlogse tijd. Om de economische situatie in Spanje te verbeteren, wil Franco buitenlands kapitaal aan trekken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2521534 ;
            sgpl:spatialText "gemeente Arta" ;
            sgpl:text_context "Arta is een gemeente met een oppervlakte van 14.061 ha. en gelegen in het noord-oosten van Mallorca. De afstand tot Palma is 80 km. Artp wordt ontsloten door twee hoofdwegen: vanuit Manacor en vanuit Alcpdia." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "gemeente Calvip" ;
            sgpl:text_context "De gemeente Calvip. aan de zuidpunt van de Serra Tramuntana, wordt gekenmerkt door relipf. De geschiedenis van Calvip. is geboren uit een verdeling van Mallorca na de Catalaans verovering in 1229 door Jaime I, als het \"Islamitische\" district van Medina Mayurqa -gelegen tussen Palma en Andratx- verdeeld wordt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Henderijn Heidens Nathalie Schutjens Utrecht, Januari 1994 TG/ASG. Faculteit der Ruimtelijke Wetenschappen Universiteit Utrecht Universiteit Utrecht. BIBLIOTHEEK CENTRUM UITHOF RIJKSUNIVERSITEIT TE UTRECHT 2420 533 2." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "Massa-toerisme" ;
            sgpl:text_context "Een gevolg van deze zwakke economische structuur was dat in de periode eind 19e eeuw tot 1950 voornamelijk jonge gezinnen emigreerden. Aan deze situatie komt een einde in de jaren vijftig met de oprichting van de E.G. en de opkomst van het massa-toerisme. Deze twee externe factoren hebben voor het binnenland een versterkte \"exode agraire\" tot gevolg." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "Regionale ontwikkeling" ;
            sgpl:text_context "De beleidskeuzes van de lokale actoren worden namelijk sterk beinvloed door deze context. De ideeën van de lokale actoren ten aanzien van de conflicterende factoren komen tot uitdrukking in het gemeentebeleid en kunnen zelfs een sleutelrol vervullen in de regionale ontwikkeling. Zij geven namelijk aan of het gewenst is de leefbaarheid te verbeteren en in hoeverre er sprake is van een overschreiding van de tolerantie drempelwaarde binnen de gemeenschap." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "Leefbaarheid" ;
            sgpl:text_context "Het initiatief hiertoe ligt hoofdzakelijk op het laagste bestuurlijke niveau: de gemeenten. De gemeenten moeten, ondanks bovenstaande problemen, een evenwicht proberen te vinden tussen leefbaarheid en economische vooruitgang. Het onderzoek is gebaseerd op deze twee deels conflicterende factoren, die op een lokaal niveau duidelijk naar voren komen." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "Massa-toerisme" ;
            sgpl:text_context "Een gevolg van deze zwakke economische structuur was dat in de periode eind 19e eeuw tot 1950 voornamelijk jonge gezinnen emigreerden. Aan deze situatie komt een einde in de jaren vijftig met de oprichting van de E.G. en de opkomst van het massa-toerisme. Deze twee externe factoren hebben voor het binnenland een versterkte \"exode agraire\" tot gevolg." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "Regionale ontwikkeling" ;
            sgpl:text_context "De beleidskeuzes van de lokale actoren worden namelijk sterk beinvloed door deze context. De ideeën van de lokale actoren ten aanzien van de conflicterende factoren komen tot uitdrukking in het gemeentebeleid en kunnen zelfs een sleutelrol vervullen in de regionale ontwikkeling. Zij geven namelijk aan of het gewenst is de leefbaarheid te verbeteren en in hoeverre er sprake is van een overschreiding van de tolerantie drempelwaarde binnen de gemeenschap." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "Leefbaarheid" ;
            sgpl:text_context "Het initiatief hiertoe ligt hoofdzakelijk op het laagste bestuurlijke niveau: de gemeenten. De gemeenten moeten, ondanks bovenstaande problemen, een evenwicht proberen te vinden tussen leefbaarheid en economische vooruitgang. Het onderzoek is gebaseerd op deze twee deels conflicterende factoren, die op een lokaal niveau duidelijk naar voren komen." ] ;
    sgpl:thesisID 283 .

sgpl:Thesis284 a sgpl:SGPLThesis ;
    dcterms:creator "EMMY HESSELS",
        "JEROEN SMIT" ;
    dcterms:issued 1994 ;
    dcterms:title "DE STADSREGIONALE BEDRIJVENTERREINENMARKT EN HERSTRUCTURERING: PRIORITEIT OF LAPMIDDEL?",
        "STUDIE VOOR DE STADSREGIO EINDHOVEN-HELMOND" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6695503 ;
            sgpl:spatialText "Meerhoven" ;
            sgpl:text_context "In de tweede plaats gaat het om het ontwikkelen van het grootschalige stadsuitleggebied Meerhoven dat gelegen is tussen Eindhoven Airport, Veldhoven en Eindhoven. Dit uitleggebied zal een woon- en werkbestemming krijgen, dat regionale betekenis heeft. De basis voor het Sleutelproject werd gelegd in de Profielschets Eindhoven Internationaal Stedelijk Knooppunt uit 1991." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Westcorridor" ;
            sgpl:text_context "Zij ontwikkelde het Sleutelproject Westcorridor. Dit project richt zich op de duurzame ontwikkeling van de zone die loopt vanaf het Centraal Station Eindhoven via het stadsdeel Strijp naar Eindhoven Airport respectievelijk het Citycentrum Veldhoven. Twee aspecten uit het Sleutelproject zijn voor dit onderzoek van belang." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746601 ;
            sgpl:spatialText "Philips-Strijp" ;
            sgpl:text_context "Anderzijds stuit een dergelijke herontwikkeling op specifieke problemen van praktische en financi6le aard. Philips-Strijp zal als voorbeeld worden genomen om na te gaan welke kansen en knelpunten van invloed zijn op de herontwikkeling van vrijkomende bedrijfscomplexen. De aanbodkenmerken van het terrein zullen daarom geconfronteerd moeten worden met wensen en voorwaarden van de actoren op de vastgoedmarkt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "Zowel Philips, DAF als NedCar stoten in het kader van reorganisatieprogramma's momenteel veel bedrijfspanden en reservegronden af, waardoor in de steden Eindhoven en Helmond open plekken ontstaan. De Philips-complexen in het Eindhovense stadsdeel Strijp, de Kadez6ne langs het Eindhovensch kanaal en de Kanaalzone in Helmond zijn voorbeelden van zulke lokaties. Omdat tijd en geld nogal eens belemmerende factoren kunnen zijn, wordt van de gemeenten niet verwacht dat ze met een vastomlijnd herstructureringsbeleid op tafel komen, maar wel dat ze actief meedenken over kansen en knelpunten met betrekking tot in onbruik geraakte bedrijfscomplexen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "BZOB" ;
            sgpl:text_context "Het betreft de bedrijvenlokaties in het Sleutelproject (200 ha), het GDC-Acht (50 ha), de uitbreiding van het BZOB (90 ha), de uitbreiding van Groot-Schooten (17 ha) en een nieuw te ontwikkelen lokatie aan de westkant van Helmond, Brandevoort (20 a 30 ha), in totaal ongeveer 375 ha. In de Regiovisie wordt op verschillende lokaties in totaal 375 ha gepland voor nieuwe bedrijventerreinen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754447 ;
            sgpl:spatialText "Helmond" ;
            sgpl:text_context "Zowel Philips, DAF als NedCar stoten in het kader van reorganisatieprogramma's momenteel veel bedrijfspanden en reservegronden af, waardoor in de steden Eindhoven en Helmond open plekken ontstaan. De Philips-complexen in het Eindhovense stadsdeel Strijp, de Kadez6ne langs het Eindhovensch kanaal en de Kanaalzone in Helmond zijn voorbeelden van zulke lokaties. Omdat tijd en geld nogal eens belemmerende factoren kunnen zijn, wordt van de gemeenten niet verwacht dat ze met een vastomlijnd herstructureringsbeleid op tafel komen, maar wel dat ze actief meedenken over kansen en knelpunten met betrekking tot in onbruik geraakte bedrijfscomplexen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2760050 ;
            sgpl:spatialText "GDC-Acht" ;
            sgpl:text_context "Het betreft de bedrijvenlokaties in het Sleutelproject (200 ha), het GDC-Acht (50 ha), de uitbreiding van het BZOB (90 ha), de uitbreiding van Groot-Schooten (17 ha) en een nieuw te ontwikkelen lokatie aan de westkant van Helmond, Brandevoort (20 a 30 ha), in totaal ongeveer 375 ha. In de Regiovisie wordt op verschillende lokaties in totaal 375 ha gepland voor nieuwe bedrijventerreinen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746600 ;
            sgpl:spatialText "Strijp R" ;
            sgpl:text_context "Strijp R maakt w6l onderdeel uit van het Sleutelproject. Strijp R zal integraal (16 ha) worden herbestemd voor woningbouw, onder het voorbehoud dat de kosten voor bodemsanering dit toelaten. Gedeelten hiervan zijn op het terrein Strijp gelegen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Provincie Noord-Brabant" ;
            sgpl:text_context "Het tweede spoor kent zijn startpunt bij het Streekplan voor de Provincie Noord-Brabant uit 1992. Zowel de relaties binnen de sporen alsmede de dwarsverbanden tussen de twee sporen zullen worden aangegeven. Het schematisch overzicht van dit planologisch kader is te vinden in figuur 1.1." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756252 ;
            sgpl:spatialText "stadsregio Eindhoven-Helmond" ;
            sgpl:text_context "Voor de gemeente Eindhoven en het SRE is de hierboven beschreven problematiek aanleiding geweest een onderzoek te laten verrichten naar de bedrijventerreinen- en kantorensituatie in de stadsregio Eindhoven-Helmond. De rol van vrijkomende, verouderde bedrijfsterreinen moest in het onderzoek meegenomen worden. Dit rapport vormt het eindresultaat van dat onderzoek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746600 ;
            sgpl:spatialText "Strijp T" ;
            sgpl:text_context "Op de drie Strijp-complexen komen de volgende oppervlakten vrij for herontwikkeling: op het complex Strijp S komt ongeveer 1 5 ha plangebied voor bedrijfsmati- ge herontwikkeling in aanmerking; op Strijp T is deze oppervlakte niet groter dan ongeveer 2 ha. Wanneer rekening wordt gehouden met een aftrek van 20% voor openbare voorzieningen (wegen, HOV, groen), dan blijft er 14 ha uitgeefbare grond over." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746600 ;
            sgpl:spatialText "Strijp S" ;
            sgpl:text_context "Op de drie Strijp-complexen komen de volgende oppervlakten vrij voor herontwikkeling: op het complex Strijp S komt ongeveer 1 5 ha plangebied voor bedrijfsmati- ge herontwikkeling in aanmerking; op Strijp T is deze oppervlakte niet groter dan ongeveer 2 ha. Wanneer rekening wordt gehouden met een aftrek van 20% voor openbare voorzieningen (wegen, HOV, groen), dan blijft er 14 ha uitgeefbare grond over." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746600 ;
            sgpl:spatialText "stadsdeel Strijp" ;
            sgpl:text_context "Dit project richt zich op de duurzame ontwikkeling van de zone die loopt vanaf het Centraal Station Eindhoven via het stadsdeel Strijp naar Eindhoven Airport respectievelijk het Citycentrum Veldhoven. Twee aspecten uit het Sleutelproject zijn voor dit onderzoek van belang. In de eerste plaats is dit het actief herstructureren van (delen van) vrijkomende (groot- schalige) bedrijfscomplexen in het stadsdeel Strijp." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven Airport" ;
            sgpl:text_context "Dit project richt zich op de duurzame ontwikkeling van de zone die loopt vanaf het Centraal Station Eindhoven via het stadsdeel Strijp naar Eindhoven Airport respectievelijk het Citycentrum Veldhoven. Twee aspecten uit het Sleutelproject zijn voor dit onderzoek van belang. In de eerste plaats is dit het actief herstructureren van (delen van) vrijkomende (groot- schalige) bedrijfscomplexen in het stadsdeel Strijp." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Daar komt bij dat vrijwel elk stukje grond in Nederland momenteel al bestemd is voor bepaalde activiteiten. Voor economische activiteiten, waarvan de planning door het groeiende milieu- en mobiliteitsvraagstuk steeds complexer wordt, is het daarom van het grootste belang vroegtijdig ruimte te reserveren. Voor de gemeente Eindhoven en het SRE is de hierboven beschreven problematiek aanleiding geweest een onderzoek te laten verrichten naar de bedrijventerreinen- en kantorensituatie in de stadsregio Eindhoven-Helmond." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "Kantoorlocaties" ;
            sgpl:text_context "Daarbij wordt met name aandacht besteed aan de vraag- en aanbodverhoudingen binnen de onderscheiden categorieën bedrijventerreinen. Welke mogelijkheden zijn er voor de herstructureringsterreinen Philips-Strijp in Eindhoven met betrekking tot de herontwikkeling als bedrijventerrein of kantorenlokatie? De herstructurering van bedrijventerreinen als gevolg van het afstoten van activiteiten door bedrijven zoals Philips, DAF en NedCar biedt unieke mogelijkheden, maar levert ook specifieke problemen op voor de herinrichting van delen van de binnenstad." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Bedrijventerreinenbeleid" ;
            sgpl:text_context "Dit rapport vormt het eindresultaat van dat onderzoek. We hebben hierin getracht een veelheid aan gegevens over het onderwerp systematisch te bundelen, opdat ze door de gemeente Eindhoven en het SRE gebruikt kunnen worden voor de te maken keuzes in het bedrijventerreinen- en kantorenbeleid. We hopen met dit onderzoek ook een raamwerk te hebben geboden voor soortgelijke onderzoeken, wanneer en waar dan ook." ],
        [ sgpl:refersToConcept unesco:concept10315 ;
            sgpl:subjectText "Herstructurering" ;
            sgpl:text_context "In de Regiovisie wordt in dit opzicht gesproken over het revitaliseren van de stad. Eén van de onderdelen van zo'n revitalisering is een actieve, ruimtelijke en functionele herstructurering van steden en/of stadsdelen. Met betrekking tot bedrijventerreinen spitst deze herstructurering zich toe op het herbestemmen van vrijkomende bedrijfscomplexen." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Bedrijventerreinenbeleid" ;
            sgpl:text_context "Dit rapport vormt het eindresultaat van dat onderzoek. We hebben hierin getracht een veelheid aan gegevens over het onderwerp systematisch te bundelen, opdat ze door de gemeente Eindhoven en het SRE gebruikt kunnen worden voor de te maken keuzes in het bedrijventerreinen- en kantorenbeleid. We hopen met dit onderzoek ook een raamwerk te hebben geboden voor soortgelijke onderzoeken, wanneer en waar dan ook." ],
        [ sgpl:refersToConcept unesco:concept10315 ;
            sgpl:subjectText "Herstructurering" ;
            sgpl:text_context "In de Regiovisie wordt in dit opzicht gesproken over het revitaliseren van de stad. Eén van de onderdelen van zo'n revitalisering is een actieve, ruimtelijke en functionele herstructurering van steden en/of stadsdelen. Met betrekking tot bedrijventerreinen spitst deze herstructurering zich toe op het herbestemmen van vrijkomende bedrijfscomplexen." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "Kantoorlocaties" ;
            sgpl:text_context "Daarbij wordt met name aandacht besteed aan de vraag- en aanbodverhoudingen binnen de onderscheiden categorieën bedrijventerreinen. Welke mogelijkheden zijn er voor de herstructureringsterreinen Philips-Strijp in Eindhoven met betrekking tot de herontwikkeling als bedrijventerrein of kantorenlokatie? De herstructurering van bedrijventerreinen als gevolg van het afstoten van activiteiten door bedrijven zoals Philips, DAF en NedCar biedt unieke mogelijkheden, maar levert ook specifieke problemen op voor de herinrichting van delen van de binnenstad." ] ;
    sgpl:thesisID 284 .

sgpl:Thesis285 a sgpl:SGPLThesis ;
    dcterms:creator "Anita Jalving" ;
    dcterms:issued 1994 ;
    dcterms:title "Future prospects and policy recommendations",
        "Gentrification in East Tottenham?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2635608 ;
            sgpl:spatialText "South Tottenham" ;
            sgpl:text_context "This research shall focus on three wards in Tottenham; Coleraine, High Cross and South Tottenham, which together will be called East Tottenham (see diagram p. vii). This area is chosen as case study because several designations for (parts of) East Tottenham will lead to considerable investments for economic regeneration. The underlying idea in this research is that economic regeneration could lead to pressures from gentrifiers on the housing market." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Coleraine" ;
            sgpl:text_context "This research shall focus on three wards in Tottenham; Coleraine, High Cross and South Tottenham, which together will be called East Tottenham (see diagram p. vii). This area is chosen as case study because several designations for (parts of) East Tottenham will lead to considerable investments for economic regeneration. The underlying idea in this research is that economic regeneration could lead to pressures from gentrifiers on the housing market." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "London" ;
            sgpl:text_context "First in London, later in other places, parts of a city showed an influx of middle class people in a working-class neighbourhood leading to displacement of the existing residents. The newcomers rehabilitate their houses, which could lead to a total upgrading of the neighbourhood. This process is called gentrification and forms the central theme in this research." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:12264441 ;
            sgpl:spatialText "High Cross" ;
            sgpl:text_context "This research shall focus on three wards in Tottenham; Coleraine, High Cross and South Tottenham, which together will be called East Tottenham (see diagram p. vii). This area is chosen as case study because several designations for (parts of) East Tottenham will lead to considerable investments for economic regeneration. The underlying idea in this research is that economic regeneration could lead to pressures from gentrifiers on the housing market." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2635608 ;
            sgpl:spatialText "East Tottenham" ;
            sgpl:text_context "A study area is chosen in the London Borough (LB) of Haringey, namely East Tottenham (see diagram, p. vii). East Tottenham is a run-down area with unemployment, homelessness and image problems, so maybe at the first sight not an attractive area for newcomers. The area is however interesting for this research because the central government indicated (parts of) the area with special designations, which means that new investments for economic regeneration in the area are likely." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2647476 ;
            sgpl:spatialText "London Borough of Haringey" ;
            sgpl:text_context "A study area is chosen in the London Borough (LB) of Haringey, namely East Tottenham (see diagram, p. vii). East Tottenham is a run-down area with unemployment, homelessness and image problems, so maybe at the first sight not an attractive area for newcomers. The area is however interesting for this research because the central government indicated (parts of) the area with special designations, which means that new investments for economic regeneration in the area are likely." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "This thesis has been written as part of an ERASMUS student exchange program between the University of Utrecht, the Netherlands, and Middlesex University, Enfield (London), United Kingdom. I am extremely thankful to all those who have assisted me in undertaking this research. Particular thanks goes to my supervisor D. Smallbone of Middlesex University for his useful comments on this research report and for his support." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Lee Valley Regional Park" ;
            sgpl:text_context "Main open space in East Tottenham is the Lee Valley Regional Park (LVRP) which is located at the east of East Tottenham. Tottenham Marshes in the north, forms the main part which covers 125 acres of which 117 acres is owned by the Lee Valley Regional Park Authority. The site was used for refuse disposal and landfill after gravel extraction between 1939 and 1969." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Gentrification" ;
            sgpl:text_context "The newcomers rehabilitate their houses, which could lead to a total upgrading of the neighbourhood. This process is called gentrification and forms the central theme in this research. A study area is chosen in the London Borough (LB) of Haringey, namely East Tottenham (see diagram, p. vii)." ],
        [ sgpl:refersToConcept unesco:concept4463 ;
            sgpl:subjectText "Economische regeneratie" ;
            sgpl:text_context "The area is however interesting for this research because the central government indicated (parts of) the area with special designations, which means that new investments for economic regeneration in the area are likely. Economic regeneration could mean an increase in the number of people from outside the area feeling attracted to East Tottenham wishing to buy a house in the area. This could mean that East Tottenham could be \"threatened\" by gentrification." ],
        [ sgpl:refersToConcept unesco:concept4399 ;
            sgpl:subjectText "Woningmarkt" ;
            sgpl:text_context "The key persons were selected from the telephone directory or were recommended by Council officials. The key persons are property developers, estate agents, housing associations, councillors, economic institutions and community organisation workers selected in order to form a vision of East Tottenham and the activity on its housing market. Four main characteristics of the East Tottenham housing market are indicated and the effect of economic regeneration on the housing market in East Tottenham is assessed." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Gentrification" ;
            sgpl:text_context "The newcomers rehabilitate their houses, which could lead to a total upgrading of the neighbourhood. This process is called gentrification and forms the central theme in this research. A study area is chosen in the London Borough (LB) of Haringey, namely East Tottenham (see diagram, p. vii)." ],
        [ sgpl:refersToConcept unesco:concept4399 ;
            sgpl:subjectText "Woningmarkt" ;
            sgpl:text_context "The key persons were selected from the telephone directory or were recommended by Council officials. The key persons are property developers, estate agents, housing associations, councillors, economic institutions and community organisation workers selected in order to form a vision of East Tottenham and the activity on its housing market. Four main characteristics of the East Tottenham housing market are indicated and the effect of economic regeneration on the housing market in East Tottenham is assessed." ],
        [ sgpl:refersToConcept unesco:concept4463 ;
            sgpl:subjectText "Economische regeneratie" ;
            sgpl:text_context "The area is however interesting for this research because the central government indicated (parts of) the area with special designations, which means that new investments for economic regeneration in the area are likely. Economic regeneration could mean an increase in the number of people from outside the area feeling attracted to East Tottenham wishing to buy a house in the area. This could mean that East Tottenham could be \"threatened\" by gentrification." ] ;
    sgpl:thesisID 285 .

sgpl:Thesis286 a sgpl:SGPLThesis ;
    dcterms:creator "Jan Kennis",
        "Martin Schluter" ;
    dcterms:issued 1994 ;
    dcterms:title "De gevolgen van de transitie naar een markteconomie op de regionale economische ontwikkeling",
        "Hongarije: land van de twee snelheden?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:721159 ;
            sgpl:spatialText "het gebied rond Encs" ;
            sgpl:text_context "Dit zijn veelal kleinere plaatsen waar de meerderheid van de beroepsbevolking werkzaam is in één of een paar grote fabrieken. Als voorbeeld kan het gebied rond Encs in Szabolcs-Szatmár-Bereg genoemd worden. In deze streek is de werkloosheid in sommige gemeenten opgelopen tot boven de 40 procent in maart 1992 (Dövényi 1993)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3054643 ;
            sgpl:spatialText "Budapest" ;
            sgpl:text_context "In de economische structuur treedt een verschuiving op van de industrie en landbouw naar de diensten. Budapest gaat fungeren als groeipool. Hierdoor zullen de meeste dienstverlenende bedrijven zich in Budapest vestigen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:719819 ;
            sgpl:spatialText "Hongarije" ;
            sgpl:text_context "Veel minder belangstelling bestaat er voor de regionale gevolgen van de transitie. Als onderzoeksgebied is Hongarije gekozen. In dit land zijn ten tijde van het socialisme al hervormingen doorgevoerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7729884 ;
            sgpl:spatialText "Oost-Europa" ;
            sgpl:text_context "Zowel op politiek als economisch vlak worden ingrijpende hervormingen ingevoerd waardoor een transitie op gang wordt gebracht van een centraal geleide economie naar een markteconomie. De landen in Oost-Europa hebben elk hun eigen route gekozen om deze transitie gestalte te geven. De wijze waarop de verschillende landen hun hervormingen doorvoeren en welke macro-economische effecten deze hebben, krijgt veel aandacht in het Westen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Borsod-Abaüj-Zemplén" ;
            sgpl:text_context "Uitzondering is Baranya. In de provincies Baranya, Veszprém, Komárom-Esztergom, Fejér, Nógrád en Borsod-Abaüj-Zemplén komen echter wel grondstoffen voor. Deze provincies vormen een zuidwest - noordoost lijn, die bekend staat als de energie-as (zie figuur 6.1)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3055744 ;
            sgpl:spatialText "Bács-Kiskun" ;
            sgpl:text_context "In de provincie Pest waar bijna 35.000 banen verdwenen. Ook in de provincies Bács-Kiskun, Békés, Hajdú-Bihar, Szabolcs-Szatmár-Bereg en Borsod-Abaüj-Zemplén daalde de werkgelegenheid in de landbouw snel. De afname van het aantal arbeidsplaatsen zal zich waarschijnlijk ook de komende jaren voortzetten, zij het in een wat langzamer tempo." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:719819 ;
            sgpl:spatialText "Noordwest-Hongarije" ;
            sgpl:text_context "De omringende gebieden zullen hier ook van profiteren. In de korte termijn zal Noordwest-Hongarije waarschijnlijk ook economische groei zien. De perifere gebieden in het noorden en zuiden zullen te maken hebben met een verdere daling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "De gevolgen van de transitie naar een markteconomie op de regionale economische ontwikkeling. Faculteit Ruimtelijke Wetenschappen, Universiteit Utrecht. Heidelberglaan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:9408659 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "Hierdoor zullen de meeste dienstverlenende bedrijven zich in Budapest vestigen. Wat betreft de handel en de buitenlandse investeringen kan het Noord-Westen van Hongarije profiteren van haar ligging ten opzichte van West-Europa. Infrastructuur zal een belangrijke factor bij de keuze van de vestigingsplaats van nieuwe ondernemingen zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:719819 ;
            sgpl:spatialText "Noord-Westen van Hongarije" ;
            sgpl:text_context "Hierdoor zullen de meeste dienstverlenende bedrijven zich in Budapest vestigen. Wat betreft de handel en de buitenlandse investeringen kan het Noord-Westen van Hongarije profiteren van haar ligging ten opzichte van West-Europa. Infrastructuur zal een belangrijke factor bij de keuze van de vestigingsplaats van nieuwe ondernemingen zijn." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8557 ;
            sgpl:subjectText "duale economie" ;
            sgpl:text_context "De transitie naar een markteconomie heeft een aantal processen in gang gezet die van invloed zijn op de economische ontwikkeling van de regio’s. Door de transitie is een soort duale economie ontstaan met de staatsbedrijven enerzijds en de nieuwe particuliere bedrijven anderzijds. De staatsbedrijven zijn een erfenis van de socialistische periode." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionale economische ontwikkeling" ;
            sgpl:text_context "In deze scriptie staan de gevolgen van de transitie van een planeconomie naar een markteconomie centraal. In het bijzonder richt de aandacht zich hierbij op de regionale economische ontwikkeling in Hongarije. De particuliere ondernemingen vestigen zich volgens een ander patroon dan de staatsondernemingen." ],
        [ sgpl:refersToConcept unesco:concept4636 ;
            sgpl:subjectText "transitie naar een markteconomie" ;
            sgpl:text_context "De val van de Berlijnse muur in 1989 leidt tot grote maatschappelijke veranderingen in alle Oosteuropese landen. Zowel op politiek als economisch vlak worden ingrijpende hervormingen ingevoerd waardoor een transitie op gang wordt gebracht van een centraal geleide economie naar een markteconomie. De landen in Oost-Europa hebben elk hun eigen route gekozen om deze transitie gestalte te geven." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionale economische ontwikkeling" ;
            sgpl:text_context "In deze scriptie staan de gevolgen van de transitie van een planeconomie naar een markteconomie centraal. In het bijzonder richt de aandacht zich hierbij op de regionale economische ontwikkeling in Hongarije. De particuliere ondernemingen vestigen zich volgens een ander patroon dan de staatsondernemingen." ],
        [ sgpl:refersToConcept unesco:concept4636 ;
            sgpl:subjectText "transitie naar een markteconomie" ;
            sgpl:text_context "De val van de Berlijnse muur in 1989 leidt tot grote maatschappelijke veranderingen in alle Oosteuropese landen. Zowel op politiek als economisch vlak worden ingrijpende hervormingen ingevoerd waardoor een transitie op gang wordt gebracht van een centraal geleide economie naar een markteconomie. De landen in Oost-Europa hebben elk hun eigen route gekozen om deze transitie gestalte te geven." ],
        [ sgpl:refersToConcept unesco:concept8557 ;
            sgpl:subjectText "duale economie" ;
            sgpl:text_context "De transitie naar een markteconomie heeft een aantal processen in gang gezet die van invloed zijn op de economische ontwikkeling van de regio’s. Door de transitie is een soort duale economie ontstaan met de staatsbedrijven enerzijds en de nieuwe particuliere bedrijven anderzijds. De staatsbedrijven zijn een erfenis van de socialistische periode." ] ;
    sgpl:thesisID 286 .

sgpl:Thesis287 a sgpl:SGPLThesis ;
    dcterms:creator "Ben Verstegen",
        "Jeroen Koldewijn" ;
    dcterms:issued 1994 ;
    dcterms:title "Een regionaal-geografisch onderzoek in de Catalaanse comarca El Baix Penedès",
        "Van Wijn naar een Toeristenparadijs?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "de gemeente Montmell" ;
            sgpl:text_context "Een voorbeeld hiervan is de gemeente Montmell, waar de verlaten terrassen nu bloot staan aan de elementen. Een andere belangrijke oorzaak was een epidemie in de wijnbouw, veroorzaakt door de zogenaamde ’druifluis’ (fibloxera). Deze epidemie zorgde eerder, toen ze in Frankrijk optrad, ironisch genoeg voor een groei van de wijnbouw in de Penedès regio." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3108287 ;
            sgpl:spatialText "de provincie Tarragona" ;
            sgpl:text_context "Sinds de invoering van de huidige provincies, is de Penedès echter opgedeeld over twee provincies. De Baix Penedès ligt in de provincie Tarragona, de andere twee comarcas in de provincie Barcelona. Het in het noordoosten van Tarragona gelegen Baix Penedès wordt in het noorden begrensd door de pre-litorale berggordel." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "de kustgemeenten van de Baix Penedès" ;
            sgpl:text_context "Nog geen honderd jaar geleden was er nauwelijks sprake van toerisme in de kustgemeenten van de Baix Penedès. Het kustgebied kenmerkte zich door rustieke vissersplaatsjes, alwaar het leven met een rustige regelmaat verliep. Wanneer er nu over de boulevards parallel aan het strand geflaneerd wordt, dan denkt menigeen met weemoed terug aan de tijd van weleer." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2510769 ;
            sgpl:spatialText "Spanje" ;
            sgpl:text_context "Deze zogenaamde ’Comunidad Autónoma’ is één van de zeventien autonome regio’s binnen Spanje en is qua oppervlak te vergelijken met België. De ligging van Catalonië blijkt uit figuur 1.1. In deze kaart wordt de huidige bestuurlijke indeling van Spanje weergegeven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3128760 ;
            sgpl:spatialText "het metropolitane gebied Barcelona" ;
            sgpl:text_context "In de kuststreek is er sprake van een relatieve afname van de natuurlijke bevolkingsgroei. De migratiesaldi in de kuststreek zijn positief, met uitzondering van het metropolitane gebied Barcelona. In het binnenland zijn ze voor het overgrote deel negatief." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3121557 ;
            sgpl:spatialText "de comarcas Alt Penedès en Garraf" ;
            sgpl:text_context "De Penedès is echter opgedeeld over twee provincies. De Baix Penedès maakt, tezamen met de comarcas Alt Penedès en Garraf, deel uit van de Penedès regio. De Baix Penedès ligt in de provincie Tarragona, de andere twee comarcas in de provincie Barcelona." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3108288 ;
            sgpl:spatialText "de stad Tarragona" ;
            sgpl:text_context "Vanuit deze steden vertrekken de meeste spoorlijnen met natuurlijk een nadruk op het metropolitane gebied van Barcelona. De spoorlijnen zijn voornamelijk geconcentreerd rond de steden Barcelona, Tarragona en Lleida. Verder liggen er in het binnenland nog enige minder druk bereden lijnen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3336901 ;
            sgpl:spatialText "Catalonië" ;
            sgpl:text_context "Deze scriptie is een regionaal-geografische studie van de regio de Baix Penedès. Deze comarca vormt een onderdeel van een autonome regio binnen Spanje, te weten Catalonië. Deze zogenaamde ’Comunidad Autónoma’ is één van de zeventien autonome regio’s binnen Spanje en is qua oppervlak te vergelijken met België." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "l’Arboç" ;
            sgpl:text_context "Tot aan 1960 is de economie van de Baix Penedès gebaseerd geweest op de agrarische sector, met name de wijnbouw. In 1960 kende de Baix Penedès vijf gemeenten met meer dan 1.000 inwoners, namelijk l’Arboç, la Bisbal, Calafell, Sant Jaume en de hoofdplaats el Vendrell. Van deze vijf is eigenlijk alleen de hoofdplaats van de comarca ’groot’ te noemen met 6.000 van de toen ruim 17.000 inwoners van de comarca." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de Baix Penedès" ;
            sgpl:text_context "Deze scriptie is een regionaal-geografische studie van de regio de Baix Penedès. Deze comarca vormt een onderdeel van een autonome regio binnen Spanje, te weten Catalonië. Deze zogenaamde ’Comunidad Autónoma’ is één van de zeventien autonome regio’s binnen Spanje en is qua oppervlak te vergelijken met België." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Urbaan veld" ;
            sgpl:text_context "Voordat de Baix Penedès een deel uit ging maken van het systeem, was het een rurale comarca. Sinds de jaren zestig is de Baix Penedès geleidelijk aan geïntegreerd in het ’systeem’ dat het urbane veld Barcelona is. Onder invloed van de reeds genoemde maatschappelijke processen, breidde het urbane leven zich uit vanuit Barcelona." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "Toerisme" ;
            sgpl:text_context "Deze specifieke tak van de economie is moeilijk in cijfers te vangen, daar toerisme zich moeilijk laat meten. De groei van het toerisme hangt samen met een veelvoud aan factoren, zoals hoofdstuk vijf nog zal laten zien. Er zijn een drietal karakteristieken te onderscheiden aangaande toerisme in de Baix Penedès (Margalef i Llebaria, 1990, p. 219-220)." ],
        [ sgpl:refersToConcept unesco:concept3513 ;
            sgpl:subjectText "Wijnbouw" ;
            sgpl:text_context "In de 18c en 19c eeuw groeide de comarca dankzij een uitbreiding van de agrarische activiteiten. De wijnbouw en aanverwante commerciële activiteiten maakten de Baix Penedès tot een aantrekkelijk vestigingsgebied. In de loop van de 19e eeuw nam de groei af doordat de agrarische productie verzadigd raakte." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Urbaan veld" ;
            sgpl:text_context "Voordat de Baix Penedès een deel uit ging maken van het systeem, was het een rurale comarca. Sinds de jaren zestig is de Baix Penedès geleidelijk aan geïntegreerd in het ’systeem’ dat het urbane veld Barcelona is. Onder invloed van de reeds genoemde maatschappelijke processen, breidde het urbane leven zich uit vanuit Barcelona." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "Toerisme" ;
            sgpl:text_context "Deze specifieke tak van de economie is moeilijk in cijfers te vangen, daar toerisme zich moeilijk laat meten. De groei van het toerisme hangt samen met een veelvoud aan factoren, zoals hoofdstuk vijf nog zal laten zien. Er zijn een drietal karakteristieken te onderscheiden aangaande toerisme in de Baix Penedès (Margalef i Llebaria, 1990, p. 219-220)." ],
        [ sgpl:refersToConcept unesco:concept3513 ;
            sgpl:subjectText "Wijnbouw" ;
            sgpl:text_context "In de 18c en 19c eeuw groeide de comarca dankzij een uitbreiding van de agrarische activiteiten. De wijnbouw en aanverwante commerciële activiteiten maakten de Baix Penedès tot een aantrekkelijk vestigingsgebied. In de loop van de 19e eeuw nam de groei af doordat de agrarische productie verzadigd raakte." ] ;
    sgpl:thesisID 287 .

sgpl:Thesis288 a sgpl:SGPLThesis ;
    dcterms:creator "Sarah Kropveld" ;
    dcterms:issued 1994 ;
    dcterms:title "An Urban Village in West Silvertown" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2637825 ;
            sgpl:spatialText "West Silvertown" ;
            sgpl:text_context "West Silvertown, bordered by the North Woolwich road, the Connaught road and the Victoria Dock consists mostly of vacant land. But now the London Docklands Development Corporation has plans to build an Urban Village in West Silvertown. This means that they aim to build a new community of 5,000 people with homes, jobs and facilities that give the area a self-sustaining character." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "Londen" ;
            sgpl:text_context "Sarah Kropveld Middlesex University University of Utrecht June 1994. This Thesis has been written as part of an ERASMUS student exchange program between the University of Utrecht, the Netherlands and Middlesex University, London, the United Kingdom. I am extremely grateful to all those who have assisted me in undertaking this research." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:8449743 ;
            sgpl:spatialText "Isle of Dogs" ;
            sgpl:text_context "But it proved difficult to attract private investment to the more eastern parts of Docklands. The Royal Docks, situated east of the Isle of Dogs, is the last area that still has to be regenerated by the LDDC. The Royal Docks were the last and largest docks built in London Docklands." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Sarah Kropveld Middlesex University University of Utrecht June 1994. This Thesis has been written as part of an ERASMUS student exchange program between the University of Utrecht, the Netherlands and Middlesex University, London, the United Kingdom. I am extremely grateful to all those who have assisted me in undertaking this research." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "het Royal Victoria Dock" ;
            sgpl:text_context "They were built between 1855 and 1921 to accommodate the new steam powered cargo ships, and finally they closed in 1981. The Royal Docks comprises four docks and a basin: the Royal Victoria Dock, the Pontoon Dock, the Royal Albert Dock, the King George V Dock and the Albert Basin. South of the docks are two neighbourhoods, North Woolwich in the east and Silvertown, named after S.W. Silver’s clothing works, in the west." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "MA Thesis Sarah Kropveld Middlesex University University of Utrecht June 1994. RIJKSUNIVERSITEIT TE UTRECHT 2564 993 4 ACKNOWLEDGEMENTS. This Thesis has been written as part of an ERASMUS student exchange program between the University of Utrecht, the Netherlands and Middlesex University, London, the United Kingdom." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:12048330 ;
            sgpl:spatialText "de Royal Docks" ;
            sgpl:text_context "The Royal Docks, situated east of the Isle of Dogs, is the last area that still has to be regenerated by the LDDC. The Royal Docks were the last and largest docks built in London Docklands. They were built between 1855 and 1921 to accommodate the new steam powered cargo ships, and were once the largest and most technically advanced docks in the world." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2641639 ;
            sgpl:spatialText "de gemeente Newham" ;
            sgpl:text_context "This thesis will discuss the different expectations about the Urban Village in West Silvertown. The parties involved in this Urban Village are the Urban Villages Group, who developed the Urban Village concept, the London Docklands Development Corporation, the London Borough of Newham in which the Royal Docks are situated, and the West Silvertown residents. They all agree on an Urban Village but each has different expectations about it." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2637825 ;
            sgpl:spatialText "Silvertown" ;
            sgpl:text_context "The Royal Docks comprises four docks and a basin: the Royal Victoria Dock, the Pontoon Dock, the Royal Albert Dock, the King George V Dock and the Albert Basin. South of the docks are two neighbourhoods, North Woolwich in the east and Silvertown, named after S.W. Silver’s clothing works, in the west. In the far western corner of the Royal Docks, there is another small neighbourhood, West Silvertown." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stedelijke herontwikkeling" ;
            sgpl:text_context "The Docklands in the East End of London declined from the 1960’s onwards when economic and technical change led to dock closures. 8.5 Square miles became vacant, the largest redevelopment area in Western Europe, and could be used for experiments in urban regeneration. The Conservative Government established the London Docklands Development Corporation (LDDC) in 1981 which aim it was to attract private investment to regenerate the area." ],
        [ sgpl:refersToConcept unesco:concept5861 ;
            sgpl:subjectText "Gemeenschapsdeelname" ;
            sgpl:text_context "It starts with the People’s Plan, the first attempt for community participation in the Royal Docks 10 years ago. Then the outcome of the Planning Weekend will be discussed. The Planning Weekend was organised by the Urban Villages Forum as an attempt to involve the residents in the planning of the Urban Village." ],
        [ sgpl:refersToConcept unesco:concept445 ;
            sgpl:subjectText "Urban Village-concept" ;
            sgpl:text_context "When implemented, West Silvertown will be one of the first Urban Villages in Britain. As this Urban Village concept is a new development in town planning, it is worth researching. Also the location of this Urban Village in Docklands, wich can be seen as a laboratory for urban planning, makes it an interesting subject for research." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stedelijke herontwikkeling" ;
            sgpl:text_context "The Docklands in the East End of London declined from the 1960’s onwards when economic and technical change led to dock closures. 8.5 Square miles became vacant, the largest redevelopment area in Western Europe, and could be used for experiments in urban regeneration. The Conservative Government established the London Docklands Development Corporation (LDDC) in 1981 which aim it was to attract private investment to regenerate the area." ],
        [ sgpl:refersToConcept unesco:concept445 ;
            sgpl:subjectText "Urban Village-concept" ;
            sgpl:text_context "When implemented, West Silvertown will be one of the first Urban Villages in Britain. As this Urban Village concept is a new development in town planning, it is worth researching. Also the location of this Urban Village in Docklands, wich can be seen as a laboratory for urban planning, makes it an interesting subject for research." ],
        [ sgpl:refersToConcept unesco:concept5861 ;
            sgpl:subjectText "Gemeenschapsdeelname" ;
            sgpl:text_context "It starts with the People’s Plan, the first attempt for community participation in the Royal Docks 10 years ago. Then the outcome of the Planning Weekend will be discussed. The Planning Weekend was organised by the Urban Villages Forum as an attempt to involve the residents in the planning of the Urban Village." ] ;
    sgpl:thesisID 288 .

sgpl:Thesis289 a sgpl:SGPLThesis ;
    dcterms:creator "Chiel Stroeven",
        "Paul Mijland" ;
    dcterms:issued 1994 ;
    dcterms:title "Onderzoek naar de toepassing van multimedia en uitwerking in een applicatie",
        "kartografie en multimedia" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "De Vakgroep Kartografie van de Faculteit der Ruimtelijke Wetenschappen te Utrecht heeft hier begin 1993 op in gehaakt door eigen onderzoek op te starten op het gebied van de multimedia. Dit heeft onder meer geresulteerd in deze scriptie. Het doel van deze scriptie is de toepassingsmogelijkheden van multimedia in de kartografie te onderzoeken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748994 ;
            sgpl:spatialText "Oude Tonge" ;
            sgpl:text_context "De overstromingen in deze regio zijn, op het gebruikte schaalniveau, wel goed gedocumenteerd zodat de overstroming in fasen kon worden opgedeeld. Naast de overstroming van Tholen, waar het primair om de vergelijking tussen de verschillende karteermethoden ging, is gekozen voor het weergeven van de overstroming van Oude Tonge, wat gesitueerd is op Goeree-Overflakkee (fig. 7.6). Bij de animatie van Oude Tonge had het realistische karakter prioriteit." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755989 ;
            sgpl:spatialText "Europoortregio" ;
            sgpl:text_context "Om ons onderwerp min of meer af te ronden zijn de wijzigingen in de vorm van de kustlijn in de regio rond de Europoort als animatie weergegeven. De animatie beslaat de periode van 1953 tot heden. In het overzichtskaartje wordt landaanwinst (inclusief de Zeelandbrug) en landverlies gescheiden weergegeven, dit in tegenstelling tot het inzoom kaartje van het Europoortgebied, waar de landaanwinst en het landverlies tegelijkertijd wordt weergegeven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "zuid-west Nederland" ;
            sgpl:text_context "Helaas was de telecommunicatie in 1953 nog niet zo ontwikkeld als vandaag de dag en was in veel gevallen niet bekend wanneer de verschillende locaties precies overstroomden. Aangezien wij beschikten over een digitaal basisbestand van zuid-west Nederland met het overstroomd en drassig gebied, zou het zonde zijn geweest om er niets mee te doen. Het kostte dan ook weinig moeite om de overstroming van zuid-west Nederland in een korte animatie weer te geven (fig. 7.7)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744011 ;
            sgpl:spatialText "Zeeland" ;
            sgpl:text_context "Inke Camphens willen wij bedanken voor het inspreken van de engelse teksten en het kartografisch laboratorium van de Universiteit Utrecht voor het beschikbaar stellen van het digitale bestand van Zeeland. Tenslotte bedanken wij de heer Drs. R.O. Koop voor zijn begeleiding gedurende deze maanden. Paul Mijland Chiel Stroeven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746352 ;
            sgpl:spatialText "Tholen" ;
            sgpl:text_context "Elke kaart is een momentopname van een bepaald moment of periode in de tijd. Een geanimeerd voorbeeld van deze techniek is te vinden in de bij deze scriptie behorende applicatie, waarbij de overstroming van Tholen wordt weergegeven. Een ander voorbeeld is de NAIS demo van de vakgroep Kartografie, waar onder meer de vorming van de nederlandse kustlijn wordt uitgebeeld en de Territorial evolution of Canada waar de wordingsgeschiedenis van het land wordt geanimeerd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:12808706 ;
            sgpl:spatialText "Goeree-Overflakkee" ;
            sgpl:text_context "Naast de overstroming van Tholen, waar het primair om de vergelijking tussen de verschillende karteermethoden ging, is gekozen voor het weergeven van de overstroming van Oude Tonge, wat gesitueerd is op Goeree-Overflakkee (fig. 7.6). Bij de animatie van Oude Tonge had het realistische karakter prioriteit. De basis voor de animatie is een scan van een topografische kaart uit 1955 van het betreffende gebied." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2374 ;
            sgpl:subjectText "Kartografische animaties" ;
            sgpl:text_context "Er zijn zeer veel toepassingen denkbaar waarvoor animaties een nuttige functie vervullen. Kartografische animaties kunnen niet los worden gezien van de factor tijd. Het weergeven van de tijdsdimensie biedt de beste toepassingsmogelijkheden voor animaties (Goodchild, 1988)." ],
        [ sgpl:refersToConcept unesco:concept3342 ;
            sgpl:subjectText "Interactieve multimedia" ;
            sgpl:text_context "Interactieve multimedia gaat een steeds belangrijkere rol spelen in de informatieve en communicatieve industrie. Interactieve multimedia maakt het mogelijk de diverse, steeds groeiende hoeveelheid informatie geïntegreerd aan te bieden op een gebruiksvriendelijke manier. Door de ingebouwde interactiviteit bepaalt de gebruiker wat het wil horen, zien en doen." ],
        [ sgpl:refersToConcept unesco:concept3339 ;
            sgpl:subjectText "Audio variabelen" ;
            sgpl:text_context "Zo zouden we in het geval van het gebruik van geluid als hierboven genoemd (toonlengte, associatieve spraak (kwantitatief), toonhoogte, volume van geluid en geluidsoort) kunnen spreken van audio variabelen die kaartelementen van elkaar onderscheiden. In dat geval zouden ook waarnemingseigenschappen gekoppeld kunnen worden aan de audio variabelen. Figuur 4.3 is een poging hiertoe." ],
        [ sgpl:refersToConcept unesco:concept2374 ;
            sgpl:subjectText "Kartografische animaties" ;
            sgpl:text_context "Er zijn zeer veel toepassingen denkbaar waarvoor animaties een nuttige functie vervullen. Kartografische animaties kunnen niet los worden gezien van de factor tijd. Het weergeven van de tijdsdimensie biedt de beste toepassingsmogelijkheden voor animaties (Goodchild, 1988)." ],
        [ sgpl:refersToConcept unesco:concept3342 ;
            sgpl:subjectText "Interactieve multimedia" ;
            sgpl:text_context "Interactieve multimedia gaat een steeds belangrijkere rol spelen in de informatieve en communicatieve industrie. Interactieve multimedia maakt het mogelijk de diverse, steeds groeiende hoeveelheid informatie geïntegreerd aan te bieden op een gebruiksvriendelijke manier. Door de ingebouwde interactiviteit bepaalt de gebruiker wat het wil horen, zien en doen." ],
        [ sgpl:refersToConcept unesco:concept3339 ;
            sgpl:subjectText "Audio variabelen" ;
            sgpl:text_context "Zo zouden we in het geval van het gebruik van geluid als hierboven genoemd (toonlengte, associatieve spraak (kwantitatief), toonhoogte, volume van geluid en geluidsoort) kunnen spreken van audio variabelen die kaartelementen van elkaar onderscheiden. In dat geval zouden ook waarnemingseigenschappen gekoppeld kunnen worden aan de audio variabelen. Figuur 4.3 is een poging hiertoe." ] ;
    sgpl:thesisID 289 .

sgpl:Thesis29 a sgpl:SGPLThesis ;
    dcterms:creator "J. Harms" ;
    dcterms:issued 1960 ;
    dcterms:title "Historisch-demografische spanningen op de zandgronden van de Gelderse Vallei",
        "in verband met de ontwikkeling van het kleinbedrijf en de pluimveeteelt" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "Utrechtse Stuwwallen" ;
            sgpl:text_context "De eerste taak,waarvoor de geograaf zich gesteld ziet, is het om- grenzen van het te onderzoeken gebied,i.c.van de Gelderse Vallei. ITu is het afpalen volgens een nhysisch-geografisch criterium in zoverre eenvoudig,dat het relief markante trekken vertoont,waardoor de Vallei op duidelijke wijze te herkennen is als een naar het Noorden breder wordend dal,als een lage inzinking tussen de Veluwse en Utrechtse Stuwwallen. Waar op de heuvelruggen,ongeveer boven de hoogtelijn van 20m,de bossen en-zo het bos verdwenen is-de stuif- zanden liggen,daar ligt de grens,welke de Vallei scheidt van de \"onbewoonde\"wereld van zanden,uitgestrekte heidevelden en bossen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745666 ;
            sgpl:spatialText "Veluwse Stuwwallen" ;
            sgpl:text_context "De eerste taak,waarvoor de geograaf zich gesteld ziet, is het om- grenzen van het te onderzoeken gebied,i.c.van de Gelderse Vallei. ITu is het afpalen volgens een nhysisch-geografisch criterium in zoverre eenvoudig,dat het relief markante trekken vertoont,waardoor de Vallei op duidelijke wijze te herkennen is als een naar het Noorden breder wordend dal,als een lage inzinking tussen de Veluwse en Utrechtse Stuwwallen. Waar op de heuvelruggen,ongeveer boven de hoogtelijn van 20m,de bossen en-zo het bos verdwenen is-de stuif- zanden liggen,daar ligt de grens,welke de Vallei scheidt van de \"onbewoonde\"wereld van zanden,uitgestrekte heidevelden en bossen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759197 ;
            sgpl:spatialText "Bennekom" ;
            sgpl:text_context "Rijk aan contrasten zijn de nederzettingen in de oude woonzone in de schaduw van het IToftbos tussen Wageningen en Lunteren en in het gebied der kampontginningen op het grillige patroon van de zandruggen. In het eerste gebied: een rondom een brink geconcentreerde bevolking van geërfde boeren en van keuters, van boeren, ambachtslieden, renteniers en dagloners(in de kerkdorpen als Bennekom, Ede, Lunteren, Otterloo). Een in smalle stroken verdeelde eng aan de \"hoge kant\" van het dorp, in het Veld de gronden van de Buurt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756429 ;
            sgpl:spatialText "Ede" ;
            sgpl:text_context "IV/at overblijft voor de landbouwende bevolking is nadere intensivering en vloeing naar andere beroepen, het laatste gepaard gaanoe met een forensisme of met vertrek naar plaatsen als Veenendaal en Ede. Een ty-nisch verschijnsel in de Gelderse Vallei,dat in nauw en di- rect verband staat met de opkomst van talrijke kleine bedrijfjes door kolonisatie en door splitsing van bestaande boerderijen,is de kinnenhouderij. Zo men dit verband voorbijgaat en de opkomst en groei van de pluimveeteelt niet plaatst in een historische context,dan is men daarover spoedig uitgepraat." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759406 ;
            sgpl:spatialText "Gemeente Barneveld" ;
            sgpl:text_context "Al heeft Hartog in zijn opstel het niet uitdrukkelijk over de kippenhouderij, in 1886 schrijft hij een rapport over de agrarische stand van zaken in de gemeente Barneveld, waarin wij lezen, dat de kippenhouderij een grote vlucht neemt en dat menig boertje zijn pachtpenningen kan betalen uit de opbrengst van eieren en kippen. Afgezien daarvan,dat wij nu enig houvast krijgen in het bepalen van het begin der grote kippenhouderij,geeft dit zinnetje onbedoeld relief aan een opmerking in het pretentieloze,maar aardige boekje van de Barneveldse Burgemeester Nairac." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "zandgronden van de Gelderse Vallei" ;
            sgpl:text_context "J.Harms. mei 1960. Historisch-demografische spanningen op de zandgronden van de Gelderse Vallei, (in verband met, de ontwikkeling van het kleinbedrijf en de pluimveeteelt). J.Karma." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelderse Vallei" ;
            sgpl:text_context "Hoofdstuk I INLEIDING. De eerste taak,waarvoor de geograaf zich gesteld ziet, is het om- grenzen van het te onderzoeken gebied,i.c.van de Gelderse Vallei. ITu is het afpalen volgens een nhysisch-geografisch criterium in zoverre eenvoudig,dat het relief markante trekken vertoont,waardoor de Vallei op duidelijke wijze te herkennen is als een naar het Noorden breder wordend dal,als een lage inzinking tussen de Veluwse en Utrechtse Stuwwallen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753919 ;
            sgpl:spatialText "Holland" ;
            sgpl:text_context "Ederveen is zulk een kolonisatie- gebied van paupers,van de doodarme voorouders van de tegenwoordige kleine boeren. Het is opvallend dat de verarming op het platteland zo duidelijk openbaar wordt in allerlei vormen van mobiliteit, waaronder niet alleen de bovengenoemde migraties gerangschikt kunnen worden,maar ook het grasmaaien in \"Holland\" en het rondtrekken, langs de boeren, van bedelende daghuurdersvrouwen. De armoede en de achteruitgang troffen overigens ook de landbouw in het meer centrale deel van de Vallei,waar verreweg de meeste boerderijen buurbedrijven waren." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756426 ;
            sgpl:spatialText "Ederveen" ;
            sgpl:text_context "In vroegere eeuwen zien wij hóe de agrarische beroepsbevolking een oplossing vindt in de intensivering, bv.van een bepaald bedrijfs- onderdeel als de bijenhouderij,of in een migratie naar onontgonnen gebieden,bv.Ederveen en het lunterse Veld,of in een ander beroep, bv.van fabrieksarbeider in Veenendaal,maar in de 20-e eeuw is in de*Vallei niet veel meer te ontginnen en te koloniseren. Ederveen is zulk een kolonisatie- gebied van paupers,van de doodarme voorouders van de tegenwoordige kleine boeren. Het is opvallend dat de verarming op het platteland zo duidelijk openbaar wordt in allerlei vormen van mobiliteit, waaronder niet alleen de bovengenoemde migraties gerangschikt kunnen worden,maar ook het grasmaaien in \"Holland\" en het rondtrekken, langs de boeren, van bedelende daghuurdersvrouwen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745774 ;
            sgpl:spatialText "Veenendaal" ;
            sgpl:text_context "In vroegere eeuwen zien wij hóe de agrarische beroepsbevolking een , oplossing vindt in de intensivering, bv.van een bepaald bedrijfs- onderdeel als de bijenhouderij,of in een migratie naar onontgonnen gebieden,bv.Ederveen en het lunterse Veld,of in een ander beroep, bv.van fabrieksarbeider in Veenendaal,maar in de 20-e eeuw is in de*Vallei niet veel meer te ontginnen en te koloniseren. IV/at overblijft voor de landbouwende bevolking is nadere intensivering en vloeing naar andere beroepen, het laatste gepaard gaanoe met een forensisme of met vertrek naar plaatsen als Veenendaal en Ede. Een ty-nisch verschijnsel in de Gelderse Vallei,dat in nauw en di- rect verband staat met de opkomst van talrijke kleine bedrijfjes door kolonisatie en door splitsing van bestaande boerderijen,is de kinnenhouderij." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3457 ;
            sgpl:subjectText "Pluimveeteelt" ;
            sgpl:text_context "Een typisch verschijnsel in de Gelderse Vallei, dat in nauw en direct verband staat met de opkomst van talrijke kleine bedrijfjes door kolonisatie en door splitsing van bestaande boerderijen, is de kippenhouderij, die, evenals de gehele agrarische structuur, sinds het eind der vorige eeuw een geweldige ontwikkeling doorgemaakt heeft. Zo men dit verband voorbijgaat en de opkomst en groei van de pluimveeteelt niet plaatst in een historische context, dan is men daarover spoedig uitgepraat; als vanzelf echter leidde het onderzoek naar de historische kippenhouderij in de Vallei tot een onderzoek naar het ontstaan van de kleine keuterbedrijfjes, terwijl dit laatste op zijn beurt weer aanleiding gaf om dieper te gaan graven naar de historisch-demografische ontwikkeling in de Gelderse Vallei-, waarmee de oorspronkelijke opzet (de historische kippenhouderij) eigenlijk werd overschreden. In hoofdstuk II wordt de pluimveeteelt in de Vallei zo mogelijk ab ovo verteld, waarbij blijkt dat de kippenhouderij in vroeger eeuwen niet zonder betekenis was; weliswaar is de omvang toen nooit groot geweest- niet te vergelijken met wat we in de 20-e eeuw zien-, maar toch moet de kippenhouderij een bepaalde functie hebben gehad, immers komt men herhaaldelijk de opmerkelijke bepaling tegen dat tijnsen, pachten en tienden betaald moeten of mogen worden in de vorm van hoenders of eieren." ],
        [ sgpl:refersToConcept unesco:concept678 ;
            sgpl:subjectText "Occupatiegeschiedenis" ;
            sgpl:text_context "In de volgende hoofdstukken wordt ingegaan op de occupatie-geschiedenis van de Gelderse Vallei, waarin wij enkele fasen menen te kunnen ontdekken, zij het dat deze fasen niet erg duidelijk zijn te markeren. Toch lijkt het erop dat de eerste bewoningscentra op de hoge zandgronden, op de hellingen van de Vallei te vinden zijn en dat van daaruit in de middeleeuwen, in een volgende fase, de 'wouden' op de middelhoge zandgronden ontgonnen zijn, aldus een spreiding vanuit de hoger gelegen brink-nederzettingen naar het midden van de Vallei, naar het gebied der horsten, laren en donken. Rijk aan contrasten zijn de nederzettingen in de oude woonzone in de schaduw van het Moftbos tussen Wageningen en Lunteren en in het gebied der kampontginningen op het grillige patroon van de zandruggen (vgl. de Bodemkaart 1:100.000, waarop met zwarte stippen verschillende horst-, laar- en donk-namen zijn aangegeven)." ],
        [ sgpl:refersToConcept unesco:concept9673 ;
            sgpl:subjectText "Kleinbedrijf" ;
            sgpl:text_context "Waar kenmerken van uitgesproken physische aard, zoals heuvels of een rivier, afwezig zijn, moeten wij op een andere wijze trachten een grens te vinden, waarbinnen de Gelderse Vallei als een typisch gebied onderscheiden wordt van de buiten die grens gelegen gebieden, waarmee tegelijk het, tot een minimum gereduceerde, geografische adagium- 'hier dit, daar dat'- aan de orde is. Typisch voor de Gelderse Vallei is het bestaan van overwegend kleine boerenbedrijfjes met veeteelt en vooral kippenhouderij als voornaamste bedrijfstakken; eigenlijk is niet zozeer het bestaan, maar veeleer het ontstaan typerend en wel aan de rand van de bestaande bevolkingskernen- individuele boerderijen of dorpen-, aan de zoom van de reeds vroeger ontgonnen cultuur-arealen; de dynamiek van de bevolkingstoeneming leidde er toe, dat steeds nieuwe gebieden ontgonnen werden, of- wanneer cultivering van woeste gronden om bepaalde redenen werd tegengehouden- dat in de bestaande landbouw-bedrijven geïntensiveerd werd. Ofschoon het afgrenzen van de Vallei in het Noorden, in physisch-geografisch opzicht niet gelukt, toch mogen wij het morfologisch karakter van ons gebied niet negeren, immers is het merkwaardig om te zien hoe in de loop der eeuwen de occupatie zich voltrekt op een telkens lager liggend niveau, waardoor achtereenvolgens de hoge zandgronden op de helling der Vallei, de bosgronden, waarop de brink-nederzettingen en de engen kwamen te liggen, daarna de middelhoge, met 'woud' begroeide zandruggen, de horsten en donken, en tenslotte de broeken en velden in de lage delen van de Vallei, ontgonnen werden tot bouwgrond en grasland." ],
        [ sgpl:refersToConcept unesco:concept3457 ;
            sgpl:subjectText "Pluimveeteelt" ;
            sgpl:text_context "Een typisch verschijnsel in de Gelderse Vallei, dat in nauw en direct verband staat met de opkomst van talrijke kleine bedrijfjes door kolonisatie en door splitsing van bestaande boerderijen, is de kippenhouderij, die, evenals de gehele agrarische structuur, sinds het eind der vorige eeuw een geweldige ontwikkeling doorgemaakt heeft. Zo men dit verband voorbijgaat en de opkomst en groei van de pluimveeteelt niet plaatst in een historische context, dan is men daarover spoedig uitgepraat; als vanzelf echter leidde het onderzoek naar de historische kippenhouderij in de Vallei tot een onderzoek naar het ontstaan van de kleine keuterbedrijfjes, terwijl dit laatste op zijn beurt weer aanleiding gaf om dieper te gaan graven naar de historisch-demografische ontwikkeling in de Gelderse Vallei-, waarmee de oorspronkelijke opzet (de historische kippenhouderij) eigenlijk werd overschreden. In hoofdstuk II wordt de pluimveeteelt in de Vallei zo mogelijk ab ovo verteld, waarbij blijkt dat de kippenhouderij in vroeger eeuwen niet zonder betekenis was; weliswaar is de omvang toen nooit groot geweest- niet te vergelijken met wat we in de 20-e eeuw zien-, maar toch moet de kippenhouderij een bepaalde functie hebben gehad, immers komt men herhaaldelijk de opmerkelijke bepaling tegen dat tijnsen, pachten en tienden betaald moeten of mogen worden in de vorm van hoenders of eieren." ],
        [ sgpl:refersToConcept unesco:concept9673 ;
            sgpl:subjectText "Kleinbedrijf" ;
            sgpl:text_context "Waar kenmerken van uitgesproken physische aard, zoals heuvels of een rivier, afwezig zijn, moeten wij op een andere wijze trachten een grens te vinden, waarbinnen de Gelderse Vallei als een typisch gebied onderscheiden wordt van de buiten die grens gelegen gebieden, waarmee tegelijk het, tot een minimum gereduceerde, geografische adagium- 'hier dit, daar dat'- aan de orde is. Typisch voor de Gelderse Vallei is het bestaan van overwegend kleine boerenbedrijfjes met veeteelt en vooral kippenhouderij als voornaamste bedrijfstakken; eigenlijk is niet zozeer het bestaan, maar veeleer het ontstaan typerend en wel aan de rand van de bestaande bevolkingskernen- individuele boerderijen of dorpen-, aan de zoom van de reeds vroeger ontgonnen cultuur-arealen; de dynamiek van de bevolkingstoeneming leidde er toe, dat steeds nieuwe gebieden ontgonnen werden, of- wanneer cultivering van woeste gronden om bepaalde redenen werd tegengehouden- dat in de bestaande landbouw-bedrijven geïntensiveerd werd. Ofschoon het afgrenzen van de Vallei in het Noorden, in physisch-geografisch opzicht niet gelukt, toch mogen wij het morfologisch karakter van ons gebied niet negeren, immers is het merkwaardig om te zien hoe in de loop der eeuwen de occupatie zich voltrekt op een telkens lager liggend niveau, waardoor achtereenvolgens de hoge zandgronden op de helling der Vallei, de bosgronden, waarop de brink-nederzettingen en de engen kwamen te liggen, daarna de middelhoge, met 'woud' begroeide zandruggen, de horsten en donken, en tenslotte de broeken en velden in de lage delen van de Vallei, ontgonnen werden tot bouwgrond en grasland." ],
        [ sgpl:refersToConcept unesco:concept678 ;
            sgpl:subjectText "Occupatiegeschiedenis" ;
            sgpl:text_context "In de volgende hoofdstukken wordt ingegaan op de occupatie-geschiedenis van de Gelderse Vallei, waarin wij enkele fasen menen te kunnen ontdekken, zij het dat deze fasen niet erg duidelijk zijn te markeren. Toch lijkt het erop dat de eerste bewoningscentra op de hoge zandgronden, op de hellingen van de Vallei te vinden zijn en dat van daaruit in de middeleeuwen, in een volgende fase, de 'wouden' op de middelhoge zandgronden ontgonnen zijn, aldus een spreiding vanuit de hoger gelegen brink-nederzettingen naar het midden van de Vallei, naar het gebied der horsten, laren en donken. Rijk aan contrasten zijn de nederzettingen in de oude woonzone in de schaduw van het Moftbos tussen Wageningen en Lunteren en in het gebied der kampontginningen op het grillige patroon van de zandruggen (vgl. de Bodemkaart 1:100.000, waarop met zwarte stippen verschillende horst-, laar- en donk-namen zijn aangegeven)." ] ;
    sgpl:thesisID 29 .

sgpl:Thesis291 a sgpl:SGPLThesis ;
    dcterms:creator "Roger Raat" ;
    dcterms:issued 1994 ;
    dcterms:title "Bedrijvigheid in het landelijk gebied",
        "Een onderzoek naar de mogelijkheden van niet-agrarische bedrijfsvestiging in leegstaande en vrijkomende bebouwing in het landelijk gebied van de regio IJssel-Vecht." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "Noordwest-Overijssel" ;
            sgpl:text_context "Zo zijn de kleine kemen in het Stadsgewest Zwolle en de Randgemeenten goed bereikbaar via de hoofdinfrastructuur (A28, A50) en zijn ze nabij de grote bevolkingsconcentraties in Zwolle en Kampen gelegen. Het produktiemilieu in Noordwest-Overijssel wordt voor het grootste deel bepaald door de grote natuurlijke en landschappelijke waarden in het gebied. Dit biedt een gunstig woon- en werkklimaat voor ondernemers, die stedelijke centra als Wolvega/Heerenveen, Steenwijk, Meppel en Zwolle niet ver weg weten, maar stelt ook strengere (milieu-)eisen ten aanzien van het type bedrijvigheid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "regio Ussel-Vecht" ;
            sgpl:text_context "Deze WGR-gebieden kunnen gezien worden als verlengd lokaal bestuur, omdat primair vanuit de gemeente de regionale problematiek dient te worden aangepakt. Mede door mijn grote interesse in de Regionale Geografie was ik dan ook verheugd dat mij de mogelijkheid werd geboden stage te lopen bij de regio Ussel-Vecht te Zwolle. De regio Ussel-Vecht ligt in het noorden van de provincie Overijssel en bestaat naast het stedelijk knooppunt Zwolle voornamelijk uit landelijk gebied." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754858 ;
            sgpl:spatialText "gemeente Hardenberg" ;
            sgpl:text_context "Voor de periode 1996-1999 is een indicatieve jaarproduktie van ruim 2.200 woningen aangegeven, gebaseerd op verwachtingen van een zich stabiliserende bevolkingsomvang. In Noordoost-Overijssel loopt de woningbouw achter bij de raming, wat vooral veroorzaakt wordt door de geringe bouwproduktie van de gemeente Hardenberg. In Ommen en Gramsbergen wordt gebouwd boven de raming, terwijl Avereest een woningbouwproduktie volgens plan kent." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743477 ;
            sgpl:spatialText "Zwolle" ;
            sgpl:text_context "De regio Ussel-Vecht bestaat uit 19 gemeenten, waarvan er 18 in de provincie Overijssel zijn gelegen en één (Hattem) in Gelderland. Veruit de grootste stad in de regio is Zwolle met 98.318 inwoners, waar de tweede stad, Kampen, 32.571 inwoners telt. In deze grote en gediversificeerde regio zal het produktiemilieu belangrijke verschillen vertonen tussen de gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Dit onderzoek vormt een onderdeel van de specialisatie Bestuursgeografie binnen de studie Sociale Geografie. Naast het opdoen van theoretische kennis met betrekking tot met name het lokale bestuur in Nederland, vormt een zeer belangrijk onderdeel van de specialisatie Bestuursgeografie het lopen van een stage bij het lokale bestuur. Het komt echter ook wel voor dat stage wordt gelopen bij het regionale bestuur, met name bij de regionale samenwerkingsverbanden van gemeenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743477 ;
            sgpl:spatialText "Stadsgewest Zwolle" ;
            sgpl:text_context "Voor het landelijk gebied in de deelgebieden Stadsgewest Zwolle, Randgemeenten, Noordwest-Overijssel en Noordoost-Overijssel is bekeken welke mogelijkheden hun produktiemilieu biedt voor de vestiging van bedrijven. De kleine kemen hebben gemeen dat ze een gering draagvlak bieden voor bedrijven, een relatief laag aandeel (hooggeschoolde) jongeren huisvesten en een eenzijdige produktiestructuur kennen. Toch bestaan er wel verschillen in het produktiemilieu van de kleine kemen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "Noordoost-Overijssel" ;
            sgpl:text_context "Verder heeft dit deelgebied te maken met een sterk vergrijzende bevolking, mede door het vertrek van jongeren. Noordoost-Overijssel ligt verder weg van de hoofdinfrastructuur en kent geen grote bevolkingsconcentraties. Alhoewel het gebied een negatief migratiesaldo kent, is er toch een bevolkingsgroei, dankzij de hoge geboortencijfers." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "Leefbaarheid" ;
            sgpl:text_context "Juist in het landelijk gebied doen zich problemen met de leefbaarheid voor. Een mogelijkheid om de leefbaarheid te vergroten is het scheppen van meer werkgelegenheid in het landelijk gebied. De werkgelegenheid in het landelijk gebied loopt vooral in de landbouw sterk terug." ],
        [ sgpl:refersToConcept unesco:concept1714 ;
            sgpl:subjectText "Niet-agrarische bedrijvigheid" ;
            sgpl:text_context "Tot slot wens ik de lezer veel succes toe in het doornemen van dit rapport. Hij of zij zal snel tot de conclusie komen dat niet-agrarische bedrijvigheid in het landelijk gebied een zeer interessant, divers en wellicht controversieel onderwerp is, waarvan dit rapport slechts een klein stukje kan raken. Het laatste woord over dit onderwerp zal dan ook zeker nog niet geschreven zijn, integendeel, ik verwacht dat er steeds meer over zal worden geschreven en gesproken." ],
        [ sgpl:refersToConcept unesco:concept1741 ;
            sgpl:subjectText "Vrijkomende agrarische bebouwing" ;
            sgpl:text_context "Door schaalvergroting en toenemende regelgeving zijn steeds meer boeren gedwongen hun bedrijf op te geven. Bij de regio Ussel-Vecht ontstond daarom het idee om te onderzoeken in hoeverre de bij dit proces vrijkomende agrarische bebouwing is te gebruiken ten behoeve van andere bedrijfsmatige functies. Dit zou een positief effect hebben op de hoeveelheid en de diversiviteit van de werkgelegenheid in het landelijk gebied." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "Leefbaarheid" ;
            sgpl:text_context "Juist in het landelijk gebied doen zich problemen met de leefbaarheid voor. Een mogelijkheid om de leefbaarheid te vergroten is het scheppen van meer werkgelegenheid in het landelijk gebied. De werkgelegenheid in het landelijk gebied loopt vooral in de landbouw sterk terug." ],
        [ sgpl:refersToConcept unesco:concept1741 ;
            sgpl:subjectText "Vrijkomende agrarische bebouwing" ;
            sgpl:text_context "Door schaalvergroting en toenemende regelgeving zijn steeds meer boeren gedwongen hun bedrijf op te geven. Bij de regio Ussel-Vecht ontstond daarom het idee om te onderzoeken in hoeverre de bij dit proces vrijkomende agrarische bebouwing is te gebruiken ten behoeve van andere bedrijfsmatige functies. Dit zou een positief effect hebben op de hoeveelheid en de diversiviteit van de werkgelegenheid in het landelijk gebied." ],
        [ sgpl:refersToConcept unesco:concept1714 ;
            sgpl:subjectText "Niet-agrarische bedrijvigheid" ;
            sgpl:text_context "Tot slot wens ik de lezer veel succes toe in het doornemen van dit rapport. Hij of zij zal snel tot de conclusie komen dat niet-agrarische bedrijvigheid in het landelijk gebied een zeer interessant, divers en wellicht controversieel onderwerp is, waarvan dit rapport slechts een klein stukje kan raken. Het laatste woord over dit onderwerp zal dan ook zeker nog niet geschreven zijn, integendeel, ik verwacht dat er steeds meer over zal worden geschreven en gesproken." ] ;
    sgpl:thesisID 291 .

sgpl:Thesis293 a sgpl:SGPLThesis ;
    dcterms:creator "Harmen Smit" ;
    dcterms:issued 1994 ;
    dcterms:title "Een onderzoek naar de omvang van de problematiek van de de wijk- en buurtwinkelcentra en het gemeentelijk detailhandelsbeleid in Nederland.",
        "WIJK- EN BUURTWINKELCENTRA IN DE KNEL" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Gemeentelijk beleid met betrekking tot de detailhandel bleek meer dan ooit nodig, en niet alleen in Den Haag maar ook in andere Nederlandse gemeenten. Van zowel de gemeente Den Haag als Utrecht was bekend dat zij zochten naar oplossingen voor de in problemen geraakte winkelstructuur. Via beleidsstukken, waarvan de detailhandelsnota de kem vormde, gaven zij aan welke weg hun detailhandelsstructuur op zou moeten gaan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Haarlem" ;
            sgpl:text_context "Per wijk/buurtcentrum is aan gege- ven welke levensverwachting het centrum heeft, a.dh.v. enkele para- meters, waaronder ligging, aanbod, leegstand etc. (8) HAARLEM DOELSTELLING NADERE UITWERKING Het zo optimaal laten Dit houdt in: het in stand houden functioneren van de detail- van een bepaald voerzieaingenni- handeL veau, voor zowel een goed leskli- maat als een goede bereikbaarheid voor de minder mobielen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Van zowel de gemeente Den Haag als Utrecht was bekend dat zij zochten naar oplossingen voor de in problemen geraakte winkelstructuur. Via beleidsstukken, waarvan de detailhandelsnota de kem vormde, gaven zij aan welke weg hun detailhandelsstructuur op zou moeten gaan. Of ook Amsterdam, Rotterdam en andere (middelgrote gemeenten bezig waren met de problematiek van de wijk- en buurtwinkelcentra was niet duidelijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Via beleidsstukken, waarvan de detailhandelsnota de kem vormde, gaven zij aan welke weg hun detailhandelsstructuur op zou moeten gaan. Of ook Amsterdam, Rotterdam en andere (middelgrote gemeenten bezig waren met de problematiek van de wijk- en buurtwinkelcentra was niet duidelijk. Verder was het ook onduidelijk wat ‘detailhandelsbeleid’ precies inhield, met andere woorden: hoe dachten de gemeenten de problemen met betrekking tot de winkelstructuur, en dan met name de wijk- en buurtwinkelcentra, op te lossen?" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "De indeling van de buurtwinkelcentra door Rotterdam, Den Haag (zuidwest), Utrecht en Maastricht is weergegeven in tabel 4.2. Het beoordelen van de winkelcentra vindt plaats op grond van een aantal parameters, zoals de ligging van het centrum in het verzorgingsgebied, de bevolking, het aanbod in de foodsector, de omvang van de winkelfunctie, de leegstand, de bereikbaarheid, de parkeergelegenheid, visuele aspecten en de ligging van het centrum binnen de winkelstructuur. Deze beoordeling leidt in de gemeenten Rotterdam, Den Haag (Zuidwest), Utrecht en Maastricht tot een duidelijke classificatie van de centra." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "s-Gravenhage Zuid-West" ;
            sgpl:text_context "Midden 1986 kwam het rapport “Winkelstructuur ‘s-Gravenhage Zuid-West” (Kok, 1986) uit. Dit rapport ging in op de ontwikkeling van de winkelcentra in het zuidwestelijke stadsdeel van Den Haag. De belangrijkste conclusie van het rapport was dat van de 28 winkelcentra er slechts tien levensvatbaar waren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Herstructurering, en in sommige gevallen zelfs sanering van de winkel structuur bleek noodzakelijk te zijn. Gemeentelijk beleid met betrekking tot de detailhandel bleek meer dan ooit nodig, en niet alleen in Den Haag maar ook in andere Nederlandse gemeenten. Sinds de jaren ’60 heeft een aantal maatschappelijke veranderingen ertoe geleid dat het draagvlak voor vele wijk- en buurtwinkelcentra afnam, met als gevolg een steeds marginaler functioneren van deze centra." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Stadsdeel Geuzenveld/Slotermeer" ;
            sgpl:text_context "In Geuzenveld: 1 wijkw.c. enl buurtw.c.; In Slotermeer: 1 stadsdeelcentrum en 3 buurtwinkelcentra. (2) AMSTERDAM, STADSDEEL GEUZENVELD/SLOTERMEER DOELSTELLING NADERE UITWERKING Het zodanig realiseren De weergave van dit beleid wordt v.e. winkelgebied, waar- gedaan a.dh.v. een Ruimtelijk bij een evenwichtige en Economische Structuur (RES). Hierin worden concentratie-, con- duurzame winkelstructuur ont staat. solidatie- en ontmoedigingsgebie- den onderscheiden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Stadsdeel Buitenveldert" ;
            sgpl:text_context "In de eerste instantie ging mijn voorkeur uit naar een meer planologisch gericht onderzoek, maar na wat gesprekken met een aantal mensen ben ik toch teruggekeerd bij mijn eerste liefde, de detailhandel. (1) AMSTERDAM, STADSDEEL buitenveldert nadere uitwerking Het zorg dragen voor een samcohangcnde visie op hel economisch beleid m.b.t. de winkelvoorzie- ning. Hel verbeteren vd situatie van buurtwinkelcentra die naar ver- wachting goede economische per- spectieven bieden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Via beleidsstukken, waarvan de detailhandelsnota de kem vormde, gaven zij aan welke weg hun detailhandelsstructuur op zou moeten gaan. Of ook Amsterdam, Rotterdam en andere (middelgrote gemeenten bezig waren met de problematiek van de wijk- en buurtwinkelcentra was niet duidelijk. Verder was het ook onduidelijk wat ‘detailhandelsbeleid’ precies inhield, met andere woorden: hoe dachten de gemeenten de problemen met betrekking tot de winkelstructuur, en dan met name de wijk- en buurtwinkelcentra, op te lossen?" ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1499 ;
            sgpl:subjectText "wijk- en buurtwinkelcentra" ;
            sgpl:text_context "Alhoewel de conclusies later wat zijn afgezwakt, gaf het rapport aan dat de na-oorlogse winkel structuur grote problemen kende. Sinds de jaren ’60 heeft een aantal maatschappelijke veranderingen ertoe geleid dat het draagvlak voor vele wijk- en buurtwinkelcentra afnam, met als gevolg een steeds marginaler functioneren van deze centra. Deze teruggang werd zichtbaar door toenemende leegstand van winkelpanden, een afname van het aantal non-food zaken, een toename in zakelijke dienstverlening (een niet-winkelfiinctie) en, in het ergste geval, zelfs algehele verpaupering." ],
        [ sgpl:refersToConcept unesco:concept5706 ;
            sgpl:subjectText "gemeentelijk detailhandelsbeleid" ;
            sgpl:text_context "Gemeentelijk beleid met betrekking tot de detailhandel bleek meer dan ooit nodig, en niet alleen in Den Haag maar ook in andere Nederlandse gemeenten. In dit rapport wordt een overzicht gegeven van de aard en omvang van de problematiek van wijk- en buurtwinkelcentra en het gemeentelijk detailhandelsbeleid. In de eerste fase is onderzocht in hoeverre gemeenten problemen hebben met hun wijk- en buurtwinkelcentra, en of zij, als mogelijke reactie daarop, een detailhandelsbeleid hebben geformuleerd." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "herstructurering en sanering" ;
            sgpl:text_context "Deze teruggang werd zichtbaar door toenemende leegstand van winkelpanden, een afname van het aantal non-food zaken, een toename in zakelijke dienstverlening (een niet-winkelfiinctie) en, in het ergste geval, zelfs algehele verpaupering. De laatste tien jaar hebben vele gemeenten zich gerealiseerd dat deze negatieve ontwikkeling een halt toegeroepen moest worden: zij ontwikkelden daarom detailhandelsbeleid, waarin herstructurering, en in veel gevallen ook sanering van de winkel structuur op vooral het wijk- en buurtniveau vorm werd gegeven. Van zowel de gemeente Den Haag als Utrecht was bekend dat zij zochten naar oplossingen voor de in problemen geraakte winkelstructuur." ],
        [ sgpl:refersToConcept unesco:concept5706 ;
            sgpl:subjectText "gemeentelijk detailhandelsbeleid" ;
            sgpl:text_context "Gemeentelijk beleid met betrekking tot de detailhandel bleek meer dan ooit nodig, en niet alleen in Den Haag maar ook in andere Nederlandse gemeenten. In dit rapport wordt een overzicht gegeven van de aard en omvang van de problematiek van wijk- en buurtwinkelcentra en het gemeentelijk detailhandelsbeleid. In de eerste fase is onderzocht in hoeverre gemeenten problemen hebben met hun wijk- en buurtwinkelcentra, en of zij, als mogelijke reactie daarop, een detailhandelsbeleid hebben geformuleerd." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "herstructurering en sanering" ;
            sgpl:text_context "Deze teruggang werd zichtbaar door toenemende leegstand van winkelpanden, een afname van het aantal non-food zaken, een toename in zakelijke dienstverlening (een niet-winkelfiinctie) en, in het ergste geval, zelfs algehele verpaupering. De laatste tien jaar hebben vele gemeenten zich gerealiseerd dat deze negatieve ontwikkeling een halt toegeroepen moest worden: zij ontwikkelden daarom detailhandelsbeleid, waarin herstructurering, en in veel gevallen ook sanering van de winkel structuur op vooral het wijk- en buurtniveau vorm werd gegeven. Van zowel de gemeente Den Haag als Utrecht was bekend dat zij zochten naar oplossingen voor de in problemen geraakte winkelstructuur." ],
        [ sgpl:refersToConcept unesco:concept1499 ;
            sgpl:subjectText "wijk- en buurtwinkelcentra" ;
            sgpl:text_context "Alhoewel de conclusies later wat zijn afgezwakt, gaf het rapport aan dat de na-oorlogse winkel structuur grote problemen kende. Sinds de jaren ’60 heeft een aantal maatschappelijke veranderingen ertoe geleid dat het draagvlak voor vele wijk- en buurtwinkelcentra afnam, met als gevolg een steeds marginaler functioneren van deze centra. Deze teruggang werd zichtbaar door toenemende leegstand van winkelpanden, een afname van het aantal non-food zaken, een toename in zakelijke dienstverlening (een niet-winkelfiinctie) en, in het ergste geval, zelfs algehele verpaupering." ] ;
    sgpl:thesisID 293 .

sgpl:Thesis294 a sgpl:SGPLThesis ;
    dcterms:creator "Ian van Deijck" ;
    dcterms:issued 1994 ;
    dcterms:title "DE CHEMISCHE INDUSTRIE ALS KATALYSATOR VAN DE NEDERLANDSE ECONOMIE ?",
        "GROTE NEDERLANDSE CHEMIE-ONDERNEMINGEN IN INTERNATIONALE CONTEXT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279858 ;
            sgpl:spatialText "de Rijnmond" ;
            sgpl:text_context "In deze conclusie zal getracht worden antwoord te geven op de in dit hoofdstuk geformuleerde onderzoeksvragen. Veruit de grootste concentratie van chemiebedrijven in Nederland is te vinden in Rotterdam / de Rijnmond (waartoe in dit geval ook Dordrecht en Moerdijk gerekend worden). Deze regio heeft voor raffinaderijen en chemiebedrijven een aantal belangrijke voordelen, die voor veel internationale ondernemingen een reden zijn geweest om zich hier te vestigen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Zuid-Limburg" ;
            sgpl:text_context "DSM is de kleinste en minst geïnternationaliseerde MNO van de drie, en zal daar op eigen gelegenheid weinig verandering in kunnen brengen door een gebrek aan financiële middelen. De regio Zuid-Limburg overheerst toch sterk binnen DSM's lokatiepatroon. Dit in tegenstelling tot Akzo's meer gelijkmatige spreiding van vestigingen over Nederland, met slechts een lichte oververtegenwoordiging van vestigingen in het oosten van het land." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Er wordt gezocht naar lokaties en activiteitenpatronen met een optimaal voordeel voor de concurrentiepositie. De probleemstelling die centraal staat in dit onderzoek is in welke zin de voortgaande internationalisering in de chemie-sector gevolgen heeft voor de bijdrage van deze sector aan de werkgelegenheidsontwikkeling en de economische groei in Nederland en aan die in de verschillende vestigingsregio's binnen Nederland in het bijzonder? Aan de hand van de probleemstelling zijn een aantal onderzoeksvragen geformuleerd:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "Daarmee verwachten wij een relatie te kunnen leggen met de kansen en de bedreigingen waaraan de vestigingsmilieus van de regio's in Nederland onderworpen zijn. Het gedrag van grote ondernemingen ten aanzien van hun activiteiten in bepaalde regio's vormt namelijk een belangrijk element van de toenemende internationale competitie tussen regio's in West-Europa. Dit is de aanleiding van een onderzoeksprogramma, dat INRO-TNO in samenwerking met de Faculteit Ruimtelijke Wetenschappen van de Universiteit Utrecht uitvoert." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Midden- en Oost-Europa" ;
            sgpl:text_context "Ik nodig u van harte uit de informatie uit het rapport, dat verrassende inzichten biedt, tot u te nemen. De verwachting is dat de internationale economische ontwikkelingen, zoals de verdere integratie en uitbreiding van de Europese Gemeenschap en de ontwikkeling van Midden- en Oost-Europa, in het lopende decennium van grote invloed blijven op de strategie van de grootste Nederlandse ondernemingen, zoals dit reeds sedert het einde van de jaren tachtig het geval is. Aan deze strategieën zijn vele aspecten verbonden, waarvan onze interesse met name uitgaat naar de ontwikkelingen in de aard, omvang en lokaties van de activiteiten van de grootste ondernemingen binnen Nederland zelf." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4994 ;
            sgpl:subjectText "Chemische industrie" ;
            sgpl:text_context "Zonder chemie zou onze hedendaagse wereld niet zijn wat ze nu is. De economische betekenis van de chemische industrie is groot: niet voor niets wordt zij 'the industry of industries' genoemd, omdat zoveel andere bedrijfstakken produkten, voortgebracht door de chemische industrie, nodig hebben. Het kan in een aanzienlijke mate economische processen in andere sectoren stimuleren; met andere woorden dienen als katalysator van de Nederlandse economie." ],
        [ sgpl:refersToConcept unesco:mt7.35 ;
            sgpl:subjectText "Lokatiepatroon" ;
            sgpl:text_context "Door het formuleren van een ondernemingsstrategie reageert een onderneming op ontwikkelingen en tendensen uit de omgeving en de concurrentiepositie die zij binnen de sector inneemt. De ondernemingsstrategie staat aan de basis van veranderingen in de organisatiestructuur en het lokatiepatroon. In het conceptueel model (fig.1.1) zijn deze te onderzoeken relaties weergegeven door middel van de dichte lijnen tussen de genoemde elementen waarop dit onderzoek zich richt." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "Ondernemingsstrategie" ;
            sgpl:text_context "Bij deze benadering zal de onderneming centraal staan. Door het formuleren van een ondernemingsstrategie reageert een onderneming op ontwikkelingen en tendensen uit de omgeving en de concurrentiepositie die zij binnen de sector inneemt. De ondernemingsstrategie staat aan de basis van veranderingen in de organisatiestructuur en het lokatiepatroon." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "Ondernemingsstrategie" ;
            sgpl:text_context "Bij deze benadering zal de onderneming centraal staan. Door het formuleren van een ondernemingsstrategie reageert een onderneming op ontwikkelingen en tendensen uit de omgeving en de concurrentiepositie die zij binnen de sector inneemt. De ondernemingsstrategie staat aan de basis van veranderingen in de organisatiestructuur en het lokatiepatroon." ],
        [ sgpl:refersToConcept unesco:concept4994 ;
            sgpl:subjectText "Chemische industrie" ;
            sgpl:text_context "Zonder chemie zou onze hedendaagse wereld niet zijn wat ze nu is. De economische betekenis van de chemische industrie is groot: niet voor niets wordt zij 'the industry of industries' genoemd, omdat zoveel andere bedrijfstakken produkten, voortgebracht door de chemische industrie, nodig hebben. Het kan in een aanzienlijke mate economische processen in andere sectoren stimuleren; met andere woorden dienen als katalysator van de Nederlandse economie." ],
        [ sgpl:refersToConcept unesco:mt7.35 ;
            sgpl:subjectText "Lokatiepatroon" ;
            sgpl:text_context "Door het formuleren van een ondernemingsstrategie reageert een onderneming op ontwikkelingen en tendensen uit de omgeving en de concurrentiepositie die zij binnen de sector inneemt. De ondernemingsstrategie staat aan de basis van veranderingen in de organisatiestructuur en het lokatiepatroon. In het conceptueel model (fig.1.1) zijn deze te onderzoeken relaties weergegeven door middel van de dichte lijnen tussen de genoemde elementen waarop dit onderzoek zich richt." ] ;
    sgpl:thesisID 294 .

sgpl:Thesis295 a sgpl:SGPLThesis ;
    dcterms:creator "Ton Hummel" ;
    dcterms:issued 1994 ;
    dcterms:title "Een inventarisatie van verhuisvoornemens in de Rotterdamse stadsvernieuwingsbuurten Feyenoord en Oud Crooswijk",
        "VERHUISVOORNEMENS IN STADSVERNIEUWINGSGEBIEDEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "het Oude Noorden" ;
            sgpl:text_context "Zo bleken uit onderzoek in de rotterdamse stadsvernieuwingsbuurten het Oude Noorden en Hillesluis (Bergsma, R.J., 1992, pag. 27) de volgende verhuisredenen: - gedwongen verhuizing 41%; - ontevreden over woning 21%; - ontevreden over woonomgeving 8 %. Het grote aandeel gedwongen verhuizingen is hier het gevolg van de stadsvernieuwingsactiviteiten. In tegenstelling tot wat bij de formulering van de hypothesen werd verwacht, vormt de verandering van de huishoudenssamenstelling niet de belangrijkste verhuisreden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743698 ;
            sgpl:spatialText "provincie Zuid-Holland" ;
            sgpl:text_context "Naar een woning in de regio Rijnmond, maar niet in Rotterdam. Naar een woning in de provincie Zuid-Holland, maar niet in de regio Rijnmond. Naar een woning elders in het land, maar niet in Zuid-Holland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Oud Crooswijk" ;
            sgpl:text_context "Het onderzoek is uitgevoerd onder de huishoudens in nieuwbouwwoningen in twee verschillende stadsvernieuwingsgebieden in Rotterdam, te weten Feyenoord en Oud Crooswijk. Er is voor deze buurten gekozen, omdat zowel de omvang van de buurten (aantal woningen en aantal inwoners) als het aandeel nieuwbouwwoningen in het totale woningbestand redelijk dicht bij elkaar lagen. Daarnaast behoren beide stadsvernieuwingsbuurten tot de eerste generatie stadsvernieuwingsgebieden in Rotterdam, hetgeen betekent dat in beide buurten de stadsvernieuwingsactiviteiten al geruime tijd geleden zijn voltooid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "wijk Crooswijk" ;
            sgpl:text_context "In een studie naar de effecten van stadsvernieuwing in de rotterdamse wijk Crooswijk (Smit, V. en K. Noort, 1986) bleek een groot deel van de oorspronkelijke bewoners zelfs al voor het gereedkomen van de wijk te zijn verhuisd naar een andere wijk. Ook binnen de gemeente Rotterdam is de vraag gerezen in hoeverre de oorspronkelijke buurtbewoners na het gereedkomen van de stadsvernieuwing in de buurt zijn blijven wonen. Het vermoeden bestaat dat een groot deel van de oorspronkelijke bewoners toch slechts tijdelijk in de vernieuwde wijk blijft wonen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "In de eerste jaren na de tweede wereldoorlog is de ruimtelijke ordening in Rotterdam sterk gericht geweest op de wederopbouw van de havens en het centrum van de stad. Daarnaast wordt in deze periode een begin gemaakt met de ontwikkeling van een aantal grote uitbreidingsgebieden. De gemeentelijke aandacht voor behoud en herstel van de laat 19e eeuwse en vroeg 20e eeuwse woonwijken is in deze jaren in het algemeen gering." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Hillesluis" ;
            sgpl:text_context "Zo bleken uit onderzoek in de rotterdamse stadsvernieuwingsbuurten het Oude Noorden en Hillesluis (Bergsma, R.J., 1992, pag. 27) de volgende verhuisredenen: - gedwongen verhuizing 41%; - ontevreden over woning 21%; - ontevreden over woonomgeving 8 %. Het grote aandeel gedwongen verhuizingen is hier het gevolg van de stadsvernieuwingsactiviteiten. In tegenstelling tot wat bij de formulering van de hypothesen werd verwacht, vormt de verandering van de huishoudenssamenstelling niet de belangrijkste verhuisreden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Feyenoord" ;
            sgpl:text_context "Het onderzoek is uitgevoerd onder de huishoudens in nieuwbouwwoningen in twee verschillende stadsvernieuwingsgebieden in Rotterdam, te weten Feyenoord en Oud Crooswijk. Er is voor deze buurten gekozen, omdat zowel de omvang van de buurten (aantal woningen en aantal inwoners) als het aandeel nieuwbouwwoningen in het totale woningbestand redelijk dicht bij elkaar lagen. Daarnaast behoren beide stadsvernieuwingsbuurten tot de eerste generatie stadsvernieuwingsgebieden in Rotterdam, hetgeen betekent dat in beide buurten de stadsvernieuwingsactiviteiten al geruime tijd geleden zijn voltooid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749945 ;
            sgpl:spatialText "Noordereiland" ;
            sgpl:text_context "De 19e eeuwse arbeidersbuurt Feyenoord-Noordereiland behoort tot de eerste generatie stadsvernieuwingsbuurten in Rotterdam. Met de ontwikkeling van het gebied is gestart in 1874 en werd een opvang gecreëerd voor de zich uitbreidende scheepvaart- en havenactiviteiten en de daarmee samenhangende trek naar de stad. Ten westen van de in 1876 aangelegde spoorweg naar Breda werd een havengebied ontwikkeld; aan de oostelijke zijde van deze spoorlijn werd voornamelijk industrie gevestigd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "regio Groot Rijnmond" ;
            sgpl:text_context "In het WoningBehoeftenOnderzoek 1989/1990 van het CBS (CBS, 1991, pag. 72) wordt voor de regio Groot Rijnmond aangegeven dat 60,7% van de huishoudens geen verhuisplannen heeft. Hoewel cijfers voor de gemeente Rotterdam afzonderlijk ontbreken, kan na vergelijking met de gemiddelde waarden voor Groot Rijnmond geconcludeerd worden dat het aandeel huishoudens zonder verhuisvoornemens in de bestudeerde buurten relatief klein te noemen is. Dit relatief kleine aandeel huishoudens zonder verhuisvoornemens blijkt zowel in Feyenoord (44,1% heeft geen verhuisplannen) als in Oud Crooswijk (47,1% heeft geen verhuisplannen)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Het onderzoek is uitgevoerd in de periode 1993-1994 en vormt als deel van het doctoraalexamen de afronding van mijn studie sociale geografie, specialisatie stads- en plattelandsgeografie, aan de Rijksuniversiteit Utrecht. Een aantal personen heeft mij bij de uitvoering van dit afstudeeronderzoek bijgestaan met advies en medewerking aan het onderzoek, waarvoor ik hen vanaf deze plaats hartelijk wil bedanken. In de eerste plaats wil ik mevrouw Anita ter Welle bedanken voor de opbouwende ondersteuning die zij mij als afstudeerbegeleidster heeft gegeven." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5303 ;
            sgpl:subjectText "Verhuisvoornemens" ;
            sgpl:text_context "6.3. Huishoudenskarakteristieken als verklaring voor verhuisgeneigdheid. Het wel of niet hebben van verhuisvoornemens blijkt met een aantal huishoudenskarakteristieken te correleren. De sterkste correlatie blijkt hierbij met de leeftijd van de respondent (in het onderzoek het hoofd van het huishouden) en met de leeftijd van de partner van de respondent." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Bouwen voor de buurt" ;
            sgpl:text_context "Pas dan kan worden vastgesteld in hoeverre de reputatie van de buurt als aanleiding voor een voorgenomen vertrek geldt (zie deel probleemstelling 7 en 8). Met name bij stadsvernieuwing in de eersterings gebieden in Rotterdam is het principe van \"bouwen voor de buurt\" gehanteerd. Dit betekent dat binnen stadsvernieuwingsbuurten de uitvoering en toewijzing primair werd gericht op de bewoners die vóór de stadsvernieuwing in de buurt woonden (\"oorspronkelijke buurtbewoners\")." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Een cruciaal omslagpunt is de vorming van het nieuwe programcollege in 1974. Sinds dat jaar heeft stadsvernieuwing de hoogste prioriteit in het gemeentebeleid. Dit beleid was gebaseerd op de volgende uitgangspunten: 1. Behoud van de woonfunctie van de aangegeven stadsvernieuwingsgebieden via een werkwijze van geleidelijke en gefaseerde aanpak." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Bouwen voor de buurt" ;
            sgpl:text_context "Pas dan kan worden vastgesteld in hoeverre de reputatie van de buurt als aanleiding voor een voorgenomen vertrek geldt (zie deel probleemstelling 7 en 8). Met name bij stadsvernieuwing in de eersterings gebieden in Rotterdam is het principe van \"bouwen voor de buurt\" gehanteerd. Dit betekent dat binnen stadsvernieuwingsbuurten de uitvoering en toewijzing primair werd gericht op de bewoners die vóór de stadsvernieuwing in de buurt woonden (\"oorspronkelijke buurtbewoners\")." ],
        [ sgpl:refersToConcept unesco:concept5303 ;
            sgpl:subjectText "Verhuisvoornemens" ;
            sgpl:text_context "6.3. Huishoudenskarakteristieken als verklaring voor verhuisgeneigdheid. Het wel of niet hebben van verhuisvoornemens blijkt met een aantal huishoudenskarakteristieken te correleren. De sterkste correlatie blijkt hierbij met de leeftijd van de respondent (in het onderzoek het hoofd van het huishouden) en met de leeftijd van de partner van de respondent." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Een cruciaal omslagpunt is de vorming van het nieuwe programcollege in 1974. Sinds dat jaar heeft stadsvernieuwing de hoogste prioriteit in het gemeentebeleid. Dit beleid was gebaseerd op de volgende uitgangspunten: 1. Behoud van de woonfunctie van de aangegeven stadsvernieuwingsgebieden via een werkwijze van geleidelijke en gefaseerde aanpak." ] ;
    sgpl:thesisID 295 .

sgpl:Thesis296 a sgpl:SGPLThesis ;
    dcterms:creator "Martijn W. Haan",
        "Remko V. Bak" ;
    dcterms:issued 1995 ;
    dcterms:title "De regio Potsdam: Ontwikkelingen in de ruimtelijke geleding van een bijzondere ommelandregio van Berlijn" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2852458 ;
            sgpl:spatialText "noordoostelijke deel van de Regio Potsdam" ;
            sgpl:text_context "Voor Teltow en het overige noordoostelijke deel van de Regio Potsdam was de ontwikkeling van het waterwegennet de grote stimulans achter de industriële ontwikkeling. Tussen 1901 en 1906 werd het Teltowkanaal gegraven, waardoor de vaarweg naar Berlijn aanzienlijk werd verkort en de ontwikkeling van het gebied werd ingeleid. De aan het kanaal gelegen gemeenten -Teltow, Stahnsdorf en Kleinmachnow- werden pas na 1900 in het Vorortsverkeersnet opgenomen, maar konden omdat ze grensden aan Berlijn toch aanzienlijk groeien." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2938124 ;
            sgpl:spatialText "Golm" ;
            sgpl:text_context "Waarom we er voor kozen wisten we op dat moment nog niet, dat het een gouden keus was bleek achteraf wel. Zeker toen we samen op onze kamer op de campus van de Universiteit van Potsdam in Golm zaten. De regio Potsdam bleek een werkelijk geweldig mooi gebied te zijn met mooie oude historische gebouwen en paleizen, zeer schone parken en uiterst spannende vervallen kazemeterreinen die uit een nog niet ge- schreven jongensboek leken te komen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2852458 ;
            sgpl:spatialText "Stadt- en Landkreis Potsdam" ;
            sgpl:text_context "1.2.1 Regiokeuze en afgrenzing. Het in dit onderzoek behandelde gebied, de regio Potsdam, bestaat uit het gebied van de Stadt- en Landkreis Potsdam, die tot eind 1993 bestaan hebben (zie figuur 1.1). De regio Potsdam grenst in het noordoosten direct aan (West)- Berlijn en is als zodanig een onderdeel van het ommeland waarvoor in de verschillende perioden de invloed van (West)- Berlijn sterk verschillend was." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2852456 ;
            sgpl:spatialText "Landkreis Potsdam-Mittelmark" ;
            sgpl:text_context "De regio Potsdam bestaat uit 60 gemeenten, die wat inwonertal betreft variëren van net boven de 100 in Schape tot meer dan 15.000 in Teltow (zie figuur 1.2). Potsdam Land is op zes december 1993 overgegaan in de grotere Landkreis Potsdam-Mittelmark. De grootte van de regio is zo gekozen dat de ruimere context in beschouwing kan worden genomen en ook de verschillende invloeden en ontwikkelingen binnen de regio kunnen worden bekeken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2852458 ;
            sgpl:spatialText "de regio Potsdam" ;
            sgpl:text_context "Het in dit onderzoek behandelde gebied, de regio Potsdam, bestaat uit het gebied van de Stadt- en Landkreis Potsdam, die tot eind 1993 bestaan hebben (zie figuur 1.1). De regio Potsdam grenst in het noordoosten direct aan (West)- Berlijn en is als zodanig een onderdeel van het ommeland waarvoor in de verschillende perioden de invloed van (West)- Berlijn sterk verschillend was. De regio is onder te verdelen in twee deelgebieden, namelijk de Stadtkreis en de Landkreis Potsdam." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2823568 ;
            sgpl:spatialText "Teltow" ;
            sgpl:text_context "De regio Potsdam bestaat uit 60 gemeenten, die wat inwonertal betreft variëren van net boven de 100 in Schape tot meer dan 15.000 in Teltow (zie figuur 1.2). Potsdam Land is op zes december 1993 overgegaan in de grotere Landkreis Potsdam-Mittelmark. De grootte van de regio is zo gekozen dat de ruimere context in beschouwing kan worden genomen en ook de verschillende invloeden en ontwikkelingen binnen de regio kunnen worden bekeken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2908638 ;
            sgpl:spatialText "Havellandse fruitbouwgebied" ;
            sgpl:text_context "Tabel 5.3: De belangrijkste fruit- en groenteproducenten in het Havellandse fruitbouwgebied. De schaalvergroting in de landbouw kwam al eerder tot uitdrukking in het streven naar grotere aaneengesloten vlakken met hetzelfde gewas. Eind vijftiger jaren werd in het Havellandische Obstbaugebiet al begonnen met deze vergroting van de arealen tot vaak boven de 50 ha." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2950159 ;
            sgpl:spatialText "West-Berlijn" ;
            sgpl:text_context "Wat voor Duitsland als geheel geldt, gaat ook op voor West-Berlijn en het ommeland van de stad. West-Berlijn verloor na de Wende eindelijk zijn eilandligging en was niet langer een enclave op oostduits grondgebied. De van oudsher bestaande relaties tussen Berlijn en zijn ommeland konden nu weer, zij het aarzelend, op gang komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2950159 ;
            sgpl:spatialText "Berlijn" ;
            sgpl:text_context "West-Berlijn verloor na de Wende eindelijk zijn eilandligging en was niet langer een enclave op oostduits grondgebied. De van oudsher bestaande relaties tussen Berlijn en zijn ommeland konden nu weer, zij het aarzelend, op gang komen. De onderlinge beïnvloeding van beide steden gaat in ieder geval terug tot de tijd van de Kurfürsten, die Potsdam hebben ontdekt als mooie residentie en de ruimtelijke geleding van het gebied tot nu toe hebben beïnvloed." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2950159 ;
            sgpl:spatialText "ommeland van Berlijn" ;
            sgpl:text_context "Wat voor Duitsland als geheel geldt, gaat ook op voor West-Berlijn en het ommeland van de stad. West-Berlijn verloor na de Wende eindelijk zijn eilandligging en was niet langer een enclave op oostduits grondgebied. De van oudsher bestaande relaties tussen Berlijn en zijn ommeland konden nu weer, zij het aarzelend, op gang komen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Suburbanisatie" ;
            sgpl:text_context "Het is zeer waarschijnlijk dat processen die een gevolg waren van de nabijheid van Berlijn en zich in het ommeland voordeden vóór de bouw van de muur nadien zijn gestopt. Een proces als suburbanisatie vanuit West-Berlijn werd door de bouw van de muur onmogelijk. In deze periode zijn, naar het zich laat aanzien, geheel andere processen verantwoordelijk voor de ontwikkeling van de regio en de veranderingen in de ruimtelijke geleding." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Urban field model" ;
            sgpl:text_context "Gelet op de ligging van Potsdam ten opzichte van Berlijn, lijkt het zinvol om te werken met een model dat de ontwikkelingen in een gebied verklaart aan de hand van de invloed van een nabijgelegen stedelijke agglomeratie. Het urban field model voldoet aan die voorwaarde. Dit model is ontwikkeld door Friedmann en Miller in 1965 en verder uitgewerkt door Lamb (1975) en Friedmann (1978)." ],
        [ sgpl:refersToConcept unesco:concept401 ;
            sgpl:subjectText "Ruimtelijke geleding" ;
            sgpl:text_context "De van oudsher bestaande relaties tussen Berlijn en zijn ommeland konden nu weer, zij het aarzelend, op gang komen. De onderlinge beïnvloeding van beide steden gaat in ieder geval terug tot de tijd van de Kurfürsten, die Potsdam hebben ontdekt als mooie residentie en de ruimtelijke geleding van het gebied tot nu toe hebben beïnvloed. De grens die was ontstaan na de feitelijke deling in 1949 was tot vlak voor de bouw van de Muur in 1961 nog tamelijk doorlatend en het is dus heel goed mogelijk dat de relaties tussen stad en ommeland in deze periode nog van invloed zijn geweest op de ruimtelijke geleding van de regio Potsdam." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Urban field model" ;
            sgpl:text_context "Gelet op de ligging van Potsdam ten opzichte van Berlijn, lijkt het zinvol om te werken met een model dat de ontwikkelingen in een gebied verklaart aan de hand van de invloed van een nabijgelegen stedelijke agglomeratie. Het urban field model voldoet aan die voorwaarde. Dit model is ontwikkeld door Friedmann en Miller in 1965 en verder uitgewerkt door Lamb (1975) en Friedmann (1978)." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Suburbanisatie" ;
            sgpl:text_context "Het is zeer waarschijnlijk dat processen die een gevolg waren van de nabijheid van Berlijn en zich in het ommeland voordeden vóór de bouw van de muur nadien zijn gestopt. Een proces als suburbanisatie vanuit West-Berlijn werd door de bouw van de muur onmogelijk. In deze periode zijn, naar het zich laat aanzien, geheel andere processen verantwoordelijk voor de ontwikkeling van de regio en de veranderingen in de ruimtelijke geleding." ],
        [ sgpl:refersToConcept unesco:concept401 ;
            sgpl:subjectText "Ruimtelijke geleding" ;
            sgpl:text_context "De van oudsher bestaande relaties tussen Berlijn en zijn ommeland konden nu weer, zij het aarzelend, op gang komen. De onderlinge beïnvloeding van beide steden gaat in ieder geval terug tot de tijd van de Kurfürsten, die Potsdam hebben ontdekt als mooie residentie en de ruimtelijke geleding van het gebied tot nu toe hebben beïnvloed. De grens die was ontstaan na de feitelijke deling in 1949 was tot vlak voor de bouw van de Muur in 1961 nog tamelijk doorlatend en het is dus heel goed mogelijk dat de relaties tussen stad en ommeland in deze periode nog van invloed zijn geweest op de ruimtelijke geleding van de regio Potsdam." ] ;
    sgpl:thesisID 296 .

sgpl:Thesis297 a sgpl:SGPLThesis ;
    dcterms:creator "Marten Bouma" ;
    dcterms:issued 1995 ;
    dcterms:title "Conversie de opgave, vrachtluchthaven de kans?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "A Achtergrond en opzet van het onderzoek. 1 Dit onderzoek vindt plaats in het kader van de afstudeerperiode van de studie Internationale Economie en Economische Geografie van de Universiteit Utrecht. Het doel is om inzicht te krijgen in de gebeurtenissen rond de ontwikkeling van militaire terreinen tot civiele luchtvrachtcentrum." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3037349 ;
            sgpl:spatialText "Aquitaine" ;
            sgpl:text_context "Languedoc-Roussillon Gard. Aquitaine Gironde. Alsace Bas-Rhin." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmegen" ;
            sgpl:text_context "Faculteit Ruimtelijke Wetenschappen. Marten Bouma. Nijmegen, augustus 1995." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Duitsland" ;
            sgpl:text_context "Een afbakening vindt plaats op de volgende punten: * Uitgangspunt in dit onderzoek zijn de KONVER-regio’s binnen Duitsland, Frankrijk en de Benelux, zoals door de Europese Commissie aangeven is. De reden om op de ontwikkelingen binnen Noordwest-Europa in te gaan is dat de luchtvrachtmarkt van Europa zich vooral in en via deze landen van de Europese Unie afspeelt en er redelijke toegangelijkheid tot informatie is." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3017382 ;
            sgpl:spatialText "Frankrijk" ;
            sgpl:text_context "Een afbakening vindt plaats op de volgende punten: * Uitgangspunt in dit onderzoek zijn de KONVER-regio’s binnen Duitsland, Frankrijk en de Benelux, zoals door de Europese Commissie aangeven is. De reden om op de ontwikkelingen binnen Noordwest-Europa in te gaan is dat de luchtvrachtmarkt van Europa zich vooral in en via deze landen van de Europese Unie afspeelt en er redelijke toegangelijkheid tot informatie is." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Noordwest-Europa" ;
            sgpl:text_context "Het is interessant hier binnen het afstudeeronderzoek van de studie Internationale Economie en Economische Geografie van de Universiteit Utrecht en de stage bij Buck Consultants International in Nijmegen nader op in te gaan. In dit onderzoek 'Conversie de opgave, vrachtluchthaven de uitdaging?’ is voor die regio’s in Noordwest-Europa die via het KONVER-programma van de Europese Commissie extra aandacht krijgen bij hun lokale problemen met demilitarisatie, nagegaan welke regio’s mogelijkheden bieden voor de ontwikkeling van een vrachtluchthaven. Met dit afstudeeronderzoek is mijn extra specialisatie Luchtvaarteconomie en het 'Utrechtse’ profiel van de studie op het snijvlak van geografie en internationale economie alle eer aangedaan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6692168 ;
            sgpl:spatialText "Benelux" ;
            sgpl:text_context "Een afbakening vindt plaats op de volgende punten: * Uitgangspunt in dit onderzoek zijn de KONVER-regio’s binnen Duitsland, Frankrijk en de Benelux, zoals door de Europese Commissie aangeven is. De reden om op de ontwikkelingen binnen Noordwest-Europa in te gaan is dat de luchtvrachtmarkt van Europa zich vooral in en via deze landen van de Europese Unie afspeelt en er redelijke toegangelijkheid tot informatie is." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2847618 ;
            sgpl:spatialText "Rheinland-Pfalz" ;
            sgpl:text_context "De geselecteerde regio’s in Frankrijk. V.3. De geselecteerde regio’s in Duitsland: Rheinland-Pfalz. De deelstaat Rheinland-Pfalz ligt in het midden van de belangrijkste produktie- en consumptiecentra in Europa." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3038032 ;
            sgpl:spatialText "Alsace" ;
            sgpl:text_context "Languedoc-Roussillon Gard. Aquitaine Gironde. Alsace Bas-Rhin." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3007669 ;
            sgpl:spatialText "Languedoc-Roussillon" ;
            sgpl:text_context "V.1. Inleiding. V.2. De geselecteerde regio’s in Frankrijk: Languedoc-Roussillon Gard. Het mediterrane klimaat overheerst in de ’planregio’ (Région de Programme) Languedoc-Roussillon aan de Franse Zuidkust." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1567 ;
            sgpl:subjectText "militaire vliegvelden" ;
            sgpl:text_context "De verminderde behoefte aan militaire bases binnen Europa opent een mogelijkheid voor het uitbreiden van de vliegveldcapaciteit voor de burgerluchtvaart. Het ombouwen van (verlaten) militaire vliegvelden, die vaak centraal in Europa zijn gelegen, zouden veel van de bestaande moeilijkheden van het plannen of uitbreiden van nieuwe luchthavens kunnen omzeilen, omdat de bestaande bases al beschikken over faciliteiten (start-/landingsbanen, verlichting, hangars, etc.), al afgebakende vluchtpaden hebben en over, voldoende ruimte en geluidsbufferzones beschikken. In de media verschijnen veel berichten over plannen op dit gebied." ],
        [ sgpl:refersToConcept unesco:concept1567 ;
            sgpl:subjectText "vrachtluchthaven" ;
            sgpl:text_context "Gedeeltelijk zal het slagen liggen aan de mate waarin de betrokken overheden ook in staat zijn hulp te bieden en projecten ook na het einde van het KONVER-programma te begeleiden. Een van de mogelijke ontwikkelingsrichtingen voor KONVER-regio’s die beschikken over een militaire luchthaveninfrastructuur, is die van de inrichting van het gebied als vrachtluchthaven. Redenen hiervoor zijn onder andere de noodzaak om de groeiende luchtvrachtstromen te heraccommoderen en de directe gebruiksmogelijkheden van de vrijkomende infrastructuur." ],
        [ sgpl:refersToConcept unesco:concept17091 ;
            sgpl:subjectText "KONVER-programma" ;
            sgpl:text_context "De KONVER-regio’s staan in dit onderzoek centraal. De Europese Commissie heeft het KONVER-programma opgezet om de alternatieve ontwikkelingsmogelijkheden voor regio’s met militaire terreinen voor civiele doeleinden te ondersteunen. KONVER II is een communautair initiatief van het Europese Parlement, specifiek ten behoeve van regio’s die sterk waren gericht op de defensie-industrie en nu worden ‘gedwongen’ om hun structuur te verbreden." ],
        [ sgpl:refersToConcept unesco:concept17091 ;
            sgpl:subjectText "KONVER-programma" ;
            sgpl:text_context "De KONVER-regio’s staan in dit onderzoek centraal. De Europese Commissie heeft het KONVER-programma opgezet om de alternatieve ontwikkelingsmogelijkheden voor regio’s met militaire terreinen voor civiele doeleinden te ondersteunen. KONVER II is een communautair initiatief van het Europese Parlement, specifiek ten behoeve van regio’s die sterk waren gericht op de defensie-industrie en nu worden ‘gedwongen’ om hun structuur te verbreden." ],
        [ sgpl:refersToConcept unesco:concept1567 ;
            sgpl:subjectText "militaire vliegvelden" ;
            sgpl:text_context "De verminderde behoefte aan militaire bases binnen Europa opent een mogelijkheid voor het uitbreiden van de vliegveldcapaciteit voor de burgerluchtvaart. Het ombouwen van (verlaten) militaire vliegvelden, die vaak centraal in Europa zijn gelegen, zouden veel van de bestaande moeilijkheden van het plannen of uitbreiden van nieuwe luchthavens kunnen omzeilen, omdat de bestaande bases al beschikken over faciliteiten (start-/landingsbanen, verlichting, hangars, etc.), al afgebakende vluchtpaden hebben en over, voldoende ruimte en geluidsbufferzones beschikken. In de media verschijnen veel berichten over plannen op dit gebied." ],
        [ sgpl:refersToConcept unesco:concept1567 ;
            sgpl:subjectText "vrachtluchthaven" ;
            sgpl:text_context "Gedeeltelijk zal het slagen liggen aan de mate waarin de betrokken overheden ook in staat zijn hulp te bieden en projecten ook na het einde van het KONVER-programma te begeleiden. Een van de mogelijke ontwikkelingsrichtingen voor KONVER-regio’s die beschikken over een militaire luchthaveninfrastructuur, is die van de inrichting van het gebied als vrachtluchthaven. Redenen hiervoor zijn onder andere de noodzaak om de groeiende luchtvrachtstromen te heraccommoderen en de directe gebruiksmogelijkheden van de vrijkomende infrastructuur." ] ;
    sgpl:thesisID 297 .

sgpl:Thesis298 a sgpl:SGPLThesis ;
    dcterms:creator "J.W.A. Braat" ;
    dcterms:issued 1995 ;
    dcterms:title "Monumentenzorg in Europees perspectief",
        "VERSLAGEN VAN LEERONDERZOEK G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "BIBLIOGRAFIE Dit rapport vormt het eindverslag van een afstudeeronderzoek dat uitgevoerd is aan de Universiteit Utrecht binnen de vakgroep Toegepaste Geografie en Planologie. Bij het schrijven van deze doctoraalscriptie heeft Dr. R. Verhoeff als begeleider gefungeerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Parijs" ;
            sgpl:text_context "Veelal gesteund door plaatselijke adel of andere invloedrijke personen ontstaan zo de eerste musea en kunstcollecties. Voorbeelden hiervan zijn het British Museum in Londen en het Louvre in Parijs. Vanuit deze belangstelling om 'oude en mooie’ dingen te bewaren gaat men zich tevens richten op datgene wat de directe leefomgeving zoal te bieden heeft." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3017382 ;
            sgpl:spatialText "Frankrijk" ;
            sgpl:text_context "Opmerkelijk is dan ook dat in veel Westerse landen binnen een periode van tien jaar aan een wetgeving op dit terrein definitief vorm wordt gegeven. In Nederland ontstaat er ’de Monumentenwet’ 1961, in Frankrijk ’Loi Malraux’ 1962, in Engeland ’Civic Amenities Act’ 1967, in Italië ’Urban Planning Act’ 1967 en Turkije komt met een 'Monuments and Historie Building Act’ in 1973. De 'National Historie Preservation Act’ in de Verenigde Staten dateert uit dezelfde periode, 1966." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2802361 ;
            sgpl:spatialText "België" ;
            sgpl:text_context "Om deze reden richtte in 1790 de Franse overheid bijvoorbeeld een ’Commission del Art et Monuments' op. België volgde in 1835 en in Nederland werd in 1875 een departement voor monumentenzorg in het leven geroepen (= voorloper van de huidige Rijksdienst voor Monumentenzorg). De taakstelling binnen deze organisaties was tweeledig." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Tot slot is er voor de vier grote steden door het Rijk voor een specifieke benadering gekozen. Met Amsterdam, Rotterdam, Utrecht en Den Haag zijn aparte convenanten afgesloten. In deze bestuursovereenkomsten zijn door Rijk en gemeente speciale afspraken gemaakt over financiering op het gebied van het cultuurbeleid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "In Nederland verschijnt een eerste officiële monumentenlijst in 1908. In West-Europa en Noord-Amerika ontstaat aan het begin van de twintigste eeuw een soort overgangsfase. Binnen deze periode staat het noteren van monumenten niet langer meer centraal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Noord-Europa" ;
            sgpl:text_context "Door de looptijd van dit onderzoek (6 maanden) en door het ontbreken van financiële middelen was het niet haalbaar om geheel Europa bij dit onderzoek te betrekken. Daarom is gekozen voor één land uit Noord-Europa -Denemarken-, één land uit Zuid-Europa -Portugal-, en één land uit Midden-Europa -Engeland-. Vanuit deze situatie is het volgende schema opgesteld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3175395 ;
            sgpl:spatialText "Italië" ;
            sgpl:text_context "Opmerkelijk is dan ook dat in veel Westerse landen binnen een periode van tien jaar aan een wetgeving op dit terrein definitief vorm wordt gegeven. In Nederland ontstaat er ’de Monumentenwet’ 1961, in Frankrijk ’Loi Malraux’ 1962, in Engeland ’Civic Amenities Act’ 1967, in Italië ’Urban Planning Act’ 1967 en Turkije komt met een 'Monuments and Historie Building Act’ in 1973. De 'National Historie Preservation Act’ in de Verenigde Staten dateert uit dezelfde periode, 1966." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Verenigde Staten" ;
            sgpl:text_context "In Nederland ontstaat er ’de Monumentenwet’ 1961, in Frankrijk ’Loi Malraux’ 1962, in Engeland ’Civic Amenities Act’ 1967, in Italië ’Urban Planning Act’ 1967 en Turkije komt met een 'Monuments and Historie Building Act’ in 1973. De 'National Historie Preservation Act’ in de Verenigde Staten dateert uit dezelfde periode, 1966. Naast het ontstaan van deze wetgeving zijn in de jaren 60 en 70 de volgende ontwikkelingen bepalend geweest voor de monumentenzorg uit die periode (Ashworth 1994):" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2264397 ;
            sgpl:spatialText "Portugal" ;
            sgpl:text_context "Door de looptijd van dit onderzoek (6 maanden) en door het ontbreken van financiële middelen was het niet haalbaar om geheel Europa bij dit onderzoek te betrekken. Daarom is gekozen voor één land uit Noord-Europa -Denemarken-, één land uit Zuid-Europa -Portugal-, en één land uit Midden-Europa -Engeland-. Vanuit deze situatie is het volgende schema opgesteld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "In figuur 4.6 zijn deze opmerkingen tot slot schematisch weergegeven. HOOFDSTUK 5: Een vergelijking van de monumentenzorg in verschillende landen van Europa. 5.1 Methodiek van de internationale vergelijking." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Noord-Amerika" ;
            sgpl:text_context "In Nederland verschijnt een eerste officiële monumentenlijst in 1908. In West-Europa en Noord-Amerika ontstaat aan het begin van de twintigste eeuw een soort overgangsfase. Binnen deze periode staat het noteren van monumenten niet langer meer centraal." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Doelstelling van het onderzoek is om na te gaan in hoeverre er overeenkomsten en verschillen bestaan tussen de monumentenzorg in Nederland en dat van andere (West-) Europese landen. Voorafgaand aan deze vergelijking wordt in de hoofdstukken één tot en met vier een beschrijving gegeven van de monumentenzorg in Nederland. Binnen deze eerste vier hoofdstukken zal een antwoord gegeven worden op volgende vragen:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Tot slot is er voor de vier grote steden door het Rijk voor een specifieke benadering gekozen. Met Amsterdam, Rotterdam, Utrecht en Den Haag zijn aparte convenanten afgesloten. In deze bestuursovereenkomsten zijn door Rijk en gemeente speciale afspraken gemaakt over financiering op het gebied van het cultuurbeleid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:298795 ;
            sgpl:spatialText "Turkije" ;
            sgpl:text_context "Opmerkelijk is dan ook dat in veel Westerse landen binnen een periode van tien jaar aan een wetgeving op dit terrein definitief vorm wordt gegeven. In Nederland ontstaat er ’de Monumentenwet’ 1961, in Frankrijk ’Loi Malraux’ 1962, in Engeland ’Civic Amenities Act’ 1967, in Italië ’Urban Planning Act’ 1967 en Turkije komt met een 'Monuments and Historie Building Act’ in 1973. De 'National Historie Preservation Act’ in de Verenigde Staten dateert uit dezelfde periode, 1966." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Engeland" ;
            sgpl:text_context "Door de looptijd van dit onderzoek (6 maanden) en door het ontbreken van financiële middelen was het niet haalbaar om geheel Europa bij dit onderzoek te betrekken. Daarom is gekozen voor één land uit Noord-Europa -Denemarken-, één land uit Zuid-Europa -Portugal-, en één land uit Midden-Europa -Engeland-. Vanuit deze situatie is het volgende schema opgesteld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Tot slot is er voor de vier grote steden door het Rijk voor een specifieke benadering gekozen. Met Amsterdam, Rotterdam, Utrecht en Den Haag zijn aparte convenanten afgesloten. In deze bestuursovereenkomsten zijn door Rijk en gemeente speciale afspraken gemaakt over financiering op het gebied van het cultuurbeleid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2623032 ;
            sgpl:spatialText "Denemarken" ;
            sgpl:text_context "Door de looptijd van dit onderzoek (6 maanden) en door het ontbreken van financiële middelen was het niet haalbaar om geheel Europa bij dit onderzoek te betrekken. Daarom is gekozen voor één land uit Noord-Europa -Denemarken-, één land uit Zuid-Europa -Portugal-, en één land uit Midden-Europa -Engeland-. Vanuit deze situatie is het volgende schema opgesteld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Tot slot is er voor de vier grote steden door het Rijk voor een specifieke benadering gekozen. Met Amsterdam, Rotterdam, Utrecht en Den Haag zijn aparte convenanten afgesloten. In deze bestuursovereenkomsten zijn door Rijk en gemeente speciale afspraken gemaakt over financiering op het gebied van het cultuurbeleid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2267057 ;
            sgpl:spatialText "gemeente Lissabon" ;
            sgpl:text_context "Het beleid waarbij monumenten als een onderdeel binnen de gehele ruimtelijke ordening worden benaderd is dus ook in Portugal aanwezig. Een opmerkelijk initiatief op dit gebied is het ’Recria’ dat de overheid heeft gesloten met de gemeente Lissabon (SEC 1993). Binnen deze overeenkomst is vastgelegd om de wijken met veel oude huurhuizen in z’n geheel op te knappen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "Londen" ;
            sgpl:text_context "Veelal gesteund door plaatselijke adel of andere invloedrijke personen ontstaan zo de eerste musea en kunstcollecties. Voorbeelden hiervan zijn het British Museum in Londen en het Louvre in Parijs. Vanuit deze belangstelling om 'oude en mooie’ dingen te bewaren gaat men zich tevens richten op datgene wat de directe leefomgeving zoal te bieden heeft." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept274 ;
            sgpl:subjectText "monumentenzorg" ;
            sgpl:text_context "Bij het schrijven van deze doctoraalscriptie heeft Dr. R. Verhoeff als begeleider gefungeerd. Doelstelling van het onderzoek is om na te gaan in hoeverre er overeenkomsten en verschillen bestaan tussen de monumentenzorg in Nederland en dat van andere (West-) Europese landen. De resultaten van deze internationale vergelijking zijn opgenomen in hoofdstuk vijf." ],
        [ sgpl:refersToConcept unesco:concept274 ;
            sgpl:subjectText "erfgoedplanning" ;
            sgpl:text_context "Het monument zelf vormt nu een deelaspect van het totale produkt en marketing is verworden tot hoofdfunctie. Bij deze derde fase kan men zich wel afvragen of het begrip erfgoedplanning zoals Ashworth dit beschrijft nu al werkelijkheid is. Het is namelijk ook goed denkbaar dat we hier te maken hebben met een vorm van monumentenzorg die zich pas over een aantal jaren zal gaan manifesteren." ],
        [ sgpl:refersToConcept unesco:concept2709 ;
            sgpl:subjectText "monumentenbeleid" ;
            sgpl:text_context "Hoofdstuk 2 is afgerond met een vooruitblik. Hierbij is aangegeven dat het begrip cultuurhistorisch kwaliteitsbeheer bepalend zal zijn voor het toekomstige monumentenbeleid in Nederland. Dit monumentenbeleid steunt daarbij op de drie hoofdpeilers actief beheer, de planologische benadering en marktgerichte monumentenzorg." ],
        [ sgpl:refersToConcept unesco:concept2709 ;
            sgpl:subjectText "monumentenbeleid" ;
            sgpl:text_context "Hoofdstuk 2 is afgerond met een vooruitblik. Hierbij is aangegeven dat het begrip cultuurhistorisch kwaliteitsbeheer bepalend zal zijn voor het toekomstige monumentenbeleid in Nederland. Dit monumentenbeleid steunt daarbij op de drie hoofdpeilers actief beheer, de planologische benadering en marktgerichte monumentenzorg." ],
        [ sgpl:refersToConcept unesco:concept274 ;
            sgpl:subjectText "monumentenzorg" ;
            sgpl:text_context "Bij het schrijven van deze doctoraalscriptie heeft Dr. R. Verhoeff als begeleider gefungeerd. Doelstelling van het onderzoek is om na te gaan in hoeverre er overeenkomsten en verschillen bestaan tussen de monumentenzorg in Nederland en dat van andere (West-) Europese landen. De resultaten van deze internationale vergelijking zijn opgenomen in hoofdstuk vijf." ],
        [ sgpl:refersToConcept unesco:concept274 ;
            sgpl:subjectText "erfgoedplanning" ;
            sgpl:text_context "Het monument zelf vormt nu een deelaspect van het totale produkt en marketing is verworden tot hoofdfunctie. Bij deze derde fase kan men zich wel afvragen of het begrip erfgoedplanning zoals Ashworth dit beschrijft nu al werkelijkheid is. Het is namelijk ook goed denkbaar dat we hier te maken hebben met een vorm van monumentenzorg die zich pas over een aantal jaren zal gaan manifesteren." ] ;
    sgpl:thesisID 298 .

sgpl:Thesis299 a sgpl:SGPLThesis ;
    dcterms:creator "Maarten de Laat" ;
    dcterms:issued 1995 ;
    dcterms:title "Een beleidsevaluatie aan de hand van een sloopprocedure",
        "HET BESLUIT BEHEER SOCIALE HUURSECTOR IN UITVOERING" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "het centrum van de stad Utrecht" ;
            sgpl:text_context "In 1966 is het complex gerenoveerd, met als uitgangspunt een verdere exploitatie van 25 jaar. Complex 102 is gelegen in de Rivierenwijk, een wijk nabij het centrum van de stad Utrecht, en is gebouwd in 1920. In 1966 is het complex gerenoveerd, met als uitgangspunt een verdere exploitatie van 25 jaar." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "de gemeente Utrecht" ;
            sgpl:text_context "Dit vindt plaats aan de hand van een case-study, met als onderwerp de besluitvormingsprocedure rond de toekomst van een woningcomplex, waarvoor de bezittende woningcorporatie een sloopmelding gedaan heeft. In concreto gaat het om een complex van 174 woningen in de Rivierenwijk in de gemeente Utrecht, Complex 102 geheten. De woningen zijn in eigendom van Stichting BO-EX ’91." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Voorliggend onderzoek is mijn doctoraal scriptie voor de studie Sociale Geografie aan de Faculteit Ruimtelijke Wetenschappen van de Universiteit Utrecht. Het is tot stand gekomen in een stageverband bij Stichting BO-EX ’91, een woningcorporatie in Utrecht. Het volkshuisvestingsbeleid in Nederland is sterk aan veranderingen onderhevig." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748039 ;
            sgpl:spatialText "Rivierenwijk" ;
            sgpl:text_context "Dit BBSH is een regelgevend kader waaraan invulling gegeven moet worden door de verschillende partijen op gemeentelijk niveau; gemeente, corporatie en bewoners. Dit onderzoek laat zien hoe dit in de praktijk geschiedt en betreft analoog hieraan een case-study, namelijk de sloopprocedure van een groot aantal woningen van Stichting BO-EX ’91 in de Rivierenwijk te Utrecht. Dit proces werd door alle betrokken partijen als probleem vol ervaren, wat feitelijk de directe aanleiding vormde voor het uitvoeren van dit onderzoek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Complex 102" ;
            sgpl:text_context "Dit vindt plaats aan de hand van een case-study, met als onderwerp de besluitvormingsprocedure rond de toekomst van een woningcomplex, waarvoor de bezittende woningcorporatie een sloopmelding gedaan heeft. In concreto gaat het om een complex van 174 woningen in de Rivierenwijk in de gemeente Utrecht, Complex 102 geheten. De woningen zijn in eigendom van Stichting BO-EX ’91." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het is tot stand gekomen in een stageverband bij Stichting BO-EX ’91, een woningcorporatie in Utrecht. Het volkshuisvestingsbeleid in Nederland is sterk aan veranderingen onderhevig. Decentralisatie, deregulering en verzelfstandiging van de sociale sector zijn hierbij de steek- woorden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "Besluit Beheer Sociale Huursector" ;
            sgpl:text_context "Decentralisatie, deregulering en verzelfstandiging van de sociale sector zijn hierbij de steekwoorden. Het Besluit Beheer Sociale Huursector (BBSH), dat op 1 januari 1993 in werking trad, is een belangrijk onderdeel van de implementatie van het nieuwe rijksbeleid. Het BBSH is een regelgevend kader waaraan invulling gegeven moet worden door de verschillende partijen op gemeentelijk niveau; gemeente, corporatie en bewoners." ],
        [ sgpl:refersToConcept unesco:concept4419 ;
            sgpl:subjectText "Sloopprocedure" ;
            sgpl:text_context "Het BBSH is een regelgevend kader waaraan invulling gegeven moet worden door de verschillende partijen op gemeentelijk niveau; gemeente, corporatie en bewoners. Dit onderzoek laat zien hoe dit in de praktijk geschiedt en betreft analoog hieraan een case-study, namelijk de sloopprocedure van een groot aantal woningen van Stichting BO-EX ’91 in de Rivierenwijk te Utrecht. Dit proces werd door alle betrokken partijen als probleem vol ervaren, wat feitelijk de directe aanleiding vormde voor het uitvoeren van dit onderzoek." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "Woningcorporaties" ;
            sgpl:text_context "In vergelijking met de oude regelgeving geeft de overheid nu meer vrijheid aan de woningcorporaties als het gaat om dergelijke besluiten. De woningcorporaties zijn nu in staat initiatief te nemen tot de uitvoering van een besluit van aanmerkelijk belang. De gemeente heeft zich beperkt tot de taak toezicht te houden op de beleidsvoering van de corporaties." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "Woningcorporaties" ;
            sgpl:text_context "In vergelijking met de oude regelgeving geeft de overheid nu meer vrijheid aan de woningcorporaties als het gaat om dergelijke besluiten. De woningcorporaties zijn nu in staat initiatief te nemen tot de uitvoering van een besluit van aanmerkelijk belang. De gemeente heeft zich beperkt tot de taak toezicht te houden op de beleidsvoering van de corporaties." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "Besluit Beheer Sociale Huursector" ;
            sgpl:text_context "Decentralisatie, deregulering en verzelfstandiging van de sociale sector zijn hierbij de steekwoorden. Het Besluit Beheer Sociale Huursector (BBSH), dat op 1 januari 1993 in werking trad, is een belangrijk onderdeel van de implementatie van het nieuwe rijksbeleid. Het BBSH is een regelgevend kader waaraan invulling gegeven moet worden door de verschillende partijen op gemeentelijk niveau; gemeente, corporatie en bewoners." ],
        [ sgpl:refersToConcept unesco:concept4419 ;
            sgpl:subjectText "Sloopprocedure" ;
            sgpl:text_context "Het BBSH is een regelgevend kader waaraan invulling gegeven moet worden door de verschillende partijen op gemeentelijk niveau; gemeente, corporatie en bewoners. Dit onderzoek laat zien hoe dit in de praktijk geschiedt en betreft analoog hieraan een case-study, namelijk de sloopprocedure van een groot aantal woningen van Stichting BO-EX ’91 in de Rivierenwijk te Utrecht. Dit proces werd door alle betrokken partijen als probleem vol ervaren, wat feitelijk de directe aanleiding vormde voor het uitvoeren van dit onderzoek." ] ;
    sgpl:thesisID 299 .

sgpl:Thesis30 a sgpl:SGPLThesis ;
    dcterms:creator "J. Hummelen" ;
    dcterms:issued 1960 ;
    dcterms:title "DE AGRARISCHE STRUCTUUR",
        "IN DE GELDERSE VALLEI" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745666 ;
            sgpl:spatialText "Neder-Veluwe" ;
            sgpl:text_context "Bij de indelingen in landbouwgebieden wordt de Gelderse Vallei niet genoemd als een geheel. Liet enige beperkingen kunnen we het gebied doen opgaan in het Utrechtse zandgebied en de Neder-Veluwe. In vele opzichten vertonen deze gebieden dezelfde trekken ten aanzien van de agrarische structuur, maar er zijn ook belangrijke verschillen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759407 ;
            sgpl:spatialText "Barneveld" ;
            sgpl:text_context "Uit kartogram II, 1 blijkt duidelijk, dat de gemiddelde bedrijfsgrootte naar het Veesten toeneemt. Barneveld geeft een vertekening in de algemene indruk, omdat het Westen van Barneveld nauw aansluit bij de Stichtse gemeenten. Het Oosten daarentegen sluit door zijn grote aantal kleine bedrijven weer nauw aan bij de gemeente Ede." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756426 ;
            sgpl:spatialText "het gebied rond Ederveen" ;
            sgpl:text_context "Binnen de gemeente bestaan er duidelijk verschillen in arbeidsbehoefte en intensiteitsniveau. Het hoogste intensiteitsniveau wordt bereikt in het gebied rond Ederveen en De Klomp, waar de bedrijven door hun geringe omvang aan nauwelijks meer dan een man werk kunnen verschaffen. De afvloeiing uit de landbouw wordt hier in gunstige zin beïnvloed door de reeds lang bestaande gewoonte werk te zoeken in Gelders Veenendaal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2760049 ;
            sgpl:spatialText "Achterberg" ;
            sgpl:text_context "De kleine bedrijven hebben naar verhouding niet meer varkens en kippen dan de grotere. Geheel in tegenstelling met wat men zou verwachten, komen zelfs in Achterberg (gemeente Rhenen) op de kleine bedrijven minder varkens en kippen voor dan op de grotere bedrijven. Reeds eerder werd dan ook opgemerkt, dat bij de grote naoorlogs: uitbreiding van de pluimveestapel de bedrijven tussen 7 en 10 ha. vooraangingen, terwijl de kleinere bedrijven achterbleven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "Utrechtse zandgebied" ;
            sgpl:text_context "Bij de indelingen in landbouwgebieden wordt de Gelderse Vallei niet genoemd als een geheel. Liet enige beperkingen kunnen we het gebied doen opgaan in het Utrechtse zandgebied en de Neder-Veluwe. In vele opzichten vertonen deze gebieden dezelfde trekken ten aanzien van de agrarische structuur, maar er zijn ook belangrijke verschillen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755622 ;
            sgpl:spatialText "Gelderse Vallei" ;
            sgpl:text_context "De andere leden van de werkgroep bestudeerden resp. de historische agrarische structuur, de betekenis van de industrie in de omgeving en de tegenwoordige kippenhouderij. Er is vrijwel geen literatuur over de huidige agrarische toestand in de Gelderse Vallei. Daarom zijn de hoofdstukken I en II nagenoeg geheel gebaseerd op het wel bestaande cijfermateriaal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745774 ;
            sgpl:spatialText "Veenendaal" ;
            sgpl:text_context "Het hoge percentage bedrijven beneden 1 ha. in Barneveld heeft om dezelfde reden ook veel betekenis. De groep van 1-5 ha. is ruim vertegenwoordigd in Ede, Barneveld en Veenendaal. De grootteklasse van 5-10 ha. is in alle gemeenten goed vertegenwoordigd met bedragen van 25% tot ruim 30% met uitzondering van Ede (23%), Leusden (20%) en Stoutenberg (19%)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756429 ;
            sgpl:spatialText "gemeente Ede" ;
            sgpl:text_context "Omdat de gemiddelden niets te zien geven van de verdeling over de grootteklassen, is ook dit laatste gegeven in een beeldstatistiek verwerkt (bijlage II, 2). Opval lend is hierbij het in vergelijking met de andere gemeenten zeer hoge percentage van de bedrijven beneden 1 ha. in de gemeente Ede. Dit hoge percentage is zeer belangrijk, omdat het hier om een bijzonder groot totaal aantal bedrijven gaat (2441)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In het door het Landbouw Economisch Instituut uitgegeven rapport \"Het Kleine-Boerenvraagstuk op de zandgronden\" zijn kwantitatieve gegevens opgenomen betreffende de elf zandgebieden in Nederland. Een aantal van deze kwantitatieve gegevens hebben we in beeld gebracht om een globale vergelijking van het hier te bespreken gebied met de overige zandgebieden mogelijk te maken. Bijzonder opvallend is, dat zowel de Neder-Veluwe als het Utrechtse zandgebied in de jaren 1910 - 1948 een daling van de gemiddelde bedrijfsgrootte te zien geven (bijlage I, 2)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756426 ;
            sgpl:spatialText "Ederveen" ;
            sgpl:text_context "Het moge de lezer duidelijk worden, dat een dergelijke classificatie met de ons ter beschikking staande middelen niet was te verwezenlijkon voor de gehele Gelderse Vallei. Onze keus viel op Ederveen, dat zelfs in de Gelderse Vallei nog opvalt door zijn hoge agrarische dichtheid en grote bevolkingstoename sinds de vorige eeuw. We beschouwen deze studie dan ook als een inleiding en niet als een voltooid en afgerond geheel." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3457 ;
            sgpl:subjectText "Pluimveehouderij" ;
            sgpl:text_context "In vergelijking met de bedrijven van 7-12 ha. zijn de kleine bedrijven aanzienlijk achtergebleven. Dit is naar alle waarschijnlijkheid ook een verklaring voor de verhoudingsgewijs vrij grote betekenis, welke de pluimveehouderij in de centrale Valleigemeenten Scherpenzeel en Renswoude thans inneemt 1). Juist in deze gemeenten blijken de kippen gemiddeld in grotore aantallen per bedrijf voor te komen." ],
        [ sgpl:refersToConcept unesco:concept8044 ;
            sgpl:subjectText "Kleine landbouwbedrijven" ;
            sgpl:text_context "Hiernaast werden nog andere wijzigingen in landbouwmethoden ingevoerd, welke landarbeiders voor een groot deel overbodig maakten. Tegelijk mee de noodzaak voor de dagloners om naar andere werkgelegenheid uit te zien, was de vergrote vraag naar dierlijke producten in de grote steden van het Westen bijzonder gunstig voor de kleine landbouwbedrijven, welke zich in hoge mate konden intensiveren door kippen- en varkensteelt. Door de gunstige ligging kon de Gelderse Vallei beter dan de andere zandgebieden een verzorgende functie voor het Westen krijgen." ],
        [ sgpl:refersToConcept unesco:concept1699 ;
            sgpl:subjectText "Agrarische structuur" ;
            sgpl:text_context "Liet enige beperkingen kunnen we het gebied doen opgaan in het Utrechtse zandgebied en de Neder-Veluwe. In vele opzichten vertonen deze gebieden dezelfde trekken ten aanzien van de agrarische structuur, maar er zijn ook belangrijke verschillen. In het door het Landbouw Economisch Instituut uitgegeven rapport \"Het Kleine-Boerenvraagstuk op de zandgronden\" zijn kwantitatieve gegevens opgenomen betreffende de elf zandgebieden in Nederland." ],
        [ sgpl:refersToConcept unesco:concept1699 ;
            sgpl:subjectText "Agrarische structuur" ;
            sgpl:text_context "Liet enige beperkingen kunnen we het gebied doen opgaan in het Utrechtse zandgebied en de Neder-Veluwe. In vele opzichten vertonen deze gebieden dezelfde trekken ten aanzien van de agrarische structuur, maar er zijn ook belangrijke verschillen. In het door het Landbouw Economisch Instituut uitgegeven rapport \"Het Kleine-Boerenvraagstuk op de zandgronden\" zijn kwantitatieve gegevens opgenomen betreffende de elf zandgebieden in Nederland." ],
        [ sgpl:refersToConcept unesco:concept3457 ;
            sgpl:subjectText "Pluimveehouderij" ;
            sgpl:text_context "In vergelijking met de bedrijven van 7-12 ha. zijn de kleine bedrijven aanzienlijk achtergebleven. Dit is naar alle waarschijnlijkheid ook een verklaring voor de verhoudingsgewijs vrij grote betekenis, welke de pluimveehouderij in de centrale Valleigemeenten Scherpenzeel en Renswoude thans inneemt 1). Juist in deze gemeenten blijken de kippen gemiddeld in grotore aantallen per bedrijf voor te komen." ],
        [ sgpl:refersToConcept unesco:concept8044 ;
            sgpl:subjectText "Kleine landbouwbedrijven" ;
            sgpl:text_context "Hiernaast werden nog andere wijzigingen in landbouwmethoden ingevoerd, welke landarbeiders voor een groot deel overbodig maakten. Tegelijk mee de noodzaak voor de dagloners om naar andere werkgelegenheid uit te zien, was de vergrote vraag naar dierlijke producten in de grote steden van het Westen bijzonder gunstig voor de kleine landbouwbedrijven, welke zich in hoge mate konden intensiveren door kippen- en varkensteelt. Door de gunstige ligging kon de Gelderse Vallei beter dan de andere zandgebieden een verzorgende functie voor het Westen krijgen." ] ;
    sgpl:thesisID 30 .

sgpl:Thesis300 a sgpl:SGPLThesis ;
    dcterms:creator "Amir Jilani" ;
    dcterms:issued 1995 ;
    dcterms:title "REMOTE SENSING DATA TEN BEHOEVE VAN EEN MANAGEMENT-SYSTEEM VOOR BEHEER EN EXPLOITATIE VAN BOSGEBIEDEN",
        "vraag, aanbod en eigenschappen" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6251999 ;
            sgpl:spatialText "Canada" ;
            sgpl:text_context "De toenemende bevolkingsdruk, zorg voor het mtlteu alsmede het belang van bosgebieden voor commerciële exploitatie, hebben ervoor gezorgd dat de druk om een goed management van deze gebieden te bereiken, is toegenomen. De grote bosgebieden van de wereld bevinden zich in de gematigde streken in Canada de voormalige Sovjet Unie en Scandinavië en in de tropen, bijvoorbeeld in Indonesië Maleisië Centraal- en West-Afrika en in Brazilië (de Amazone). Remote sensing kan voor deze bosgebieden als interessant beschouwd worden vanwege de grootte van de gebieden en de relatieve ontoegankelijkheid daarvan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:5667009 ;
            sgpl:spatialText "Montana" ;
            sgpl:text_context "Het Swedish County Forestry Board Project en de Montana Timber-Water Cooperative Study zijn grootschalig en hebben betrekking op noordelijke landen, respectievelijk Zweden en de V.S. Begin jaren tachtig werd als onderdeel van het USDA Cooperative Study Program een project gestart in Montana, het Montana Timber-Water Cooperative Study. De doelstelling was tweeledig: ten eerste, het automatiseren van de kartering van bosgebieden en ten tweede het evalueren van het gebruik van een GIS voor management van zulke gebieden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2661886 ;
            sgpl:spatialText "Zweden" ;
            sgpl:text_context "De beelden die door Landsat oplevprH en 1:1.000.000. g worden, hebben een schaal tussen 1:250.000. Sinds 1986 is er nog een belangrijke bron voor MSS-beelden bijgekomen, de serie SPOT-satellieten, een programma met deelname van Frankrijk, België en Zweden. De SPOT-satellieten worden gekenmerkt door twee high resolution visible imaging Instruments (HRV’s), pushbroomdetectcnen en off-nadir viewing." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Mijn dank gaat natuurlijk uit aan allen die geholpen hebben bij het tot stand komen van dit werkstuk, in het bijzonder aan mijn twee begeleiders Barend Kobben en Frans van der Wel van de vakgroep Kartografie te Utrecht. e •• on er ee van de studie Kartografie aan de Universiteit Utrecht bestaat uit het schrijven van een scriptie over een onderwerp binnen het vakgebied. Al gedurende het eerste jaar van mijn studie Kartografie kreeg ik het idee om mijn scriptie te richten op een toepassmgsgebie van remote sensing." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3665361 ;
            sgpl:spatialText "Amazone-gebied" ;
            sgpl:text_context "Taken die het GRID op zich neemt zijn (Jaakkola 1990 p.1355): Tussen 1987 en 1990 hebben er in het kader van het GRID twee onderzoeken plaatsgehad met het oog op het ontwikkelen van een methodologie voor de taken waarmee GRID belast is: één naar het onderscheiden van bos- en niet-bosgebied in West-Afrika, en een ander onderzoek naar de mate van ontbossing in het Amazone-gebied. De meest gebruikte data waren AVHRR-data van het LAC-formaat, met daarnaast Landsat TM- en SPOT-beelden, aangevuld door veldwerkdata." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3382998 ;
            sgpl:spatialText "Suriname" ;
            sgpl:text_context "Een managementsysteem zou in deze verbetering kunnen brengen. Een recent voorbeeld van een situatie waarin zo’n systeem (of delen daarvan) gebruikt zou kunnen worden ligt in Suriname1. Daar zou in principe een principe-accoord gesloten worden tussen de Surinaamse regering en de Maleisische bosbouwgroep Berjaja voor de exploitatie van 700.000 ha Surinaams regenwoud." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255146 ;
            sgpl:spatialText "Oost-Afrika" ;
            sgpl:text_context "Gecombineerd met andere gegevens, bijvoorbeeld meteorologische, kan een zogenaamd early waming system gecreëerd worden. Het systeem van de UN Food & Agricultural Organisarion (FAO) voor Oost-Afrika is hier een voorbeeld van1. De bosbouw is een ander toepassingsgebied waar, getuige de aanzienlijke hoeveelheid literatuur, aandacht naar uitgegaan is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Kisatchie National Park" ;
            sgpl:text_context "Gezien de verbeterde spectrale en ruimtelijke resolutie: van TM beekte” van MSS-beelden3 zou men kunnen verwachten dat de nauw eung van de typen bos bij gebruik van eerstgenoemde data groteren. Evans & Hill hebben in 1990 onderzoek gedaan naar het gebruik van TM-beelden voor het identificeren van bostypen in Kisatchie National Park in Louisiana, V.S. Voor een gebied werden drie klassen onderscheiden: loofbomen, naaldbomen en open vlakte." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3469034 ;
            sgpl:spatialText "Brazilië" ;
            sgpl:text_context "De toenemende bevolkingsdruk, zorg voor het mtlteu alsmede het belang van bosgebieden voor commerciële exploitatie, hebben ervoor gezorgd dat de druk om een goed management van deze gebieden te bereiken, is toegenomen. De grote bosgebieden van de wereld bevinden zich in de gematigde streken in Canada de voormalige Sovjet Unie en Scandinavië en in de tropen, bijvoorbeeld in Indonesië Maleisië Centraal- en West-Afrika en in Brazilië (de Amazone). Remote sensing kan voor deze bosgebieden als interessant beschouwd worden vanwege de grootte van de gebieden en de relatieve ontoegankelijkheid daarvan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1643084 ;
            sgpl:spatialText "Indonesië" ;
            sgpl:text_context "In de tweede plaats is er het beheer met als doel behoud van het bos wegens milieu-motieven. In veel bosrijke landen, met name de (sub-)tropische landen (bv. Indonesië, Maleisië, Thailand, India, Ivoorkust)3, is er veel druk op grote bosgebieden vanwege de grote bevolkingsgroei, de armoede en gevestigde belangen van machtige personen en bedrijven, hetzij lokaal, hetzij internationaal. Deze bossen zullen waarschijnlijk alleen behouden kunnen worden als er met de genoemde randverschijnselen rekening wordt gehouden, met andere woorden de lokale bevolking moet een reden hebben om het bos te behouden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1853 ;
            sgpl:subjectText "beheer van bosgebieden" ;
            sgpl:text_context "De toenemende bevolkingsdruk, zorg voor het milieu alsmede het belang van bosgebieden voor commerciële exploitatie, hebben ervoor gezorgd dat de druk om een goed management van deze gebieden te bereiken, is toegenomen. Een management-systeem, bestaande uit een database met de mogelijkheid tot invoer van gegevens en uitvoer van informatie, zou een hulpmiddel kunnen vormen voor het beheer en de commerciële exploitatie van bosgebieden. In hoeverre remote sensing hierbij een rol kan spelen, zal afhankelijk zijn van het antwoord op de al eerder genoemde vraag over het praktisch nut van de geleverde remote sensing data in vergelijking tot andere data." ],
        [ sgpl:refersToConcept unesco:concept1557 ;
            sgpl:subjectText "remote sensing" ;
            sgpl:text_context "In de loop der jaren heeft men dan ook op allerlei wetenschappelijke en niet-wetenschappelijke gebieden geprobeerd informatie te verzamelen gebruikmakend van deze techniek (Lillesand/Kiefer, 1987). Remote sensing, ook wel teledetectie genoemd, kan gedefinieerd worden als \"het verkrijgen van informatie over objecten of verschijnselen door middel van de analyse van data die verkregen zijn met een meetinstrument, dat niet in contact staat met die objecten of verschijnselen\" (Lillesand/Kiefer, 1987, p.1). Sinds men is begonnen om remote sensing technieken, oorspronkelijk bedacht voor militaire toepassingen, te ontwikkelen ten behoeve van toepassingen in de civiele sfeer, zijn talloze miljoenen guldens geïnvesteerd in het aanpassen en het verbeteren van deze technieken." ],
        [ sgpl:refersToConcept unesco:concept12035 ;
            sgpl:subjectText "commerciële exploitatie" ;
            sgpl:text_context "In hoeverre remote sensing hierbij een rol kan spelen, zal afhankelijk zijn van het antwoord op de al eerder genoemde vraag over het praktisch nut van de geleverde remote sensing data in vergelijking tot andere data. Voor de combinatie van data ten behoeve van beheer en commerciële exploitatie van bosgebieden is gekozen vanwege het verband dat tussen beide bestaat. Beheer kan op meerdere manieren opgevat worden." ],
        [ sgpl:refersToConcept unesco:concept1557 ;
            sgpl:subjectText "remote sensing" ;
            sgpl:text_context "In de loop der jaren heeft men dan ook op allerlei wetenschappelijke en niet-wetenschappelijke gebieden geprobeerd informatie te verzamelen gebruikmakend van deze techniek (Lillesand/Kiefer, 1987). Remote sensing, ook wel teledetectie genoemd, kan gedefinieerd worden als \"het verkrijgen van informatie over objecten of verschijnselen door middel van de analyse van data die verkregen zijn met een meetinstrument, dat niet in contact staat met die objecten of verschijnselen\" (Lillesand/Kiefer, 1987, p.1). Sinds men is begonnen om remote sensing technieken, oorspronkelijk bedacht voor militaire toepassingen, te ontwikkelen ten behoeve van toepassingen in de civiele sfeer, zijn talloze miljoenen guldens geïnvesteerd in het aanpassen en het verbeteren van deze technieken." ],
        [ sgpl:refersToConcept unesco:concept1853 ;
            sgpl:subjectText "beheer van bosgebieden" ;
            sgpl:text_context "De toenemende bevolkingsdruk, zorg voor het milieu alsmede het belang van bosgebieden voor commerciële exploitatie, hebben ervoor gezorgd dat de druk om een goed management van deze gebieden te bereiken, is toegenomen. Een management-systeem, bestaande uit een database met de mogelijkheid tot invoer van gegevens en uitvoer van informatie, zou een hulpmiddel kunnen vormen voor het beheer en de commerciële exploitatie van bosgebieden. In hoeverre remote sensing hierbij een rol kan spelen, zal afhankelijk zijn van het antwoord op de al eerder genoemde vraag over het praktisch nut van de geleverde remote sensing data in vergelijking tot andere data." ],
        [ sgpl:refersToConcept unesco:concept12035 ;
            sgpl:subjectText "commerciële exploitatie" ;
            sgpl:text_context "In hoeverre remote sensing hierbij een rol kan spelen, zal afhankelijk zijn van het antwoord op de al eerder genoemde vraag over het praktisch nut van de geleverde remote sensing data in vergelijking tot andere data. Voor de combinatie van data ten behoeve van beheer en commerciële exploitatie van bosgebieden is gekozen vanwege het verband dat tussen beide bestaat. Beheer kan op meerdere manieren opgevat worden." ] ;
    sgpl:thesisID 300 .

sgpl:Thesis301 a sgpl:SGPLThesis ;
    dcterms:creator "Madelon Leeuwenburgh" ;
    dcterms:issued 1995 ;
    dcterms:title "Niet dik, dun is de mode",
        "ruimtelijke gevolgen van organisatorische veranderingen: decentralisatie en verplatting" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758998 ;
            sgpl:spatialText "Beverwijk" ;
            sgpl:text_context "Voor de divisie staal vormt het geïntegreerde staalbedrijf Hoogovens IJmuiden de kern. De relatie met het hoofdkantoor in het kader van de ruimtelijke verschuivingen die optreden als gevolg van verplatting is echter minder interessant, omdat de afstand tussen Beverwijk (waar het hoofdkantoor gevestigd is) en Umuiden zeer gering is. Toch heeft het staalbedrijf Hoogovens IJmuiden een voorbeeld functie voor de rest van het concern, gezien de totale concemomzet van 52%." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753376 ;
            sgpl:spatialText "Hoogovens IJmuiden" ;
            sgpl:text_context "De activiteiten van het Hoogovens-concem zijn in 1993 gegroepeerd in zes divisies die ressorteren onder Hoogovens Groep B.V. Tot de staaldivisie behoort onder meer het staalbedrijf Hoogovens IJmuiden, dat een breed assortiment platte warm- en koudgewalste produkten levert, alsmede verpakkingsstaal. Tot de aluminium divisie behoren de primair-aluminiumbedrijven en walserij- en extrusiebedrijven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757340 ;
            sgpl:spatialText "Delfzijl" ;
            sgpl:text_context "Hoogovens Umuiden is een uniek bedrijf met een geïntegreerde produktieketen die bestaat uit geschakelde, kapitaalintensieve mammoetinstallaties (Keuning, Opheij en Maas 1993, 42). Het telefoongesprek met de vestiging van Hoogovens in Delfzijl (Aluminium Delfzijl) wees echter uit dat Hoogovens Umuiden niet als voorbeeldvestiging kan worden gezien. Binnen de vestiging Aluminium Delfzijl zijn wel reorganisaties doorgevoerd, maar deze hadden vooral betrekking op bezuinigingen die een afname van het aantal personeelsleden tot gevolg heeft gehad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Zuid-Oost Azië" ;
            sgpl:text_context "De rubberverwerkende industrie kent drie belangrijke grondstoffen: natuurrubber, synthetische rubber, kunststoffen. Voor de invoer van natuurrubber is de sector afhankelijk van de grondstofproduktie in Zuid-Oost Azië. De rubberverwerkende industrie stelt, in tegenstelling tot de kunststofvenverkende industrie, haar mengsels in het algemeen zelf samen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754394 ;
            sgpl:spatialText "Hengelo" ;
            sgpl:text_context "De oorzaak van de decentralisatie en de verplatting van de organisatie ligt in feite in Hengelo. Tot 1969 zat de centrale organisatie met een groot hoofdkantoor in Hengelo. Dit was een trage, bureaucratische organisatie met lange beslissingslijnen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756071 ;
            sgpl:spatialText "Enschede" ;
            sgpl:text_context "Binnen de verschillende groepen van VNU worden reorganisaties door de eigen directies bepaald en doorgevoerd. Voor het onderzoek naar de verschuivingen tussen het hoofdkantoor en de vestigingen is gekozen voor de business unit Vredestem Banden te Enschede. Deze business unit dient als voorbeeld vestiging voor heel het concern." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Was het vroeger zo dat de groot stedelijke gebieden een stempel drukte op de positieve regionale economische ontwikkeling, tegenwoordig leveren bedrijven of onderdelen van bedrijven een positieve bijdrage aan de regionale economische ontwikkeling in perifere gebieden. Binnen Nederland is het niet zozeer meer de vestigingsplaats van een onderneming die bepalend is voor de welvaart van een onderneming, maar de interne bedrijfsstructuur die bepalend is voor het succes van een onderneming. De interne bedrijfsstructuur bepaalt of een onderneming in staat is op de veranderende omgeving te reageren en deze naar haar hand te zetten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758462 ;
            sgpl:spatialText "Boxmeer" ;
            sgpl:text_context "De Raad van Bestuur overlegt met de werkmaatschappijen over allerhande zaken met betrekking tot de primaire en ondersteunende taken, maar de beslissingsbevoegdheid blijft bij de Raad van Bestuur. Voor de analyse van de ruimtelijke verschuivingen in de werkgelegenheid, het patroon vanbeslissingen en functies tussen het hoofdkantoor en de vestingen, ts gekozen voor de vestiging Stork Sereens te Boxmeer. Stork Sereens behoort tot de kernactiviteit industriële systemen en daarbinnen tot de groep systemen voor drukvormvervaardiging." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "Verplatting" ;
            sgpl:text_context "De laatste mogelijkheid uit het model die de structuur van een organisatie verandert is het verplatten van de organisatie. Verplatting is het proces waarin het aantal managementlagen van een organisatie wordt verminderd. Verplatting van organisaties is de structurele verandering die in dit onderzoek centraal staat." ],
        [ sgpl:refersToConcept unesco:concept12334 ;
            sgpl:subjectText "Bedrijfsgeografie" ;
            sgpl:text_context "Deze nadruk op de omgeving veranderde toen de bedrijfsgeografie in de jaren zestig haar intrede deed. De bedrijfsgeografie stelde het bedrijf en de invloed van economische activiteiten op de omgeving centraal. De verandering in het denken over de relatie tussen een bedrijf en haar omgeving, heeft een verandering in het denken over de regionale economische ontwikkeling tot gevolg gehad." ],
        [ sgpl:refersToConcept unesco:concept4877 ;
            sgpl:subjectText "Decentralisatie" ;
            sgpl:text_context "Deze centrale probleemstelling wordt vervolgens afgebakend. De organisatorische veranderingen die in dit onderzoek centraal staan zijn de decentralisatie en de verplatting (het minder hiërarchisch worden) van organisaties. Decentralisatie en verplatting van organisaties beïnvloeden onder andere de werkgelegenheid, het beslissingsniveau en het functieniveau op het hoofdkantoor, maar ook in de vestigingen." ],
        [ sgpl:refersToConcept unesco:concept4877 ;
            sgpl:subjectText "Decentralisatie" ;
            sgpl:text_context "Deze centrale probleemstelling wordt vervolgens afgebakend. De organisatorische veranderingen die in dit onderzoek centraal staan zijn de decentralisatie en de verplatting (het minder hiërarchisch worden) van organisaties. Decentralisatie en verplatting van organisaties beïnvloeden onder andere de werkgelegenheid, het beslissingsniveau en het functieniveau op het hoofdkantoor, maar ook in de vestigingen." ],
        [ sgpl:refersToConcept unesco:concept12334 ;
            sgpl:subjectText "Bedrijfsgeografie" ;
            sgpl:text_context "Deze nadruk op de omgeving veranderde toen de bedrijfsgeografie in de jaren zestig haar intrede deed. De bedrijfsgeografie stelde het bedrijf en de invloed van economische activiteiten op de omgeving centraal. De verandering in het denken over de relatie tussen een bedrijf en haar omgeving, heeft een verandering in het denken over de regionale economische ontwikkeling tot gevolg gehad." ],
        [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "Verplatting" ;
            sgpl:text_context "De laatste mogelijkheid uit het model die de structuur van een organisatie verandert is het verplatten van de organisatie. Verplatting is het proces waarin het aantal managementlagen van een organisatie wordt verminderd. Verplatting van organisaties is de structurele verandering die in dit onderzoek centraal staat." ] ;
    sgpl:thesisID 301 .

sgpl:Thesis302 a sgpl:SGPLThesis ;
    dcterms:creator "Jef Muhren" ;
    dcterms:issued 1995 ;
    dcterms:title "het beeldkwaliteitsplan",
        "terugblik en vooruitzicht" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "In een enkel geval worden juist de karakteristieken en eigenschappen van de openbare ruimte centraal gesteld. De gemeente wenst hiermee de richting aan te geven waar het gaat om haar eigen beleid: \"Het doel is voor toekomstige plannen voor verdichting, uitbreiding of ander gebruik van het stedelijk gebied, een toetsingskader te bieden waarmee de kwaliteit van de openbare ruimte beschermd en zonodig verbeterd wordt.\" (Stadsbeeld Utrecht). Overigens wordt met de eigenschappen van de openbare ruimte ook nadrukkelijk gedoeld op de randen hiervan in de vorm van bebouwingswanden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "centraal stadsgebied Amersfoort" ;
            sgpl:text_context "In de projectontwikkelingsovereenkomsten kunnen gemeentes kwaliteitseisen stellen, en gemeentes kunnen invloed uitoefenen bij de keuze van vormgevers. Kwaliteitskaart centraal stadsgebied Amersfoort. Gemeente Amersfoort. november 1990 (concept)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In vele vakdiscussies blijven de meeste betrokkenen op de vlakte als het erom gaat de eigen ambities ten aanzien van het bouwen te benoemen. Een groot deel van hetgeen er in Nederland wordt gebouwd kan worden omschreven als massa- of serieproduktie, reproduktie, soms ook wel oneerbiedig 'stenen stapelen’ genoemd. De rol van vormgevende disciplines bij deze opgaven is in de huidige situatie op zijn minst twijfelachtig geworden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "De figuur van stadsbouwmeester wordt echter niet opportuun geacht: Het stadsbeeld van Amsterdam is beter gediend door een helder kader voor welstandsbeleid, dat breed wordt gedragen. Het beeldkwaliteitsplan kan daarbij een belangrijke ondersteuning vormen (lit. 57 'De schoonheid van Amsterdam’). Hiertoe is het noodzakelijk dat de formele status van het beeldkwaliteitsplan voor alle betrokkenen zo duidelijk mogelijk wordt gemaakt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Dit in het kader van het leeronderzoek specialisatie planologie, binnen de vakgroep toegepaste geografie en planologie, Faculteit der Ruimtelijke Wetenschappen, aan de Rijksuniversiteit Utrecht. Met dank aan mijn begeleider Peter Donkersloot. Rotterdam, oktober 1995." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "Hiervoor is enerzijds herkenbaarheid en duidelijkheid vereist, terwijl anderzijds diversiteit en rijkdom aan gebruiks- en interpretatiemogelijkheden de vormkwaliteit bepalen. (beeldkwaliteitsplan Breda). Als het onderwerp beeldkwaliteit aan de orde is, zou het hierover moeten gaan. Eigenschappen en kenmerken en het samenstel hiervan die tot een kwaliteit of diskwaliteit leiden en niet tot stijl of smaak." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Dit in het kader van het leeronderzoek specialisatie planologie, binnen de vakgroep toegepaste geografie en planologie, Faculteit der Ruimtelijke Wetenschappen, aan de Rijksuniversiteit Utrecht. Met dank aan mijn begeleider Peter Donkersloot. Rotterdam, oktober 1995. Jef Muhren." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743976 ;
            sgpl:spatialText "gemeente Zeist" ;
            sgpl:text_context "Verschillende diensten binnen gemeentes zouden het kunnen initiëren, in verschillende wetten zou er aandacht aan moeten/kunnen worden besteed (Wet Ruimtelijke Ordening, Woningwet, Monumentenwet etc.). In het beeldkwaliteitsplan voor de gemeente Zeist bijvoorbeeld worden deze drie lagen als volgt benoemd: - het kaartbeeld (lange termijn) (streek- en structuurplan-nivo); - ruimtebeeld (bestemmingsplannen, bouwplannen en beplantingsplannen); - stadsbeeld (tijdgebonden invloeden, kleur van de stad, detaille- ring). Ook in het 'Beeldkwaliteitsplan Schoonhoven' wordt een dergelijke driedeling aangehouden:" ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6517 ;
            sgpl:subjectText "beeldkwaliteitsplan" ;
            sgpl:text_context "Met de wens tot deregulering en decentralisatie heeft de rijksoverheid gemeend met een handleiding voor het maken van beeldkwaliteitsplannen en met aanzienlijke subsidies, gemeentelijk initiatief op dit terrein aan te moeten moedigen en te ondersteunen. In de nota ’Het Beeldkwaliteitsplan, instrument voor kwaliteitsbeleid’ is in 1992 een uitvoerige aanzet gegeven. Hierin is een middenweg gekozen tussen theorie en praktijk." ],
        [ sgpl:refersToConcept unesco:concept2214 ;
            sgpl:subjectText "beeldanalyse" ;
            sgpl:text_context "De beeldanalyse op zichzelf heeft een beleidsondersteunende functie en niet een juridische functie. De beeldanalyse vormt de eerste stap in de beleidsvorming, namelijk die van stedebouwkundig architectonisch vooronderzoek. Dit onderzoek kan als basis dienen voor het formuleren van beleid, bijvoorbeeld in de vorm van een beeldkwaliteitsplan of in andere vormen van beeldkwaliteitsbeleid." ],
        [ sgpl:refersToConcept unesco:concept1584 ;
            sgpl:subjectText "welstandszorg" ;
            sgpl:text_context "Op 10 mei jl. werd een delegatie van het bestuur van de Federatie Welstandstoezicht ontvangen door de Vaste Kamercommissie voor VROM. Gesproken werd over de ontwikkelingen van de welstandszorg en de ruimtelijke kwaliteitszorg in de gemeenten. Het naar voren trekken in het beleid en in de besluitvorming van de welstandszorg in de vorm van welstandscriteria en beeldkwaliteitsplannen wordt vanuit de commissie belangrijk gevonden." ],
        [ sgpl:refersToConcept unesco:concept1584 ;
            sgpl:subjectText "welstandszorg" ;
            sgpl:text_context "Op 10 mei jl. werd een delegatie van het bestuur van de Federatie Welstandstoezicht ontvangen door de Vaste Kamercommissie voor VROM. Gesproken werd over de ontwikkelingen van de welstandszorg en de ruimtelijke kwaliteitszorg in de gemeenten. Het naar voren trekken in het beleid en in de besluitvorming van de welstandszorg in de vorm van welstandscriteria en beeldkwaliteitsplannen wordt vanuit de commissie belangrijk gevonden." ],
        [ sgpl:refersToConcept unesco:concept2214 ;
            sgpl:subjectText "beeldanalyse" ;
            sgpl:text_context "De beeldanalyse op zichzelf heeft een beleidsondersteunende functie en niet een juridische functie. De beeldanalyse vormt de eerste stap in de beleidsvorming, namelijk die van stedebouwkundig architectonisch vooronderzoek. Dit onderzoek kan als basis dienen voor het formuleren van beleid, bijvoorbeeld in de vorm van een beeldkwaliteitsplan of in andere vormen van beeldkwaliteitsbeleid." ],
        [ sgpl:refersToConcept unesco:concept6517 ;
            sgpl:subjectText "beeldkwaliteitsplan" ;
            sgpl:text_context "Met de wens tot deregulering en decentralisatie heeft de rijksoverheid gemeend met een handleiding voor het maken van beeldkwaliteitsplannen en met aanzienlijke subsidies, gemeentelijk initiatief op dit terrein aan te moeten moedigen en te ondersteunen. In de nota ’Het Beeldkwaliteitsplan, instrument voor kwaliteitsbeleid’ is in 1992 een uitvoerige aanzet gegeven. Hierin is een middenweg gekozen tussen theorie en praktijk." ] ;
    sgpl:thesisID 302 .

sgpl:Thesis303 a sgpl:SGPLThesis ;
    dcterms:creator "H.J. Nijmeijer" ;
    dcterms:issued 1995 ;
    dcterms:title "Een onderzoek naar regionale verschillen in winstgevendheid van industriële bedrijven in Nederland.",
        "RESULTAAT EN REGIO" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279858 ;
            sgpl:spatialText "Groot-Rijnmond" ;
            sgpl:text_context "Er blijken op basis van dit materiaal onmiskenbaar regionale verschillen in winstgevendheid te bestaan. In de periode 1987-1991 doen vier gebieden (Delfzijl, Groot-Rijnmond, Zeeuwsch-Vlaanderen en Overig Zeeland) het veel beter dan gemiddeld. Vijf regio's doen het juist veel slechter: Noord-Friesland, Zuidwest-Friesland, Zuidoost-Drenthe, Delft en Westland en Zuidoost-Noord-Brabant." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Auteur : H.J. Nijmeijer. Plaats : Utrecht, Faculteit der Ruimtelijke Wetenschappen Universiteit Utrecht. Titel : Regio en resultaat." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746058 ;
            sgpl:spatialText "Twente" ;
            sgpl:text_context "In Delfzijl en omgeving en Zeeuwsch-Vlaanderen zijn maar weinig bedrijfsklassen (respectievelijk 4 en 2) substantieel vertegenwoordigd. Opmerkelijk is dat géén van de regio's met een technische universiteit (Delft en Westland, Zuidoost-Noord-Brabant en Twente) voorkomt in het rijtje van beter presterende gebieden. De vermeende invloed op het gebied van technische innovaties leidt op Corop-niveau niet tot een hogere winstgevendheid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757340 ;
            sgpl:spatialText "Delfzijl" ;
            sgpl:text_context "Er blijken op basis van dit materiaal onmiskenbaar regionale verschillen in winstgevendheid te bestaan. In de periode 1987-1991 doen vier gebieden (Delfzijl, Groot-Rijnmond, Zeeuwsch-Vlaanderen en Overig Zeeland) het veel beter dan gemiddeld. Vijf regio's doen het juist veel slechter: Noord-Friesland, Zuidwest-Friesland, Zuidoost-Drenthe, Delft en Westland en Zuidoost-Noord-Brabant." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Zuid-Limburg" ;
            sgpl:text_context "Daarnaast zijn er dus nog enkele Corop-gebieden aan te wijzen die sterk fluctuerende prestaties laten zien ('springers'). Zuidwest-Overijssel, IJmond en Zuid-Limburg tonen geen continu dalend of stijgend beeld, maar de prestaties wisselen sterk, soms zelfs in opeenvolgende jaren. De geconstateerde fluctuaties zijn bij twee van de drie regio's toe te schrijven aan één van de aanwezige bedrijfsklassen: de basis metaalindustrie in IJmond en de chemie in Zuid-Limburg." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Noord-Friesland" ;
            sgpl:text_context "Er blijken op basis van dit materiaal onmiskenbaar regionale verschillen in winstgevendheid te bestaan. In de periode 1987-1991 doen vier gebieden (Delfzijl, Groot-Rijnmond, Zeeuwsch-Vlaanderen en Overig Zeeland) het veel beter dan gemiddeld. Vijf regio's doen het juist veel slechter: Noord-Friesland, Zuidwest-Friesland, Zuidoost-Drenthe, Delft en Westland en Zuidoost-Noord-Brabant." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744633,
                geonames:2757345 ;
            sgpl:spatialText "Delft en Westland" ;
            sgpl:text_context "In Delfzijl en omgeving en Zeeuwsch-Vlaanderen zijn maar weinig bedrijfsklassen (respectievelijk 4 en 2) substantieel vertegenwoordigd. Opmerkelijk is dat géén van de regio's met een technische universiteit (Delft en Westland, Zuidoost-Noord-Brabant en Twente) voorkomt in het rijtje van beter presterende gebieden. De vermeende invloed op het gebied van technische innovaties leidt op Corop-niveau niet tot een hogere winstgevendheid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Zuidoost-Noord-Brabant" ;
            sgpl:text_context "Er blijken op basis van dit materiaal onmiskenbaar regionale verschillen in winstgevendheid te bestaan. In de periode 1987-1991 doen vier gebieden (Delfzijl, Groot-Rijnmond, Zeeuwsch-Vlaanderen en Overig Zeeland) het veel beter dan gemiddeld. Vijf regio's doen het juist veel slechter: Noord-Friesland, Zuidwest-Friesland, Zuidoost-Drenthe, Delft en Westland en Zuidoost-Noord-Brabant." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744000 ;
            sgpl:spatialText "Zeeuwsch-Vlaanderen" ;
            sgpl:text_context "Er blijken op basis van dit materiaal onmiskenbaar regionale verschillen in winstgevendheid te bestaan. In de periode 1987-1991 doen vier gebieden (Delfzijl, Groot-Rijnmond, Zeeuwsch-Vlaanderen en Overig Zeeland) het veel beter dan gemiddeld. Vijf regio's doen het juist veel slechter: Noord-Friesland, Zuidwest-Friesland, Zuidoost-Drenthe, Delft en Westland en Zuidoost-Noord-Brabant." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "perifere Noorden" ;
            sgpl:text_context "Zijn die werkelijk verschillend binnen Nederland? Doen bedrijven het in de Randstad beter dan in bijvoorbeeld het perifere Noorden (of juist slechter door agglomeratienadelen)? Wanneer er wel regionale verschillen in bedrijfseconomische prestaties binnen Nederland bestaan en deze niet verklaard worden door verschillen in produktiestructuur noch door verschillen in produktiemilieu dan blijft het de vraag wat de gevonden afwijkingen dan wel veroorzaakt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Faculteit der Ruimtelijke Wetenschappen. Een onderzoek naar regionale verschillen in winstgevendheid van industriële bedrijven in Nederland. RESULTAAT EN REGIO." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Zijn die werkelijk verschillend binnen Nederland? Doen bedrijven het in de Randstad beter dan in bijvoorbeeld het perifere Noorden (of juist slechter door agglomeratienadelen)? Wanneer er wel regionale verschillen in bedrijfseconomische prestaties binnen Nederland bestaan en deze niet verklaard worden door verschillen in produktiestructuur noch door verschillen in produktiemilieu dan blijft het de vraag wat de gevonden afwijkingen dan wel veroorzaakt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "IJmond" ;
            sgpl:text_context "Daarnaast zijn er dus nog enkele Corop-gebieden aan te wijzen die sterk fluctuerende prestaties laten zien ('springers'). Zuidwest-Overijssel, IJmond en Zuid-Limburg tonen geen continu dalend of stijgend beeld, maar de prestaties wisselen sterk, soms zelfs in opeenvolgende jaren. De geconstateerde fluctuaties zijn bij twee van de drie regio's toe te schrijven aan één van de aanwezige bedrijfsklassen: de basis metaalindustrie in IJmond en de chemie in Zuid-Limburg." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Corop-gebied" ;
            sgpl:text_context "Wanneer er wel regionale verschillen in bedrijfseconomische prestaties binnen Nederland bestaan en deze niet verklaard worden door verschillen in produktiestructuur noch door verschillen in produktiemilieu dan blijft het de vraag wat de gevonden afwijkingen dan wel veroorzaakt. Het onderzoek beperkt zich tot industriële bedrijven en het ruimtelijk schaalniveau is het Corop-gebied. Voor het meten van bedrijfseconomische prestaties is gekozen voor het bedrijfsresultaat (winst)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755457 ;
            sgpl:spatialText "Het Gooi en Vechtstreek" ;
            sgpl:text_context "Er zijn nog wel regio's waarvan de prestaties stijgen (o.a. Het Gooi en Vechtstreek) of dalen (o.a. Noord-Overijssel). In ieder geval blijkt dat de regionale verschillen in winstgevendheid niet volledig verklaard worden door de verschillen in produktiestructuur. Voor de beoordeling van de invloed van het regionale produktie-milieu op de regionale verschillen in winstgevendheid is een micro-analyse uitgevoerd op data-materiaal van de Produktiestatistiek van de industrie over het jaar 1992." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3402 ;
            sgpl:subjectText "produktiemilieu" ;
            sgpl:text_context "In ieder geval blijkt dat de regionale verschillen in winstgevendheid niet volledig verklaard worden door de verschillen in produktiestructuur. Voor de beoordeling van de invloed van het regionale produktiemilieu op de regionale verschillen in winstgevendheid is een micro-analyse uitgevoerd op data-materiaal van de Produktiestatistiek van de industrie over het jaar 1992. Omdat op dit niveau informatie beschikbaar is over de afschrijvingen, is winstgevendheid hier vertaald met netto bedrijfsresultaat gedeeld door de netto toegevoegde waarde." ],
        [ sgpl:refersToConcept unesco:concept8761 ;
            sgpl:subjectText "produktiestructuur" ;
            sgpl:text_context "De resultaten van de overige 25 regio's zijn dus gemiddeld of wijken slechts in beperkte mate af van het Nederlands gemiddelde. Met behulp van de indirecte standaardisatiemethode is vervolgens gekeken naar de invloed van de produktiestructuur. Na standaardisatie blijken er nog steeds regionale verschillen in prestaties te bestaan, hoewel deze wel kleiner zijn geworden." ],
        [ sgpl:refersToConcept unesco:concept10893 ;
            sgpl:subjectText "winstgevendheid" ;
            sgpl:text_context "Voor het regionaliseren van de variabelen van bedrijven met vestigingen in meerdere regio's wordt gebruik gemaakt van informatie uit arbeidsstatistieken. Er blijken op basis van dit materiaal onmiskenbaar regionale verschillen in winstgevendheid te bestaan. In de periode 1987-1991 doen vier gebieden (Delfzijl, Groot-Rijnmond, Zeeuwsch-Vlaanderen en Overig Zeeland) het veel beter dan gemiddeld." ],
        [ sgpl:refersToConcept unesco:concept10893 ;
            sgpl:subjectText "winstgevendheid" ;
            sgpl:text_context "Voor het regionaliseren van de variabelen van bedrijven met vestigingen in meerdere regio's wordt gebruik gemaakt van informatie uit arbeidsstatistieken. Er blijken op basis van dit materiaal onmiskenbaar regionale verschillen in winstgevendheid te bestaan. In de periode 1987-1991 doen vier gebieden (Delfzijl, Groot-Rijnmond, Zeeuwsch-Vlaanderen en Overig Zeeland) het veel beter dan gemiddeld." ],
        [ sgpl:refersToConcept unesco:concept3402 ;
            sgpl:subjectText "produktiemilieu" ;
            sgpl:text_context "In ieder geval blijkt dat de regionale verschillen in winstgevendheid niet volledig verklaard worden door de verschillen in produktiestructuur. Voor de beoordeling van de invloed van het regionale produktiemilieu op de regionale verschillen in winstgevendheid is een micro-analyse uitgevoerd op data-materiaal van de Produktiestatistiek van de industrie over het jaar 1992. Omdat op dit niveau informatie beschikbaar is over de afschrijvingen, is winstgevendheid hier vertaald met netto bedrijfsresultaat gedeeld door de netto toegevoegde waarde." ],
        [ sgpl:refersToConcept unesco:concept8761 ;
            sgpl:subjectText "produktiestructuur" ;
            sgpl:text_context "De resultaten van de overige 25 regio's zijn dus gemiddeld of wijken slechts in beperkte mate af van het Nederlands gemiddelde. Met behulp van de indirecte standaardisatiemethode is vervolgens gekeken naar de invloed van de produktiestructuur. Na standaardisatie blijken er nog steeds regionale verschillen in prestaties te bestaan, hoewel deze wel kleiner zijn geworden." ] ;
    sgpl:thesisID 303 .

sgpl:Thesis304 a sgpl:SGPLThesis ;
    dcterms:creator "Annemarie Overbeek" ;
    dcterms:issued 1995 ;
    dcterms:title "De Kempen en de Dommel",
        "Een regionaal geografische studie naar sociaal-economische ontwikkelingen en gevolgen voor het milieu" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "het Nederlandse gedeelte van de Boven-Dommel" ;
            sgpl:text_context "Omdat het binnen het tijdsbestek van mijn onderzoek onmogelijk is, het hele stroomgebied te onderzoeken op de sociaal-economische ontwikkeling, heb ik gekozen voor het stroomgebied van het Nederlandse gedeelte van de Boven-Dommel. Zie figuur 1.1. Daaronder vallen de volgende gemeenten: 1. Eindhoven, 2. Nuenen c.a., 3. Geldrop, 4. Waalre, 5. Veldhoven, 6. Vessem c.a., 7. Eersel, 8. Hoogeloon c.a., 9. Bladel-Netersel, 10. Reusel, 11. Riethoven, 12. Westerhoven, 13. Valkenswaard, 14. Bergeijk, 15. Luijksgestel, 16. Heeze, 17. Leende, 18. Maarheeze en 19. Budel." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "West- en Midden-Brabant" ;
            sgpl:text_context "Figuur 2.5a Toerisme in West- en Midden-Brabant, aantal overnachtingen 1988-1993. Figuur 2.5b Toerisme in West- en Midden-Brabant, procentueel t.o.v. Nederland, 1988-1993. Figuur 2.6a Werkforensisme op Eindhoven in % van arbeidsplaatsen per gemeente, 1982-1992." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "In 1920 annexeert ze de omliggende gemeenten en voor het eerst is er sprake van vestigingsoverschotten. Uit Noord-Nederland komen mensen naar De Kempen, hetgeen zorgt voor een verandering in de overheersende religie (Rooms Katholiek) en volksgewoonten. De omgeving van Eindhoven is na de tweede wereldoorlog sterk gegroeid door suburbanisatie vanuit Eindhoven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "de omgeving van Eindhoven" ;
            sgpl:text_context "Uit Noord-Nederland komen mensen naar De Kempen, hetgeen zorgt voor een verandering in de overheersende religie (Rooms Katholiek) en volksgewoonten. De omgeving van Eindhoven is na de tweede wereldoorlog sterk gegroeid door suburbanisatie vanuit Eindhoven. Ook de economie groeide: Door schaalvergroting, rationalisatie en technische ontwikkeling heeft de intensieve veehouderij en rundveehouderij een hoge vlucht genomen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "De schraalheid van de zandgronden leidde er toe dat, zodra mogelijk, er vanuit deze bedrijfjes er industriële ontwikkeling in de vorm van sigarenindustrie (Eersel, Valkenswaard), elektrotechniek (Eindhoven) en textiel (De Peel) ontstond. De lage lonen in Noord-Brabant speelden ook mee in de verschuiving van de textielindustrie vanuit het Westen van het land. Verder heeft de ontsluiting van het gebied door aanleg van de Zuid-Willemsvaart (1826) en in 1846 van het Eindhovens Kanaal aan de industriële ontwikkeling mee geholpen (Brand, 1937, p.13)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "stroomgebied van de Boven-Dommel" ;
            sgpl:text_context "Omdat het binnen het tijdsbestek van mijn onderzoek onmogelijk is, het hele stroomgebied te onderzoeken op de sociaal-economische ontwikkeling, heb ik gekozen voor het stroomgebied van het Nederlandse gedeelte van de Boven-Dommel. Zie figuur 1.1. Daaronder vallen de volgende gemeenten: 1. Eindhoven, 2. Nuenen c.a., 3. Geldrop, 4. Waalre, 5. Veldhoven, 6. Vessem c.a., 7. Eersel, 8. Hoogeloon c.a., 9. Bladel-Netersel, 10. Reusel, 11. Riethoven, 12. Westerhoven, 13. Valkenswaard, 14. Bergeijk, 15. Luijksgestel, 16. Heeze, 17. Leende, 18. Maarheeze en 19. Budel." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Binnen dit grote project worden deelprojecten uitgevoerd. Een aantal milieukundigen van de faculteit Ruimtelijke Wetenschappen, Universiteit Utrecht, inventariseert de milieuproblematiek in het stroomgebied van de Dommel, een ecoloog brengt de vegetatie-ontwikkeling in kaart en alles wordt uiteindelijk in een Geografisch Informatie Systeem gecombineerd. Om tot een goed beleid te komen zullen ook de sociaal-economische activiteiten, hun economische functie en hun invloed op het milieu in het stroomgebied van de Dommel onderzocht worden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2794575 ;
            sgpl:spatialText "De Kempen" ;
            sgpl:text_context "De Kempen, waarvan het stroomgebied van de Dommel onderdeel is, is vanouds her een agrarisch gebied geweest. Het gebied was altijd op zich zelf staand en geïsoleerd van de rest van Nederland en België. De bestuurlijke structuur heeft de isolatie en het achterblijven in de ontwikkeling versterkt: In het zuidelijk deel van de Kempen hebben zelfstandige, niet op samenwerking gerichte provincies ervoor gezorgd, dat geen gezamenlijke ontginningen plaats vonden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept207 ;
            sgpl:subjectText "milieuproblematiek" ;
            sgpl:text_context "Binnen dit grote project worden deelprojecten uitgevoerd. Een aantal milieukundigen van de faculteit Ruimtelijke Wetenschappen, Universiteit Utrecht, inventariseert de milieuproblematiek in het stroomgebied van de Dommel, een ecoloog brengt de vegetatie-ontwikkeling in kaart en alles wordt uiteindelijk in een Geografisch Informatie Systeem gecombineerd. Om tot een goed beleid te komen zullen ook de sociaal-economische activiteiten, hun economische functie en hun invloed op het milieu in het stroomgebied van de Dommel onderzocht worden." ],
        [ sgpl:refersToConcept unesco:concept594 ;
            sgpl:subjectText "sociaal-economische ontwikkelingen" ;
            sgpl:text_context "In het kader van de studie regionale geografie is deze scriptie tot stand gekomen. Voor U ligt het afstudeerverslag over sociaal-economische ontwikkelingen in een aantal gemeenten in het stroomgebied van de Boven-Dommel en de gevolgen daarvan voor het milieu. Aanleiding voor de keuze van dit onderwerp was mijn interesse voor water, die opgewekt was tijdens het bijvak fysische geografie." ],
        [ sgpl:refersToConcept unesco:concept1723 ;
            sgpl:subjectText "mestoverschot" ;
            sgpl:text_context "Vóór de mestwetgeving werd de overtollige mest geëxporteerd naar nabijgelegen gebieden (lage transportkosten) gedumpt op land, dat primair bestemd was voor mestafzet (Waajen, 1985, p.29). Het is gebleken, dat er een aanzienlijk mestoverschot in het gebied is. De gegevens zijn wel geflatteerd, omdat de effecten van distributie hierin niet zijn meegenomen." ],
        [ sgpl:refersToConcept unesco:concept594 ;
            sgpl:subjectText "sociaal-economische ontwikkelingen" ;
            sgpl:text_context "In het kader van de studie regionale geografie is deze scriptie tot stand gekomen. Voor U ligt het afstudeerverslag over sociaal-economische ontwikkelingen in een aantal gemeenten in het stroomgebied van de Boven-Dommel en de gevolgen daarvan voor het milieu. Aanleiding voor de keuze van dit onderwerp was mijn interesse voor water, die opgewekt was tijdens het bijvak fysische geografie." ],
        [ sgpl:refersToConcept unesco:concept207 ;
            sgpl:subjectText "milieuproblematiek" ;
            sgpl:text_context "Binnen dit grote project worden deelprojecten uitgevoerd. Een aantal milieukundigen van de faculteit Ruimtelijke Wetenschappen, Universiteit Utrecht, inventariseert de milieuproblematiek in het stroomgebied van de Dommel, een ecoloog brengt de vegetatie-ontwikkeling in kaart en alles wordt uiteindelijk in een Geografisch Informatie Systeem gecombineerd. Om tot een goed beleid te komen zullen ook de sociaal-economische activiteiten, hun economische functie en hun invloed op het milieu in het stroomgebied van de Dommel onderzocht worden." ],
        [ sgpl:refersToConcept unesco:concept1723 ;
            sgpl:subjectText "mestoverschot" ;
            sgpl:text_context "Vóór de mestwetgeving werd de overtollige mest geëxporteerd naar nabijgelegen gebieden (lage transportkosten) gedumpt op land, dat primair bestemd was voor mestafzet (Waajen, 1985, p.29). Het is gebleken, dat er een aanzienlijk mestoverschot in het gebied is. De gegevens zijn wel geflatteerd, omdat de effecten van distributie hierin niet zijn meegenomen." ] ;
    sgpl:thesisID 304 .

sgpl:Thesis305 a sgpl:SGPLThesis ;
    dcterms:creator "Tjeerd Roosjen" ;
    dcterms:issued 1995 ;
    dcterms:title "De Geografie van de Wielersport" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2802361 ;
            sgpl:spatialText "België" ;
            sgpl:text_context "De nadruk ligt daarbij op de ontwikkelingen in Nederland, die lange tijd sterk verschilden met die in de rest van West-Europa. Zo was het wielrennen op de weg in Nederland lange tijd verboden, terwijl in België, Italië en Frankrijk toen de bekende klassiekers ontstonden. Hoofdstuk drie is het eerste echt geografische hoofdstuk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3175395 ;
            sgpl:spatialText "Italië" ;
            sgpl:text_context "De nadruk ligt daarbij op de ontwikkelingen in Nederland, die lange tijd sterk verschilden met die in de rest van West-Europa. Zo was het wielrennen op de weg in Nederland lange tijd verboden, terwijl in België, Italië en Frankrijk toen de bekende klassiekers ontstonden. Hoofdstuk drie is het eerste echt geografische hoofdstuk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Friesland" ;
            sgpl:text_context "Na zo’n twintig jaar is het eindelijk weer zover; de opvolger van Reinier Paping zal over een aantal uren bekend zijn. Reeds weken heerst in Nederland (en in Friesland in het bijzonder) de unieke ‘Elfstedenkoorts’: hoe meer het vriest, des te meer ontdooien de Friezen. Gespannen heeft men de afgelopen twee weken het weerbericht in de gaten gehouden, tot eindelijk alle rayonhoofden hun fiat geven voor de tocht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "In het tweede hoofdstuk wordt de wielerhistorie doorlopen, voor zover dat voor een geografische scriptie van belang is. De nadruk ligt daarbij op de ontwikkelingen in Nederland, die lange tijd sterk verschilden met die in de rest van West-Europa. Zo was het wielrennen op de weg in Nederland lange tijd verboden, terwijl in België, Italië en Frankrijk toen de bekende klassiekers ontstonden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Clubs van de tweede garnituur hebben het daar erg moeilijk en opheffingen en faillissementen komen daar meer voor dan elders (Volkers & Van Dam 1992). De situatie in het Nederlandse betaald voetbal in de Randstad duidt daar al op; men is daar grofweg Ajax- of Feyenoord-supporter. De op handen zijnde verhuizing van Sparta uit Spangen kan in dit licht bezien worden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "Overijssel" ;
            sgpl:text_context "Dat daarbij Noord-Brabant als het wielerhart van Nederland naar voren komt, zal de insiders nauwelijks verbazen. Verrassender is de opkomst van Gelderland en Overijssel als wielerprovincies. In hoofdstuk vier staan de economische aspecten van de wielersport centraal." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "In de eerste paragraaf worden enkele typisch geografische begrippen in een wielercontext geplaatst, waarna het verdere hoofdstuk zich toespitst op de plaats van de wielersport binnen de Nederlandse sportwereld en de spreiding van het wielrennen over Nederland. Dat daarbij Noord-Brabant als het wielerhart van Nederland naar voren komt, zal de insiders nauwelijks verbazen. Verrassender is de opkomst van Gelderland en Overijssel als wielerprovincies." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "het Oostblok" ;
            sgpl:text_context "Het blijkt dat dit nogal tegenvalt; weliswaar zijn er momenteel meer nationaliteiten in het profpeloton aanwezig dan in de jaren ’60, maar dit is vooral te danken aan de ontwikkelingen in het Oostblok. Het is nog te vroeg’ om de FICP-plannen als mislukt te bestempelen, maar erg veel heeft men nog niet bereikt. Tenslotte wordt in hoofdstuk zes een antwoord gegeven op de hoofdvraag van de scriptie- hoe bruikbaar is sportgeografie voor wielrennen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "Groningen" ;
            sgpl:text_context "Het vinden van een begeleider die enigszins thuis was in deze materie viel ook niet mee. Bij de Faculteit der Ruimtelijke Wetenschappen in Groningen waren wel enthousiaste geluiden te horen over mijn streven het in Nederland nog vrijwel onontgonnen terrein der sportgeografie verder te verkennen. Na enkele gesprekken op mijn thuisbasis bleek echter al snel dat men mijn plan in een ‘recreatie & toerisme’-jasje wilde passen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3017382 ;
            sgpl:spatialText "Frankrijk" ;
            sgpl:text_context "De nadruk ligt daarbij op de ontwikkelingen in Nederland, die lange tijd sterk verschilden met die in de rest van West-Europa. Zo was het wielrennen op de weg in Nederland lange tijd verboden, terwijl in België, Italië en Frankrijk toen de bekende klassiekers ontstonden. Hoofdstuk drie is het eerste echt geografische hoofdstuk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelderland" ;
            sgpl:text_context "Dat daarbij Noord-Brabant als het wielerhart van Nederland naar voren komt, zal de insiders nauwelijks verbazen. Verrassender is de opkomst van Gelderland en Overijssel als wielerprovincies. In hoofdstuk vier staan de economische aspecten van de wielersport centraal." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Voor u ligt een scriptie waarin wordt getracht een aanzet te geven tot het vormen van een geografie van de wielersport. Veruit de meerderheid van geografisch Nederland zal bij het horen van een dergelijk onderwerp eens flink de wenkbrauwen fronsen. \"Sportgeografie. Wat moet ik mij daar bij voorstellen?\", zullen velen zich afvragen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4374 ;
            sgpl:subjectText "Sponsoring" ;
            sgpl:text_context "In hoofdstuk vier staan de economische aspecten van de wielersport centraal. Eerst wordt een beschouwing gegeven over sponsoring in het algemeen en welke zaken daarbij komen kijken. Aan de hand van een model wordt aangetoond dat wielrennen een redelijk sponsorvriendelijke sport is, maar wel overvleugeld dreigt te worden door moderne, snellere en dynamischer sporten." ],
        [ sgpl:refersToConcept unesco:concept11547 ;
            sgpl:subjectText "Mondialisering" ;
            sgpl:text_context "Hoofdstuk vijf behandelt de mondialisering van de wielersport, zoals de internationaliseringstrend in het wielrennen wordt genoemd. Een gedeelte waarin de doelstellingen van de FICP (de profsectie van de internationale wielerunie) worden uiteengezet wat betreft de mondialisering, opent het hoofdstuk. Vervolgens wordt door middel van een aantal cases onderzocht hoever de mondialisering is gevorderd en hoe succesvol de FICP is geweest bij zijn streven om de wielersport een internationaal karakter te geven." ],
        [ sgpl:refersToConcept unesco:concept11415 ;
            sgpl:subjectText "Sportgeografie" ;
            sgpl:text_context "In deze doctoraalscriptie staat de toepasbaarheid van de sportgeografie op de wielersport centraal. Sportgeografie is een tak van de geografie die vooral is geworteld in de Angelsaksische landen. In Nederland zijn op dit gebied nog vrijwel geen artikelen verschenen, behoudens enkele over betaald voetbal en de Elfstedentocht." ],
        [ sgpl:refersToConcept unesco:concept11547 ;
            sgpl:subjectText "Mondialisering" ;
            sgpl:text_context "Hoofdstuk vijf behandelt de mondialisering van de wielersport, zoals de internationaliseringstrend in het wielrennen wordt genoemd. Een gedeelte waarin de doelstellingen van de FICP (de profsectie van de internationale wielerunie) worden uiteengezet wat betreft de mondialisering, opent het hoofdstuk. Vervolgens wordt door middel van een aantal cases onderzocht hoever de mondialisering is gevorderd en hoe succesvol de FICP is geweest bij zijn streven om de wielersport een internationaal karakter te geven." ],
        [ sgpl:refersToConcept unesco:concept11415 ;
            sgpl:subjectText "Sportgeografie" ;
            sgpl:text_context "In deze doctoraalscriptie staat de toepasbaarheid van de sportgeografie op de wielersport centraal. Sportgeografie is een tak van de geografie die vooral is geworteld in de Angelsaksische landen. In Nederland zijn op dit gebied nog vrijwel geen artikelen verschenen, behoudens enkele over betaald voetbal en de Elfstedentocht." ],
        [ sgpl:refersToConcept unesco:concept4374 ;
            sgpl:subjectText "Sponsoring" ;
            sgpl:text_context "In hoofdstuk vier staan de economische aspecten van de wielersport centraal. Eerst wordt een beschouwing gegeven over sponsoring in het algemeen en welke zaken daarbij komen kijken. Aan de hand van een model wordt aangetoond dat wielrennen een redelijk sponsorvriendelijke sport is, maar wel overvleugeld dreigt te worden door moderne, snellere en dynamischer sporten." ] ;
    sgpl:thesisID 305 .

sgpl:Thesis306 a sgpl:SGPLThesis ;
    dcterms:creator "Claudia Schutte" ;
    dcterms:issued 1995 ;
    dcterms:title "Op zoek naar de ontbrekende schakel tussen opleiding en praktijk",
        "Planologen aan het werk met planningmethoden" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Zuid-Duitsland" ;
            sgpl:text_context "In Nederland moet de Hogesnelheidslijn (HSL) Amsterdam met Parijs verbinden via Schiphol, Rotterdam, Antwerpen en Brussel. Hierbij is zowel de relatie met Brussel, Parijs (aansluiting op het reeds bestaande net van hogesnelheidslijnen), Londen en Frankrijk aan de orde als de mogelijke snelle railverbinding van de Randstad met het Ruhrgebied en Zuid-Duitsland. De verdere afweging zal wat betreft de lijn Amsterdam-Parijs plaatsvinden in de planologische kernbeslissing en de tracé nota voor deze hogesnelheidslijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Parijs" ;
            sgpl:text_context "Zulke treinen rijden onder andere in Frankrijk al op bepaalde trajecten en zijn daar bekend als Train a Grande Vitesse (TGV). In Nederland moet de Hogesnelheidslijn (HSL) Amsterdam met Parijs verbinden via Schiphol, Rotterdam, Antwerpen en Brussel. Hierbij is zowel de relatie met Brussel, Parijs (aansluiting op het reeds bestaande net van hogesnelheidslijnen), Londen en Frankrijk aan de orde als de mogelijke snelle railverbinding van de Randstad met het Ruhrgebied en Zuid-Duitsland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Zulke treinen rijden onder andere in Frankrijk al op bepaalde trajecten en zijn daar bekend als Train a Grande Vitesse (TGV). In Nederland moet de Hogesnelheidslijn (HSL) Amsterdam met Parijs verbinden via Schiphol, Rotterdam, Antwerpen en Brussel. Hierbij is zowel de relatie met Brussel, Parijs (aansluiting op het reeds bestaande net van hogesnelheidslijnen), Londen en Frankrijk aan de orde als de mogelijke snelle railverbinding van de Randstad met het Ruhrgebied en Zuid-Duitsland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "Groningen" ;
            sgpl:text_context "De opleidingen, die in dit onderzoek onderzocht worden, zijn weergegeven als kleinere cirkels die verbonden zijn met de grote cirkel van opleidingen. Er zijn vier (universitaire) planologie-opleidingenonderzocht: Utrecht, Nijmegen, Amsterdam en Groningen. De planningspraktijk speelt zich af op drie ruimtelijke schaalniveau's: het nationale niveau, het regionale niveau en het lokale niveau." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "stadsgewest Amsterdam" ;
            sgpl:text_context "De uitvoering geschiedt in de vorm van landinrichtingsprojecten, een groenschap en door middel van publiek-private- samenwerking. In het uitvoeringsconvenant worden afspraken gemaakt over de realisatie van alle bouwlokaties in het stadsgewest Amsterdam. Hierbij zijn betrokken het Rijk, de provincies Noord-Holland en Flevoland, het Regionaal Orgaan Amsterdam (ROA) en de vijf bouwgemeenten (Almere, Purmerend, Amsterdam, Haarlemmermeer en Zaanstad)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754999 ;
            sgpl:spatialText "gemeente Haarlemmermeer" ;
            sgpl:text_context "De Provincie Noord-Holland heeft beginjaren '90 besloten dat er in plaats van zes, twee streekplangebieden moeten komen, één voor het noorden van de provincie en één voor het zuiden. Vooruitlopend op het nieuwe streekplan Noord-Holland-Zuid, heeft de provincie besloten een herziening te maken van het oude streekplan voor het grondgebied van de gemeente Haarlemmermeer. Dit gezien het feit dat er in de gemeente Haarlemmermeer en omgeving zo veel veranderingen voltrokken zijn en het gebied in de toekomst grote (waaronder ook nadelige) ontwikkelingen zal ondergaan als gevolg van de ontwikkeling van de luchthaven Schiphol." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757345 ;
            sgpl:spatialText "gemeente Delft" ;
            sgpl:text_context "De Ontwikkelingsvisie Delft is een plan op lokaal niveau. Het plan betreft het gehele grondgebied van de gemeente Delft. De Ontwikkelingsvisie Delft, welke een structuurschets genoemd wordt, is geen officiële planfiguur uit de Ruimtelijk Ordening (althans niet op lokaal niveau), maar een plan in de categorie \"pseudo-structuurplan8\"." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmegen" ;
            sgpl:text_context "De opleidingen, die in dit onderzoek onderzocht worden, zijn weergegeven als kleinere cirkels die verbonden zijn met de grote cirkel van opleidingen. Er zijn vier (universitaire) planologie-opleidingenonderzocht: Utrecht, Nijmegen, Amsterdam en Groningen. De planningspraktijk speelt zich af op drie ruimtelijke schaalniveau's: het nationale niveau, het regionale niveau en het lokale niveau." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6544262 ;
            sgpl:spatialText "Midden Delfland" ;
            sgpl:text_context "De randen van Delft kennen twee karakters. Aan de noordelijke helft bestaat de rand uit kassen (economische factor) en parken (fysiek-ruimtelijke factor) aansluitend op de Haagse karakteristiek en aan de zuidelijke helft uit het open weide gebied Midden Delfland (fysiek-ruimtelijke factor) met oude boerderijlinten (sociaal, fysiek-ruimtelijke factor) die de stad insteken. Ruimtelijk gezien past Delft in het Haagse systeem van woningbouw afgewisseld met parken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelderland" ;
            sgpl:text_context "Het initiatief voor zo'n gecoördineerde aanpak wordt eind 1987 genomen door de provincie Gelderland (politiek-bestuurlijke actor) naar aanleiding van een discussie in Provinciale Staten over de gevolgen van het streekplan Veluwe en het Provinciaal Milieubeleidsplan. Het ROM gebied Gelderse Vallei is gelegen op het grensvlak van de provincies Utrecht en Gelderland (actoren) en is daarom een plan op inter-regionaal niveau. Het is een overwegend agrarisch gebied dat ingeklemd ligt tussen twee grote natuurgebieden, de Utrechtse Heuvelrug aan de westelijke zijde en het Centraal Veluws Natuurgebied aan de oostelijke zijde." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het is een plan op nationaal niveau en dient het algemeen belang. De Nederlandse regering heeft besloten dat er in Nederland een Hoge Snelheidstrein/lijn moet komen in aansluiting op het Europese netwerk van supersnelle treinen. Zulke treinen rijden onder andere in Frankrijk al op bepaalde trajecten en zijn daar bekend als Train a Grande Vitesse (TGV)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Zulke treinen rijden onder andere in Frankrijk al op bepaalde trajecten en zijn daar bekend als Train a Grande Vitesse (TGV). In Nederland moet de Hogesnelheidslijn (HSL) Amsterdam met Parijs verbinden via Schiphol, Rotterdam, Antwerpen en Brussel. Hierbij is zowel de relatie met Brussel, Parijs (aansluiting op het reeds bestaande net van hogesnelheidslijnen), Londen en Frankrijk aan de orde als de mogelijke snelle railverbinding van de Randstad met het Ruhrgebied en Zuid-Duitsland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "stadsregio Breda" ;
            sgpl:text_context "Dit geldt ten eerste voor de docenten Tejo Spit (Universiteit Utrecht), Peter de Klein (Katholieke Universiteit Nijmegen), Henk de Feijter (Universiteit van Amsterdam) en Paul Ike (Universiteit Groningen), die informatie gaven over het methodenonderwijs aan de verschillende universiteiten. Dit geldt ook voor de \"planologen aan het werk\": Evelien van Hercules (Project Hoge Snelheidslijn), Jacque Ninhaber (Streekplanherziening Haarlemmermeer), Jos Verweij (Plan van Aanpak Gelderse Vallei), Dhr. C. Paans (Toekomstvisie op de stadsregio Breda) en Hilde Blank (Ontwikkelingsvisie Delft). Met name Hilde Blank zou ik willen bedanken voor haar enthousiaste en openhartige verhalen over haar ervaring met de \"ins\" en \"outs\" van de planningspraktijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Groene Hart" ;
            sgpl:text_context "Maximal 10000 woningen mochten binnen het gebied van 35 Ke5- geluidzone als handhavingszone liggen, en er mochten geen bouwlokaties voorkomen binnen de 30 Ke behorende bij de geluidzone van 12600 woningen van het 5-banenstelsel (Ontwerp Streekplanherziening Haarlemmermeer, 1994, p.22). Een derde onderdeel van de planproblematiek wordt gevormd door de landbouw (fysiek-ruimtelijk, economische factor) en verschillende functies waarin het Groene Hart (fysiek-ruimtelijke factor) moet voorzien. Binnen het Groene Hart moesten een aantal functies een plaats vinden zoals natuur (fysiek-ruimtelijke factor), landschap (fysiek-ruimtelijke factor) en recreatie (sociaal, economisch en fysiek-ruimtelijke factor) en integrale groenontwikkeling zoals aangegeven in het Structuurschema Groene Ruimte (fysiek-ruimtelijke factor)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2843198 ;
            sgpl:spatialText "Ruhrgebied" ;
            sgpl:text_context "In Nederland moet de Hogesnelheidslijn (HSL) Amsterdam met Parijs verbinden via Schiphol, Rotterdam, Antwerpen en Brussel. Hierbij is zowel de relatie met Brussel, Parijs (aansluiting op het reeds bestaande net van hogesnelheidslijnen), Londen en Frankrijk aan de orde als de mogelijke snelle railverbinding van de Randstad met het Ruhrgebied en Zuid-Duitsland. De verdere afweging zal wat betreft de lijn Amsterdam-Parijs plaatsvinden in de planologische kernbeslissing en de tracé nota voor deze hogesnelheidslijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "De opleidingen, die in dit onderzoek onderzocht worden, zijn weergegeven als kleinere cirkels die verbonden zijn met de grote cirkel van opleidingen. Er zijn vier (universitaire) planologie-opleidingenonderzocht: Utrecht, Nijmegen, Amsterdam en Groningen. De planningspraktijk speelt zich af op drie ruimtelijke schaalniveau's: het nationale niveau, het regionale niveau en het lokale niveau." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745666 ;
            sgpl:spatialText "Centraal Veluws Natuurgebied" ;
            sgpl:text_context "Het ROM gebied Gelderse Vallei is gelegen op het grensvlak van de provincies Utrecht en Gelderland (actoren) en is daarom een plan op inter-regionaal niveau. Het is een overwegend agrarisch gebied dat ingeklemd ligt tussen twee grote natuurgebieden, de Utrechtse Heuvelrug aan de westelijke zijde en het Centraal Veluws Natuurgebied aan de oostelijke zijde. In noordelijke richting strekt het gebied zich uit tot aan de Randmeren." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757345 ;
            sgpl:spatialText "Delft" ;
            sgpl:text_context "Dit geldt ten eerste voor de docenten Tejo Spit (Universiteit Utrecht), Peter de Klein (Katholieke Universiteit Nijmegen), Henk de Feijter (Universiteit van Amsterdam) en Paul Ike (Universiteit Groningen), die informatie gaven over het methodenonderwijs aan de verschillende universiteiten. Dit geldt ook voor de \"planologen aan het werk\": Evelien van Hercules (Project Hoge Snelheidslijn), Jacque Ninhaber (Streekplanherziening Haarlemmermeer), Jos Verweij (Plan van Aanpak Gelderse Vallei), Dhr. C. Paans (Toekomstvisie op de stadsregio Breda) en Hilde Blank (Ontwikkelingsvisie Delft). Met name Hilde Blank zou ik willen bedanken voor haar enthousiaste en openhartige verhalen over haar ervaring met de \"ins\" en \"outs\" van de planningspraktijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "De opleidingen, die in dit onderzoek onderzocht worden, zijn weergegeven als kleinere cirkels die verbonden zijn met de grote cirkel van opleidingen. Er zijn vier (universitaire) planologie-opleidingenonderzocht: Utrecht, Nijmegen, Amsterdam en Groningen. De planningspraktijk speelt zich af op drie ruimtelijke schaalniveau's: het nationale niveau, het regionale niveau en het lokale niveau." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2800866 ;
            sgpl:spatialText "Brussel" ;
            sgpl:text_context "Zulke treinen rijden onder andere in Frankrijk al op bepaalde trajecten en zijn daar bekend als Train a Grande Vitesse (TGV). In Nederland moet de Hogesnelheidslijn (HSL) Amsterdam met Parijs verbinden via Schiphol, Rotterdam, Antwerpen en Brussel. Hierbij is zowel de relatie met Brussel, Parijs (aansluiting op het reeds bestaande net van hogesnelheidslijnen), Londen en Frankrijk aan de orde als de mogelijke snelle railverbinding van de Randstad met het Ruhrgebied en Zuid-Duitsland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754999 ;
            sgpl:spatialText "Haarlemmermeer" ;
            sgpl:text_context "Dit geldt ten eerste voor de docenten Tejo Spit (Universiteit Utrecht), Peter de Klein (Katholieke Universiteit Nijmegen), Henk de Feijter (Universiteit van Amsterdam) en Paul Ike (Universiteit Groningen), die informatie gaven over het methodenonderwijs aan de verschillende universiteiten. Dit geldt ook voor de \"planologen aan het werk\": Evelien van Hercules (Project Hoge Snelheidslijn), Jacque Ninhaber (Streekplanherziening Haarlemmermeer), Jos Verweij (Plan van Aanpak Gelderse Vallei), Dhr. C. Paans (Toekomstvisie op de stadsregio Breda) en Hilde Blank (Ontwikkelingsvisie Delft). Met name Hilde Blank zou ik willen bedanken voor haar enthousiaste en openhartige verhalen over haar ervaring met de \"ins\" en \"outs\" van de planningspraktijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincies Utrecht" ;
            sgpl:text_context "Het initiatief voor zo'n gecoördineerde aanpak wordt eind 1987 genomen door de provincie Gelderland (politiek-bestuurlijke actor) naar aanleiding van een discussie in Provinciale Staten over de gevolgen van het streekplan Veluwe en het Provinciaal Milieubeleidsplan. Het ROM gebied Gelderse Vallei is gelegen op het grensvlak van de provincies Utrecht en Gelderland (actoren) en is daarom een plan op inter-regionaal niveau. Het is een overwegend agrarisch gebied dat ingeklemd ligt tussen twee grote natuurgebieden, de Utrechtse Heuvelrug aan de westelijke zijde en het Centraal Veluws Natuurgebied aan de oostelijke zijde." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "De dubbele oriëntatie op zowel Den Haag als Rotterdam biedt Delft een woonmilieu vlakbij grootstedelijke voorzieningen. Echter door de verbindingslijnen (fysiek-ruimtelijke factor) tussen Rotterdam en Den Haag, zoals de snelwegen, de Schie en het spoor, wordt Delft in plakjes gedeeld waardoor aparte gebieden ontstaan. Alleen ter hoogte van de binnenstad staan de oostelijke en westelijke stadsdelen in direct contact met elkaar." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755622 ;
            sgpl:spatialText "Gelderse Vallei" ;
            sgpl:text_context "Dit geldt ten eerste voor de docenten Tejo Spit (Universiteit Utrecht), Peter de Klein (Katholieke Universiteit Nijmegen), Henk de Feijter (Universiteit van Amsterdam) en Paul Ike (Universiteit Groningen), die informatie gaven over het methodenonderwijs aan de verschillende universiteiten. Dit geldt ook voor de \"planologen aan het werk\": Evelien van Hercules (Project Hoge Snelheidslijn), Jacque Ninhaber (Streekplanherziening Haarlemmermeer), Jos Verweij (Plan van Aanpak Gelderse Vallei), Dhr. C. Paans (Toekomstvisie op de stadsregio Breda) en Hilde Blank (Ontwikkelingsvisie Delft). Met name Hilde Blank zou ik willen bedanken voor haar enthousiaste en openhartige verhalen over haar ervaring met de \"ins\" en \"outs\" van de planningspraktijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "In Nederland moet de Hogesnelheidslijn (HSL) Amsterdam met Parijs verbinden via Schiphol, Rotterdam, Antwerpen en Brussel. Hierbij is zowel de relatie met Brussel, Parijs (aansluiting op het reeds bestaande net van hogesnelheidslijnen), Londen en Frankrijk aan de orde als de mogelijke snelle railverbinding van de Randstad met het Ruhrgebied en Zuid-Duitsland. De verdere afweging zal wat betreft de lijn Amsterdam-Parijs plaatsvinden in de planologische kernbeslissing en de tracé nota voor deze hogesnelheidslijn." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "strategische planning" ;
            sgpl:text_context "Daarnaast zal in de toekomst ook een beroep gedaan moeten worden op de burger. In de periode van de strategische planning zal \"planning niet exclusief of zelfs overwegend een overheidsaangelegenheid zijn\" (Kreukels, 1985, p.312 en Kreukels en Simonis red., 1988, p.11). Vanaf de jaren '80 zijn overheid, bedrijfsleven en wetenschap zeer nauw met elkaar gaan samenwerken." ],
        [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "planningmethoden" ;
            sgpl:text_context "Zoals uit paragraaf 1.2 van dit hoofdstuk zal blijken, worden de ontwikkelingen in de maatschappij gereflecteerd in de planningtheorie, die via de planningmethodologie doordringt tot de planningmethoden. In elke periode in de planologie kan daardoor een specifieke \"instrumenten-kist\" aan methoden onderscheiden worden. De planningspraktijk staat dicht bij maatschappelijke ontwikkelingen." ],
        [ sgpl:refersToConcept unesco:concept538 ;
            sgpl:subjectText "blauwdrukplanning" ;
            sgpl:text_context "Er werd als het ware een blauwdruk van de toekomst gegeven. Vandaar dat dit soort planning ook wel blauwdrukplanning wordt genoemd (Kreukels, colleges KTPT, 1992). Het waren plannen waaruit het optimisme spreekt van de welvaartstaat (de maakbare samenleving) en de technische vooruitgang (niet alleen technische problemen konden worden opgelost, maar ook sociale problemen)." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "strategische planning" ;
            sgpl:text_context "Daarnaast zal in de toekomst ook een beroep gedaan moeten worden op de burger. In de periode van de strategische planning zal \"planning niet exclusief of zelfs overwegend een overheidsaangelegenheid zijn\" (Kreukels, 1985, p.312 en Kreukels en Simonis red., 1988, p.11). Vanaf de jaren '80 zijn overheid, bedrijfsleven en wetenschap zeer nauw met elkaar gaan samenwerken." ],
        [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "planningmethoden" ;
            sgpl:text_context "Zoals uit paragraaf 1.2 van dit hoofdstuk zal blijken, worden de ontwikkelingen in de maatschappij gereflecteerd in de planningtheorie, die via de planningmethodologie doordringt tot de planningmethoden. In elke periode in de planologie kan daardoor een specifieke \"instrumenten-kist\" aan methoden onderscheiden worden. De planningspraktijk staat dicht bij maatschappelijke ontwikkelingen." ],
        [ sgpl:refersToConcept unesco:concept538 ;
            sgpl:subjectText "blauwdrukplanning" ;
            sgpl:text_context "Er werd als het ware een blauwdruk van de toekomst gegeven. Vandaar dat dit soort planning ook wel blauwdrukplanning wordt genoemd (Kreukels, colleges KTPT, 1992). Het waren plannen waaruit het optimisme spreekt van de welvaartstaat (de maakbare samenleving) en de technische vooruitgang (niet alleen technische problemen konden worden opgelost, maar ook sociale problemen)." ] ;
    sgpl:thesisID 306 .

sgpl:Thesis307 a sgpl:SGPLThesis ;
    dcterms:creator "M. Yaman" ;
    dcterms:issued 1995 ;
    dcterms:title "Kartografische Animaties",
        "een theoretisch kader" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Verenigde Staten" ;
            sgpl:text_context "Audiences conditioned to animated performances are apt to find a series of static maps which attempt to illustrate changing phenomena, less than satisfactory. In de Verenigde Staten was er vooral van de kant van de militaire educatie, maar ook vanuit de industrie en het onderwijs, veel belangstelling voor educatieve animatie als onderdeel van audiovisuele communicatie. Animatie werd vooral toegepast bij de bestudering van processen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:4990729 ;
            sgpl:spatialText "Detroit" ;
            sgpl:text_context "Zij maakten gebruik van een camera met een handmatig geregelde sluitertijd waarmee eenvoudige kartografische tekeningen vanaf een vectorscherm op film werden vastgelegd. In 1970 publiceerde Tobler de resultaten van een onderzoek naar kartografische computer animatie over de 3-D representatie van een bevolkingsgroeimodel voor Detroit. Andere bijdragen uit de jaren zeventig zijn o.a. de 3-D studies van Monmonier (1978) en Worth (1978)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "De verandering in attributen van een object of verschijnsel wordt weergegeven. Bijvoorbeeld de weergave van de verkorting van de reistijd naar Utrecht vanuit omliggende gemeenten na aanleg van speciale busbanen. 3- benadrukken locatie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:192950 ;
            sgpl:spatialText "Kenya" ;
            sgpl:text_context "De tweede animatie beeldt de bevolkingstoename van Frankrijk en Kenya uit voor de jaren 1985 tot en met 2000 (figuur 7.24). Deze animatie heeft de waarnemingseigenschap orde. Het blijkt uit de animatie dat de bevolkingstoename in Kenya in een zelfde tijdsbestek meer is dan in Frankrijk; dit geeft orde weer." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Parijs" ;
            sgpl:text_context "De eerste animatie beeldt het verschil reistijd met de auto en met het vliegtuig tussen Amsterdam en Parijs uit (figuur 7.23). Door middel van de dynamische variabele mate van verandering kunnen we deze verhouding uitbeelden in termen van sneller en/of langzamer; er is dus sprake van orde (bijlage 5.5a, tabel 5.4). De tweede animatie beeldt de bevolkingstoename van Frankrijk en Kenya uit voor de jaren 1985 tot en met 2000 (figuur 7.24)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De tijdschaal kan, afhankelijk van de aard van het verschijnsel lineair-continu we spreken in dit geval ook van cyclische animatie: 4x12 maanden. Niet-lineair-discrete (bijvoorbeeld uitbreiding landijs in Nederland in verschillende fasen) of niet-lineair-discrete (bijvoorbeeld maximale uitbreiding van het landijs gedurende verschillende glacialen in het pleistoceen) is ook mogelijk. De actie speelt zich meestal in chronologische volgorde af." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Om dit te verduidelijken hebben we twee animaties gemaakt: 'Reistijd Amsterdam-Parijs' en 'Bevolkingstoename Frankrijk en Kenya' (bijlage 4). De eerste animatie beeldt het verschil reistijd met de auto en met het vliegtuig tussen Amsterdam en Parijs uit (figuur 7.23). Door middel van de dynamische variabele mate van verandering kunnen we deze verhouding uitbeelden in termen van sneller en/of langzamer; er is dus sprake van orde." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "De dynamische variabele frequentie heeft betrekking op de regelmaat waarmee veranderingen worden aangebracht in het beeld. Figuur 7.4a vergelijkt met knipperende symbolen met een lage of hoge frequentie de mate van internationaal vluchtverkeer op de luchthavens Schiphol en Maastricht. In figuur 7.4b is frequentie gekoppeld aan een temporeel fenomeen, namelijk de overkomst van satellieten boven Frankrijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3017382 ;
            sgpl:spatialText "Frankrijk" ;
            sgpl:text_context "Door middel van de dynamische variabele mate van verandering kunnen we deze verhouding uitbeelden in termen van sneller en/of langzamer; er is dus sprake van orde (bijlage 5.5a, tabel 5.4). De tweede animatie beeldt de bevolkingstoename van Frankrijk en Kenya uit voor de jaren 1985 tot en met 2000 (figuur 7.24). Deze animatie heeft de waarnemingseigenschap orde." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2453866 ;
            sgpl:spatialText "Kayes and Yehmane distr. (Mali)" ;
            sgpl:text_context "Omdat de techniek van het produceren van animaties buiten de strekking van deze scriptie valt, zullen we er hier verder niet op in gaan. Voor het toetsen van de waarnemingseigenschappen van deze variabele zijn een serie animaties gemaakt; deze zijn te vinden onder de subgroepen 'Desertification Status of Kayes and Yehmane distr. (Mali)' en idem, maar met een interactieve legenda. Het eerste bevat drie verschillende animaties: één animatie met de dynamische variabele frequentie, eentje met de variabelen frequentie en duur gecombineerd en weer een andere met frequentie en duur gecombineerd met de grafische variabelen kleur en grijswaarde." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2374 ;
            sgpl:subjectText "Kartografische animaties" ;
            sgpl:text_context "Het is met deze technologie mogelijk om beeld-, geluid- en tekstinformatie op een interactieve en relatief goedkope manier te combineren met kaarten, ook in de vorm van kartografische animaties. Met behulp van kartografische animaties kunnen we een o.a. proces in zijn continuïteit analyseren, ruimtelijke en temporele trends zichtbaar maken en kaarten volgens verschillende karteer-, classificatie- en generalisatiemethoden presenteren. Deze scriptie is bedoeld om de theoretische aspecten achter kartografische animaties te belichten en nader uit te werken." ],
        [ sgpl:refersToConcept unesco:concept6659 ;
            sgpl:subjectText "Dynamische variabelen" ;
            sgpl:text_context "Om de volledige potentiaal van kartografische animaties te kunnen benutten moeten we de functionele aspecten van tijd goed beheersen. DiBiase e a (1992) introduceerden in dit verband drie dynamische variabelen, namelijk duur, male van verandering en volgorde, waarmee de temporele component binnen animaties kan worden eeregeld. MacEachren (1994) voegde ook nog weergave moment, frequentie en synchronisatie aan dit rijtje toe." ],
        [ sgpl:refersToConcept unesco:concept6822 ;
            sgpl:subjectText "Wetenschappelijke visualisatie" ;
            sgpl:text_context "Ook het steeds op een andere manier vormgeven van dezelfde informatie, zoals het weergeven van dezelfde statistische gegevens in de volgorde van bijvoorbeeld een stippenkaart, een chropleeth, een isolijnenkaart of een ruimtelijk model valt onder deze animatie. Brushing is een techniek afkomstig uit de wetenschappelijke visualisatie (zie Hf. V.4) om de relatie tussen twee of meer variabelen te analyseren. Monmonier (1989) introduceerde het begrip 'geographic brushing'-: één of meerdere spreidingsdiagrammen en een kaart zijn dynamisch met elkaar verbonden (figuur 6.6), dat wil zeggen: als punten op een deel van een spreidingsdiagram worden geselecteerd lichten de geografische locaties in de kaart op en andersom." ],
        [ sgpl:refersToConcept unesco:concept2374 ;
            sgpl:subjectText "Kartografische animaties" ;
            sgpl:text_context "Het is met deze technologie mogelijk om beeld-, geluid- en tekstinformatie op een interactieve en relatief goedkope manier te combineren met kaarten, ook in de vorm van kartografische animaties. Met behulp van kartografische animaties kunnen we een o.a. proces in zijn continuïteit analyseren, ruimtelijke en temporele trends zichtbaar maken en kaarten volgens verschillende karteer-, classificatie- en generalisatiemethoden presenteren. Deze scriptie is bedoeld om de theoretische aspecten achter kartografische animaties te belichten en nader uit te werken." ],
        [ sgpl:refersToConcept unesco:concept6822 ;
            sgpl:subjectText "Wetenschappelijke visualisatie" ;
            sgpl:text_context "Ook het steeds op een andere manier vormgeven van dezelfde informatie, zoals het weergeven van dezelfde statistische gegevens in de volgorde van bijvoorbeeld een stippenkaart, een chropleeth, een isolijnenkaart of een ruimtelijk model valt onder deze animatie. Brushing is een techniek afkomstig uit de wetenschappelijke visualisatie (zie Hf. V.4) om de relatie tussen twee of meer variabelen te analyseren. Monmonier (1989) introduceerde het begrip 'geographic brushing'-: één of meerdere spreidingsdiagrammen en een kaart zijn dynamisch met elkaar verbonden (figuur 6.6), dat wil zeggen: als punten op een deel van een spreidingsdiagram worden geselecteerd lichten de geografische locaties in de kaart op en andersom." ],
        [ sgpl:refersToConcept unesco:concept6659 ;
            sgpl:subjectText "Dynamische variabelen" ;
            sgpl:text_context "Om de volledige potentiaal van kartografische animaties te kunnen benutten moeten we de functionele aspecten van tijd goed beheersen. DiBiase e a (1992) introduceerden in dit verband drie dynamische variabelen, namelijk duur, male van verandering en volgorde, waarmee de temporele component binnen animaties kan worden eeregeld. MacEachren (1994) voegde ook nog weergave moment, frequentie en synchronisatie aan dit rijtje toe." ] ;
    sgpl:thesisID 307 .

sgpl:Thesis308 a sgpl:SGPLThesis ;
    dcterms:creator "Klaske W. Ypma" ;
    dcterms:issued 1995 ;
    dcterms:title "De Regio Stedendriehoek",
        "Regionale ontwikkeling en de betekenis van watersystemen voor de relatie tussen stedelijk en landelijk gebied" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Daarnaast wil ik prof.dr. G.A. Hoekveld bedanken voor de begeleiding en ondersteuning vanuit de Universiteit Utrecht. Ik ben hem met name dankbaar vanwege het feit dat ik in mijn afstudeerscriptie de relatie heb kunnen leggen tussen regionale geografie en watersystemen. Tenslotte wil ik de vrienden en familie bedanken die tijdens mijn stageperiode steeds het goede advies en de juiste steun op het goede moment hebben gegeven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759661 ;
            sgpl:spatialText "de omgeving van Arnhem" ;
            sgpl:text_context "Midden-Gelderland zal de bevolkingsdruk vanuit de Randstad in overwegende mate moeten opvangen in de omgeving van Arnhem. Arnhem en Zwolle zijn in de Derde Nota wel aangewezen als stadsgewest. Buiten de stadsgewesten en de Veluwe om worden Overijssel en Gelderland hoofdzakelijk gekenmerkt als gebieden met afwisselend landbouw, natuur en andere functies in kleinere ruimtelijke eenheden (zone C) (Ministerie van VROM, 1979)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756987 ;
            sgpl:spatialText "Deventer" ;
            sgpl:text_context "In deze regionaal-geografische studie staat de regio rondom de stedendriehoek Apeldoorn, Deventer en Zutphen centraal. Dit gebied zal per 1 mei 1995 officieel bekend staan onder de bestuurlijke naam Regio Stedendriehoek (figuur 1.1). Deze Regio Stedendriehoek wordt gevormd uit twee intergemeentelijke samenwerkingsregio’s namelijk het Gewest Midden-Ussel (GMU) en het Samenwerkingsorgaan Oost-Veluwe (SOV)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759706 ;
            sgpl:spatialText "Apeldoorn" ;
            sgpl:text_context "In deze regionaal-geografische studie staat de regio rondom de stedendriehoek Apeldoorn, Deventer en Zutphen centraal. Dit gebied zal per 1 mei 1995 officieel bekend staan onder de bestuurlijke naam Regio Stedendriehoek (figuur 1.1). Deze Regio Stedendriehoek wordt gevormd uit twee intergemeentelijke samenwerkingsregio’s namelijk het Gewest Midden-Ussel (GMU) en het Samenwerkingsorgaan Oost-Veluwe (SOV)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "Overijssel" ;
            sgpl:text_context "De Regio Stedendriehoek beslaat een oppervlakte van ongeveer 1200 km2, welke is verdeeld over de provincies Overijssel en Gelderland. Binnen deze regio bevindt zich het Stadsgewest Stedendriehoek. Dit Stadsgewest is een planologische afbakening en wordt gevormd door de steden Apeldoorn, Deventer en Zutphen, en de drie gemeenten die verder nog van belang zijn voor de verstedelijkingsopgave van het Stadsgewest (figuur 1.2)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "provincie Gelderland" ;
            sgpl:text_context "Het onderzoek is uitgevoerd in het kader van een zes maanden durende stage bij de dienst Milieu en Water (onderafdeling gebieden) van de provincie Gelderland. De provincie Gelderland heeft mij via deze stage een mogelijkheid geboden om te kijken in de keuken van het gebiedsgerichte beleid en in het algemeen binnen de organisatie van deze overheidsinstelling. Via deze weg wil ik de afdeling gebieden en met name mijn begeleider ir. G. van Eijk bedanken voor de begeleiding en de gezelligheid die ik tijdens mijn stage heb ondervonden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743608 ;
            sgpl:spatialText "Zutphen" ;
            sgpl:text_context "In deze regionaal-geografische studie staat de regio rondom de stedendriehoek Apeldoorn, Deventer en Zutphen centraal. Dit gebied zal per 1 mei 1995 officieel bekend staan onder de bestuurlijke naam Regio Stedendriehoek (figuur 1.1). Deze Regio Stedendriehoek wordt gevormd uit twee intergemeentelijke samenwerkingsregio’s namelijk het Gewest Midden-Ussel (GMU) en het Samenwerkingsorgaan Oost-Veluwe (SOV)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Naast de stedelijke gebieden bestaat de Regio Stedendriehoek gedeeltelijk uit belangrijke natuurgebieden, zoals het Centraal Veluws Natuurgebied, wat het grootste aaneengesloten bosgebied is van Nederland, en de Sallandse Heuvelrug. Deze gebieden bevatten waardevolle geomorfologische, natuurlijke en cultuurhistorische elementen die in het belang van de functies en waarden van de gehele Regio behouden moeten blijven. Anderzijds beslaat de landbouw een belangrijk deel van het oppervlak." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Regio Stedendriehoek" ;
            sgpl:text_context "In deze regionaal-geografische studie staat de regio rondom de stedendriehoek Apeldoorn, Deventer en Zutphen centraal. Dit gebied zal per 1 mei 1995 officieel bekend staan onder de bestuurlijke naam Regio Stedendriehoek (figuur 1.1). Deze Regio Stedendriehoek wordt gevormd uit twee intergemeentelijke samenwerkingsregio’s namelijk het Gewest Midden-Ussel (GMU) en het Samenwerkingsorgaan Oost-Veluwe (SOV)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745666 ;
            sgpl:spatialText "Veluwe" ;
            sgpl:text_context "De drie centrale steden zijn bijzonder aantrekkelijk gesitueerd tussen deze natuur- en landbouwgebieden. Apeldoorn ligt aan de rand van de Veluwe en voor Deventer en Zutphen geldt dat zij te midden van waardevolle landschappen en aan de rivier de IJssel zijn gelegen. De ontwikkelingen van de steden volgens het stadsgewestmodel hebben vermoedelijk hun invloeden op de landbouw- en natuurgebieden die liggen rond deze steden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept985 ;
            sgpl:subjectText "waterkwantiteit" ;
            sgpl:text_context "De studie over watersystemen kan opgesplitst worden in twee onderdelen namelijk de waterkwantiteit en de waterkwaliteit. Om praktische redenen zal in deze studie hoofdzakelijk het onderwerp waterkwantiteit aan de orde komen. Onderzocht zal worden inhoeverre regionale ontwikkeling waterstromen en waterpeilen kan beïnvloeden en welke gevolgen dat zal hebben voor de functies van het landelijk gebied van de Regio Stedendriehoek." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionale ontwikkeling" ;
            sgpl:text_context "Huidige patronen in een regio zijn slechts een momentopname van processen die continu plaatsvinden. Om een regio te begrijpen wordt daarom bij regionale geografie de regionale ontwikkeling van het onderzoeksgebied bestudeerd, waardoor de richting en snelheid van de veranderingen binnen het gebied worden blootgelegd. Met behulp van een methodische analyse worden daarnaast complex samenhangende kenmerken van een regio begrijpelijk gemaakt en grenzen van systemen (of sets) ontvouwd." ],
        [ sgpl:refersToConcept unesco:concept985 ;
            sgpl:subjectText "watersystemen" ;
            sgpl:text_context "Daarnaast wil ik prof.dr. G.A. Hoekveld bedanken voor de begeleiding en ondersteuning vanuit de Universiteit Utrecht. Ik ben hem met name dankbaar vanwege het feit dat ik in mijn afstudeerscriptie de relatie heb kunnen leggen tussen regionale geografie en watersystemen. Tenslotte wil ik de vrienden en familie bedanken die tijdens mijn stageperiode steeds het goede advies en de juiste steun op het goede moment hebben gegeven." ],
        [ sgpl:refersToConcept unesco:concept985 ;
            sgpl:subjectText "waterkwantiteit" ;
            sgpl:text_context "De studie over watersystemen kan opgesplitst worden in twee onderdelen namelijk de waterkwantiteit en de waterkwaliteit. Om praktische redenen zal in deze studie hoofdzakelijk het onderwerp waterkwantiteit aan de orde komen. Onderzocht zal worden inhoeverre regionale ontwikkeling waterstromen en waterpeilen kan beïnvloeden en welke gevolgen dat zal hebben voor de functies van het landelijk gebied van de Regio Stedendriehoek." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionale ontwikkeling" ;
            sgpl:text_context "Huidige patronen in een regio zijn slechts een momentopname van processen die continu plaatsvinden. Om een regio te begrijpen wordt daarom bij regionale geografie de regionale ontwikkeling van het onderzoeksgebied bestudeerd, waardoor de richting en snelheid van de veranderingen binnen het gebied worden blootgelegd. Met behulp van een methodische analyse worden daarnaast complex samenhangende kenmerken van een regio begrijpelijk gemaakt en grenzen van systemen (of sets) ontvouwd." ],
        [ sgpl:refersToConcept unesco:concept985 ;
            sgpl:subjectText "watersystemen" ;
            sgpl:text_context "Daarnaast wil ik prof.dr. G.A. Hoekveld bedanken voor de begeleiding en ondersteuning vanuit de Universiteit Utrecht. Ik ben hem met name dankbaar vanwege het feit dat ik in mijn afstudeerscriptie de relatie heb kunnen leggen tussen regionale geografie en watersystemen. Tenslotte wil ik de vrienden en familie bedanken die tijdens mijn stageperiode steeds het goede advies en de juiste steun op het goede moment hebben gegeven." ] ;
    sgpl:thesisID 308 .

sgpl:Thesis309 a sgpl:SGPLThesis ;
    dcterms:creator "Mariette Oldeman",
        "Marlies Bruinstroop" ;
    dcterms:issued 1996 ;
    dcterms:title "Een onderzoek naar de woon- en zorgwensen van oudere huishoudens in het kader van Leidsche Rijn",
        "LEIDSCHE RIJN, OOK VOOR OUDEREN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6956040 ;
            sgpl:spatialText "Leidsche Rijn" ;
            sgpl:text_context "LEIDSCHE RIJN, OOK VOOR OUDEREN Een onderzoek naar de woon- en zorgwensen van oudere huishoudens in het kader van Leidsche Rijn. De plannen rondom de nieuwbouwlokatie Leidsche Rijn, gelegen in het gebied tussen Utrecht en Vleuten-De Meern, kwamen voor ons op een uitstekend moment. Wij hadden namelijk de kans om met ons afstudeeronderzoek in te springen op een actueel onderwerp." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stad Utrecht" ;
            sgpl:text_context "De leeftijdsgrens van 65 jaar is als bovengrens genomen, omdat bekend is dat de verhuisgeneigdheid afneemt naarmate de leeftijd van een huishouden toeneemt. Een tweede criterium waaraan een huishouden moest voldoen, was dat het huishouden in een zelfstandige woning in de stad Utrecht moest wonen. Dit criterium is gehanteerd, omdat het niet aannemelijk is dat huishoudens die nu in een bejaardenoord of in een verpleeghuis wonen, nog zullen verhuizen naar een zelfstandige woning in Leidsche Rijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoortse wijk Kattenbroek" ;
            sgpl:text_context "Wanneer gekeken wordt naar de integratie van wonen, zorg en welzijn kan de gemeente Utrecht een voorbeeld nemen aan de situatie in de Amersfoortse wijk Kattenbroek (zie kader). In de Amersfoortse nieuwbouwwijk Kattenbroek, is sinds 1992 een speciaal ouderensteunpunt in gebruik: het Pluspunt. Het Pluspunt is een samenwerkingsverband tussen twee verzorgingshuizen, het Kruiswerk, de Thuiszorgwinkel, de Stichting Centrale Woningzorg en de gemeente Amersfoort." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6621526 ;
            sgpl:spatialText "Binnenstad" ;
            sgpl:text_context "Vooral in de uitbreidingswijken uit de jaren zestig en zeventig, Overvecht en Zuidwest, wonen relatief veel ouderen. In de Binnenstad en de wijken daaromheen zijn daarentegen weinig ouderen te vinden. Verreweg de meeste ouderen huren hun woning." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748815 ;
            sgpl:spatialText "Overvecht" ;
            sgpl:text_context "De oudere huishoudens zijn niet evenwichtig over de stad Utrecht verdeeld. Vooral in de uitbreidingswijken uit de jaren zestig en zeventig, Overvecht en Zuidwest, wonen relatief veel ouderen. In de Binnenstad en de wijken daaromheen zijn daarentegen weinig ouderen te vinden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "LEIDSCHE RIJN, OOK VOOR OUDEREN Een onderzoek naar de woon- en zorgwensen van oudere huishoudens in het kader van Leidsche Rijn. De plannen rondom de nieuwbouwlokatie Leidsche Rijn, gelegen in het gebied tussen Utrecht en Vleuten-De Meern, kwamen voor ons op een uitstekend moment. Wij hadden namelijk de kans om met ons afstudeeronderzoek in te springen op een actueel onderwerp." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Wij hadden namelijk de kans om met ons afstudeeronderzoek in te springen op een actueel onderwerp. Om te voorkomen dat een jaar hard werken uiteindelijk zou leiden tot een rapport dat alleen wordt gelezen door vrienden en familieleden en vervolgens ergens in een kast verdwijnt, namen wij in de beginfase van ons onderzoek contact op met de gemeente Utrecht. Tijdens een eerste gesprek werd al snel duidelijk, dat er bij de gemeente behoefte bestond aan antwoord op de vraag of oudere woonconsumenten interesse hebben voor een woning in Leidsche Rijn en zo ja, welke eisen zij in dat geval stellen aan het wonen op deze nieuwbouwlokatie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Vleuten-De Meern" ;
            sgpl:text_context "LEIDSCHE RIJN, OOK VOOR OUDEREN Een onderzoek naar de woon- en zorgwensen van oudere huishoudens in het kader van Leidsche Rijn. De plannen rondom de nieuwbouwlokatie Leidsche Rijn, gelegen in het gebied tussen Utrecht en Vleuten-De Meern, kwamen voor ons op een uitstekend moment. Wij hadden namelijk de kans om met ons afstudeeronderzoek in te springen op een actueel onderwerp." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Zuidwest" ;
            sgpl:text_context "De oudere huishoudens zijn niet evenwichtig over de stad Utrecht verdeeld. Vooral in de uitbreidingswijken uit de jaren zestig en zeventig, Overvecht en Zuidwest, wonen relatief veel ouderen. In de Binnenstad en de wijken daaromheen zijn daarentegen weinig ouderen te vinden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De nog altijd toenemende woningbehoefte, de bestrijding van het bestaande woningtekort en de vervangingsbehoefte zorgen ervoor dat er de komende jaren nog een aanzienlijk aantal woningen gebouwd moet worden. Volgens de Vierde Nota over de Ruimtelijke Ordening Extra (VINEX) uit 1991, is er in Nederland in de periode 1995-2005 behoefte aan een uitbreiding van de woningvoorraad met 483.000 woningen (Tabel 1.1). De Trendbrief, die in 1993 is verschenen, signaleert een hogere woningbehoefte dan de VINEX." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "verhuisgeneigdheid" ;
            sgpl:text_context "Het uitgangspunt dat Leidsche Rijn, vanaf het begin, een gedifferentieerde bevolkingssamenstelling moet hebben, zorgt ervoor dat er bij de realisering van Leidsche Rijn aandacht moet zijn voor de ouderen. Uit eerdere onderzoeken is gebleken dat de verhuisgeneigdheid van ouderen laag is, dat ouderen vaak gebonden zijn aan hun eigen woonomgeving en dat zij over het algemeen weinig belangstelling hebben voor nieuwbouwwijken. De verwachting is dan ook dat het een hele klus zal zijn om de ouderen ertoe te bewegen om naar Leidsche Rijn te verhuizen." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "woon- en zorgwensen" ;
            sgpl:text_context "Het leek ons niet de meest interessante groep woonconsumenten om onderzoek naar te doen. Tijdens het lezen van literatuur over de woon- en zorgwensen van ouderen, werden wij echter steeds enthousiaster en al snel besloten wij om de ouderen in ons onderzoek centraal te stellen. Er zijn veel mensen die hun medewerking hebben verleend aan het tot stand komen van dit rapport." ],
        [ sgpl:refersToConcept unesco:concept3652 ;
            sgpl:subjectText "VINEX-uitbreidingslokaties" ;
            sgpl:text_context "De komende decennia moet de Nederlandse woningvoorraad nog aanzienlijk worden uitgebreid. Het merendeel van de nieuw te bouwen woningen moet gerealiseerd worden op de door het Rijk aangewezen VINEX-uitbreidingslokaties, aan de rand van de vier grote steden. Leidsche Rijn is zo’n VINEX-uitbreidingslokatie, gelegen in het stadsgewest Utrecht." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "verhuisgeneigdheid" ;
            sgpl:text_context "Het uitgangspunt dat Leidsche Rijn, vanaf het begin, een gedifferentieerde bevolkingssamenstelling moet hebben, zorgt ervoor dat er bij de realisering van Leidsche Rijn aandacht moet zijn voor de ouderen. Uit eerdere onderzoeken is gebleken dat de verhuisgeneigdheid van ouderen laag is, dat ouderen vaak gebonden zijn aan hun eigen woonomgeving en dat zij over het algemeen weinig belangstelling hebben voor nieuwbouwwijken. De verwachting is dan ook dat het een hele klus zal zijn om de ouderen ertoe te bewegen om naar Leidsche Rijn te verhuizen." ],
        [ sgpl:refersToConcept unesco:concept3652 ;
            sgpl:subjectText "VINEX-uitbreidingslokaties" ;
            sgpl:text_context "De komende decennia moet de Nederlandse woningvoorraad nog aanzienlijk worden uitgebreid. Het merendeel van de nieuw te bouwen woningen moet gerealiseerd worden op de door het Rijk aangewezen VINEX-uitbreidingslokaties, aan de rand van de vier grote steden. Leidsche Rijn is zo’n VINEX-uitbreidingslokatie, gelegen in het stadsgewest Utrecht." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "woon- en zorgwensen" ;
            sgpl:text_context "Het leek ons niet de meest interessante groep woonconsumenten om onderzoek naar te doen. Tijdens het lezen van literatuur over de woon- en zorgwensen van ouderen, werden wij echter steeds enthousiaster en al snel besloten wij om de ouderen in ons onderzoek centraal te stellen. Er zijn veel mensen die hun medewerking hebben verleend aan het tot stand komen van dit rapport." ] ;
    sgpl:thesisID 309 .

sgpl:Thesis31 a sgpl:SGPLThesis ;
    dcterms:creator "J.L.M. Kits Nieuwenkamp" ;
    dcterms:issued 1960 ;
    dcterms:title "(Een onder invloed van een grenstrekking veranderende samenleving vanuit een sociaal- en economisch-geografisch gezichtspunt benaderd.)",
        "DUDERSTADT",
        "Stad en Kreis aan het Ijzeren Gordijn" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Duitsland" ;
            sgpl:text_context "Een niet minder duidelijk omlijnde centrumfunktie, waarbij tevens niet minder schilderachtig, heeft het Hannoverse stadje Duderstadt. Zeer zeker is het geenszins zo, dat Duderstadt daarmee het prototype van Duitsland zou zijn. Duitsland en de verscheidenheid aan gebieden en steden is daarvoor te groot." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3207074 ;
            sgpl:spatialText "Untereichsfeld" ;
            sgpl:text_context "Tussen Harz, Werra en Thüringerwald ligt het onder zekere fysische maatstaven tesamen horende triasgebied het \"Eichsfeld\", vooral naar hoogte onderverdeeld in Ober- en Untereichsfeld. Het Untereichsfeld daarentegen is een Bekken met in het Oosten het prepermisch Harzgebergte, in het zuidoosten de schelpenkalkcuesta met een boog lopend tot het zuidwesten. In de Atlas van Niedersachsen wordt het Untereichsfeld tot het Leinebergland gerekend, genoemd naar de rivier die op het Obereichsfeld ontspringt en waarin de Rhume en de Hahle die de Goldene Mark ontwateren, afvloeien." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743913 ;
            sgpl:spatialText "Zierikzee" ;
            sgpl:text_context "I. VOORWOORD. In Nederland geldt als het prototype van een kleine stad met duidelijk omlijnde centrumfunktie het schilderachtige Zierikzee. Een niet minder duidelijk omlijnde centrumfunktie, waarbij tevens niet minder schilderachtig, heeft het Hannoverse stadje Duderstadt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2919331 ;
            sgpl:spatialText "Goldene Mark" ;
            sgpl:text_context "Hoewel de bodem kalkarm is, wordt het bekken door zijn vruchtbaarheid reeds sinds eeuwen de \"Goldene Mark\" genoemd. Deze vruchtbaarheid is vooral aan de rijke verweringslaag van bontzandsteen te danken en aan andere alluviale leemsoorten, benevens aan diluviale löss, dat vooral in het westelijke deel in de windschaduw van het Göttingerwald werd neergelegd. In de Atlas van Niedersachsen wordt het Untereichsfeld tot het Leinebergland gerekend, genoemd naar de rivier die op het Obereichsfeld ontspringt en waarin de Rhume en de Hahle die de Goldene Mark ontwateren, afvloeien." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2822542 ;
            sgpl:spatialText "Thüringen" ;
            sgpl:text_context "Het bleek dat de Kreisstad Duderstadt door het ontstaan van het ijzeren gordijn ongeveer eenderde van zijn achterland had verloren. Waar het stadje voor 1945 hoofdzakelijk oostwaarts georiënteerd was en in Thüringen zijn grootste natuurlijke afzet- en inkoopgebied had, moest het na de oorlog plotseling rechtsomkeerd maken. Gezien dit grondgegeven leek een analyse van de ruimtelijke betrekkingen van het stadje, dat niet is los te zien van de Kreis, een vruchtbare basis voor een onderzoek ten behoeve van een scriptie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2934728 ;
            sgpl:spatialText "Kreis Duderstadt" ;
            sgpl:text_context "Toch werd dit ruim 10 000 inwoners tellende stadje, tegen de achtergrond van Kreis en Land en zonder de centrumfunktie centraal te stellen, tot onderwerp van deze scriptie gekozen. Het bleek dat de Kreisstad Duderstadt door het ontstaan van het ijzeren gordijn ongeveer eenderde van zijn achterland had verloren. Gezien dit grondgegeven leek een analyse van de ruimtelijke betrekkingen van het stadje, dat niet is los te zien van de Kreis, een vruchtbare basis voor een onderzoek ten behoeve van een scriptie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Ijzeren Gordijn" ;
            sgpl:text_context "Daar zijn aandacht en belangstelling reeds eerder door het nieuwe verloop van grenzen en de daaruit volgende regionale hergroepering van Midden- en Oost Europa getrokken was, lag het voor de hand, dat het gebied aan het Ijzeren Gordijn in de omgeving van Göttingen nader onderzocht werd. Het bleek dat de Kreisstad Duderstadt door het ontstaan van het ijzeren gordijn ongeveer eenderde van zijn achterland had verloren. Gezien dit grondgegeven leek een analyse van de ruimtelijke betrekkingen van het stadje, dat niet is los te zien van de Kreis, een vruchtbare basis voor een onderzoek ten behoeve van een scriptie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2918632 ;
            sgpl:spatialText "Göttingen" ;
            sgpl:text_context "Schrijver dezes had het voorrecht door middel van een uitwisselingsbeurs een zomersemester te Göttingen te studeren. Daar voor een doctoraalscriptie eigen onderzoek vereist is, werd dit verblijf te baat genomen te onderzoeken of in de naaste omgeving enig onderwerp voor studie in aanmerking kwam. Daar zijn aandacht en belangstelling reeds eerder door het nieuwe verloop van grenzen en de daaruit volgende regionale hergroepering van Midden- en Oost Europa getrokken was, lag het voor de hand, dat het gebied aan het Ijzeren Gordijn in de omgeving van Göttingen nader onderzocht werd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2934728 ;
            sgpl:spatialText "Hannoverse stadje Duderstadt" ;
            sgpl:text_context "In Nederland geldt als het prototype van een kleine stad met duidelijk omlijnde centrumfunktie het schilderachtige Zierikzee. Een niet minder duidelijk omlijnde centrumfunktie, waarbij tevens niet minder schilderachtig, heeft het Hannoverse stadje Duderstadt. Zeer zeker is het geenszins zo, dat Duderstadt daarmee het prototype van Duitsland zou zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "I. VOORWOORD. In Nederland geldt als het prototype van een kleine stad met duidelijk omlijnde centrumfunktie het schilderachtige Zierikzee. Een niet minder duidelijk omlijnde centrumfunktie, waarbij tevens niet minder schilderachtig, heeft het Hannoverse stadje Duderstadt." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10788 ;
            sgpl:subjectText "Ijzeren Gordijn" ;
            sgpl:text_context "Daar zijn aandacht en belangstelling reeds eerder door het nieuwe verloop van grenzen en de daaruit volgende regionale hergroepering van Midden- en Oost Europa getrokken was, lag het voor de hand, dat het gebied aan het Ijzeren Gordijn in de omgeving van Göttingen nader onderzocht werd. Het bleek dat de Kreisstad Duderstadt door het ontstaan van het ijzeren gordijn ongeveer eenderde van zijn achterland had verloren. Waar het stadje voor 1945 hoofdzakelijk oostwaarts georiënteerd was en in Thüringen zijn grootste natuurlijke afzet- en inkoopgebied had, moest het na de oorlog plotseling rechtsomkeerd maken." ],
        [ sgpl:refersToConcept unesco:concept5670 ;
            sgpl:subjectText "Grenstrekking" ;
            sgpl:text_context "Stad en Kreis aan het Ijzeren Gordijn. Een onder invloed van een grenstrekking veranderende samenleving vanuit een sociaal— en economisch-geografisch gezichtspunt benaderd. Toch werd dit ruim 10 000 inwoners tellende stadje, tegen de achtergrond van Kreis en Land en zonder de centrumfunktie centraal te stellen, tot onderwerp van deze scriptie gekozen." ],
        [ sgpl:refersToConcept unesco:concept917 ;
            sgpl:subjectText "Achterland" ;
            sgpl:text_context "Hoewel dus door de plaats van studie gebonden, deed zich het toeval voor, dat slechts 30 km. ten oosten ven de Nedersaksische universiteitsstad een zeer dankbaar onderwerp voor sociaal-geografisch onderzoek gevonden werd. Het bleek dat de Kreisstad Duderstadt door het ontstaan van het ijzeren gordijn ongeveer eenderde van zijn achterland had verloren. Waar het stadje voor 1945 hoofdzakelijk oostwaarts georiënteerd was en in Thüringen zijn grootste natuurlijke afzet- en inkoopgebied had, moest het na de oorlog plotseling rechtsomkeerd maken." ],
        [ sgpl:refersToConcept unesco:concept917 ;
            sgpl:subjectText "Achterland" ;
            sgpl:text_context "Hoewel dus door de plaats van studie gebonden, deed zich het toeval voor, dat slechts 30 km. ten oosten ven de Nedersaksische universiteitsstad een zeer dankbaar onderwerp voor sociaal-geografisch onderzoek gevonden werd. Het bleek dat de Kreisstad Duderstadt door het ontstaan van het ijzeren gordijn ongeveer eenderde van zijn achterland had verloren. Waar het stadje voor 1945 hoofdzakelijk oostwaarts georiënteerd was en in Thüringen zijn grootste natuurlijke afzet- en inkoopgebied had, moest het na de oorlog plotseling rechtsomkeerd maken." ],
        [ sgpl:refersToConcept unesco:concept10788 ;
            sgpl:subjectText "Ijzeren Gordijn" ;
            sgpl:text_context "Daar zijn aandacht en belangstelling reeds eerder door het nieuwe verloop van grenzen en de daaruit volgende regionale hergroepering van Midden- en Oost Europa getrokken was, lag het voor de hand, dat het gebied aan het Ijzeren Gordijn in de omgeving van Göttingen nader onderzocht werd. Het bleek dat de Kreisstad Duderstadt door het ontstaan van het ijzeren gordijn ongeveer eenderde van zijn achterland had verloren. Waar het stadje voor 1945 hoofdzakelijk oostwaarts georiënteerd was en in Thüringen zijn grootste natuurlijke afzet- en inkoopgebied had, moest het na de oorlog plotseling rechtsomkeerd maken." ],
        [ sgpl:refersToConcept unesco:concept5670 ;
            sgpl:subjectText "Grenstrekking" ;
            sgpl:text_context "Stad en Kreis aan het Ijzeren Gordijn. Een onder invloed van een grenstrekking veranderende samenleving vanuit een sociaal— en economisch-geografisch gezichtspunt benaderd. Toch werd dit ruim 10 000 inwoners tellende stadje, tegen de achtergrond van Kreis en Land en zonder de centrumfunktie centraal te stellen, tot onderwerp van deze scriptie gekozen." ] ;
    sgpl:thesisID 31 .

sgpl:Thesis310 a sgpl:SGPLThesis ;
    dcterms:creator "Wim de Haas" ;
    dcterms:issued 1996 ;
    dcterms:title "VERSLAGEN VAN LEERONDERZOEK G&P",
        "Verscheiden plattelandstoerisme in plattelandsontwikkeling: het werkgelegenheidseffect vanuit de aanbodzijde benaderd." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "de Kop van Noord-Holland" ;
            sgpl:text_context "In overleg met de provinciale besturen heeft de regering zes gebieden aangewezen, waar getracht wordt door middel van gerichte aanpassingen in te spelen op bovengenoemde ontwikkeling. Het betreft de volgende gebieden: het Oldambt, NO-Friesland/NW-Groningen, NW-Friesland, de Kop van Noord-Holland, Zeeuwsch-Vlaanderen en het Drentse Oostermoergebied. In deze gebieden wordt gewerkt aan de opstelling van op uitvoering gerichte Regionale Ontwikkelingsplannen (ROP’s)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Nieuwkoopse Plassen" ;
            sgpl:text_context "paardrijden Havelte. vissen Nieuwkoopse Plassen. zwemmen Veluwemeer." ],
        [ a sgpl:SpatialExtentReference ;
