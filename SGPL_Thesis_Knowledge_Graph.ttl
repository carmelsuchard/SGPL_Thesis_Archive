        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743977 ;
            sgpl:spatialText "Gemeente Zeist" ;
            sgpl:text_context "Dhr. Knijff. Dhr. van Mourik. Dhr. van Hamburg en dhr. Koekoek. Uiteraard gaat mijn dank uit naar de familie Kleyer-Schumacher te Maarssen, mijn uitvalsbasis tijdens de veldwerkperiode (september/oktober 1991)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Park Voorn" ;
