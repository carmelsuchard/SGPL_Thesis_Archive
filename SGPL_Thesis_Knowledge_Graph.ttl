    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Saint C h i n i a n" ;
            sgpl:text_context "B i n n e n d i t g e b i e d l i g g e n 61 g e m e e n t e n \" b e n e f i c i a n t 6e 11 a p p e l l a t i o n V . ’ D . g, . 3 . . Vo l g e n s T H O H A L ( 51 ) v . o r d t d e z u i d g r e n s v e n h o t \" V o r . t a g n e N o i r e \" z o w e l g e o l o g i s c h a l s g e o g r a f i s c h g e v o r m d d o o r e e n l i j n d i e l o o p t t u s s e n Ca u n c s e n S a i n t C h i n i a n, m e t a n d e r e w o o r d e n : o e n d e e l v . n b e i d e g e m e e n t e n s o u d u s v u l l e n b i n n e n h e t \" H o n t a g n e N o i r e \" ." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Geog r a f i s c h I n s t i t uu t t e U t r e c h t" ;
            sgpl:text_context "De z e w e r d v e r v a a r d i g d d o o r d e 19 b l a d e n v a n d e k a d a s t r a l e k a a r t v a n S a i n t J e a n d e I J i n e r v o i s e n d e 8 v a n d i e v a n A s s i g n a n o v e r t e t e k e n e n e n d e d i v e r s e p e r c e l e n i n t e k l e u r e n, w a a r n a d e z e \" f e u i l l e s \" o p h e t G e o g r a f i s c h I n s t i t u u t t e U t r e c h t v i j f m a a l w e r d e n v e r k l e i n d e n v e r v o l g e n s a a n e l k a a r g e p a s t . De k a d a s t e r s w a r e n g o e d b i j g e h o u d e n ." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Bar r o u b i o" ;
            sgpl:text_context "De g e m e e n t e n S a i n t J e a n d e i i n e r v o i s e n. A s s i g n a n z i j n g e l o g e n i n h e t F r a n s e d e p a r t e m e n t Hér a u l t e n w e l z o d a n i g. In d e g e m e e n t e S a i n t J e a n d e I l i n e r v o i s l i g g e n v a n w e s t n a a r o o s t d e d o r p e n : S a i n t k a r t i a l, Be l l e r a z e, S a i n t J e a n d e 'ï i n e r v o i s, Gi m i o s e n 8 a r r o u'' i o ; v o o r t s d e r uïn e s v a n e e n a a n t a l v e r s p r e i d l i g g e n d e b o e r d e r i j e n. In d e g e m e e n t e A s s i g n a n l i g t e n k e l h e t g e l i j k n a m i g e d o r p ." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Mo n t a g n e N o i r e" ;
