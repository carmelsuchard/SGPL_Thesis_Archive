sgpl:Thesis100 a sgpl:SGPLThesis ;
    dcterms:creator "H. Prins" ;
    dcterms:issued 1981 ;
    dcterms:title "ACCEPTATIE VAN EEN RELATIE",
        "Een analyse van de toepassingsmogelijkheden van de Relatienota in het relatienotagebied Oirschot-Best" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749682 ;
            sgpl:spatialText "gemeente Oirschot" ;
            sgpl:text_context "Het studiegebied ligt centraal in de stedendriehoek 's-Hertogenbosch-Eindhoven-Tilburg en is voorts grotendeels gelegen binnen de gemeente Oirschot ten dele binnen de gemeenten Best en Boxtel. Naar het oosten en het noord-oosten sluit het relatienotagebied Oirschot-Best aan bij de bosrijke landgoederen 'Heerenbeek' en 'Veldersbosch' en bij het populierengebied van Best en Liempde. In het noordwesten wordt het gebied begrensd door ontginningsgronden, die een scheiding vormen tussen het relatienotagebied en de natuurgebieden van de Kampinasche Heide." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De directe aanleiding tot deze studie is het overal in Nederland waar te nemen verschijnsel, dat de belangen van landbouw op een gespannen voet staan met die van natuur- en landschapsbehoud. Hiervoor zijn ontwikkelingen in zowel het landelijke als het stedelijke milieu verantwoordelijk. Op zichzelf is dit spanningsveld interessant genoeg om aan een sociaal-geografische beschouwing te onderwerpen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757269 ;
            sgpl:spatialText "De Mortelen" ;
            sgpl:text_context "Oorzaak en achtergronden spanningsveld landbouw: natuur- en landschapsbehoud in de Mortelen. Sinds eind van de zestiger jaren zijn de inzichten in de na te streven doelstellingen met betrekking tot de inrichting van de landelijke gebieden aanmerkelijk verruimd. De maatschappelijke waardering van natuur en landschap groeide enorm." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759040 ;
            sgpl:spatialText "gemeente Best" ;
            sgpl:text_context "Enkele kenmerken van de landbouw in de gemeenten Oirschot en Best. Snelle ontwikkelingen in de landbouw. Ongeveer 2/3 deel van de provincie Noord-Brabant wordt in beslag genomen door cultuurgrond." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "nationale landschap Midden-Brabant" ;
            sgpl:text_context "Ook zijn de eerste beheersovereenkomsten - in de zin van de Beschikking Beheersovereenkomsten van de minister van Landbouw en Visserij - in ons land afgesloten voor dit gebied. Daarnaast maakt dit gebied deel uit van de bijna voltooide ruilverkaveling Oirschot-Best en van het potentiële nationale landschap Midden-Brabant. Uit overwegingen van representativiteit kan ik op de voorhand niet nagaan of het relatienotagebied Oirschot-Best voor een verkennende studie als bedoeld het meest aangewezen is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "Het studiegebied ligt centraal in de stedendriehoek 's-Hertogenbosch-Eindhoven-Tilburg en is voorts grotendeels gelegen binnen de gemeente Oirschot ten dele binnen de gemeenten Best en Boxtel. Naar het oosten en het noord-oosten sluit het relatienotagebied Oirschot-Best aan bij de bosrijke landgoederen 'Heerenbeek' en 'Veldersbosch' en bij het populierengebied van Best en Liempde. In het noordwesten wordt het gebied begrensd door ontginningsgronden, die een scheiding vormen tussen het relatienotagebied en de natuurgebieden van de Kampinasche Heide." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749683,
                geonames:2759040 ;
            sgpl:spatialText "relatienotagebied Oirschot-Best" ;
            sgpl:text_context "ACCEPTATIE VAN EEN RELATIE. Een analyse van de toepassingsmogelijkheden van de Relatienota in het relatienotagebied Oirschot-Best. Doctoraal-scriptiasociale geografie Rijksuniversiteit Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "provinciaal bestuur van Noord-Brabant" ;
            sgpl:text_context "Een bijkomend motief waarom ik dit thema heb gekozen is, dat ik als medewerker van het provinciaal bestuur van Noord-Brabant onder andere betrokken ben bij de beleidsvoorbereiding in de sfeer van het natuur- en landschapsbehoud en de toepassing van de Relatienota. Prof. dr. M. de Smidt ben ik dank verschuldigd voor de constructieve en stimulerende begeleiding van dit verkennende onderzoek. Vught, november 1981." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5324 ;
            sgpl:subjectText "Beheersovereenkomst" ;
            sgpl:text_context "De keuze van het relatienotagebied Oirschot-Best als studiegebied vloeit vooral voort uit het feit, dat het eerste beheersplan-op basis van de Relatienota- in ons land is opgesteld voor dit gebied. Ook zijn de eerste beheersovereenkomsten- in de zin van de Beschikking Beheersovereenkomsten van de minister van Landbouw en Visserij- in ons land afgesloten voor dit gebied. Daarnaast maakt dit gebied deel uit van de bijna voltooide ruilverkaveling Oirschot-Best en van het potentiële nationale landschap Midden-Brabant." ],
        [ sgpl:refersToConcept unesco:concept9610 ;
            sgpl:subjectText "Relatienota" ;
            sgpl:text_context "Deze in het parlement levende bezorgdheid was voor de minister van Landbouw en Visserij, de staatssecretaris van Cultuur, Recreatie en Maatschappelijk Werk en de minister van Volkshuisvesting en Ruimtelijke Ordening aanleiding om een algehele beleidsnota op te stellen over de relatie tussen landbouw en natuur- en landschapsbehoud: Nota betreffende de relatie landbouw en natuur-en landschapsbehoud (Relatienota) (1). In deze nota worden maatregelen voorgesteld om aan de toenemende spanning tussen de ontwikkeling van de landbouw en het natuur- en landschapsbehoud een halt toe te roepen. Om inzicht te krijgen in de aard en doelmatigheid van de toepassing van de Relatienota in het relatienotagebied Oirschot-Best is het gewenst gegevens te verzamelen over factoren en processen die van invloed zijn op de acceptatie door de betrokken eigenaren/pachters van landbouwgronden in het relatienotagebied van de beheersmaatregelen voortvloeiende uit de Relatienota." ],
        [ sgpl:refersToConcept unesco:concept9610 ;
            sgpl:subjectText "Relatienota" ;
            sgpl:text_context "Deze in het parlement levende bezorgdheid was voor de minister van Landbouw en Visserij, de staatssecretaris van Cultuur, Recreatie en Maatschappelijk Werk en de minister van Volkshuisvesting en Ruimtelijke Ordening aanleiding om een algehele beleidsnota op te stellen over de relatie tussen landbouw en natuur- en landschapsbehoud: Nota betreffende de relatie landbouw en natuur-en landschapsbehoud (Relatienota) (1). In deze nota worden maatregelen voorgesteld om aan de toenemende spanning tussen de ontwikkeling van de landbouw en het natuur- en landschapsbehoud een halt toe te roepen. Om inzicht te krijgen in de aard en doelmatigheid van de toepassing van de Relatienota in het relatienotagebied Oirschot-Best is het gewenst gegevens te verzamelen over factoren en processen die van invloed zijn op de acceptatie door de betrokken eigenaren/pachters van landbouwgronden in het relatienotagebied van de beheersmaatregelen voortvloeiende uit de Relatienota." ],
        [ sgpl:refersToConcept unesco:concept4016 ;
            sgpl:subjectText "Natuur- en landschapsbehoud" ;
            sgpl:text_context "Niet in de laatste plaats heeft de overheid -vooral in het afgelopen decennium- in de sfeer van ruimtelijke ordening, landinrichting (ruilverkaveling) en natuur- en landschapsbehoud intensief te maken gekregen met de betrekkingen tussen landbouw en natuur- en landschapsbehoud. Gelet op de actuele en toekomstige betekenis van het overheidsbeleid ten aanzien van de oplossing van de conflicten tussen landbouw en natuur- en landschapsbehoud, wil ik trachten vanuit een sociaal-geografische optiek, de factoren en processen, die een rol spelen bij de aanvaarding of verwerping van het instrumentarium van de Relatienota in het relatienotagebied Oirschot-Best, aan een beschouwing te onderwerpen. Het feit dat een studie-onderwerp als dit gekenmerkt wordt door een grote, niet of nauwelijks reduceerbare aspectenrijkdom, brengt met zich mee, dat het object van studie tot verscheidene interpretatief-theoretische benaderingswijzen aanleiding kan geven." ],
        [ sgpl:refersToConcept unesco:concept5324 ;
            sgpl:subjectText "Beheersovereenkomst" ;
            sgpl:text_context "De keuze van het relatienotagebied Oirschot-Best als studiegebied vloeit vooral voort uit het feit, dat het eerste beheersplan-op basis van de Relatienota- in ons land is opgesteld voor dit gebied. Ook zijn de eerste beheersovereenkomsten- in de zin van de Beschikking Beheersovereenkomsten van de minister van Landbouw en Visserij- in ons land afgesloten voor dit gebied. Daarnaast maakt dit gebied deel uit van de bijna voltooide ruilverkaveling Oirschot-Best en van het potentiële nationale landschap Midden-Brabant." ],
        [ sgpl:refersToConcept unesco:concept4016 ;
            sgpl:subjectText "Natuur- en landschapsbehoud" ;
            sgpl:text_context "Niet in de laatste plaats heeft de overheid -vooral in het afgelopen decennium- in de sfeer van ruimtelijke ordening, landinrichting (ruilverkaveling) en natuur- en landschapsbehoud intensief te maken gekregen met de betrekkingen tussen landbouw en natuur- en landschapsbehoud. Gelet op de actuele en toekomstige betekenis van het overheidsbeleid ten aanzien van de oplossing van de conflicten tussen landbouw en natuur- en landschapsbehoud, wil ik trachten vanuit een sociaal-geografische optiek, de factoren en processen, die een rol spelen bij de aanvaarding of verwerping van het instrumentarium van de Relatienota in het relatienotagebied Oirschot-Best, aan een beschouwing te onderwerpen. Het feit dat een studie-onderwerp als dit gekenmerkt wordt door een grote, niet of nauwelijks reduceerbare aspectenrijkdom, brengt met zich mee, dat het object van studie tot verscheidene interpretatief-theoretische benaderingswijzen aanleiding kan geven." ] ;
    sgpl:thesisID 100 .

sgpl:Thesis101 a sgpl:SGPLThesis ;
    dcterms:creator "R. Roosjen",
        "R. Snel" ;
    dcterms:issued 1981 ;
    dcterms:title "Immigratie, oprichting en verplaatsing van kantoren in de gemeente Utrecht, 1975-1980 resultaten van een enquete",
        "Kantoren in Midden - Utrecht" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6621526 ;
            sgpl:spatialText "binnenstad" ;
            sgpl:text_context "Enerzijds is er het moderne zakendistrikt van Hoog Catharijne en andere onderdelen van de Stationsbuurt, getypeerd door moderne, prijzige kommerciële kantoren met minstens een nationaal taakveld. Anderzijds bestaat het aangrenzende centrale deel van de binnenstad uit merendeels kleine kantoren met een bonte mengeling van aktiviteiten, soms geaksentueerd door het winkelkarakter (uitzend- en reisburo's). Andere delen van de binnenstad behoren niet tot het'stadscentrum, doch herbergen wel kleine kantoren voor kommerciële en sociale dienstverlening, de laatste veelal in goedkope panden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Onderzoekenreeks Stedelijke Problematiek West-Nederland rapport no 5b Utrecht, october 1981. Kantoren m Midden - Utrecht Immigratie, oprichting en verplaatsing van kantoren in de gemeente Utrecht, 1975-1980 resultaten van een enquête. R. Roosjen R. Snel Rijksuniversiteit Utrecht, Geografisch Instituut, Heidelberglaan 2, Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Rijnsweerd" ;
            sgpl:text_context "Op de industrieterreinen in Lage Weide en Kanaleneiland-Zuid zijn wel enige grootschalige kantoorpanden te vinden. De gigantische kantoorpanden in Rijnsweerd en Westravenflat in het uiterste zuiden van Kanaleneiland vormen \"kantooreilanden\" welke geheel op zichzelf staan. Naast de vestigingen van de overheid zijn hier ook verzekeringsmaatschappijen gevestigd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Hoog Catharijne" ;
            sgpl:text_context "Het stadscentrum vervult een tweeledige, dominante rol. Enerzijds is er het moderne zakendistrikt van Hoog Catharijne en andere onderdelen van de Stationsbuurt, getypeerd door moderne, prijzige kommerciële kantoren met minstens een nationaal taakveld. Anderzijds bestaat het aangrenzende centrale deel van de binnenstad uit merendeels kleine kantoren met een bonte mengeling van aktiviteiten, soms geaksentueerd door het winkelkarakter (uitzend- en reisburo's)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748815 ;
            sgpl:spatialText "Overvecht" ;
            sgpl:text_context "In tegenstelling tot bijvoorbeeld de Rijswijkse \"In den Boogaard\" in de Haagse agglomeratie is de vorming van duidelijke subcentra waar zowel een uitgebreid winkelapparaat als een koncentratie van kantoren te vinden zijn, in Utrecht nooit echt tot stand gekomen. Bij het winkelcentrum Overvecht is wel enige kantoorruimte te vinden maar de echte grote kantorenkoncentraties bevinden zich elders in deze wijk (Kaap Hoorndreef, Tiberdreef en net buiten Overvecht: W. Dreeslaan). Op Kanaleneiland is rondom het belangrijkste winkelcentrum beduidend meer kantoorruimte te vinden, doch ook hier geldt dat de totale aanwezige kantoorruimte veel meer over de gehele wijk is verspreid (onder andere langs bijna de gehele Beneluxlaan)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "De Amsterdamse en Rotterdamse kantorensektor hebben in de literatuur reeds enige aandacht gehad. De Haagse regio is wat dat betreft belicht in de reeks studies die het Utrechtse Geografisch Instituut heeft ondernomen in vijf steden in opdracht van de Rijksplanologische Dienst (buiten Den Haag gaat het om Breda, Groningen, Nijmegen en Zwolle). Deze deelstudies zijn inmiddels gepubliceerd, evenals het hoofdrapport \"Kantoren en ruimte." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Bij de nevenvestigingen is gevraagd naar de lokatie van het hoofdkantoor. Er wordt verwezen naar 4 hoofdkantoren in Utrecht, terwijl door 51 vestigingen een hoofdkantoor buiten Utrecht wordt vermeld (Tab. 3.7). Amsterdam en Den Haag worden, evenals in 1978, vaak genoemd (12), terwijl verbindingen met Rotterdam op dit vlak vrijwel ontbreken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753082 ;
            sgpl:spatialText "Kanaleneiland" ;
            sgpl:text_context "Bij het winkelcentrum Overvecht is wel enige kantoorruimte te vinden maar de echte grote kantorenkoncentraties bevinden zich elders in deze wijk (Kaap Hoorndreef, Tiberdreef en net buiten Overvecht: W. Dreeslaan). Op Kanaleneiland is rondom het belangrijkste winkelcentrum beduidend meer kantoorruimte te vinden, doch ook hier geldt dat de totale aanwezige kantoorruimte veel meer over de gehele wijk is verspreid (onder andere langs bijna de gehele Beneluxlaan). Behoudens de kantoorontwikkelingen in Zeist (5) komen er in de gemeenten rond Utrecht geen kantorenkoncentraties van enig belang voor." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750324 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Op dit moment wordt opnieuw aandacht besteed aan de stad Amersfoort, een vervolg op kantorenonderzoek uit 1975 en wordt overwogen om tot een aanvullend onderzoek in Midden-Utrecht te komen voor wat betreft de gemeenten rond de stad Utrecht, vooral in de gemeenten Maarssen, Nieuwegein en Houten. Hun onderzoek is meer dan een inventarisatie, de achtergronden van de lokatie- dynamiek komen aan de hand van analyses van vele kenmerken aan de orde. Daarbij gaat het om Utrecht binnenkomende kantoren, oprichtingen en verplaatsingen binnen de stad, in onderling vergelijk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Midden - Utrecht" ;
            sgpl:text_context "Onderzoekenreeks Stedelijke Problematiek West-Nederland rapport no 5b Utrecht, october 1981. Kantoren m Midden - Utrecht Immigratie, oprichting en verplaatsing van kantoren in de gemeente Utrecht, 1975-1980 resultaten van een enquête. R. Roosjen R. Snel Rijksuniversiteit Utrecht, Geografisch Instituut, Heidelberglaan 2, Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:11525082 ;
            sgpl:spatialText "Stationsbuurt" ;
            sgpl:text_context "Het stadscentrum vervult een tweeledige, dominante rol. Enerzijds is er het moderne zakendistrikt van Hoog Catharijne en andere onderdelen van de Stationsbuurt, getypeerd door moderne, prijzige kommerciële kantoren met minstens een nationaal taakveld. Anderzijds bestaat het aangrenzende centrale deel van de binnenstad uit merendeels kleine kantoren met een bonte mengeling van aktiviteiten, soms geaksentueerd door het winkelkarakter (uitzend- en reisburo's)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2752014 ;
            sgpl:spatialText "Lage Weide" ;
            sgpl:text_context "Op het bedrijfsterrein Overvecht-Noord slechts een enkel kantoor aan, dat meestal gelieerd is aan groothandelsaktiviteiten. Op de industrieterreinen in Lage Weide en Kanaleneiland-Zuid zijn wel enige grootschalige kantoorpanden te vinden. De gigantische kantoorpanden in Rijnsweerd en Westravenflat in het uiterste zuiden van Kanaleneiland vormen \"kantooreilanden\" welke geheel op zichzelf staan." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1361 ;
            sgpl:subjectText "Ontkantoringsbeleid" ;
            sgpl:text_context "Nog geen tiende van de ondervraagden wenste het kantoor naar elders, buiten Utrecht, te verplaatsen (voor de helft afkomstig uit de oude binnenstad). De schrijvers pleiten voor duidelijke lokatie-altematieven buiten de oude stadsdelen voor kleine kantoren indien de gemeente het 'ontkantoringsbeleid' wenst voort te zetten zonder de werkgelegenheid te zeer in de waagschaal te stellen. Summary - Immigration establishing and relocation of offices in Utrecht 1975-1980." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "Kantoorvestigingen" ;
            sgpl:text_context "Het model verdeelt het stadsgewest in 5 belangrijke deelgebieden: 1. Het hoofdverzorgingscentrum - Het hoofdverzorgingscentrum heeft veelal de hoogste koncentratie van kantoorvestigingen. De kantoren zijn veelal financieel sterk wat verklaarbaar is vanwege de hoge grondprijzen en de grote konkurrentie ten aanzien van de gebouwen." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "Ruimtelijk gedrag" ;
            sgpl:text_context "Alvorens de probleemstellingen van dit onderzoek te formuleren, is het noodzakelijk te komen tot een (reeds gegeven) definitie van het begrip kantoor (1.2); uiteen te zetten wat moet worden verstaan onder ruimtelijk (1.3) en (re)lokationeel (1.4) gedrag van een kantoor en een theoretische indeling (geleding) van een stad(sgewest) te maken (1.5). 1.3 Ruimtelijk gedrag van een kantoor - Onder ruimtelijk gedrag van een kantoor dient te worden verstaan 'De oriëntering van de organisatie op de omgeving voorzover deze oriëntering in ruimtelijke relaties tot uiting komt' (9). Tussen het kantoor en de omgeving (samenleving, maatschappij) vindt een voortdurend proces van wederzijdse beïnvloeding plaats." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "Ruimtelijk gedrag" ;
            sgpl:text_context "Alvorens de probleemstellingen van dit onderzoek te formuleren, is het noodzakelijk te komen tot een (reeds gegeven) definitie van het begrip kantoor (1.2); uiteen te zetten wat moet worden verstaan onder ruimtelijk (1.3) en (re)lokationeel (1.4) gedrag van een kantoor en een theoretische indeling (geleding) van een stad(sgewest) te maken (1.5). 1.3 Ruimtelijk gedrag van een kantoor - Onder ruimtelijk gedrag van een kantoor dient te worden verstaan 'De oriëntering van de organisatie op de omgeving voorzover deze oriëntering in ruimtelijke relaties tot uiting komt' (9). Tussen het kantoor en de omgeving (samenleving, maatschappij) vindt een voortdurend proces van wederzijdse beïnvloeding plaats." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "Kantoorvestigingen" ;
            sgpl:text_context "Het model verdeelt het stadsgewest in 5 belangrijke deelgebieden: 1. Het hoofdverzorgingscentrum - Het hoofdverzorgingscentrum heeft veelal de hoogste koncentratie van kantoorvestigingen. De kantoren zijn veelal financieel sterk wat verklaarbaar is vanwege de hoge grondprijzen en de grote konkurrentie ten aanzien van de gebouwen." ],
        [ sgpl:refersToConcept unesco:concept1361 ;
            sgpl:subjectText "Ontkantoringsbeleid" ;
            sgpl:text_context "Nog geen tiende van de ondervraagden wenste het kantoor naar elders, buiten Utrecht, te verplaatsen (voor de helft afkomstig uit de oude binnenstad). De schrijvers pleiten voor duidelijke lokatie-altematieven buiten de oude stadsdelen voor kleine kantoren indien de gemeente het 'ontkantoringsbeleid' wenst voort te zetten zonder de werkgelegenheid te zeer in de waagschaal te stellen. Summary - Immigration establishing and relocation of offices in Utrecht 1975-1980." ] ;
    sgpl:thesisID 101 .

sgpl:Thesis102 a sgpl:SGPLThesis ;
    dcterms:creator "Coja Jansen",
        "Marlies Vulto" ;
    dcterms:issued 1981 ;
    dcterms:title "De belemmeringen vanuit de woonomgeving bij het ondernemen van aktiviteiten buitenshuis door vrouwen met jonge kinderen die in een nieuwbouwwijk wonen",
        "Met een case-study in Maarssenbroek",
        "VROUWEN IN EEN NIEUWBOUWWIJK: VASTGEBOUWD?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751316 ;
            sgpl:spatialText "Maarssen-dorp" ;
            sgpl:text_context "Er is alleen een Scouting en een jeugdsociëteit. Voor een diskotheek moeten zij naar Maarssen-dorp. Uit het onderzoek van Lagendijk bleek dan ook dat 55% van de ondervraagden geheel of gedeeltelijk ontevreden was over het vertier voor lagere schoolkinderen en 62% was geheel of ten dele ontevreden over de ontspanningsmoge- lijkheden voor tieners (Lagendijk 1979, p.2.5)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Reigerskamp" ;
            sgpl:text_context "We wilden ongeveer 100 vrouwen enquêteren. In Reigerskamp staan echter vele huizen leeg, en we moesten rekening houden met een aantal weigeringen. Met een steekproeffraktie van 1 op de 42 huizen kwamen we op 134 enquêteadressen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751316 ;
            sgpl:spatialText "gemeente Maarssen" ;
            sgpl:text_context "4.2. Bevolking en woningbouw 4.2.1. Bevolkingsgroei en -samenstelling De bevolking van de gemeente Maarssen groeide tot 1973 ongeveer met het gemiddelde Nederlandse groeipercentage. Pas na 1973 is men begonnen met grootschalige woningbouw in Maarssenbroek en is de bevolking zeer snel gaan groeien, zoals tabel 4.1. weergeeft." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "In de inleiding vertelden we reeds, dat de eerste fase van ons onderzoek bestand uit een aantal gesprekken met opbouwwerkers in verschillende nieuwbouwwijken. Dit waren: Overvecht, Lunetten (twee buitenwijken van Utrecht), Nieuwegein (een groeikern in de buurt van Utrecht), en Maarssenbroek (een 'illegale' groeikern tussen Utrecht en Amsterdam). Onze voorkeur ging allereerst uit naar een nieuwbouwwijk die min of meer zelfstandig is opgezet, zoals Maarssenbroek of Nieuwegein." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Boomstede" ;
            sgpl:text_context "Op het moment dat het onderzoek uitgevoerd wordt (1981 ) is het winkelaanbod als volgt. In Boomstede is een winkelcentrum gereed van - 1.200 m2. Daarnaast is er een winkelcentrum in Reigerskamp van 600 m2." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Dit waren: Overvecht, Lunetten (twee buitenwijken van Utrecht), Nieuwegein (een groeikern in de buurt van Utrecht), en Maarssenbroek (een 'illegale' groeikern tussen Utrecht en Amsterdam). Onze voorkeur ging allereerst uit naar een nieuwbouwwijk die min of meer zelfstandig is opgezet, zoals Maarssenbroek of Nieuwegein. Zo'n wijk kan niet zo sterk leunen op voorzieningen van een grootstedelijk centrum, zoals Overvecht en Lunetten, welke terug kunnen vallen op Utrecht-centrum." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751314 ;
            sgpl:spatialText "Maarssenbroek" ;
            sgpl:text_context "Door deze gesprekken werd ons vermoeden bevestigd dat vrouwen die in nieuwbouwwijken wonen, wel degelijk te kampen hebben met specifieke problemen. In hoofdstuk 4 wordt de ontwikkeling en huidige struktuur van de nieuwbouwwijke waar ons onderzoek heeft plaatsgevonden, namelijk Maarssenbroek, beschreven. Na deze oriëntering op het thema is een onderzoeksopzet gemaakt, welke is weergegeven in hoofdstuk 5." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751738 ;
            sgpl:spatialText "Lelystad" ;
            sgpl:text_context "Omdat man en vrouw elkaar de hele dag veelal niet zien en omdat zij meestal samen uitgaan, zal de neiging van de man die een grote woon-werk afstand af moet leggen om 's avonds thuis te blijven, ook zijn eventuele echtgenote in haar aktiviteiten buitenshuis beperken. Meijer deed onderzoek in Lelystad naar de invloed van de langdurige afwezigheid van de man voor zijn werk (Meijer 1979). Lelystad is een nieuwe stad in Oostelijk Flevoland en ligt ver van her 'oude land' waar de meeste werkgelegenheid en uitgaansmogelijkheden zich bevinden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Wat zijn de oorzaken van het feit dat het verschijnsel nieuwbouwwijk zo'n hoge vlucht heeft genomen, en hoe ziet de sociaal-rdimtelijke struktuur van de meeste nieuwbouw- wijken eruit? 1.2.1. Het ontstaan van de nieuwbouwwijken Na de Tweede Wereldoorlog en de daarmee samenhangende stagnatie in de bouwaktiviteit is men in de jaren vijftig in Nederland weer op grote schaal met de woningbouw begonnen. Met name in de steden kwamen er snel vele woningen bij voor de grote aantallen woningzoekenden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "het Amsterdamse" ;
            sgpl:text_context "Uit Maarssen zelf is 17% afkomstig. Uit het Amsterdamse komt 14% (Lagendijk 1 979, p.2.1 ,). De bevolkingsopbouw naar leeftijd en geslacht is weergegeven op bijlage 5." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Nieuwbouwwijken" ;
            sgpl:text_context "Onder meer door aktiviteiten in de vrouwenbeweging werden we ons bewust van het feit dat veel vrouwen door de strikte arbeidsverdeling - in 'mannen- en vrouwentaken' in de problemen komen. Daarbij hebben we de indruk, dat de problematiek van vrouwen zeer duidelijk naar voren komt in nieuwbouwwijken, omdat deze woongebieden in het algemeen de minste alternatieven (lijken te) bieden voor de huisvrouwentaak in de vorm van werkgelegenheid voor vrouwen, kinderopvang en dergelijke. Dit alles wil overigens niet zeggen dat vrouwen in andere woonomgevingen minder problemen zouden hebben en evenmin dat de arbeidsverdeling naar sekse en de woonomgeving voor mannen probleemloos is." ],
        [ sgpl:refersToConcept unesco:concept10145 ;
            sgpl:subjectText "Tijd-ruimte benadering" ;
            sgpl:text_context "Bij de tweede soort onderzoeken gaat men er van uit dat ieder individu per dag slechts een beperkte hoeveelheid tijd tot zijn beschikking heeft om dingen te doen, en dat dit betekent dat ieder persoon zich ook slechts in een beperkte ruimte kan bewegen. De Zweedse geograaf Hagerstrand, die de grondlegger van deze benadering is, koppelt de begrippen ruimte en tijd in deze zin nadrukkelijk aan elkaar (Hagerstrand 1970). Deze benadering houdt zich niet zozeer bezig met de konkrete tijdsbesteding van individuen maar met de mogelijkheden die zij hebben om de dag te besteden, gegeven een aantal beperkingen (Parkes e.a. 1980, p.243)." ],
        [ sgpl:refersToConcept unesco:concept1304 ;
            sgpl:subjectText "Aktiviteitenpatronen" ;
            sgpl:text_context "Hiertegenover staat Koerse's eigen definitie van wat wonen moet zijn, namelijk: het verblijven temidden van de aktiviteiten die in een samenleving plaats vinden. Deze uiteengelegde ruimtelijke struktuur heeft invloed op de aktiviteitenpatronen van mensen. In het volgende hoofdstuk zullen we hierop ingaan." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Nieuwbouwwijken" ;
            sgpl:text_context "Onder meer door aktiviteiten in de vrouwenbeweging werden we ons bewust van het feit dat veel vrouwen door de strikte arbeidsverdeling - in 'mannen- en vrouwentaken' in de problemen komen. Daarbij hebben we de indruk, dat de problematiek van vrouwen zeer duidelijk naar voren komt in nieuwbouwwijken, omdat deze woongebieden in het algemeen de minste alternatieven (lijken te) bieden voor de huisvrouwentaak in de vorm van werkgelegenheid voor vrouwen, kinderopvang en dergelijke. Dit alles wil overigens niet zeggen dat vrouwen in andere woonomgevingen minder problemen zouden hebben en evenmin dat de arbeidsverdeling naar sekse en de woonomgeving voor mannen probleemloos is." ],
        [ sgpl:refersToConcept unesco:concept10145 ;
            sgpl:subjectText "Tijd-ruimte benadering" ;
            sgpl:text_context "Bij de tweede soort onderzoeken gaat men er van uit dat ieder individu per dag slechts een beperkte hoeveelheid tijd tot zijn beschikking heeft om dingen te doen, en dat dit betekent dat ieder persoon zich ook slechts in een beperkte ruimte kan bewegen. De Zweedse geograaf Hagerstrand, die de grondlegger van deze benadering is, koppelt de begrippen ruimte en tijd in deze zin nadrukkelijk aan elkaar (Hagerstrand 1970). Deze benadering houdt zich niet zozeer bezig met de konkrete tijdsbesteding van individuen maar met de mogelijkheden die zij hebben om de dag te besteden, gegeven een aantal beperkingen (Parkes e.a. 1980, p.243)." ],
        [ sgpl:refersToConcept unesco:concept1304 ;
            sgpl:subjectText "Aktiviteitenpatronen" ;
            sgpl:text_context "Hiertegenover staat Koerse's eigen definitie van wat wonen moet zijn, namelijk: het verblijven temidden van de aktiviteiten die in een samenleving plaats vinden. Deze uiteengelegde ruimtelijke struktuur heeft invloed op de aktiviteitenpatronen van mensen. In het volgende hoofdstuk zullen we hierop ingaan." ] ;
    sgpl:thesisID 102 .

sgpl:Thesis103 a sgpl:SGPLThesis ;
    dcterms:creator "KEES WERKHOVEN" ;
    dcterms:issued 1980 ;
    dcterms:title "RUIMTELIJKE ORDENING en SOCIAAL-EKONOMIES BELEID" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Limburg" ;
            sgpl:text_context "Hoofdstuk 9 : N&ord-Brabant. Hoofdstuk 10: Limburg. Hoofdstuk 11: De dienstensektor in het regionale beleid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743698 ;
            sgpl:spatialText "Zuid-Holland" ;
            sgpl:text_context "Hoofdstuk 7 : Nbord-Holland. Hoofdstuk 8 : Zuid-Holland. Hoofdstuk 9 : N&ord-Brabant." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "IJsselvallei" ;
            sgpl:text_context "Bijlage I : Het beleid voor de verschillende gebieden. Bijlage II : Uitvoeringsschema bedrijfsterreinen, behorende bij Ontwerp Streekplan Usselvallei. Bijlage III: Sectorprogramma bedrijfsterreinen, behorende bij Ontwerp Streekplan Zuid-Holland West." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "Hoofdstuk 8 : Zuid-Holland. Hoofdstuk 9 : N&ord-Brabant. Hoofdstuk 10: Limburg." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756631 ;
            sgpl:spatialText "Drenthe" ;
            sgpl:text_context "Hoofdstuk 3 : Friesland. Hoofdstuk 4 : Drenthe. Hoofdstuk 5 : Overijssel." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "KEES WERKHOVEN Utrecht, 1980. INSTITUUT voor PLANOLOGIE RIJKSUNIVERSITEIT UTRECHT. Naar aanleiding van de voorplaat: '....dat er een min of meer bizondere vorm van ko&rdinatie tussen de facetten ruimtelijk en ekonomies beleid moet zijn." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755249 ;
            sgpl:spatialText "Groningen" ;
            sgpl:text_context "Hoofdstuk 1 : Inleiding. Hoofdstuk 2 : Groningen. Hoofdstuk 3 : Friesland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het regionaal ekoncmies beleid heeft zich de laatste dertig jaar ontwikkeld van een eenvoudig industrialisatiebeleid, waarbij de struktureel achtergebleven regio’s door middel van het aantrekken van industri&le nijverheid gestimuleerd moesten worden, tot een meer integrale aanpak van de sociaal-ekoncmiese problematiek in de verschillende regio's van Nederland. Deze verandering van aanpak kunnen wij ook terugvinden in de naamsverandering. De eerste regionale ekonomiese beleidsmaatregelen werden verpakt in industrialisatienota' s ( in totaal zijn er 8 verschenen) terwijl wij nu spreken over de Nota regionaal sociaal-econcmisch beleid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Friesland" ;
            sgpl:text_context "Hoofdstuk 2 : Groningen. Hoofdstuk 3 : Friesland. Hoofdstuk 4 : Drenthe." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743698 ;
            sgpl:spatialText "Zuid-Holland West" ;
            sgpl:text_context "Bijlage II : Uitvoeringsschema bedrijfsterreinen, behorende bij Ontwerp Streekplan Usselvallei. Bijlage III: Sectorprogramma bedrijfsterreinen, behorende bij Ontwerp Streekplan Zuid-Holland West. Bijlage IV : Overzicht van prioriteiten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "1) Betere spreiding van bevolking en werkgelegenheid (en welzijnsvoorzieningen) over het land: a) uitstraling van de bevolking en werkgelegenheid van de Randstad in noordelijke, oostelijke en zuidelijke richting, naar de Usselmeerpolders, naar het westen van Noord-Brabant en naar Zeeland. b) spreiding van bevolking en werkgelegenheid naar het noorden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "Overijssel" ;
            sgpl:text_context "Hoofdstuk 4 : Drenthe. Hoofdstuk 5 : Overijssel. Hoofdstuk 6 : Gelderland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Zuid-Limburg" ;
            sgpl:text_context "12.2. Het Integraal Structuurplan Noorden des Lands. 12.3. De Perspectievennota Zuid-Limburg. Hoofdstuk 13: De sociaal-ekoncmiese komponent van het streekplan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelderland" ;
            sgpl:text_context "Hoofdstuk 5 : Overijssel. Hoofdstuk 6 : Gelderland. Hoofdstuk 7 : Nbord-Holland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Noord-Holland" ;
            sgpl:text_context "Hoofdstuk 6 : Gelderland. Hoofdstuk 7 : Nbord-Holland. Hoofdstuk 8 : Zuid-Holland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Noorden des Lands" ;
            sgpl:text_context "12.1. Een vergelijking in de tot stand kcming. 12.2. Het Integraal Structuurplan Noorden des Lands. 12.3. De Perspectievennota Zuid-Limburg." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8751 ;
            sgpl:subjectText "Regionaal sociaal-economisch beleid" ;
            sgpl:text_context "De eerste probleemstelling is dan: In hoeverre is er sprake van een regionale differentiatie van het centraal geregelde regionale sociaal-ekonomiese beleid? Een goed regionaal beleid richt zich dus op de sociaal-ekonomiese problematiek in de verschillende regio's." ],
        [ sgpl:refersToConcept unesco:concept7879 ;
            sgpl:subjectText "Streekplanplanning" ;
            sgpl:text_context "Een goed regionaal beleid richt zich dus op de sociaal-ekonomiese problematiek in de verschillende regio's. De ruimtelijke tegenhanger van dit beleid is zodoende de regionale ruimtelijke planning, die wij in Nederland kennen als streekplanplanning. Een tweede vraag nu is : Kan het streekplan een funktie hebben als integratiekader voor het regionaal sociaal-ekonomies beleid en op welke manier is een eventuele integratie het best te bereiken?" ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Planning van bedrijfsterreinen" ;
            sgpl:text_context "Na de inhoudelijke bespreking van de diverse regionale plannen wordt getracht de sociaal-ekoncmiese kcmponent van de streekplannen nader te analyseren. Hierbij zal dan aandacht worden geschonken aan de verschillen in planning van bedrijfsterreinen en hoe dit verbeterd zou kunnen worden. Vervolgens worden enkele aanzetten gegeven cm te kernen tot een betere afstemming tussen regionaal ruimtelijke en sociaal-ekonomies beleid." ],
        [ sgpl:refersToConcept unesco:concept7879 ;
            sgpl:subjectText "Streekplanplanning" ;
            sgpl:text_context "Een goed regionaal beleid richt zich dus op de sociaal-ekonomiese problematiek in de verschillende regio's. De ruimtelijke tegenhanger van dit beleid is zodoende de regionale ruimtelijke planning, die wij in Nederland kennen als streekplanplanning. Een tweede vraag nu is : Kan het streekplan een funktie hebben als integratiekader voor het regionaal sociaal-ekonomies beleid en op welke manier is een eventuele integratie het best te bereiken?" ],
        [ sgpl:refersToConcept unesco:concept8751 ;
            sgpl:subjectText "Regionaal sociaal-economisch beleid" ;
            sgpl:text_context "De eerste probleemstelling is dan: In hoeverre is er sprake van een regionale differentiatie van het centraal geregelde regionale sociaal-ekonomiese beleid? Een goed regionaal beleid richt zich dus op de sociaal-ekonomiese problematiek in de verschillende regio's." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Planning van bedrijfsterreinen" ;
            sgpl:text_context "Na de inhoudelijke bespreking van de diverse regionale plannen wordt getracht de sociaal-ekoncmiese kcmponent van de streekplannen nader te analyseren. Hierbij zal dan aandacht worden geschonken aan de verschillen in planning van bedrijfsterreinen en hoe dit verbeterd zou kunnen worden. Vervolgens worden enkele aanzetten gegeven cm te kernen tot een betere afstemming tussen regionaal ruimtelijke en sociaal-ekonomies beleid." ] ;
    sgpl:thesisID 103 .

sgpl:Thesis104 a sgpl:SGPLThesis ;
    dcterms:creator "André Versloot",
        "Dick W. Akkies" ;
    dcterms:issued 1982 ;
    dcterms:title "een onderzoek naar de struktuurveranderingen in de werkgelegenheid en de invloed van het gemeentelijk beleid op het bedrijfsleven",
        "werkgelegenheid en beleid in de gemeente zeist" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Utrechtse Heuvelrug" ;
            sgpl:text_context "In de eerste plaats is er de natuurlijke omgeving: met name op de Utrechtse Heuvelrug bevinden zich uitgestrekte bosgebieden, waar in vorige eeuwen uitgebreide landgoederen met grote buitenhuizen werden gesticht. Aangezien deze in de tegenwoordige tijd te hoge kosten met zich meebrengen voor normale bewoning, gaan zij over in de handen van bedrijven en instellingen, die een kantoor in een representatieve omgeving willen stichten. In de tweede plaats is er het gegeven, dat Utrecht zeer centraal is gelegen binnen Nederland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279858 ;
            sgpl:spatialText "Rijnmond" ;
            sgpl:text_context "De vergunningsprocedure wordt altijd toegepast in Rijnmond, elders kan dit door de Minister van Economische Zaken ge&euml;ist worden (JANSSEN, 1979, p. 40). Dit laatste is recent veel toegepast voor de Utrechtse Heuvelrug. In Zeist zelf hebben nog geen weigeringen op grond van de SIR-pr&oacute;cedures plaatsgevonden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743977 ;
            sgpl:spatialText "het centrum van Zeist" ;
            sgpl:text_context "Zeer opvallend daarbij is, dat in Zeist de werkgelegenheid nog steeds blijft toenemen (vooral in de buitenwijken), terwijl elders sprake is van een afbrokkelende werkgelegenheid. De meeste bedrijven waren oorspronkelijk in het centrum van Zeist gevestigd. De nieuwe vestigingsplaats ligt in vier gevallen in de regio, tweemaal in een ander deel van de Randstad en eenmaal in Limburg." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stad Utrecht" ;
            sgpl:text_context "In de eerste plaats is er de natuurlijke omgeving: met name op de Utrechtse Heuvelrug bevinden zich uitgestrekte bosgebieden, waar in vorige eeuwen uitgebreide landgoederen met grote buitenhuizen werden gesticht. Daardoor heeft met name de stad Utrecht uitstekende verbindingen met alle delen van het land. Vanwege dit feit bevinden zich in de omgeving van de stad talrijke handels ondernemingen, distributiecentra en dienstverlenende bedrijven, die landelijk opereren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753556 ;
            sgpl:spatialText "Houten" ;
            sgpl:text_context "Tevens kunnen bedrijven, die zich naar groeikernen verplaatsen, in aanmerking komen voor een verplaatsingstoeslag voor gebouwen. In de buurt van Zeist bevinden zich twee groeikernen, namelijk Houten en Nieuwegein. Het is dan ook waarschijnlijk, dat deze twee gemeenten een aanzienlijke concurrentie voor de gemeente Zeist betekenen, wat betreft bedrijfsvestiging en bedrijfsverplaatsing." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743976 ;
            sgpl:spatialText "gemeente Zeist" ;
            sgpl:text_context "Wij hebben als onderzoek 'werkgelegenheid en beleid in de gemeente Zeist' gekozen, een economisch-geografisch onderwerp. Bij dit onderzoek hebben wij veel hulp gehad van onze begeleider, Drs. J.G. Borchert, met wie wij plezierig hebben samengewerkt en die ons vele adviezen heeft gegeven. Daarvoor verdient hij onze bijzondere dank." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Allereerst wordt de ontwikkeling van de werkgelegenheid op landelijk en provinciaal nivo geanalyseerd. De laatste decennia kenmerkt de ontwikkeling van de werkgelegenheid in Nederland zich vooral door een verschuiving van de secundaire naar de tertiaire sektor. Daardoor kunnen we de Nederlandse maatschappij als post-industrieel beschouwen (v. ASSELDONK en v. SPLUNTER, 1981, p. 14)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "Daarentegen concentreerde de dienstverlening zich meer in het westen. Daarom kunnen we verwachten, dat in de provincie Utrecht, en daarmee ook in Zeist,de tertiairisering zich sterk heeft doorgezet. Daar komt nog bij, dat de provincie Utrecht zich kenmerkt door een relatief gunstig vestigingsklimaat voor met name de bedrijven uit de tertiaire sektor." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "West-Nederlandse steden" ;
            sgpl:text_context "Dit is een onderzoeksproject van de vakgroep S.G.S. van het Geografisch Instituut Utrecht. De onderzoeken in dit project richten zich op de problematiek van de ontwikkeling van de grotere West-Nederlandse steden en vinden vooral plaats in de regio Utrecht, waarvan ook Zeist deel uit maakt. Binnen dit onderzoeksveld hebben wij de werkgelegenheid en het beleid in de gemeente Zeist onderzocht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757240 ;
            sgpl:spatialText "Den Dolder" ;
            sgpl:text_context "De werkgelegenheidsspreiding over de gemeente. De gemeente Zeist omvat naast de kern Zeist nog de kernen Den Dolder, Bosch en Duin en Huis ter Heide in het noorden van de gemeente en Austerlitz in het zuidoosten. Daarom leek het ons interessant eens te bekijken, hoe de werkgelegenheid in deze kernen is opgebouwd en afwijkt van die in de kern Zeist." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6805 ;
            sgpl:subjectText "Werkgelegenheidsstruktuur" ;
            sgpl:text_context "Ook gaan we in op de mogelijkheden die een gemeente heeft om een werkgelegenheidsbeleid te voeren. Om achter de veranderingen in de werkgelegenheidsstruktuur van Zeist te komen, zullen we nagaan hoe de werkgelegenheidsontwikkeling in de periode 1971-1981 is geweest, door de struktuur van 1971 , 1976 en 1981 met elkaar te vergelijken. Belangrijk hierbij is ook, om niet alleen naar de totale werkgelegenheid en aantal vestigingen te kijken, maar ook naar bedrijfstak en bedrijfsklasse." ],
        [ sgpl:refersToConcept unesco:concept7887 ;
            sgpl:subjectText "Werkgelegenheidsbeleid" ;
            sgpl:text_context "De werkgelegenheidsontwikkeling op nationaal en provinciaal nivo wordt behandeld, om de werkgelegenheidsontwikkeling in Zeist een vergelijkingskader te geven. Het beleid van rijks- en provinciale overheid wordt besproken, omdat dit kaderscheppend is voor een gemeentelijk werkgelegenheidsbeleid en van invloed kan zijn op de werkgelegenheidsontwikkeling in een gemeente. Ook gaan we in op de mogelijkheden die een gemeente heeft om een werkgelegenheidsbeleid te voeren." ],
        [ sgpl:refersToConcept unesco:concept15295 ;
            sgpl:subjectText "Bedrijfsvestigingsbeleid" ;
            sgpl:text_context "Het voeren van een beleid ten aanzien van de werkgelegenheid is op gemeentelijk nivo belangrijker geworden, maar richt zich nog vooral op de ruimtelijke aspecten van de bedrijvigheid. Verschillende gemeenten echter zijn al overgegaan op een bedrijfsvestigingsbeleid, waarmee men probeert de voor hen gunstige bedrijven te selekteren. Om een goed werkgelegenheidsbeleid op gemeentelijk nivo te voeren, is het noodzakelijk, dat men inzicht heeft in de werkgelegenheidssituatie en de ontwikkeling hiervan ter plaatse." ],
        [ sgpl:refersToConcept unesco:concept7887 ;
            sgpl:subjectText "Werkgelegenheidsbeleid" ;
            sgpl:text_context "De werkgelegenheidsontwikkeling op nationaal en provinciaal nivo wordt behandeld, om de werkgelegenheidsontwikkeling in Zeist een vergelijkingskader te geven. Het beleid van rijks- en provinciale overheid wordt besproken, omdat dit kaderscheppend is voor een gemeentelijk werkgelegenheidsbeleid en van invloed kan zijn op de werkgelegenheidsontwikkeling in een gemeente. Ook gaan we in op de mogelijkheden die een gemeente heeft om een werkgelegenheidsbeleid te voeren." ],
        [ sgpl:refersToConcept unesco:concept15295 ;
            sgpl:subjectText "Bedrijfsvestigingsbeleid" ;
            sgpl:text_context "Het voeren van een beleid ten aanzien van de werkgelegenheid is op gemeentelijk nivo belangrijker geworden, maar richt zich nog vooral op de ruimtelijke aspecten van de bedrijvigheid. Verschillende gemeenten echter zijn al overgegaan op een bedrijfsvestigingsbeleid, waarmee men probeert de voor hen gunstige bedrijven te selekteren. Om een goed werkgelegenheidsbeleid op gemeentelijk nivo te voeren, is het noodzakelijk, dat men inzicht heeft in de werkgelegenheidssituatie en de ontwikkeling hiervan ter plaatse." ],
        [ sgpl:refersToConcept unesco:concept6805 ;
            sgpl:subjectText "Werkgelegenheidsstruktuur" ;
            sgpl:text_context "Ook gaan we in op de mogelijkheden die een gemeente heeft om een werkgelegenheidsbeleid te voeren. Om achter de veranderingen in de werkgelegenheidsstruktuur van Zeist te komen, zullen we nagaan hoe de werkgelegenheidsontwikkeling in de periode 1971-1981 is geweest, door de struktuur van 1971 , 1976 en 1981 met elkaar te vergelijken. Belangrijk hierbij is ook, om niet alleen naar de totale werkgelegenheid en aantal vestigingen te kijken, maar ook naar bedrijfstak en bedrijfsklasse." ] ;
    sgpl:thesisID 104 .

sgpl:Thesis105 a sgpl:SGPLThesis ;
    dcterms:creator "Fedde Poort",
        "Fer de Bruin",
        "Hans de Leeuw",
        "Jan Minderhoud" ;
    dcterms:issued 1982 ;
    dcterms:title "STEDELIJK BEHEER IN THEORETISCH PERSPECTIEF" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "plein Henegouwen in Amersfoort" ;
            sgpl:text_context "In de Jordaan in Boxtel hebben bewoners, daartoe financieel in staat gesteld door de gemeente, zelf een buurthuis op de kop getikt en het beheer hiervan op zich genomen. De inrichting en het gebruik van het plein Henegouwen in Amersfoort beviel de bewoners niet. Zelf hebben zij dit plein, met hulp van een deskundige, heringericht en aangepast aan de eigen wensen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "1. Stedelijk beheer in theoretisch perspectief. 2.A. Stedelijk beheer in Breda: een case-study. 2.B. Stedelijk beheer in Eindhoven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758460 ;
            sgpl:spatialText "Jordaan in Boxtel" ;
            sgpl:text_context "Voor wat betreft de woonomgeving kunnen een aantal voorbeelden een indruk geven van wat er zoal gaande is. In de Jordaan in Boxtel hebben bewoners, daartoe financieel in staat gesteld door de gemeente, zelf een buurthuis op de kop getikt en het beheer hiervan op zich genomen. De inrichting en het gebruik van het plein Henegouwen in Amersfoort beviel de bewoners niet." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "2.A. Stedelijk beheer in Breda: een case-study. 2.B. Stedelijk beheer in Eindhoven. 3. Stedelijk beheer: een theorie-praktijk-confrontatie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759145 ;
            sgpl:spatialText "binnenstad van Bergen op Zoom" ;
            sgpl:text_context "In een notitie ten behoeve van een te ontwikkelen structuurplan voor de binnenstad van Bergen op Zoom stelt het Research Instituut voor de Gebouwde Omgeving (RIGO), dat de term beheerplanologie in feite een breder terrein omvat dan alleen de ruimtelijke ordening en er onder andere een relatie met volkshuisvestingsaspecten is. Aansluitend bij de ideeën van Bussink heeft het RIGO een analysemethode ontwikkeld ten behoeve van plannen voor (binnen-)steden, die aanzetten levert tot een op beheer van de gebouwde omgeving gerichte planningaanpak. Onder beheer wordt daarbij verstaan: 'Het geheel van maatregelen op het gebied van ruimtelijke ordening en volkshuisvesting dat de gemeentelijke doelstellingen met betrekking tot de gebouwde omgeving zou kunnen realiseren'." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De gerichtheid van de ruimtelijke planning verschuift hiermee van ontwikkeling naar beheer, hetgeen consequenties zal hebben voor alle planningniveaus. Daarnaast is in de ontwikkeling van de ruimtelijke planning in Nederland steeds meer aandacht te onderkennen voor de aan de ruimtelijke ontwikkeling ten grondslag liggende maatschappelijke processen. De aanpak van de problemen blijft hierbij in de sfeer van de toelatingsplanologie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "binnenstad van Groningen" ;
            sgpl:text_context "8.5. Stedelijke Herverkaveling 90. 8.6. Het bestemmingsplan voor de binnenstad van Groningen 93. 8.7. De 'buurtaanpak' 95." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "provincie Noord-Brabant" ;
            sgpl:text_context "De toenemende oriëntatie op beheer op gemeentelijk niveau blijkt ook uit het toevoegen als nieuw onderdeel van de Dienst Ruimtelijke Ordening in Amsterdam van een afdeling Stedebouwkundige Beheerszaken. Voor het provinciaal niveau kan worden verwezen naar de provinciale nota 'Stads- en Dorpsvernieuwing in Noord-Brabant' en het jaarverslag 1980 van de Planologische Dienst van Noord-Brabant. Deze nota’s hebben landelijk als eye-opener gediend voor het nieuwe terrein van de beheerplanologie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "In het kader van onze doctoraalstudie Planologie aan de Instituut voor Planologie aan de Rijksuniversiteit Utrecht is door ons een onderzoek verricht naar 'Stadsbeheer en planningsinstrumenten’. Dit onderzoek is mede een voorstudie in het kader van de voorwaardelijke financiering. In het kader van ons onderzoek zullen een viertal deelrapporten verschijnen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Dienst Ruimtelijke Ordening in Amsterdam" ;
            sgpl:text_context "Het onderzoek van de vakgroep sociologie van bouwen en wonen aan de Rijksuniversiteit Utrecht ’Over het beheer in en van stadsbuurten’ illustreert de aandacht vanuit het gemeentelijk niveau. De toenemende oriëntatie op beheer op gemeentelijk niveau blijkt ook uit het toevoegen als nieuw onderdeel van de Dienst Ruimtelijke Ordening in Amsterdam van een afdeling Stedebouwkundige Beheerszaken. Voor het provinciaal niveau kan worden verwezen naar de provinciale nota ’Stads- en Dorpsvernieuwing in Noord-Brabant' en het jaarverslag 1980 van de Planologische Dienst van Noord-Brabant." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "planningsinstrumentarium" ;
            sgpl:text_context "Doel hiervan is te kunnen beoordelen of het opstellen van dergelijke beleidsplannen wenselijk is. De behoefte aan een meer op uitvoering gericht planningsinstrumentarium ten behoeve van de stadsvernieuwing wordt verkend. Die verkenning is gericht op en vervat in een integraal stadsbeheer." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "stadsbeheer" ;
            sgpl:text_context "De verschillende deelrapporten zijn overigens zodanig opgezet dat ze los van elkaar gelezen kunnen worden. In dit deelrapport vindt een eerste theoretische verkenning van stadsbeheer plaats. Bezien zal worden hoe de huidige stand van zaken met betrekking tot beheer is vanuit een theoretisch perspectief." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Na de aandacht voor de nieuwe woon- en werkgebieden (stadsuitleg) zijn vanaf het begin van de jaren zeventig ook de bestaande bebouwde gebieden in de belangstelling gekomen (stadsvernieuwing). Intussen wijzigt zich ook het karakter van de stadsvernieuwing. Is eerst sloop en nieuwbouw het parool, later worden dat vernieuwbouw, verbetering en instandhouding." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "stadsbeheer" ;
            sgpl:text_context "De verschillende deelrapporten zijn overigens zodanig opgezet dat ze los van elkaar gelezen kunnen worden. In dit deelrapport vindt een eerste theoretische verkenning van stadsbeheer plaats. Bezien zal worden hoe de huidige stand van zaken met betrekking tot beheer is vanuit een theoretisch perspectief." ],
        [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "planningsinstrumentarium" ;
            sgpl:text_context "Doel hiervan is te kunnen beoordelen of het opstellen van dergelijke beleidsplannen wenselijk is. De behoefte aan een meer op uitvoering gericht planningsinstrumentarium ten behoeve van de stadsvernieuwing wordt verkend. Die verkenning is gericht op en vervat in een integraal stadsbeheer." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Na de aandacht voor de nieuwe woon- en werkgebieden (stadsuitleg) zijn vanaf het begin van de jaren zeventig ook de bestaande bebouwde gebieden in de belangstelling gekomen (stadsvernieuwing). Intussen wijzigt zich ook het karakter van de stadsvernieuwing. Is eerst sloop en nieuwbouw het parool, later worden dat vernieuwbouw, verbetering en instandhouding." ] ;
    sgpl:thesisID 105 .

sgpl:Thesis106 a sgpl:SGPLThesis ;
    dcterms:creator "A.L.P. Buitelaar" ;
    dcterms:issued 1988 ;
    dcterms:title "Een onderzoek naar de publieke organisatie in de Middeleeuwse parochie Breukelen, mede bezien tegen het licht van de historische geografie.",
        "MACHT EN ZEGGENSCHAP IN HET MIDDELEEUWSE BREUKELEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758333 ;
            sgpl:spatialText "Middeleeuwse parochie Breukelen" ;
            sgpl:text_context "MACHT EN ZEGGENSCHAP IN HET MIDDELEEUWSE BREUKELEN. Een onderzoek naar de publieke organisatie in de Middeleeuwse parochie Breukelen, mede bezien tegen het licht van de historische geografie. A.L.P. Buitelaar /VOOR GESÊnltDSWS DSR •\\ RIJXS-UHIVdRSiTEJÏ Dokt oraalsc ript ie Rijksuniversiteit Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749192 ;
            sgpl:spatialText "gerecht Oud-Aa" ;
            sgpl:text_context "Zodoende vinden we de bisschop als opper-leenheer van een complex leengoederen, waaronder het gerecht van Otterspoorbroek en diverse kleinere gerechten en tiencien; van een ander complex waarin zich het gerecht van Oud-Aa bevindt, heb ik niet gevonden, dat je bisschop opperleenheer was, maar gezien zijn oorspronkelijk eigendom over deze gebieden, hem door koning Otro geschonken zou het heel wel mogelijk zijn. Kortom, uit al deze goederen langs de Vecht gaf de bisschop goederen in leen, die konden bestaan uit landerijen of ontginningshoeven, al of niet met gerecht, tijns en tienden, of ook uit gerecht, tijns en tiende van een gehele ontginningseenheid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758333 ;
            sgpl:spatialText "gemeente Breukelen" ;
            sgpl:text_context "A.L.P. Buitelaar /VOOR GESÊnltDSWS DSR •\\ RIJXS-UHIVdRSiTEJÏ Dokt oraalsc ript ie Rijksuniversiteit Utrecht. Uitgevoerd mede in opdracht van \"de commissie terzake van de beschrijving van de geschiedenis van de gemeente Breukelen\". UNIVERSITEITSBIBLIOTHEEK UTRECHT 3725 7106 INHOUDS OPGA VE Inhoudsopgave 2." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "A.L.P. Buitelaar /VOOR GESÊnltDSWS DSR •\\ RIJXS-UHIVdRSiTEJÏ Dokt oraalsc ript ie Rijksuniversiteit Utrecht. Uitgevoerd mede in opdracht van \"de commissie terzake van de beschrijving van de geschiedenis van de gemeente Breukelen\". UNIVERSITEITSBIBLIOTHEEK UTRECHT 3725 7106 INHOUDS OPGA VE Inhoudsopgave 2." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "gerecht Otterspoorbroek" ;
            sgpl:text_context "Zodoende vinden we de bisschop als opper-leenheer van een complex leengoederen, waaronder het gerecht van Otterspoorbroek en diverse kleinere gerechten en tiencien; van een ander complex waarin zich het gerecht van Oud-Aa bevindt, heb ik niet gevonden, dat je bisschop opperleenheer was, maar gezien zijn oorspronkelijk eigendom over deze gebieden, hem door koning Otro geschonken zou het heel wel mogelijk zijn. Kortom, uit al deze goederen langs de Vecht gaf de bisschop goederen in leen, die konden bestaan uit landerijen of ontginningshoeven, al of niet met gerecht, tijns en tienden, of ook uit gerecht, tijns en tiende van een gehele ontginningseenheid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758329 ;
            sgpl:spatialText "Breukelerveen" ;
            sgpl:text_context "De 19e eeuwse gemeente Breukelen-Sint-Pieters omvatte de gerechten (ook van vóór 1795) Breukelen-Sint-Piet ers en Breukelerveen. De Middeleeuwse parochie Breukelen echter omvatte méér gerechten dan de 19e eeuwse gemeenten Breukelen-Nijenrode en Breukelen-Sint-Pieters tezamen; ook de gerechten Bre ukelerwaard& en Vijf hoeven vielen onder de parochie Breukelen (voor toelichting: zie figuur 1). Op grond van bovenstaande overwegingen zou ik dan ook, in navolging van Middeleeuws gebruik, \"Breukelen\" willen opvatten als het grondgebied van de Middeleeuwse parochie Breukelen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755041 ;
            sgpl:spatialText "Gunterstein" ;
            sgpl:text_context "Te Breukelen stonden in de Middeleeuwen drie versterkte huizen, nl. Nijenrode, Gunterstein en Oudaan en net buiten Breukelen het huis Ruwiel. De bewoners zullen ongetwijfeld tot de \"personen met flinke bezittingen\" behoord hebben. Kerkelijk gezien lag de parochie Breukelen in het aaxtsdia- konaat van de proost van Oudmunster, in het dekanaat luxta Vechtam." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750081 ;
            sgpl:spatialText "Nijenrode" ;
            sgpl:text_context "Te Breukelen stonden in de Middeleeuwen drie versterkte huizen, nl. Nijenrode, Gunterstein en Oudaan en net buiten Breukelen het huis Ruwiel. De bewoners zullen ongetwijfeld tot de \"personen met flinke bezittingen\" behoord hebben. Kerkelijk gezien lag de parochie Breukelen in het aaxtsdia- konaat van de proost van Oudmunster, in het dekanaat luxta Vechtam." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758333 ;
            sgpl:spatialText "Breukelen" ;
            sgpl:text_context "Alvorens op zoek te gaan naar bronnenmateriaal over \"Breukelen\" in een bepaalde periode zal allereerst vastgesteld moeten worden wat we onder \"Breukelen\" willen verstaan. De gemeentegrenzen, zoals die op de topografische kaart van 1969/1970 staan aangegeven vormen geen geschikt uitgangspunt; deze grenzen vallen op veel plaatsen in het geheel niet samen met het bestuurlijk kader van vóór 1795, de gerechtsgrenzen. Hoewel de grenzen van de gemeenten in de periode tussen de Franse tijd en 1940 (\"de 19e eeuwse gemeenten\") wel de gerechtsgrenzen volgden (zij bestonden steeds uit een aantal samengevoegde gerechten), biedt ook dit criterium geen geschikte oplossing; weliswaar had men de 19e eeuwse gemeenten geformeerd door samenvoeging van een aantal gerechten uit de periode van vóór 1795, doch andere uitgangspunten dan de bestaande gerechten enerzijds en bestuurbaarheid anderzijds zijn vermoedelijk niet gehanteerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Sticht Utrecht" ;
            sgpl:text_context "Vanaf het moment, waarop er in de bronnen sprake is van Breukelen (vanaf tiet jaar 1139), is Breukelen Stichts gebied geweest en gebleven. De landsheer van tier Sticht was steeds de bissctiop van Utrecht, totdat deze in 1548 tier veld moest ru.men voor keizer Karei V. Het gezag op locaal niveau was georganiseerd per gerecht; de narren van de gerechten, vallend onder de parochie Breukelen wijzen reeds in de richting van de bezitters van deze gerechtsheerlikheden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11251 ;
            sgpl:subjectText "Veenontginningen" ;
            sgpl:text_context "Ten westen en ten oosten van de stroomrug- en komkleigronden, die zich langs en tussen de rivierlopen Vecht en Aa bevinden, strekken zich de klei-op-veen en veengronden uit. Moesten we bij de beschrijving van de vroege geografische structuur van de rivierkleigronden de bodemkunde betrekken omdat naast menselijk ingrijpen ook de verschillende rivierlopen zeer bepalend zijn geweest voor het totstandkomen van deze structuur, een beschrijving van de veenontginningen zal veeleer vanuit de historische bronnen te werk moeten gaan; menselijk ingrijpen heeft de natuur hier dusdanig gereguleerd en vorm gegeven dat we slechts kunnen pogen met behulp van gegevens uit de schriftelijke bronnen (meest van na de ontginning) en het kaartbeeld, dat door de ontginningen is ontstaan, het verloop van deze ontginningen te reconstrueren. Wat betreft vorm en tijd van de ontginning zijn de ontginningen ten westen van de Vecht bovendien zo verschillend van de ontginningen ten oosten van de Vecht, dat we een beschrijving van deze ontginningen hier willen laten rusten; per gerecht zal de eigenaardigheid van de ontginningsvorm onder de loep genomen worden met de bedoeling tot een, voor zover mogelijk afgerond beeld te komen van de ontginningsgeschiedenis van de veengronden onder de parochie Breukelen." ],
        [ sgpl:refersToConcept unesco:concept3211 ;
            sgpl:subjectText "Publieke organisatie" ;
            sgpl:text_context "Hoe het ook zij, het merendeel van het archief is zoekgeraakt, een deel bevindt zich zoals gezegd op het Rijksarchief Utrecht; op het kasteel Nijenrode bevinden zich nog eens 38 charters (het zou overigens voor eenvoudiger toegankelijkheid tot deze charters en voor meer eenheid in het resterend materiaal aanbeveling verdienen om deze 38 charters in bewaring te geven op het Rijksarchief te Utrecht). Een deel van de 38 charters op Nijenrode kan ons verder helpen met het onderzoek naar de publieke organisatie van een aantal Breukelse gerechten ten westen van de Vecht, waartoe ook de regestenlijst van de Geer een waardevolle bijdrage zal kunnen leveren. Afgaande op het bronnenmateriaal dat we aantroffen op het Rijksarchief te Utrecht, aangevuld met de charters op het huis Nijenrode en de regestenlijst van de Geer, zou het onderwerp \"de Middeleeuwse geschiedenis van Breukelen\" voorlopig als volgt ingevuld kunnen worden: er staan ons gegevens ter beschikking betreffende het geestelijk gezag in de Middeleeuwse parochie Breukelen en betreffende het wereldlijk gezag in de diverse gerechten van de parochie Breukelen; anders gezegd betreffende de publieke organisatie in het Middeleeuwse Breukelen." ],
        [ sgpl:refersToConcept unesco:concept11417 ;
            sgpl:subjectText "Historische geografie" ;
            sgpl:text_context "Gezien het ontginningskarakter van het westelijk en oostelijk gedeelte van de parochie Breukelen kan men van de veronderstelling uitgaan, dat de wijze waarop en de vorm waarin deze ontginningen tot stand kwamen van grote invloed is geweest op de bestuursorganisatie, die in dit gebied ontstond en op de verdeling van de macht in dit gebied. Om die reden zal voorafgaande aan een hoofdstuk over het bestuur in het westelijk deel van het Sticht Utrecht aandacht gegeven worden aan de historische geografie van Breukelen; ook de beschrijving van het bestuur in de Middeleeuwen van elk van de Breukelse gerechten afzonderlijk zal door een uiteenzetting over de (historische) geografie van het betreffende gerecht voorafgegaan worden. Als afsluiting willen we proberen, op basis van de beschrijving van het bestuur en van de conflicten, die zich rond macht en zeggenschap op geestelijk en wereldlijk niveau hebben afgespeeld, conclusies te trekken over de machtsverhoudingen in de parochie Breukelen en de verschuivingen waaraan deze verhoudingen in de loop van de Middeleeuwen onderhevig waren." ],
        [ sgpl:refersToConcept unesco:concept3211 ;
            sgpl:subjectText "Publieke organisatie" ;
            sgpl:text_context "Hoe het ook zij, het merendeel van het archief is zoekgeraakt, een deel bevindt zich zoals gezegd op het Rijksarchief Utrecht; op het kasteel Nijenrode bevinden zich nog eens 38 charters (het zou overigens voor eenvoudiger toegankelijkheid tot deze charters en voor meer eenheid in het resterend materiaal aanbeveling verdienen om deze 38 charters in bewaring te geven op het Rijksarchief te Utrecht). Een deel van de 38 charters op Nijenrode kan ons verder helpen met het onderzoek naar de publieke organisatie van een aantal Breukelse gerechten ten westen van de Vecht, waartoe ook de regestenlijst van de Geer een waardevolle bijdrage zal kunnen leveren. Afgaande op het bronnenmateriaal dat we aantroffen op het Rijksarchief te Utrecht, aangevuld met de charters op het huis Nijenrode en de regestenlijst van de Geer, zou het onderwerp \"de Middeleeuwse geschiedenis van Breukelen\" voorlopig als volgt ingevuld kunnen worden: er staan ons gegevens ter beschikking betreffende het geestelijk gezag in de Middeleeuwse parochie Breukelen en betreffende het wereldlijk gezag in de diverse gerechten van de parochie Breukelen; anders gezegd betreffende de publieke organisatie in het Middeleeuwse Breukelen." ],
        [ sgpl:refersToConcept unesco:concept11417 ;
            sgpl:subjectText "Historische geografie" ;
            sgpl:text_context "Gezien het ontginningskarakter van het westelijk en oostelijk gedeelte van de parochie Breukelen kan men van de veronderstelling uitgaan, dat de wijze waarop en de vorm waarin deze ontginningen tot stand kwamen van grote invloed is geweest op de bestuursorganisatie, die in dit gebied ontstond en op de verdeling van de macht in dit gebied. Om die reden zal voorafgaande aan een hoofdstuk over het bestuur in het westelijk deel van het Sticht Utrecht aandacht gegeven worden aan de historische geografie van Breukelen; ook de beschrijving van het bestuur in de Middeleeuwen van elk van de Breukelse gerechten afzonderlijk zal door een uiteenzetting over de (historische) geografie van het betreffende gerecht voorafgegaan worden. Als afsluiting willen we proberen, op basis van de beschrijving van het bestuur en van de conflicten, die zich rond macht en zeggenschap op geestelijk en wereldlijk niveau hebben afgespeeld, conclusies te trekken over de machtsverhoudingen in de parochie Breukelen en de verschuivingen waaraan deze verhoudingen in de loop van de Middeleeuwen onderhevig waren." ],
        [ sgpl:refersToConcept unesco:concept11251 ;
            sgpl:subjectText "Veenontginningen" ;
            sgpl:text_context "Ten westen en ten oosten van de stroomrug- en komkleigronden, die zich langs en tussen de rivierlopen Vecht en Aa bevinden, strekken zich de klei-op-veen en veengronden uit. Moesten we bij de beschrijving van de vroege geografische structuur van de rivierkleigronden de bodemkunde betrekken omdat naast menselijk ingrijpen ook de verschillende rivierlopen zeer bepalend zijn geweest voor het totstandkomen van deze structuur, een beschrijving van de veenontginningen zal veeleer vanuit de historische bronnen te werk moeten gaan; menselijk ingrijpen heeft de natuur hier dusdanig gereguleerd en vorm gegeven dat we slechts kunnen pogen met behulp van gegevens uit de schriftelijke bronnen (meest van na de ontginning) en het kaartbeeld, dat door de ontginningen is ontstaan, het verloop van deze ontginningen te reconstrueren. Wat betreft vorm en tijd van de ontginning zijn de ontginningen ten westen van de Vecht bovendien zo verschillend van de ontginningen ten oosten van de Vecht, dat we een beschrijving van deze ontginningen hier willen laten rusten; per gerecht zal de eigenaardigheid van de ontginningsvorm onder de loep genomen worden met de bedoeling tot een, voor zover mogelijk afgerond beeld te komen van de ontginningsgeschiedenis van de veengronden onder de parochie Breukelen." ] ;
    sgpl:thesisID 106 .

sgpl:Thesis107 a sgpl:SGPLThesis ;
    dcterms:creator "Guus van Westen",
        "Ron Hansen" ;
    dcterms:issued 1982 ;
    dcterms:title "Een studie naar handelsactiviteiten in een kleine Malinese stad",
        "Handel en Wandel in Djenne" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2453866 ;
            sgpl:spatialText "Mali" ;
            sgpl:text_context "This benign neglect towards Mali on the part of scholars must partly be attributed to the overal scarcity and unreliability of data added to particularly unfavourable research conditions within Mali itself. Guy Martin ( Canadian Journal of African Studies, vol X, no I, 1976, pag. 25 ). i INHOUDSOPGAVE: n ." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2449067 ;
            sgpl:spatialText "Tombouctou" ;
            sgpl:text_context "Hoofdstuk 2 is gewijd aan een historische schets van Djenné, eens een belangrijke stad in de trans-Sahara handel. Voornaamlijk de stagnatie van deze lange afstandshandel en daarnaast het feit dat de franse koloniale overheersers het politieke en administratieve centrum verlegden naar Mopti, hebben ertoe geleid dat van de handelsmetropool van weleer niet veel meer over is dan een perifeer streekcentrum. In hoofdstuk 3 komt de positie van de handel in de productiestructuur van Djenné ter sprake." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2458589 ;
            sgpl:spatialText "dorpen rondom Djenné" ;
            sgpl:text_context "De globale doelstelling van het onderzoeksproject ISEDE is inzicht in de huidige sociaal-economische structuur van de stad Djenné, alsmede van de sociaal-economische structuur van de dorpen rondom Djenné én hun relaties tot de stad. Hierdoor zal een beeld ontstaan van de rol die Djenné speelt — en wellicht zou kunnen spelen - in de ontwikkeling van de binnen-delta van de Niger. De onderzoeksactiviteiten binnen ISEDE zijn opgesplitst in drie cycli." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Nr. 15 maart 1982 geografisch instituut heidel berglaan Z 3508 TC utrecht rijksuniversiteit utrecht transitorium II tel: 030-532044" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2453348 ;
            sgpl:spatialText "Mopti" ;
            sgpl:text_context "Voornaamlijk de stagnatie van deze lange afstandshandel en daarnaast het feit dat de franse koloniale overheersers het politieke en administratieve centrum verlegden naar Mopti, hebben ertoe geleid dat van de handelsmetropool van weleer niet veel meer over is dan een perifeer streekcentrum. In hoofdstuk 3 komt de positie van de handel in de productiestructuur van Djenné ter sprake. Vanzelfsprekend daarbij is de aandacht voor andere beroepsgroepen, omdat de relaties tot de handel legio - kunnen - zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2460596 ;
            sgpl:spatialText "Bamako" ;
            sgpl:text_context "Tijdens een verblijf in Bamako wisten wij enkele oriënterende gesprekken te arrangeren met belagrijke personen van enkele Staatsorganisaties, o.a. de adjunct directeur generaal van dé Somiex, de commercieel directeur van de OPAIM. Verder zijn op regionaal ( Mopti ) en locaal ( Djenné ) interviews gehouden met representanten van verschillende staatsorganisaties . Vóór het vertrek naar Mali hadden we in grote lijnen een enquête samengesteld, die afgenomen zou worden aan een per steekproef te bepalen aantal Djennenké." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "binnen-delta van de Niger" ;
            sgpl:text_context "Hierdoor zal een beeld ontstaan van de rol die Djenné speelt — en wellicht zou kunnen spelen - in de ontwikkeling van de binnen-delta van de Niger. De onderzoeksactiviteiten binnen ISEDE zijn opgesplitst in drie cycli. Tijdens de eerste cyclus ( oktober ’78 — april *79 ) heeft men zich gericht op de demografische situatie en op de ambachtelijke activiteiten waarbij speciaal aandacht is geschonken aan de bouwnijverheid en de woonomstandigheden in Djenné." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2451778 ;
            sgpl:spatialText "San" ;
            sgpl:text_context "Ondertussen zijn Mopti en San in de loop van deze eeuw opgekomen als nieuwe regionale handelscentra met bijna volledige voorbijstreving van Djenné. De oorzaken van het verval van Djenné zijn in twee groepen te verdelen. Er zijn specifieke redenen aan te wijzen waarom juist Djenné op een gegeven moment geen stand meer kon houden; daarnaast is op een fundamenteler niveau het feit van de nagenoeg volledige ondergang van de karavaanhandel, waarmee Djenné was verbonden van belang." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "West-Afrika" ;
            sgpl:text_context "2.1. Ontstaan van de handel. 2.2. Lange-afstandshandel in pre-koloniaal West-Afrika. 2.3. Opkomst van Djenné als handelscentrum." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2458589 ;
            sgpl:spatialText "Djenné" ;
            sgpl:text_context "In de voor liggende scriptie worden de resultaten gepresenteerd van een onderzoek naar de handelssector van Djenné. Dit onderzoek maakt deel uit van het project ISEDE: \"Investigation Socio - Economique de la ville de Djenné et ses Environs\". Dit project, waarvoor in mei 1978 de eerste formele aanzetten zijn gemaakt, wordt uitgevoerd onder verantwoording van de vakgroep Sociale Geografie der Ontwikkelingslanden van de Rijksuniversiteit Utrecht en geschiedt in samenwerking met het Institute des Sciences Humaines in Bamako." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2458589 ;
            sgpl:spatialText "stad Djenné" ;
            sgpl:text_context "De globale doelstelling van het onderzoeksproject ISEDE is inzicht in de huidige sociaal-economische structuur van de stad Djenné, alsmede van de sociaal-economische structuur van de dorpen rondom Djenné én hun relaties tot de stad. Hierdoor zal een beeld ontstaan van de rol die Djenné speelt — en wellicht zou kunnen spelen - in de ontwikkeling van de binnen-delta van de Niger. De onderzoeksactiviteiten binnen ISEDE zijn opgesplitst in drie cycli." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1564 ;
            sgpl:subjectText "goederenstromen" ;
            sgpl:text_context "In hoofdstuk 4 worden de handelaren besproken: hun eigenschappen en gedrag. Hoofdstuk 5 behandeld de goederenstromen ( waar komen producten vandaan en waar gaan ze naartoe? ) en handelsketens ( d.w.z. het aantal en het soort van handelaren die een product doorgeven van de producent naar de uiteindelijke consument ). Er wordt een poging gedaan de positie van Djenné als marktcentrum voor het omliggende platteland te schetsen." ],
        [ sgpl:refersToConcept unesco:concept13608 ;
            sgpl:subjectText "periodieke markten" ;
            sgpl:text_context "Wij willen hier nog in het kort de identiteit van de marktparticipanten nader specificeren. Tot ongeveer 1960 hadden de studies over periodieke markten in ontwikkelingslanden een sterk ideografisch karakter: de periodieke marktplaatsen werden beschouwd als sociaal-culturele fenomenen die de moeite waard waren om beschreven te worden als aparte objecten, maar daar bleef het bij. Na W.O.II zien we binnen de sociale wetenschappen een trend van het zoeken naar algemene wetmatigheden." ],
        [ sgpl:refersToConcept unesco:concept1539 ;
            sgpl:subjectText "handelsactiviteiten" ;
            sgpl:text_context "Het onderzoeksdoel is tweeledig, als volgt geformuleerd: een analyse van de handelssector in Djenné, waarbij enerzijds de verschillende groepen handelaren en hun posities in het handelsapparaat worden bekeken, en waarbij anderzijds de betekenis van de handel als bestaansbron voor de bevolking van Djenné wordt onderzocht. Het onderzoeksdoel is nader gespecificeerd in de volgende onderzoeksvragen: 1: Wat is de betekenis van de handelsactiviteiten als bestaansbron voor de bevolking van Djenné? 2: Welke functies vervullen de periodieke en de niet-periodieke handel in het geheel van distributie en collectie van goederen in Djenné, én hoe is de onderlinge relatie tussen periodieke en niet-periodieke handel in Djenné?" ],
        [ sgpl:refersToConcept unesco:concept1539 ;
            sgpl:subjectText "handelsactiviteiten" ;
            sgpl:text_context "Het onderzoeksdoel is tweeledig, als volgt geformuleerd: een analyse van de handelssector in Djenné, waarbij enerzijds de verschillende groepen handelaren en hun posities in het handelsapparaat worden bekeken, en waarbij anderzijds de betekenis van de handel als bestaansbron voor de bevolking van Djenné wordt onderzocht. Het onderzoeksdoel is nader gespecificeerd in de volgende onderzoeksvragen: 1: Wat is de betekenis van de handelsactiviteiten als bestaansbron voor de bevolking van Djenné? 2: Welke functies vervullen de periodieke en de niet-periodieke handel in het geheel van distributie en collectie van goederen in Djenné, én hoe is de onderlinge relatie tussen periodieke en niet-periodieke handel in Djenné?" ],
        [ sgpl:refersToConcept unesco:concept13608 ;
            sgpl:subjectText "periodieke markten" ;
            sgpl:text_context "Wij willen hier nog in het kort de identiteit van de marktparticipanten nader specificeren. Tot ongeveer 1960 hadden de studies over periodieke markten in ontwikkelingslanden een sterk ideografisch karakter: de periodieke marktplaatsen werden beschouwd als sociaal-culturele fenomenen die de moeite waard waren om beschreven te worden als aparte objecten, maar daar bleef het bij. Na W.O.II zien we binnen de sociale wetenschappen een trend van het zoeken naar algemene wetmatigheden." ],
        [ sgpl:refersToConcept unesco:concept1564 ;
            sgpl:subjectText "goederenstromen" ;
            sgpl:text_context "In hoofdstuk 4 worden de handelaren besproken: hun eigenschappen en gedrag. Hoofdstuk 5 behandeld de goederenstromen ( waar komen producten vandaan en waar gaan ze naartoe? ) en handelsketens ( d.w.z. het aantal en het soort van handelaren die een product doorgeven van de producent naar de uiteindelijke consument ). Er wordt een poging gedaan de positie van Djenné als marktcentrum voor het omliggende platteland te schetsen." ] ;
    sgpl:thesisID 107 .

sgpl:Thesis108 a sgpl:SGPLThesis ;
    dcterms:creator "Luc van Huijgevoort",
        "Yvonne Hazelaar" ;
    dcterms:issued 1982 ;
    dcterms:title "een inventarisatie en evaluatie van de overloop van de werkgelegenheid naar nieuwegein en hoorn",
        "werk naar de groeikernen" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744658 ;
            sgpl:spatialText "Westfriesland" ;
            sgpl:text_context "Zo zou Hoorn niet alleen de bevolkingsoverloop uit de Noordvleugel van de Randstad, en met name uit Amsterdam, op moeten vangen, maar ook zou zij een groeipoolfunktie moeten vervullen ten behoeve van het omringende probleemgebied Westfriesland. In verband met deze dubbelzijdige taakstelling merkt FOPMA (1980, p. 10) terecht op dat 'de aanwijzing van Westfriesland-oost tot stimuleringsgebied met Hoorn als primaire ontwikkelingskern met enige goede wil als een maatregel ter bevordering van de overloop kan worden gezien, alhoewel deze maatregelen meer geïnitieerd waren door de regionale werkgelegenheidsproblematiek'. Ondanks de aanwijzing tot opvangkern (lees: groeikern) in 1958 heeft Hoorn pas veertien jaar later, namelijk in 1972, de eerste eenduidige taakstelling van de rijksoverheid toebedeeld gekregen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753638 ;
            sgpl:spatialText "Hoorn" ;
            sgpl:text_context "Het onderzoek is namelijk deels gericht op het maken van een inventarisatie van de vertrek- en vestigingsredenen van die bedrijven en instellingen, die zich daadwerkelijk verplaatst hebben uit de door ons afgebakende donorgebieden naar de twee gekozen groeikernen Nieuwegein en Hoorn. Bij deze inventarisatie zal speciale aandacht besteed worden aan de rol, welke door de investeringspremies gespeeld wordt in het totale lokatiebesluit. Voor zover wij hebben kunnen achterhalen is op het schaalnivo, waarop de relatie tussen groeikern en donorgebied zich manifesteert, nog geen onderzoek verricht naar de rol van de financiële en stimulerende overheidsmaatregelen in het gehele lokatiebesluit van de bedrijfsvestiging." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Het onderzoek is namelijk deels gericht op het maken van een inventarisatie van de vertrek- en vestigingsredenen van die bedrijven en instellingen, die zich daadwerkelijk verplaatst hebben uit de door ons afgebakende donorgebieden naar de twee gekozen groeikernen Nieuwegein en Hoorn. Bij deze inventarisatie zal speciale aandacht besteed worden aan de rol, welke door de investeringspremies gespeeld wordt in het totale lokatiebesluit. Voor zover wij hebben kunnen achterhalen is op het schaalnivo, waarop de relatie tussen groeikern en donorgebied zich manifesteert, nog geen onderzoek verricht naar de rol van de financiële en stimulerende overheidsmaatregelen in het gehele lokatiebesluit van de bedrijfsvestiging." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Onder de donorgebieden wordt hier het gebied verstaan dat bestaat uit het grondgebied van de respektievelijke donorsteden Utrecht en Amsterdam plus de daaraan direkt grenzende gemeenten. Deze uitbreiding is gekozen tegen de achtergrond van het feit dat door de jaren heen ook deze aangrenzende gemeenten tot de traditionele vestigingsplaatsen van het bedrijfsleven zijn gaan behoren (voor preciese afbakening zie bijlage 2) en derhalve overeenkomsten met de twee donorsteden zijn gaan vertonen op het terrein van de bedrijfshuisvesting, de bereikbaarheid en dergelijke. In het tweede onderzoeksgedeelte zal het overloopproces van arbeidsplaatsen vanuit de donorgebieden naar de groeikernen bekeken worden vanuit de betrokken provincies en gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "Provincie Utrecht" ;
            sgpl:text_context "Ook bij een onderwerp als de gemeentelijke werkgelegenheid laat de provincie haar invloed gelden. In het geval van Nieuwegein zijn er een drietal van belang: 1) het Streekplan voor Midden- en Zuidoost Utrecht (1974) 2) het Toetsingskader Bedrijfsvestiging Provincie Utrecht (1981) 3) het rapport van de Werkgroep Joosten omtrent de werkgelegenheidsontwikkeling in de provincie Utrecht (1980). In het bovengenoemde streekplan, dat op 16 mei 1974 door Provinciale Staten van Utrecht is vastgesteld, wordt als hoofdlijn voor de ekonomische ontwikkeling in het streekplangebied aangehouden: 'zoveel mogelijke afremming van de groei van de werkfunktie in samenhang met een beperking van de woonfunktie onder handhaving, met behulp van het ter beschikking staande wettelijke instrumentarium, van het evenwicht tussen wonen en werken in deze provincie' (PROVINCIALE STATEN VAN UTRECHT 1974, p. 14)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Sinds tientallen jaren wordt in verschillende europese landen een ruimtelijk beleid gevoerd dat gericht is op de afremming van de groei van de grote steden en de afleiding van hun 'overspill' (overloop) naar nabij gelegen kleinere centra. Het groeikernenbeleid is er op gericht om nabij de grotere steden van met name de Randstad te komen tot de vorming van een aantal centra (sinds 1972 groeikernen genoemd). Hoewel zij officieel gedefinieerd zijn als 'nevenkernen in een stadsgewest, die in belangrijke mate de woningbehoefte van het stadsgewest moeten opvangen ' (VERSTEDELIJKINGSNOTA DEEL D 1977, p. 238), dienen zij niet alleen de bevolkingsoverloop op te vangen, maar ook de stadsgewestelijke werkgelegenheidsoverloop." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Yvonne Hazelaar Luc van Huijgevoort Utrecht, juli 1982. Voorwoord Dit voor u liggende rapport is het zichtbare resultaat van een onderzoek, dat verricht is in het kader van onze hoofdvakstudie, die wij bij de vakgroep Sociale Geografie der stedelijk-industriële landen, met als specialisatie 'bedrijvigheid', volgden. Vanuit de vakgroep werden wij begeleid door drs. J.G. Borchert, die ons op menig moment een zet vooruit bracht, zodat wij niet schaakmat kwamen te staan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Provincie Noord-Holland" ;
            sgpl:text_context "Teneinde uiting te geven aan een gericht en duidelijk acquisitiebeleid is in 1977 een werkgelegenheidskoördinator aangesteld, die tot taak heeft om bedrijven uit het noordelijk deel van de Randstad te interesseren voor vestiging in Hoorn. Meer in het bijzonder zal, mede met het oog op de wens om het forensisme naar Amsterdam terug te dringen, getracht moeten worden 'om kantoren, die aan de rand van Amsterdam geen plaats kunnen vinden, voor vestiging in Groot-Hoorn te interesseren' (GEMEENTE HOORN 1977, p. 16). Het beleid dat door de provincie Noord-Holland met betrekking tot de werkgelegenheidsontwikkeling in Hoorn gevoerd wordt heeft, in tegenstelling tot het restriktieve beleid van de provincie Utrecht ten aanzien van Nieuwegein, een stimulerend karakter." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept13122 ;
            sgpl:subjectText "bedrijfsmigratie" ;
            sgpl:text_context "Sinds het midden van de jaren zestig doen zich ook in de bedrijvigheid, in navolging van de al eerder opgetreden suburbanisatie van het wonen, op grote schaal suburbanisatieprocessen voor. Het totale bedrijfsmigratiebeeld, dat tot voor het midden van de jaren zestig verdeeld kon worden in twee gelijke stromen, namelijk enerzijds partiële verplaatsingen over grote afstanden met de faktor 'arbeidsmarkt' als belangrijkste oorzaak ('filtering down') en anderzijds integrale verplaatsingen over geringere afstanden met de faktor 'bedrijfsruimte/uitbreidingsmogelijkheden' als belangrijkste vertrekmotief ('urban overspill'), wordt de laatste twintig jaar geheel overheerst door de laatstgenoemde stroom, zijnde bedrijfsmigraties op suburbane schaal. Er heeft zich dus een 'tendensomkering' voltrokken (PELLENBARG 1977, p. 1)." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "ruimtelijke ordeningstoeslag" ;
            sgpl:text_context "In het kader van het laatstgenoemde beleid worden namelijk aan het bedrijfsleven premies in het vooruitzicht gesteld, die in het algemeen gericht zijn op de bevordering van het doen van investeringen. Een premie die speciaal gericht is op het doen van investeringen in groeikernen (en groeisteden), is de ruimtelijke ordeningstoeslag (ROT), die deel uitmaakt van de sinds 1978 van kracht zijnde Wet op de Investeringsrekening. Via de ROT wordt getracht de werkgelegenheidsontwikkeling in de groeikernen, ten behoeve van hun eerdergenoemde zelfstandige funktie binnen het stadsgewest waartoe zij behoren, zoveel mogelijk parallel te laten lopen met de ontwikkeling van de ter plaatse wonende bevolking." ],
        [ sgpl:refersToConcept unesco:concept6828 ;
            sgpl:subjectText "groeikernenbeleid" ;
            sgpl:text_context "Deze gedachte, voor het eerst toegepast in Engeland met betrekking tot de situatie rondom Londen en haar new towns, heeft na 1958 ook in ons land postgevat. Hier is de rijksoverheid gekomen tot de formulering van het zogenaamde groeikernenbeleid, dat als zodanig een essentieel onderdeel uitmaakt van het totale ruimtelijke beleid. Het groeikernenbeleid is er op gericht om nabij de grotere steden van met name de Randstad te komen tot de vorming van een aantal centra (sinds 1972 groeikernen genoemd)." ],
        [ sgpl:refersToConcept unesco:concept6828 ;
            sgpl:subjectText "groeikernenbeleid" ;
            sgpl:text_context "Deze gedachte, voor het eerst toegepast in Engeland met betrekking tot de situatie rondom Londen en haar new towns, heeft na 1958 ook in ons land postgevat. Hier is de rijksoverheid gekomen tot de formulering van het zogenaamde groeikernenbeleid, dat als zodanig een essentieel onderdeel uitmaakt van het totale ruimtelijke beleid. Het groeikernenbeleid is er op gericht om nabij de grotere steden van met name de Randstad te komen tot de vorming van een aantal centra (sinds 1972 groeikernen genoemd)." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "ruimtelijke ordeningstoeslag" ;
            sgpl:text_context "In het kader van het laatstgenoemde beleid worden namelijk aan het bedrijfsleven premies in het vooruitzicht gesteld, die in het algemeen gericht zijn op de bevordering van het doen van investeringen. Een premie die speciaal gericht is op het doen van investeringen in groeikernen (en groeisteden), is de ruimtelijke ordeningstoeslag (ROT), die deel uitmaakt van de sinds 1978 van kracht zijnde Wet op de Investeringsrekening. Via de ROT wordt getracht de werkgelegenheidsontwikkeling in de groeikernen, ten behoeve van hun eerdergenoemde zelfstandige funktie binnen het stadsgewest waartoe zij behoren, zoveel mogelijk parallel te laten lopen met de ontwikkeling van de ter plaatse wonende bevolking." ],
        [ sgpl:refersToConcept unesco:concept13122 ;
            sgpl:subjectText "bedrijfsmigratie" ;
            sgpl:text_context "Sinds het midden van de jaren zestig doen zich ook in de bedrijvigheid, in navolging van de al eerder opgetreden suburbanisatie van het wonen, op grote schaal suburbanisatieprocessen voor. Het totale bedrijfsmigratiebeeld, dat tot voor het midden van de jaren zestig verdeeld kon worden in twee gelijke stromen, namelijk enerzijds partiële verplaatsingen over grote afstanden met de faktor 'arbeidsmarkt' als belangrijkste oorzaak ('filtering down') en anderzijds integrale verplaatsingen over geringere afstanden met de faktor 'bedrijfsruimte/uitbreidingsmogelijkheden' als belangrijkste vertrekmotief ('urban overspill'), wordt de laatste twintig jaar geheel overheerst door de laatstgenoemde stroom, zijnde bedrijfsmigraties op suburbane schaal. Er heeft zich dus een 'tendensomkering' voltrokken (PELLENBARG 1977, p. 1)." ] ;
    sgpl:thesisID 108 .

sgpl:Thesis109 a sgpl:SGPLThesis ;
    dcterms:creator "Fedde Poort",
        "Hans de Leeuw" ;
    dcterms:issued 1982 ;
    dcterms:title "in Eindhoven.",
        "stedelijk beheer" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "centrum van Eindhoven" ;
            sgpl:text_context "Toetsing van het stadsvernieuwingsbeleid in De Bergen en de Rochusbuurt aan het stedelijk beheerconcept 63. Een analyse van de beheerproblematiek in de stadsvernieuwingsgebieden in het centrum van Eindhoven 51. Inleiding 51." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "gemeente Eindhoven" ;
            sgpl:text_context "Voor dit onderzoek zijn wij gedurende de periode februari 1982 tot en met mei 1982 in Eindhoven werkzaam geweest op de afdeling Stedebouwkundig Onderzoek van de gemeente Eindhoven. In de eerste plaats willen wij de heren J. Weitering en F. Klarenbeek bedanken voor de begeleiding die zij ons hebben gegeven bij onze werkzaamheden in Eindhoven. Daarnaast willen wij ook nog die medewerkers van de gemeente Eindhoven bedanken die ons tal van adviezen en informatie hebben gegeven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "centrumgebied van Eindhoven" ;
            sgpl:text_context "In de Nederlandse literatuur is tot op heden relatief weinig aandacht besteed aan de manier waarop in Eindhoven een ruimtelijk beleid wordt gevoerd. Dit onderzoek vult in die zin een leemte op, omdat in dit rapport expliciet aandacht wordt geschonken aan het ruimtelijk beleid zoals dat in de laatste tien jaar in Eindhoven en dan met name het centrumgebied van Eindhoven, gevoerd is. Bij ons onderzoek in Eindhoven hebben wij ons gericht op het opsporen van knelpunten (en de oorzaken daarvan) die het realiseren van een stedelijk beheer in de weg staan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746215 ;
            sgpl:spatialText "gemeente Tongelre" ;
            sgpl:text_context "Later werden ook woningen gebouwd langs de wegen die aansloten op de verbindingsweg met de gemeente Tongelre. De oudste thans nog aanwezige bebouwing in de buurt bevindt zich dan ook langs deze wegen. Het merendeel van de bestaande situatie heeft zich ontwikkeld vanaf het begin van deze eeuw en met name rond de annexatie in 1920, toen ook in het binnengebied bebouwing verrees." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754130 ;
            sgpl:spatialText "terrein Heuvel" ;
            sgpl:text_context "Opvullingen naast de genoemde uitbreiding van het kernwinkelapparaat, van het bestaande winkelfront aan de radialen zijn echter wel mogelijk. De belangrijkste ontwikkeling van de winkelfunctie heeft men in de schets echter toebedacht aan het momenteel als parkeerterrein gebruikte, voormalige binnenziekenhuisterrein (oftewel het terrein Heuvel), midden in het centrumgebied gelegen. Hier hoopt de gemeente op maar liefst 11.000 m2 van de in totaal 14.000 m2 winkelvloeroppervlak en wel in de vorm van detailhandel met een trekkersfunctie, liefst een zelfbedieningswarenhuis." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746624 ;
            sgpl:spatialText "gemeente Stratum" ;
            sgpl:text_context "De Rochusbuurt maakte oorspronkelijk deel uit van de gemeente Stratum. De eerste bebouwing is ontstaan langs de radialen die de Rochusbuurt omringen. Het betrof hier voornamelijk woningen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757790 ;
            sgpl:spatialText "De Bergen" ;
            sgpl:text_context "De Bergen : de geschiedenis en het planvormingsproces 51. De Rochusbuurt : de geschiedenis en het planvormingsproces 57. Toetsing van het stadsvernieuwingsbeleid in De Bergen en de Rochusbuurt aan het stedelijk beheerconcept 63." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "Ook is gekozen voor onderzoek in Eindhoven en Breda omdat beide gemeenten deel uit maken van een provinciale overleggroep in Noord-Brabant, waarin gepoogd wordt aan stedelijk beheer gestalte te geven : het zogenaamde stadsvemieuwingsplatform. In de Nederlandse literatuur is tot op heden relatief weinig aandacht besteed aan de manier waarop in Eindhoven een ruimtelijk beleid wordt gevoerd. Dit onderzoek vult in die zin een leemte op, omdat in dit rapport expliciet aandacht wordt geschonken aan het ruimtelijk beleid zoals dat in de laatste tien jaar in Eindhoven en dan met name het centrumgebied van Eindhoven, gevoerd is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Het hier voor U liggende rapport is het product van een onderzoek naar stedelijk beheer in Eindhoven. Dit onderzoek hebben wij verricht in het kader van het afstudeerproject dat onderdeel uitmaakt van de doctoraalstudie planologie aan het instituut voor planologie aan de rijksuniversiteit te Utrecht. Voor dit onderzoek zijn wij gedurende de periode februari 1982 tot en met mei 1982 in Eindhoven werkzaam geweest op de afdeling Stedebouwkundig Onderzoek van de gemeente Eindhoven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Iriswijk" ;
            sgpl:text_context "Op basis van de huidige inzet jaarlijks in het beleidsplan wordt bepaald, welke nieuwe zaken ter hand zullen worden genomen. B&W zijn er zich van bewust dat ten gevolge van dit afwezig zijn van een aan de schets verbonden actieprogramma, over een aantal zaken onzekerheid blijft bestaan (bijvoorbeeld over de vraag wanneer de Iriswijk zal worden gerehabiliteerd). Men acht zich echter niet in staat om daarover op dat moment op verantwoorde wijze uitsluitsel te geven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "In deelrapport 2a is, evenals in deelrapport 2b, gekozen voor een praktijk-ingang : deelrapport 2a handelt over stedelijk beheer in Breda, deelrapport 2b, dit rapport dus, handelt over stedelijk beheer in Eindhoven. Deelrapport 3 tenslotte tracht gestalte te geven aan een praktijk/theorie-confrontatie. Waarom wij in Eindhoven onderzoek hebben verricht en niet in een andere gemeente laat zich vrij gemakkelijk verklaren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Tegen deze achtergrond is het dan ook verwonderlijk, dat tot nu toe zo weinig aandacht geschonken is aan een meer integrale analyse van het onderwerp stadsbeheer. Te meer als bedacht wordt dat in Nederland de ruimte zeer beperkt is, dat de omvang van de bevolking zich lijkt te stabiliseren en dat de hoeveelheid gebouwen die jaarlijks aan de bestaande voorraad toegevoegd wordt, relatief gering is, maar die betrekkelijk geringe hoeveelheid uitbreiding wel onevenredig veel aandacht in het wetenschappelijk onderzoek krijgt. Uit het voorgaande wordt duidelijk dat stedelijk beheer zich met name moet richten op bestaand stedelijk gebied." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "Het hier voor U liggende rapport is het product van een onderzoek naar stedelijk beheer in Eindhoven. Dit onderzoek hebben wij verricht in het kader van het afstudeerproject dat onderdeel uitmaakt van de doctoraalstudie planologie aan het instituut voor planologie aan de rijksuniversiteit te Utrecht. Voor dit onderzoek zijn wij gedurende de periode februari 1982 tot en met mei 1982 in Eindhoven werkzaam geweest op de afdeling Stedebouwkundig Onderzoek van de gemeente Eindhoven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Stratumsedijk" ;
            sgpl:text_context "De functie van deze radiaalwegen behoort voor de gebruiker vanzelfsprekend te zijn. Vandaar ook dat bijvoorbeeld de Stratumsedijk (een radiaal die deels de westelijke grens van de Rochusbuurt vormt) wat de vorm betreft volgens de samenstellers van de schets een onevenwichtig uiterlijk heeft. De westwand is vernieuwd, de oostwand, waarvan voor vernieuwing de aanzetten aan weerszijden al aanwezig zijn, staat er wat vreemd tegenover." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751143 ;
            sgpl:spatialText "de Markt" ;
            sgpl:text_context "Ten aanzien van de binnenstad heeft men in stedebouwkundig opzicht als belangrijkste wensen : bereiking van een sluitend stelsel van loopcircuits, intensivering van de functies aan en bij de Markt (een centraal plein in het winkelcentrum) ten behoeve van een meer centrale positie van deze markt, en een betere visuele samenhang van de binnenstad. De binnenstadsrandzones dienen herkenbaar te zijn als entrees tot de binnenstad. De verbinding van het centrum met de daarbuiten liggende gebieden wordt vanouds tot stand gebracht via de radiaalwegen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "De Bergstraat" ;
            sgpl:text_context "rehabilitatiegebieden : 1. De Bergen 2. Rochusbuurt 3. De Bergstraat. — : binnenring rondom de binnenstad. Bron : Kaartenatlas bij de structuurschets centrumgebied Eindhoven, gemeente Eindhoven, 1979." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de Rochusbuurt" ;
            sgpl:text_context "De Bergen : de geschiedenis en het planvormingsproces 51. De Rochusbuurt : de geschiedenis en het planvormingsproces 57. Toetsing van het stadsvernieuwingsbeleid in De Bergen en de Rochusbuurt aan het stedelijk beheerconcept 63." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1408 ;
            sgpl:subjectText "Centrumgebiedbeleid" ;
            sgpl:text_context "In de volgende hoofdstukken zullen het (ruimtelijk) centrumgebiedbeleid, het algemene stadsvernieuwingsbeleid en de ruimtelijke plannen voor twee in het centrumgebied van Eindhoven gelegen rehabilitatiegebieden worden getoetst aan eerder genoemde vijf criteria. In hoofdstuk 2 beschrijven we de ontwikkelingen die leidden tot de totstandkoming van de structuurschets voor het centrumgebied van Eindhoven en toetsen we dit ruimtelijk plan aan ons stedelijk beheerconcept. Daarna behandelen we in hoofdstuk 3 het stadsvernieuwingsbeleid van Eindhoven en toetsen ook dit beleid." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "Stedelijk beheer" ;
            sgpl:text_context "In deelrapport 1 is gekozen voor een theoretische beschouwing rondom het begrip stedelijk beheer: stedelijk beheer in theoretisch perspectief. In deelrapport 2a is, evenals in deelrapport 2b, gekozen voor een praktijk-ingang : deelrapport 2a handelt over stedelijk beheer in Breda, deelrapport 2b, dit rapport dus, handelt over stedelijk beheer in Eindhoven. Deelrapport 3 tenslotte tracht gestalte te geven aan een praktijk/theorie-confrontatie." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Het betreft dan wel een aanpak die instandhouding én verandering van het stedelijk gebied in samenhang beschouwt. In dit licht bezien kan stadsvernieuwing beschouwd worden als het kader waarin met name het materiële verval aan de orde wordt gesteld en aangepakt. De stadsvernieuwing is in zekere zin de strijd tegen de aftakeling van het woon- en leefmilieu als gevolg van het tekortschieten van het beheer van het stedelijk milieu." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Het betreft dan wel een aanpak die instandhouding én verandering van het stedelijk gebied in samenhang beschouwt. In dit licht bezien kan stadsvernieuwing beschouwd worden als het kader waarin met name het materiële verval aan de orde wordt gesteld en aangepakt. De stadsvernieuwing is in zekere zin de strijd tegen de aftakeling van het woon- en leefmilieu als gevolg van het tekortschieten van het beheer van het stedelijk milieu." ],
        [ sgpl:refersToConcept unesco:concept1408 ;
            sgpl:subjectText "Centrumgebiedbeleid" ;
            sgpl:text_context "In de volgende hoofdstukken zullen het (ruimtelijk) centrumgebiedbeleid, het algemene stadsvernieuwingsbeleid en de ruimtelijke plannen voor twee in het centrumgebied van Eindhoven gelegen rehabilitatiegebieden worden getoetst aan eerder genoemde vijf criteria. In hoofdstuk 2 beschrijven we de ontwikkelingen die leidden tot de totstandkoming van de structuurschets voor het centrumgebied van Eindhoven en toetsen we dit ruimtelijk plan aan ons stedelijk beheerconcept. Daarna behandelen we in hoofdstuk 3 het stadsvernieuwingsbeleid van Eindhoven en toetsen ook dit beleid." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "Stedelijk beheer" ;
            sgpl:text_context "In deelrapport 1 is gekozen voor een theoretische beschouwing rondom het begrip stedelijk beheer: stedelijk beheer in theoretisch perspectief. In deelrapport 2a is, evenals in deelrapport 2b, gekozen voor een praktijk-ingang : deelrapport 2a handelt over stedelijk beheer in Breda, deelrapport 2b, dit rapport dus, handelt over stedelijk beheer in Eindhoven. Deelrapport 3 tenslotte tracht gestalte te geven aan een praktijk/theorie-confrontatie." ] ;
    sgpl:thesisID 109 .

sgpl:Thesis110 a sgpl:SGPLThesis ;
    dcterms:creator "Eric Lensink",
        "Hans van Paddenburgh" ;
    dcterms:issued 1982 ;
    dcterms:title "blijf op de kleintjes letten",
        "een verslag van een onderzoek naar de variatie in en waardering van regionale verschillen in prijzen van kruidenierswaren" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Dit verslag is het resultaat van ons doctoraalonderzoek dat verricht werd voor het hoofdvak Sociale Geografie der Stedelijk-Industriële landen (S.G.S.) aan het Geografisch Instituut van de Rijksuniversiteit van Utrecht. Utrecht, januari 1982. Eric Lensink en Hans van Paddenburgh." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Friesland" ;
            sgpl:text_context "Het blijkt dus dat veel bewoners van \"een\" perifeer landelijk gebied in Friesland vinden dat kruidenierswaren in hun dorp duurder zijn dan in de Randstad (DEELGROEP LANDELIJKE GEBIEDEN 1980, p. 60). In de provincie Friesland bestaat het werkgebied van het experiment uit alle 14 dorpen in de gemeente Hennaarderadeel en de dorpen Hichtum, Hartwerd, Burgwerd en Lollum in Wonseradeel. Doel van het experiment is om met inschakeling van de bevolking na te gaan wat de belangrijkste knelpunten met betrekking tot de leefbaarheid in de betrokken kernen zijn en hoe daarvoor practische oplossingen kunnen worden gevonden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In dit onderzoek wordt getracht de verschillen in de prijs van een gemiddeld kruidenierswarenpakket tussen ZWF, Rijnmond en Nederland vast te stellen. In de eerste bedrijfstakgewijze collectieve arbeidsovereenkomst, n.l. die voor het kleinbedrijf in Nederland, worden de gemeenten in Nederland in vijf klassen verdeeld, op basis waarvan de lonen worden gedifferentieerd. Vanaf ongeveer 1925 (onduidelijk is wanneer de gemeenteclassificatie precies werd ingevoerd) worden rijksambtenaren uitbetaald op grond van een gemeenteindeling in drie klassen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279858 ;
            sgpl:spatialText "Rijnmond" ;
            sgpl:text_context "In dit onderzoek wordt getracht de verschillen in de prijs van een gemiddeld kruidenierswarenpakket tussen ZWF, Rijnmond en Nederland vast te stellen. Om verschillen tussen stedelijke en perifeer landelijke gebieden te verduidelijken en een lasten en baten-onderzoek zoals hier bedoeld meer tot zijn recht te laten komen, is een stedelijk referentiegebied gekozen in de vorm van Rijnmond (zie voor motivering VAN BEMMEL 1979, p. 55 en VAN BEMMEL 1981, p. 70), \"een goed voorbeeld van een stedelijk-industriëel gebied in Nederland\". Van Bemmel stelt in één van zijn subprobleemstellingen: \"wat zijn de kosten van een gemiddeld kruidenierswarenpakket in ZWF?\"" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753302 ;
            sgpl:spatialText "Itens" ;
            sgpl:text_context "In overleg met de regionale welzijnsstichting voor de Zuidwesthoek van Friesland Sudergoa, de medewerker van het B.R.W.-experiment Friesland en de consulent van het Regionaal Dienstverleningscentrum Kleinbedrijf Friesland hebben we Itens, Rien, Hennaard, en Lutkewierum als voorbeeld van kernen met een minimaal voorzieningenniveau gekozen. In Itens en de drie omliggende dorpen ontstond omstreeks 1975 een initiatief om de bestaande combinatie kruidenierswarenwinkel/café (eigendom van de Nederlands Hervormde Kerkvoogdij) om te zetten in een combinatie kruidenierswarenwinkel/café/dorpshuis. Dit zou gepaard moeten gaan met een verbouwing en uitbreiding." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Rien" ;
            sgpl:text_context "In overleg met de regionale welzijnsstichting voor de Zuidwesthoek van Friesland Sudergoa, de medewerker van het B.R.W.-experiment Friesland en de consulent van het Regionaal Dienstverleningscentrum Kleinbedrijf Friesland hebben we Itens, Rien, Hennaard, en Lutkewierum als voorbeeld van kernen met een minimaal voorzieningenniveau gekozen. Rien (1979: 139 inwoners) ligt 9 km. ten noorden van Sneek en 5,5 km. ten oostzuidoosten van Wommels. Er wonen 44 huishoudens (1981) die wat hun dagelijkse boodschappen betreft zijn aangewezen op andere kernen of op venters en/of op een rijdende winkel." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Gemeente Hennaarderadeel" ;
            sgpl:text_context "In het oostelijk deel van de gemeente Hennaarderadeel liggen de dorpen Hennaard, Itens, Lutkewierum en Rien. Wommels vervult een duidelijke functie als hoofdplaats van deze gemeente. De kern Wommels (1979: 1793 inwoners) is de hoofdkern van de gemeente Hennaarderadeel." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754381 ;
            sgpl:spatialText "Hennaard" ;
            sgpl:text_context "In overleg met de regionale welzijnsstichting voor de Zuidwesthoek van Friesland Sudergoa, de medewerker van het B.R.W.-experiment Friesland en de consulent van het Regionaal Dienstverleningscentrum Kleinbedrijf Friesland hebben we Itens, Rien, Hennaard, en Lutkewierum als voorbeeld van kernen met een minimaal voorzieningenniveau gekozen. Hennaard (1979: 59 inwoners) ligt 12 km. ten noorden van Sneek en ruim 5 km. ten oostnoordoosten van Wommels. Hennaard kun je nauwelijks een dorp noemen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744191 ;
            sgpl:spatialText "Wommels" ;
            sgpl:text_context "Nogmaals willen we de geënquêteerde kruideniers in Zuidwest Friesland en de geënquêteerde inwoners van de dorpen Hennaard, Itens, Lutkewierum, Rien en Wommels hartelijk danken voor hun medewerking. De keus is gevallen op Wommels. Een kern met bijna 1.800 inwoners, een goed voorzieningenapparaat (onderdeel van het stratum 2, zie 3.1.3.) en op ca. 5 km. van Itens (onderdeel van het stratum 0,1,2) gelegen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Zuidwest Friesland" ;
            sgpl:text_context "Zuidwest Friesland (ZWF) voldoet aan de eisen die we mogen stellen aan een perifeer landelijk gebied (zie VAN BEMMEL et al. 1979, p. 12; HAUER EN VELDMAN 1980, p. 43-44) en daarom, maar ook vanwege de interesse in het onderzoek van de provinciale planologische dienst Friesland werd voor het ZWF-project gekozen. Het gebied bestaat uit de gemeenten: Bolsward, Doniawerstal, Gaasterland, Hemelumer Oldeferd, Hennaarderadeel, Hindeloopen, Lemsterland, Rauwerderhem, Sloten, Stavoren, Sneek, Wonseradeel, Workum, Wymbritseradeel en IJlst, welke tesamen een COROP-gebied onder de naam Zuidwest Friesland vormen. 1.2. Lasten en baten van het wonen in landelijke gebieden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747063 ;
            sgpl:spatialText "Sneek" ;
            sgpl:text_context "Wommels vervult een duidelijke functie als hoofdplaats van deze gemeente. Itens is van de vier kleine dorpen de grootste (1979: 199 inwoners). De kern ligt 10 km. ten noorden van Sneek en 4,4 km. ten oosten van Wommels." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758682 ;
            sgpl:spatialText "Bolsward" ;
            sgpl:text_context "Het gebied bestaat uit de gemeenten: Bolsward, Doniawerstal, Gaasterland, Hemelumer Oldeferd, Hennaarderadeel, Hindeloopen, Lemsterland, Rauwerderhem, Sloten, Stavoren, Sneek, Wonseradeel, Workum, Wymbritseradeel en IJlst, welke tesamen een COROP-gebied onder de naam Zuidwest Friesland vormen. In deze twee gemeenten bleken meer dan vijf kruidenierswarenwinkels aanwezig te zijn. De kern Wommels (1979: 1793 inwoners) is de hoofdkern van de gemeente Hennaarderadeel." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751364 ;
            sgpl:spatialText "Lutkewierum" ;
            sgpl:text_context "In overleg met de regionale welzijnsstichting voor de Zuidwesthoek van Friesland Sudergoa, de medewerker van het B.R.W.-experiment Friesland en de consulent van het Regionaal Dienstverleningscentrum Kleinbedrijf Friesland hebben we Itens, Rien, Hennaard, en Lutkewierum als voorbeeld van kernen met een minimaal voorzieningenniveau gekozen. Lutkewierum (1979: 82 inwoners) ligt ruim 7 km. ten noorden van Sneek en bijna 8 km. ten zuidoosten van Wommels. In het dorpje rondom de kerk wonen 10 huishoudens (exclusief 3 tweede woningbezitters), terwijl in het buitengebied 12 huishoudens veelal in vrijstaande boerderijen wonen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept628 ;
            sgpl:subjectText "kruidenierswarenpakket" ;
            sgpl:text_context "Toegepaste geografie wordt door OTTENS (1976, p. 19) omschreven als de richting binnen de sociale geografie, 'die zich toelegt op het ontwikkelen en uitvoeren van onderzoek naar de opbouw, werking, ontwikkeling en waardering van de sociaal-ruimtelijke werkelijkheid of onderdelen daarvan, ter voorbereiding van de sociaal-ruimtelijke planning en ordening'. In dit onderzoek wordt getracht de verschillen in de prijs van een gemiddeld kruidenierswarenpakket tussen ZWF, Rijnmond en Nederland vast te stellen. Vervolgens wordt ingegaan op 'het beeld' en 'de waardering' van eventuele ruimtelijke variatie van prijzen van de consument in ZWF." ],
        [ sgpl:refersToConcept unesco:concept7814 ;
            sgpl:subjectText "ruimtelijke ongelijkheid" ;
            sgpl:text_context "Deze kansenvermindering kan in strijd zijn met de principes van de verzorgingsstaat waarin wij geacht worden te leven (VAN BEMMEL et al. 1979, p. 14). Een relatieve kansenvermindering in het gebruik van door de samenleving als geheel verkregen sociaal-economische en sociaal-culturele verworvenheden, t.o.v. andere gebieden en/of bevolkingsgroepen, kan leiden tot een bepaalde mate van ruimtelijke ongelijkheid. Combineren we de gedachten van BUIT (1977, p. 616) en OTTENS (1980, p. 2) over ruimtelijke ongelijkheid dan kunnen we onderscheid maken tussen ruimtelijke ongelijkheid (in enge zin) dat betrekking heeft op de als negatief beoordeelde afwijkingen in kwantitatieve of kwalitatieve zin van processen en situaties in het ene gebied t.o.v. het andere gebied, en ruimtelijke verscheidenheid, waarbij die afwijkingen als positief worden beoordeeld." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "koopgedrag" ;
            sgpl:text_context "In 'Distributieve voorzieningen in kleine kernen' worden aanwijzingen in deze richting gegeven: motieven om te kopen in eigen dorp blijken vooral nabijheid, persoonlijke bediening en sociale verplichting te zijn (MIN. VAN ECONOMISCHE ZAKEN 1977, p. III9). De prijs is n.l. maar één aspect van de zaken die een rol spelen in het koopgedrag, oftewel: er zijn verscheidene dimensies in het koopgedrag te onderscheiden naast de rol van prijzen, bijv, assortiment, service en afstand tot huis. De consument verleent echter aan de ene dimensie meer prioriteit dan aan een andere en dit bepaalt in feite het relatieve belang van prijzen." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "koopgedrag" ;
            sgpl:text_context "In 'Distributieve voorzieningen in kleine kernen' worden aanwijzingen in deze richting gegeven: motieven om te kopen in eigen dorp blijken vooral nabijheid, persoonlijke bediening en sociale verplichting te zijn (MIN. VAN ECONOMISCHE ZAKEN 1977, p. III9). De prijs is n.l. maar één aspect van de zaken die een rol spelen in het koopgedrag, oftewel: er zijn verscheidene dimensies in het koopgedrag te onderscheiden naast de rol van prijzen, bijv, assortiment, service en afstand tot huis. De consument verleent echter aan de ene dimensie meer prioriteit dan aan een andere en dit bepaalt in feite het relatieve belang van prijzen." ],
        [ sgpl:refersToConcept unesco:concept7814 ;
            sgpl:subjectText "ruimtelijke ongelijkheid" ;
            sgpl:text_context "Deze kansenvermindering kan in strijd zijn met de principes van de verzorgingsstaat waarin wij geacht worden te leven (VAN BEMMEL et al. 1979, p. 14). Een relatieve kansenvermindering in het gebruik van door de samenleving als geheel verkregen sociaal-economische en sociaal-culturele verworvenheden, t.o.v. andere gebieden en/of bevolkingsgroepen, kan leiden tot een bepaalde mate van ruimtelijke ongelijkheid. Combineren we de gedachten van BUIT (1977, p. 616) en OTTENS (1980, p. 2) over ruimtelijke ongelijkheid dan kunnen we onderscheid maken tussen ruimtelijke ongelijkheid (in enge zin) dat betrekking heeft op de als negatief beoordeelde afwijkingen in kwantitatieve of kwalitatieve zin van processen en situaties in het ene gebied t.o.v. het andere gebied, en ruimtelijke verscheidenheid, waarbij die afwijkingen als positief worden beoordeeld." ],
        [ sgpl:refersToConcept unesco:concept628 ;
            sgpl:subjectText "kruidenierswarenpakket" ;
            sgpl:text_context "Toegepaste geografie wordt door OTTENS (1976, p. 19) omschreven als de richting binnen de sociale geografie, 'die zich toelegt op het ontwikkelen en uitvoeren van onderzoek naar de opbouw, werking, ontwikkeling en waardering van de sociaal-ruimtelijke werkelijkheid of onderdelen daarvan, ter voorbereiding van de sociaal-ruimtelijke planning en ordening'. In dit onderzoek wordt getracht de verschillen in de prijs van een gemiddeld kruidenierswarenpakket tussen ZWF, Rijnmond en Nederland vast te stellen. Vervolgens wordt ingegaan op 'het beeld' en 'de waardering' van eventuele ruimtelijke variatie van prijzen van de consument in ZWF." ] ;
    sgpl:thesisID 110 .

sgpl:Thesis111 a sgpl:SGPLThesis ;
    dcterms:creator "Pia Lindner" ;
    dcterms:title "De vrouw in Djenné, Mali",
        "Een sociaal-economische en demografische analyse" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2449067 ;
            sgpl:spatialText "Tombouctou" ;
            sgpl:text_context "In de eeuwen na de stichting van de stad vestigden praktisch alle handelaren uit Dia zich in Djenné (d.w.z. kleine Dia) en daarmee nam Djenné de oude handelsfunctie van Dia over. De bloeiperiode van Djenné begon in de 12de eeuw, toen ook Tombouctou (Timboektoe) als handelsstad opkwam. Deze bloei kreeg in de 15de eeuw een verdere impuls, toen zowel Djenné als Tombouctou tot hetzelfde rijk gingen behoren, het Songhay-rijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2458589 ;
            sgpl:spatialText "\"cercle\" Djenné" ;
            sgpl:text_context "De internationale handelsfunktie is ver- vangen door een beperkte regionale handelsfunktie, die niet veel verder reikt dan de direkte omgeving van Djenné. Behouden ia gebleven dat Djenné het belangrijkste regionale centrum is van de \"cercle\" Djenné, waartoe 29 dorpen behoren. Dit betekent dat Djenné het administratieve centrum is van de regio en dat de stad het best uitgeruste gezondheidscentrum (zie hoofdstuk s) en het best ontwikkelde onderwijssysteem (zie hoofdstuk 5) heeft van de regio." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2453348 ;
            sgpl:spatialText "Mopti" ;
            sgpl:text_context "In deze tijd is de stad niet meer over de weg te bereiken, omdat er geen vaste verbinding meer is met het \"vasteland” buiten de delta. Mensen die van de regionale hoofdstad Mopti (90 km ten nno van Djenné) naar Djenné willen, moeten om te beginnen wachten, op de wekelijkse dag dat de boot vertrekt en dan -inclusief overnachting- nog wel 36 uur reistijd rekenen. In de \"natte” tijd zijn de contacten met de buitenwereld dan ook minimaal." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2458589 ;
            sgpl:spatialText "Djenné" ;
            sgpl:text_context "In 1978 is de vakgroep Sociale Geografie der Ontwikkelingslanden van het geografisch instituut van de Rijks Universiteit van Utrecht een serie onderzoeken gestart rond een van de kleine steden van Mali: Djenné. Doel van deze onderzoeken is zo veel mogelijk inzicht te verwerven in het funktioneren van zowel stad als platteland en in de relaties die tusse: stad en platteland bestaan, opdat mogelijkheden voor ontwikkeling van de regio ontdekt kunnen worden. De onderzoeken worden uit gevoerd door drie groepjes van drie studenten elk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2453866 ;
            sgpl:spatialText "Mali" ;
            sgpl:text_context "In 1978 is de vakgroep Sociale Geografie der Ontwikkelingslanden van het geografisch instituut van de Rijks Universiteit van Utrecht een serie onderzoeken gestart rond een van de kleine steden van Mali: Djenné. Doel van deze onderzoeken is zo veel mogelijk inzicht te verwerven in het funktioneren van zowel stad als platteland en in de relaties die tusse: stad en platteland bestaan, opdat mogelijkheden voor ontwikkeling van de regio ontdekt kunnen worden. De onderzoeken worden uit gevoerd door drie groepjes van drie studenten elk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2460596 ;
            sgpl:spatialText "Bamako" ;
            sgpl:text_context "Maar ook dan moet men nog 4 a 7 uur reizen naar Mopti of naar de andere nabijgelegen stad San ( 90 km zzw van Djenné). Om de hoofdstad Bamako te bereiken (550 km wzw van Djenné) moet men ook in de droge tijd op 12 'a 24 uur reistijd rekenen. Het geïsoleerd gelegen Djenné ligt dus in het ook al moeilijk te bereiken land Mali." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Om een beter inzicht te verkrijgen in de stad is het zinnig eerst puntsgewijs de belangrijkste karakteristieken van het land te geven: —Mali is, hoewel tamelijk onbekend, een van de grootste Afrikaanse landen, en is ruim JO maal zo groot als Nederland. In 1975 telde het land ca. 5*580.000 inwoners (Annuaire Statistique Mali 1975» gepubl. 1976, p.24). De gemiddelde bevolkingsdichtheid van het bewoonde platteland bedraagt 10 inwoners per km." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2453347 ;
            sgpl:spatialText "regio Mopti" ;
            sgpl:text_context "Gingen in 1963-64 nog ruim 2x zoveel jongens als meisjes naar de basisschool, in 1972-73 gingen nog maar 1,6x.zoveel jongens als meisjes naar deze school. Deze landelijke gemiddelden gaan niet op voor de regio Mopti, waarin Djenné is gelegen. De verhouding jongens: meisjes die een ^school bezoeken is hier voor de meisjes nóg ongunstiger." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2451778 ;
            sgpl:spatialText "San" ;
            sgpl:text_context "In de periode met laag water, half december, is een pontje in staat met auto 1 s de rivier de Bani over te steken en het isolement wordt dan ook minder. Maar ook dan moet men nog 4 a 7 uur reizen naar Mopti of naar de andere nabijgelegen stad San ( 90 km zzw van Djenné). Om de hoofdstad Bamako te bereiken (550 km wzw van Djenné) moet men ook in de droge tijd op 12 'a 24 uur reistijd rekenen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2459176 ;
            sgpl:spatialText "stadje Dia" ;
            sgpl:text_context "Djenné is in het begin van de 9de eeuw gesticht door een aantal handelaren uit het naburige stadje Dia. Dia speelde op dat moment een rol in de Transsaharahandel, waarbij goederen uit het Middellandse zeegebied werden vervoerd naar de west-Afrikaanse landen ten zuiden van de Sahara, en omgekeerd. Djenné heeft zijn bestaan in den beginne te danken aan het feit dat het aan een zijkreek van de Bani ligt, die een groot deel van het jaar goed bevaarbaar is." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept436 ;
            sgpl:subjectText "Huwelijkspatroon" ;
            sgpl:text_context "M.n. het hoge bruto geboortecijfer wijst erop dat de vrouwen in de reproduktieve leeftijd een groot deel van haar tijd aan kinderzorg zullen moeten besteden. Wat het huwelijkspatroon betreft mag tenminste aangenomen worden dat de huwelijksleeftijd van de Djenninké-vrouwen laag zal zijn. Uit de enquête demographique dans le delta central Nigerien (1962, p.77) blijkt dat 72,6% van de vrouwen voor haar 20 ste jaar gehuwd is." ],
        [ sgpl:refersToConcept unesco:concept6181 ;
            sgpl:subjectText "Sociaal-economische positie van de vrouw" ;
            sgpl:text_context "Deze scriptie is het resultaat van het onderzoek van een van hen en werd uitgevoerd van oktober 1978 t/m maart 1979*. Het betreft een onderzoek waarin wordt nagegaan wat de sociaal economische aktiviteiten van de vrouw in de Djenninké gemeenschap zijn en waarin, daarmee samenhangend, een analyse wordt gemaakt van de demografische variabelen huwelijkspatroon, vruchtbaarheidspatroon en sterfte-patroon. De sociaal-economische aktiviteiten van de Djenninké vrouwen worden bestudeerd opdat men, als een ontwikkelingsstategie voor Djenné en omgeving wordt opgesteld, ook met het werkterrein en de positie van de vrouw rekening kan houden." ],
        [ sgpl:refersToConcept unesco:concept4115 ;
            sgpl:subjectText "Vruchtbaarheidspatroon" ;
            sgpl:text_context "XII DB INVLOED VAN DE DEMOGRAFISCHE VARIABELEN OP DE POSITIE DIE DE VROUWEN IN DE SAMENLEVING INNEMEN. In deze scriptie kwam naar voren dat het huweljjkspatroon, het vruchtbaarheidspatroon en het sterftepatroon worden beïnvloed door verschillende factoren. Zo wordt het huweljjkspatroon in belangrijke mate beïnvloed door de culturele waarden en voorschriften van de samenleving, door de wens van de bevolking veel kinderen te hebben en door de Islam." ],
        [ sgpl:refersToConcept unesco:concept436 ;
            sgpl:subjectText "Huwelijkspatroon" ;
            sgpl:text_context "M.n. het hoge bruto geboortecijfer wijst erop dat de vrouwen in de reproduktieve leeftijd een groot deel van haar tijd aan kinderzorg zullen moeten besteden. Wat het huwelijkspatroon betreft mag tenminste aangenomen worden dat de huwelijksleeftijd van de Djenninké-vrouwen laag zal zijn. Uit de enquête demographique dans le delta central Nigerien (1962, p.77) blijkt dat 72,6% van de vrouwen voor haar 20 ste jaar gehuwd is." ],
        [ sgpl:refersToConcept unesco:concept4115 ;
            sgpl:subjectText "Vruchtbaarheidspatroon" ;
            sgpl:text_context "XII DB INVLOED VAN DE DEMOGRAFISCHE VARIABELEN OP DE POSITIE DIE DE VROUWEN IN DE SAMENLEVING INNEMEN. In deze scriptie kwam naar voren dat het huweljjkspatroon, het vruchtbaarheidspatroon en het sterftepatroon worden beïnvloed door verschillende factoren. Zo wordt het huweljjkspatroon in belangrijke mate beïnvloed door de culturele waarden en voorschriften van de samenleving, door de wens van de bevolking veel kinderen te hebben en door de Islam." ],
        [ sgpl:refersToConcept unesco:concept6181 ;
            sgpl:subjectText "Sociaal-economische positie van de vrouw" ;
            sgpl:text_context "Deze scriptie is het resultaat van het onderzoek van een van hen en werd uitgevoerd van oktober 1978 t/m maart 1979*. Het betreft een onderzoek waarin wordt nagegaan wat de sociaal economische aktiviteiten van de vrouw in de Djenninké gemeenschap zijn en waarin, daarmee samenhangend, een analyse wordt gemaakt van de demografische variabelen huwelijkspatroon, vruchtbaarheidspatroon en sterfte-patroon. De sociaal-economische aktiviteiten van de Djenninké vrouwen worden bestudeerd opdat men, als een ontwikkelingsstategie voor Djenné en omgeving wordt opgesteld, ook met het werkterrein en de positie van de vrouw rekening kan houden." ] ;
    sgpl:thesisID 111 .

sgpl:Thesis113 a sgpl:SGPLThesis ;
    dcterms:creator "Geert Renting" ;
    dcterms:issued 1982 ;
    dcterms:title "De weg van Rotterdam naar zee",
        "een historisch-kartografische studie" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745307 ;
            sgpl:spatialText "Voorne" ;
            sgpl:text_context "De beschikbare diepgang van het Haringvliet langs Hel- levoetsluis was nog een 18 voet, maar de lengte van de vaarweg naar Rotterdam langs deze route was 94 kilometer in plaats van de 35 door de Maas. Vandaar dat besloten werd tot de aanleg van een kanaal door Voorne tussen Hel- levoetsluis en Zwartewaal, hetwelk in 1829 voltooid werd: nu was de route van zee naar Rotterdam 40 kilometer en bevaarbaar voor schepen met een diepgang van 18 voet. Echter al heel gauw daarna werd ook de diepte van het Goereese Gat onvoldoende." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750630 ;
            sgpl:spatialText "Monster" ;
            sgpl:text_context "In de Romeinse tijd was de Maasmond aanzienlijk breder dan in latere tijden. De breedte ervan strekte zich in die dagen, en ook nog vele eeuwen daarna, uit van Brielle tot Monster. De rivier verbreedde zich voorbij het huidige Vlaardingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "de noordelijke oever" ;
            sgpl:text_context "Daarna echter is het mogelijk de geschiedenis van de Maasmond te reconstrueren, hetgeen Dr. A.A. Beekman (in het tijdschrift van het K.N.AtG.) in 1919 zeer volledig heeft gedaan, zy het dat het met name gaat om een reconstructie van de loop van de noordelijke oever. Hij veronderstelt onder meer dat aan de naam Monster, die in 11% voor het eerst voor- komt, mogelijk de namen Masemude en/of Masemuthon zyn voorafge- gaan, hetgeen gewoon Maasmond betekent. In. de twaalfde eeuw liep de buitenwaterkering noord- westelijk van Monster tot de duinen (Engelbrecht, 1934» blz. 55) hetgeen nog eens duidelijk maakt hoe breed ook in die tijd de Maasmond nog altijd was." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754007 ;
            sgpl:spatialText "Hoek van Holland" ;
            sgpl:text_context "Ook daarmee zijn echter de problemen niet opgelost: er is immers nog steeds sprake van de ’levendige zallem- vangst in de Maas voor deze stad (Rotterdam), als op d’ IJssel en de Lek' (tekst Maaskaart -hfdst. IV, kaart 11- van Quack) en dus ook nog van de 'onbehoorlijke salm- steeken'. In een 'Verbael, gemaekt bij Corn. de Man en Willem Stellenaer wegens het peilen van de Salmfteeken op Order van de Heeren Burger= en Regeerders der Steden Delft, Rotterdam, Schiedam en Brielle' van juli 1740 (OAR 2553) worden talloze zalmsteken tussen Hoek van Holland en Dordrecht opgesomd. Ook op kaarten uit die tijd (hfdstk. IV, kaarten 76 en 77) ziet men ongelofelijk veel van dergelijke zalmsteken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755420 ;
            sgpl:spatialText "Stad Gouda" ;
            sgpl:text_context "Kaarte van den loop der Maase en Merwede; zoo als denzelven was in den Jaare 1565. Zijnde deze kaart ter requisitie van Ben Wel Edelen Gebooren Gestrengen Heere Mr. Adriaan Prins Raad en regeerend Burgermeester der Stad Gouda & & , naauw- keurig gecopieert en in allen deele gevolgt naar de Origineele van dato 26 jultf der bovenstaanden Jaars, berustende onder de Archiven der Stad Gouda voorn : auteur: J. van Westenhout Bavidsz bij den Ed.Hove van Holl. geadm land ." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "De heer P. Ratsma, hoofd van de Topografisch—historische atlas van het Gemeentearchief te Rotterdam gaf de aanzet tot dit onderzoek en deed daarby een aantal zinvolle suggesties. Door de hoeveelheid kaarten van de Maasmond die bleek te bestaan en de heleas beperkte tyd die beschikbaar was, moest ik me beperken tot het grootschalig kaartmateriaal met relevante informatie met betrekking tot de Maasmond en bovendien afzien van inventarisatie van in atlassen opgenomen kaarten. In het Algemeen Ryksarchief te 's Gravenhage werd de inventaris Hingman, met supplementen, op het aanwezige kaartmateriaal bekeken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757348 ;
            sgpl:spatialText "Delfland" ;
            sgpl:text_context "Op dezelfde kaart is te zien dat de duinen aan de kust van Delfland aanzienlijk meer zeewaarts liggen ( rie tevens figuur 2 ) dan in latere tijden. De steeds verder gaande afkalving van deze‘duinen in de volgende decennia noodzaakt het Hoogheemraadschap maatregelen te nemen. Dientengevolge is op een groot aantal kaarten de zich steeds verder oostelijk terugtrekkende duinenrij afgebeeld ( hfdstk. IV, kaarten 84 t/m 91 )." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747869 ;
            sgpl:spatialText "Rozenburg" ;
            sgpl:text_context "In de eeuwen daarop zal het eiland steeds verder in omvang toenemen. Door het ontstaan van Rozenburg werd de nog steeds brede Maasmond in twee zich steeds versmallende wateren verdeeld. Door deze opvulling van de Maasmond en de daaraan inherente verkleining van de spuikom, werd de werking van de vloed belemmerd: de riviermond werd niet langer op diepte gehouden, met nieuwe aanslibbingen als logisch gevolg." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Gemeentearchief te Rotterdam" ;
            sgpl:text_context "De weg van Rotterdam naar zee een historisch-kartografische studie. De heer P. Ratsma, hoofd van de Topografisch—historische atlas van het Gemeentearchief te Rotterdam gaf de aanzet tot dit onderzoek en deed daarby een aantal zinvolle suggesties. Door de hoeveelheid kaarten van de Maasmond die bleek te bestaan en de heleas beperkte tyd die beschikbaar was, moest ik me beperken tot het grootschalig kaartmateriaal met relevante informatie met betrekking tot de Maasmond en bovendien afzien van inventarisatie van in atlassen opgenomen kaarten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "stad Rotterdam" ;
            sgpl:text_context "Het Oud Archief van de stad Rotterdam (OAR) werd nog geraadpleegd om meer contemporaine informatie te verkrijgen. Vanzelfsprekend werd de al eerder over de geschiedenis van de Maasmond verschenen literatuur tevens doorgenomen. G.R., september 1982." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745467 ;
            sgpl:spatialText "Vlaardingen" ;
            sgpl:text_context "De breedte ervan strekte zich in die dagen, en ook nog vele eeuwen daarna, uit van Brielle tot Monster. De rivier verbreedde zich voorbij het huidige Vlaardingen. Het deel van de Maas tussen die plaats en de Noordzee werd toentertijd omschreven als een 'fretum’, dat vertaald kan worden met 'zeearm'." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Maasmond" ;
            sgpl:text_context "Het moge echter duidelyk zijn dat de gerichtheid op deze kaarten onlosmakelijk verbonden is met de problematiek achter de kaarten. Het eerste hoofdstuk gaat over de geschiedenis van de Maasmond, waarbij de verzandingsproblemen voor de scheepvaart en in verband met de herhaaldelijk optredende ernstige overstromingen een centrale plaats innemen. In hoofdstuk twee komen de meer traditionele scheepvaartbegeleidingsmethodes ter sprake zoals bebakening, betonning en loodsdiensten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758326 ;
            sgpl:spatialText "Brielle" ;
            sgpl:text_context "In de Romeinse tijd was de Maasmond aanzienlijk breder dan in latere tijden. De breedte ervan strekte zich in die dagen, en ook nog vele eeuwen daarna, uit van Brielle tot Monster. De rivier verbreedde zich voorbij het huidige Vlaardingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Algemeen Ryksarchief te 's Gravenhage" ;
            sgpl:text_context "Door de hoeveelheid kaarten van de Maasmond die bleek te bestaan en de heleas beperkte tyd die beschikbaar was, moest ik me beperken tot het grootschalig kaartmateriaal met relevante informatie met betrekking tot de Maasmond en bovendien afzien van inventarisatie van in atlassen opgenomen kaarten. In het Algemeen Ryksarchief te 's Gravenhage werd de inventaris Hingman, met supplementen, op het aanwezige kaartmateriaal bekeken. De andere (kaarten)archieven in het ARA, zoals van Waterstaat, Genie en ook de inventaris op de nieuwe aanwinsten, bevatten wel Maasmondkaarten, maar dit zyn voornamelijk doublures van al eerder tegengekomen kaarten zonder verdere aanvullende informatie." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11077 ;
            sgpl:subjectText "Verzandingsproblemen" ;
            sgpl:text_context "Een kaart wordt immers niet gemaakt zonder dat er een aanleiding toe is en derhalve zullen toch hydrografische, economische, waterstaats- en scheepvaartkundige aspecten met betrekking tot de Maasmond belicht moeten worden, alvorens tot behandeling van de kaarten over te gaan. Het eerste hoofdstuk gaat over de geschiedenis van de Maasmond, waarbij de verzandingsproblemen voor de scheepvaart en in verband met de herhaaldelijk optredende ernstige overstromingen een centrale plaats innemen. In hoofdstuk twee komen de meer traditionele scheepvaartbegeleidingsmethodes ter sprake zoals bebakening, betonning en loodsdiensten." ],
        [ sgpl:refersToConcept unesco:concept3269 ;
            sgpl:subjectText "Historische kartografie" ;
            sgpl:text_context "Vanzelfsprekend werd de al eerder over de geschiedenis van de Maasmond verschenen literatuur tevens doorgenomen. Dat de onderhavige scriptie gemaakt is in Historisch Kartografisch kader moet de lezer duidelijk voor ogen staan. Centraal staat dus niet een historisch geografische reconstructie van de wording van de Maasmond, noch een hydrografische, waterstaats of scheepvaartkundige verhandeling, maar centraal moet in dit geval een zo volledig mogelyke inventarisatie en studie van het historisch kaartmateriaal betreffende de Maasmond staan." ],
        [ sgpl:refersToConcept unesco:concept7901 ;
            sgpl:subjectText "Loodsdiensten" ;
            sgpl:text_context "Het eerste hoofdstuk gaat over de geschiedenis van de Maasmond, waarbij de verzandingsproblemen voor de scheepvaart en in verband met de herhaaldelijk optredende ernstige overstromingen een centrale plaats innemen. In hoofdstuk twee komen de meer traditionele scheepvaartbegeleidingsmethodes ter sprake zoals bebakening, betonning en loodsdiensten. In hoofdstuk drie worden de in de loop der eeuwen aangedragen en eventueel ook uitgevoerde oplossingen voor de in het eerste hoofdstuk behandelde problematiek uiteengezet." ],
        [ sgpl:refersToConcept unesco:concept3269 ;
            sgpl:subjectText "Historische kartografie" ;
            sgpl:text_context "Vanzelfsprekend werd de al eerder over de geschiedenis van de Maasmond verschenen literatuur tevens doorgenomen. Dat de onderhavige scriptie gemaakt is in Historisch Kartografisch kader moet de lezer duidelijk voor ogen staan. Centraal staat dus niet een historisch geografische reconstructie van de wording van de Maasmond, noch een hydrografische, waterstaats of scheepvaartkundige verhandeling, maar centraal moet in dit geval een zo volledig mogelyke inventarisatie en studie van het historisch kaartmateriaal betreffende de Maasmond staan." ],
        [ sgpl:refersToConcept unesco:concept11077 ;
            sgpl:subjectText "Verzandingsproblemen" ;
            sgpl:text_context "Een kaart wordt immers niet gemaakt zonder dat er een aanleiding toe is en derhalve zullen toch hydrografische, economische, waterstaats- en scheepvaartkundige aspecten met betrekking tot de Maasmond belicht moeten worden, alvorens tot behandeling van de kaarten over te gaan. Het eerste hoofdstuk gaat over de geschiedenis van de Maasmond, waarbij de verzandingsproblemen voor de scheepvaart en in verband met de herhaaldelijk optredende ernstige overstromingen een centrale plaats innemen. In hoofdstuk twee komen de meer traditionele scheepvaartbegeleidingsmethodes ter sprake zoals bebakening, betonning en loodsdiensten." ],
        [ sgpl:refersToConcept unesco:concept7901 ;
            sgpl:subjectText "Loodsdiensten" ;
            sgpl:text_context "Het eerste hoofdstuk gaat over de geschiedenis van de Maasmond, waarbij de verzandingsproblemen voor de scheepvaart en in verband met de herhaaldelijk optredende ernstige overstromingen een centrale plaats innemen. In hoofdstuk twee komen de meer traditionele scheepvaartbegeleidingsmethodes ter sprake zoals bebakening, betonning en loodsdiensten. In hoofdstuk drie worden de in de loop der eeuwen aangedragen en eventueel ook uitgevoerde oplossingen voor de in het eerste hoofdstuk behandelde problematiek uiteengezet." ] ;
    sgpl:thesisID 113 .

sgpl:Thesis114 a sgpl:SGPLThesis ;
    dcterms:creator "G.G. van Beinum" ;
    dcterms:issued 1983 ;
    dcterms:title "Een beleidsgerichte beoordelingsmethoden van woonomstandigheden",
        "Huisvestingsomstandigheden op het Keniaanse platteland en het huisvestingsbeleid van de overheid" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:192950 ;
            sgpl:spatialText "Kenya" ;
            sgpl:text_context "Voorwoord. Deze scriptie is geschreven in het kader van de doctoraalstudie sociale geografie van de ontwikkelingslanden en gebaseerd op een veldwerk dat in 1980/1981 in Kenya is uitgevoerd. De kwaliteitsbeoordeling van de huisvestings- situatie in het Kisumu District bleek tijdens het veldwerk en tijdens het verwerken van de gegevens een hoop stof tot discussie op te leveren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:184745 ;
            sgpl:spatialText "Nairobi" ;
            sgpl:text_context "Vergeleken met de andere districten van Nyanza Province heeft Kisumu District een hoge weg-dichtheid per km2. De redenen hiervoor zijn: de grote weg van Nairobi naar Uganda loopt door het district, de nationale en regionale wegen die naar Kisumu-stad lopen. Behalve de \"all weather roads\" zijn de wegen gedurende het regenseizoen soms onbegaanbaar." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:193906 ;
            sgpl:spatialText "Kapuonja sub-locatie" ;
            sgpl:text_context "De onderzoeksgebieden zijn gekozen met het oog op de verwachte verschillen in HVO, de betrokken aantallen platteland-huishoudens en het inkomen van de huishoudens. In het suikergebied werd de Muhoroni suikerplantage gekozen, de Kabar sub-locatie staat model voor de kleinschalige \"outgrowers\", de beide irrigatieprojekten werden gekozen en tenslotte werd in Maseno Kapuonja subllocatie en op de Kano Plains Wawidhi \"A\" sub-locatie gekozen, (zie kaart 4) Om de verschillende manieren voor kwaliteitsbeoordeling van huisvestingsomstandigheden te toetsen, wordt hieronder de huisvestingssituatie in de sub-locaties beschreven en beoordeeld op kwaliteit." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:183015 ;
            sgpl:spatialText "Nyakach" ;
            sgpl:text_context "Op de Kano Plains is dit percentage aanzienlijk lager (66%) wat duidt op (tijdelijk) migratie om het inkomen aan te vullen. De boerderijen zijn in Maseno/Nyakach kleiner dan in de andere gebieden, maar daar staat tegenover dat de condities voor de landbouw veel gunstiger zijn. In Maseno/Nyakach is 80% van de boerderijen kleiner dan 3,2 ha., op de Kano Plains is 64% van de boerderijen groter dan 3,2 ha." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:182763 ;
            sgpl:spatialText "Nyanza Province" ;
            sgpl:text_context "Het Kisumu District is een van de vier districten van Nyanza Province en beslaat een landoppervlak van 2093 km2. Voor het grootste deel bestaat het uit een vlakke riviervlakte omringd door steile heuvelruggen in het noorden en zuiden, en het Victoria meer in het westen. In het oosten is geen duidelijke natuurlijke grens aanwezig." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:187506 ;
            sgpl:spatialText "Maseno" ;
            sgpl:text_context "Op de Kano Plains is dit percentage aanzienlijk lager (66%) wat duidt op (tijdelijk) migratie om het inkomen aan te vullen. De boerderijen zijn in Maseno/Nyakach kleiner dan in de andere gebieden, maar daar staat tegenover dat de condities voor de landbouw veel gunstiger zijn. In Maseno/Nyakach is 80% van de boerderijen kleiner dan 3,2 ha., op de Kano Plains is 64% van de boerderijen groter dan 3,2 ha." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:11964397 ;
            sgpl:spatialText "Kabar sub-locatie" ;
            sgpl:text_context "De onderzoeksgebieden zijn gekozen met het oog op de verwachte verschillen in HVO, de betrokken aantallen platteland-huishoudens en het inkomen van de huishoudens. In het suikergebied werd de Muhoroni suikerplantage gekozen, de Kabar sub-locatie staat model voor de kleinschalige \"outgrowers\", de beide irrigatieprojekten werden gekozen en tenslotte werd in Maseno Kapuonja subllocatie en op de Kano Plains Wawidhi \"A\" sub-locatie gekozen, (zie kaart 4) Om de verschillende manieren voor kwaliteitsbeoordeling van huisvestingsomstandigheden te toetsen, wordt hieronder de huisvestingssituatie in de sub-locaties beschreven en beoordeeld op kwaliteit." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Kano Plains" ;
            sgpl:text_context "In de meeste delen van het district komt deze verspreide vorm van bewoning voor. In de Kano Plains worden de homesteads gebouwd op de de iets hogere stukken grond om ze te beschermen tegen overstromingen. De Luo homestead verschilt in grootte en samenstelling overeenkomstig de samenstelling van het huishouden en de hoeveelheid land die beschikbaar is voor de bewoners." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:178214 ;
            sgpl:spatialText "Wawidhi \"A\" sub-locatie" ;
            sgpl:text_context "De onderzoeksgebieden zijn gekozen met het oog op de verwachte verschillen in HVO, de betrokken aantallen platteland-huishoudens en het inkomen van de huishoudens. In het suikergebied werd de Muhoroni suikerplantage gekozen, de Kabar sub-locatie staat model voor de kleinschalige \"outgrowers\", de beide irrigatieprojekten werden gekozen en tenslotte werd in Maseno Kapuonja subllocatie en op de Kano Plains Wawidhi \"A\" sub-locatie gekozen, (zie kaart 4) Om de verschillende manieren voor kwaliteitsbeoordeling van huisvestingsomstandigheden te toetsen, wordt hieronder de huisvestingssituatie in de sub-locaties beschreven en beoordeeld op kwaliteit." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:191242 ;
            sgpl:spatialText "Kisumu District" ;
            sgpl:text_context "Deze scriptie is geschreven in het kader van de doctoraalstudie sociale geografie van de ontwikkelingslanden en gebaseerd op een veldwerk dat in 1980/1981 in Kenya is uitgevoerd. De kwaliteitsbeoordeling van de huisvestingssituatie in het Kisumu District bleek tijdens het veldwerk en tijdens het verwerken van de gegevens een hoop stof tot discussie op te leveren. Daar ik geïnteresseerd ben in de toepasbaarheid van wetenschap wil ik nagaan of/hoe de verschillende manieren van benaderen van het huisvestingsprobleem kunnen worden toegepast op een concrete situatie." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6517 ;
            sgpl:subjectText "Kwaliteitsbeoordeling" ;
            sgpl:text_context "Deze scriptie is geschreven in het kader van de doctoraalstudie sociale geografie van de ontwikkelingslanden en gebaseerd op een veldwerk dat in 1980/1981 in Kenya is uitgevoerd. De kwaliteitsbeoordeling van de huisvestings- situatie in het Kisumu District bleek tijdens het veldwerk en tijdens het verwerken van de gegevens een hoop stof tot discussie op te leveren. Daar ik geïnteresseerd ben in de toepasbaarheid van wetenschap wil ik nagaan of/hoe de ver- schillende manieren van benaderen van het huisvestingsprobleem kunnen worden toegepast op een concrete situatie." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Huisvestingsomstandigheden" ;
            sgpl:text_context "Het doel van deze scriptie is het identificeren van problemen bij de analyse van huisvestingsomstandigheden (op het platteland) in ontwikkelingslanden en de implicaties voor het overheidsbeleid. Tevens zal, aan de hand van een onderzoek in Kenya (Kisumu District), worden nagegaan wat de mogelijkheden zijn om de huisvestings- omstandigheden op het platteland te analyseren en tot beleids- aanbevelingen te komen. Deze doelstelling zal aan de hand van de volgende onderzoeks- vragen worden uitgewerkt:" ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "Huisvestingsbeleid" ;
            sgpl:text_context "Deze sleutelbegrippen vormen samen het instrument om huisvestings- omstandigheden te meten. In hoofdstuk 2 wordt de positie van huisvestingsbeleid binnen de totale ontwikkelingsinspanning besproken en verschillende opvattingen daarover vergeleken. In hoofdstuk 3 wordt geprobeerd de drie meetinstrumenten die beschreven zijn in hoofdstuk 2 toe te passen voor de analyse van de huisvestingssituatie in het Kisumu District." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "Huisvestingsbeleid" ;
            sgpl:text_context "Deze sleutelbegrippen vormen samen het instrument om huisvestings- omstandigheden te meten. In hoofdstuk 2 wordt de positie van huisvestingsbeleid binnen de totale ontwikkelingsinspanning besproken en verschillende opvattingen daarover vergeleken. In hoofdstuk 3 wordt geprobeerd de drie meetinstrumenten die beschreven zijn in hoofdstuk 2 toe te passen voor de analyse van de huisvestingssituatie in het Kisumu District." ],
        [ sgpl:refersToConcept unesco:concept6517 ;
            sgpl:subjectText "Kwaliteitsbeoordeling" ;
            sgpl:text_context "Deze scriptie is geschreven in het kader van de doctoraalstudie sociale geografie van de ontwikkelingslanden en gebaseerd op een veldwerk dat in 1980/1981 in Kenya is uitgevoerd. De kwaliteitsbeoordeling van de huisvestings- situatie in het Kisumu District bleek tijdens het veldwerk en tijdens het verwerken van de gegevens een hoop stof tot discussie op te leveren. Daar ik geïnteresseerd ben in de toepasbaarheid van wetenschap wil ik nagaan of/hoe de ver- schillende manieren van benaderen van het huisvestingsprobleem kunnen worden toegepast op een concrete situatie." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Huisvestingsomstandigheden" ;
            sgpl:text_context "Het doel van deze scriptie is het identificeren van problemen bij de analyse van huisvestingsomstandigheden (op het platteland) in ontwikkelingslanden en de implicaties voor het overheidsbeleid. Tevens zal, aan de hand van een onderzoek in Kenya (Kisumu District), worden nagegaan wat de mogelijkheden zijn om de huisvestings- omstandigheden op het platteland te analyseren en tot beleids- aanbevelingen te komen. Deze doelstelling zal aan de hand van de volgende onderzoeks- vragen worden uitgewerkt:" ] ;
    sgpl:thesisID 114 .

sgpl:Thesis115 a sgpl:SGPLThesis ;
    dcterms:creator "Fedde Poort",
        "Fer de Bruin",
        "Hans de Leeuw",
        "Jan Minderhoud" ;
    dcterms:issued 1983 ;
    dcterms:title "stedelijk beheer: een theorie-praktijk-confrontatie" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "Het maakt eveneens onderdeel uit van het ’voorwaardelijk financierings-programma’ van het instituut. Voor dit onderzoek zijn wij gedurende de eerste helft van 1982 werkzaam geweest in Breda en Eindhoven. In de eerste plaats willen wij de heren A. Olsthoorn (Breda), J. Weitering en F. Klarenbeek (Eindhoven) bedanken voor de begeleiding die zij ons hebben gegeven bij onze werkzaamheden in beide gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Gerardus Majella-buurt" ;
            sgpl:text_context "De belangrijkste van die plannen zijn het structuurplan (1978), het sociaal plan (1977) en de nota stadsvernieuwing (.1981). Daarnaast is ook nog aandacht besteed aan de nota parkeerbeheer en het op poten staande groenstructuurplan en is het stadsvernieuwingsproces zoals zich dat heeft afgespeeld in de Gerardus Majella-buurt geanalyseerd. De bestudeerde plannen zijn niet los van elkaar te zien." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Rochusbuurt" ;
            sgpl:text_context "Volgens ons is dat er de oorzaak van dat een geschikte planorganisatie op buurtniveau, dat wil zeggen een organisatievorm waarin naast ambtelijke personen ook andere actoren vertegenwoordigd zijn, ontbreekt. Vandaar dat men in de Rochusbuurt en De Bergen {de huidige rehabilitatiegebieden in het centrumgebied) een puur ambtelijke planorganisatie in het leven heeft geroepen welke ad hoe met de buurt overlegt. Hierdoor, maar ook doordat die ambtelijke planorganisatie niet optimaal functioneert, is het stadsvernieuwingsproces voor de buurt zelf uitermate ondoorzichtig." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "Groningse binnenstad" ;
            sgpl:text_context "Artikel 11 biedt mogelijkheden om een bestemmingsplan uitvoeringsgericht te maken, zonder dat het zelf een uitvoeringsplan wordt (deel-, rapport 1, bijlage I). Bij de bestemmingsplanaanpak voor de Groningse binnenstad is men op een eigen wijze met artikel 11 WRO te werk gegaan (deelrapport 1, 3.6.). Bij de interpretatie van het globale bestemmingsplan vormt niet het eigendom maar de openbare ruimte het centrale gegeven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757790 ;
            sgpl:spatialText "De Bergen" ;
            sgpl:text_context "Volgens ons is dat er de oorzaak van dat een geschikte planorganisatie op buurtniveau, dat wil zeggen een organisatievorm waarin naast ambtelijke personen ook andere actoren vertegenwoordigd zijn, ontbreekt. Vandaar dat men in de Rochusbuurt en De Bergen {de huidige rehabilitatiegebieden in het centrumgebied) een puur ambtelijke planorganisatie in het leven heeft geroepen welke ad hoe met de buurt overlegt. Hierdoor, maar ook doordat die ambtelijke planorganisatie niet optimaal functioneert, is het stadsvernieuwingsproces voor de buurt zelf uitermate ondoorzichtig." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755034 ;
            sgpl:spatialText "Haagse Beemden" ;
            sgpl:text_context "Met name de dienst Openbare Werken is een star en gesloten opererend instituut gebleken dat nauwelijks open staat voor ideeën vanuit de bewoners. Naast de hiervoor in verband met de verschillende knelpunten genoemde problemen om te komen tot een beter beheer, is een zeer belangrijk knelpunt dat de gemeente haar aandacht moet verdelen tussen stadsuitbreiding (de Haagse Beemden) en het beheer van het bestaande stedelijk gebied. Het gelijktijdig ontwikkelen van een stadsvernieuwingsbeleid en een uitbreiding dreigt al een te grote claim te leggen op de gemeentelijke organisatie en financiën, terwijl nu bovendien onder invloed van een toenemende aandacht voor beheer het inzicht rijpt dat ook buiten de direct urgente stadsvernieuwingsgebieden ingrijpen gewenst is om verval te voorkomen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "provincie Noord-Brabant" ;
            sgpl:text_context "In de eerste plaats willen wij de heren A. Olsthoorn (Breda), J. Weitering en F. Klarenbeek (Eindhoven) bedanken voor de begeleiding die zij ons hebben gegeven bij onze werkzaamheden in beide gemeenten. Daarnaast willen wij ook nog die medewerkers bedanken van de gemeente Breda, de gemeente Eindhoven en het zogenaamde stadsvernieuwingsplatform van de provincie Noord-Brabant, die ons tal van adviezen en informatie hebben gegeven. De onderzoeksgegevens en -resultaten die we hebben gekregen op grond van een literatuuronderzoek en bij onze werkzaamheden in Breda en Eindhoven, hebben we verwerkt tot dit rapport." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "Het maakt eveneens onderdeel uit van het ’voorwaardelijk financierings-programma’ van het instituut. Voor dit onderzoek zijn wij gedurende de eerste helft van 1982 werkzaam geweest in Breda en Eindhoven. In de eerste plaats willen wij de heren A. Olsthoorn (Breda), J. Weitering en F. Klarenbeek (Eindhoven) bedanken voor de begeleiding die zij ons hebben gegeven bij onze werkzaamheden in beide gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Het hier voor u liggende rapport is het product van een onderzoek naar stedelijk beheer. Dit onderzoek hebben wij verricht in het kader van het afstudeerproject dat onderdeel uitmaakt van de doctoraalstudie planologie aan het Instituut voor Planologie aan de Rijksuniversiteit te Utrecht. Het maakt eveneens onderdeel uit van het ’voorwaardelijk financierings-programma’ van het instituut." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "stedelijk beheer" ;
            sgpl:text_context "In deze omschrijving wordt stadsvernieuwing gezien als een onderdeel van stadsbeheer. De omschrijving van stedelijk beheer mag zich niet beperken tot de gebouwde omgeving; ook de sociaal-maatschappelijke kanten van beheer moeten tot uitdrukking komen. Beheer kan dan ruim als volgt gedefinieerd worden: ’De bewaking van het leefklimaat in een stadsdeel’." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Na de aandacht voor de nieuwe woon- en werkgebieden (stadsuitleg) zijn vanaf het begin van de jaren zeventig ook de bestaande bebouwde gebieden in de belangstelling gekomen (stadsvernieuwing). Intussen wijzigt zich ook het karakter van de stadsvernieuwing. Is eerst sloop en nieuwbouw het parool, later wordt dat vernieuwbouw, verbetering en instandhouding." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "leefbaarheid" ;
            sgpl:text_context "Stedelijk beheer moet oplossingen aanreiken voor de in verschillende gebieden geconstateerde maatschappelijke en stedebouwkundige problemen. Een handvat voor inventarisatie van die problemen wordt gevormd door het begrip leefbaarheid. Voor een omschrijving van het leefbaarheidsbegrip hanteren wij de definitie van J.P. Groot." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "stedelijk beheer" ;
            sgpl:text_context "In deze omschrijving wordt stadsvernieuwing gezien als een onderdeel van stadsbeheer. De omschrijving van stedelijk beheer mag zich niet beperken tot de gebouwde omgeving; ook de sociaal-maatschappelijke kanten van beheer moeten tot uitdrukking komen. Beheer kan dan ruim als volgt gedefinieerd worden: ’De bewaking van het leefklimaat in een stadsdeel’." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "leefbaarheid" ;
            sgpl:text_context "Stedelijk beheer moet oplossingen aanreiken voor de in verschillende gebieden geconstateerde maatschappelijke en stedebouwkundige problemen. Een handvat voor inventarisatie van die problemen wordt gevormd door het begrip leefbaarheid. Voor een omschrijving van het leefbaarheidsbegrip hanteren wij de definitie van J.P. Groot." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Na de aandacht voor de nieuwe woon- en werkgebieden (stadsuitleg) zijn vanaf het begin van de jaren zeventig ook de bestaande bebouwde gebieden in de belangstelling gekomen (stadsvernieuwing). Intussen wijzigt zich ook het karakter van de stadsvernieuwing. Is eerst sloop en nieuwbouw het parool, later wordt dat vernieuwbouw, verbetering en instandhouding." ] ;
    sgpl:thesisID 115 .

sgpl:Thesis117 a sgpl:SGPLThesis ;
    dcterms:creator "Ben van de Burgwal" ;
    dcterms:issued 1983 ;
    dcterms:title "Een onderzoek naar de invloed van de tweede woningen op het wonen in een landelijk gebied en het daarbij betrokken beleid",
        "TWEEDE WONINGEN IN ZUIDWEST-FRIESLAND" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747231 ;
            sgpl:spatialText "Sint-Nicolaasga" ;
            sgpl:text_context "In Wyckel en in mindere mate in Woudsend en Gaastmeer vreesde men, dat daarnaast veel boodschaapen in een nabijgelegen groter centrum (Balk of Sneek) gedaan werden. In Idskenhuizen deden de rekreanten, evenals trouwens het merendeel van de bewoners, de meeste boodschappen in Sint-Nicolaasga of elders buiten het dorp. Een opmerkelijk verschil deed zich in dit verband voor met de geplande 2e woningen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "noordelijke Randstad" ;
            sgpl:text_context "Een waterrijk enrelatief dunbevolkt gebied met een hoge landschappelijke waarde, dat redelijk goed bereikbaar is vanuit bijvoorbeeld de noordelijke Randstad. Lange tijd was hier tevens sprake van een ruim aanbod van relatief goedkope huizen, waarmee de ontwikkelingen in het verleden ongetwijfeld zijn gestimuleerd. 1.3. Tweede woningen en de gevolgen voor de leefbaarheid: Een literatuuroverzicht" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Hemelumer Oldeferd" ;
            sgpl:text_context "Bij de keuze van de gemeenten was het gewenst die gemeenten te kiezen, die zowel absoluut als relatief ten opzichte van hun totale woningvoorraad veel 2e woningen binnen hun grenzen telden. Daarmee viel de keuze op de gemeenten Doniawerstal, Hemelumer Oldeferd, Wymbritseradeel en Gaasterland. Verder is een kleinere gemeente (Sloten) bij het onderzoek betrokken, om een grotere heterogeniteit van gemeenten kwa inwonertal na te streven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747132 ;
            sgpl:spatialText "Sloten" ;
            sgpl:text_context "Bij de keuze van de gemeenten was het gewenst die gemeenten te kiezen, die zowel absoluut als relatief ten opzichte van hun totale woningvoorraad veel 2e woningen binnen hun grenzen telden. Daarmee viel de keuze op de gemeenten Doniawerstal, Hemelumer Oldeferd, Wymbritseradeel en Gaasterland. Verder is een kleinere gemeente (Sloten) bij het onderzoek betrokken, om een grotere heterogeniteit van gemeenten kwa inwonertal na te streven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759472 ;
            sgpl:spatialText "Balk" ;
            sgpl:text_context "In Elahuizen, Sloten en deels in Langweer waren de streekkenners het meest positief over het gebruik, dat de rekreanten in de echte 2e woningen van de lokale voorzieningen maakten. In Wyckel en in mindere mate in Woudsend en Gaastmeer vreesde men, dat daarnaast veel boodschaapen in een nabijgelegen groter centrum (Balk of Sneek) gedaan werden. In Idskenhuizen deden de rekreanten, evenals trouwens het merendeel van de bewoners, de meeste boodschappen in Sint-Nicolaasga of elders buiten het dorp." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754669 ;
            sgpl:spatialText "Heerenveen" ;
            sgpl:text_context "In Woudsend en Langweer wist men de leegloop echter redelijk op te vangen door nieuwbouw en een beter aanbod aan voorzieningen. Dat neemt niet weg dat ook deze kernen te kampen hadden met sterke verliezen aan werkgelegenheid ten gunste van grotere plaatsen als Sneek en Heerenveen. Voor deel 3 van de probleemstelling is kontakt gezocht met makelaars in de omgeving die zich beroepshalve wel eens bezig hadden gehouden met 2e woningen of dat nog steeds deden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756235 ;
            sgpl:spatialText "Elahuizen" ;
            sgpl:text_context "Tot de zelfstandige dorpen, dat wil zeggen de kernen die in staat zijn een redelijk verzorgingsapparaat, afgestemd op de dagelijkse levensbehoeften in stand te houden, worden Woudsend, Langweer en Sloten gerekend. De afhankelijke dorpen in het onderzoek, die voor bepaalde dagelijkse levensbehoeften als het ware afhankelijk zijn van centra, die hoger in de verzorgingshiërarchie staan, zijn Idskenhuizen, Elahuizen en Gaastmeer. De kern Wyckel valt daartussen als een gedeeltelijk zelfstandig dorp." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751888 ;
            sgpl:spatialText "Langweer" ;
            sgpl:text_context "Tot de zelfstandige dorpen, dat wil zeggen de kernen die in staat zijn een redelijk verzorgingsapparaat, afgestemd op de dagelijkse levensbehoeften in stand te houden, worden Woudsend, Langweer en Sloten gerekend. De afhankelijke dorpen in het onderzoek, die voor bepaalde dagelijkse levensbehoeften als het ware afhankelijk zijn van centra, die hoger in de verzorgingshiërarchie staan, zijn Idskenhuizen, Elahuizen en Gaastmeer. De kern Wyckel valt daartussen als een gedeeltelijk zelfstandig dorp." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Uit gegevens van het CBS blijkt dat de 2e woningen in 1972 zeer ongelijk verdeeld waren over Nederland. Friesland had 21,7 Z of 2616 op het totaal van 12.030 en met Zeeland was het aandeel bijna 53 Z van het aantal 2e woningen in heel Nederland. Het onderzoek van IJKELENSTAM (1974, p. 2,3), waarin deze gegevens zijn ongenomen, geeft een zeer sterke koncentratie van 2e woningen in waterrijke gebieden aan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755787 ;
            sgpl:spatialText "Gaasterland" ;
            sgpl:text_context "Bij de keuze van de gemeenten was het gewenst die gemeenten te kiezen, die zowel absoluut als relatief ten opzichte van hun totale woningvoorraad veel 2e woningen binnen hun grenzen telden. Daarmee viel de keuze op de gemeenten Doniawerstal, Hemelumer Oldeferd, Wymbritseradeel en Gaasterland. Verder is een kleinere gemeente (Sloten) bij het onderzoek betrokken, om een grotere heterogeniteit van gemeenten kwa inwonertal na te streven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747063 ;
            sgpl:spatialText "Sneek" ;
            sgpl:text_context "In Woudsend en Langweer wist men de leegloop echter redelijk op te vangen door nieuwbouw en een beter aanbod aan voorzieningen. Dat neemt niet weg dat ook deze kernen te kampen hadden met sterke verliezen aan werkgelegenheid ten gunste van grotere plaatsen als Sneek en Heerenveen. Voor deel 3 van de probleemstelling is kontakt gezocht met makelaars in de omgeving die zich beroepshalve wel eens bezig hadden gehouden met 2e woningen of dat nog steeds deden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744011 ;
            sgpl:spatialText "Zeeland" ;
            sgpl:text_context "Uit gegevens van het CBS blijkt dat de 2e woningen in 1972 zeer ongelijk verdeeld waren over Nederland. Friesland had 21,7 Z of 2616 op het totaal van 12.030 en met Zeeland was het aandeel bijna 53 Z van het aantal 2e woningen in heel Nederland. Het onderzoek van IJKELENSTAM (1974, p. 2,3), waarin deze gegevens zijn ongenomen, geeft een zeer sterke koncentratie van 2e woningen in waterrijke gebieden aan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755781 ;
            sgpl:spatialText "Gaastmeer" ;
            sgpl:text_context "Tot de zelfstandige dorpen, dat wil zeggen de kernen die in staat zijn een redelijk verzorgingsapparaat, afgestemd op de dagelijkse levensbehoeften in stand te houden, worden Woudsend, Langweer en Sloten gerekend. De afhankelijke dorpen in het onderzoek, die voor bepaalde dagelijkse levensbehoeften als het ware afhankelijk zijn van centra, die hoger in de verzorgingshiërarchie staan, zijn Idskenhuizen, Elahuizen en Gaastmeer. De kern Wyckel valt daartussen als een gedeeltelijk zelfstandig dorp." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Wyckel" ;
            sgpl:text_context "Tot de zelfstandige dorpen, dat wil zeggen de kernen die in staat zijn een redelijk verzorgingsapparaat, afgestemd op de dagelijkse levensbehoeften in stand te houden, worden Woudsend, Langweer en Sloten gerekend. De afhankelijke dorpen in het onderzoek, die voor bepaalde dagelijkse levensbehoeften als het ware afhankelijk zijn van centra, die hoger in de verzorgingshiërarchie staan, zijn Idskenhuizen, Elahuizen en Gaastmeer. De kern Wyckel valt daartussen als een gedeeltelijk zelfstandig dorp." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Zuidwest-Friesland" ;
            sgpl:text_context "Het is uitgevoerd in het kader van het projekt Zuidwest-Friesland. In dit gebied, dat door zijn uiterlijke kenmerken als 'landelijk gebied' wordt beschouwd, wordt de sociaal-ruimtelijke problematiek onder meer gekenmerkt door veelal botsende belangen vanuit de bewoners, de rekreanten en de natuur. Dit onderzoek heeft betrekking op een aspekt van deze problematiek, een aspekt dat echter meerdere raakvlakken heeft met de genoemde probleemvelden: het verschijnsel van de tweede woningen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Doniawerstal" ;
            sgpl:text_context "Bij de keuze van de gemeenten was het gewenst die gemeenten te kiezen, die zowel absoluut als relatief ten opzichte van hun totale woningvoorraad veel 2e woningen binnen hun grenzen telden. Daarmee viel de keuze op de gemeenten Doniawerstal, Hemelumer Oldeferd, Wymbritseradeel en Gaasterland. Verder is een kleinere gemeente (Sloten) bij het onderzoek betrokken, om een grotere heterogeniteit van gemeenten kwa inwonertal na te streven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Friesland" ;
            sgpl:text_context "Voor de totstandkoming van dit onderzoek was de medewerking van veie instanties en personen in Friesland noodzakelijk. In het bijzonder wil ik daarom mijn dank uitspreken aan de Provinciaal Planologische Dienst van Friesland, de welzijnsstichting Sudergoa en de beleidsmedewerkers van de 5 in het onderzoek betrokken gemeenten alsmede alle andere geïnterviewde personen voor hun bereidheid de nodige inlichtingen te verschaffen. Ben van de Burgwal maart 1983." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Wymbritseradeel" ;
            sgpl:text_context "Bij de keuze van de gemeenten was het gewenst die gemeenten te kiezen, die zowel absoluut als relatief ten opzichte van hun totale woningvoorraad veel 2e woningen binnen hun grenzen telden. Daarmee viel de keuze op de gemeenten Doniawerstal, Hemelumer Oldeferd, Wymbritseradeel en Gaasterland. Verder is een kleinere gemeente (Sloten) bij het onderzoek betrokken, om een grotere heterogeniteit van gemeenten kwa inwonertal na te streven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT tweede woningen ■ Ben van de Burgwal mei 1983. VERSLAGEN VAN LEERONDERZOEK SGS vakgroep sociale geografie van destedelijk-industriële landen. I l TWEEDE WONINGEN IN ZUIDWEST-FRIESLAND." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744153 ;
            sgpl:spatialText "Woudsend" ;
            sgpl:text_context "Tot de zelfstandige dorpen, dat wil zeggen de kernen die in staat zijn een redelijk verzorgingsapparaat, afgestemd op de dagelijkse levensbehoeften in stand te houden, worden Woudsend, Langweer en Sloten gerekend. De afhankelijke dorpen in het onderzoek, die voor bepaalde dagelijkse levensbehoeften als het ware afhankelijk zijn van centra, die hoger in de verzorgingshiërarchie staan, zijn Idskenhuizen, Elahuizen en Gaastmeer. De kern Wyckel valt daartussen als een gedeeltelijk zelfstandig dorp." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753390 ;
            sgpl:spatialText "Idskenhuizen" ;
            sgpl:text_context "Tot de zelfstandige dorpen, dat wil zeggen de kernen die in staat zijn een redelijk verzorgingsapparaat, afgestemd op de dagelijkse levensbehoeften in stand te houden, worden Woudsend, Langweer en Sloten gerekend. De afhankelijke dorpen in het onderzoek, die voor bepaalde dagelijkse levensbehoeften als het ware afhankelijk zijn van centra, die hoger in de verzorgingshiërarchie staan, zijn Idskenhuizen, Elahuizen en Gaastmeer. De kern Wyckel valt daartussen als een gedeeltelijk zelfstandig dorp." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "tweede woningen" ;
            sgpl:text_context "In dit gebied, dat door zijn uiterlijke kenmerken als 'landelijk gebied' wordt beschouwd, wordt de sociaal-ruimtelijke problematiek onder meer gekenmerkt door veelal botsende belangen vanuit de bewoners, de rekreanten en de natuur. Dit onderzoek heeft betrekking op een aspekt van deze problematiek, een aspekt dat echter meerdere raakvlakken heeft met de genoemde probleemvelden: het verschijnsel van de tweede woningen. Daarbij gaat het om de invloed, die hun aanwezigheid heeft op het wonen in kleine kernen en het beleid dat daarbij, in het bijzonder door de gemeenten wordt ge- voerd." ],
        [ sgpl:refersToConcept unesco:concept367 ;
            sgpl:subjectText "rekreatievergunning" ;
            sgpl:text_context "Wat het tweede punt betreft wordt er in het VOORONTWERP (1980, p. 140) op aange- drongen hiervoor de nodige maatregelen te treffen. In de praktijk blijkt de toepassing van de rekreatievergunning via de Algemene Politieverordening veruit de meest gehanteerde beleidsmaatregel te zijn om de toename van 2e woningen te benvloeden. Aan de betekenis van de rekreatievergunning en de voorgeschiedenis ervan zijn dan ook de volgende drie paragrafen aan gewijd." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "leefbaarheid" ;
            sgpl:text_context "De laatste jaren heeft zich een duidelijke kentering in het tweede-woningbezit voltrokken. Daarnaast kreeg de problematiek van kleine kernen nieuwe aandacht en werd meer benaderd vanuit het begrip 'leefbaarheid'. Dit begrip, dat in IV.1 nader is toegelicht, is in dit onderzoek met name gebaseerd op studies hierover van J. Groot." ],
        [ sgpl:refersToConcept unesco:concept367 ;
            sgpl:subjectText "rekreatievergunning" ;
            sgpl:text_context "Wat het tweede punt betreft wordt er in het VOORONTWERP (1980, p. 140) op aange- drongen hiervoor de nodige maatregelen te treffen. In de praktijk blijkt de toepassing van de rekreatievergunning via de Algemene Politieverordening veruit de meest gehanteerde beleidsmaatregel te zijn om de toename van 2e woningen te benvloeden. Aan de betekenis van de rekreatievergunning en de voorgeschiedenis ervan zijn dan ook de volgende drie paragrafen aan gewijd." ],
        [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "tweede woningen" ;
            sgpl:text_context "In dit gebied, dat door zijn uiterlijke kenmerken als 'landelijk gebied' wordt beschouwd, wordt de sociaal-ruimtelijke problematiek onder meer gekenmerkt door veelal botsende belangen vanuit de bewoners, de rekreanten en de natuur. Dit onderzoek heeft betrekking op een aspekt van deze problematiek, een aspekt dat echter meerdere raakvlakken heeft met de genoemde probleemvelden: het verschijnsel van de tweede woningen. Daarbij gaat het om de invloed, die hun aanwezigheid heeft op het wonen in kleine kernen en het beleid dat daarbij, in het bijzonder door de gemeenten wordt ge- voerd." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "leefbaarheid" ;
            sgpl:text_context "De laatste jaren heeft zich een duidelijke kentering in het tweede-woningbezit voltrokken. Daarnaast kreeg de problematiek van kleine kernen nieuwe aandacht en werd meer benaderd vanuit het begrip 'leefbaarheid'. Dit begrip, dat in IV.1 nader is toegelicht, is in dit onderzoek met name gebaseerd op studies hierover van J. Groot." ] ;
    sgpl:thesisID 117 .

sgpl:Thesis118 a sgpl:SGPLThesis ;
    dcterms:creator "Marian van Eekelen" ;
    dcterms:issued 1983 ;
    dcterms:title "AGRARISCHE HERVORMING IN ZUID-PORTUGAL",
        "Landbouwcoöperaties en -collectieven in Zuid-Portugal na de Anjerrevolutie in 1974" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2272034 ;
            sgpl:spatialText "Alentejo" ;
            sgpl:text_context "In het Noorden van Portugal ontbreekt het grootgrondbezit niet, maar het komt toch vooral voor ten Zuiden van de Taag, waar het landsdeel Alentejo een belangrijk concentratiegebied vormt (zie Figuur 3., Bijlagen). Alentejo, dit is letterlijk het aan de overzijde van de Taag (Tejo) gelegen land, heeft een uitgesproken mediterraan klimaat. De neer- slag is er niet meer dan 500 tot 750 mm. per jaar en valt hoofd- zakelijk in het winterhalfjaar." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2264507,
                geonames:2268404,
                geonames:2270984 ;
            sgpl:spatialText "districten Be ja, Évora, Portalegre en Setübal" ;
            sgpl:text_context "In het Noorden van Portugal ontbreekt het grootgrondbezit niet, maar het komt toch vooral voor ten Zuiden van de Taag, waar het landsdeel Alentejo een belangrijk concentratiegebied vormt (zie Figuur 3., Bijlagen). In 1968 hoort in de districten Be ja, Évora, Portalegre en Setübal tesamen 78,1% van de landbouwgrond bij slechts 4,5% van het totaal aantal bedrijven dat groter is dan 100 ha. Daarentegen valt 58,2% van de landbouwbedrijven er in de bedrijfsgrootteklasse van 0,05-4 ha. en heeft daarbij de beschikking over slechts 2,3% van het totale landbouwoppervlak (Roux, 1982, p.200)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2264397 ;
            sgpl:spatialText "het zuidelijk deel van Portugal" ;
            sgpl:text_context "Bedoeling van deze scriptie is een antwoord te vinden op de vraag welke sociaal-economische veranderingen de zogenaamde agrarische revolutie heeft teweeggebracht in Zuid-Portügal; Daarbij wil ik me beperken tot het zuidelijk deel van Portugal, omdat de landbouwhervormingen grotendeels daar hebben plaatsge- vonden. Gezien de aard van de problematiek, die met de agrarische revolutie gepaard is gegaan, heb ik mij hoofdzakelijk bepaald tot een behandeling van de sociaal-economische en ook politieke fak- toren, die bij die veranderingen in de landbouw een rol spelen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Algarvië" ;
            sgpl:text_context "Alleen rond de dorpen en op die plaatsen waar irrigatie vzordt toegepast is van een intensievere landbouw sprake. In het uiterste Zuiden ligt Algarvië, waarvan het hoge gedeelte Alentejo van het zuidelijk kustgebied scheidt. De temperatuur wordt naar het Zuidwesten toe gematigder." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2267057 ;
            sgpl:spatialText "Lissabon" ;
            sgpl:text_context "Op grote schaal werd een groot aantal bedrij- van opnieuw georganiseerd in de vorm van collectieven en coöpe- raties, die later ook zijn genationaliseerd. In Lissabon keert in het najaar 1975 het politieke tij. Er vindt een machtsovername plaats door ’rechts’ dat zich in de daarop volgende jaren, via democratische verkiezingen evenwel, steeds duidelijker weet te manifesteren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijks- universiteit te Utrecht" ;
            sgpl:text_context "Landbouwcoöperaties en -collectieven in Zuid-Portugal na de Anjerrevolutie in 1974- Scriptie in het kader van de afstudeerrichting Geografie voor Educatie bij do studiorichting Sociale Geografie aan de Rijks- universiteit te Utrecht, onder begeleiding van Prof.dr. M. de Smidt. AGRARISCHE HERVORMING IN ZUID-PORTUGAL" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2264397 ;
            sgpl:spatialText "Portugal" ;
            sgpl:text_context "In het tweede hoofdstuk wordt ingegaan op de portugese landbouw- situatie, voordat zich daarin als gevolg van de revolutie verande- ringen voordoen. In het eerste deel van dit hoofdstuk wordt een karakteri.sein ng gegeven van de algehele landbouwsituatie in Portugal; in het tweede deel volgt een regionale typering met betrek- king tot de landbouw, gezien in het licht van de bestaande Moord- Zuid tegenstelling in Portugal. Het derde hoofdstuk wordt toegespitst op de zuid-portugese land- bouw." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2264397 ;
            sgpl:spatialText "Zuid-Portügal" ;
            sgpl:text_context "Verschillende schrijvers, onder wie G.Grohs en M.Cadete, V/. Borov/czak en P.Hoebink, zien de veranderingen die zich vanaf 1974 in Portugal hebben voorgedaan, als voornamelijk 'mot .'betrek- king, tót dö landbouvz van belang. Bedoeling van deze scriptie is een antwoord te vinden op de vraag welke sociaal-economische veranderingen de zogenaamde agrarische revolutie heeft teweeggebracht in Zuid-Portügal; Daarbij wil ik me beperken tot het zuidelijk deel van Portugal, omdat de landbouwhervormingen grotendeels daar hebben plaatsge- vonden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept13162 ;
            sgpl:subjectText "Grootgrondbezit" ;
            sgpl:text_context "In het voorjaar 1975 vzerd daartoe overgegaan tot de bezetting van een aantal fabrieken en banken, die vervolgens werden genationaliseerd. In nagenoeg alle districten waar het grootgrondbezit sterk was vertegenwoordigd werden na 25 april 1574 direct vakbonden opgericht. Enkele daarvan wisten CAO’s af te dwingen, waarin met name het recht op vzerk werd vastgelegd." ],
        [ sgpl:refersToConcept unesco:concept1701 ;
            sgpl:subjectText "Agrarische hervorming" ;
            sgpl:text_context "In hot vierde hoofdstuk wordt beschreven welko agrarische hervormingen in Zuid-Portugal hebben plaatsgevonden, met het accent daarin op het verloop van hot landhervormingsproces. In het vijfde hoofdstuk wordt bekeken welk resultaat de hervormingen op beperkte termijn gehad hebben in Zuid-Portugal en hoe de agrarische hervorming vanuit wisselend perspectief belicht kan worden. Tot slot wordt ten aanzien van het verdere verloop van het agrarische hervormingsproces kort. ingegaan jop een aantal recente ontwikkelingen in de portuges© politiek." ],
        [ sgpl:refersToConcept unesco:concept1730 ;
            sgpl:subjectText "Landbouwcollectieven" ;
            sgpl:text_context "Ook hierop was het. antwoord, van-de .arbeiders-controle en bezetting. Op grote schaal werd een groot aantal bedrijven opnieuw georganiseerd in de vorm van collectieven en coöperaties, die later ook zijn genationaliseerd. In Lissabon keert in het najaar 1975 het politieke tij." ],
        [ sgpl:refersToConcept unesco:concept1701 ;
            sgpl:subjectText "Agrarische hervorming" ;
            sgpl:text_context "In hot vierde hoofdstuk wordt beschreven welko agrarische hervormingen in Zuid-Portugal hebben plaatsgevonden, met het accent daarin op het verloop van hot landhervormingsproces. In het vijfde hoofdstuk wordt bekeken welk resultaat de hervormingen op beperkte termijn gehad hebben in Zuid-Portugal en hoe de agrarische hervorming vanuit wisselend perspectief belicht kan worden. Tot slot wordt ten aanzien van het verdere verloop van het agrarische hervormingsproces kort. ingegaan jop een aantal recente ontwikkelingen in de portuges© politiek." ],
        [ sgpl:refersToConcept unesco:concept1730 ;
            sgpl:subjectText "Landbouwcollectieven" ;
            sgpl:text_context "Ook hierop was het. antwoord, van-de .arbeiders-controle en bezetting. Op grote schaal werd een groot aantal bedrijven opnieuw georganiseerd in de vorm van collectieven en coöperaties, die later ook zijn genationaliseerd. In Lissabon keert in het najaar 1975 het politieke tij." ],
        [ sgpl:refersToConcept unesco:concept13162 ;
            sgpl:subjectText "Grootgrondbezit" ;
            sgpl:text_context "In het voorjaar 1975 vzerd daartoe overgegaan tot de bezetting van een aantal fabrieken en banken, die vervolgens werden genationaliseerd. In nagenoeg alle districten waar het grootgrondbezit sterk was vertegenwoordigd werden na 25 april 1574 direct vakbonden opgericht. Enkele daarvan wisten CAO’s af te dwingen, waarin met name het recht op vzerk werd vastgelegd." ] ;
    sgpl:thesisID 118 .

sgpl:Thesis119 a sgpl:SGPLThesis ;
    dcterms:creator "K.E. van der Wielen",
        "P.J.W.M. Mulders" ;
    dcterms:issued 1983 ;
    dcterms:title "Een historisch-geografisch onderzoek naar de ruimtelijke structuur van rurale nederzettingen in West-Suffolk, Engeland",
        "Typologie en genese van rurale nederzettingen in West-Suffolk" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Engeland" ;
            sgpl:text_context "Binnen deze studierichting is gekozen voor een onderzoek op regionaal niveau naar een deel van het landschap, namelijk de ruimtelijke structuur van rurale nederzettingen in West-Suffolk (Engeland). Teneinde informatie te verkrijgen over de genese van de nederzettingen is veldwerk verricht vanaf eind januari tot begin maart 1982. In deze periode is het merendeel van de tijd doorgebracht in het archief van Bury St Edmunds." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Landschappelijk gezien vertoont West-Suffolk enigszins gelijkenis met Drenthe. Ten derde is de ligging van het gebied ten opzichte van Nederland van belang gezien de bereikbaarheid in verband met het verzamelen van gegevens. West-Suffolk als geheel is als onderzoeksgebied te omvangrijk, zodat daarbinnen een nadere afbakening heeft plaatsgevonden op basis van de aanwezigheid van een verscheidenheid aan landschappen (paragraaf 2.1)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2645074 ;
            sgpl:spatialText "Lackford" ;
            sgpl:text_context "West-Suffolk als geheel is als onderzoeksgebied te omvangrijk, zodat daarbinnen een nadere afbakening heeft plaatsgevonden op basis van de aanwezigheid van een verscheidenheid aan landschappen (paragraaf 2.1). In overleg met DYMOND is uiteindelijk gekozen voor een aaneengesloten gebied, dat gelegen is binnen de hundreds Lackford, Thingoe en Babergh (Figuur 1.3 en 3.1). Tabel 3.1 Aantal nederzettingen en parishes per hundred." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:11609041 ;
            sgpl:spatialText "Norfolk" ;
            sgpl:text_context "4.15 Combinatie van kerk en Hall in Stanstead 88. 4.16 Verschuiving van de nederzetting (in de parish Longham, Norfolk) 91. 4.17 Mogelijke verschuiving van de bewoning van de kerk naar de green in Lackford 92." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2654186 ;
            sgpl:spatialText "Bury St Edmunds" ;
            sgpl:text_context "Teneinde informatie te verkrijgen over de genese van de nederzettingen is veldwerk verricht vanaf eind januari tot begin maart 1982. In deze periode is het merendeel van de tijd doorgebracht in het archief van Bury St Edmunds. Langs deze weg willen wij enkele mensen bedanken voor hun bijdrage aan de totstandkoming van dit onderzoek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2636561 ;
            sgpl:spatialText "West-Suffolk" ;
            sgpl:text_context "Binnen deze studierichting is gekozen voor een onderzoek op regionaal niveau naar een deel van het landschap, namelijk de ruimtelijke structuur van rurale nederzettingen in West-Suffolk (Engeland). Teneinde informatie te verkrijgen over de genese van de nederzettingen is veldwerk verricht vanaf eind januari tot begin maart 1982. In deze periode is het merendeel van de tijd doorgebracht in het archief van Bury St Edmunds." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756631 ;
            sgpl:spatialText "Drenthe" ;
            sgpl:text_context "Landschappelijk gezien vertoont West-Suffolk enigszins gelijkenis met Drenthe. Ten derde is de ligging van het gebied ten opzichte van Nederland van belang gezien de bereikbaarheid in verband met het verzamelen van gegevens. West-Suffolk als geheel is als onderzoeksgebied te omvangrijk, zodat daarbinnen een nadere afbakening heeft plaatsgevonden op basis van de aanwezigheid van een verscheidenheid aan landschappen (paragraaf 2.1)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Thingoe" ;
            sgpl:text_context "West-Suffolk als geheel is als onderzoeksgebied te omvangrijk, zodat daarbinnen een nadere afbakening heeft plaatsgevonden op basis van de aanwezigheid van een verscheidenheid aan landschappen (paragraaf 2.1). In overleg met DYMOND is uiteindelijk gekozen voor een aaneengesloten gebied, dat gelegen is binnen de hundreds Lackford, Thingoe en Babergh (Figuur 1.3 en 3.1). Tabel 3.1 Aantal nederzettingen en parishes per hundred." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2646302 ;
            sgpl:spatialText "Icklingham" ;
            sgpl:text_context "1.1 (a) Een lineaire nederzetting: Icklingham (b) Een eenvoudige rasternederzetting: Little Waldingfield. 1.2 Relaties tussen de elementen en de onderdelen van de ruimtelijke structuur van rurale nederzettingen. 1.3 Plaatsing van het onderzoeksgebied binnen een regionaal en een nationaal kader." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Geografisch Instituut Utrecht" ;
            sgpl:text_context "De algehele wetenschappelijke begeleiding van het onderzoek kwam voor rekening van J.D.H. Harten (hoofdmedewerker Geografisch Instituut Utrecht), waarvoor onze hartelijke dank. Lilianne Mulders Klaas van der Wielen Utrecht, mei 1983. Rijksuniversiteit Utrecht, Geografisch Instituut, Heidelberglaan 2, 3508 TC Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "De algehele wetenschappelijke begeleiding van het onderzoek kwam voor rekening van J.D.H. Harten (hoofdmedewerker Geografisch Instituut Utrecht), waarvoor onze hartelijke dank. Lilianne Mulders Klaas van der Wielen Utrecht, mei 1983. Rijksuniversiteit Utrecht, Geografisch Instituut, Heidelberglaan 2, 3508 TC Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Babergh" ;
            sgpl:text_context "West-Suffolk als geheel is als onderzoeksgebied te omvangrijk, zodat daarbinnen een nadere afbakening heeft plaatsgevonden op basis van de aanwezigheid van een verscheidenheid aan landschappen (paragraaf 2.1). In overleg met DYMOND is uiteindelijk gekozen voor een aaneengesloten gebied, dat gelegen is binnen de hundreds Lackford, Thingoe en Babergh (Figuur 1.3 en 3.1). Tabel 3.1 Aantal nederzettingen en parishes per hundred." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Nederzettingsstructuur" ;
            sgpl:text_context "De typologie van rurale nederzettingen is echter een momentopname. De genese van de nederzettingsstructuur speelt daarom een belangrijke rol bij het verklaren van de situatie in 1884. In elke nederzetting zijn in de loop van de tijd veranderingen opgetreden, die al dan niet hebben geleid tot veranderingen in de nederzettingsstructuur." ],
        [ sgpl:refersToConcept unesco:concept4129 ;
            sgpl:subjectText "Green" ;
            sgpl:text_context "Een belangrijk en opvallend onderdeel van de ruimtelijke structuur van rurale nederzettingen in West-Suffolk is de green: 'Greens ... are still a striking feature of the map of High Suffolk' (DYMOND 1968, p. 29). Een green kan worden omschreven als een open ruimte in de nederzetting, die gemeenschappelijk wordt gebruikt ten behoeve van sociale activiteiten en/of het weiden van vee (ROBERTS 1977a, p. 123). Naast de oorsprong en functie van de green wordt aandacht besteed aan de ruimtelijke kenmerken (vorm, omvang en ligging)." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Rurale nederzettingen" ;
            sgpl:text_context "In het bijzonder is er gekozen voor de nederzettingen in engere zin. Dit, omdat er in de laatste jaren een aantal nieuwe inzichten is ontwikkeld ten aanzien van het bestuderen van de ruimtelijke structuur van rurale nederzettingen (met name door UHLIG & LIENAU, RENES en ROBERTS). Aan andere aspecten van het cultuurlandschap zal geen aandacht worden besteed, aangezien de beschikbare tijd een beperkende factor is bij het verrichten van het onderzoek." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Rurale nederzettingen" ;
            sgpl:text_context "In het bijzonder is er gekozen voor de nederzettingen in engere zin. Dit, omdat er in de laatste jaren een aantal nieuwe inzichten is ontwikkeld ten aanzien van het bestuderen van de ruimtelijke structuur van rurale nederzettingen (met name door UHLIG & LIENAU, RENES en ROBERTS). Aan andere aspecten van het cultuurlandschap zal geen aandacht worden besteed, aangezien de beschikbare tijd een beperkende factor is bij het verrichten van het onderzoek." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Nederzettingsstructuur" ;
            sgpl:text_context "De typologie van rurale nederzettingen is echter een momentopname. De genese van de nederzettingsstructuur speelt daarom een belangrijke rol bij het verklaren van de situatie in 1884. In elke nederzetting zijn in de loop van de tijd veranderingen opgetreden, die al dan niet hebben geleid tot veranderingen in de nederzettingsstructuur." ],
        [ sgpl:refersToConcept unesco:concept4129 ;
            sgpl:subjectText "Green" ;
            sgpl:text_context "Een belangrijk en opvallend onderdeel van de ruimtelijke structuur van rurale nederzettingen in West-Suffolk is de green: 'Greens ... are still a striking feature of the map of High Suffolk' (DYMOND 1968, p. 29). Een green kan worden omschreven als een open ruimte in de nederzetting, die gemeenschappelijk wordt gebruikt ten behoeve van sociale activiteiten en/of het weiden van vee (ROBERTS 1977a, p. 123). Naast de oorsprong en functie van de green wordt aandacht besteed aan de ruimtelijke kenmerken (vorm, omvang en ligging)." ] ;
    sgpl:thesisID 119 .

sgpl:Thesis120 a sgpl:SGPLThesis ;
    dcterms:creator "Marion van der Plas",
        "Renske van Vliet" ;
    dcterms:issued 1983 ;
    dcterms:title "OVER VERBETERING EN BELEID",
        "een analyse van de verbetering van vooroorlogse woningwetkomplexen door toegelaten instellingen in Amsterdam" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Amsterdam-Noord" ;
            sgpl:text_context "3.2.4. Komplex Buiksloterham van Woningstichting Zomers Buiten. Amsterdam-Noord wordt door het IJ gescheiden van de rest van de stad. Ondanks de brugverbinding, de twee pontverbindingen en de beide tunnels, is er sprake van een nog steeds min of meer geïsoleerde ligging van het stadsdeel ten opzichte van de rest van Amsterdam." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744976 ;
            sgpl:spatialText "gemeente Watergraafsmeer" ;
            sgpl:text_context "Betondorp is oorspronkelijk ontworpen als uitbreiding van de gemeente Watergraafsmeer. Het was de bedoeling dat het zou dienen om Amsterdammers op te vangen. Na de annexatie in 1921 nam Amsterdam ook de uitbreidingsplannen van de gemeente Watergraafsmeer over, waaronder het Uitbreidingsplan Betondorp, dat als een tuindorp ontworpen was." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7303019 ;
            sgpl:spatialText "Buiksloterham" ;
            sgpl:text_context "Op basis van een aantal elkaar opvolgende plannen - onder andere het plan Tellegen (1914), het plan Keppler (1926) en het Algemeen Uitbreidingsplan (1934) - wordt aan de noordkant van het IJ gebouwd. Zo ontstond de wijk Buiksloterham, gelegen tussen de drukke uitvalsweg richting Oostzaan en het Florapark. Hierbinnen ligt een komplex van 581 woningen, eigendom van de Woningstichting Zomers Buiten, dat de Heliotroopstraat als as kent (zie figuur 3.5, volgende pagina)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "VERSLAGEN VAN LEERONDERZOEK SGS vakgroep sociale geografie van de stedelijk-industriële landen. Transitorium II, Heidelberglaan 2, De Uithof, Utrecht (030)532044. INHOUD Pag." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De omvang van de sociale woningbouw. In figuur 1.1 is te zien dat in de jaren twintig en dertig de partikuliere woningbouw profiteert van de lage bouwprijzen en hoge huren en de overheid de woning- wetbouw minimaliseert, terwijl het omgekeerde juist gebeurt ten tijde van de eerste wereldoorlog en vlak daarna. Figuur 1.1 Nederlandse woningproduktie, onderscheiden naar sektoren, 1902-1945." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "De rond 1920 bestaande woningnood en de sterke bouwkostenstijging noopten namelijk tot een bezuiniging op de bouwtechniek. Slechts in Amsterdam, Rotterdam en Den Haag zijn v33r 1940 meergezinshuizen in het kader van de Woningwet tot stand gebracht. Het betreft hier grotendeels drie of vier bouwlagen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Westelijke Eilanden" ;
            sgpl:text_context "Toch was de woningnood nog zo groot dat men in 1934 het A.U.P. (Algemeen Uitbreidings Plan) lanceerde. De na-oorlogse uitbreidingspannen (Westelijke Eilanden) zijn gebouwd op basis van dit A.U.P. Zij hadden enerzijds een grote aantrekkingskracht op jonge gezinnen met kinderen (er is veel groen, vrijwel alle faciliteiten zijn aanwezig), anderzijds waren het verzamelplaatsen van mensen die, op deze of gene wijze gedwongen, uit de stad waren verdrongen (JOBSE, 1980, p. 63)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Spaarndammerbuurt" ;
            sgpl:text_context "In de Spaarndammerbuurt zijn.-tussen 1910 en 1930 bijna 4000 woningen gebouwd, vooral door de gemeente en woningbouwkorporaties (VAN DE BURGWAL & KUIN, 1977, p. 19). Voor die tijd was deze arbeiderswijk modern, maar aan de huidige normen (douche, keuken e.d.) werd niet voldaan. Verbetering was noodzakelijk, ook vanwege de bouwtechnische staat van de woningen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Verder hebben we gekozen voor Amsterdam als plaats van onderzoek. Dit omdat het een grote stad is waar nogal wat stadsvernieuwing- saktiviteiten plaatsvinden en vanuit de meer pragmatische reden dat het vanuit Utrecht voor ons gemakkelijk met het openbaar vervoer te bereiken is. Uit deze overwegingen kwam de volgende. - voorlopige - probleemstelling naar voren:" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "stad Amsterdam" ;
            sgpl:text_context "Het eerste hoofdstuk is te zien als een terreinverkenning. Er wordt een beeld geschetst van de ontwikkelingen die zich de laatste eeuw op het gebied van de stadsvernieuwing hebben voorgedaan, van het ontstaan en de taken van toegelaten instellingen en van de ontwikkelingen in de volkshuisvesting en stadsvernieuwing in de stad Amsterdam. Verder worden in dat hoofdstuk de algemene kenmerken van vooroorlogse woningwetgebieden besproken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "R.U.U." ;
            sgpl:text_context "Het voor u liggende rapport is het verslag van een doktoraal- leeronderzoek binnen de vakgroep sociale geografie van de stedelijk-industriële landen van het geografisch instituut van de R.U.U. Het handelt over het beleid van toegelaten instellingen bij de verbetering van vooroorlogse woningwet- komplexen en de daarmee samenhangende gevolgen. Uit kostenoverwegingen konden de bij dit verslag behorende bijlagen helaas niet in het rapport worden opgenomen, maar voor de geïnteresseerde zijn ze op het geografisch instituut beschikbaar." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7648383 ;
            sgpl:spatialText "Oud-Zuid" ;
            sgpl:text_context "Vlietstraat Oud-Zuid Woningstichting Patrimonium 1914 1979 216 198. Buiksloterham Oud-Noord Woningstichting Zomers Buiten 1925-28 1980 581 513. 3.3 Beschrijving van de verschillende tpegelaten instellingen 27." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Wij hebben besloten om vernieuwde komplexen met elkaar te vergelijken die onder beheer staan van verschillende toegelaten instellingen. Verder hebben we gekozen voor Amsterdam als plaats van onderzoek. Dit omdat het een grote stad is waar nogal wat stadsvernieuwing- saktiviteiten plaatsvinden en vanuit de meer pragmatische reden dat het vanuit Utrecht voor ons gemakkelijk met het openbaar vervoer te bereiken is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "De rond 1920 bestaande woningnood en de sterke bouwkostenstijging noopten namelijk tot een bezuiniging op de bouwtechniek. Slechts in Amsterdam, Rotterdam en Den Haag zijn v33r 1940 meergezinshuizen in het kader van de Woningwet tot stand gebracht. Het betreft hier grotendeels drie of vier bouwlagen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Betondorp" ;
            sgpl:text_context "Betondorp is oorspronkelijk ontworpen als uitbreiding van de gemeente Watergraafsmeer. Het was de bedoeling dat het zou dienen om Amsterdammers op te vangen. Na de annexatie in 1921 nam Amsterdam ook de uitbreidingsplannen van de gemeente Watergraafsmeer over, waaronder het Uitbreidingsplan Betondorp, dat als een tuindorp ontworpen was." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "woningverbetering" ;
            sgpl:text_context "Het grootste verschil is dat we ons toespitsen op verbetering. Bovendien hebben we het begrip beheer vervangen door (verbeterings)beleid, aangezien het beheren van woningen veel facetten omvat die niet met woningverbetering te maken hebben. Beleid is echter niet iets dat op een bepaald moment gebeurt, maar een dynamisch begrip." ],
        [ sgpl:refersToConcept unesco:concept673 ;
            sgpl:subjectText "toegelaten instellingen" ;
            sgpl:text_context "Dat zijn gebieden die onder beheer staan van toegelaten instellingen (woningbouwkorporaties). Wij hebben besloten om vernieuwde komplexen met elkaar te vergelijken die onder beheer staan van verschillende toegelaten instellingen. Dit vanuit de gedachte dat elke toegelaten instelling waarschijnlijk weer een andere aanpak zal hebben, wat van invloed is op het verloop van het vernieuwingsproces en op de direkte gevolgen daarvan." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Al bij het schrijven van het theoretisch kader bleek, dat wij er niet omheen zouden kunnen expliciet het verbeteringsbeleid van toegelaten instellingen bij ons onderzoek te betrekken. Bovendien werd ons duidelijk dat het begrip stadsvernieuwing te breed was gekozen; de verschillen tussen de gevolgen bij verschillende soorten stadsvernieuwing zijn evident. Daarom besloten we om het onderzoek toe te spitsen op verbetering, een ingreep waarop in de jaren '70 - de periode waarop ons onderzoek voornamelijk betrekking heeft - het aksent lag." ],
        [ sgpl:refersToConcept unesco:concept673 ;
            sgpl:subjectText "toegelaten instellingen" ;
            sgpl:text_context "Dat zijn gebieden die onder beheer staan van toegelaten instellingen (woningbouwkorporaties). Wij hebben besloten om vernieuwde komplexen met elkaar te vergelijken die onder beheer staan van verschillende toegelaten instellingen. Dit vanuit de gedachte dat elke toegelaten instelling waarschijnlijk weer een andere aanpak zal hebben, wat van invloed is op het verloop van het vernieuwingsproces en op de direkte gevolgen daarvan." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "woningverbetering" ;
            sgpl:text_context "Het grootste verschil is dat we ons toespitsen op verbetering. Bovendien hebben we het begrip beheer vervangen door (verbeterings)beleid, aangezien het beheren van woningen veel facetten omvat die niet met woningverbetering te maken hebben. Beleid is echter niet iets dat op een bepaald moment gebeurt, maar een dynamisch begrip." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Al bij het schrijven van het theoretisch kader bleek, dat wij er niet omheen zouden kunnen expliciet het verbeteringsbeleid van toegelaten instellingen bij ons onderzoek te betrekken. Bovendien werd ons duidelijk dat het begrip stadsvernieuwing te breed was gekozen; de verschillen tussen de gevolgen bij verschillende soorten stadsvernieuwing zijn evident. Daarom besloten we om het onderzoek toe te spitsen op verbetering, een ingreep waarop in de jaren '70 - de periode waarop ons onderzoek voornamelijk betrekking heeft - het aksent lag." ] ;
    sgpl:thesisID 120 .

sgpl:Thesis121 a sgpl:SGPLThesis ;
    dcterms:creator "Hijmen Valkenburg",
        "Jos Rikers" ;
    dcterms:issued 1983 ;
    dcterms:title "BEWONERSBELANGEN EN RECREANTENBELANGEN : EEN RUIMTELIJK CONFLICT ?",
        "Een onderzoek naar de houding van de bewoners ten aanzien van een watersportfunctie van hun dorp, in twee dorpen (Hemelum en Heeg) in het Friese Merengebied." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Het door ons verrichtte onderzoek maakte deel uit van het Zuidwest Friesland project, opgezet door het Geografisch Instituut van de Rijksuniversiteit te Utrecht. Daarbij voldoet Zuidwest Friesland aan de criteria, die gelden voor perifeer gelegen landelijke gebieden (Projectkader, Bemmel, e.a., 1979, p.12). Om de hoofdprobleemstelling van het Zuidwest Friesland project te kunnen bestuderen, is een opsplitsing in deelonderzoeksthema's gemaakt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747063 ;
            sgpl:spatialText "Sneek" ;
            sgpl:text_context "Heeg is het grootste dorp van de gemeente Wymbritseradeel en telt zo’n 1700 inwoners. Een van de meest opvallende kenmerken van de gemeente Wymbritseradeel is het ontbreken van een hoofddorp. Het gemeentehuis staat dan ook in de gemeente Sneek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754428 ;
            sgpl:spatialText "het maanlandschap" ;
            sgpl:text_context "Een kleiner plan voor het gebied dat de Hemelumers als \"het maanlandschap\" aanduiden, stuitte ook op weerstand, omdat het recreatiewoningen en een jachthaven omvat. Consequentie van dit plan zou zijn dat de goedkope ligplaatsen van de bevolking zouden moeten wijken. Wordt in de plannen echter rekening gehouden met de belangen van de bewoners, dan zal de weerstand zeker afnemen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "Hijmen Valkenburg. Jos Rikers. 1983. VERSLAGEN VAN LEERONDERZOEK SGS. vakgroep sociale geografie i van de stedelijk-industriële landen BU Transitorium II, Heidelberglaan 2 De Uithof, Utrecht (030)532044." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754712 ;
            sgpl:spatialText "Heeg" ;
            sgpl:text_context "Tijdens de verschillende fasen van het onderzoek kregen wij vele bruikbare adviezen van de stafleden van de vakgroep S.G.S., die wij hierbij willen bedanken voor hun behulpzaamheid. Onze speciale dank gaat uit naar de bewoners van Hemelum, Heeg en Uitwellingerga, die aan het onderzoek hun medewerking verleenden. Verder danken wij allen, die ons bij het realiseren van dit onderzoeksrapport tot steun zijn geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Gemeente Wymbritseradeel" ;
            sgpl:text_context "Heeg is het grootste dorp van de gemeente Wymbritseradeel en telt zo’n 1700 inwoners. Een van de meest opvallende kenmerken van de gemeente Wymbritseradeel is het ontbreken van een hoofddorp. Het gemeentehuis staat dan ook in de gemeente Sneek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745960 ;
            sgpl:spatialText "Uitwellingerga" ;
            sgpl:text_context "Tijdens de verschillende fasen van het onderzoek kregen wij vele bruikbare adviezen van de stafleden van de vakgroep S.G.S., die wij hierbij willen bedanken voor hun behulpzaamheid. Onze speciale dank gaat uit naar de bewoners van Hemelum, Heeg en Uitwellingerga, die aan het onderzoek hun medewerking verleenden. Verder danken wij allen, die ons bij het realiseren van dit onderzoeksrapport tot steun zijn geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755786 ;
            sgpl:spatialText "Gaasterland" ;
            sgpl:text_context "Het dorp Hemelum (gemeente Hemelumer Oldeferd) telt ongeveer 550 inwoners. Het is gelegen op een van de uitlopers van de zandruggen van Gaasterland. Het dorp ligt aan de Morra en heeft zo een verbinding met alle Friese watersportgebieden en bovendien ligt het dorp gunstig voor recreanten, die zich meer op de Gaasterlandse bossen richten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Gemeente Hemelumer Oldeferd" ;
            sgpl:text_context "Het dorp Hemelum (gemeente Hemelumer Oldeferd) telt ongeveer 550 inwoners. Het is gelegen op een van de uitlopers van de zandruggen van Gaasterland. Het dorp ligt aan de Morra en heeft zo een verbinding met alle Friese watersportgebieden en bovendien ligt het dorp gunstig voor recreanten, die zich meer op de Gaasterlandse bossen richten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In Nederland is enig onderzoek verricht naar de waardering van de bevolking ten aanzien van de recreatieve ontwikkelingen in hun woongebied. Case-studies door onderzoekers van verschillende pluimage zijn o.a. gehouden in toeristenplaatsen als Borger (Drenthe), Bruinisse (Zeeland), Thora (Limburg), Oudega, Terhorne en Woudsend (Friesland). Bij de recreatiedorpen, die al zeer lang geconfronteerd worden met een recreatieve ontwikkeling, blijken de drie verschillende fasen zelfs te onderscheiden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754428 ;
            sgpl:spatialText "Hemelum" ;
            sgpl:text_context "Tijdens de verschillende fasen van het onderzoek kregen wij vele bruikbare adviezen van de stafleden van de vakgroep S.G.S., die wij hierbij willen bedanken voor hun behulpzaamheid. Onze speciale dank gaat uit naar de bewoners van Hemelum, Heeg en Uitwellingerga, die aan het onderzoek hun medewerking verleenden. Verder danken wij allen, die ons bij het realiseren van dit onderzoeksrapport tot steun zijn geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "het Friese Merengebied" ;
            sgpl:text_context "Via gesprekken met medewerkers van de P.P.D. te Leeuwarden en de Welzijnsstichting Sudergoa te Sneek, eigen ervaringen in het onderzoeksgebied (zeilvakanties) en het verzamelen van achtergrondinformatie van de dorpen, is gekozen voor een onderzoek in de dorpen Hemelum en Heeg. Hemelum kozen we als dorp, dat op het eerste gezicht in de eerste fase verkeerd en Heeg, als watersportplaats bij uitstek in het Merengebied van Zuidwest Friesland, als dorp dat de derde fase van recreatieve ontwikkeling heeft bereikt. De verschillen in de houding van de plaatselijke bevolking ten aanzien van de watersport zouden zo het beste naar voren komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Zuidwest Friesland" ;
            sgpl:text_context "Het door ons verrichtte onderzoek maakte deel uit van het Zuidwest Friesland project, opgezet door het Geografisch Instituut van de Rijksuniversiteit te Utrecht. Daarbij voldoet Zuidwest Friesland aan de criteria, die gelden voor perifeer gelegen landelijke gebieden (Projectkader, Bemmel, e.a., 1979, p.12). Om de hoofdprobleemstelling van het Zuidwest Friesland project te kunnen bestuderen, is een opsplitsing in deelonderzoeksthema's gemaakt." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept367 ;
            sgpl:subjectText "Openluchtrecreatie" ;
            sgpl:text_context "Bovendien ligt de nadruk in dit rapport meer op de ruimtelijke componenten van het begrip openluchtrecreatie, dan op de gedragselementen van de recreanten. De term openluchtrecreatie wordt met name door de verschillende overheden in hun plannen, schema's en schetsen gebruikt. In het Structuurschema Openluchtrecreatie (1981, p.15) definieert zij deze term als volgt: 'Die bezigheden, die ontspanning en zelfontplooiing als hoofddoel hebben, uit vrije keuze worden verricht en plaatsvinden in de openlucht'." ],
        [ sgpl:refersToConcept unesco:concept2670 ;
            sgpl:subjectText "Ruimtelijk conflict" ;
            sgpl:text_context "Bovendien ligt de nadruk in dit rapport meer op de ruimtelijke componenten van het begrip openluchtrecreatie, dan op de gedragselementen van de recreanten. Een ander centraal begrip in dit onderzoeksverslag is het ruimtelijk conflict. Dit definiëren we als volgt: 'Het toekennen van verschillende positionele waarden, door individuen of groepen op grond van allerlei (sociaal-economische en/of sociaal-culturele) normen, aan één en dezelfde positie'." ],
        [ sgpl:refersToConcept unesco:concept357 ;
            sgpl:subjectText "Fasentheorie" ;
            sgpl:text_context "Heeg in de derde fase van recreatieve ontwikkeling verkeert. De fasentheorie haar bruikbaarheid zal tonen bij het voorspellen van de houding van de bewoners ten aanzien van een recreatieve ontwikkeling van hun woongebied. 3. RUIMTELIJKE CONFLICTEN TUSSEN BEWONERSBELANGEN EN RECREANTENBELANGEN ALS GEVOLG VAN BESTAANDE BESTEMMINGEN VOOR DE WATERSPORT." ],
        [ sgpl:refersToConcept unesco:concept357 ;
            sgpl:subjectText "Fasentheorie" ;
            sgpl:text_context "Heeg in de derde fase van recreatieve ontwikkeling verkeert. De fasentheorie haar bruikbaarheid zal tonen bij het voorspellen van de houding van de bewoners ten aanzien van een recreatieve ontwikkeling van hun woongebied. 3. RUIMTELIJKE CONFLICTEN TUSSEN BEWONERSBELANGEN EN RECREANTENBELANGEN ALS GEVOLG VAN BESTAANDE BESTEMMINGEN VOOR DE WATERSPORT." ],
        [ sgpl:refersToConcept unesco:concept367 ;
            sgpl:subjectText "Openluchtrecreatie" ;
            sgpl:text_context "Bovendien ligt de nadruk in dit rapport meer op de ruimtelijke componenten van het begrip openluchtrecreatie, dan op de gedragselementen van de recreanten. De term openluchtrecreatie wordt met name door de verschillende overheden in hun plannen, schema's en schetsen gebruikt. In het Structuurschema Openluchtrecreatie (1981, p.15) definieert zij deze term als volgt: 'Die bezigheden, die ontspanning en zelfontplooiing als hoofddoel hebben, uit vrije keuze worden verricht en plaatsvinden in de openlucht'." ],
        [ sgpl:refersToConcept unesco:concept2670 ;
            sgpl:subjectText "Ruimtelijk conflict" ;
            sgpl:text_context "Bovendien ligt de nadruk in dit rapport meer op de ruimtelijke componenten van het begrip openluchtrecreatie, dan op de gedragselementen van de recreanten. Een ander centraal begrip in dit onderzoeksverslag is het ruimtelijk conflict. Dit definiëren we als volgt: 'Het toekennen van verschillende positionele waarden, door individuen of groepen op grond van allerlei (sociaal-economische en/of sociaal-culturele) normen, aan één en dezelfde positie'." ] ;
    sgpl:thesisID 121 .

sgpl:Thesis122 a sgpl:SGPLThesis ;
    dcterms:creator "Moniek Schr&#246;der" ;
    dcterms:issued 1983 ;
    dcterms:title "Swedish corporations Corporate strategy and Locational choice",
        "ZWEEDSE INDUSTRIËLE ONDERNEMINGEN: Ondernemingsstrategie en Lokatiekeuze" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "s-Gravenhage" ;
            sgpl:text_context "Voor u ligt thans deel I van het project. De heer A. Troive van de Zweedse Handelsdelegatie te 's-Gravenhage, de heer R. Waardenburg, de heer E.F. Herbschleb en de heer E.B. Dupont dank ik allen zeer voor hun bereidwillige hulp bij de organisatie en realisatie van het veldwerk. Tot slot moet een woord van dank worden uitgesproken aan de heer N.F. Abcouwer en de heer M. de Smidt voor hun prettige en stimulerende begeleiding en aan Robert voor zijn geduld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "Aan deze criteria wordt door 235 bedrijven voldaan. Gezamenlijk hebben deze 235 bedrijven 1825 vestigingen in West-Europa. De nevenvestigingen, gemiddeld 7,76 per bedrijf, zijn veelal verdeeld over een aantal landen (zie tabel 3.7.)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "West-Duitsland" ;
            sgpl:text_context "De meeste bedrijven zullen hun dochteronderneming in West-Duitsland een grotere zelfstandigheid verlenen dan hun dochter in Nederland. Echter in het V.K. nog minder. Dit gezien de omvang van de markt, de aanwezige kennis en kapitaal en aard van de dochteronderneming." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Noord-Nederland" ;
            sgpl:text_context "Van de bezochte bedrijven hadden alle een of meerdere produktievestigingen in West-Europa, elf hiervan produceren ook in Nederland. Een rubberbedrijf was in Nederland begonnen met produktie omdat men binnen de EEG een produktievestiging wenste en in Noord-Nederland investeringspremies werden verleend (er werd wel kritiek geuit omdat de hulp van de kant van de Nederlandse overheid zich daartoe had beperkt, en verder geen begeleiding of hulp was verstrekt). Een automobielbedrijf (Saab) is met assemblage in Nederland gestart om binnen de EEG gevestigd te zijn (jaren zeventig)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof, Utrecht" ;
            sgpl:text_context "aaa vakgroep sociale geografie ÊA van de stedelijk-industriële landen. Transitorium II, Heidelberglaan2, De Uithof, Utrecht (030)532044. Z ZWEEDSE INDUSTRIËLE ONDERNEMINGEN: Ondernemingsstrategie en Lokatiekeuze." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2661886 ;
            sgpl:spatialText "Zweden" ;
            sgpl:text_context "De historie van de Zweedse economie leert dat Zweden in toenemende mate afhankelijk is geraakt van het buitenland om haar economie in stand te houden. Reeds voor de eeuwwisseling waren er produktievestigingen van Zweedse industriële ondernemingen in het buitenland. De eerste vestigingen waren voornamelijk gesitueerd in de buurlanden van Zweden, Noorwegen, Denemarken en Finland, maar ook in landen op niet te grote afstand van Zweden als West-Duitsland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdamse stadsgewest" ;
            sgpl:text_context "VOORWOORD. Als vervolg op het onderzoek van Loeve en De Vries (1982) naar buitenlandse bedrijven in het Amsterdamse stadsgewest en naar Japanse ondernemingen in Nederland heeft de Rijksdienst voor de IJsselmeerpolders het Geografisch Instituut van de Rijksuniversiteit Utrecht gevraagd een onderzoek te verrichten naar Zweedse ondernemingen in Nederland. In tegenstelling tot de Japanse ondernemingen welke zich met een vrij agressieve handelspolitiek vanaf het eind van de zestiger jaren in Nederland zijn gaan vestigen, dateren de eerste dochterondernemingen van Zweedse bedrijven in Nederland van voor W.O. II." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2722708 ;
            sgpl:spatialText "Bergslagendistrict" ;
            sgpl:text_context "Dit ook ondanks het feit dat Zweden een traditie van ijzerproduktie kende: in de 18e eeuw was zij voor 40% van de wereldproduktie verantwoordelijk. In Zweden zijn grote voorraden aanwezig van ijzererts rond het Bergslagendistrict, in Kiruna en Malmberget in Lapland (Fig.2.2.), en hout (meer dan 50% van het landoppervlakte is bedekt met bos, dat is 450.000 km2), terwijl dankzij de aanwezigheid van rivieren en meertjes op grote schaal hydro-etectricite'it kan worden opgewekt. Men kon, nadat de staat in 1856 met de aanleg van een spoorwegnet was begonnen, het transport van de winningplaats naar de havens, Narvik in Noorwegen en Lule&, sneller en goedkoper doen plaatsvinden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Lapland" ;
            sgpl:text_context "Dit ook ondanks het feit dat Zweden een traditie van ijzerproduktie kende: in de 18e eeuw was zij voor 40% van de wereldproduktie verantwoordelijk. In Zweden zijn grote voorraden aanwezig van ijzererts rond het Bergslagendistrict, in Kiruna en Malmberget in Lapland (Fig.2.2.), en hout (meer dan 50% van het landoppervlakte is bedekt met bos, dat is 450.000 km2), terwijl dankzij de aanwezigheid van rivieren en meertjes op grote schaal hydro-etectricite'it kan worden opgewekt. Men kon, nadat de staat in 1856 met de aanleg van een spoorwegnet was begonnen, het transport van de winningplaats naar de havens, Narvik in Noorwegen en Lule&, sneller en goedkoper doen plaatsvinden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Als vervolg op het onderzoek van Loeve en De Vries (1982) naar buitenlandse bedrijven in het Amsterdamse stadsgewest en naar Japanse ondernemingen in Nederland heeft de Rijksdienst voor de IJsselmeerpolders het Geografisch Instituut van de Rijksuniversiteit Utrecht gevraagd een onderzoek te verrichten naar Zweedse ondernemingen in Nederland. In tegenstelling tot de Japanse ondernemingen welke zich met een vrij agressieve handelspolitiek vanaf het eind van de zestiger jaren in Nederland zijn gaan vestigen, dateren de eerste dochterondernemingen van Zweedse bedrijven in Nederland van voor W.O. II. Dit heeft mede tot gevolg dat nu een veel groter aantal Zweedse ondernemingen niet alleen in Nederland is vertegenwoordigd, maar ook een groter deel van hun activiteiten in Nederland laat plaatsvinden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "Ondernemingsstrategie" ;
            sgpl:text_context "In het recente verleden is de perceptie van de ondernemer in het onderzoek betrokken. Momenteel staat ook de besluitvorming tijdens het locatiekeuze-proces in de aandacht: op welk niveau binnen de hiërarchie worden welke beslissingen genomen, wie beslist wat, welke (externe) informatiebronnen worden aangeboord, wat is het verband met de ondernemingsstrategie? In de onderhavige studie is gekozen voor een gedachtengang vanuit de Zweedse ondernemer." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Locatiekeuze" ;
            sgpl:text_context "In de onderhavige studie is gekozen voor een gedachtengang vanuit de Zweedse ondernemer. Als hij heeft besloten tot produktie in het buitenland over te gaan, hoe vindt dan het locatiekeuze-proces plaats? Wat is de plaats van Nederland als potentieel vestigingsland in zijn buitenlandse oriëntatie?" ],
        [ sgpl:refersToConcept unesco:concept11040 ;
            sgpl:subjectText "Directe investeringen" ;
            sgpl:text_context "De historie van de Zweedse economie leert dat Zweden in toenemende mate afhankelijk is geraakt van het buitenland om haar economie in stand te houden. Deze buitenlandse afhankelijkheid uit zich in: 1. de grote rol van de export; 2. de directe investeringen in het buitenland. Reeds voor de eeuwwisseling waren er produktievestigingen van Zweedse industriële ondernemingen in het buitenland." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "Ondernemingsstrategie" ;
            sgpl:text_context "In het recente verleden is de perceptie van de ondernemer in het onderzoek betrokken. Momenteel staat ook de besluitvorming tijdens het locatiekeuze-proces in de aandacht: op welk niveau binnen de hiërarchie worden welke beslissingen genomen, wie beslist wat, welke (externe) informatiebronnen worden aangeboord, wat is het verband met de ondernemingsstrategie? In de onderhavige studie is gekozen voor een gedachtengang vanuit de Zweedse ondernemer." ],
        [ sgpl:refersToConcept unesco:concept11040 ;
            sgpl:subjectText "Directe investeringen" ;
            sgpl:text_context "De historie van de Zweedse economie leert dat Zweden in toenemende mate afhankelijk is geraakt van het buitenland om haar economie in stand te houden. Deze buitenlandse afhankelijkheid uit zich in: 1. de grote rol van de export; 2. de directe investeringen in het buitenland. Reeds voor de eeuwwisseling waren er produktievestigingen van Zweedse industriële ondernemingen in het buitenland." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Locatiekeuze" ;
            sgpl:text_context "In de onderhavige studie is gekozen voor een gedachtengang vanuit de Zweedse ondernemer. Als hij heeft besloten tot produktie in het buitenland over te gaan, hoe vindt dan het locatiekeuze-proces plaats? Wat is de plaats van Nederland als potentieel vestigingsland in zijn buitenlandse oriëntatie?" ] ;
    sgpl:thesisID 122 .

sgpl:Thesis123 a sgpl:SGPLThesis ;
    dcterms:creator "F.J. van Woudenberg" ;
    dcterms:issued 1983 ;
    dcterms:title "Een historisch geografisch onderzoek naar het ontstaan en de ontwikkeling van de stedelijke nederzettingen Tholen en Sint Maartensdijk",
        "VAN TOL TOT THOLEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744011 ;
            sgpl:spatialText "Zeeland" ;
            sgpl:text_context "Het doel hiervan was te komen tot een rapport, waarin het ontstaan en de ontwikkeling van de stedelijke nederzettingen Tholen en Sint Maartensdijk (Zeeland) belicht worden. Deze steden staan in de nota \" Herinventarisatie van stads- en dorpsgezichten \" (1980) als \" beschermenswaardig \" genoemd. De onderzoeksresultaten zullen derhalve door de Rijksdienst voor de Monumentenzorg gebruikt worden voor het opstellen van de \" Toelichting op het voorstel van aanwijzing tot beschermd stadsgezicht \"." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Brabant" ;
            sgpl:text_context "In 1212 komt de naam Schakerloo voor het eerst in een archiefstuk voor. De naam wordt in verband gebracht met de tol op de Striene (zie hoofdstuk 4), die de grensrivier vormde tussen Zeeland en Brabant. Schakerloo hoorde toen bij Brabant." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743977 ;
            sgpl:spatialText "Zeist" ;
            sgpl:text_context "Het doel van het onderzoek was het vervaardigen van een rapport, waarin het ontstaan en de genese van de steden Tholen en Sint Maartensdijk in Zeeland behandeld worden. De Rijksdienst voor de Monumentenzorg te Zeist, waar ik voor een periode van drie maanden stage heb gelopen, wil deze skriptie gebruiken bij de voorbereidingen die moeten leiden tot een aanwijzing tot beschermd stadsgezicht. Bij de totstandkoming van deze skriptie zijn velen mij tot steun geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Schakerloo" ;
            sgpl:text_context "In 1212 komt de naam Schakerloo voor het eerst in een archiefstuk voor. De naam wordt in verband gebracht met de tol op de Striene (zie hoofdstuk 4), die de grensrivier vormde tussen Zeeland en Brabant. Schakerloo hoorde toen bij Brabant." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Dit onderzoek werd verricht voor het hoofdvak Historische Geografie aan het Geografisch Instituut van de Rijksuniversiteit te Utrecht. Het doel van het onderzoek was het vervaardigen van een rapport, waarin het ontstaan en de genese van de steden Tholen en Sint Maartensdijk in Zeeland behandeld worden. De Rijksdienst voor de Monumentenzorg te Zeist, waar ik voor een periode van drie maanden stage heb gelopen, wil deze skriptie gebruiken bij de voorbereidingen die moeten leiden tot een aanwijzing tot beschermd stadsgezicht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748498 ;
            sgpl:spatialText "Poortvliet" ;
            sgpl:text_context "Ten oosten van de lijn Sint Annaland - Poortvliet zijn naast elkaar diepe en ondiepe plekken aangetroffen. Dit zijn waarschijnlijk kreekgronden. Veen, bovenop de oude zeeklei gevormd, is vrijwel overal in de ondergrond aanwezig." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746351 ;
            sgpl:spatialText "Tholen" ;
            sgpl:text_context "Dit verslag vormt de neerslag van een onderzoek dat verricht is in opdracht van de Rijksdienst voor de Monumentenzorg. Het doel hiervan was te komen tot een rapport, waarin het ontstaan en de ontwikkeling van de stedelijke nederzettingen Tholen en Sint Maartensdijk (Zeeland) belicht worden. Deze steden staan in de nota \" Herinventarisatie van stads- en dorpsgezichten \" (1980) als \" beschermenswaardig \" genoemd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747241 ;
            sgpl:spatialText "Sint Maartensdijk" ;
            sgpl:text_context "Voor de ontwikkeling van Tholen en Sint Maartensdijk is vooral de periode van de 13e eeuw tot het begin van de 17e eeuw van belang. Dit tijdvak, grofweg de late middeleeuwen en de overgang naar de Nieuwe Tijd, is voor de meeste Nederlandse steden - en zo ook voor Tholen en Sint Maartensdijk -, voor zover het de historische ruimtelijke ontwikkeling aangaat, de belangrijkste. Derhalve zullen relevante aspekten, die buiten dit tijdsbestek vallen, slechts summier worden behandeld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746351 ;
            sgpl:spatialText "gemeente Tholen" ;
            sgpl:text_context "Bij de totstandkoming van deze skriptie zijn velen mij tot steun geweest. Allereerst wil ik de gemeentearchivaris van de gemeente Tholen, de heer J.P.B. Zuurdeeg hartelijk danken. Zonder zijn hulp zouden vele gegevens uit het archief onbenut zijn gebleven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746351 ;
            sgpl:spatialText "eiland Tholen" ;
            sgpl:text_context "Derhalve komen, alvorens in te gaan op de ruimtelijke neerslag van Tholen en Sint Maartensdijk (hoofdstuk 5), de volgende aspekten aan de orde: de fysische genese van het eiland Tholen, waarbij nader ingegaan wordt op de waterschappen waarin de plaatsen liggen (hoofdstuk 2); de politieke aspekten die in Zeeland en met name in Tholen en Sint Maartensdijk van belang waren (hoofdstuk 3) en de ekonomische ontplooiing van de mens die van invloed is geweest op de stadsontwikkeling (hoofdstuk 4). Bij de bestudering van de genoemde nederzettingen is naast de bestaande literatuur veelvuldig gebruik gemaakt van historische kaartmateriaal. Door verschillende kaarten naast elkaar te leggen en te vergelijken ontstaat een beeld van de ruimtelijke ontwikkelingen, die zich in een stad voordoen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11417 ;
            sgpl:subjectText "historische geografie" ;
            sgpl:text_context "De voor u liggende skriptie is het resultaat van mijn doktoraal leeronderzoek. Dit onderzoek werd verricht voor het hoofdvak Historische Geografie aan het Geografisch Instituut van de Rijksuniversiteit te Utrecht. Het doel van het onderzoek was het vervaardigen van een rapport, waarin het ontstaan en de genese van de steden Tholen en Sint Maartensdijk in Zeeland behandeld worden." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "beschermd stadsgezicht" ;
            sgpl:text_context "Deze steden staan in de nota \" Herinventarisatie van stads- en dorpsgezichten \" (1980) als \" beschermenswaardig \" genoemd. De onderzoeksresultaten zullen derhalve door de Rijksdienst voor de Monumentenzorg gebruikt worden voor het opstellen van de \" Toelichting op het voorstel van aanwijzing tot beschermd stadsgezicht \". \" De Monumentenwet maakt op grond van artikel 20 de aanwijzing van beschermde stads- en dorpsgezichten mogelijk." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "stedelijke nederzettingen" ;
            sgpl:text_context "Het verslag vormt de neerslag van een onderzoek dat verricht is in opdracht van de Rijksdienst voor de Monumentenzorg. Het doel hiervan was te komen tot een rapport, waarin het ontstaan en de ontwikkeling van de stedelijke nederzettingen Tholen en Sint Maartensdijk (Zeeland) belicht worden. Deze steden staan in de nota \" Herinventarisatie van stads- en dorpsgezichten \" (1980) als \" beschermenswaardig \" genoemd." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "stedelijke nederzettingen" ;
            sgpl:text_context "Het verslag vormt de neerslag van een onderzoek dat verricht is in opdracht van de Rijksdienst voor de Monumentenzorg. Het doel hiervan was te komen tot een rapport, waarin het ontstaan en de ontwikkeling van de stedelijke nederzettingen Tholen en Sint Maartensdijk (Zeeland) belicht worden. Deze steden staan in de nota \" Herinventarisatie van stads- en dorpsgezichten \" (1980) als \" beschermenswaardig \" genoemd." ],
        [ sgpl:refersToConcept unesco:concept11417 ;
            sgpl:subjectText "historische geografie" ;
            sgpl:text_context "De voor u liggende skriptie is het resultaat van mijn doktoraal leeronderzoek. Dit onderzoek werd verricht voor het hoofdvak Historische Geografie aan het Geografisch Instituut van de Rijksuniversiteit te Utrecht. Het doel van het onderzoek was het vervaardigen van een rapport, waarin het ontstaan en de genese van de steden Tholen en Sint Maartensdijk in Zeeland behandeld worden." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "beschermd stadsgezicht" ;
            sgpl:text_context "Deze steden staan in de nota \" Herinventarisatie van stads- en dorpsgezichten \" (1980) als \" beschermenswaardig \" genoemd. De onderzoeksresultaten zullen derhalve door de Rijksdienst voor de Monumentenzorg gebruikt worden voor het opstellen van de \" Toelichting op het voorstel van aanwijzing tot beschermd stadsgezicht \". \" De Monumentenwet maakt op grond van artikel 20 de aanwijzing van beschermde stads- en dorpsgezichten mogelijk." ] ;
    sgpl:thesisID 123 .

sgpl:Thesis124 a sgpl:SGPLThesis ;
    dcterms:creator "CONSTANCE BOOGERS",
        "FRANK V. DUGTEREN" ;
    dcterms:issued 1984 ;
    dcterms:title "EEN ONDERZOEK NAAR WOONLASTEN EN DOORSTROMING IN : NIEUWEGEIN",
        "WOONLASTEN IN NIEUWBOUW" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Fokkesteeg" ;
            sgpl:text_context "Vanwege de al eerder genoemde beperkingen was bij de keuze tevens van belang dat er een koncentratie van de door ons beoogde nieuwbouwkategorieën aanwezig zou zijn. Dit bleek het geval te zijn in de wijken Fokkesteeg, Zuilestein en Doorslag. Het totale bestand van nieuwbouwwoningen bedraagt in deze wijken 3.984 woningen, onderverdeeld naar de kategorieën: woningwet (WW) 1641 premie A (PA) 646." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "nieuwbouw van Nieuwegein" ;
            sgpl:text_context "Omslagontwerp: C. Boogers. VOORWOORD. Ter afsluiting van ons hoofdvak SGS (Sociale Geografie van de stedelijk-industriële landen), specialisatie wonen en stadsvernieuwing, hebben we ons acht maanden bezig gehouden met een onderzoek naar woonlasten in de nieuwbouw van Nieuwegein. Doel was het zelfstandig uitvoeren van een onderzoek, waarbij alle onderzoeksfases doorlopen en alle voorkomende werkzaamheden zelfstandig uitgevoerd worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Nieuwegein zou vooral als overloopgemeente voor de stad Utrecht fungeren. Vanaf 1971-'79 was deze afspraak dat jaarlijks 40 % van de opgeleverde woningwetwoningen door de gemeente Utrecht met bewoners gevuld mocht worden. Tevens is het aandeel van andere gemeenten uit de provincie Utrecht vergroot in de toewijzingsquota." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stad Utrecht" ;
            sgpl:text_context "Duidelijk mag zijn dat de planologische beleidsbeslissing zoals deze op rijksnivo genomen was door de aanwijzing van een groeikern, in hoge mate door de gemeente Nieuwegein zelf ingevuld kon worden, ten aanzien van de volkshuisvestingstaak. Nieuwegein zou vooral als overloopgemeente voor de stad Utrecht fungeren. De afspraken tussen deze twee gemeenten zijn dan ook van belang." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "gemeente Nieuwegein" ;
            sgpl:text_context "Ten eerste zijn dat de bewoners van Nieuwegein, die aan het onderzoek hebben meegewerkt. Daarnaast zijn wij de gemeente Nieuwegein erkentelijk voor hun bijdragen. Zonder hun medewerking en informatie zou ons onderzoek niet geslaagd zijn." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750324 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Dit laatste vertaald in verhuisgeneigdheid en woonwensen van bewoners. In de loop van het onderzoek is gekozeh voor Nieuwegein als de te onderzoeken gemeente, met name vanwege de groeikernstatus. Zoals te doen gebruikelijk, zijn er ook in ons geval een aantal personen die ons in de loop van het onderzoek bijgestaan en vooruit geholpen hebben." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756674 ;
            sgpl:spatialText "Doorslag" ;
            sgpl:text_context "Vanwege de al eerder genoemde beperkingen was bij de keuze tevens van belang dat er een koncentratie van de door ons beoogde nieuwbouwkategorieën aanwezig zou zijn. Dit bleek het geval te zijn in de wijken Fokkesteeg, Zuilestein en Doorslag. Het totale bestand van nieuwbouwwoningen bedraagt in deze wijken 3.984 woningen, onderverdeeld naar de kategorieën: woningwet (WW) 1641 premie A (PA) 646." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "nieuwbouwwijken van Den Haag" ;
            sgpl:text_context "Kortom de verschillen tussen starters en doorstromers zijn duidelijk, maar dat deze verschillen elkaar voor de woonlastenquoten opheffen. We vergelijken daarom de in dit onderzoek verkregen resultaten met de uitkomsten van een onderzoek dat in 1982 in nieuwbouwwijken van Den Haag heeft plaatsgevonden. Er zal hier alleen een vergelijking worden gemaakt, met de nieuwbouw huurwoningen in uitbreidingswijken en niet met de vervangende nieuwbouw in het kader van stadsvernieuwing." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Geografisch Instituut Utrecht" ;
            sgpl:text_context "BIJLAGEN. LITERATUUR. 0 1984 Geografisch Instituut Utrecht. Drukwerk: Kanters, Alblasserdam." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Zuilestein" ;
            sgpl:text_context "Vanwege de al eerder genoemde beperkingen was bij de keuze tevens van belang dat er een koncentratie van de door ons beoogde nieuwbouwkategorieën aanwezig zou zijn. Dit bleek het geval te zijn in de wijken Fokkesteeg, Zuilestein en Doorslag. Het totale bestand van nieuwbouwwoningen bedraagt in deze wijken 3.984 woningen, onderverdeeld naar de kategorieën: woningwet (WW) 1641 premie A (PA) 646." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Onze speciale dank gaat uit naar Peter Boelhouwer, die er altijd was, meedacht en hielp, om het onderzoek te laten slagen. Constance Boogers Frank v. Dugteren Utrecht, augustus 1984. 7 INLEIDING. Er is de laatste jaren een stroom van informatie losgekomen via nota's, rapporten en dergelijke, die zich allemaal bezighouden met de woonlastenproblematiek, terwijl woonlastenkomité's de grond uitgestampt worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Er wordt een woonlastenschema opgesteld met daarin de te verwachten inkomensverdeling voor de bewoners van Nieuwegein. De achtergrond daarvoor is de als evenwichtig beschouwde inkomensverdeling van Nederland. Dit als doel, om aan alle inkomenskategorieën de mogelijkheid te geven, zich in Nieuwegein te vestigen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "Vanaf 1971-'79 was deze afspraak dat jaarlijks 40 % van de opgeleverde woningwetwoningen door de gemeente Utrecht met bewoners gevuld mocht worden. Tevens is het aandeel van andere gemeenten uit de provincie Utrecht vergroot in de toewijzingsquota. De vraag is nu waartoe al deze plannen uiteindelijk geleid hebben." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stadsgewest Utrecht" ;
            sgpl:text_context "Ons doel is te kijken in hoeverre doorstroming en woonlasten elkaar beïnvloeden. Nieuwegein vormt binnen het stadsgewest Utrecht één van de belangrijkste opvanggemeenten (zeker tot 1985) voor de bevolkingsoverloop. We richten ons voornamelijk op de funktie die Nieuwegein heeft en had om de verdeling van woonruimte en lasten ten aanzien van de onderscheiden deelpopulaties beter op elkaar af te stemmen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759915 ;
            sgpl:spatialText "Alblasserdam" ;
            sgpl:text_context "BIJLAGEN. LITERATUUR. 0 1984 Geografisch Instituut Utrecht. Drukwerk: Kanters, Alblasserdam. Omslagontwerp: C. Boogers." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "verhuisgeneigdheid" ;
            sgpl:text_context "Dit zeer arbeidsintensieve werk heeft geresulteerd in een onderzoeksverslag waarin naast de meting van de woonlasten, ook geprobeerd is een koppeling te leggen met het -geografische- begrip doorstroming. Dit laatste vertaald in verhuisgeneigdheid en woonwensen van bewoners. In de loop van het onderzoek is gekozeh voor Nieuwegein als de te onderzoeken gemeente, met name vanwege de groeikernstatus." ],
        [ sgpl:refersToConcept unesco:concept3618 ;
            sgpl:subjectText "woonlasten" ;
            sgpl:text_context "Er is de laatste jaren een stroom van informatie losgekomen via nota's, rapporten en dergelijke, die zich allemaal bezighouden met de woonlastenproblematiek, terwijl woonlastenkomité's de grond uitgestampt worden. De woonlasten vormen voor veel bewoners een probleem en worden ook als zodanig maatschappelijk en politiek onderkend. De bijdrage die wij aan onderzoek naar woonlasten willen leveren, zal te dele aansluiten bij de resultaten van reeds voltooide onderzoeken en deels daarvan afwijken." ],
        [ sgpl:refersToConcept unesco:concept1564 ;
            sgpl:subjectText "doorstroming" ;
            sgpl:text_context "Naast dit pure woonlasten deel van het onderzoek, volgen we ook nog een tweede lijn, die in kombinatie met woonlasten nog relatief weinig onderzocht is, namelijk de doorstromingsproblematiek. Ons doel is te kijken in hoeverre doorstroming en woonlasten elkaar benvloeden. Doorstroming zal vanuit z'n waarde als instrument in het groeikernenbeleid onder de loep genomen worden." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "verhuisgeneigdheid" ;
            sgpl:text_context "Dit zeer arbeidsintensieve werk heeft geresulteerd in een onderzoeksverslag waarin naast de meting van de woonlasten, ook geprobeerd is een koppeling te leggen met het -geografische- begrip doorstroming. Dit laatste vertaald in verhuisgeneigdheid en woonwensen van bewoners. In de loop van het onderzoek is gekozeh voor Nieuwegein als de te onderzoeken gemeente, met name vanwege de groeikernstatus." ],
        [ sgpl:refersToConcept unesco:concept1564 ;
            sgpl:subjectText "doorstroming" ;
            sgpl:text_context "Naast dit pure woonlasten deel van het onderzoek, volgen we ook nog een tweede lijn, die in kombinatie met woonlasten nog relatief weinig onderzocht is, namelijk de doorstromingsproblematiek. Ons doel is te kijken in hoeverre doorstroming en woonlasten elkaar benvloeden. Doorstroming zal vanuit z'n waarde als instrument in het groeikernenbeleid onder de loep genomen worden." ],
        [ sgpl:refersToConcept unesco:concept3618 ;
            sgpl:subjectText "woonlasten" ;
            sgpl:text_context "Er is de laatste jaren een stroom van informatie losgekomen via nota's, rapporten en dergelijke, die zich allemaal bezighouden met de woonlastenproblematiek, terwijl woonlastenkomité's de grond uitgestampt worden. De woonlasten vormen voor veel bewoners een probleem en worden ook als zodanig maatschappelijk en politiek onderkend. De bijdrage die wij aan onderzoek naar woonlasten willen leveren, zal te dele aansluiten bij de resultaten van reeds voltooide onderzoeken en deels daarvan afwijken." ] ;
    sgpl:thesisID 124 .

sgpl:Thesis125 a sgpl:SGPLThesis ;
    dcterms:creator "TJALLE VAN DER BURG" ;
    dcterms:issued 1984 ;
    dcterms:title "OVER DE OORZAKEN VAN ONDERONTWIKKELING" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:191964 ;
            sgpl:spatialText "Kimalewa" ;
            sgpl:text_context "In een aantal gebieden in West-Kenia is reeds een aantal jaren een onderzoek gaande naar onderontwikkeling op het platteland. Dit onderzoek is een initiatief van drs. Jan Lavrijsen, die van 1974 tot 1980 in Kenia werkzaam is geweest, eerst als projektkoördinator van een aantal door de NOVIB gesteunde koöperaties, en later als manager van de koöperatie in Kimalewa, een van de onderzoeksgebieden. De onderzoekingen van Lavrijsen waren in eerste instantie gericht op het verkrijgen van voor de projekten relevante informatie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:192950 ;
            sgpl:spatialText "West-Kenia" ;
            sgpl:text_context "Verschillende mensen zijn een direkte steun geweest bij het totstandkomen van dit diskussiestuk. Allereerst wil ik Jos Algia noemen, met wie ik samen in West-Kenia veldonderzoek deed en met wie ik ook tijdens het schrijven van mijn skriptie veel kontakt had. Zijn enthousiasme was een grote stimulans." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:187740 ;
            sgpl:spatialText "Maragoli" ;
            sgpl:text_context "Dit indicates dat few school-graduates will remain at the society level of assist in its operations. Dat een soortgelijke mentaliteit ook in Western Province heerst werd o.m. duidelijk gesteld door doktor Stephen Wanje, een medicus uit Maragoli. Naast zijn normale werk houdt deze man zich ook aktief bezig met een experimentele boerderij, terwijl hij ook regelmatig lezingen geeft aan scholen in Western Province." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:191299 ;
            sgpl:spatialText "Kisii" ;
            sgpl:text_context "Een tweede reden voor het vaak ontbreken van een geschikt kader is de volgende. Dobrin zegt wat dit betreft het volgende over de situatie die zich zo'n tien jaar geleden in Kisii voordeed (kisii is een gebied in Zuidwest-Kenia dat in veel opzichten sterk op Western Province lijkt): At the society level there is a dearth of leadership." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:194521 ;
            sgpl:spatialText "Kandara Division" ;
            sgpl:text_context "Gezien de mate waarin fraude voorkomt moet dit voor een aantal bestuursleden een belangrijke bron van inkomsten zijn. Volgens Lamb zijn mensen die in de besturen van lagere en middelbare scholen in Kandara Division zitten vaak rijker en beter opgeleid dan de gemiddelde peasant. Hyden stelt dat mensen die leidende posities hebben in andere gemeenschapsinstituties dan koöperaties, ook vaak zitting hebben in het koöperatiebestuur." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:192950 ;
            sgpl:spatialText "Kenia" ;
            sgpl:text_context "In een aantal gebieden in West-Kenia is reeds een aantal jaren een onderzoek gaande naar onderontwikkeling op het platteland. Dit onderzoek is een initiatief van drs. Jan Lavrijsen, die van 1974 tot 1980 in Kenia werkzaam is geweest, eerst als projektkoördinator van een aantal door de NOVIB gesteunde koöperaties, en later als manager van de koöperatie in Kimalewa, een van de onderzoeksgebieden. De onderzoekingen van Lavrijsen waren in eerste instantie gericht op het verkrijgen van voor de projekten relevante informatie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:400743 ;
            sgpl:spatialText "Western Province" ;
            sgpl:text_context "Dit indicates dat few school-graduates will remain at the society level of assist in its operations. Dat een soortgelijke mentaliteit ook in Western Province heerst werd o.m. duidelijk gesteld door doktor Stephen Wanje, een medicus uit Maragoli. Naast zijn normale werk houdt deze man zich ook aktief bezig met een experimentele boerderij, terwijl hij ook regelmatig lezingen geeft aan scholen in Western Province." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Central Province" ;
            sgpl:text_context "Lamb, 1974, p. 66. Kandara Division ligt in Central Province. Hyden stelt dat mensen die leidende posities hebben in andere gemeenschapsinstituties dan koöperaties, ook vaak zitting hebben in het koöperatiebestuur." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Nr. 25 januari 1984 geografisch instituut heidel berglaan 2 3508 TC utrecht rijksuniversiteit utrecht transitorium II tel: 030-532044" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255146 ;
            sgpl:spatialText "Oost-Afrika" ;
            sgpl:text_context "Dit zal gewijd zijn aan de landbouwkooperaties. In het volgende zal slechts over de Oost-Afrikaanse peasant-samenlevingen een theoretische beschouwing gegeven worden. Onze kennis reikt niet ver genoeg om beschouwingen over andere gebieden ten beste te geven." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1703 ;
            sgpl:subjectText "rurale marginalisatie" ;
            sgpl:text_context "Hier is later een theoretisch-wetenschappelijke motivatie bijgekomen, en Lavrijsen hoopt binnenkort een dissertatie over rurale marginalisatie te doen verschijnen. Rurale marginalisatie is een vakterm, die hier grofweg vertaald kan worden met onderontwikkeling op het platteland. In de jaren 1977 en 1979 werden in totaal 4 doktoraalstudenten bij het onderzoek ingeschakeld, te weten Gerard Monninkhof, John Steenwinkel, Jos Algra en schrijver dezes." ],
        [ sgpl:refersToConcept unesco:concept7853 ;
            sgpl:subjectText "onderontwikkeling" ;
            sgpl:text_context "Hun doktoraalskripties staan in de literatuurlijst vermeld en geven, te zamen met eveneens vermeld werk van Heijnen,al een behoorlijke informatie over het verrichte onderzoek. Een van de grote problemen van het onderzoek is geweest de grote afstand tussen de in de onderzoeksgebieden gedane observaties en de moderne theorieën over onderontwikkeling. Onder de moderne theorieën worden hier verstaan die theorieën welke sterke nadruk leggen op faktoren als machtsstrukturen, belangengroepen, afhankelijkheidsrelaties, ongelijkheidsprocessen, ongelijke ruil, etc., en welke aan het eind van de jaren zestig en in de jaren zeventig sterk op de voorgrond traden." ],
        [ sgpl:refersToConcept unesco:concept1730 ;
            sgpl:subjectText "landbouwkoöperaties" ;
            sgpl:text_context "Tot slot van deze paragraaf een korte vooruitblik op de rest van dit hoofdstuk. Dit zal gewijd zijn aan de landbouwkooperaties. Over dit onderwerp zal een meer gedetailleerde theoretische beschouwing gegeven worden dan in het voorgaande mogelijk was." ],
        [ sgpl:refersToConcept unesco:concept1703 ;
            sgpl:subjectText "rurale marginalisatie" ;
            sgpl:text_context "Hier is later een theoretisch-wetenschappelijke motivatie bijgekomen, en Lavrijsen hoopt binnenkort een dissertatie over rurale marginalisatie te doen verschijnen. Rurale marginalisatie is een vakterm, die hier grofweg vertaald kan worden met onderontwikkeling op het platteland. In de jaren 1977 en 1979 werden in totaal 4 doktoraalstudenten bij het onderzoek ingeschakeld, te weten Gerard Monninkhof, John Steenwinkel, Jos Algra en schrijver dezes." ],
        [ sgpl:refersToConcept unesco:concept1730 ;
            sgpl:subjectText "landbouwkoöperaties" ;
            sgpl:text_context "Tot slot van deze paragraaf een korte vooruitblik op de rest van dit hoofdstuk. Dit zal gewijd zijn aan de landbouwkooperaties. Over dit onderwerp zal een meer gedetailleerde theoretische beschouwing gegeven worden dan in het voorgaande mogelijk was." ],
        [ sgpl:refersToConcept unesco:concept7853 ;
            sgpl:subjectText "onderontwikkeling" ;
            sgpl:text_context "Hun doktoraalskripties staan in de literatuurlijst vermeld en geven, te zamen met eveneens vermeld werk van Heijnen,al een behoorlijke informatie over het verrichte onderzoek. Een van de grote problemen van het onderzoek is geweest de grote afstand tussen de in de onderzoeksgebieden gedane observaties en de moderne theorieën over onderontwikkeling. Onder de moderne theorieën worden hier verstaan die theorieën welke sterke nadruk leggen op faktoren als machtsstrukturen, belangengroepen, afhankelijkheidsrelaties, ongelijkheidsprocessen, ongelijke ruil, etc., en welke aan het eind van de jaren zestig en in de jaren zeventig sterk op de voorgrond traden." ] ;
    sgpl:thesisID 125 .

sgpl:Thesis126 a sgpl:SGPLThesis ;
    dcterms:creator "Elly Klooster",
        "Heleen van Camp" ;
    dcterms:issued 1984 ;
    dcterms:title "MULTICRITERIA-EVALUATIE",
        "VAN BOUWLOCATIES IN HET STADSGEWEST UTRECHT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "De bouwlocatie-problematiek in het Utrechtse stadsgewest zagen wij als zo'n onderwerp. In het kader van de voorbereiding van het streekplan voor de gehele provincie Utrecht werd de toekomstige woningbehoefte van de regio Utrecht tot het jaar 1995 onderzocht. Deze had een omvang van ca. 20.000 te bouwen woningen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6698635 ;
            sgpl:spatialText "Lunetten" ;
            sgpl:text_context "In 1982 verscheen haar \"Stadsrandstudie\" waarin wordt geconcludeerd dat, op een enkele uitzondering na, verdere verstedelijking aan de randen van de stad ongewenst is. Deze uitzonderingen zijn: ten eerste de afronding van bebouwing in Lunetten, Rijnsweerd, De Uithof en Klopvaart in Overvecht, en ten tweede: - Polder Papendorp; door de Gemeenteraad zijn op 25 juni 1981 de voorgestelde woningbouwplannen afgewezen op grond van ernstige milieu bezwaren; voorgesteld werd de polder te beschouwen als een reservegebied in de sfeer van werken en/of recreëren; - Het gebied ten noorden van de Veemarkt;" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "In 1982 verscheen haar \"Stadsrandstudie\" waarin wordt geconcludeerd dat, op een enkele uitzondering na, verdere verstedelijking aan de randen van de stad ongewenst is. Deze uitzonderingen zijn: ten eerste de afronding van bebouwing in Lunetten, Rijnsweerd, De Uithof en Klopvaart in Overvecht, en ten tweede: - Polder Papendorp; door de Gemeenteraad zijn op 25 juni 1981 de voorgestelde woningbouwplannen afgewezen op grond van ernstige milieu bezwaren; voorgesteld werd de polder te beschouwen als een reservegebied in de sfeer van werken en/of recreëren; - Het gebied ten noorden van de Veemarkt;" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "In maart 1983 formuleerden GS hun standpunt t.a.v. de ontwikkeling van nieuwe bouwlocaties in het centrale deel van de provincie Utrecht. Nadat van alle bouwlocaties, zowel in de regio Utrecht als aan de stadsrand als in de gemeente Utrecht, een beeld was gevormd, werden deze locaties door GS op basis van de volgende twee uitgangspunten beoordeeld: 1. de ontwikkeling van een groenstructuur rond de stad Utrecht dient mogelijk te blijven;" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stadsgewest Utrecht" ;
            sgpl:text_context "Toen wij vorig jaar met ons doctoraal-onderzoek begonnen, zochten wij naar een onderwerp waarin de belangenafweging, die zich afspeelt bij de concurrentie om de ruimte, een belangrijke rol vervult. De bouwlocatie-problematiek in het Utrechtse stadsgewest zagen wij als zo'n onderwerp. Deze belangenafweging kon o.i. het meest inzichtelijk gemaakt worden door de multicriteria-evaluatie methode toe te passen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753557 ;
            sgpl:spatialText "Houten" ;
            sgpl:text_context "GS achten een aantal van ca. 10.000 woningen binnen de gemeente Utrecht op voorhand haalbaar; de hardheid van deze aanname moet zo spoedig mogelijk worden nagegaan en indien mogelijk worden verhoogd; - Houten realisering mogelijk van ca. 2.000 woningen door verdichting binnen het globale bestemmingsplan Houten; - Nieuwegein zo snel mogelijk openen van bestuurlijk overleg over de locatie Galecop in relatie tot de leidingenproblematiek; capaciteit p.m. 2.000 woningen;" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755302,
                geonames:2757783 ;
            sgpl:spatialText "Groenekan/De Bilt" ;
            sgpl:text_context "Houten opp. 200 ha. 6.000 woningen Groenekan/De Bilt opp. 110 ha. 3.300 woningen De Uithof - 1.800 woningen" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "westlob" ;
            sgpl:text_context "Tussen deze drie zogenaamde \"lobben\" bevinden zich dan de uitlopers van de open ruimte. Binnen deze twee lobben is nadruk op de westlob te rechtvaardigen vanwege: a. het ontstaan van een meer evenwichtige structuur binnen het stadsgewest; b. de aanwezigheid van voldoende ruimtelijke mogelijkheden; c. de verbeteringen aan de wegen-infrastructuur tussen deze lob en Utrecht, welke in uitvoering of juist voltooid zijn; d. de aanwezigheid van een belangrijke werkgelegenheidsconcentratie tussen deze lob en de centrale kern, nl. Lage Weide; In maart 1983 formuleerden GS hun standpunt t.a.v. de ontwikkeling van nieuwe bouwlocaties in het centrale deel van de provincie Utrecht." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10507 ;
            sgpl:subjectText "Multicriteria-evaluatie" ;
            sgpl:text_context "hebben wij een onderzoek gedaan naar de aantrekkelijkheid van woningbouw-locaties in het stadsgewest Utrecht. Wij hebben dit onderzoek verricht m.b.v. de multicriteria-evaluatie methode. Hiermede hopen wij ten eerste te bereiken dat de bouwlocatieproblematiek inzichtelijk wordt en dat het standpunt van GS in deze getoetst kan worden aan onze bevindingen, en ten tweede dat de multicriteria-evaluatie methode door deze praktische toepassing meer bekendheid wordt gegeven." ],
        [ sgpl:refersToConcept unesco:concept5724 ;
            sgpl:subjectText "Ruimtelijk ordeningsbeleid" ;
            sgpl:text_context "De overheid kan bij deze concurrentie om de gebruikte ruimte in het peri-urbane gebied regulerend optreden. Op de verschillende overheidsniveau's wordt daartoe een ruimtelijk ordeningsbeleid gevoerd, waarin bij afweging niet alleen de economische aspecten een rol spelen, maar ook de maatschappelijke. Door dit beleid kunnen functies beschermd en toegelaten worden waarbij in bepaalde gevallen tot scheiding en/of verweving over-gegaan kan worden." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Woningbouwlocaties" ;
            sgpl:text_context "Met name in het stadsgewest doet zich dit conflict voor, gezien de ruimtelijke schaal waarin het wonen, werken, de recreatie en voorzieningen hun plaats moeten hebben. In het stadsgewest Utrecht is deze concurrentie om de ruimte expliciet tot uiting gekomen bij het zoeken naar ruimtelijke mogelijkheden voor woningbouwlocaties. In het kader van de voorbereiding van het streekplan voor de gehele provincie Utrecht werd de toekomstige woningbehoefte van de regio Utrecht tot het jaar 1995 onderzocht." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Woningbouwlocaties" ;
            sgpl:text_context "Met name in het stadsgewest doet zich dit conflict voor, gezien de ruimtelijke schaal waarin het wonen, werken, de recreatie en voorzieningen hun plaats moeten hebben. In het stadsgewest Utrecht is deze concurrentie om de ruimte expliciet tot uiting gekomen bij het zoeken naar ruimtelijke mogelijkheden voor woningbouwlocaties. In het kader van de voorbereiding van het streekplan voor de gehele provincie Utrecht werd de toekomstige woningbehoefte van de regio Utrecht tot het jaar 1995 onderzocht." ],
        [ sgpl:refersToConcept unesco:concept10507 ;
            sgpl:subjectText "Multicriteria-evaluatie" ;
            sgpl:text_context "hebben wij een onderzoek gedaan naar de aantrekkelijkheid van woningbouw-locaties in het stadsgewest Utrecht. Wij hebben dit onderzoek verricht m.b.v. de multicriteria-evaluatie methode. Hiermede hopen wij ten eerste te bereiken dat de bouwlocatieproblematiek inzichtelijk wordt en dat het standpunt van GS in deze getoetst kan worden aan onze bevindingen, en ten tweede dat de multicriteria-evaluatie methode door deze praktische toepassing meer bekendheid wordt gegeven." ],
        [ sgpl:refersToConcept unesco:concept5724 ;
            sgpl:subjectText "Ruimtelijk ordeningsbeleid" ;
            sgpl:text_context "De overheid kan bij deze concurrentie om de gebruikte ruimte in het peri-urbane gebied regulerend optreden. Op de verschillende overheidsniveau's wordt daartoe een ruimtelijk ordeningsbeleid gevoerd, waarin bij afweging niet alleen de economische aspecten een rol spelen, maar ook de maatschappelijke. Door dit beleid kunnen functies beschermd en toegelaten worden waarbij in bepaalde gevallen tot scheiding en/of verweving over-gegaan kan worden." ] ;
    sgpl:thesisID 126 .

sgpl:Thesis127 a sgpl:SGPLThesis ;
    dcterms:creator "A. G. M. VAN ELZAKKER" ;
    dcterms:title "REGIONALE VERSCHILLEN IN MEDISCHE CONSUMPTIE",
        "een sociaal-geografische studie" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756039 ;
            sgpl:spatialText "Ermelo" ;
            sgpl:text_context "Na toepassing van deze twee kriteria bleef een aantal groepjes van deze gemeenten over, die in aanmerking kwamen voor het onderzoek. De keus viel op Ermelo, Hoogezand-Sappemeer, Tilburg en Zaanstad. 4.2. De geselekteerde gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In dit hoofdstuk wordt de probleemstelling geplaatst tegen een achtergrond van sociaal-geografische en sociologische kennis. In zijn proefschrift stelt Stijnenbosch (1983, p.14) dat sociaal geografen in Nederland nog weinig onderzoek hebben gedaan naar (ontwikkelingen in en totstandkoming van) locatiepatronen van instellingen in de non-profitsector. Kennelijk om het voortouw te nemen in deze heeft Stijnenbosch een dergelijk onderzoek uitgevoerd, toegespitst op de ziekenhuisinstellingen in Nederland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746300 ;
            sgpl:spatialText "Tilburg" ;
            sgpl:text_context "Na toepassing van deze twee kriteria bleef een aantal groepjes van deze gemeenten over, die in aanmerking kwamen voor het onderzoek. De keus viel op Ermelo, Hoogezand-Sappemeer, Tilburg en Zaanstad. 4.2. De geselekteerde gemeenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744113 ;
            sgpl:spatialText "Zaanstad" ;
            sgpl:text_context "Na toepassing van deze twee kriteria bleef een aantal groepjes van deze gemeenten over, die in aanmerking kwamen voor het onderzoek. De keus viel op Ermelo, Hoogezand-Sappemeer, Tilburg en Zaanstad. 4.2. De geselekteerde gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Het VBO Amsterdam lijkt in dit verband realistischer. Daar wordt eerst gevraagd naar het voorkomen van verschillen in gezondheidstoestand per buurt. Vervolgens wordt getracht deze verschillen te verklaren met behulp van de volgende clusters van variabelen: bevolkingsdichtheid, alleenstaanden, hetrogeniteit, stabiliteit van de bevolking, sociaal economische status, woningkwaliteit, fysisch milieu en huisartsendichtheid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Ik zal hen hier niet bij naam noemen: ik hoop dat ik tegenover degenen die ik bedoel mijn dank al op enigerlei wijze heb geuit. Utrecht, september 1984 Ad van Elzakker. 1. INLEIDING" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753705 ;
            sgpl:spatialText "Hoogezand-Sappemeer" ;
            sgpl:text_context "Na toepassing van deze twee kriteria bleef een aantal groepjes van deze gemeenten over, die in aanmerking kwamen voor het onderzoek. De keus viel op Ermelo, Hoogezand-Sappemeer, Tilburg en Zaanstad. 4.2. De geselekteerde gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "nederlandse regio's" ;
            sgpl:text_context "Er wordt daarom een behoefte gevoeld aan meer van dergelijke kriteria. Kriteria die enerzijds een rol kunnen spelen in beoordelingen van incidentele planningssituaties en anderzijds mogelijk een plaats kunnen vinden in een verdelingsmodel dat een allocatie van de middelen voor de gezondheidszorg over de nederlandse regio's mogelijk maakt. Om dergelijke kriteria te kunnen vinden zal de medische konsumptie via de derde weg moeten worden benaderd." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5456 ;
            sgpl:subjectText "gezondheidszorgvoorzieningen" ;
            sgpl:text_context "Door verschillende auteurs (o.a. Stijnenbosch 1983, Hogewind 1983) is namelijk vastgesteld dat er zich belangrijke verschillen in de ruimte voordoen in gebruik van het professionele gezondheidszorgcircuit. Deze medische konsumptie, hier gedefinieerd als het gebruik van professionele gezondheidszorgvoorzieningen, wordt bepaald door vraag- en aanbodfaktoren, ofwel door enerzijds de kenmerken van de konsumenten en hun omgeving en anderzijds de kenmerken van het voorzieningensysteem. Regionale konsumptieverschillen kunnen op hun beurt worden geacht samen hangen met regionale verschillen in die vraag- en aanbodfaktoren." ],
        [ sgpl:refersToConcept unesco:concept6710 ;
            sgpl:subjectText "medische konsumptie" ;
            sgpl:text_context "Ten derde is nog denkbaar dat niet iedereen evenveel mogelijkheden heeft om gebruik te maken van gezondheidszorgvoorzieningen. Hoewel het is te begrijpen dat zich verschillen voordoen in zogenaamde medische konsumptie tussen individuen, is het merkwaardig dat zich aan die verschillen een ruimtelijke komponent laat ontdekken. Door verschillende auteurs (o.a. Stijnenbosch 1983, Hogewind 1983) is namelijk vastgesteld dat er zich belangrijke verschillen in de ruimte voordoen in gebruik van het professionele gezondheidszorgcircuit." ],
        [ sgpl:refersToConcept unesco:concept6436 ;
            sgpl:subjectText "vraagfaktoren" ;
            sgpl:text_context "Om dergelijke kriteria te kunnen vinden zal de medische konsumptie via de derde weg moeten worden benaderd. De onderzoekaandacht zal zich hier richten op de vraagfaktoren: de behoeften van de regionale bevolkingen. Het zal duidelijk zijn dat het onmogelijk is een absolute vraag c.q. behoefte naar medische voorzieningen te bepalen op basis van een aantal bevolkingskenmerken." ],
        [ sgpl:refersToConcept unesco:concept5456 ;
            sgpl:subjectText "gezondheidszorgvoorzieningen" ;
            sgpl:text_context "Door verschillende auteurs (o.a. Stijnenbosch 1983, Hogewind 1983) is namelijk vastgesteld dat er zich belangrijke verschillen in de ruimte voordoen in gebruik van het professionele gezondheidszorgcircuit. Deze medische konsumptie, hier gedefinieerd als het gebruik van professionele gezondheidszorgvoorzieningen, wordt bepaald door vraag- en aanbodfaktoren, ofwel door enerzijds de kenmerken van de konsumenten en hun omgeving en anderzijds de kenmerken van het voorzieningensysteem. Regionale konsumptieverschillen kunnen op hun beurt worden geacht samen hangen met regionale verschillen in die vraag- en aanbodfaktoren." ],
        [ sgpl:refersToConcept unesco:concept6710 ;
            sgpl:subjectText "medische konsumptie" ;
            sgpl:text_context "Ten derde is nog denkbaar dat niet iedereen evenveel mogelijkheden heeft om gebruik te maken van gezondheidszorgvoorzieningen. Hoewel het is te begrijpen dat zich verschillen voordoen in zogenaamde medische konsumptie tussen individuen, is het merkwaardig dat zich aan die verschillen een ruimtelijke komponent laat ontdekken. Door verschillende auteurs (o.a. Stijnenbosch 1983, Hogewind 1983) is namelijk vastgesteld dat er zich belangrijke verschillen in de ruimte voordoen in gebruik van het professionele gezondheidszorgcircuit." ],
        [ sgpl:refersToConcept unesco:concept6436 ;
            sgpl:subjectText "vraagfaktoren" ;
            sgpl:text_context "Om dergelijke kriteria te kunnen vinden zal de medische konsumptie via de derde weg moeten worden benaderd. De onderzoekaandacht zal zich hier richten op de vraagfaktoren: de behoeften van de regionale bevolkingen. Het zal duidelijk zijn dat het onmogelijk is een absolute vraag c.q. behoefte naar medische voorzieningen te bepalen op basis van een aantal bevolkingskenmerken." ] ;
    sgpl:thesisID 127 .

sgpl:Thesis128 a sgpl:SGPLThesis ;
    dcterms:creator "Jenny Fix",
        "René Verhoeff" ;
    dcterms:issued 1984 ;
    dcterms:title "Regionale ontwikkeling",
        "door Zelfbestuur",
        "een onderzoek naar de naoorlogse regionale ontwikkeling van Servië (Joegoslavië) deel 1" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:784272 ;
            sgpl:spatialText "Vojvodina" ;
            sgpl:text_context "Onder het onderzoeksgebied Servië verstaan wij dat deel van de Socialistische Republiek Servië uitgezonderd de autonome provincies Kosovo en Vojvodina; in de literatuur ook wel benoemd als het eigenlijke Servië of Klein-Servië. De oorspronkelijke onderzoeksopzet en probleemstelling werden in samenwerking met Dr. Branislav Derit van het Ekonomisch Instituut in Belgrado, onze onderzoeksbegeleider, verder uitgewerkt en er werd een werkprogramma voor 9 maanden opgesteld. De eerste maanden werden vooral besteed aan het inlezen in de Servokroatische vakliteratuur, naast het volgen van een taalkursus en het regelen van allerhande praktische zaken, die, gezien onze onbekendheid met de Joegoslavische burokratie, veel tijd vergden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:831053 ;
            sgpl:spatialText "Kosovo" ;
            sgpl:text_context "Onder het onderzoeksgebied Servië verstaan wij dat deel van de Socialistische Republiek Servië uitgezonderd de autonome provincies Kosovo en Vojvodina; in de literatuur ook wel benoemd als het eigenlijke Servië of Klein-Servië. De oorspronkelijke onderzoeksopzet en probleemstelling werden in samenwerking met Dr. Branislav Derit van het Ekonomisch Instituut in Belgrado, onze onderzoeksbegeleider, verder uitgewerkt en er werd een werkprogramma voor 9 maanden opgesteld. De eerste maanden werden vooral besteed aan het inlezen in de Servokroatische vakliteratuur, naast het volgen van een taalkursus en het regelen van allerhande praktische zaken, die, gezien onze onbekendheid met de Joegoslavische burokratie, veel tijd vergden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:792680 ;
            sgpl:spatialText "Belgrado" ;
            sgpl:text_context "Deze hebben wij ingediend bij de Vakgroep Sociale Geografie van de Stedelijk Industriële Landen van de Interfakulteit der Aardrijkskunde en Prehistorie der Rijksuniversiteit te Utrecht en bij het Ministerie van Onderwijs en Wetenschappen, ten behoeve van een beursaanvraag voor ons verblijf van 9 maanden in Belgrado. Onder het onderzoeksgebied Servië verstaan wij dat deel van de Socialistische Republiek Servië uitgezonderd de autonome provincies Kosovo en Vojvodina; in de literatuur ook wel benoemd als het eigenlijke Servië of Klein-Servië. De oorspronkelijke onderzoeksopzet en probleemstelling werden in samenwerking met Dr. Branislav Derit van het Ekonomisch Instituut in Belgrado, onze onderzoeksbegeleider, verder uitgewerkt en er werd een werkprogramma voor 9 maanden opgesteld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6290252 ;
            sgpl:spatialText "Servië" ;
            sgpl:text_context "In deze skriptie zullen wij een beschrijving geven van de effekten van de naoorlogse ontwikkeling in Servië in het algemeen (als deel van de Socialistische Federatieve Republiek van Joegoslavië, de SFRJ) en verschillen tussen de Servische regio's in het bijzonder. De nadruk zal liggen op de maatschappelijke ontwikkelingen van de laatste twintig jaar met speciale aandacht voor de ruimtelijke aspekten van de maatschappelijke veranderingsprocessen en de beleidsmatige en planmatige aanpak van die processen. Vanuit die kontekst proberen we dan inzicht te krijgen in het gevoerde beleid en de mogelijkheden voor de toekomst van het onderzoeksgebied, uitmondend in een evaluatie van het geheel." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:792680 ;
            sgpl:spatialText "regio Beograd" ;
            sgpl:text_context "Hoge positieve migratiesaldi vinden we vooral in de stedelijke gebieden, met name de regio Beograd was een enorm attraktiepunt voor de plattelandsbevolking. In de periode 1961-1971 had Servië zonder Belgrado zelfs een negatief migratiesaldo van -10.676. Andere stedelijke gebieden met positieve migratiesaldi waren industrialiserende regionale centra als Bor, Nisj en Kragujevac en nog een tiental andere gemeenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6290252 ;
            sgpl:spatialText "Socialistische Republiek Servië" ;
            sgpl:text_context "Deze hebben wij ingediend bij de Vakgroep Sociale Geografie van de Stedelijk Industriële Landen van de Interfakulteit der Aardrijkskunde en Prehistorie der Rijksuniversiteit te Utrecht en bij het Ministerie van Onderwijs en Wetenschappen, ten behoeve van een beursaanvraag for ons verblijf van 9 maanden in Belgrado. Onder het onderzoeksgebied Servië verstaan wij dat deel van de Socialistische Republiek Servië uitgezonderd de autonome provincies Kosovo en Vojvodina; in de literatuur ook wel benoemd als het eigenlijke Servië of Klein-Servië. De oorspronkelijke onderzoeksopzet en probleemstelling werden in samenwerking met Dr. Branislav Derit van het Ekonomisch Instituut in Belgrado, onze onderzoeksbegeleider, verder uitgewerkt en er werd een werkprogramma voor 9 maanden opgesteld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6290252 ;
            sgpl:spatialText "Klein-Servië" ;
            sgpl:text_context "Onder het onderzoeksgebied Servië verstaan wij dat deel van de Socialistische Republiek Servië uitgezonderd de autonome provincies Kosovo en Vojvodina; in de literatuur ook wel benoemd als het eigenlijke Servië of Klein-Servië. De oorspronkelijke onderzoeksopzet en probleemstelling werden in samenwerking met Dr. Branislav Derit van het Ekonomisch Instituut in Belgrado, onze onderzoeksbegeleider, verder uitgewerkt en er werd een werkprogramma voor 9 maanden opgesteld. De eerste maanden werden vooral besteed aan het inlezen in de Servokroatische vakliteratuur, naast het volgen van een taalkursus en het regelen van allerhande praktische zaken, die, gezien onze onbekendheid met de Joegoslavische burokratie, veel tijd vergden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6290252 ;
            sgpl:spatialText "eigenlijke Servië" ;
            sgpl:text_context "Onder het onderzoeksgebied Servië verstaan wij dat deel van de Socialistische Republiek Servië uitgezonderd de autonome provincies Kosovo en Vojvodina; in de literatuur ook wel benoemd als het eigenlijke Servië of Klein-Servië. De oorspronkelijke onderzoeksopzet en probleemstelling werden in samenwerking met Dr. Branislav Derit van het Ekonomisch Instituut in Belgrado, onze onderzoeksbegeleider, verder uitgewerkt en er werd een werkprogramma voor 9 maanden opgesteld. De eerste maanden werden vooral besteed aan het inlezen in de Servokroatische vakliteratuur, naast het volgen van een taalkursus en het regelen van allerhande praktische zaken, die, gezien onze onbekendheid met de Joegoslavische burokratie, veel tijd vergden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1406 ;
            sgpl:subjectText "regionaal beleid" ;
            sgpl:text_context "Tenslotte zullen we in hoofdstuk 7 de naoorlogse ruimtelijke en ekonomische ontwikkelingen op het regionale nivo bespreken. Er zal daarbij aandacht worden geschonken aan de regionale differentiatie, het verschijnsel polarisatie, de territoriale differentiatie en het regionaal beleid. In de skriptie komen een aantal belangrijke spanningsvelden waarbinnen de ontwikkeling een weg moet vinden aan de orde." ],
        [ sgpl:refersToConcept unesco:concept3395 ;
            sgpl:subjectText "zelfbestuurssysteem" ;
            sgpl:text_context "Volgens Kardelj (1954, p. 32) had het gecentraliseerde staatssysteem haar tijd gehad en omdat er politieke en ekonomische stagnaties optraden, moest het socialisme voortgezet worden op een andere manier. Zo werd een begin gemaakt met de introduktie van het zelfbestuurssysteem: \"Een staat, een systeem of een politieke partij kan de mens geen geluk geven.\" Alleen hijzelf kan zijn eigen geluk kreëren." ],
        [ sgpl:refersToConcept unesco:concept12340 ;
            sgpl:subjectText "industrialisatie" ;
            sgpl:text_context "De overgang van Joegoslavië en Servië van een onderontwikkelde agrarische samenleving naar een moderne industriële maatschappij wordt gekenmerkt door een drietal sociaal-ekonomische transformatieprocessen, die de gehele naoorlogse periode hebben bijgedragen aan alle veranderingen die in het eerste deel beschreven zijn. Deze drie processen zijn de industrialisatie, de verstedelijking of urbanisatie en de deagrarisatie, welke onlosmakelijk met elkaar verbonden zijn. Aangezien zij sterk gestimuleerd zijn en plaats gevonden hebben in een relatief korte periode, hebben de gevolgen van deze processen een zeer specifiek karakter gekregen met een geheel eigen ruimtelijke weerslag en een eigen problematiek." ],
        [ sgpl:refersToConcept unesco:concept1406 ;
            sgpl:subjectText "regionaal beleid" ;
            sgpl:text_context "Tenslotte zullen we in hoofdstuk 7 de naoorlogse ruimtelijke en ekonomische ontwikkelingen op het regionale nivo bespreken. Er zal daarbij aandacht worden geschonken aan de regionale differentiatie, het verschijnsel polarisatie, de territoriale differentiatie en het regionaal beleid. In de skriptie komen een aantal belangrijke spanningsvelden waarbinnen de ontwikkeling een weg moet vinden aan de orde." ],
        [ sgpl:refersToConcept unesco:concept12340 ;
            sgpl:subjectText "industrialisatie" ;
            sgpl:text_context "De overgang van Joegoslavië en Servië van een onderontwikkelde agrarische samenleving naar een moderne industriële maatschappij wordt gekenmerkt door een drietal sociaal-ekonomische transformatieprocessen, die de gehele naoorlogse periode hebben bijgedragen aan alle veranderingen die in het eerste deel beschreven zijn. Deze drie processen zijn de industrialisatie, de verstedelijking of urbanisatie en de deagrarisatie, welke onlosmakelijk met elkaar verbonden zijn. Aangezien zij sterk gestimuleerd zijn en plaats gevonden hebben in een relatief korte periode, hebben de gevolgen van deze processen een zeer specifiek karakter gekregen met een geheel eigen ruimtelijke weerslag en een eigen problematiek." ],
        [ sgpl:refersToConcept unesco:concept3395 ;
            sgpl:subjectText "zelfbestuurssysteem" ;
            sgpl:text_context "Volgens Kardelj (1954, p. 32) had het gecentraliseerde staatssysteem haar tijd gehad en omdat er politieke en ekonomische stagnaties optraden, moest het socialisme voortgezet worden op een andere manier. Zo werd een begin gemaakt met de introduktie van het zelfbestuurssysteem: \"Een staat, een systeem of een politieke partij kan de mens geen geluk geven.\" Alleen hijzelf kan zijn eigen geluk kreëren." ] ;
    sgpl:thesisID 128 .

sgpl:Thesis129 a sgpl:SGPLThesis ;
    dcterms:creator "Jan Willem de Koning",
        "Michiel Olij" ;
    dcterms:issued 1985 ;
    dcterms:title "ECONOMISCHE POTENTIES EN PRODUKTIESTRUCTUUR",
        "een sterkte/zwakte onderzoek van de metaalindustrie in Nederland, alsmede de regio's Utrecht, Limburg en Oost-Nederland" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmeegse produktiestructuur" ;
            sgpl:text_context "Bij deze benaderingswijze wordt de gewone bedrijfseconomische portfolio-analyse toegepast op een aantal \"leading-industriés\" in een regio, welke elk individueel geanalyseerd worden. Deze benaderingswijze is toegepast door Alders c.s. op de Nijmeegse produktiestructuur (1982). De onderzoekers werden geconfronteerd met het feit dat de Nijmeegse industriële structuur wordt gedomineerd door filiaalvestigingen van (inter-) nationale multi-vestigings-ondernemingen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Limburg" ;
            sgpl:text_context "Het vijfde hoofdstuk past de in hoofdstuk 4 verworven kennis toe op drie regio's. De regionale sterkten van de provincies Utrecht en Limburg en de regio Oost-Nederland zullen, voorzover het de metaalindustrie betreft, worden opgespoord en benoemd. In het laatste hoofdstuk zal vervolgens voor de provincie Utrecht geprobeerd worden de regionale sterkten te implementeren in een sociaal-economisch beleid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "In een onderzoek naar de ruimtelijke spreiding van kansrijke economische activiteiten, door Alders en De Ruijter, bleek dat de huidige kansrijke metaalbedrijven, absoluut gezien, geconcentreerd zijn in de Randstad (1984, p. 104). Met behulp van een correctie door middel van het lokatiequotiënt bleek daarnaast, dat de kansrijke metaalbedrijven in de COROP-gebieden Zuidoost Noord-Brabant, Noord-Limburg en Het Gooi relatief sterk oververtegenwoordigd zijn ten opzichte van de totale bedrijvigheid in die regio's en dat in vele andere COROP-gebieden, ook buiten de Randstad, de kansrijke metaalnijverheid meer dan gemiddeld vertegenwoordigd is. Van een sterke regionale concentratie van de kansrijke metaalbedrijven was daarom nauwelijks sprake." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De eerste drie hoofdstukken kunnen worden gezien als de receptuur van een nieuw type produktiestructuurwaardering: de theorie in hoofdstuk 1, de methode in hoofdstuk 2 en de techniek in hoofdstuk 3. In hoofdstuk 4 wordt de ontwikkelde methode toegepast op de metaalindustrie in Nederland. Geanalyseerd wordt de periode 1981-1983 aan de hand van de Enquête Regionale Bedrijfsontwikkeling die jaarlijks door de Kamers van Koophandel en Fabrieken wordt uitgevoerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Zuidoost Noord-Brabant" ;
            sgpl:text_context "In een onderzoek naar de ruimtelijke spreiding van kansrijke economische activiteiten, door Alders en De Ruijter, bleek dat de huidige kansrijke metaalbedrijven, absoluut gezien, geconcentreerd zijn in de Randstad (1984, p. 104). Met behulp van een correctie door middel van het lokatiequotiënt bleek daarnaast, dat de kansrijke metaalbedrijven in de COROP-gebieden Zuidoost Noord-Brabant, Noord-Limburg en Het Gooi relatief sterk oververtegenwoordigd zijn ten opzichte van de totale bedrijvigheid in die regio's en dat in vele andere COROP-gebieden, ook buiten de Randstad, de kansrijke metaalnijverheid meer dan gemiddeld vertegenwoordigd is. Van een sterke regionale concentratie van de kansrijke metaalbedrijven was daarom nauwelijks sprake." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Bondsrepubliek Duitsland" ;
            sgpl:text_context "Agglomeratie-effecten: benaderd met behulp van urbanisatiegraad. Toegepast in de Bondsrepubliek Duitsland, gaf de theorie van Biehl een redelijke verklaring van regionale verschillen van het bruto regionaal produkt per capita. De theorie doet dit, ons inziens, op een inzichtelijke wijze en heeft een relatief geringe data-behoefte." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Oost-Nederland" ;
            sgpl:text_context "Het vijfde hoofdstuk past de in hoofdstuk 4 verworven kennis toe op drie regio's. De regionale sterkten van de provincies Utrecht en Limburg en de regio Oost-Nederland zullen, voorzover het de metaalindustrie betreft, worden opgespoord en benoemd. In het laatste hoofdstuk zal vervolgens voor de provincie Utrecht geprobeerd worden de regionale sterkten te implementeren in een sociaal-economisch beleid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747168 ;
            sgpl:spatialText "gemeente Sliedrecht" ;
            sgpl:text_context "In de navolgende beschouwing worden beide invalshoeken nader toegelicht. Een andere portfolio werd uitgevoerd door Groeneveld en Olij (1984) op een deel van de produktiestructuur van de gemeente Sliedrecht. Hierbij was het doel de herontwikkelingsmogelijkheden van een industrieterrein te identificeren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757345 ;
            sgpl:spatialText "Delft" ;
            sgpl:text_context "Het onderzoek werd mogelijk gemaakt door middel van een financiële injectie van de Rijksplanologische Dienst in het kader van haar doelsubsidie besteding. Het onderzoek is uitgevoerd in de vorm van een stage bij het Planologisch Studiecentrum TNO te Delft. Binnen het Planologisch Studiecentrum TNO is ondersteuning verleend door verschillende medewerkers." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "De regionale sterkten van de provincies Utrecht en Limburg en de regio Oost-Nederland zullen, voorzover het de metaalindustrie betreft, worden opgespoord en benoemd. In het laatste hoofdstuk zal vervolgens voor de provincie Utrecht geprobeerd worden de regionale sterkten te implementeren in een sociaal-economisch beleid. Voor de provincie Utrecht zullen concrete uitspraken worden gedaan ten aanzien van de ontwikkelingen in de metaalindustrie en hoe deze ontwikkelingen gestimuleerd kunnen worden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12325 ;
            sgpl:subjectText "metaalindustrie" ;
            sgpl:text_context "Het een en ander resulteerde in een produktiestructuur waarderingsmethodiek. De ontwikkelde methodiek wordt gedemonstreerd aan de hand van een case-study van de ontwikkelingen in de metaalindustrie, die zowel op nationaal niveau als in een drietal regio's is geanalyseerd. Het onderzoek werd mogelijk gemaakt door middel van een financiële injectie van de Rijksplanologische Dienst in het kader van haar doelsubsidie besteding." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionaal ontwikkelingspotentieel" ;
            sgpl:text_context "Het hiermee bedoelde beleid richt zich op de ontwikkeling van reeds bestaande sterkten. In dit verband kwam het begrip regionaal ontwikkelingspotentieel in zwang. De trend binnen het regionaal beleid vooral aandacht te geven aan regionale sterkten in plaats van zwakten staat niet los van ontwikkelingen binnen andere economische beleidsvelden." ],
        [ sgpl:refersToConcept unesco:concept2234 ;
            sgpl:subjectText "portfolio-analyse" ;
            sgpl:text_context "In hoofdstuk 1 zal de relatie worden gelegd tussen ontwikkelingspotenties en het functioneren van de regionale bedrijvigheid aan de hand van een overzicht van diverse onderzoeksbenaderingen ten aanzien van potenties. Het tweede hoofdstuk introduceert de bedrijfseconomische portfolio-analyse als een mogelijke produktiestructuur waarderingsmethodiek. Tevens zullen twee voorbeelden van eerdere toepassingen met een ruimtelijke component gegeven worden." ],
        [ sgpl:refersToConcept unesco:concept12325 ;
            sgpl:subjectText "metaalindustrie" ;
            sgpl:text_context "Het een en ander resulteerde in een produktiestructuur waarderingsmethodiek. De ontwikkelde methodiek wordt gedemonstreerd aan de hand van een case-study van de ontwikkelingen in de metaalindustrie, die zowel op nationaal niveau als in een drietal regio's is geanalyseerd. Het onderzoek werd mogelijk gemaakt door middel van een financiële injectie van de Rijksplanologische Dienst in het kader van haar doelsubsidie besteding." ],
        [ sgpl:refersToConcept unesco:concept444 ;
            sgpl:subjectText "regionaal ontwikkelingspotentieel" ;
            sgpl:text_context "Het hiermee bedoelde beleid richt zich op de ontwikkeling van reeds bestaande sterkten. In dit verband kwam het begrip regionaal ontwikkelingspotentieel in zwang. De trend binnen het regionaal beleid vooral aandacht te geven aan regionale sterkten in plaats van zwakten staat niet los van ontwikkelingen binnen andere economische beleidsvelden." ],
        [ sgpl:refersToConcept unesco:concept2234 ;
            sgpl:subjectText "portfolio-analyse" ;
            sgpl:text_context "In hoofdstuk 1 zal de relatie worden gelegd tussen ontwikkelingspotenties en het functioneren van de regionale bedrijvigheid aan de hand van een overzicht van diverse onderzoeksbenaderingen ten aanzien van potenties. Het tweede hoofdstuk introduceert de bedrijfseconomische portfolio-analyse als een mogelijke produktiestructuur waarderingsmethodiek. Tevens zullen twee voorbeelden van eerdere toepassingen met een ruimtelijke component gegeven worden." ] ;
    sgpl:thesisID 129 .

sgpl:Thesis130 a sgpl:SGPLThesis ;
    dcterms:creator "Henk Luitjes",
        "Ingrid Schrauwen" ;
    dcterms:issued 1984 ;
    dcterms:title "BOERDERIJVERPLAATSING EN LEEFBAARHEID",
        "Enkele effecten van boerderijverplaatsing in de ruilverkaveling Lek en Linge op een aantal leefbaarheidsdimensies.",
        "TUSSEN LEK EN LINGE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Brabant" ;
            sgpl:text_context "Behorende tot de centrale open ruimte wordt het rivierenland zowel uit het noorden door de provincie Utrecht als in het zuiden door Brabant door verstedelijking bedreigd. Doch ook het rivierenland zelf kampt met de nodige problemen, zoals sterke achteruitgang in de werkgelegenheid. Het rivierenland is landschappelijk en natuurlijk zeer aantrekkelijk ten gevolge van een grote variatie aan landschapselementen als dijken, uiterwaarden, polders en dergelijke." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746162 ;
            sgpl:spatialText "Tricht" ;
            sgpl:text_context "Het nieuw gebouwde gemaal de Neust bij Tricht draagt hier ook zeker toe bij. Door de ruilverkaveling is de verkavelingssituatie ook sterk veranderd. Per bedrijf zijn nu gemiddeld 3,6 kavels aanwezig met een gemiddelde grootte van 4,76 ha." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "Behorende tot de centrale open ruimte wordt het rivierenland zowel uit het noorden door de provincie Utrecht als in het zuiden door Brabant door verstedelijking bedreigd. Doch ook het rivierenland zelf kampt met de nodige problemen, zoals sterke achteruitgang in de werkgelegenheid. Het rivierenland is landschappelijk en natuurlijk zeer aantrekkelijk ten gevolge van een grote variatie aan landschapselementen als dijken, uiterwaarden, polders en dergelijke." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "natuurreservaat de Regulieren" ;
            sgpl:text_context "En van de meest waardevolle van de lager gelegen komgronden in het centrum van het gebied is tijdens de ruilverkaveling met hulp van Provincie en Rijk veilig gesteld en overgedragen aan het Gelders Landschap. Dit is het 185 ha grote natuurreservaat de Regulieren. De Regulieren bestaat voornamelijk uit vochtige komkleigraslandgrond (113 ha), dat beheerd wordt met een extensief gras- maailandregime." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De West-Betuwe is n van de nieuwe onderzoeksgebieden. Gelegen in het hart van Nederland heeft het ruimtelijk een zeer moeilijke positie. Doch ook het rivierenland zelf kampt met de nodige problemen, zoals sterke achteruitgang in de werkgelegenheid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757871,
                geonames:2758052,
                geonames:2758095,
                geonames:2759006,
                geonames:2759288 ;
            sgpl:spatialText "gemeenten Beesd, Beusichem, Buren, Buurmalsen en Culemborg" ;
            sgpl:text_context "Het gebied, waar het onderzoek is verricht, is het ruilverkavelingsgebied Lek-Linge (zie fig.2.1). De ruilverkaveling omvat een gebied van 7700 ha gelegen in de gemeenten Beesd, Beusichem, Buren, Buurmalsen en Culemborg met eveneens de kernen Zoelmond, Asch, Rhenoy en Acquoy en delen van Tricht. In verband met de gemeentelijke herindeling zijn dit geworden de gemeenten Buren, Culemborg en Geldermalsen (fig.2.2)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751572 ;
            sgpl:spatialText "Lek en Linge" ;
            sgpl:text_context "BOERDERIJVERPLAATSING EN LEEFBAARHEID TUSSEN LEK EN LINGE. Enkele effecten van boerderijverplaatsing in de ruilverkaveling Lek en Linge op een aantal leefbaarheidsdimensies. Henk Luitjes Ingrid Schrauwen Aan 150 boerinnen n boeren tussen Linge en Lek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756890 ;
            sgpl:spatialText "Diefdijk" ;
            sgpl:text_context "Het open karakter van het graslandgebied met zijn smalle opstrekkende kavels zonder bebouwing werd in de lagere delen onderbroken door vrij veel grienden, grienden die doorpldnt werden met populieren en al dan niet verlande eendekooien. Zeer aantrekkelijke visueel ruimtelijke kenmerken in het gebied zijn de Diefdijk met omgeving die het ruilverkavelingsblok aan de westzijde begrenst. Een ander belangrijk element in het landschap vormde, en vormt nog steeds, de oeverwallen bestaande uit stroomrug- en overslaggronden die het gebied aan de noordoost- en zuidzijde afsluiten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:12022127 ;
            sgpl:spatialText "West-Betuwe" ;
            sgpl:text_context "Na het afbouwen van het Zuidwest-Frieslandproject is de vakgroep SGS-landelijke gebieden haar onderzoeksterrein naar de regio Utrecht gaan verleggen. De West-Betuwe is n van de nieuwe onderzoeksgebieden. Gelegen in het hart van Nederland heeft het ruimtelijk een zeer moeilijke positie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Vijfherenland" ;
            sgpl:text_context "De werkgroep voor Natuurbehoud en Milieubeheer \"Noordwest Betuwe\" zou het reservaat de Regulieren liever nog verder uitgebreid zien. Eventueel zelfs in aansluiting tot het natuurgebied in het Vijfherenland ten westen van de Diefdijk. Boerderijverplaatsing in de ruilverkaveling Lek-Linge." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "Leefbaarheid" ;
            sgpl:text_context "Leefbaarheid op zich is moeilijk te evalueren, daar ieder individu leefbaarheid verschillend beleeft; het is een aggregatie van individuele percepties. Leefbaarheid probeert uit te drukken de wisselwerking die er bestaat tussen het individu en zijn fysiek-ruimtelijke en sociaal-ruimtelijke omgeving. De ruilverkaveling heeft o.a. met zijn boerderijverplaatsing, kavelverandering en infrastructuurverbetering de fysiek-ruimtelijke omgeving gewijzigd en daarmee ook de sociale processen in het gebied beïnvloed (Veldman,1981)." ],
        [ sgpl:refersToConcept unesco:concept12784 ;
            sgpl:subjectText "Boerderijverplaatsing" ;
            sgpl:text_context "In dit onderzoek ligt het accent op de leefomstandigheden van de individuele boer zoals die zich feitelijk voordoen en zoals deze door de boer en zijn partner worden gepercipieerd. Als centrale relatie in het onderzoek is gekozen voor het effect dat boerderijverplaatsing binnen ruilverkavelingsverband heeft op de leefomstandigheden van de betrokken boeren. Van Kampen (1977) veronderstelt, dat de leefbaarheid voor met name de vervoersarme groepen zoals ouden van dagen en de jeugd tot 16 jaar is afgenomen als gevolg van de afname van het aantal agrariërs op het platteland en daarmee de toename van de afstanden tot de buren en op de lange duur tot de verzorgingskernen." ],
        [ sgpl:refersToConcept unesco:concept8391 ;
            sgpl:subjectText "Ruilverkaveling" ;
            sgpl:text_context "De situatie van de dure gesubsidieerde overproductie van o.a. zuivelproducten, die een gevolg is van het gehanteerde landbouwstructuurbeleid, dient volgens velen te worden veranderd. Ook de ruilverkaveling als één van de belangrijkste instrumenten van het structuurbeleid staat ter discussie. De vraag in dit verband is namelijk in hoeverre voortgaande intensivering en schaalvergroting van de landbouwproductie via ruilverkaveling dient te worden gestimuleerd, gelet op de vele maatschappelijke en ecologische neveneffecten." ],
        [ sgpl:refersToConcept unesco:concept12784 ;
            sgpl:subjectText "Boerderijverplaatsing" ;
            sgpl:text_context "In dit onderzoek ligt het accent op de leefomstandigheden van de individuele boer zoals die zich feitelijk voordoen en zoals deze door de boer en zijn partner worden gepercipieerd. Als centrale relatie in het onderzoek is gekozen voor het effect dat boerderijverplaatsing binnen ruilverkavelingsverband heeft op de leefomstandigheden van de betrokken boeren. Van Kampen (1977) veronderstelt, dat de leefbaarheid voor met name de vervoersarme groepen zoals ouden van dagen en de jeugd tot 16 jaar is afgenomen als gevolg van de afname van het aantal agrariërs op het platteland en daarmee de toename van de afstanden tot de buren en op de lange duur tot de verzorgingskernen." ],
        [ sgpl:refersToConcept unesco:concept8391 ;
            sgpl:subjectText "Ruilverkaveling" ;
            sgpl:text_context "De situatie van de dure gesubsidieerde overproductie van o.a. zuivelproducten, die een gevolg is van het gehanteerde landbouwstructuurbeleid, dient volgens velen te worden veranderd. Ook de ruilverkaveling als één van de belangrijkste instrumenten van het structuurbeleid staat ter discussie. De vraag in dit verband is namelijk in hoeverre voortgaande intensivering en schaalvergroting van de landbouwproductie via ruilverkaveling dient te worden gestimuleerd, gelet op de vele maatschappelijke en ecologische neveneffecten." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "Leefbaarheid" ;
            sgpl:text_context "Leefbaarheid op zich is moeilijk te evalueren, daar ieder individu leefbaarheid verschillend beleeft; het is een aggregatie van individuele percepties. Leefbaarheid probeert uit te drukken de wisselwerking die er bestaat tussen het individu en zijn fysiek-ruimtelijke en sociaal-ruimtelijke omgeving. De ruilverkaveling heeft o.a. met zijn boerderijverplaatsing, kavelverandering en infrastructuurverbetering de fysiek-ruimtelijke omgeving gewijzigd en daarmee ook de sociale processen in het gebied beïnvloed (Veldman,1981)." ] ;
    sgpl:thesisID 130 .

sgpl:Thesis131 a sgpl:SGPLThesis ;
    dcterms:creator "Erni Olde Loohuis-Morssinkhof",
        "Marijke Kloosterman" ;
    dcterms:issued 1984 ;
    dcterms:title "EEN ECONOMISCH-GEOGRAFISCHE CASE-STUDIE IN DE GEMEENTEN DOORN, LOOSDRECHT EN RHENEN.",
        "TOERISME/RECREATIE en WERKGELEGENHEIDsaspecten" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743977 ;
            sgpl:spatialText "Zeist" ;
            sgpl:text_context "Zo worden onder andere de bossen rond Lage Vuursche, ten Noorden van Zeist en de Amerongse Berg als te ontlasten gebieden aangegeven. Nieuwe voorzieningen moeten zoveel mogelijk buiten de bosgebieden en dichtbij de woonbebouwing worden gesitueerd. Dit is met name in het noordwestelijk deel van de Heuvelrug aan de orde." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756686 ;
            sgpl:spatialText "Kaapse Bossen bij Doorn" ;
            sgpl:text_context "De zandafgraving De Dikkenberg kan dan als concentratiepunt dienen met een totale dagcapaciteit van 1000 recreanten. In het plan worden ook enkele voorzieningen voorgesteld om de Kaapse Bossen bij Doorn te ontlasten; dergelijka voorzieningen zullen bestaan uit een parkeerplaats met een startpunt voor een wandelroute en een picknickplaats. Ten aanzien van de verblijfsrecreatie wordt het consoliderend beleid onderschreven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Kamer van Koophandel te Utrecht" ;
            sgpl:text_context "De medewerking die we van de kant van de gemeenten Doorn, Loosdrecht en Rhenen, van hun respectievelijke middenstandsverenigingen, de Loosdrechtse vereniging van watersportbedrijven, de lokale VW’s, de Kamer van Koophandel te Utrecht en niet in de laatste plaats de ge22nqueteerde bedrijven kregen, zijn van grote waarde gebleken bij de realisering van dit onderzoek. Daarnaast zijn we de Stichting Recreatie te ’s-Gravenhage zeer erkentelijk; hier was alle benodigde literatuur aanwezig en voor ons beschikbaar. Tenslotte willen we drs. G.M.R.A. van Oort bedanken voor zijn begeleiding in de verschillende onderzoeks-fasen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "In de omgeving van Amersfoort bij het landgoed Den Treek zal een zone voor de opvang van extensieve recreatievormen ontwikkeld worden, welke ruimte moet bieden aan 1500 tot 2000 recreanten. Deze zone moet aansluiten aan de groene zones om Amersfoort. Ook ten zuidwesten van Veenendaal is een zone voor extensief gebruik, met name wandelen, gepland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756686 ;
            sgpl:spatialText "Huis Doorn" ;
            sgpl:text_context "De locatie van logiesverstrekkende bedrijven lijkt invloed te hebben op het aantal overnachtingen; zo is er vlakbij Huis Doorn, een bezienswaardigheid voor met name Duitse bustoeristen en een bezoekersaantal van ruim 65.000 in 1983, een hotel gelegen dat met nog geen 20 bedden wel 1550 overnachtingen heeft. Voor wat betreft de jachthavensector is het aantal ligplaatsen bepalend voor de grootte. We onderscheiden natte ligplaatsen in het water en droge ligplaatsen voor met name kleinere zeilboten en surfplanken op de wal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745493,
                geonames:8714374 ;
            sgpl:spatialText "Vinkeveense en Loosdrechtse Plassen" ;
            sgpl:text_context "Het gaat hier onder andere om de Utrechtse Heuvelrug, het Plassengebied en het Kromme Rijngebied. Voor wat betreft de watersport worden de Vinkeveense en Loosdrechtse Plassen ook als consolideringsgebied voor ligplaatsen aangeduid. De behoeftenraming van het structuurschema gaat uit van een verdere daling van het binnenlands vakantie-aandeel tot 35% in 1995." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de Utrechtse Heuvelrug" ;
            sgpl:text_context "In dit type onderzoek worden de effecten van activiteiten van stedelijke ruimtegebruikers in de beschouwing betrokken. Ons onderzoeksterrein, het plassengebied bij Loosdrecht en de Utrechtse Heuvelrug, kan gezien worden als peri-urbaan gebied dat te maken heeft met de uitwaaiiering van stedelijke activiteiten, zoals onder andere recreatie. Studie van het verschijnsel recreatie kan zich richten op verschillende facetten, bijvoorbeeld op de ruimtelijke context, op de welzijnsdimendie of zoals in dit onderzoek op de economische betekenis." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "In de provincie Utrecht is de recreatiedruk groot en in verband met schade aan natuur en milieu worden grote delen als consolideringsgebied voor de verblijfsrecreatie, dan wel als prioriteitsgebied voor recreatief medegebruik aangeduid. Het gaat hier onder andere om de Utrechtse Heuvelrug, het Plassengebied en het Kromme Rijngebied. Voor wat betreft de watersport worden de Vinkeveense en Loosdrechtse Plassen ook als consolideringsgebied voor ligplaatsen aangeduid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De algemene verhouding tussen full-time en part-time werk in Nederland ten opzichte van die in de toeristisch-recreatieve sector in de onderzoeksgemeenten (in percentages. Het aantal mensjaren verdeeld over full-time en part-time werk in alle onderzochte bedrijven en in de van toerisme/recreatie afhankelijke bedrijven (absoluut). Percentage bedrijven dat het (hoog)seizoen heeft in de maanden juni, juli, augustus en november, december." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748184,
                geonames:2756686,
                geonames:8714374 ;
            sgpl:spatialText "de gemeenten Doorn, Loosdrecht en Rhenen" ;
            sgpl:text_context "Wat wel 'nieuw' is, is het schaalniveau. We hebben ons namelijk gericht op de gemeenten Doorn, Loosdrecht en Rhenen en dus op het lokale niveau. Bij veel economische studies ligt de nadruk op nationale of regionale schaal. Of de uitkomsten en ramingen hiervan, vaak op basis van input-output-modellen lokaal wel dezelfde impact hebben als op de hogere schaalniveau’s is veelal niet bekend." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Het gebied ligt tegen de Noordvleugel van de Randstad en vervult een belangrijke functie als recreatiegebied, zowel voor de extensieve als voor de intensieve recreatie. Ten gevolge van de toename van de mobiliteit en de toename van de vrije tijd is de recreatiedruk de laatste decennia voortdurend toegenomen. Om het waardevolle karakter van dit gebied - veenweide-, plassen- en rivierengebied - in stand te houden wordt de oplossing van de recreatieproblematiek in grote lijnen bepaald door de volgende doelstellingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Eist" ;
            sgpl:text_context "Bij de kleine passantenhaven (30 ligplaatsen) en de veerstoep in Eist oevervoorzieningen als speel- en ligweides en parkeermogelijkheden aanbrengen. Hoewel de gemeente Doom de uitgangspunten van het streekplan Utrecht Oost en van het recreatiebasisplan Utrechtse Heuvelrug en Valleigebied in grote lijnen onderschrijft, wijkt de gemeentelijke visie ten aanzien van de verblijfsrecreatieve terreinen enigszins af van het door de provincie voorgestane beleid. Dit gaat ervan uit dat de maximaal toelaatbare recreatiedruk reeds bereikt is, terwijl de gemeente nog wel wat uitbreiding wil toestaan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745774 ;
            sgpl:spatialText "Veenendaal" ;
            sgpl:text_context "Deze zone moet aansluiten aan de groene zones om Amersfoort. Ook ten zuidwesten van Veenendaal is een zone voor extensief gebruik, met name wandelen, gepland. Het bosgebied tussen Veenendaal en Rhenen kan nog meer recreanten opvangen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Stichting Recreatie te ’s-Gravenhage" ;
            sgpl:text_context "De medewerking die we van de kant van de gemeenten Doorn, Loosdrecht en Rhenen, van hun respectievelijke middenstandsverenigingen, de Loosdrechtse vereniging van watersportbedrijven, de lokale VW’s, de Kamer van Koophandel te Utrecht en niet in de laatste plaats de ge22nqueteerde bedrijven kregen, zijn van grote waarde gebleken bij de realisering van dit onderzoek. Daarnaast zijn we de Stichting Recreatie te ’s-Gravenhage zeer erkentelijk; hier was alle benodigde literatuur aanwezig en voor ons beschikbaar. Tenslotte willen we drs. G.M.R.A. van Oort bedanken voor zijn begeleiding in de verschillende onderzoeks-fasen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:8714374 ;
            sgpl:spatialText "het plassengebied bij Loosdrecht" ;
            sgpl:text_context "In dit type onderzoek worden de effecten van activiteiten van stedelijke ruimtegebruikers in de beschouwing betrokken. Ons onderzoeksterrein, het plassengebied bij Loosdrecht en de Utrechtse Heuvelrug, kan gezien worden als peri-urbaan gebied dat te maken heeft met de uitwaaiiering van stedelijke activiteiten, zoals onder andere recreatie. Studie van het verschijnsel recreatie kan zich richten op verschillende facetten, bijvoorbeeld op de ruimtelijke context, op de welzijnsdimendie of zoals in dit onderzoek op de economische betekenis." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Heidelberglaan 2, De Uithof, Utrecht" ;
            sgpl:text_context "vakgroep sociale geografie van de stedelijk-industri61le landen. II, Heidelberglaan 2, De Uithof, Utrecht (030)532044. TOERISME/rECREATIE en WERKGELEGENHEIDsaspecten EEN ECONOMISCH-GEOGRAFISCHE CASE-STUDIE IN DE GEMEENTEN DOORN, LOOSDRECHT EN RHENEN." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept682 ;
            sgpl:subjectText "Werkgelegenheid" ;
            sgpl:text_context "De stuwende activiteiten en de erdoor gecreëerde arbeidsplaatsen hebben een stimulerende invlod op verzorgende activiteiten (DE JAGER 1980, pp. 62-63). Met name het werkgelegenheidsaspect van de recreatie staat in deze tijd van excessief hoge werkloosheid sterk in de belangstelling. Vooral in beleidskringen beschouwt men toerisme/recreatie als een groeisector die de terugloop van het aantal arbeidsplaatsen in andere bedrijfstakken zou kunnen opvangen." ],
        [ sgpl:refersToConcept unesco:concept5951 ;
            sgpl:subjectText "Economische betekenis" ;
            sgpl:text_context "Het thema van ons onderzoek is gekozen binnen de specialisatierichting \"geografie van de landelijke gebieden\". Het betreft de economische betekenis van toerisme en recreatie op lokale schaal, welke in tegenstelling tot de nationale- en regionale schaal, tot nu toe slechts sporadisch belangstelling heeft gekregen. De medewerking die we van de kant van de gemeenten Doorn, Loosdrecht en Rhenen, van hun respectievelijke middenstandsverenigingen, de Loosdrechtse vereniging van watersportbedrijven, de lokale VW’s, de Kamer van Koophandel te Utrecht en niet in de laatste plaats de geënqueteerde bedrijven kregen, zijn van grote waarde gebleken bij de realisering van dit onderzoek." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "Toeristisch-recreatieve sector" ;
            sgpl:text_context "Er zal geen totaalbeeld van de toeristisch-recreatieve sector worden gegeven, aangezien de specifieke reissector (reisbureau’s, WV’s en dergelijk) en de nonprofit-sector (NBT, NRITetc.) buiten beschouwing blijven. Het gaat ons erom een indruk te krijgen van het particuliere toeristisch-recreatieve bedrijfsleven aangezien vooral daar de verwachtingen met betrekking tot inkomens- en werkgelegenheidsgroei waargemaakt zullen moeten worden. De overheid zelf maakt immers een pas op de plaats met haar bezuinigingen." ],
        [ sgpl:refersToConcept unesco:concept682 ;
            sgpl:subjectText "Werkgelegenheid" ;
            sgpl:text_context "De stuwende activiteiten en de erdoor gecreëerde arbeidsplaatsen hebben een stimulerende invlod op verzorgende activiteiten (DE JAGER 1980, pp. 62-63). Met name het werkgelegenheidsaspect van de recreatie staat in deze tijd van excessief hoge werkloosheid sterk in de belangstelling. Vooral in beleidskringen beschouwt men toerisme/recreatie als een groeisector die de terugloop van het aantal arbeidsplaatsen in andere bedrijfstakken zou kunnen opvangen." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "Toeristisch-recreatieve sector" ;
            sgpl:text_context "Er zal geen totaalbeeld van de toeristisch-recreatieve sector worden gegeven, aangezien de specifieke reissector (reisbureau’s, WV’s en dergelijk) en de nonprofit-sector (NBT, NRITetc.) buiten beschouwing blijven. Het gaat ons erom een indruk te krijgen van het particuliere toeristisch-recreatieve bedrijfsleven aangezien vooral daar de verwachtingen met betrekking tot inkomens- en werkgelegenheidsgroei waargemaakt zullen moeten worden. De overheid zelf maakt immers een pas op de plaats met haar bezuinigingen." ],
        [ sgpl:refersToConcept unesco:concept5951 ;
            sgpl:subjectText "Economische betekenis" ;
            sgpl:text_context "Het thema van ons onderzoek is gekozen binnen de specialisatierichting \"geografie van de landelijke gebieden\". Het betreft de economische betekenis van toerisme en recreatie op lokale schaal, welke in tegenstelling tot de nationale- en regionale schaal, tot nu toe slechts sporadisch belangstelling heeft gekregen. De medewerking die we van de kant van de gemeenten Doorn, Loosdrecht en Rhenen, van hun respectievelijke middenstandsverenigingen, de Loosdrechtse vereniging van watersportbedrijven, de lokale VW’s, de Kamer van Koophandel te Utrecht en niet in de laatste plaats de geënqueteerde bedrijven kregen, zijn van grote waarde gebleken bij de realisering van dit onderzoek." ] ;
    sgpl:thesisID 131 .

sgpl:Thesis132 a sgpl:SGPLThesis ;
    dcterms:creator "L.J. Paul" ;
    dcterms:issued 1984 ;
    dcterms:title "HET I.M.F. EN AFRIKA",
        "HET VOORBEELD MALI" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Latijns-Amerika" ;
            sgpl:text_context "Centraal zal daarbij staan de vraag of de specifieke situatie van Afrika ten zuiden van de Sahara leidt tot een ander IMF-Afrika beleid, en tot andere gevolgen van een ekonomische aanpassingspolitiek in vergelijking tot met name Latijns-Amerika. Kortom, misschien geen geografische scriptie, wel een scriptie door een geograaf geschreven. Met dit laatste wordt allerminst gepretendeerd dat dankzij die integrerende benadering nu eindelijk het volmaakte verhaal is gescireven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2287781 ;
            sgpl:spatialText "Ivoorkust" ;
            sgpl:text_context "Mali kent een groot aantal kleine en grotere ethnische groepen, waarvan de woongebieden zich vaak over de landsgrenzen uitstrekken. Ca. 9% van de Malinezen woont buiten de landsgrenzen: ongeveer 600.000 in Ivoorkust, 12.000 in Senegal en 35.000 in Frankrijk. Zij zijn meestal weggetrokken om ekonomische redenen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2453866 ;
            sgpl:spatialText "Mali" ;
            sgpl:text_context "Deze landenevaluatie, waarin de macro-ekonomische situatie van Mali centraal stond, bood de gelegenheid om op verschillende niveau*s en met een theoretische achtergrond in kontakt te komen met de praktijk van het ontwikkelingsvraagstuk en de ontwikkelingshulp. Mali bleek zich te bevinden in een turbulente tijd van ingrijpende politieke en ekonomische hervormingen, waarin het Internationaal Monetaire Fonds een belangrijke rol speelde. Het geven van een oordeel over deze hervormingen impliceerde een oordeelsvorming over de rol die de Malinese overheid had gespeeld in de ekonomische ontwikkeling van het land vanaf de onafhankelijkheid, in het licht van internationale politieke en ekonomische verhoudingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2245662 ;
            sgpl:spatialText "Senegal" ;
            sgpl:text_context "Mali kent een groot aantal kleine en grotere ethnische groepen, waarvan de woongebieden zich vaak over de landsgrenzen uitstrekken. Ca. 9% van de Malinezen woont buiten de landsgrenzen: ongeveer 600.000 in Ivoorkust, 12.000 in Senegal en 35.000 in Frankrijk. Zij zijn meestal weggetrokken om ekonomische redenen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het geven van een oordeel over deze hervormingen impliceerde een oordeelsvorming over de rol die de Malinese overheid had gespeeld in de ekonomische ontwikkeling van het land vanaf de onafhankelijkheid, in het licht van internationale politieke en ekonomische verhoudingen. Dit wekte de interesse op om na terugkeer in Nederland de rol van het IMF in de Derde Wereld, en Afrika in het bijzonder, nader te onderzoeken. Dit heeft ertoe geleid, en dat kan ook moeilijk anders met dit onderwerp, dat deze scriptie zeer ekonomisch getint is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2460596 ;
            sgpl:spatialText "Bamako" ;
            sgpl:text_context "De interne migratie bedraagt ongeveer 0,6% van de rurale bevolking per jaar, en is vooral gericht op Bamako. De urbanisatiegraad in Mali bedraagt ongeveer 19s£°Van de stedelingen woont de helft in Bamako (nu ongeveer 675.000 inwoners), hierna volgen op ruime afstand Ségou (75.000 inw.), Mopti, Sikasso, Kayes en Gao. Administratief is Mali onderverdeeld in 7 regio’s, 46 cercle’s en 281 arrondissementen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6255146 ;
            sgpl:spatialText "Afrika ten zuiden van de Sahara" ;
            sgpl:text_context "In deze scriptie zal geprobeerd worden om vanuit een regionaal perspectief de problematiek van het IMF en de ontwikkelingslanden te benaderen. Centraal zal daarbij staan de vraag of de specifieke situatie van Afrika ten zuiden van de Sahara leidt tot een ander IMF-Afrika beleid, en tot andere gevolgen van een ekonomische aanpassingspolitiek in vergelijking tot met name Latijns-Amerika. Kortom, misschien geen geografische scriptie, wel een scriptie door een geograaf geschreven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6255146 ;
            sgpl:spatialText "Afrika" ;
            sgpl:text_context "Het geven van een oordeel over deze hervormingen impliceerde een oordeelsvorming over de rol die de Malinese overheid had gespeeld in de ekonomische ontwikkeling van het land vanaf de onafhankelijkheid, in het licht van internationale politieke en ekonomische verhoudingen. Dit wekte de interesse op om na terugkeer in Nederland de rol van het IMF in de Derde Wereld, en Afrika in het bijzonder, nader te onderzoeken. Dit heeft ertoe geleid, en dat kan ook moeilijk anders met dit onderwerp, dat deze scriptie zeer ekonomisch getint is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Doktoraalscriptie in het kader van de vrije-studierichting sociale geografie. Geografisch Instituut der Rijksuniversiteit Utrecht. December 1984." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1335 ;
            sgpl:subjectText "aanpassingspolitiek" ;
            sgpl:text_context "Gepleit wordt dan ook voor een andere benadering van de Afrikaanse situatie. In deze scriptie zal bekeken worden of deze kritiek gedeeld kan worden. Daarbij wordt uitgegaan van de volgende probleemstelling: 'Waaruit bestaat de aanpassingspolitiek die het IMF aan veel Afrikaanse landen voorschrijft, en hoe moet deze politiek beoordeeld worden, tegen de achtergrond van ontstaan en funktie van het IMF, en de achterliggende oorzaken van betalingsbalanstekorten en ekonomische problemen van Afrika ten zuiden van de Sahara.' Daartoe zal een antwoord gezocht worden op de volgende onderzoeksvragen: - welke rol speelt het IMF in het internationale monetaire stelsel, en hoe heeft het monetaire stelsel zich in de loop der tijd ontwikkeld?" ],
        [ sgpl:refersToConcept unesco:concept7248 ;
            sgpl:subjectText "Internationaal Monetair Fonds" ;
            sgpl:text_context "Deze landenevaluatie, waarin de macro-ekonomische situatie van Mali centraal stond, bood de gelegenheid om op verschillende niveau's en met een theoretische achtergrond in kontakt te komen met de praktijk van het ontwikkelingsvraagstuk en de ontwikkelingshulp. Mali bleek zich te bevinden in een turbulente tijd van ingrijpende politieke en ekonomische hervormingen, waarin het Internationaal Monetaire Fonds een belangrijke rol speelde. Het geven van een oordeel over deze hervormingen impliceerde een oordeels-vorming over de rol die de Malinese overheid had gespeeld in de ekonomische ontwikkeling van het land vanaf de onafhankelijkheid, in het licht van internationale politieke en ekonomische verhoudingen." ],
        [ sgpl:refersToConcept unesco:concept3521 ;
            sgpl:subjectText "betalingsbalans" ;
            sgpl:text_context "Afrika is het laatste decennium gekonfronteerd met dalende inkomsten uit de export, verslechterde externe omstandigheden (droogte en een mondiale ekonomische recessie) maar ook met een groeiend overheidsapparaat en inefficiënt geleide nationale ekonomieën. De betalingsbalans raakte uit het evenwicht, hetgeen vaak leidde tot importbeperkingen. Door deze importbeperkingen werden echter weer vitale delen van de exportsektor aangetast, hetgeen weer leidde tot nog geringere exportopbrengsten." ],
        [ sgpl:refersToConcept unesco:concept7248 ;
            sgpl:subjectText "Internationaal Monetair Fonds" ;
            sgpl:text_context "Deze landenevaluatie, waarin de macro-ekonomische situatie van Mali centraal stond, bood de gelegenheid om op verschillende niveau's en met een theoretische achtergrond in kontakt te komen met de praktijk van het ontwikkelingsvraagstuk en de ontwikkelingshulp. Mali bleek zich te bevinden in een turbulente tijd van ingrijpende politieke en ekonomische hervormingen, waarin het Internationaal Monetaire Fonds een belangrijke rol speelde. Het geven van een oordeel over deze hervormingen impliceerde een oordeels-vorming over de rol die de Malinese overheid had gespeeld in de ekonomische ontwikkeling van het land vanaf de onafhankelijkheid, in het licht van internationale politieke en ekonomische verhoudingen." ],
        [ sgpl:refersToConcept unesco:concept1335 ;
            sgpl:subjectText "aanpassingspolitiek" ;
            sgpl:text_context "Gepleit wordt dan ook voor een andere benadering van de Afrikaanse situatie. In deze scriptie zal bekeken worden of deze kritiek gedeeld kan worden. Daarbij wordt uitgegaan van de volgende probleemstelling: 'Waaruit bestaat de aanpassingspolitiek die het IMF aan veel Afrikaanse landen voorschrijft, en hoe moet deze politiek beoordeeld worden, tegen de achtergrond van ontstaan en funktie van het IMF, en de achterliggende oorzaken van betalingsbalanstekorten en ekonomische problemen van Afrika ten zuiden van de Sahara.' Daartoe zal een antwoord gezocht worden op de volgende onderzoeksvragen: - welke rol speelt het IMF in het internationale monetaire stelsel, en hoe heeft het monetaire stelsel zich in de loop der tijd ontwikkeld?" ],
        [ sgpl:refersToConcept unesco:concept3521 ;
            sgpl:subjectText "betalingsbalans" ;
            sgpl:text_context "Afrika is het laatste decennium gekonfronteerd met dalende inkomsten uit de export, verslechterde externe omstandigheden (droogte en een mondiale ekonomische recessie) maar ook met een groeiend overheidsapparaat en inefficiënt geleide nationale ekonomieën. De betalingsbalans raakte uit het evenwicht, hetgeen vaak leidde tot importbeperkingen. Door deze importbeperkingen werden echter weer vitale delen van de exportsektor aangetast, hetgeen weer leidde tot nog geringere exportopbrengsten." ] ;
    sgpl:thesisID 132 .

sgpl:Thesis133 a sgpl:SGPLThesis ;
    dcterms:creator "J. van Plateringen" ;
    dcterms:issued 1984 ;
    dcterms:title "Afstandsgedrag en consumentenonderzoek" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rivierenwijk (Utrecht)" ;
            sgpl:text_context "De in het navolgende vermelde gegevens zijn opgehoogd tot het laatstgenoemde getal, waarbij rekening is gehouden met het in de enquête onevenredig hoog of laag vertegenwoordigd zijn van respondenten in bepaalde gebiedsdelen. Voor de 38 uiteindelijk samengestelde woonzones in het studiegebied kwam dit neer op ophoogfactoren welke varieerden van 42,59 voor Rivierenwijk (Utrecht) tot 11.88 voor de gemeente Schalkwijk (zie bijlage I voor aantallen respondenten en ophoogfactoren in de woonzones van het onderzoeksgebied). De hier gebruikte maat voor afstand is de door de consument in de consumenten—enquête opgegeven reistijd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747702 ;
            sgpl:spatialText "gemeente Schalkwijk" ;
            sgpl:text_context "De in het navolgende vermelde gegevens zijn opgehoogd tot het laatstgenoemde getal, waarbij rekening is gehouden met het in de enquête onevenredig hoog of laag vertegenwoordigd zijn van respondenten in bepaalde gebiedsdelen. Voor de 38 uiteindelijk samengestelde woonzones in het studiegebied kwam dit neer op ophoogfactoren welke varieerden van 42,59 voor Rivierenwijk (Utrecht) tot 11.88 voor de gemeente Schalkwijk (zie bijlage I voor aantallen respondenten en ophoogfactoren in de woonzones van het onderzoeksgebied). De hier gebruikte maat voor afstand is de door de consument in de consumenten—enquête opgegeven reistijd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750569 ;
            sgpl:spatialText "Muiden" ;
            sgpl:text_context "Dit werd echter beschouwd als een te subjectieve methode, waarbij de onderlinge relaties tussen de koopstromen buiten beschouwing bleven. Met de Maxisstudie in Muiden werd het hanteren van een koopkrachtverdeelmodel gemeengoed bij consumentenonderzoek op regionale schaal. De huidige problematiek m.b.t. koopkrachtverdeelmodellen is vooral gelegen in de keuze van methoden en aannames." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "Stadsgewest Tilburg" ;
            sgpl:text_context "Bij d.p.o. Rijnland werd terugggevallen op de hemelsbrede afstand, waaarbij een extra afstandsvariabele werd opgenomen om een nuancering aan te brengen m.b.t winkelcentra met bijzondere kenmerken. In de d.p.o.'s Stadsgewest Tilburg en Gooi- en Vechtstreek werden aparte afstandsfuncties gespecificeerd voor zeer aantrekkelijke gebieden. Tabel : Gebruikte interactievariabelen bij koopkrachtverdeelmodellen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Bij het construeren van de reistijdenmatrices bleek, dat voor een groot aantal combinaties van woon— en winkelzones geen waarnemingen bestonden, terwijl tevens een aantal onwaarschijnlijkheden in het materiaal aanwezig waren. zo liep een consument in 5 minuten naar Amsterdam. Na een selectie- procedure werden uit de bruikbare gegevens gemiddelde reistijden (per ver- voermiddel) berekend, waarmee een (hemelsbrede) afstandenmatrix in een reistijdenmatrix kon worden omgezet (de Jong, 1981)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751687 ;
            sgpl:spatialText "Leusden" ;
            sgpl:text_context "Deze doctoraalscriptie is geschreven in het kader van studie in de Sociale Geografie van de Stedelijk-industriële landen aan de Rijksuniversiteit te Utrecht en kwam tot stand mede dankzij de begeleiding van drs. J.G. Borchert. Voor het typewerk ben ik dank verschuldigd aan Inge Been, die daartoe in staat gesteld werd door Pon’s Automobielhandel B.V. te Leusden. J. van Plateringen, Zeist, 1984." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Hoog Catharijne" ;
            sgpl:text_context "Anders dan bij dagelijkse artikelen zien we bij de aankoop van duurzame goederen dat de gemiddelde frequentie per verkoopuur op zaterdag het hoogst is, gevolgd door koopavond. Gezien het domineren van grote winkelcentra als Hoog Catharijne en de Oude Binnenstad in Utrecht verwachten we bij de aankoop van duurzame goederen een verschil in aankoopfrequentie naar al of niet woonachtig zijn in de stad Utrecht. Tabel 5: Frequentie van winkelbezoek aan de eerste twee centra voor duurzame goederen, naar woonplaats (alleen doordeweeks, overdag)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrechtse regio" ;
            sgpl:text_context "In de enquête werd gevraagd naar de reistijd per vervoermiddel naar de gekozen winkelcentra voor duurzame en dagelijkse goederen. We willen in het praktische deel de opgegeven reistijd gebruiken om het afstandsgedrag van de consument in de Utrechtse regio nader te onderzoeken. Besloten zal worden met een evaluatie van het voorafgaande." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8726 ;
            sgpl:subjectText "koopkrachtverdeelmodellen" ;
            sgpl:text_context "Aspecten als vervoermiddelkeuze, frequentie van aankoop en de multipurpose-trip etc. zullen hierbij aan de orde komen. Vervolgens gaan we in op de koopkrachtverdeelmodellen, welke bij regionaal distributie-planologisch onderzoek gebruikt worden om het ruimtelijk koopgedrag te verklaren en voorspellen. De wijze, waarop interactie-/afstands- variabelen ingebouwd zijn, varieert veelal per onderzoek." ],
        [ sgpl:refersToConcept unesco:concept8237 ;
            sgpl:subjectText "afstandsgedrag" ;
            sgpl:text_context "Het vinden van een goede maat voor de afstands- en attractiefactor stuit in de praktijk van d.p.o. op problemen en leidt nog niet tot bevredigende resultaten. In het onderhavige willen we ingaan op het afstandsgedrag van consumenten van winkeldiensten. Daartoe verdiepen we ons allereerst in de theorievorming m.b.t. dit onderwerp." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "ruimtelijk koopgedrag" ;
            sgpl:text_context "Onderzoek naar het feitelijk gedrag van de gebruiker (consument) werd facultatief gesteld. In de praktijk echter zal men zelden een d.p.o. aantreffen zonder aandacht voor ruimtelijk koopgedrag. Naast aandacht voor de bestaande situatie is er de doelstelling van het toekomstonderzoek." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "ruimtelijk koopgedrag" ;
            sgpl:text_context "Onderzoek naar het feitelijk gedrag van de gebruiker (consument) werd facultatief gesteld. In de praktijk echter zal men zelden een d.p.o. aantreffen zonder aandacht voor ruimtelijk koopgedrag. Naast aandacht voor de bestaande situatie is er de doelstelling van het toekomstonderzoek." ],
        [ sgpl:refersToConcept unesco:concept8237 ;
            sgpl:subjectText "afstandsgedrag" ;
            sgpl:text_context "Het vinden van een goede maat voor de afstands- en attractiefactor stuit in de praktijk van d.p.o. op problemen en leidt nog niet tot bevredigende resultaten. In het onderhavige willen we ingaan op het afstandsgedrag van consumenten van winkeldiensten. Daartoe verdiepen we ons allereerst in de theorievorming m.b.t. dit onderwerp." ],
        [ sgpl:refersToConcept unesco:concept8726 ;
            sgpl:subjectText "koopkrachtverdeelmodellen" ;
            sgpl:text_context "Aspecten als vervoermiddelkeuze, frequentie van aankoop en de multipurpose-trip etc. zullen hierbij aan de orde komen. Vervolgens gaan we in op de koopkrachtverdeelmodellen, welke bij regionaal distributie-planologisch onderzoek gebruikt worden om het ruimtelijk koopgedrag te verklaren en voorspellen. De wijze, waarop interactie-/afstands- variabelen ingebouwd zijn, varieert veelal per onderzoek." ] ;
    sgpl:thesisID 133 .

sgpl:Thesis134 a sgpl:SGPLThesis ;
    dcterms:creator "G. Renting" ;
    dcterms:issued 1985 ;
    dcterms:title "'MARS- EN WESTERSTROOM'; EEN RUILVERKAVELING OP HET DRENTS PLATEAU, historisch-geografisch benaderd" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759633 ;
            sgpl:spatialText "Rjjksarchief te Assen" ;
            sgpl:text_context "Over Drenthe is redelijk veel literatuur op historisch-landschappelijk gebied verschenen; over het ruilverka- velingsgebied 'Mars- en Westerstroom' daarentegen nauwelijks. - archiefonderzoek. Diverse archieven in het Rjjksarchief te Assen werden geraadpleegd. Helaas ontbraken de grondschattingsregisterkaartjes (zg. Verpondingsveldwerk) van ca. 1640 voor het ruilverkavelingsgebied." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "ruilverkavelingsgebied 'Mars- en Westerstroom'" ;
            sgpl:text_context "Deze historisch-geografische studie is met name gebaseerd op een onderzoek ten behoeve van de Natuurwetenschappelijke Commissie van de Natuurbeschermingsraad, in het kader waarvan de auteur van september tot en met december 1983 als stagiair voor deze commissie werkzaam was. Het voor de Natuurwetenschappelijke Commissie verrichte onderzoek had betrekking op de historisch-landschappelljke waarden in het circa 6.000 hectare grote ruilverkavelingsgebied 'Mars- en Westerstroom' -grofweg de huidige gemeenten Oosterhesselen en Zweeloo- in zuidoost Drenthe: een typisch esdorpenlandschap. Het karakter ervan is de afgelopen decennia echter wel veranderd, omdat in ruilverkavelingen en kavelruilen binnen het gebied cultuurtechnische werken zijn uitgevoerd en ook door de boeren zelf allerlei incidentele werkzaamheden ter verhoging van de doelmatigheid hunner bedrijven, echter niet ter verfraai-ing van het landschap, werden uitgevoerd: kavelruilen, perceelsvergrotingen, egalisaties, sloten dempen en graven, opruimen en aanbrengen van beplantingen etc." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749461 ;
            sgpl:spatialText "gemeente Oosterhesselen" ;
            sgpl:text_context "Het voor de Natuurwetenschappelijke Commissie verrichte onderzoek had betrekking op de historisch-landschappelljke waarden in het circa 6.000 hectare grote ruilverkavelingsgebied 'Mars- en Westerstroom' -grofweg de huidige gemeenten Oosterhesselen en Zweeloo- in zuidoost Drenthe: een typisch esdorpenlandschap. Het karakter ervan is de afgelopen decennia echter wel veranderd, omdat in ruilverkavelingen en kavelruilen binnen het gebied cultuurtechnische werken zijn uitgevoerd en ook door de boeren zelf allerlei incidentele werkzaamheden ter verhoging van de doelmatigheid hunner bedrijven, echter niet ter verfraai-ing van het landschap, werden uitgevoerd: kavelruilen, perceelsvergrotingen, egalisaties, sloten dempen en graven, opruimen en aanbrengen van beplantingen etc. Met name in de jaren zeventig heeft dit geleid tot een vrij sterke landschappelijke waar den vermindering." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756631 ;
            sgpl:spatialText "Drents plateau" ;
            sgpl:text_context "In dat beeld past het Drents plateau. Dit is namelijk een weinig versneden zwakgolvende keileemvlakte met daarop gesuperponeerde dekzandruggen. Onder dergelijke omstandigheden zal een zekere ’burenbinding' prevaleren boven ’landbinding'." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Hierbij was de dissertatie van Brongers (’76) tevens zeer bruikbaar. - regelmatig werkoverleg met de twee begeleiders: Drs. J.D.H. Harten, historisch-geograaf, verbonden aan het Geo- grafisch Instituut der Rijksuniversiteit Utrecht. Drs. A. A.M. van Marrewijk, fysisch-geograaf, verbonden aan de Natuurwetenschappelijke Commissie van de matuurbeschermingsraad, even- eens te Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755664 ;
            sgpl:spatialText "Gees" ;
            sgpl:text_context "Het ruilverkavelingsgebied Mars- en Westerstroom ligt op het zuidoostelijk deel van het Drents plateau (zie afb. 4) en heeft een grootte van iets meer dan 6.000 hectare. Het gebied valt voor een zeer groot deel samen met de huidige gemeenten Oosterhesselen en Zweeloo en omvat de dorpen Gees, Oosterhesselen, Aaiden, Benneveld, Meppen, Wezup en Zweeloo. Het is een typisch Drents esdorpenlandschap." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743510 ;
            sgpl:spatialText "gemeente Zweeloo" ;
            sgpl:text_context "Het voor de Natuurwetenschappelijke Commissie verrichte onderzoek had betrekking op de historisch-landschappelljke waarden in het circa 6.000 hectare grote ruilverkavelingsgebied 'Mars- en Westerstroom' -grofweg de huidige gemeenten Oosterhesselen en Zweeloo- in zuidoost Drenthe: een typisch esdorpenlandschap. Het karakter ervan is de afgelopen decennia echter wel veranderd, omdat in ruilverkavelingen en kavelruilen binnen het gebied cultuurtechnische werken zijn uitgevoerd en ook door de boeren zelf allerlei incidentele werkzaamheden ter verhoging van de doelmatigheid hunner bedrijven, echter niet ter verfraai-ing van het landschap, werden uitgevoerd: kavelruilen, perceelsvergrotingen, egalisaties, sloten dempen en graven, opruimen en aanbrengen van beplantingen etc. Met name in de jaren zeventig heeft dit geleid tot een vrij sterke landschappelijke waar den vermindering." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756631 ;
            sgpl:spatialText "Drenthe" ;
            sgpl:text_context "Veel aandacht wordt derhalve in de eerste twee hoofdstukken besteed aan Drenthe, het Drentse landschap en het landbouwsysteem in het Drentse esdorp, waarbij de vier landschappelijke componenten nederzetting, bouwland (es), gras- of groenland (hooi- en weiland) en woeste grond (veld) van groot belang zijn. Hoewel Drenthe altijd, mede als gevolg van een geïsoleerde ligging, veel streekeigene had en ook heeft behouden (en dat niet alleen landschappelijk bezien), moet een verhandeling over deze provincie voor de duidelijkheid toch beginnen met het globaal belichten van het landschap der Nederlandse zandgronden. Enerzijds blijkt er veel verwantschap in de structuur en organisatie van landschap en samenleving tussen Drenthe en de andere zandgebieden te zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "de Nederlandse zandgronden" ;
            sgpl:text_context "Hoewel Drenthe altijd, mede als gevolg van een geïsoleerde ligging, veel streekeigene had en ook heeft behouden (en dat niet alleen landschappelijk bezien), moet een verhandeling over deze provincie voor de duidelijkheid toch beginnen met het globaal belichten van het landschap der Nederlandse zandgronden. Enerzijds blijkt er veel verwantschap in de structuur en organisatie van landschap en samenleving tussen Drenthe en de andere zandgebieden te zijn. Anderzijds komt hierdoor het eigene van Drenthe meer naar voren." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4583 ;
            sgpl:subjectText "Beekdalen" ;
            sgpl:text_context "Aangezien de voorgenomen ruilverkaveling als belangrijk oogmerk heeft de graslanden in de beekdalen grotere kavels te geven, waardoor zeer veel van de juist voor dit gebied zo karakteristieke beekdalbeplanting zou verdwijnen, verzocht de natuurwetenschappelijke Commissie mij met name historisch-landschappelijk onderzoek naar de perceelsvormen en beplanting in de beekdalen te verrichten. Wellicht interessant te vermelden in dit kader is dat Beijerinck al in '43 (in: Poortman, '43, p. 153) schreef: \"De oorspronkelijke landschappen zijn in het gedrang\" en \"helaas zijn de beekdalen nauwelijks beschermd\". Hoewel dit beekdalonderzoek een belangrijke plaats inneemt in het onderhavige werkstuk, is het toch ook de bedoeling dat het. ruilverkavelingsgebied 'Mars- en Westerstroom' belicht wordt in een ruimer kader." ],
        [ sgpl:refersToConcept unesco:concept445 ;
            sgpl:subjectText "Esdorp" ;
            sgpl:text_context "De Drentse marke-organisaties hadden weinig met grondheer- HJk gezag uit te staan. Het gevolg van dit alles was dat op de zandgronden de bewoning nergens zo sterk geconcentreerd was als in Drenthe, net gebruikelijke in Drenthe voorkomende type esdorp is dan ook het kernesdorp. De bewoning is als het ware geconcentreerd op één raakpunt met de es, doorgaans aan de beekdal- ,dus grasland-, zijde van de es." ],
        [ sgpl:refersToConcept unesco:concept8391 ;
            sgpl:subjectText "Ruilverkaveling" ;
            sgpl:text_context "Het voor de Natuurwetenschappelijke Commissie verrichte onderzoek had betrekking op de historisch-landschappelljke waarden in het circa 6.000 hectare grote ruilverkavelingsgebied 'Mars- en Westerstroom' -grofweg de huidige gemeenten Oosterhesselen en Zweeloo- in zuidoost Drenthe: een typisch esdorpenlandschap. Het karakter ervan is de afgelopen decennia echter wel veranderd, omdat in ruilverkavelingen en kavelruilen binnen het gebied cultuurtechnische werken zijn uitgevoerd en ook door de boeren zelf allerlei incidentele werkzaamheden ter verhoging van de doelmatigheid hunner bedrijven, echter niet ter verfraai-ing van het landschap, werden uitgevoerd: kavelruilen, perceelsvergrotingen, egalisaties, sloten dempen en graven, opruimen en aanbrengen van beplantingen etc. Met name in de jaren zeventig heeft dit geleid tot een vrij sterke landschappelijke waarden vermindering." ],
        [ sgpl:refersToConcept unesco:concept8391 ;
            sgpl:subjectText "Ruilverkaveling" ;
            sgpl:text_context "Het voor de Natuurwetenschappelijke Commissie verrichte onderzoek had betrekking op de historisch-landschappelljke waarden in het circa 6.000 hectare grote ruilverkavelingsgebied 'Mars- en Westerstroom' -grofweg de huidige gemeenten Oosterhesselen en Zweeloo- in zuidoost Drenthe: een typisch esdorpenlandschap. Het karakter ervan is de afgelopen decennia echter wel veranderd, omdat in ruilverkavelingen en kavelruilen binnen het gebied cultuurtechnische werken zijn uitgevoerd en ook door de boeren zelf allerlei incidentele werkzaamheden ter verhoging van de doelmatigheid hunner bedrijven, echter niet ter verfraai-ing van het landschap, werden uitgevoerd: kavelruilen, perceelsvergrotingen, egalisaties, sloten dempen en graven, opruimen en aanbrengen van beplantingen etc. Met name in de jaren zeventig heeft dit geleid tot een vrij sterke landschappelijke waarden vermindering." ],
        [ sgpl:refersToConcept unesco:concept4583 ;
            sgpl:subjectText "Beekdalen" ;
            sgpl:text_context "Aangezien de voorgenomen ruilverkaveling als belangrijk oogmerk heeft de graslanden in de beekdalen grotere kavels te geven, waardoor zeer veel van de juist voor dit gebied zo karakteristieke beekdalbeplanting zou verdwijnen, verzocht de natuurwetenschappelijke Commissie mij met name historisch-landschappelijk onderzoek naar de perceelsvormen en beplanting in de beekdalen te verrichten. Wellicht interessant te vermelden in dit kader is dat Beijerinck al in '43 (in: Poortman, '43, p. 153) schreef: \"De oorspronkelijke landschappen zijn in het gedrang\" en \"helaas zijn de beekdalen nauwelijks beschermd\". Hoewel dit beekdalonderzoek een belangrijke plaats inneemt in het onderhavige werkstuk, is het toch ook de bedoeling dat het. ruilverkavelingsgebied 'Mars- en Westerstroom' belicht wordt in een ruimer kader." ],
        [ sgpl:refersToConcept unesco:concept445 ;
            sgpl:subjectText "Esdorp" ;
            sgpl:text_context "De Drentse marke-organisaties hadden weinig met grondheer- HJk gezag uit te staan. Het gevolg van dit alles was dat op de zandgronden de bewoning nergens zo sterk geconcentreerd was als in Drenthe, net gebruikelijke in Drenthe voorkomende type esdorp is dan ook het kernesdorp. De bewoning is als het ware geconcentreerd op één raakpunt met de es, doorgaans aan de beekdal- ,dus grasland-, zijde van de es." ] ;
    sgpl:thesisID 134 .

sgpl:Thesis135 a sgpl:SGPLThesis ;
    dcterms:creator "E.A.P. Kaats",
        "H.J.A. Veelenturf" ;
    dcterms:issued 1986 ;
    dcterms:title "DE AANTREKKINGSKRACHT VAN MIDDELGROTE STEDEN: EEN KWESTIE VAN LEEFBAARHEID?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759633 ;
            sgpl:spatialText "Assen" ;
            sgpl:text_context "Door middel van een enquête wordt getracht een beeld te krijgen van de aantrekkingskracht van drie middel- grote steden, te weten Assen, Bergen op Zoom en Oss. De hoofdstukken 4 en 5 vermelden de onderzoeksresultaten van deze enquête. Daarbij gaat hoofdstuk 4 in op de algemene kenmerken van de vestigers, terwijl in hoofdstuk 5 wordt ingegaan op de vestigingsmotieven van de huishoudens, die zich in één van de 3 middelgrote steden hebben gevestigd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759633 ;
            sgpl:spatialText "gemeente Assen" ;
            sgpl:text_context "Daar- naast gaat onze dank uit naar de heren J. Lagendijk (gemeente Assen), M.J.G. Timmermans (gemeente Bergen op Zoom), P.M.A. van der Horst en J. Teerink (gemeente Oss), die ons hebben voorzien van de nodige infor- matie. H.J.A. Veelenturf E.A.P. Kaats Utrecht, november 1986" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749234 ;
            sgpl:spatialText "gemeente Oss" ;
            sgpl:text_context "Daar- naast gaat onze dank uit naar de heren J. Lagendijk (gemeente Assen), M.J.G. Timmermans (gemeente Bergen op Zoom), P.M.A. van der Horst en J. Teerink (gemeente Oss), die ons hebben voorzien van de nodige infor- matie. H.J.A. Veelenturf E.A.P. Kaats Utrecht, november 1986" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In dit onderzoek staan de middelgrote steden in Nederland centraal. Uit publicaties met betrekking tot de ontwikkeling van stedelijke nederzet- tingen blijkt, dat middelgrote steden een positieve aantrekkingskracht zullen kunnen uitoefenen op huishoudens. Dergelijke publicaties vormen de aanleiding tot een nader onderzoek naar recente ontwikkelingen op dit gebied in middelgrote steden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Klaassen merkt daarbij wel op, dat hij verwacht, dat die middelgrote steden zullen groeien, die op niet al te grote afstand van de Randstad liggen. De oorzaak hiervan zou volgens hem liggen in het feit, dat leden van het huishouden nog wel aangewezen zijn op werkgelegenheid van de grote steden enerzijds en de grootstedelijke voorzieningen en faciliteiten anderzijds. Zo lijkt er een schaal te bestaan, met aan de ene kant de grote steden en aan de andere kant de kleine kernen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759145 ;
            sgpl:spatialText "Bergen op Zoom" ;
            sgpl:text_context "Door middel van een enquête wordt getracht een beeld te krijgen van de aantrekkingskracht van drie middel- grote steden, te weten Assen, Bergen op Zoom en Oss. De hoofdstukken 4 en 5 vermelden de onderzoeksresultaten van deze enquête. Daarbij gaat hoofdstuk 4 in op de algemene kenmerken van de vestigers, terwijl in hoofdstuk 5 wordt ingegaan op de vestigingsmotieven van de huishoudens, die zich in één van de 3 middelgrote steden hebben gevestigd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747351 ;
            sgpl:spatialText "Alkmaar" ;
            sgpl:text_context "Bij de interpretatie van de resultaten is enige voorzichtigheid geboden, aangezien de geografische situatie van de onderzochte steden specifiek was en derhalve onderling moeilijk vergelijkbaar. Zo blijken binnen de straal van 25 kilometer van Assen en Oss resp. de steden Groningen en Den Bosch te liggen, waarvandaan een groot aantal vestigers afkomstig zijn. Uit deze steden alleen blijken al resp. 13,0% en 10,9% van de vestigers afkomstig." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759144 ;
            sgpl:spatialText "gemeente Bergen op Zoom" ;
            sgpl:text_context "Daar- naast gaat onze dank uit naar de heren J. Lagendijk (gemeente Assen), M.J.G. Timmermans (gemeente Bergen op Zoom), P.M.A. van der Horst en J. Teerink (gemeente Oss), die ons hebben voorzien van de nodige infor- matie. H.J.A. Veelenturf E.A.P. Kaats Utrecht, november 1986" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "Den Bosch" ;
            sgpl:text_context "Bij de interpretatie van de resultaten is enige voorzichtigheid geboden, aangezien de geografische situatie van de onderzochte steden specifiek was en derhalve onderling moeilijk vergelijkbaar. Zo blijken binnen de straal van 25 kilometer van Assen en Oss resp. de steden Groningen en Den Bosch te liggen, waarvandaan een groot aantal vestigers afkomstig zijn. Uit deze steden alleen blijken al resp. 13,0% en 10,9% van de vestigers afkomstig." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759899 ;
            sgpl:spatialText "Groningen" ;
            sgpl:text_context "Het laatste cluster tenslotte is een cluster, die zich sterk onder- scheidt van de overige clusters. Het bevat slechts 1 stad, Alkmaar, die over de periode 1970-1984 een zeer hoog positief migatiesaldo kende. Vooral in de laatste periode is het vestigingsoverschot van deze groei- kern enorm hoog." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749234 ;
            sgpl:spatialText "Oss" ;
            sgpl:text_context "Door middel van een enquête wordt getracht een beeld te krijgen van de aantrekkingskracht van drie middel- grote steden, te weten Assen, Bergen op Zoom en Oss. De hoofdstukken 4 en 5 vermelden de onderzoeksresultaten van deze enquête. Daarbij gaat hoofdstuk 4 in op de algemene kenmerken van de vestigers, terwijl in hoofdstuk 5 wordt ingegaan op de vestigingsmotieven van de huishoudens, die zich in één van de 3 middelgrote steden hebben gevestigd." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "Leefbaarheid" ;
            sgpl:text_context "Het eerste hoofdstuk behandelt de centrale begrippen en geeft een theoretische verkenning. Een centraal begrip in dit verband is het begrip leefbaarheid. Er zal aandacht worden besteed aan de rol van dit begrip in het maatschappelijk verkeer en in het migratieproces in het bijzonder." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "Migratiesaldo" ;
            sgpl:text_context "Door middel van een analyse van demografische groeicijfers zal duidelijk worden gemaakt hoe de groei van de middelgrote steden zich heeft ontwikkeld gedurende de periode 1970-1984. Daarnaast zal bekeken worden in hoeverre er een samenhang bestaat tussen de omvang en de lokatie van middelgrote steden en hun migratiesaldo. Voor de analyse is gebruik gemaakt van de statistiek \"Loop van de bevolking per gemeente\" van het Centraal Bureau van de Statistiek (C.B.S.)." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Middelgrote steden" ;
            sgpl:text_context "Uit publicaties met betrekking tot de ontwikkeling van stedelijke nederzettingen blijkt, dat middelgrote steden een positieve aantrekkingskracht zullen kunnen uitoefenen op huishoudens. In dit onderzoek staan de middelgrote steden in Nederland centraal. Dergelijke publicaties vormen de aanleiding tot een nader onderzoek naar recente ontwikkelingen op dit gebied in middelgrote steden." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "Migratiesaldo" ;
            sgpl:text_context "Door middel van een analyse van demografische groeicijfers zal duidelijk worden gemaakt hoe de groei van de middelgrote steden zich heeft ontwikkeld gedurende de periode 1970-1984. Daarnaast zal bekeken worden in hoeverre er een samenhang bestaat tussen de omvang en de lokatie van middelgrote steden en hun migratiesaldo. Voor de analyse is gebruik gemaakt van de statistiek \"Loop van de bevolking per gemeente\" van het Centraal Bureau van de Statistiek (C.B.S.)." ],
        [ sgpl:refersToConcept unesco:concept3620 ;
            sgpl:subjectText "Leefbaarheid" ;
            sgpl:text_context "Het eerste hoofdstuk behandelt de centrale begrippen en geeft een theoretische verkenning. Een centraal begrip in dit verband is het begrip leefbaarheid. Er zal aandacht worden besteed aan de rol van dit begrip in het maatschappelijk verkeer en in het migratieproces in het bijzonder." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Middelgrote steden" ;
            sgpl:text_context "Uit publicaties met betrekking tot de ontwikkeling van stedelijke nederzettingen blijkt, dat middelgrote steden een positieve aantrekkingskracht zullen kunnen uitoefenen op huishoudens. In dit onderzoek staan de middelgrote steden in Nederland centraal. Dergelijke publicaties vormen de aanleiding tot een nader onderzoek naar recente ontwikkelingen op dit gebied in middelgrote steden." ] ;
    sgpl:thesisID 135 .

sgpl:Thesis136 a sgpl:SGPLThesis ;
    dcterms:creator "Bram Verhoef",
        "Theo Thuis" ;
    dcterms:issued 1984 ;
    dcterms:title "DOORSTROMING OP DE BEDRIJFSPANDENMARKT",
        "Een onderzoek naar de veranderingen in bezetting van bedrijfspanden in een achttal buurten in Utrecht voor de periode 1977-1982" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Gemeente Utrecht" ;
            sgpl:text_context "Het onderzoek bestaat uit twee onderdelen. De gegevens hiervoor konden worden ontleend aan de bedrijvencartotheek van de gemeente Utrecht. De gekozen buurten zijn: Breedstraat en omstreken, Overvecht-industrieterrein, Carnegiedreef, Ondiep, Tuindorp, Hoog Catharijne, Kanaleneiland-industrieterrein en Lage Weide." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Een proces in de kantorensector zoals hierboven is geschetst, is reeds te constateren in Amsterdam. Daar staat vrij nieuwe kantoorruimte structureel leeg. Dit houdt ook voor de kantorensector in Utrecht een bedreiging op langere termijn in." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Vanuit de specialisatie bedrijvigheid is getracht een inzicht te verkrijgen in de veranderingen die zich hebben voorgedaan in de bezetting van bedrijfspanden in een aantal buurten van de stad Utrecht. Het onderzoek bestaat uit twee onderdelen. De inventariserende fase, hierin zijn de veranderingen in de bezetting van de bedrijfspanden voor de periode 1977-1982 geanalyseerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751314 ;
            sgpl:spatialText "Maarssenbroek" ;
            sgpl:text_context "Het derde bedrijfsterrein, Lage Weide, kan nog met het meeste recht een industrieterrein worden genoemd. Het nieuwere noordelijke deel sluit nauw aan op de recent ontwikkelde bedrijfsbebouwing van Maarssenbroek en is minder industrieel van karakter. De derde buurtcombinatie omvat de woonbuurten Carnegiedreef (17), Ondiep (24) en Tuindorp (36)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746125 ;
            sgpl:spatialText "Tuindorp" ;
            sgpl:text_context "De wijk Carnegiedreef maakt deel uit van de wijk Overvecht. De buurt Tuindorp is een middle-class woonbuurt, gebouwd in een aantal fasen vanaf de jaren dertig. De bedrijvigheid bestaat voornamelijk uit over de buurt verspreide detailhandel en enkele kantoorcomplexen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Ondiep" ;
            sgpl:text_context "De wijk Carnegiedreef maakt deel uit van de wijk Overvecht. De buurt Ondiep tenslotte is een arbeiderswijk uit het begin van deze eeuw die inmiddels een stadsvernieuwingsgolf heeft beleefd. Ook hier is er sprake van voornamelijk buurtverzorgende detailhandel met daarnaast kleinschalige industriële bedrijvigheid verspreid over de buurt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Hoog Catharijne" ;
            sgpl:text_context "De tweede buurt binnen de combinatie stadscentrum is de kern van Hoog Catharijne. Dit is een omvangrijke recente reconstructie van het stationskwartier. De bedrijvigheid neemt een zeer centrale plaats in binnen het geheel." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2752014 ;
            sgpl:spatialText "Lage Weide" ;
            sgpl:text_context "De gekozen buurten zijn: Breedstraat en omstreken, Overvecht-industrieterrein, Carnegiedreef, Ondiep, Tuindorp, Hoog Catharijne, Kanaleneiland-industrieterrein en Lage Weide. Het derde bedrijfsterrein, Lage Weide, kan nog met het meeste recht een industrieterrein worden genoemd. Dit geldt dan met name voor het oudere zuidelijke deel van het gebied." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753082 ;
            sgpl:spatialText "Kanaleneiland-industrieterrein" ;
            sgpl:text_context "De gekozen buurten zijn: Breedstraat en omstreken, Overvecht-industrieterrein, Carnegiedreef, Ondiep, Tuindorp, Hoog Catharijne, Kanaleneiland-industrieterrein en Lage Weide. Kanaleneiland is evenals Overvecht een grote na-oorlogse uitbreiding van Utrecht. Het daar gelegen bedrijfsterrein wordt gekenmerkt door een relatief groot aandeel van de ruimte-extensieve detailhandel." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Carnegiedreef" ;
            sgpl:text_context "De wijk Carnegiedreef maakt deel uit van de wijk Overvecht. Een belangrijk element in deze wijk is het grootwinkelcentrum Overvecht. Dit is een verzorgingscentrum van bovenwijkse betekenis." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748815 ;
            sgpl:spatialText "Overvecht-industrieterrein" ;
            sgpl:text_context "De gekozen buurten zijn: Breedstraat en omstreken, Overvecht-industrieterrein, Carnegiedreef, Ondiep, Tuindorp, Hoog Catharijne, Kanaleneiland-industrieterrein en Lage Weide. De hoge mutatie-intensiteit kan worden verklaard uit het feit dat dit terrein is bestemd voor de opvang van bedrijven uit de oude stad en het hoge aandeel van de doorgaans meer mobiele bedrijfstakken groothandel en bouwnijverheid in de bezetting van dit terrein. Kanaleneiland is evenals Overvecht een grote na-oorlogse uitbreiding van Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Breedstraat en omstreken" ;
            sgpl:text_context "De gegevens hiervoor konden worden ontleend aan de bedrijvencartotheek van de gemeente Utrecht. De gekozen buurten zijn: Breedstraat en omstreken, Overvecht- industrieterrein , Carnegiedreef, Ondiep, Tuindorp, Hoog Catharijne, Kanaleneiland-industrieterrein en Lage Weide. Op grond van de percentages panden met een hoge mutatie-intensiteit (twee of meer) zijn deze buurten samengevoegd tot de buurtcombinaties stadscentrum, bedrijfsterreinen en woonbuurten." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1564 ;
            sgpl:subjectText "Doorstroming" ;
            sgpl:text_context "Uit deze case-study bleek dat er sprake is van doorstroming op de bedrijfspandenmarkt (tabel 5.5). Hiermee wordt gedoeld op doorstroming in beperkte zin, dat wil zeggen: alle verhuizingen die leiden tot een hogere huurquote (deel van het inkomen wat aan huur wordt uitgegeven). Bij de verhuizingen die in de enquete aan bod zijn gekomen gaat het in ongeveer tweederde van de gevallen om verhuizingen naar een duurder pand." ],
        [ sgpl:refersToConcept unesco:concept5325 ;
            sgpl:subjectText "Bedrijfspandenmarkt" ;
            sgpl:text_context "Deze hypothese veronderstelde op de woningmarkt bijvoorbeeld dat er in flats meer werd verhuisd dan in eengezinswoningen. Het blijkt dat ook op de bedrijfspandenmarkt niet alle typen panden in even sterke mate bij het verhuizen zijn betrokken. Volgens de bedrijfspandentypo1ogie blijkt immers dat mobiele panden verschillen van stabiele." ],
        [ sgpl:refersToConcept unesco:concept11375 ;
            sgpl:subjectText "Mutatie-intensiteit" ;
            sgpl:text_context "De gegevens hiervoor konden worden ontleend aan de bedrijvencartotheek van de gemeente Utrecht. Op grond van de percentages panden met een hoge mutatie-intensiteit (twee of meer) zijn deze buurten samengevoegd tot de buurtcombinaties stadscentrum, bedrijfsterreinen en woonbuurten. Bij vergelijking van deze buurtcombinaties in paragraaf 3.1 blijkt dat de hoogste mobiliteit voorkomt in het stadscentrum en de laagste in de woonbuurten." ],
        [ sgpl:refersToConcept unesco:concept5325 ;
            sgpl:subjectText "Bedrijfspandenmarkt" ;
            sgpl:text_context "Deze hypothese veronderstelde op de woningmarkt bijvoorbeeld dat er in flats meer werd verhuisd dan in eengezinswoningen. Het blijkt dat ook op de bedrijfspandenmarkt niet alle typen panden in even sterke mate bij het verhuizen zijn betrokken. Volgens de bedrijfspandentypo1ogie blijkt immers dat mobiele panden verschillen van stabiele." ],
        [ sgpl:refersToConcept unesco:concept11375 ;
            sgpl:subjectText "Mutatie-intensiteit" ;
            sgpl:text_context "De gegevens hiervoor konden worden ontleend aan de bedrijvencartotheek van de gemeente Utrecht. Op grond van de percentages panden met een hoge mutatie-intensiteit (twee of meer) zijn deze buurten samengevoegd tot de buurtcombinaties stadscentrum, bedrijfsterreinen en woonbuurten. Bij vergelijking van deze buurtcombinaties in paragraaf 3.1 blijkt dat de hoogste mobiliteit voorkomt in het stadscentrum en de laagste in de woonbuurten." ],
        [ sgpl:refersToConcept unesco:concept1564 ;
            sgpl:subjectText "Doorstroming" ;
            sgpl:text_context "Uit deze case-study bleek dat er sprake is van doorstroming op de bedrijfspandenmarkt (tabel 5.5). Hiermee wordt gedoeld op doorstroming in beperkte zin, dat wil zeggen: alle verhuizingen die leiden tot een hogere huurquote (deel van het inkomen wat aan huur wordt uitgegeven). Bij de verhuizingen die in de enquete aan bod zijn gekomen gaat het in ongeveer tweederde van de gevallen om verhuizingen naar een duurder pand." ] ;
    sgpl:thesisID 136 .

sgpl:Thesis137 a sgpl:SGPLThesis ;
    dcterms:creator "H.J. van den Driessche",
        "J. Hollestelle" ;
    dcterms:issued 1985 ;
    dcterms:title "Een sociaal-geografisch onderzoek naar de huisvestingssituatie van zelfstandig wonende ouderen in Utrecht" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6544259 ;
            sgpl:spatialText "Almere" ;
            sgpl:text_context "Hij haalt in dit verband het voorbeeld van Almere aan, waar ouderen uit de oude buurten van Amsterdam naar toe zijn verhuisd. Zij voelen zich daar nu ontheemd. De problemen in dergelijke oude buurten zijn niet alleen nadelig voor ouderen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2655984 ;
            sgpl:spatialText "Belfast" ;
            sgpl:text_context "Zo'n zelfde ruimtelijke ontwikkeling hebben Compton en Murray (1982) waargenomen in Belfast, Noord-Ierland. Zij constateerden daar een toename van het percentage 60-plussers in de buitenwijken en een afname naar het centrum toe, in de jaren tussen 1971 en 1978. Figuur 1.3: Percentage change in the elderly population of Belfast District between 1971 and 1978." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Ondiep" ;
            sgpl:text_context "Ondiep is daarentegen een planmatige stadsuitbreiding uit de jaren tussen de beide wereldoorlogen. De meeste woningen werden door de gemeente, of door woningbouwcorporaties gebouwd. De woningen waren bedoeld voor arbeidersgezinnen, zodat er een sociaal homogene samenstelling ontstond: een arbeidersbuurt (Driessen en van Hoorn, 1982, p.77)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751496 ;
            sgpl:spatialText "wijk Lombok" ;
            sgpl:text_context "In de wijk Lombok (waartoe Kanaalstraat e.o. behoort) is er volgens Kaufman (1983) bij veel bejaarden: \"sprake van apathie, het zal hun tijd wel duren \". In het rapport \"Multiraciale samenlevingen in het klein\", wordt opgemerkt: \"Op het gebied van wereldbeschouwing heeft men elkaar weinig te zeggen vanwege de aanmerkelijke verschillen in geloof, maar ook dichter bij huis, op de werkvloer, zijn er geen aanknopingspunten\" (F. Bovenkerk e.a., 1982, p.79). In het al eerder aangehaalde onderzoek van Van Hoorn (1980) signaleert hij, tussen Nederlanders en niet-Nederlanders en ook tussen jongeren en ouderen, een door de woonvorm opgeworpen drempel, om tot meer en betere contacten te komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Hij haalt in dit verband het voorbeeld van Almere aan, waar ouderen uit de oude buurten van Amsterdam naar toe zijn verhuisd. Zij voelen zich daar nu ontheemd. De problemen in dergelijke oude buurten zijn niet alleen nadelig voor ouderen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "We hebben voor het onderzoeksveld de stad Utrecht gekozen in verband met de bereikbaarheid van en bekendheid met deze stad. Bij het bepalen van de onderzoekspopulatie zijn wij vaak gedwongen de leeftijdsgrens van 65 jaar als criterium te nemen. Dit in verband met de beschikbaarheid en bruikbaarheid van bronmateriaal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748815 ;
            sgpl:spatialText "Overvecht" ;
            sgpl:text_context "Vooral in de buitenwijken, gebouwd in de jaren zestig (Kanaleneiland en Overvecht), waar de grootschalige bejaardencomplexen staan, en de gegoede tuinwijken van voor de oorlog (Tuindorp en Oog in Al), maken een sterke vergrijzing mee. Tuindorp-Oost had in 1982 zelfs een percentage bejaarden van 31,4. Er zijn echter ook buurten waar het percentage duidelijk afneemt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Vogelenbuurt" ;
            sgpl:text_context "Vogelenbuurt is een, in het einde van de negentiende eeuw ontstane, ongeplande stadsuitbreiding. De woningbouw werd aan particulieren overgelaten. De dichtheid van bebouwing was vrij hoog." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753082 ;
            sgpl:spatialText "Kanaleneiland" ;
            sgpl:text_context "Vooral in de buitenwijken, gebouwd in de jaren zestig (Kanaleneiland en Overvecht), waar de grootschalige bejaardencomplexen staan, en de gegoede tuinwijken van voor de oorlog (Tuindorp en Oog in Al), maken een sterke vergrijzing mee. Tuindorp-Oost had in 1982 zelfs een percentage bejaarden van 31,4. Er zijn echter ook buurten waar het percentage duidelijk afneemt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Demografische processen zijn van invloed op het bouwen en wonen in Nederland. Zo zal de te verwachten vergrijzing de komende decennia van belangrijke betekenis zijn. Het Centraal Planbureau heeft het percentage bejaarden in het jaar 2000 geschat op ongeveer 13.7 voor heel Nederland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743628 ;
            sgpl:spatialText "Zuilen" ;
            sgpl:text_context "Voor Ondiep valt verder op, dat de voorkeur voor de eigen buurt en het aangrenzende Zuilen hoog is (36.7%). Voor Vogelenbuurt geldt hetzelfde; een grote voorkeur voor de 'eigen buurt' en het aangrenzende Tuindorp (40.9%). In tegenstelling tot de migratiegegevens (tabel 4.1) hebben de 65-plussers juist een veel sterkere voorkeur voor de eigen buurt dan de 55-64 jarigen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3574 ;
            sgpl:subjectText "Buurtbinding" ;
            sgpl:text_context "Ruime aandacht gaat uit naar het verhuisgedrag van ouderen, de buurtvoorkeur, de redenen van verhuizing en de woonwensen. De invloed van sociale integratie en andere vormen van buurtbinding op het verhuisgedrag van ouderen worden specifiek in hoofdstuk 5 behandeld. In hoofdstuk 6 geven we een verslag van de gehouden interviews met beleidsbepalende personen uit de praktijk." ],
        [ sgpl:refersToConcept unesco:concept12679 ;
            sgpl:subjectText "Sociale integratie" ;
            sgpl:text_context "In hoofdstuk 1 behandelen we de maatschappelijke rol van ouderen in onze moderne, westerse samenleving. Dit brengen we in verband met de woon- en leefsituatie in oude buurten, waarbij we het begrip sociale integratie introduceren. Vanuit de theoretische veronderstellingen komen we tot het formuleren van probleemstelling en hypothesen." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "Verhuisgeneigdheid" ;
            sgpl:text_context "Zijdelings stipt zij aan, dat veel 65-plussers in de oude woongebieden en daardoor veelal in niet al te goede huizen wonen. Daarbij weet zij echter wel op te merken, dat 'ouderen hoe dan ook weinig verhuisgeneigd zijn'. De COSBO (1983) vindt de opstelling van de landelijke overheid ten aanzien van ouderen en hun woonsituatie te oppervlakkig." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "Verhuisgeneigdheid" ;
            sgpl:text_context "Zijdelings stipt zij aan, dat veel 65-plussers in de oude woongebieden en daardoor veelal in niet al te goede huizen wonen. Daarbij weet zij echter wel op te merken, dat 'ouderen hoe dan ook weinig verhuisgeneigd zijn'. De COSBO (1983) vindt de opstelling van de landelijke overheid ten aanzien van ouderen en hun woonsituatie te oppervlakkig." ],
        [ sgpl:refersToConcept unesco:concept12679 ;
            sgpl:subjectText "Sociale integratie" ;
            sgpl:text_context "In hoofdstuk 1 behandelen we de maatschappelijke rol van ouderen in onze moderne, westerse samenleving. Dit brengen we in verband met de woon- en leefsituatie in oude buurten, waarbij we het begrip sociale integratie introduceren. Vanuit de theoretische veronderstellingen komen we tot het formuleren van probleemstelling en hypothesen." ],
        [ sgpl:refersToConcept unesco:concept3574 ;
            sgpl:subjectText "Buurtbinding" ;
            sgpl:text_context "Ruime aandacht gaat uit naar het verhuisgedrag van ouderen, de buurtvoorkeur, de redenen van verhuizing en de woonwensen. De invloed van sociale integratie en andere vormen van buurtbinding op het verhuisgedrag van ouderen worden specifiek in hoofdstuk 5 behandeld. In hoofdstuk 6 geven we een verslag van de gehouden interviews met beleidsbepalende personen uit de praktijk." ] ;
    sgpl:thesisID 137 .

sgpl:Thesis138 a sgpl:SGPLThesis ;
    dcterms:creator "Willy Dwarkasing" ;
    dcterms:issued 1985 ;
    dcterms:title "DE SHELL-RAFFINADERIJ OP CURACAO; HAAR SOCIAAL-ECONOMISCHE EFFECTEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3513790 ;
            sgpl:spatialText "het eiland Curacao" ;
            sgpl:text_context "In het eerste hoofdstuk wordt een beeld gegeven van het sociaal- economische struktuur van het eiland. Het eiland Curacao maakt deel uit van de Nederlandse Antillen en ligt ongeveer 60 km voor de kust van Venezuela in het Caraibisch Gebied. Het eiland is zowel qua oppervlakte, 472 km2, als qua inwoneraantal, 147644 inwoners, bet grootste eiland van de Nederlandse Antillen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Deze scriptie is geschreven in het kader van mijn doctoraalopleiding Sociale Geografie aan de Rijksuniversiteit te Utrecht. Aan dit doktoraalonderzoek was een stage verbonden die ik bij het Sociaal- economisch Planbureau te Curacao gelopen heb. Hierdoor werd het verkrijgen van de nodige gegevens vergemakkelijkt en tegelijktijd deed ik ervaring op met betrekking tot het werk dat ik na mijn studie zou kunnen verrichten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255150 ;
            sgpl:spatialText "Midden- en Zuid Amerika" ;
            sgpl:text_context "Het eiland is zowel qua oppervlakte, 472 km2, als qua inwoneraantal, 147644 inwoners, bet grootste eiland van de Nederlandse Antillen. Door de gunstige ligging ten opzichte van Midden- en Zuid Amerika en de uitstekende natuurlijke haven, ontwikkelde Curacao zich tot een van de belangrijkste overscheephavens voor Europese en Amerikaanse goederen. De vestiging van de Shell-raffinaderij op Curacao in de negentiende eeuw werd mede bepaald door de gunstige fysische gesteldheid van de haven en het stabiel politiek klimaat van het eiland in die tijd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3513790 ;
            sgpl:spatialText "Curacao" ;
            sgpl:text_context "Door de gunstige ligging ten opzichte van Midden- en Zuid Amerika en de uitstekende natuurlijke haven, ontwikkelde Curacao zich tot een van de belangrijkste overscheephavens voor Europese en Amerikaanse goederen. De vestiging van de Shell-raffinaderij op Curacao in de negentiende eeuw werd mede bepaald door de gunstige fysische gesteldheid van de haven en het stabiel politiek klimaat van het eiland in die tijd. Deze vestiging is van grote betekenis gebleken voor de Curacaose economie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7626836 ;
            sgpl:spatialText "eilandgebied Curacao" ;
            sgpl:text_context "Ter redding van het bedrijf besloten de Nederlandse-, centrale-, en lokale overheden tot het verlenen van financiële steun aan het bedrijf. De centrale overheid heeft tevens meer dan 40% van de aandelen in het C.D.M. overgenomen van Nederlandse scheepvaartmaatschappijen en vervolgens voor het symbolisch bedrag van 1 gulden aan de overheid van het eilandgebied Curacao overgedragen. Daarbij zijn er maatregelen getroffen in de zin van verlaging van operationele kosten door onder andere loonsverlaging, arbeidstijdverkorting, inkrimping van het personeelsbestand en uitstel van aflossingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De beroepsbevolking groeit sneller dan de totale bevolking maar blijft op peil ten opzichte van de werkgelegenheid. De emigratie naar Nederland welke als uitlaatklep werkt voor de beroepsbevolking, is hier een mogelijke oorzaak van. tabel 1.1 Ontwikkeling van de bevolking, beroepsbevolking en de werkgelegenheid in de periode 1980-1983/4*" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3513090 ;
            sgpl:spatialText "haven van Willemstad" ;
            sgpl:text_context "De voorwaarden impliceren onder andere dat de 30% \"Witholding tax\" op de bestaande (obligatie-) leningen blijft bestaan, zodat deze leningen gekanaliseerd blijven via de maatschappijen op de Nederlandse Antillen. De economische ontwikkeling van Curacao is te danken aan de haven van Willemstad. Voor de vestiging van stuwende sectoren als de olieraffinaderij en de havenactiviteiten die daaraan verbonden waren, was de aanwezigheid van deze beschermde haven een van de belangrijkste argumenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3625428 ;
            sgpl:spatialText "Venezuela" ;
            sgpl:text_context "In het eerste hoofdstuk wordt een beeld gegeven van het sociaal- economische struktuur van het eiland. Het eiland Curacao maakt deel uit van de Nederlandse Antillen en ligt ongeveer 60 km voor de kust van Venezuela in het Caraibisch Gebied. Het eiland is zowel qua oppervlakte, 472 km2, als qua inwoneraantal, 147644 inwoners, bet grootste eiland van de Nederlandse Antillen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:8505032 ;
            sgpl:spatialText "Nederlandse Antillen" ;
            sgpl:text_context "In het eerste hoofdstuk wordt een beeld gegeven van het sociaal- economische struktuur van het eiland. Het eiland Curacao maakt deel uit van de Nederlandse Antillen en ligt ongeveer 60 km voor de kust van Venezuela in het Caraibisch Gebied. Het eiland is zowel qua oppervlakte, 472 km2, als qua inwoneraantal, 147644 inwoners, bet grootste eiland van de Nederlandse Antillen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3577279 ;
            sgpl:spatialText "Aruba" ;
            sgpl:text_context "Het derde hoofdstuk, waarin de onderzoeksresultaten hun plaats krijgen, behandelt zaken als: de directe en indirecte werkgelegenheidseffecten van de Shell; de mate van integratie van het bedrijf in de economie; de bijdrage aan het BNP en een vergelijking met de Lago, een soortgelijke raffinaderij op Aruba. Er wordt in het onderzoek getracht enige scenario's te formuleren ten aanzien van de Shell-problematiek. Deze worden in het vierde hoofdstuk uitgewerkt." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11249 ;
            sgpl:subjectText "Olieraffinaderij" ;
            sgpl:text_context "Door de gunstige ligging ten opzichte van Midden- en Zuid Amerika en de uitstekende natuurlijke haven, ontwikkelde Curacao zich tot een van de belangrijkste overscheephavens voor Europese en Amerikaanse goederen. De vestiging van de Shell-raffinaderij op Curacao in de negentiende eeuw werd mede bepaald door de gunstige fysische gesteldheid van de haven en het stabiel politiek klimaat van het eiland in die tijd. Deze vestiging is van grote betekenis gebleken voor de Curacaose economie." ],
        [ sgpl:refersToConcept unesco:concept2218 ;
            sgpl:subjectText "Input-Output model" ;
            sgpl:text_context "Het Input-Output model verschaft een raamwerk waarbinnen interrelaties van sectoren zijn samengevat en hun invloed op het economisch systeem zijn geevalueerd. De basis van het model is een transactietabel. Deze geeft de financiële relaties tussen de sectoren weer." ],
        [ sgpl:refersToConcept unesco:concept2253 ;
            sgpl:subjectText "Sociaal-economische impact" ;
            sgpl:text_context "Dit rapport tracht de lezer inzicht te verschaffen in de mate van integratie van de Shell in de economie. De sociaal- economische effecten worden in dit rapport uiteengezet. Het rapport bestaat uit 5 hoofdstukken." ],
        [ sgpl:refersToConcept unesco:concept2218 ;
            sgpl:subjectText "Input-Output model" ;
            sgpl:text_context "Het Input-Output model verschaft een raamwerk waarbinnen interrelaties van sectoren zijn samengevat en hun invloed op het economisch systeem zijn geevalueerd. De basis van het model is een transactietabel. Deze geeft de financiële relaties tussen de sectoren weer." ],
        [ sgpl:refersToConcept unesco:concept2253 ;
            sgpl:subjectText "Sociaal-economische impact" ;
            sgpl:text_context "Dit rapport tracht de lezer inzicht te verschaffen in de mate van integratie van de Shell in de economie. De sociaal- economische effecten worden in dit rapport uiteengezet. Het rapport bestaat uit 5 hoofdstukken." ],
        [ sgpl:refersToConcept unesco:concept11249 ;
            sgpl:subjectText "Olieraffinaderij" ;
            sgpl:text_context "Door de gunstige ligging ten opzichte van Midden- en Zuid Amerika en de uitstekende natuurlijke haven, ontwikkelde Curacao zich tot een van de belangrijkste overscheephavens voor Europese en Amerikaanse goederen. De vestiging van de Shell-raffinaderij op Curacao in de negentiende eeuw werd mede bepaald door de gunstige fysische gesteldheid van de haven en het stabiel politiek klimaat van het eiland in die tijd. Deze vestiging is van grote betekenis gebleken voor de Curacaose economie." ] ;
    sgpl:thesisID 138 .

sgpl:Thesis139 a sgpl:SGPLThesis ;
    dcterms:creator "A.J.L. van Es",
        "H.G.J. Rigter" ;
    dcterms:issued 1985 ;
    dcterms:title "CIBOR",
        "Opzet van een informatiebestand ten behoeve van de openluchtrecreatie : een verkenning." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Van de overige 3.000 hectare zal ruim 1.000 hectare worden bebost en wordt minimaal de helft gerealiseerd in de Randstad. De regering zal bosuitbreidingen in de Randstad, voor zover die geen onderdeel uitmaken van recreatiegebieden, tot stand brengen in gebieden binnen de stedelijke invloedssfeer. In deze bosuitbreidingen zullen de mogelijkheden tot recreatief medegebruik worden benadrukt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "het Westen van Nederland" ;
            sgpl:text_context "In het midden van de jaren vijftig verkrijgt de recreatie een vaste plaats binnen het beleid van de Rijksoverheid en bij vele instanties zien we een ontwikkeling op gang komen van incidentele steun aan zich toevallig aandienende recreatiemogelijkheden, naar een planmatiger aanpak. In de Nota \"De Ontwikkeling van het Westen des lands\" (Werkcommissie Westen des lands,1954,p.24) wordt naar voren gebracht, dat met name het Westen van Nederland karig bedeeld is met recreatieruimten. Er wordt tevens verwacht dat de behoefte aan recreatieruimte nog zal toenemen als gevolg van de stijgende welvaart, de veranderende sociale verhoudingen, onder andere door de te verwachten arbeidstijdverkorting, en een stijging van de mobiliteit." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelderland" ;
            sgpl:text_context "Aan de provinciale besturen wordt gevraagd deze ruimten in streekplannen nader af te wegen, waarbij de P.K.B.-kaart en de aangeduide regionalisering van de verblijfsrecreatieve ruimteclaim als richtsnoer dienst doen. Per regio gaat het globaal om de volgende ruimte : Groningen, Friesland en Drente 300 ha. Overijssel en Gelderland 310 ha." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Rest ons drs. G.M.R.A. van Oort te danken voor de begeleiding aan de Universiteit Utrecht. Den Haag, augustus 1985. SAMENVATTING Sinds het einde van de vorige eeuw is de hoeveelheid arbeidsvrije tijd sterk toegenomen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Enerzijds door nieuwe mogelijkheden tot recreatie te stimuleren en te realiseren, anderzijds door de bestaande mogelijkheden te beschermen. De Rijksoverheid zal ook in de toekomst een belangrijke stempel blijven drukken op de ontwikkeling van de mogelijkheden tot openluchtrecreatie in Nederland. Hierbij zal een evaluatie van de effecten van het gevoerde beleid wellicht een nuttig hulpmiddel ter ondersteuning van het huidige beleid kunnen zijn." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "Om dit in de toekomst te kunnen verbeteren is een concept recreanten-enquête opgesteld, met behulp waarvan de voor het beleid meest essentiële informatie kan worden verzameld. De werking en werkbaarheid van het informatiebestand is getoetst door middel van een case-study, uitgevoerd in de provincie Utrecht. In deze case-study is getracht het CIBOR-bestand te vullen met gegevens over de provincie Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "In het kader van de studie Sociale Geografie, binnen de vakgroep Toegepaste Geografie en Ruimtelijke Planning, aan de Rijksuniversiteit Utrecht, is het de gewoonte een doctoraalscriptie te schrijven. Deze scriptie heeft het karakter van een leeronderzoek, in dit geval in de specialisatierichting Landelijke Gebieden. De Directie Openluchtrecreatie van het Ministerie van Landbouw en Visserij bood de gelegenheid om door middel van een stage, de scriptie een echt toegepast karakter te geven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "De werking van het informatiebestand is getoetst door middel van een case-study, uitgevoerd in de provincie Utrecht. Bekijken we de situatie in 1981, dan valt tevens op dat wat betreft de oppervlakte recreatieterrein voor intensieve landrecreatie, Breukelen, Amersfoort, Vinkeveen en Kamerik er uit springen in positieve zin en wat betreft de oppervlakte recreatieterrein bestemd voor extensieve vormen van landrecreatie, vooral de gemeenten Leusden en Amersfoort. De oppervlakte agrarisch grondgebruik vertoont in de provincie Utrecht een zeer gespreid beeld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755249 ;
            sgpl:spatialText "Groningen" ;
            sgpl:text_context "Aan de provinciale besturen wordt gevraagd deze ruimten in streekplannen nader af te wegen, waarbij de P.K.B.-kaart en de aangeduide regionalisering van de verblijfsrecreatieve ruimteclaim als richtsnoer dienst doen. Per regio gaat het globaal om de volgende ruimte : Groningen, Friesland en Drente 300 ha. Overijssel en Gelderland 310 ha." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Zo werden reeds in de 18 eeuw langs de Vecht zomerverblijven gebouwd en tuinen aangelegd, door rijke kooplieden uit Amsterdam, waar zij volop konden genieten van hun vrije tijd. Het recreatiegedrag van de meerderheid van de bevolking heeft zich echter tot in het begin van deze eeuw voornamelijk beperkt tot wat we thans recreatief medegebruik zouden noemen. De opvatting dat recreatie en natuurbescherming een belangengemeenschap vormen wordt in de jaren dertig dan ook gemeengoed." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1129 ;
            sgpl:subjectText "Informatievoorziening" ;
            sgpl:text_context "Van verschillende zijden wordt ingespeeld op deze behoefte en er ontstaat zelfs een wetenschap die zich specifiek bezig gaat houden met informatievoorziening en informatieoverdracht : de Cybernetica. Naarmate de hoeveelheid beschikbare informatie groeit, neemt ook de noodzaak tot het structureren van deze informatie toe. De snelheid van informatieoverdracht neemt sterk toe en er verschijnen vele instanties die zich speciaal gaan toeleggen op het verzamelen, structureren en beheren van gegevens." ],
        [ sgpl:refersToConcept unesco:concept14258 ;
            sgpl:subjectText "Procesbewakingssysteem" ;
            sgpl:text_context "Eerst is via een vrij uitgebreide literatuurverkenning nagegaan hoe de structuur van een procesbewakingssysteem ten behoeve van het bewaken van de voortgang van realisering van de doelstellingen van het beleid van de Rijksoverheid met betrekking tot de openluchtrecreatie er zou kunnen uitzien. Hierbij is vooral aandacht besteed aan de plaats die het informatiebestand in dit systeem zou moeten gaan innemen. Dit laatste is met name van belang, omdat de inhoud van het uiteindelijke informatiebestand hiervan in hoge mate afhankelijk is." ],
        [ sgpl:refersToConcept unesco:concept367 ;
            sgpl:subjectText "Openluchtrecreatie" ;
            sgpl:text_context "In het begin slechts door het aangeven van knelpunten en mogelijke oplossingen daarvoor, maar vanaf het midden van de jaren zestig op een meer structurele wijze. Ook in de Derde Nota inzake de Ruimtelijke Ordening en met name in de daaruit voortgekomen Structuurschets Landelijke Gebieden en het Structuurschema Openluchtrecreatie, heeft men getracht een beleid te ontwikkelen om aan deze stijgende vraag tegemoet te komen. Enerzijds door nieuwe mogelijkheden tot recreatie te stimuleren en te realiseren, anderzijds door de bestaande mogelijkheden te beschermen." ],
        [ sgpl:refersToConcept unesco:concept367 ;
            sgpl:subjectText "Openluchtrecreatie" ;
            sgpl:text_context "In het begin slechts door het aangeven van knelpunten en mogelijke oplossingen daarvoor, maar vanaf het midden van de jaren zestig op een meer structurele wijze. Ook in de Derde Nota inzake de Ruimtelijke Ordening en met name in de daaruit voortgekomen Structuurschets Landelijke Gebieden en het Structuurschema Openluchtrecreatie, heeft men getracht een beleid te ontwikkelen om aan deze stijgende vraag tegemoet te komen. Enerzijds door nieuwe mogelijkheden tot recreatie te stimuleren en te realiseren, anderzijds door de bestaande mogelijkheden te beschermen." ],
        [ sgpl:refersToConcept unesco:concept14258 ;
            sgpl:subjectText "Procesbewakingssysteem" ;
            sgpl:text_context "Eerst is via een vrij uitgebreide literatuurverkenning nagegaan hoe de structuur van een procesbewakingssysteem ten behoeve van het bewaken van de voortgang van realisering van de doelstellingen van het beleid van de Rijksoverheid met betrekking tot de openluchtrecreatie er zou kunnen uitzien. Hierbij is vooral aandacht besteed aan de plaats die het informatiebestand in dit systeem zou moeten gaan innemen. Dit laatste is met name van belang, omdat de inhoud van het uiteindelijke informatiebestand hiervan in hoge mate afhankelijk is." ],
        [ sgpl:refersToConcept unesco:concept1129 ;
            sgpl:subjectText "Informatievoorziening" ;
            sgpl:text_context "Van verschillende zijden wordt ingespeeld op deze behoefte en er ontstaat zelfs een wetenschap die zich specifiek bezig gaat houden met informatievoorziening en informatieoverdracht : de Cybernetica. Naarmate de hoeveelheid beschikbare informatie groeit, neemt ook de noodzaak tot het structureren van deze informatie toe. De snelheid van informatieoverdracht neemt sterk toe en er verschijnen vele instanties die zich speciaal gaan toeleggen op het verzamelen, structureren en beheren van gegevens." ] ;
    sgpl:thesisID 139 .

sgpl:Thesis140 a sgpl:SGPLThesis ;
    dcterms:creator "G.J. Topper",
        "L. Franso" ;
    dcterms:issued 1985 ;
    dcterms:title "Een onderzoek naar bedrijfsbeëindigingen in het stadsgewest Utrecht in 1983.",
        "KENNIS VAN ZAKEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751316 ;
            sgpl:spatialText "Maarssen" ;
            sgpl:text_context "Het zou interessant zijn om te achterhalen waardoor dit beeld veroorzaakt wordt. Gekeken zou moeten worden of in Utrecht, Maarssen, Nieuwegein en Zeist inderdaad relatief meer starters voorkomen. Omdat starters een groot deel van alle bedrijfsbeëindigingen vormen (zie par. 3.2) zou dit een mogelijke verklaring kunnen zijn voor het hoge percentage opheffers in deze gemeenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Wanneer men kijkt naar de vestigingsplaats van bedrijven die in 1983 opgehouden zijn te bestaan dan blijkt 47% uit Utrecht te komen, 13% uit Nieuwegein en 12% uit Zeist. De overige 28% is min of meer gelijkmatig over de resterende gemeenten verspreid. Het is niet verbazingwekkend dat de meeste opgeheven bedrijven in Utrecht, Zeist en Nieuwegein gevestigd waren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757014 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "vakgroep sociale geografie van de stedelijk-industriële landen. Transitorium II, Heidelbemlaan 2. De Uithof. Utrecht (030)532044. Voorwoord. Dit rapport is het verslag van een onderzoek naar bedrijfsbeëingigingen in het stadsgewest Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "In dit kader viel de naam van \"Trefpunt\", een bureau uit Den Haag dat zich openstelt voor ex-managers waar ondernemers een beroep op kunnen doen. Evenals commerciële adviesbureaus verwijst de R.N.D. vaak mensen door naar derden, waarbij ook het bestaande bedrijfsleven ingeschakeld kan worden . De mogelijkheid hierbij ook ex- ondernemers te betrekken is niet serieus overwogen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "INLEIDING. Eén van de grootste maatschappelijke problemen van Nederland is de grote werkloosheid die het land het laatste decennium kent. Een belangrijke oorzaak wordt gevormd door bedrijfsbeëindigingen welke aan de orde van de dag zijn." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stadsgewest Utrecht" ;
            sgpl:text_context "Voorwoord. Dit rapport is het verslag van een onderzoek naar bedrijfsbeëingigingen in het stadsgewest Utrecht. Het onderzoek werd verricht in het kader van de doktoraalstudie Toegepaste Geografie en Ruimtelijke Planning aan de Rijks Universiteit Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754814 ;
            sgpl:spatialText "Harmelen" ;
            sgpl:text_context "Nieuwegein doet het relatief het slechtst ; in 1983 hield bijna 7% van de bedrijven op te bestaan. Utrecht volgt als tweede met iets meer dan 5%, Harmelen scoort opvallend laag met nog geen 1%. Het zou interessant zijn om te achterhalen waardoor dit beeld veroorzaakt wordt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "De totale dienstensektor (inclusief transport en communicatiebedrijven) omvat 74% van de in 1983 opgeheven bedrijven. Gezien de opbouw van de werkgelegenheid in de provincie Utrecht, waar ook de dienstensektor is oververtegenwoordigd (in Nederland maakt de dienstensektor 65% uit van de werkgelegenheid, in de provincie Utrecht is dat 73%, CBS, 1983), is het niet zo verwonderlijk dat deze bedrijfstakken ook in dit onderzoek zijn oververtegenwoordigd. Wanneer men kijkt naar het aantal jaren dat een bedrijf gevestigd is voordat het zijn bedrijfsvoering staakt, dan blijkt dat 51% minder dan 4 jaar heeft bestaan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Wanneer men kijkt naar de vestigingsplaats van bedrijven die in 1983 opgehouden zijn te bestaan dan blijkt 47% uit Utrecht te komen, 13% uit Nieuwegein en 12% uit Zeist. Voor Nieuwegein geldt dat daar 8% van de bedrijvigheid uit het totale stadsgewest zit, terwijl er 13% van de bedrijfsbeëindigingen voorkomen. Wanneer men het aantal bedrijfsbeëindigingen neemt ten opzichte van het aantal bestaande bedrijven per gemeente (kolom 3 van tabel 3.6) dan blijkt dat de grootste gemeenten relatief het hoogste percentage opheffers hebben." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743977 ;
            sgpl:spatialText "Zeist" ;
            sgpl:text_context "Wanneer men kijkt naar de vestigingsplaats van bedrijven die in 1983 opgehouden zijn te bestaan dan blijkt 47% uit Utrecht te komen, 13% uit Nieuwegein en 12% uit Zeist. De overige 28% is min of meer gelijkmatig over de resterende gemeenten verspreid. Het is niet verbazingwekkend dat de meeste opgeheven bedrijven in Utrecht, Zeist en Nieuwegein gevestigd waren." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept17112 ;
            sgpl:subjectText "bedrijfsbeëindigingen" ;
            sgpl:text_context "Eén van de grootste maatschappelijke problemen van Nederland is de grote werkloosheid die het land het laatste decennium kent. Een belangrijke oorzaak wordt gevormd door bedrijfsbeëindigingen welke aan de orde van de dag zijn. Toch is er opvallend weinig aandacht besteed aan deze bedrijfsbeëindigingen." ],
        [ sgpl:refersToConcept unesco:concept9673 ;
            sgpl:subjectText "kleine ondernemingen" ;
            sgpl:text_context "Bij het zoeken naar literatuur is de aandacht gericht geweest op vier aspecten. In de eerste plaats op genoemde oorzaken van het sluiten van een bedrijf (par.2.2), ten tweede op de verschillende wijzen waarop bedrijven ten onder gaan, (par.2.3), ten derde op de kenmerken van kleine ondernemingen (par.2.4) en tenslotte op de symptomen die een slecht funktionerend bedrijf kenmerken (par.2.4). Door auteurs wordt onderkend dat een complex van faktoren verantwoordelijk moet worden gesteld voor het beëindigen van een bedrijf." ],
        [ sgpl:refersToConcept unesco:concept6288 ;
            sgpl:subjectText "kennisverlies" ;
            sgpl:text_context "Beter inzicht in de oorzaken van bedrijfsbeëindigingen lijkt ons van groot nut. Elke bedrijfsbeëindiging gaat gepaard met een vernietiging van kapitaal en kennis (produktkennis,marktkennis). Deze kennis zou wellicht opgeslagen en aangewend kunnen worden ten dienste van reeds bestaande of nieuw op te richten bedrijven." ],
        [ sgpl:refersToConcept unesco:concept9673 ;
            sgpl:subjectText "kleine ondernemingen" ;
            sgpl:text_context "Bij het zoeken naar literatuur is de aandacht gericht geweest op vier aspecten. In de eerste plaats op genoemde oorzaken van het sluiten van een bedrijf (par.2.2), ten tweede op de verschillende wijzen waarop bedrijven ten onder gaan, (par.2.3), ten derde op de kenmerken van kleine ondernemingen (par.2.4) en tenslotte op de symptomen die een slecht funktionerend bedrijf kenmerken (par.2.4). Door auteurs wordt onderkend dat een complex van faktoren verantwoordelijk moet worden gesteld voor het beëindigen van een bedrijf." ],
        [ sgpl:refersToConcept unesco:concept17112 ;
            sgpl:subjectText "bedrijfsbeëindigingen" ;
            sgpl:text_context "Eén van de grootste maatschappelijke problemen van Nederland is de grote werkloosheid die het land het laatste decennium kent. Een belangrijke oorzaak wordt gevormd door bedrijfsbeëindigingen welke aan de orde van de dag zijn. Toch is er opvallend weinig aandacht besteed aan deze bedrijfsbeëindigingen." ],
        [ sgpl:refersToConcept unesco:concept6288 ;
            sgpl:subjectText "kennisverlies" ;
            sgpl:text_context "Beter inzicht in de oorzaken van bedrijfsbeëindigingen lijkt ons van groot nut. Elke bedrijfsbeëindiging gaat gepaard met een vernietiging van kapitaal en kennis (produktkennis,marktkennis). Deze kennis zou wellicht opgeslagen en aangewend kunnen worden ten dienste van reeds bestaande of nieuw op te richten bedrijven." ] ;
    sgpl:thesisID 140 .

sgpl:Thesis141 a sgpl:SGPLThesis ;
    dcterms:creator "Wouter van Miltenburg" ;
    dcterms:issued 1985 ;
    dcterms:title "Een vergelijking tussen voormalige inwoners van het stadsgewest Amsterdam en de regio Noordwest-Utrecht",
        "HET VERHUISVERLEDEN VAN ALLOCHTONE HUISHOUDENS IN KLEINE PLATTELANDSKERNEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750254 ;
            sgpl:spatialText "Nieuwer ter Aa" ;
            sgpl:text_context "De meeste huishoudens hebben hieraan gehoor gegeven en de vragenlijsten later weer ingeleverd. Op deze plaats wil ik dan ook alle bewoners van Loenersloot, Baambrugge en Nieuwer ter Aa dankzeggen voor de moeite die zij zich hebben getroost. Tevens wil ik de volgende personen bedanken omdat zij hebben bijgedragen aan de verzameling of de verwerking van de gegevens: Irene de Jager, Rob van Miltenburg, Gerrit van Miltenburg, Gerard de Vries, Theo de Vries en Doortje Wesseling." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "regio Noordwest-Utrecht" ;
            sgpl:text_context "Het betreft hier een reconstructie van het verhuisverleden van twee groepen allochtone huishoudens, alle woonachtig in kleine plattelandskernen. Voormalige bewoners van het stadsgewest Amsterdam en de regio Noordwest-Utrecht worden vergeleken op hun verhuisfrequentie en de kenmerken van de door hen bewoonde woningen. Daartoe zijn in december 1984 en januari 1985 in een drietal dorpen vragenlijsten verspreid met het verzoek deze in te vullen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751517 ;
            sgpl:spatialText "Loenersloot" ;
            sgpl:text_context "De meeste huishoudens hebben hieraan gehoor gegeven en de vragenlijsten later weer ingeleverd. Op deze plaats wil ik dan ook alle bewoners van Loenersloot, Baambrugge en Nieuwer ter Aa dankzeggen voor de moeite die zij zich hebben getroost. Tevens wil ik de volgende personen bedanken omdat zij hebben bijgedragen aan de verzameling of de verwerking van de gegevens: Irene de Jager, Rob van Miltenburg, Gerrit van Miltenburg, Gerard de Vries, Theo de Vries en Doortje Wesseling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "In veel gevallen vormt een toegenomen ruimtebehoefte daarbij een belangrijke faktor. Uit een onderzoek uitgevoerd in Amersfoort e.o. door HINGSTMAN EN HARTS (1982) bleek eveneens dat sommige woningen veel meer als startpunt fungeerden dan andere. Van de na 1 januari 1960 gehuwde huishoudens die ooit waren verhuisd was voor 47 7a een etagewoning het eerste onderkomen, slechts 18 % woonde daar nu in." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759572 ;
            sgpl:spatialText "Baambrugge" ;
            sgpl:text_context "De meeste huishoudens hebben hieraan gehoor gegeven en de vragenlijsten later weer ingeleverd. Op deze plaats wil ik dan ook alle bewoners van Loenersloot, Baambrugge en Nieuwer ter Aa dankzeggen voor de moeite die zij zich hebben getroost. Tevens wil ik de volgende personen bedanken omdat zij hebben bijgedragen aan de verzameling of de verwerking van de gegevens: Irene de Jager, Rob van Miltenburg, Gerrit van Miltenburg, Gerard de Vries, Theo de Vries en Doortje Wesseling." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "stadsgewest Amsterdam" ;
            sgpl:text_context "Het betreft hier een reconstructie van het verhuisverleden van twee groepen allochtone huishoudens, alle woonachtig in kleine plattelandskernen. Voormalige bewoners van het stadsgewest Amsterdam en de regio Noordwest-Utrecht worden vergeleken op hun verhuisfrequentie en de kenmerken van de door hen bewoonde woningen. Daartoe zijn in december 1984 en januari 1985 in een drietal dorpen vragenlijsten verspreid met het verzoek deze in te vullen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept224 ;
            sgpl:subjectText "Gezinscyclus" ;
            sgpl:text_context "Bij het reconstrueren van de verhuisfrequentie van een huishouden in het verleden dienen we hiermee voortdurend rekening te houden. Vooral wanneer de huishoudensgrootte wijzigingen ondergaat is men, naar verhouding, zeer mobiel. Verscheidene auteurs hebben dan ook schema’s ontworpen waarin de gezinscyclus wordt onderverdeeld in fasen (VAN LEEUWEN 1980; ALDOUS 1978). Foote c.s. bijvoorbeeld hanteerden een indeling waarin sterk de nadruk werd gelegd op de tendens in de gezinsgrootte (WILLIS 1974, p. 60):" ],
        [ sgpl:refersToConcept unesco:concept2713 ;
            sgpl:subjectText "Woningkenmerken" ;
            sgpl:text_context "De volgende paragraaaf is hieraan gewijd. 1.2. Thema 2: Woningkenmerken Bij de reconstructie van de verhuisgeschiedenissen staan niet alleen de verhuisfrequentie en de vestigingsduur centraal maar ook de kenmerken van de woning. In deze paragraaf zal worden beschreven welke kenmerken aan de orde komen en waarom juist deze zijn gekozen." ],
        [ sgpl:refersToConcept unesco:concept2074 ;
            sgpl:subjectText "Verhuisfrequentie" ;
            sgpl:text_context "Zij die laat waren getrouwd verhuisden namelijk veel minder vaak in hun eerste huwelijksjaren dan personen die op lagere leeftijd in het huwelijk waren getreden. Het bovenstaande maakt duidelijk dat het bij het bestuderen van de verhuisfrequentie nuttig is een \"life-cycle\"-variabele te hanteren waarin de leeftijd van het hoofd van het huishouden is opgenomen. Aan deze wens komt de indeling van McCarthy volledig tegemoet (tabel 1.1.)." ],
        [ sgpl:refersToConcept unesco:concept224 ;
            sgpl:subjectText "Gezinscyclus" ;
            sgpl:text_context "Bij het reconstrueren van de verhuisfrequentie van een huishouden in het verleden dienen we hiermee voortdurend rekening te houden. Vooral wanneer de huishoudensgrootte wijzigingen ondergaat is men, naar verhouding, zeer mobiel. Verscheidene auteurs hebben dan ook schema’s ontworpen waarin de gezinscyclus wordt onderverdeeld in fasen (VAN LEEUWEN 1980; ALDOUS 1978). Foote c.s. bijvoorbeeld hanteerden een indeling waarin sterk de nadruk werd gelegd op de tendens in de gezinsgrootte (WILLIS 1974, p. 60):" ],
        [ sgpl:refersToConcept unesco:concept2713 ;
            sgpl:subjectText "Woningkenmerken" ;
            sgpl:text_context "De volgende paragraaaf is hieraan gewijd. 1.2. Thema 2: Woningkenmerken Bij de reconstructie van de verhuisgeschiedenissen staan niet alleen de verhuisfrequentie en de vestigingsduur centraal maar ook de kenmerken van de woning. In deze paragraaf zal worden beschreven welke kenmerken aan de orde komen en waarom juist deze zijn gekozen." ],
        [ sgpl:refersToConcept unesco:concept2074 ;
            sgpl:subjectText "Verhuisfrequentie" ;
            sgpl:text_context "Zij die laat waren getrouwd verhuisden namelijk veel minder vaak in hun eerste huwelijksjaren dan personen die op lagere leeftijd in het huwelijk waren getreden. Het bovenstaande maakt duidelijk dat het bij het bestuderen van de verhuisfrequentie nuttig is een \"life-cycle\"-variabele te hanteren waarin de leeftijd van het hoofd van het huishouden is opgenomen. Aan deze wens komt de indeling van McCarthy volledig tegemoet (tabel 1.1.)." ] ;
    sgpl:thesisID 141 .

sgpl:Thesis142 a sgpl:SGPLThesis ;
    dcterms:creator "J.H.J. van Nimwegen" ;
    dcterms:issued 1985 ;
    dcterms:title "Het aandeel van de bewoners in het beheer-proces van korporatiewoningen; overwegingen bij nieuwe beheervormen" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Wittevrouwen" ;
            sgpl:text_context "Het bestaat uit 4-hoog portiekflats van het type zoals dat in het einde van de vijftiger jaren gebouwd werd. De Goedestraat ligt bij het centrum van Utrecht in de wijk Wittevrouwen. De woningen hier bestaan uit recentelijk gerenoveerde negentiende eeuwse huizen, en zijn aan hofjes gelegen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Sterrenwi jk" ;
            sgpl:text_context "De flats verkeren in goede staat van onderhoud en vertonen geen leegstand van belang. —Sterrenwi jk. Het woningbestand in deze wijk bestaat uit vervangende nieuwbouw voor de oorspronkelijke witte huisjes." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stad Utrecht" ;
            sgpl:text_context "De woningstichting SW 2000 is voortgekomen uit een fusie tussen de \"Utrechtse woningstichting\" en de woningbouwvereniging \"De samenwerking\". De stichting beheert ongeveer 3500 woningen in de stad Utrecht. Het onderhoud-technische alswel het financieel-economische beheer is uit handen gegeven aan de beheerstichting \"BO-EX\"(stichting voor de bouw en exploitatie van woningen)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrechtse woningstichting" ;
            sgpl:text_context "In hoofdstuk 1 werd duidelijk, dat na de tweede wereldoorlog schaalvergroting en professionalisering de belangrijkste ontwikkelingen waren binnen het instituut korporatie. De onderzoeksgegevens uit hoofdstuk 5 en 6 zijn gebaseerd op 120 enquetes bij een Utrechtse woningstichting. Als er in deze samenvatting onderscheid wordt gemaakt naar deelpopulaties, dan zal de absolute omvang van deze deelpopulaties tussen haakjes vermeld worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748039 ;
            sgpl:spatialText "Rivierenwijk" ;
            sgpl:text_context "De wijken Rlvlerenwljk(l), Hoograven/Lunetten(2), Kanalenelland(3), 0vervecht(4), Sterrrenwljk(5), Majellapark(ó) en Wlttevrouwen(7). De grootste koncentraties woningen liggen In Hoograven, Kanaleneiland, Rivierenwijk en 0vervecht(zie figuur 4.1). —Rivierenwijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Majellapark" ;
            sgpl:text_context "—Majellapark en de Goedestraat. In de wijk Majellapark ligt het kleine SW 2000 komplex Queridostraat. Het bestaat uit 4-hoog portiekflats van het type zoals dat in het einde van de vijftiger jaren gebouwd werd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "De oprichting van de eerste korporatie \"de vereniging ten behoeve van de arbeidersklasse\", vindt plaats in 1851 in Amsterdam (Kleyn,1954). Dit gebeurde deels uit speculatieve, deels uit filantropische motieven. Nycolaas noemt nog drie andere motieven voor arbeidersbouw voor 1900 nml:(Nycolaas,1974,p.18)" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753676 ;
            sgpl:spatialText "Hoograven" ;
            sgpl:text_context "De grootste koncentraties woningen liggen In Hoograven, Kanaleneiland, Rivierenwijk en 0vervecht(zie figuur 4.1). —Hoograven/Lonetten. Een klein gedeelte van het vooroorlogse woningbestand vinden we zoals reeds gezegd terug in de wijk Hoograven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748815 ;
            sgpl:spatialText "Overvecht" ;
            sgpl:text_context "Mensen die verder weg wonen zoeken vaker telefonisch kontakt. Mensen in de derde z&ne (n=37) (Overvecht) gaan ook vaak bij de huismeester te raden. Uit deze gegevens blijkt, dat voor sommige mensen een face to face kontakt de voorkeur geniet boven telefonisch kontakt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753082 ;
            sgpl:spatialText "Kanaleneiland" ;
            sgpl:text_context "De grootste koncentraties woningen liggen In Hoograven, Kanaleneiland, Rivierenwijk en 0vervecht(zie figuur 4.1). -Kanaleneiland. Ook Kanaleneiland is rijk voorzien van 4 hoog portlekflats." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept9679 ;
            sgpl:subjectText "moeder-dochterkorporatie" ;
            sgpl:text_context "In hoofdstuk zeven zullen nieuwe beheervormen getoetst worden aan enkele kriteria, die opgesteld zijn aan de hand van de onderzoeksuitkomsten en literatuur. Als meest belovende beheervorm komt de moeder-dochterkorporatie naar voren. Als belangrijkste voordelen boven de andere nieuwe beheervormen zijn te noemen: a. er wordt aandacht besteed aan bewonersinformatie en begeleiding." ],
        [ sgpl:refersToConcept unesco:concept670 ;
            sgpl:subjectText "nieuwe beheervormen" ;
            sgpl:text_context "Participatie van bewoners in het beheer was in de jaren zeventig een belangrijk onderwerp van diskussie en onderzoek in de volkshuisvesting. Participatieschema's en nieuwe beheervormen waren de vruchten van deze diskussies en onderzoeken, die voornamelijk de verruiming van de rol van de bewoners in het beheer voor ogen hadden. Slechts zelden werd de aandacht gericht op de rol die de bewoner reeds vervult in het beheer." ],
        [ sgpl:refersToConcept unesco:concept5339 ;
            sgpl:subjectText "bewonerszeggenschap" ;
            sgpl:text_context "Centraal staat de vraag welke omstandigheden de aktiviteit van de bewoner in het beheer be'invloeden. Ook wordt bekeken inhoeverre de onderzoeksuitkomsten betekenis hebben voor de verruiming van de bewonerszeggenschap in het beheer. De bijlagen van deze studie zijn in een appart boekje opgenomen, dat evenals het onderzoeksverslag, is te bestellen bij het Geografisch instituut van de Rijksuniversiteit Utrecht ." ],
        [ sgpl:refersToConcept unesco:concept5339 ;
            sgpl:subjectText "bewonerszeggenschap" ;
            sgpl:text_context "Centraal staat de vraag welke omstandigheden de aktiviteit van de bewoner in het beheer be'invloeden. Ook wordt bekeken inhoeverre de onderzoeksuitkomsten betekenis hebben voor de verruiming van de bewonerszeggenschap in het beheer. De bijlagen van deze studie zijn in een appart boekje opgenomen, dat evenals het onderzoeksverslag, is te bestellen bij het Geografisch instituut van de Rijksuniversiteit Utrecht ." ],
        [ sgpl:refersToConcept unesco:concept9679 ;
            sgpl:subjectText "moeder-dochterkorporatie" ;
            sgpl:text_context "In hoofdstuk zeven zullen nieuwe beheervormen getoetst worden aan enkele kriteria, die opgesteld zijn aan de hand van de onderzoeksuitkomsten en literatuur. Als meest belovende beheervorm komt de moeder-dochterkorporatie naar voren. Als belangrijkste voordelen boven de andere nieuwe beheervormen zijn te noemen: a. er wordt aandacht besteed aan bewonersinformatie en begeleiding." ],
        [ sgpl:refersToConcept unesco:concept670 ;
            sgpl:subjectText "nieuwe beheervormen" ;
            sgpl:text_context "Participatie van bewoners in het beheer was in de jaren zeventig een belangrijk onderwerp van diskussie en onderzoek in de volkshuisvesting. Participatieschema's en nieuwe beheervormen waren de vruchten van deze diskussies en onderzoeken, die voornamelijk de verruiming van de rol van de bewoners in het beheer voor ogen hadden. Slechts zelden werd de aandacht gericht op de rol die de bewoner reeds vervult in het beheer." ] ;
    sgpl:thesisID 142 .

sgpl:Thesis143 a sgpl:SGPLThesis ;
    dcterms:creator "Helène van der Poel",
        "Marjolijn van Valkenhoef" ;
    dcterms:issued 1985 ;
    dcterms:title "Acquisite van buitenlandse bedrijven door regionale en lokale overheden.",
        "NEDERLAND IN DE (UIT)VERKOOP" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord Brabant" ;
            sgpl:text_context "Van Agt geniet in het buitenland bekendheid als oud-premier van Nederland. Hij is nu commissaris van de Koningin in Noord Brabant. Dit is een van de redenen waarom de acquisitie daar is ondergebracht bij de provincie en niet bij de Brabantse Ontwikkelingsmaatschappij." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Limburg" ;
            sgpl:text_context "Enschede richt zich sterk op computers, Limburg daarentegen richt zich juist niet op de computer branche, omdat daar teveel concurrentie in bestaat (zowel van regio's als van bedrijven), maar richt zich op de apparatenbouw. Elke regio probeert zo zijn eigen specifieke mogelijkheden en wensen naar voren te brengen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Regionale voorkeuren: Tot '64 zijn de investeringen vooral geconcentreerd in de Randstad. Ruim 50% van de werkgelegenheid in buitenlandse bedrijven bevindt zich in de drie westelijke provincies." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "De productiecentra, die grondstoffen gebruiken, verschuiven naar de kust. Rotterdam is daardoor het grootste raffinage—centrum binnen de E.G. geworden. Ook heeft het een belangrijke plaats als distributiecentrum (overslag e.d.) veroverd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756631 ;
            sgpl:spatialText "Drenthe" ;
            sgpl:text_context "Het zal duidelijk zijn dat het voor Gelderland niet zoveel zin heeft zich op de offshore te richten en dat het voor Drenthe moeilijk is om havengebonden activiteiten aan te trekken. Afgezien van deze duidelijk plaatsgebonden industrieën, zijn er opvallende overeenkomsten in de bedrijfstakken waarop regio's zich richten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT NEDERLAND IN DE (UIT)VERKOOP: Acquisite van buitenlandse bedrijven door regionale en lokale overheden. Utrecht (030)532044 VAN LEERONDERZOEK SGS" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747890 ;
            sgpl:spatialText "gemeente Rotterdam" ;
            sgpl:text_context "Tenslotte hebben enkele instanties nog een soort 'Club van wijze mannen'. Zie bijlage 3 voor een voorbeeld van een organisatiestructuur. Figuur 2. Organisatie economische promotie en werving van de gemeente Rotterdam." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT NEDERLAND IN DE (UIT)VERKOOP: Acquisite van buitenlandse bedrijven door regionale en lokale overheden. Utrecht (030)532044 VAN LEERONDERZOEK SGS" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756071 ;
            sgpl:spatialText "Enschede" ;
            sgpl:text_context "Helaas houdt men niet altijd rekening met het opleidingsniveau in de regio en ontbreekt er vaak een middenkader. Enschede richt zich sterk op computers, Limburg daarentegen richt zich juist niet op de computer branche, omdat daar teveel concurrentie in bestaat (zowel van regio's als van bedrijven), maar richt zich op de apparatenbouw. Elke regio probeert zo zijn eigen specifieke mogelijkheden en wensen naar voren te brengen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmegen" ;
            sgpl:text_context "De meeste acquisiteurs onderkennen deze problemen wel. Bovendien 'kun je het in deze tijd politiek gezien niet maken om er niets aan te doen' (Nijmegen). Op de kosten en baten van acquisitie zullen we later nog terugkomen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "City-marketing" ;
            sgpl:text_context "In 3.1. behandelen we de suggesties uit het McKinsey rapport over de rol die de overheid kan spelen bij het aantrekkelijker maken van Nederland voor buitenlandse investeerders. In 3.2. stappen we over naar een begrip dat men sinds enkele jaren steeds meer hoort, namelijk city-marketing. Dit begrip is door Prof.Dr.van Gent omschreven als: 'het hele proces van de marketing toegepast op de stad die zich verkoopt." ],
        [ sgpl:refersToConcept unesco:concept8751 ;
            sgpl:subjectText "Regionaal-economisch beleid" ;
            sgpl:text_context "Ook komt het regionaal-economisch beleid aan de orde. Hoewel dit volgens het Commissariaat Buitenlandse Investeringen geen duidelijke rol speelt bij de acquisitie op nationaal niveau, schept het wel voorwaarden en mogelijkheden bij de acquisitie op regionaal niveau. Dit beleid zal ook naar niveau uitgesplitst behandeld worden." ],
        [ sgpl:refersToConcept unesco:concept511 ;
            sgpl:subjectText "Acquisitie van buitenlandse bedrijven" ;
            sgpl:text_context "De namen van de instellingen en personen die we gesproken hebben, zijn opgenomen in bijlage 1. Centraal staat de acquisitie van buitenlandse bedrijven door verschillende overheidsinstanties: Commissariaat Buitenlandse Investeringen, provincies, ROM's, ETI's, gemeenten. Met name de volgende onderwerpen krijgen de aandacht: aanpak en evaluatie, afstemming en coördinatie, organisatie." ],
        [ sgpl:refersToConcept unesco:concept8751 ;
            sgpl:subjectText "Regionaal-economisch beleid" ;
            sgpl:text_context "Ook komt het regionaal-economisch beleid aan de orde. Hoewel dit volgens het Commissariaat Buitenlandse Investeringen geen duidelijke rol speelt bij de acquisitie op nationaal niveau, schept het wel voorwaarden en mogelijkheden bij de acquisitie op regionaal niveau. Dit beleid zal ook naar niveau uitgesplitst behandeld worden." ],
        [ sgpl:refersToConcept unesco:concept511 ;
            sgpl:subjectText "Acquisitie van buitenlandse bedrijven" ;
            sgpl:text_context "De namen van de instellingen en personen die we gesproken hebben, zijn opgenomen in bijlage 1. Centraal staat de acquisitie van buitenlandse bedrijven door verschillende overheidsinstanties: Commissariaat Buitenlandse Investeringen, provincies, ROM's, ETI's, gemeenten. Met name de volgende onderwerpen krijgen de aandacht: aanpak en evaluatie, afstemming en coördinatie, organisatie." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "City-marketing" ;
            sgpl:text_context "In 3.1. behandelen we de suggesties uit het McKinsey rapport over de rol die de overheid kan spelen bij het aantrekkelijker maken van Nederland voor buitenlandse investeerders. In 3.2. stappen we over naar een begrip dat men sinds enkele jaren steeds meer hoort, namelijk city-marketing. Dit begrip is door Prof.Dr.van Gent omschreven als: 'het hele proces van de marketing toegepast op de stad die zich verkoopt." ] ;
    sgpl:thesisID 143 .

sgpl:Thesis144 a sgpl:SGPLThesis ;
    dcterms:creator "Bob Sinnige",
        "Paul Trip" ;
    dcterms:issued 1985 ;
    dcterms:title "Startende bedrijven in Zuid-West Gelderland." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Een groot probleem is dat het niet eenvoudig zal zijn om tot een werkelijke decentralisatie van de middelen te komen omdat de wil hiertoe in Den Haag ontbreekt. Voortzetting van het huidige subsidiebeleid ligt meer in de lijn der verwachtingen. Van de vele subsidieregelingen in ons land zijn er maar weinig waarvan op grote schaal gebruik wordt gemaakt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746331 ;
            sgpl:spatialText "Kamer van Koophandel en Fabrieken district Tiel" ;
            sgpl:text_context "Het onderzoeksgebied omvat het Kamer van Koophandel en Fabrieken district Tiel wat nagenoeg samenvalt met het COPOP-gebied Zuid-west Gelderland. Het verschil bestaat daaruit dat de gemeenten Dreumel, Wamel en Appeltern niet tot het kamerdistrict Tiel behoren maar wel tot het COROP-gebied Zuid-West Gelderland. Bovendien maakt de gemeente Dodewaard wel deel uit van het kamerdistrict Tiel maar niet van het COROP-gebied Zuid-West Gelderland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746330 ;
            sgpl:spatialText "gemeente Tiel" ;
            sgpl:text_context "De hoofddoelstelling zal echter wel worden gehandhaafd. Er zal niet meer worden uitgegaan van een vestigingsoverschot maar er zal gestreefd moeten worden naar een evenwicht tussen vestiging en vertrek. De gemeente Tiel zal een vestigingsgebied moeten blijven voor zowel bevolking als bedrijvigheid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747351 ;
            sgpl:spatialText "s-Hertogenbosch" ;
            sgpl:text_context "De lokaties die men overwogen had lagen bovendien vrij dicht in de buurt van de eigen streek. Bijna de helft van deze ondernemers hadden hiervoor Noord-Brabant en in het bijzonder 's-Hertogenbosch uitgekozen. De belangrijkste reden dat men toch niet elders het bedrijf is gestart was dat men over het algemeen de huur van het bedrijfspand op de andere lokatie te hoog vond." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Wever constateert in zijn boek \"Nieuwe bedrijven in Nederland\" (1984) een toename van het aantal zelfstandig opgerichte bedrijven. Hierbij bespeurt hij sterke verschillen tussen de diverse districten van de Kamers van Koophandel en Fabrieken. Een van de kamerdistricten die daarbij positief uit de bus komt is het kamerdistrict Tiel." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "COROP-gebied Zuid-West Gelderland" ;
            sgpl:text_context "Het gebied dat dit district omvat, valt nagenoeg samen met het COROP-gebled Zuid-West Gelderland. In dit district is sprake van veel oprichtingen, weinig opheffingen en een evenwichtige sectorale opbouw. Juist in een tijd van economische stagnatie, gepaard gaande aan bedrijfssluitingen en verlies van werkgelegenheid in met name de grotere bedrijven, wordt een heroriëntatie van de economie wenselijk geacht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Zuid-West Gelderland" ;
            sgpl:text_context "Dit rapport is het verslag van een onderzoek naar startende bedrijven in Zuid-West Gelderland. Het onderzoek werd verricht in het kader van de doctoraalstudie Toegepaste Geografie en Puiintelijke Planning aan de Rijks Universiteit Utrecht. Bij de totstandkoming van dit rapport zijn we door veel mensen en instanties geholpen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad Holland" ;
            sgpl:text_context "De geografische ligging van Zuid-West Gelderland is niet ongunstig grenzend aan het economisch zwaartepunt van Nederland: de Randstad Holland. Gezien het restrictieve overheidsbeleid ten aanzien van bedrijfsvestiging in het groene hart kan Zuid-West Gelderland profiteren van de groeitendenzen van de Randstad die naar buiten gericht zijn. Zuid-West Gelderland kenmerkt zich door de grote rivieren die het in westelijke richting doorkruisen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758673 ;
            sgpl:spatialText "Bommelerwaard" ;
            sgpl:text_context "Opvallend is de rol van de acht gemeenten in de Bommelerwaard. Deze scoren, met uitzondering van Zaltbommel en Rossum, laag. De gemeenten in de Fidden-Betuwe: Faurik, Lienden en Resteren en de aangrenzende gemeente Buren hebben een redelijk aantal starters binnen de grenzen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756777 ;
            sgpl:spatialText "Dodewaard" ;
            sgpl:text_context "Bovendien maakt de gemeente Dodewaard wel deel uit van het kamerdistrict Tiel maar niet van het COROP-gebied Zuid-West Gelderland. De belangrijkste gemeenten, naar inwonertal, in dit gebied zijn Tiel, Culemborg, Zaltbommel en Geldermalsen. De afbakening van de onderzoekspopulatie vooraf is noodzakelijk om een keuze te kunnen maken welke bedrijven wel en welke niet onderzocht worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746331 ;
            sgpl:spatialText "Tiel" ;
            sgpl:text_context "Het name willen we drs. Nico Tijdink van de kamer van koophandel in Tiel en drs. H. Jeene van het gewestelijk arbeidsbureau, ook in Tiel, bedanken voor het geven van adviezen en het verstrekken van materiaal. Een woord van dank gaat ook uit naar professor Wever uit Nijmegen die ons in een vroeg stadium van het onderzoek heeft geholpen. Voorts zijn we zeer erkentelijk voor de meer dan goede begeleiding die wij kregen uit onze eigen vakgroep G & P van drs. Jan van Weesep en drs. Peter Boelhouwer." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "De lokaties die men overwogen had lagen bovendien vrij dicht in de buurt van de eigen streek. Bijna de helft van deze ondernemers hadden hiervoor Noord-Brabant en in het bijzonder 's-Hertogenbosch uitgekozen. De belangrijkste reden dat men toch niet elders het bedrijf is gestart was dat men over het algemeen de huur van het bedrijfspand op de andere lokatie te hoog vond." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3402 ;
            sgpl:subjectText "Productiemilieu" ;
            sgpl:text_context "Het begrip productiemilieu neemt al jaren een belangrijke plaats in binnen de economische geografie. Het kan omschreven worden als 'het geheel van externe condities, met andere woorden, factoren buiten de directe bedrijfshuishouding, die op de vestiging en het functioneren van de bedrijfshuishouding van invloed zijn' (de Smidt 1975). Het (regionale) productiemilieu geeft de economische aspecten van het maatschappelijk kader waarin alle aanwezige productiehuishoudens (de regionale productiestructuur) zijn ingebed (van Blokland en Roelofs 1984)." ],
        [ sgpl:refersToConcept unesco:concept3605 ;
            sgpl:subjectText "Startende bedrijven" ;
            sgpl:text_context "Nieuwe en innovatieve bedrijven zullen hierbij een belangrijke rol moeten gaan spelen zodat de basisinnovaties die de naoorlogse groei hebben gedragen vervangen worden (van Duijn,1979). Startende bedrijven kunnen op deze wijze een voedingsbodem vormen van waaruit gezonde bedrijven voortkomen en op deze manier een bijdrage leveren tot het herstel van de werkgelegenheid. Net betrekking tot de verbetering van de werkgelegenheid moet echter wel gesteld worden dat pas op de lange termijn sprake zal zijn van substantiële netto werkgelegenheidsgroei (1'eershoek en van der Zee 1984)." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Lokatiekeuze" ;
            sgpl:text_context "Bij de beslissing om te starten wordt al impliciet een lokatiekeuze gemaakt. De lokatiekeuze is slechts een afgeleide van de wens om te starten. Een startende ondernemer houdt zich hier ook nauwelijks mee bezig." ],
        [ sgpl:refersToConcept unesco:concept3605 ;
            sgpl:subjectText "Startende bedrijven" ;
            sgpl:text_context "Nieuwe en innovatieve bedrijven zullen hierbij een belangrijke rol moeten gaan spelen zodat de basisinnovaties die de naoorlogse groei hebben gedragen vervangen worden (van Duijn,1979). Startende bedrijven kunnen op deze wijze een voedingsbodem vormen van waaruit gezonde bedrijven voortkomen en op deze manier een bijdrage leveren tot het herstel van de werkgelegenheid. Net betrekking tot de verbetering van de werkgelegenheid moet echter wel gesteld worden dat pas op de lange termijn sprake zal zijn van substantiële netto werkgelegenheidsgroei (1'eershoek en van der Zee 1984)." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Lokatiekeuze" ;
            sgpl:text_context "Bij de beslissing om te starten wordt al impliciet een lokatiekeuze gemaakt. De lokatiekeuze is slechts een afgeleide van de wens om te starten. Een startende ondernemer houdt zich hier ook nauwelijks mee bezig." ],
        [ sgpl:refersToConcept unesco:concept3402 ;
            sgpl:subjectText "Productiemilieu" ;
            sgpl:text_context "Het begrip productiemilieu neemt al jaren een belangrijke plaats in binnen de economische geografie. Het kan omschreven worden als 'het geheel van externe condities, met andere woorden, factoren buiten de directe bedrijfshuishouding, die op de vestiging en het functioneren van de bedrijfshuishouding van invloed zijn' (de Smidt 1975). Het (regionale) productiemilieu geeft de economische aspecten van het maatschappelijk kader waarin alle aanwezige productiehuishoudens (de regionale productiestructuur) zijn ingebed (van Blokland en Roelofs 1984)." ] ;
    sgpl:thesisID 144 .

sgpl:Thesis145 a sgpl:SGPLThesis ;
    dcterms:creator "Arnoud van der Valk",
        "Rene van IJzendoorn" ;
    dcterms:issued 1985 ;
    dcterms:title "Een economisch-geografische studie naar de herbenuttingsmogelijkheden van in onbruik geraakte bedrijfsruimte in de gemeente Utrecht.",
        "HERSTRUCTURERING EN BEDRIJFSRUIMTE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "VMF/Cartesius-terrein" ;
            sgpl:text_context "Dit leidde tot een keuze van de volgende vier herstructureringsterreinen: - het Hibe-terrein - het VMF/Cartesius-terrein - het Avery-terrein - het Demka-terrein. In onderstaande tabel (tabel 3.1) zijn enkele belangrijke gegevens van de vier herstructureringsterreinen naast elkaar gezet. Hierbij wordt onderscheid gemaakt tussen de oorspronkelijke situatie, dat wil zeggen de toestand voor herstructurering, en de huidige situatie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Hibe-terrein" ;
            sgpl:text_context "Dit leidde tot een keuze van de volgende vier herstructureringsterreinen: - het Hibe-terrein - het VMF/Cartesius-terrein - het Avery-terrein - het Demka-terrein. Voor het Hibe-terrein zijn concrete herstructureringsplannen aanwezig. Hiermee verkeert het terrein al in een vergevorderd stadium van herstructurering." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Dit verslag is het resultaat van een onderzoek in het kader van een doctoraalstudie Sociale Geografie van Stedelijk-Industriele landen (SGS), met als specialisatie 'Bedrijvigheid' (Economische Geografie). In het onderzoek is getracht een inzicht te verkrijgen in de herbenuttingsmogelijkheden van in onbruik geraakte bedrijfsruimte in de gemeente Utrecht. Deze publicatie in de reeks 'Verslagen van leeronderzoek SGS' is een uitgebreide samenvatting van onze doctoraalscriptie 'Herstructurering en Bedrijfsruimte' (juli 1984)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2752014 ;
            sgpl:spatialText "Lage Weide" ;
            sgpl:text_context "Met name de collectieve bedrijfsterreinen Lage Weide, Overvecht, VMF/Cartesius, Lunetten en het Hibe-terrein kunnen worden genoemd. Deze terreinen zijn samen goed voor ongeveer 100 hectare nog uitgeefbaar terrein, waarvan het grootste deel voor rekening komt van Lage Weide (ongeveer 70 hectare). Een beschrijving van de verschillende binnenstedelijke productiemilieus vond plaats aan de hand van een door ons opgestelde bedrijfsterreinentypologie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "oude stad van Utrecht" ;
            sgpl:text_context "Om praktische redenen is de bedrijven-enquete beperkt gebleven tot het gebied van de oude stad van Utrecht, een op het oog vrij ongunstige locatie voor bedrijven met groeipotentie. Tevens hebben we alle consumentverzorgende bedrijven (detailhandel), nutsbedrijven en (semi)overheidsdiensten buiten beschouwing gelaten en zijn van de overgebleven niet-consumentverzorgende bedrijven alleen vestigingen met (in 1982) vijftig of minder werkzame personen onderzocht. Naast de bedrijven-enquete in de oude stad vond ook een onderzoek plaats naar het functioneren van twee recentelijk ontwikkelde bedrijvencentra in Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Avery-terrein" ;
            sgpl:text_context "In onderstaande tabel (tabel 3.1) zijn enkele belangrijke gegevens van de vier herstructureringsterreinen naast elkaar gezet. De herstructureringsmogelijkheden van het Avery-terrein en het daarop aanwezige bedrijfspand (zie figuur 3.6) kunnen vanuit een bredere optiek bezien worden, dan zoals dit heeft plaats gevonden bij de hiervoor besproken bedrijfsterreinen. Bij het Avery-terrein zijn namelijk nog geen herstructureringsplannen opgesteld (planologisch vormt het een 'witte vlek') en ook een eventuele bestemmingsverandering, dan wel functieverandering binnen eenzelfde bestemming kan ter discussie staan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Demka-terrein" ;
            sgpl:text_context "Een nader onderzoek is wat dit aangaat gewenst. De gang van zaken rond de herstructurering van het Demka-terrein bevindt zich in een vrij pril stadium. Sinds de sluiting van het metaalbedrijf in het najaar van 1983 houdt een commissie, waarin zitting hebben afgevaardigden van Hoogovens, de vakbond FNV en de gemeente, zich bezig met het zoeken naar vervangende werkgelegenheid voor het voormalig Demka-personeel." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "1.1 Probleemstelling. Het blijkt dat in veel steden in Nederland een steeds groter oppervlak aan bedrijfsruimte onbenut blijft. Aan de ene kant blijkt er een surplus te bestaan aan nieuw uit te geven bedrijfsruimte, veelal in de vorm van door gemeenten aangelegd collectief bedrijfsterrein." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Herstructurering van bedrijfsterreinen" ;
            sgpl:text_context "Met het ineenzakken van de bouwactiviteiten in Nederland wordt de (her-)inrichting en het beheer van de bestaande gebouwde omgeving steeds belangrijker. Hierdoor zullen herschikking, herbestemming en herstructurering van de bestaande stedelijke structuren de komende jaren op de voorgrond treden. Herstructurering van in onbruik geraakte bedrijfsterreinen kan als instrument worden gehanteerd in het kader van een ruimtelijk-economisch beleid." ],
        [ sgpl:refersToConcept unesco:concept3776 ;
            sgpl:subjectText "Bedrijvencentra" ;
            sgpl:text_context "Naast de bedrijven-enquete in de oude stad vond ook een onderzoek plaats naar het functioneren van twee recentelijk ontwikkelde bedrijvencentra in Utrecht. Nagegaan werd in hoeverre hun huidige locatie tegemoet komt aan de wensen en eisen die zij destijds ten aanzien van hun nieuwe vestigingsplaats hadden. De door ons onderzochte categorieën \"ruimtevragers” vertegenwoordigen slechts een zeer specifieke (en dus beperkte) vraag naar bedrijfsruimte, namelijk de vraag vanuit het midden- en kleinbedrijf in de oude stad." ],
        [ sgpl:refersToConcept unesco:concept153 ;
            sgpl:subjectText "Bedrijfsruimtevoorkeuren" ;
            sgpl:text_context "In de laatse fase zijn de resultaten van het onderzoek samengevat en is een aantal algemene conclusies getrokken. Op basis van bovenstaande zijn we gekomen tot de volgende probleemstelling: \"Welke mogelijkheden zijn er voor herstructurering van momenteel onbenutte, oude bedrijfsterreinen en de zich hierop eventueel bevindende bedrijfspanden, in de gemeente Utrecht, bezien in het licht van bedrijfstakspecifieke bedrijfsruimtevoorkeuren, het gemeentelijk beleid en de economische conjunctuur\". Hierbij werd het begrip herstructurering als volgt omschreven: \"Iedere vorm van hergebruik van in onbruik geraakt bedrijfsterrein en van de zich hierop eventueel bevindende bedrijfsgebouwen\"." ],
        [ sgpl:refersToConcept unesco:concept3776 ;
            sgpl:subjectText "Bedrijvencentra" ;
            sgpl:text_context "Naast de bedrijven-enquete in de oude stad vond ook een onderzoek plaats naar het functioneren van twee recentelijk ontwikkelde bedrijvencentra in Utrecht. Nagegaan werd in hoeverre hun huidige locatie tegemoet komt aan de wensen en eisen die zij destijds ten aanzien van hun nieuwe vestigingsplaats hadden. De door ons onderzochte categorieën \"ruimtevragers” vertegenwoordigen slechts een zeer specifieke (en dus beperkte) vraag naar bedrijfsruimte, namelijk de vraag vanuit het midden- en kleinbedrijf in de oude stad." ],
        [ sgpl:refersToConcept unesco:concept153 ;
            sgpl:subjectText "Bedrijfsruimtevoorkeuren" ;
            sgpl:text_context "In de laatse fase zijn de resultaten van het onderzoek samengevat en is een aantal algemene conclusies getrokken. Op basis van bovenstaande zijn we gekomen tot de volgende probleemstelling: \"Welke mogelijkheden zijn er voor herstructurering van momenteel onbenutte, oude bedrijfsterreinen en de zich hierop eventueel bevindende bedrijfspanden, in de gemeente Utrecht, bezien in het licht van bedrijfstakspecifieke bedrijfsruimtevoorkeuren, het gemeentelijk beleid en de economische conjunctuur\". Hierbij werd het begrip herstructurering als volgt omschreven: \"Iedere vorm van hergebruik van in onbruik geraakt bedrijfsterrein en van de zich hierop eventueel bevindende bedrijfsgebouwen\"." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Herstructurering van bedrijfsterreinen" ;
            sgpl:text_context "Met het ineenzakken van de bouwactiviteiten in Nederland wordt de (her-)inrichting en het beheer van de bestaande gebouwde omgeving steeds belangrijker. Hierdoor zullen herschikking, herbestemming en herstructurering van de bestaande stedelijke structuren de komende jaren op de voorgrond treden. Herstructurering van in onbruik geraakte bedrijfsterreinen kan als instrument worden gehanteerd in het kader van een ruimtelijk-economisch beleid." ] ;
    sgpl:thesisID 145 .

sgpl:Thesis146 a sgpl:SGPLThesis ;
    dcterms:creator "Frank van Dam",
        "Marcel van der Velden" ;
    dcterms:issued 1986 ;
    dcterms:title "DEELTIJDLANDBOUW EN NEVENINKOMSTEN OP AGRARISCHE BEDRIJVEN IN DE STADSRANDZONE",
        "Een onderzoek naar de inkomensvorming op agrarische bedrijven in de stadsrandzones van Amsterdam en Zwolle" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "De polder Groot-Mijdrecht, welke zich in de provincie Utrecht bevindt, grenst direkt aan de zuidkant van de polder de Ronde Hoep (zie fig. 3.2, blz. 30). De polder is in dit onderzoek betrokken opdat een eventueel afstandsverval in de te bestuderen verschijnselen aangetoond zou kunnen worden. Deze polder strekt zich, evenals het herinrichtingsgebied Amstelland, uit over meerdere gemeenten, te weten Vinkeveen-Waverveen, Mijdrecht en Wilnis." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759802 ;
            sgpl:spatialText "herinrichtingsgebied Amstelland" ;
            sgpl:text_context "De motivering van de door ons gekozen onderzoeksgebieden volgt in paragraaf 1.6 . Paragraaf 1.7 besluit dit hoofdstuk met enkele konkluderende opmerkingen. De onderzoeksgebieden, welke als uitgangspunt hebben gediend waren het herinrichtingsgebied Amstelland en de polder Groot-Mijdrecht, ten zuiden en zuidoosten van Amsterdam (zie figuur 3.2, blz. 30)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751106 ;
            sgpl:spatialText "polder Mastenbroek" ;
            sgpl:text_context "Ten zuiden van Zwolle (zie fig. 3.1, blz. 29) verkeert men in het beginstadium van de ruilverkaveling Salland-West. Ten noordwesten van Zwolle ligt de polder Mastenbroek. De ruilverkaveling hier, bevindt zich in de eindfase." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757349 ;
            sgpl:spatialText "Delfgauw" ;
            sgpl:text_context "Overigens dient hier nog opgemerkt te worden dat boeren niet altijd gebruik hoeven te maken van de potentiële afzetmarkt die de stad vormt. Zo konkludeert KLOOSTERBOER (1981, p. 59) in zijn studie over Delfgauw, dat het grootste deel van de afnemers van de door boeren aan huis verkochte produkten, buren of mensen uit het dorp Delfgauw waren en niet zozeer stedelingen uit het nabijgelegen Delft. De centrale probleemstelling luidt als volgt:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "ruilverkaveling Salland-West" ;
            sgpl:text_context "De gemeente Zwolle heeft als gevolg van annexatie van naburige gemeenten een opvallend groot buitengebied. Ten zuiden van Zwolle (zie fig. 3.1, blz. 29) verkeert men in het beginstadium van de ruilverkaveling Salland-West. Ten noordwesten van Zwolle ligt de polder Mastenbroek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Haaglanden" ;
            sgpl:text_context "Het is gelegen tussen stedelijke lobben (Amstelveen, Bijlmermeer) die te dicht bij elkaar liggen om tot een duidelijke zonering van het grondgebruik te komen, zoals bijvoorbeeld wel gelukt is in de Haaglanden, een stadsrandzone gelegen tussen steden (te weten 's-Gravenhage en Leiden) die wat verder van elkaar af liggen (mondelinge mededeling, P. Rowel, 1985). Het herinrichtingsgebied is 4.300 ha groot waarvan bij benadering 60% in gebruik is als kultuurgrond door de 154 agrarische bedrijven in het gebied. De kultuurgrond, overwegend veengrond, is praktisch geheel als grasland in gebruik." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "polder Groot-Mijdrecht" ;
            sgpl:text_context "De onderzoeksgebieden, welke als uitgangspunt hebben gediend waren het herinrichtingsgebied Amstelland en de polder Groot-Mijdrecht, ten zuiden en zuidoosten van Amsterdam (zie figuur 3.2, blz. 30). Op basis van bovenstaande kriteria is gezocht naar een vergelijkbare stadsrandzone. De keuze is gevallen op Zwolle." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "polder de Ronde Hoep" ;
            sgpl:text_context "Het herinrichtingsgebied is in 3 deelgebieden onder te verdelen, te weten Amstelland-Oost, Amstelland-West en de polder de Ronde Hoep (zie fig. 3.2, blz. 30). De woonkernen Ouderkerk aan de Amstel in het westelijke, en Driemond in het oostelijke deel van het gebied, zijn niet in het herinrichtingsgebied opgenomen. De grens van het gebied verloopt uiterst grillig." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "stadsrandzone van Amsterdam" ;
            sgpl:text_context "De drie deelonderzoeken kennen één belangrijke overeenkomst: de lokatie van het onderzoek, de stadsrandzone. De deelonderzoeken werden alle drie verricht in een deel van de stadsrandzone van Amsterdam en in de stadsrandzone van Zwolle. Hoofdstuk 3 geeft een beschrijving van de onderzoeksgebieden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743477 ;
            sgpl:spatialText "stadsrandzone van Zwolle" ;
            sgpl:text_context "De deelonderzoeken werden alle drie verricht in een deel van de stadsrandzone van Amsterdam en in de stadsrandzone van Zwolle. Hoofdstuk 3 geeft een beschrijving van de onderzoeksgebieden. In de hoofdstukken 4 en 5 worden de onderzoeksresultaten ten aanzien van respektievelijk de deeltijdlandbouw en de neveninkomsten op agrarische bedrijven gepresenteerd." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10894 ;
            sgpl:subjectText "neveninkomsten" ;
            sgpl:text_context "Paragraaf 2.2 en 2.3 behandelen respectievelijk de verschijnselen deeltijdlandbouw en neveninkomsten op agrarische bedrijven. Na het in paragraaf 2.2 behandelde verschijnsel deeltijdlandbouw, zal in deze paragraaf worden ingegaan op een verschijnsel dat eveneens van invloed is op de samenstelling van het huishoudelijk inkomen, namelijk de neveninkomsten op agrarische bedrijven. In paragraaf 2.3.2 zal allereerst besproken worden wat wij in het vervolg onder neveninkomsten zullen verstaan." ],
        [ sgpl:refersToConcept unesco:concept16538 ;
            sgpl:subjectText "stadsrandzone" ;
            sgpl:text_context "Onze keuze met betrekking tot de afbakening van de overgang tussen stad en landelijk gebied wordt in paragraaf 1.4 uiteengezet. We hanteren daarbij het begrip stadsrandzone. Allereerst willen we de kenmerken en de problematiek van de stadsrandzone beschrijven." ],
        [ sgpl:refersToConcept unesco:concept598 ;
            sgpl:subjectText "deeltijdlandbouw" ;
            sgpl:text_context "Algemeen doel van deze onderzoeken was, na te gaan of bepaalde verschijnselen in de stadsrandzone een specifieke verschijningsvorm kennen, hetzij qua vorm, hetzij qua intensiteit. Het onderhavige onderzoek richt zich op de verschijnselen deeltijdlandbouw en neveninkomsten op agrarische bedrijven in de stadsrandzone. De andere twee deelonderzoeken behandelen de opvolgingssituatie op agrarische bedrijven in de stadsrandzone enerzijds en de ruimtelijke konflikten in, en het ruimtelijk beleid ten aanzien van, de stadsrandzone anderzijds." ],
        [ sgpl:refersToConcept unesco:concept598 ;
            sgpl:subjectText "deeltijdlandbouw" ;
            sgpl:text_context "Algemeen doel van deze onderzoeken was, na te gaan of bepaalde verschijnselen in de stadsrandzone een specifieke verschijningsvorm kennen, hetzij qua vorm, hetzij qua intensiteit. Het onderhavige onderzoek richt zich op de verschijnselen deeltijdlandbouw en neveninkomsten op agrarische bedrijven in de stadsrandzone. De andere twee deelonderzoeken behandelen de opvolgingssituatie op agrarische bedrijven in de stadsrandzone enerzijds en de ruimtelijke konflikten in, en het ruimtelijk beleid ten aanzien van, de stadsrandzone anderzijds." ],
        [ sgpl:refersToConcept unesco:concept16538 ;
            sgpl:subjectText "stadsrandzone" ;
            sgpl:text_context "Onze keuze met betrekking tot de afbakening van de overgang tussen stad en landelijk gebied wordt in paragraaf 1.4 uiteengezet. We hanteren daarbij het begrip stadsrandzone. Allereerst willen we de kenmerken en de problematiek van de stadsrandzone beschrijven." ],
        [ sgpl:refersToConcept unesco:concept10894 ;
            sgpl:subjectText "neveninkomsten" ;
            sgpl:text_context "Paragraaf 2.2 en 2.3 behandelen respectievelijk de verschijnselen deeltijdlandbouw en neveninkomsten op agrarische bedrijven. Na het in paragraaf 2.2 behandelde verschijnsel deeltijdlandbouw, zal in deze paragraaf worden ingegaan op een verschijnsel dat eveneens van invloed is op de samenstelling van het huishoudelijk inkomen, namelijk de neveninkomsten op agrarische bedrijven. In paragraaf 2.3.2 zal allereerst besproken worden wat wij in het vervolg onder neveninkomsten zullen verstaan." ] ;
    sgpl:thesisID 146 .

sgpl:Thesis147 a sgpl:SGPLThesis ;
    dcterms:creator "A.M. Groen",
        "F.J. Kraan" ;
    dcterms:issued 1986 ;
    dcterms:title "DE TOEKOMST VAN DE HUURAPPARTEMENTEN IN DE HAAGSE WIJKEN VALKENBOSKWARTIER EN LAAKKWARTIER-OOST",
        "EEN ANALYSE VAN HET APPARTEMENTENBESTAND EN EEN ONDERZOEK ONDER EIGENAAR-VERHUURDERS" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "In de Haagse wijken Ualkenboskwartier en Laakkwartier-Oost hebben wij de appartementensektor onderzocht. In Den Haag is de laatste tien jaar het aantal appartementen sterk toengenomen. Hoe de ontwikkeling is geweest is moeilijk in te schatten, omdat pas na invoering van de splitsingsvergunning hierover enig inzicht is ontstaan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:11525083 ;
            sgpl:spatialText "Schildersbuurt" ;
            sgpl:text_context "Er valt een sterke ruimtelijke koncentratie van de splitsingspraktijk in bepaalde buurten te konstateren: 645i had betrekking op de buurten Ualkenboskwartier, Schildersbuurt, Regentessekwartier, Transvaalkwartier en de Bomen- en Bloemenbuurt. Al deze buurten bevatten grote delen met voor splitsing geschikte woningen: veel boven- en benedenwoningen (in het bijzonder de zogenaamde Haagse portiekwoning) van een redelijke bouwtechnische kwaliteit, maar vaak met grote achterstand in het herstel- en onderhoudswerk Chaas 1981). In hoofdstuk 1 werd gezegd dat de lokale overheid de vermeende negatieve gevolgen van appartementsplitsing, zoals de onttrekking van goedkope huurwonigen aan de woningvoorraad, probeerde tegen te gaan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746905 ;
            sgpl:spatialText "SpoorwiJk-Laakkwartier" ;
            sgpl:text_context "Laakkwartier is een onderdeel van de wijk SpoorwiJk-Laakkwartier en komt overeen met volkstellingsblok 85. De totale woningvoorraad in de buurt bevat 4815 woningen en 9O5s dateert uit de periode 1930-1340. Het woningbestand bestaat voornamelijk uit meergezinshuizen; 78/S van de woningen zijn portiekwoningen en 35s zijn boven- en benedenwoningen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Uerder gaat onze dank uit naar drs. J. Gramberg van de Dienst Stadsontwikkeling te ’s-Gravenhage en alle andere personen die een deel van hun (vaak kostbare) tijd vrij maakten voor een gesprek met ons. Utrecht, september 1SB6. A.n. Groen F.J. Kraan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:11525077 ;
            sgpl:spatialText "Ualkenboskwartier" ;
            sgpl:text_context "In Den Haag is de laatste tien jaar het aantal appartementen sterk toengenomen. In de Haagse wijken Ualkenboskwartier en Laakkwartier-Oost hebben wij de appartementensektor onderzocht. Het onderzoek sloot aan op eerder verricht onderzoek naar verkochte appartementen aan eigenaar-bewoners in deze wijken, dit werd door studenten van de Urije Universiteit van Amsterdam in 1985 uitgevoerd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747372 ;
            sgpl:spatialText "gemeente ’s-Gravenhage" ;
            sgpl:text_context "Dit alles deed bij de Dienst Stadsontwikkeling & Grondzaken van de gemeente ’s-Gravenhage de behoefte naar inzicht in deze problematiek ontstaan. tien was geïnteresseerd naar de omvang en de verspreiding van de appartementensektor en van de ermee samenhangende horizontale verkoop. Door de Dienst Stadsontwikkeling & Grondzaken en het Geografisch Instituut van de Urije Universiteit te Amsterdam werd een onderzoeksprojekt opgezet, waarbij in een viertal wijken geïnventariseerd werd hoeveel appartementsrechten er gevestigd waren, en hoeveel en welke verkooptransakties er hadden plaatsgevonden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751191 ;
            sgpl:spatialText "Mariahoeve" ;
            sgpl:text_context "Tevens werd onder de eigenaar-bewoners een onderzoek ingesteld naar hun redenen voor de aankoop van de betreffende woning en naar hun onderhouds- en verbeteringsgedrag. De wijken waarin het onderzoek verricht werd, zijn: Laakkwartier-Oost, Ualkenboskwartier, Statenkwartier en Mariahoeve. Het gaat hier om verschillende typen wijken die zich onderscheiden naar leeftijd, karakter van de bebouwing en sociale samenstelling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746826 ;
            sgpl:spatialText "Statenkwartier" ;
            sgpl:text_context "Tevens werd onder de eigenaar-bewoners een onderzoek ingesteld naar hun redenen voor de aankoop van de betreffende woning en naar hun onderhouds- en verbeteringsgedrag. De wijken waarin het onderzoek verricht werd, zijn: Laakkwartier-Oost, Ualkenboskwartier, Statenkwartier en Mariahoeve. Het gaat hier om verschillende typen wijken die zich onderscheiden naar leeftijd, karakter van de bebouwing en sociale samenstelling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Urije Universiteit van Amsterdam" ;
            sgpl:text_context "In de Haagse wijken Ualkenboskwartier en Laakkwartier-Oost hebben wij de appartementensektor onderzocht. Het onderzoek sloot aan op eerder verricht onderzoek naar verkochte appartementen aan eigenaar-bewoners in deze wijken, dit werd door studenten van de Urije Universiteit van Amsterdam in 1985 uitgevoerd. Ons onderzoek richtte zich op (nog) niet aan eigenaar-bewoners verkochte appartementen, met andere woorden de verhuurde appartementen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Laakkwartier-Oost" ;
            sgpl:text_context "In de Haagse wijken Ualkenboskwartier en Laakkwartier-Oost hebben wij de appartementensektor onderzocht. Ons onderzoek richtte zich op (nog) niet aan eigenaar-bewoners verkochte appartementen, met andere woorden de verhuurde appartementen. Het doel was een beter inzicht te krijgen in het funktioneren van deze sektor." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "appartementssplitsing" ;
            sgpl:text_context "Andere negatieve punten zijn prijsopdrijving en verzwakking van de positie van de huurder-bewoner van het appartement Chaas 13B11. Vanwege de vermeende negatieve gevolgen van de appartementssplitsing hebben lokale overheden in het verleden getracht appartementsplitsing en horizontale verkoop tegen te gaan. Op grond hiervan ging men over tot het Formuleren van het beleid, hetgeen niet altijd tot het gewenste resultaat heeft geleid CUan Weesop & Maas 19B41." ],
        [ sgpl:refersToConcept unesco:concept8849 ;
            sgpl:subjectText "partikuliere huursektor" ;
            sgpl:text_context "Het volgende hoofdstuk behandelt de ontwikkeling en typering van de partikuliere huursektor en de problematiek van de appartementen om te komen tot de uitgewerkte probleemstelling. De woningvoorraad kan worden opgedeeld in segmenten of sektoren, afhankelijk van de beheer/eigendomssituatie: eigen woningen, partikuliere huurwoningen en woningwetwoningen CUan der Schaar 1377). Het aandeel van de partikuliere huursektor in Nederland bedraagt ongeveer 175i; 75i is in handen van institutionele beleggers, als pensioenfondsen en verzekeringsmaatschappijen; en 10/f is in handen van partikuliere personen en bedrijven." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "horizontale verkoop" ;
            sgpl:text_context "In de jaren zeventig heeft er een sterke toename plaatsgevonden van de appartementsplitsing. men vreesde dat door de enorme vlucht van appartementsplitsing, met daarna de mogelijkheid tot horizontale verkoop, een grote onttrekking van relatief goedkope huurwoningen aan de woningmarkt zou ontstaan. Vanwege het belang van goedkope huurwoningen in het woonruimtebestand van vooral grote steden was duidelijkheid over de toekomst van de partikuliere huurwoningvoorraad gewenst." ],
        [ sgpl:refersToConcept unesco:concept8849 ;
            sgpl:subjectText "partikuliere huursektor" ;
            sgpl:text_context "Het volgende hoofdstuk behandelt de ontwikkeling en typering van de partikuliere huursektor en de problematiek van de appartementen om te komen tot de uitgewerkte probleemstelling. De woningvoorraad kan worden opgedeeld in segmenten of sektoren, afhankelijk van de beheer/eigendomssituatie: eigen woningen, partikuliere huurwoningen en woningwetwoningen CUan der Schaar 1377). Het aandeel van de partikuliere huursektor in Nederland bedraagt ongeveer 175i; 75i is in handen van institutionele beleggers, als pensioenfondsen en verzekeringsmaatschappijen; en 10/f is in handen van partikuliere personen en bedrijven." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "horizontale verkoop" ;
            sgpl:text_context "In de jaren zeventig heeft er een sterke toename plaatsgevonden van de appartementsplitsing. men vreesde dat door de enorme vlucht van appartementsplitsing, met daarna de mogelijkheid tot horizontale verkoop, een grote onttrekking van relatief goedkope huurwoningen aan de woningmarkt zou ontstaan. Vanwege het belang van goedkope huurwoningen in het woonruimtebestand van vooral grote steden was duidelijkheid over de toekomst van de partikuliere huurwoningvoorraad gewenst." ],
        [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "appartementssplitsing" ;
            sgpl:text_context "Andere negatieve punten zijn prijsopdrijving en verzwakking van de positie van de huurder-bewoner van het appartement Chaas 13B11. Vanwege de vermeende negatieve gevolgen van de appartementssplitsing hebben lokale overheden in het verleden getracht appartementsplitsing en horizontale verkoop tegen te gaan. Op grond hiervan ging men over tot het Formuleren van het beleid, hetgeen niet altijd tot het gewenste resultaat heeft geleid CUan Weesop & Maas 19B41." ] ;
    sgpl:thesisID 147 .

sgpl:Thesis148 a sgpl:SGPLThesis ;
    dcterms:creator "A.M.G. Stornebrink",
        "F.C.A. Fijen",
        "H.M.J.L. Koolen",
        "W.P.P. Kolner" ;
    dcterms:issued 1986 ;
    dcterms:title "Deel 1: het algemeen kader van het onderzoek en de case-studie Kennemerland.",
        "SCHAALVERGROTING IN HET HOGER BEROEPS ONDERWIJS: EEN GEOGRAFISCHE VERKENNING." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "Van de tien scholen zijn vijf dagscholen en drie avondscholen in Utrecht gevestigd, daarnaast is één dagschool in Hilversum en één dagschool in Amersfoort gevestigd. Om tot een goed beeld te komen van deze scholen en het onderwijs dat zij verzorgen, worden de volgende aspecten behandeld: 1. de aard en omvang van het onderwijs; 2. de ontwikkeling van het aantal ingeschreven studenten; 3. de huisvestingssituatie, het locatiepatroon en de bereikbaarheid van de instellingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "centrum van Haarlem" ;
            sgpl:text_context "Opvallend is de concentratie van gebouwen rond het centrum van Haarlem en de perifere ligging van de PDLS. In Haarlem kan de concentratie min of meer worden opgesplitst in twee clusters: één cluster ligt ten noordwesten van het centrum, één ten zuiden van het centrum. Eén gebouw ligt daar tussenin, in het centrum." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Haarlem" ;
            sgpl:text_context "In de HBO-regio Kennemerland is het HBO ruimtelijk geconcentreerd in een tweetal kernen, namelijk Haarlem en Heemstede. In Haarlem zijn gevestigd: - het Instituut voor Hoger Beroepsonderwijs (IHBO); - de Academie voor Gezondheidszorg Kennemerland (AvGZ); - de Intergemeentelijke Pedagogische Academie Basisonderwijs (IPABO); - de Stichting voor Opleiding tot Sociale Arbeid (SOSA). In Heemstede is gevestigd: - de R.K. Pedagogische Academie Basisonderwijs \"De la Salie\" (PDLS)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "CASE-STUDIE KENNEMERLAND Inleiding 3. Analyse van de huidige situatie 4. De analyse van toekomstige ontwikkelingen 5. .Aspecten van de toekomstige ruimtelijke invulling Deel 2 CASE-STUDIE UTRECHT 6. De analyse van de huidige situatie 7. De analyse van de toekomstige ontwikkelingen 8. Aspecten van de toekomstige ruimtelijke invulling 9. Samenvatting en evaluatie van de deelstudies Kennemerland en Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754064 ;
            sgpl:spatialText "Hilversum" ;
            sgpl:text_context "Van de tien scholen zijn vijf dagscholen en drie avondscholen in Utrecht gevestigd, daarnaast is één dagschool in Hilversum en één dagschool in Amersfoort gevestigd. Om tot een goed beeld te komen van deze scholen en het onderwijs dat zij verzorgen, worden de volgende aspecten behandeld: 1. de aard en omvang van het onderwijs; 2. de ontwikkeling van het aantal ingeschreven studenten; 3. de huisvestingssituatie, het locatiepatroon en de bereikbaarheid van de instellingen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7302154 ;
            sgpl:spatialText "HBO-regio Kennemerland" ;
            sgpl:text_context "In de HBO-regio Kennemerland wordt het Hoger Beroeps Onderwijs vertegenwoordigd door een vijftal scholen. Net zoals elders in het land proberen deze scholen aan het in hoofdstuk 1 genoemde schaalvergrotingsproces gestalte te geven. De HBO-Raad was in de tussenrapportage positief over de gang van zaken in de regio." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "De Uithof als locatie voor het Hoger Beroepsonderwijs zal de samenwerking met de Universiteit vergemakkelijken vanwege de geringe afstand. De gemeente Utrecht wil naast vestiging van onderwijs- voorzieningen, woningbouw in de Uithof realiseren om de leefbaarheid te vergroten. De HBO-scholen zijn enthousiast over locatie in de Uithof." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7302154 ;
            sgpl:spatialText "Kennemerland" ;
            sgpl:text_context "De voortgang van een hogeschool Kennemerland, het HBO in Haarlem en omstreken omvattende, behoort tot de verst gevorderde in het land, naar de huidige stand van zaken. De aanleiding voor deze positieve geluiden was het relatief vroeg verschijnen van een concept-fusieplan met perspectiefvolle vooruitzichten. Dit concept-fusieplan, dat bij het begin van het onderzoek onderwerp van besprekingen en onderhandelingen was, is de basis voor een groot deel van deze case-studie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754692 ;
            sgpl:spatialText "Heemstede" ;
            sgpl:text_context "In de HBO-regio Kennemerland is het HBO ruimtelijk geconcentreerd in een tweetal kernen, namelijk Haarlem en Heemstede. In Heemstede is gevestigd: - de R.K. Pedagogische Academie Basisonderwijs \"De la Salie\" (PDLS). Deze instellingen en het onderwijs dat daar verzorgd wordt, worden in dit hoofdstuk beschreven aan de hand van de volgende punten: 1. de aard en omvang van het onderwijs; 2. de ontwikkeling van het aantal ingeschreven studenten; 3. de huisvestingssituatie, het locatiepatroon en de bereikbaarheid van de scholen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "HBO-regio Utrecht" ;
            sgpl:text_context "In de HBO-regio Utrecht zijn een groot aantal HBO-instellingen gevestigd. Naar aanleiding van het Schaalvergroting-, Taakverdeling en Concentratie- proces in het Hoger Beroepsonderwijs zijn er binnen deze regio drie clusters ontstaan. Opvallend bij deze clustering is dat instellingen, met min of meer verwante studierichtingen, veelal samengaan." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept13886 ;
            sgpl:subjectText "Schaalvergroting" ;
            sgpl:text_context "Zij streven daarin naar een kwalitatieve versterking, die vooral gericht is op een verruiming van de onderwijskundige mogelijkheden en verantwoordelijkheden van de HBO-instellingen, en naar een kwantitatieve versterking, die gericht is op de vergroting van de omvang van de instellingen (Ministerie van O&W, 1983a, p. 1). De ministers hebben gekozen voor een proces van schaalvergroting om, in plaats van een veelheid los van elkaar staande instituten, te komen tot een beperkt aantal grote multi-sectorale instellingen met een grote autonomie, die in staat zijn hun huidige en nieuwe taken op een doelmatige wijze te vervullen. Dit schaalvergrotingsproces (STC-proces) moet volgens de ministers door het onderwijsveld zelf worden uitgewerkt." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Locatiepatroon" ;
            sgpl:text_context "Voor elk daarvan zijn twee auteurs verantwoordelijk. Het leeronderzoek tracht de rol van het locatiepatroon, de bereikbaarheid en de huisvestingssituatie in het fusieproces binnen het Hoger Beroeps Onderwijs (HBO) te belichten. Bij het verschijnen van dit eindverslag willen wij graag een ieder bedanken, die heeft bijgedragen aan de totstandkoming van dit werkstuk." ],
        [ sgpl:refersToConcept unesco:concept71 ;
            sgpl:subjectText "Hoger beroepsonderwijs" ;
            sgpl:text_context "Dit onderzoek is gebaseerd op een door de vakgroep Toegepaste Geografie & Ruimtelijke Planning geformuleerde opdracht, waarin naar aanleiding van het uitkomen van de nota \"Schaalvergroting, Taakverdeling en Concentratie in het Hoger Beroepsonderwijs\" (Ministerie van O&W, 1983a) de vraag werd gesteld, welke ruimtelijke gevolgen deze nota voor het HBO zou kunnen hebben. Ondanks dat het Hoger Beroeps Onderwijs in een ander geografisch kader functioneert dan het Voortgezet Onderwijs (het HBO op provinciaal en landsdeel niveau, het VO op regionaal niveau), kunnen de bovengenoemde aspecten van onderzoek ook ten aanzien van het HBO behandeld worden. In het eerste hoofdstuk wordt onder andere aandacht besteed aan de beleidsvoornemens, die de spreiding van de scholen onder druk zetten en aan de manier waarop aan het proces van inkrimping en herschikking vorm wordt gegeven (de institutionele context)." ],
        [ sgpl:refersToConcept unesco:concept71 ;
            sgpl:subjectText "Hoger beroepsonderwijs" ;
            sgpl:text_context "Dit onderzoek is gebaseerd op een door de vakgroep Toegepaste Geografie & Ruimtelijke Planning geformuleerde opdracht, waarin naar aanleiding van het uitkomen van de nota \"Schaalvergroting, Taakverdeling en Concentratie in het Hoger Beroepsonderwijs\" (Ministerie van O&W, 1983a) de vraag werd gesteld, welke ruimtelijke gevolgen deze nota voor het HBO zou kunnen hebben. Ondanks dat het Hoger Beroeps Onderwijs in een ander geografisch kader functioneert dan het Voortgezet Onderwijs (het HBO op provinciaal en landsdeel niveau, het VO op regionaal niveau), kunnen de bovengenoemde aspecten van onderzoek ook ten aanzien van het HBO behandeld worden. In het eerste hoofdstuk wordt onder andere aandacht besteed aan de beleidsvoornemens, die de spreiding van de scholen onder druk zetten en aan de manier waarop aan het proces van inkrimping en herschikking vorm wordt gegeven (de institutionele context)." ],
        [ sgpl:refersToConcept unesco:concept13886 ;
            sgpl:subjectText "Schaalvergroting" ;
            sgpl:text_context "Zij streven daarin naar een kwalitatieve versterking, die vooral gericht is op een verruiming van de onderwijskundige mogelijkheden en verantwoordelijkheden van de HBO-instellingen, en naar een kwantitatieve versterking, die gericht is op de vergroting van de omvang van de instellingen (Ministerie van O&W, 1983a, p. 1). De ministers hebben gekozen voor een proces van schaalvergroting om, in plaats van een veelheid los van elkaar staande instituten, te komen tot een beperkt aantal grote multi-sectorale instellingen met een grote autonomie, die in staat zijn hun huidige en nieuwe taken op een doelmatige wijze te vervullen. Dit schaalvergrotingsproces (STC-proces) moet volgens de ministers door het onderwijsveld zelf worden uitgewerkt." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Locatiepatroon" ;
            sgpl:text_context "Voor elk daarvan zijn twee auteurs verantwoordelijk. Het leeronderzoek tracht de rol van het locatiepatroon, de bereikbaarheid en de huisvestingssituatie in het fusieproces binnen het Hoger Beroeps Onderwijs (HBO) te belichten. Bij het verschijnen van dit eindverslag willen wij graag een ieder bedanken, die heeft bijgedragen aan de totstandkoming van dit werkstuk." ] ;
    sgpl:thesisID 148 .

sgpl:Thesis149 a sgpl:SGPLThesis ;
    dcterms:creator "Igor Heller" ;
    dcterms:issued 1986 ;
    dcterms:title "Een onderzoek naar het bezoek van horecabedrijven in een modern winkelcentrum.",
        "Horeca in Hoog-Catharijne" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Ongeveer 45% van alle horecabedrijven wordt door een echtpaar gerund. In Utrecht biedt de horeca volgens officiè’le cijfers werk aan 1723 personen, verdeeld over 533 bedrijven(eind 1985). De dynamiek in deze sector is groot." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745207 ;
            sgpl:spatialText "Vredenburg" ;
            sgpl:text_context "Naast de Oude Gracht zijn ook de Voorstraat, het Vredenburg en H.C. belangrijke concentraties. De in 2.1. gesignaleerde verschuiving van de kern van de winkelcity in zuidelijke richting heeft ook voor de horeca zijn gevolgen gehad. De noordelijke as Vredenburg-Lange Viestraat-Jacobsstraat verliest terrein aan het voetgangersgebied." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "oude binnenstad van Utrecht" ;
            sgpl:text_context "Na H.C. is dit het drukste winkelgebied van Utrecht. Als derde mogelijkheid konden de respondenten aangeven of zij wel eens een horecabedrijf in de oude binnenstad van Utrecht bezochten. Met oude binnenstad werd bedoeld het centrale gedeelte binnen de singels tussen Lange Viestraat-Potterstraat en de Hamburgerstraat." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Lange Viestraat" ;
            sgpl:text_context "De Lange Viestraat en Potterstraat verloren terrein aan de Lange Elisabethstraat, Steenweg en Oude Gracht, vooral toen daar in 1974 een voetgangersgebied werd ingesteld (Bruno, 1978, p.497). De Lange Viestraat raakte nog verder in verval toen de Bijenkorf de lege ruimte niet adequaat opvulde en Galeries Modernes door slecht beleid in verval raakte. Mentink (1983,p.32) constateert ook dat de mobiliteit in H.C. tot 1977 laag was (openingsfase), daarna sterk groeide tot ongeveer 9% per jaar en vervolgens weer daalde." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Gildenkwartier" ;
            sgpl:text_context "Het Godebaldkwartier kent de hoogste mobiliteit, 16.7% per jaar, gevolgd door het Gildenkwartier (10,5%). Voor de andere kwartieren ligt dit veel lager, tussen 4 en 6%. De hoge mobiliteit in het Godebaldkwartier wijt hij vooral aan de combinatie: relatief weinig passanten - hoge huren." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Hoog-Catharijne" ;
            sgpl:text_context "Een duidelijk gemis hierbij was het ontbreken van gegevens over de consumenten. Dit onderzoek tracht in deze lacune te voorzien door middel van een analyse van de bezoekers van horecabedrijven in Hoog-Catharijne, één van de concentratiepunten van horeca in Utrecht. De relatie tussen consumenten en bedrijven in een groot en modern winkelcentrum staat in het onderzoek centraal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "westen van het land" ;
            sgpl:text_context "De helft van de bezoekers van H.C. kwam uit Utrecht, 20% uit de randgemeenten rond Utrecht (vooral die ten westen van de stad), en de overige 30% van elders, met name uit het westen van het land. Naarmate de respondenten verder van H.C. woonden kwamen er minder om te winkelen. Wel was het deel dat er wel eens een horecabedrijf bezocht onder deze laatste groep groter, 75% tegen 43% bij de Utrechters." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Amsterdamsestraatweg" ;
            sgpl:text_context "Ten tweede is er een concentratie van horeca langs de grote uitvalswegen, en met name de delen hiervan die het dichtst bij de binnenstad liggen. (Amsterdamsestraatweg, Biltstraat) Café's geven hier de toon aan. Bij de Amsterdamsestraatweg is de uitzonderlijk hoge mobiliteit van rond de 20% per jaar opvallend." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Radboudkwartier" ;
            sgpl:text_context "In de daarop volgende tien jaar werd de oude stationswijk geheel afgebroken en werd H.C. gebouwd. In 1973 werd de eerste fase (Radboudkwartier, Clarenburg) geopend, in de jaren daarna volgden geleidelijk de andere delen. Mentink(1983) heeft de ontwikkeling van HC in de periode 1973-1982 geanalyseerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Hoewel er veel andere definities bestaan, geeft deze het beste weer wat in dit onderzoek onder horecabedrijven wordt verstaan. De horeca biedt werk aan ongeveer 100.000 mensen in Nederland, in ruim 37.000 bedrijven. Kleine tot zeer kleine bedrijven overheersen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Gemeente Utrecht" ;
            sgpl:text_context "Het doel van het project H.C. (een ontwerp van projectontwikkelaar Empeo uit 1963) was de binnenstad van Utrecht een wat meer grootstedelijk aanzien te geven, en de stad economische impulsen te geven. In 1968 gaf de gemeente Utrecht groen licht voor een grootschalige reorganisatie van de stationswijk. De steun van de NS was hierbij belangrijk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrechtse winkel- en zakencentrum Hoog-Catharijne" ;
            sgpl:text_context "Het voor U liggende verslag is het resultaat van een onderzoek naar de consumenten van de horeca in het Utrechtse winkel- en zakencentrum Hoog-Catharijne. Het is een verslag van een doctoraalonderzoek Sociale Geografie, specialisatie economische geografie. Het onderzoek is een vervolgonderzoek op een eerdere inventarisatie de horecasector in Utrecht en omstreken." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11979 ;
            sgpl:subjectText "Horeca" ;
            sgpl:text_context "In dit onderzoek zal een deel van het midden- en kleinbedrijf aan de orde komen, de horeca. Horeca is de verzamelnaam voor de groep bedrijven die zich richt op het aanbieden van dranken, etenswaren en/of logies in direct consumeerbare vorm voor directe consumptie ter plaatse of te huize van de consument, en tevens voor iedereen toegankelijk is. Hoewel er veel andere definities bestaan, geeft deze het beste weer wat in dit onderzoek onder horecabedrijven wordt verstaan." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "Consumenten" ;
            sgpl:text_context "Een duidelijk gemis hierbij was het ontbreken van gegevens over de consumenten. Dit onderzoek tracht in deze lacune te voorzien door middel van een analyse van de bezoekers van horecabedrijven in Hoog-Catharijne, één van de concentratiepunten van horeca in Utrecht. De relatie tussen consumenten en bedrijven in een groot en modern winkelcentrum staat in het onderzoek centraal." ],
        [ sgpl:refersToConcept unesco:concept4895 ;
            sgpl:subjectText "Winkelcentrum" ;
            sgpl:text_context "Dit onderzoek tracht in deze lacune te voorzien door middel van een analyse van de bezoekers van horecabedrijven in Hoog-Catharijne, één van de concentratiepunten van horeca in Utrecht. De relatie tussen consumenten en bedrijven in een groot en modern winkelcentrum staat in het onderzoek centraal. Ik wil bij deze mijn dank uitspreken jegens allen die mij hebben geholpen dit onderzoek tot een goed einde te brengen." ],
        [ sgpl:refersToConcept unesco:concept4895 ;
            sgpl:subjectText "Winkelcentrum" ;
            sgpl:text_context "Dit onderzoek tracht in deze lacune te voorzien door middel van een analyse van de bezoekers van horecabedrijven in Hoog-Catharijne, één van de concentratiepunten van horeca in Utrecht. De relatie tussen consumenten en bedrijven in een groot en modern winkelcentrum staat in het onderzoek centraal. Ik wil bij deze mijn dank uitspreken jegens allen die mij hebben geholpen dit onderzoek tot een goed einde te brengen." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "Consumenten" ;
            sgpl:text_context "Een duidelijk gemis hierbij was het ontbreken van gegevens over de consumenten. Dit onderzoek tracht in deze lacune te voorzien door middel van een analyse van de bezoekers van horecabedrijven in Hoog-Catharijne, één van de concentratiepunten van horeca in Utrecht. De relatie tussen consumenten en bedrijven in een groot en modern winkelcentrum staat in het onderzoek centraal." ],
        [ sgpl:refersToConcept unesco:concept11979 ;
            sgpl:subjectText "Horeca" ;
            sgpl:text_context "In dit onderzoek zal een deel van het midden- en kleinbedrijf aan de orde komen, de horeca. Horeca is de verzamelnaam voor de groep bedrijven die zich richt op het aanbieden van dranken, etenswaren en/of logies in direct consumeerbare vorm voor directe consumptie ter plaatse of te huize van de consument, en tevens voor iedereen toegankelijk is. Hoewel er veel andere definities bestaan, geeft deze het beste weer wat in dit onderzoek onder horecabedrijven wordt verstaan." ] ;
    sgpl:thesisID 149 .

sgpl:Thesis150 a sgpl:SGPLThesis ;
    dcterms:creator "Pieter van Ginneken" ;
    dcterms:issued 1986 ;
    dcterms:title "VERANDERINGEN IN HET LOKATIEPATROON VAN PSYCHIATRISCHE ZIEKENHUIZEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Uoor u ligt het verslag van een leeronderzoek met betrekking tot veranderingen in het lokatiepatroon van psychiatrische ziekenhuizen in Nederland. Deze skriptie heeft een voor sociaal-geografen (nog) niet alledaags onderwerp. Toch hoop ik de lezer door deze skriptie te prikkelen tot denken over het brede terrein van de gezondheidszorg." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747351 ;
            sgpl:spatialText "Den Bosch" ;
            sgpl:text_context "Het aantal erkende bedden is in de periode 1375-1985 met 3551 gedaald. Hierbij vallen met name de dalingen in Den Bosch C37.4 Jïl, Noord-Limburg (84.4 ïf) en Groningen-Drente (83.B 50 op. Alleen in de regio’s waar geen of een klein aantal erkende bedden aanwezig was in 1975 is sprake van een toename." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745940 ;
            sgpl:spatialText "Ulvenhout" ;
            sgpl:text_context "Dat betreft eerst en vooral mijn ouders, die mij al die tijd de faciliteiten hebben gegeven die nodig waren voor mijn studie; en verder alle studiegenoten, docenten, vakgenoten en kollega’s waarmee ik leerzaam, plezierig en/of inspirerend samengewerkt heb. Ulvenhout, oktober 13BË. 1.INLEIDING. De laatste Jaren is in Nederland in toenemende mate aandacht voer de gezondheidszorg vanuit de sociale geografie waar te nemen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "25 gezondheidsregio’s" ;
            sgpl:text_context "Voor deze studie is als onderzoeksgebied heel Nederland gekozen omdat alleen op dat nivo voldoende gegevens beschikbaar zijn om tot vergelijkingen te komen. Nederland is verdeeld in BS gezondheidsregio’s (zie figuur 2.11 en GO subregio’s. Alhoeuel de oriëntering op psychiatrische ziekenhuizen geen belangrijke faktor was bij het totstandkomen van de indeling in deze gezondheidsregio’s zal deze indeling toch als basis voor dit onderzoek worden gebruikt, omdat zij als kader bij de planning van intramurale gezondheidszorgvoorzieningen volgens de Wet Ziekenhuisvoorzieningen (WZU1 fungeert." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Stedendriehoek" ;
            sgpl:text_context "Door het aantal erkende bedden te relateren aan het aantal inwoners per gezondheidsregio wordt het pas goed mogelijk de regio’s onderling te vergelijken. Toch zijn er nog regio’s waar het aantal erkende bedden per 1000 inwoners relatief hoog is, zoals de Stedendriehoek (4.23, Kennemerland (5.61 en Den Bosch C4.5). Daarnaast zijn er 13 regio’s waar dit aantal onder de door de overheid gestelde norm van 1.5 promille ligt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755249,
                geonames:2756631 ;
            sgpl:spatialText "Groningen-Drente" ;
            sgpl:text_context "Het aantal erkende bedden is in de periode 1375-1985 met 3551 gedaald. Hierbij vallen met name de dalingen in Den Bosch C37.4 Jïl, Noord-Limburg (84.4 ïf) en Groningen-Drente (83.B 50 op. Alleen in de regio’s waar geen of een klein aantal erkende bedden aanwezig was in 1975 is sprake van een toename." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7302154 ;
            sgpl:spatialText "Kennemerland" ;
            sgpl:text_context "Door het aantal erkende bedden te relateren aan het aantal inwoners per gezondheidsregio wordt het pas goed mogelijk de regio’s onderling te vergelijken. Toch zijn er nog regio’s waar het aantal erkende bedden per 1000 inwoners relatief hoog is, zoals de Stedendriehoek (4.23, Kennemerland (5.61 en Den Bosch C4.5). Daarnaast zijn er 13 regio’s waar dit aantal onder de door de overheid gestelde norm van 1.5 promille ligt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "RIJKSUNIVERSITEIT UTRECHT" ;
            sgpl:text_context "PIETER VAN GINNEKEN LEERONDERZOEK. Rijksuniversiteit 'o Utrecht filbliotnoe^ Comruir Uithof RIJKSUNIVERSITEIT UTRECHT. INHOUD lijst van tabellen en figuren 3 UOORWOORD 4 1." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755996 ;
            sgpl:spatialText "Het Hooghuys in Etten-Leur" ;
            sgpl:text_context "Merendeel cliënten van Het Hooghuys in Etten-Leur woont al jaren in afgekeurde gebouwen. Uitstel van nieuwbouw dupeert bewoners psychiatrische inrichting. ETTEN-LEUR, 5 mei — Het letten nn de eentC «teen roor hei omv*n|rijkc nieuwbouwpro- ject een de ptychiatrnchc Initeh ling Het Hooghuyi in het Brn- banue Etten-Leur had vrijdag 25 april nieta van een feestelijke bijeenkomst." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Noord-Limburg" ;
            sgpl:text_context "Het aantal erkende bedden is in de periode 1375-1985 met 3551 gedaald. Hierbij vallen met name de dalingen in Den Bosch C37.4 Jïl, Noord-Limburg (84.4 ïf) en Groningen-Drente (83.B 50 op. Alleen in de regio’s waar geen of een klein aantal erkende bedden aanwezig was in 1975 is sprake van een toename." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept252 ;
            sgpl:subjectText "Psychiatrische ziekenhuizen" ;
            sgpl:text_context "Deze studie is als zo’n verdere uitwerking bedoeld. Daarbij zal het brede terrein van de gezondheidszorg worden beperkt tot een relatief klein deel ervan, de psychiatrische ziekenhuizen. In de geestelijke gezondheidszorg is een beweging op gang gekomen die globaal als kenmerken heeft. van grootschalig naar kleinschalig, van intra- naar semi- en extramuraal en van duur naar goedkoop." ],
        [ sgpl:refersToConcept unesco:concept673 ;
            sgpl:subjectText "Multilokationele instellingen" ;
            sgpl:text_context "Vaak blijkt een instelling namelijk meerdere vestigingspunten te hebben. Stijnenbosch C1SB3, p.2141 gebruikt hiervoor de term multilokationele instellingen. Hieraan zal onder andere in het volgende hoofdstuk aandacht worden besteed." ],
        [ sgpl:refersToConcept unesco:mt7.35 ;
            sgpl:subjectText "Lokatiepatroon" ;
            sgpl:text_context "Hoofdstuk 3 bevat een beschrijving van de ontwikkelingen in de organisatie van de gezondheidszorg bij de overheid en hoofdstuk H van de organisatie van de gezondheidszorg bij de instellingen. In hoofdstuk 5 zullen dan de veranderingen die zich in de periode 1375-1905 in het 1okatiepatroon van de psychiatrische ziekenhuizen hebben voorgedaan worden besproken. In hoofdstuk 5 tenslotte volgt een diskussie naar aanleiding van de resultaten van dit onderzoek." ],
        [ sgpl:refersToConcept unesco:concept252 ;
            sgpl:subjectText "Psychiatrische ziekenhuizen" ;
            sgpl:text_context "Deze studie is als zo’n verdere uitwerking bedoeld. Daarbij zal het brede terrein van de gezondheidszorg worden beperkt tot een relatief klein deel ervan, de psychiatrische ziekenhuizen. In de geestelijke gezondheidszorg is een beweging op gang gekomen die globaal als kenmerken heeft. van grootschalig naar kleinschalig, van intra- naar semi- en extramuraal en van duur naar goedkoop." ],
        [ sgpl:refersToConcept unesco:mt7.35 ;
            sgpl:subjectText "Lokatiepatroon" ;
            sgpl:text_context "Hoofdstuk 3 bevat een beschrijving van de ontwikkelingen in de organisatie van de gezondheidszorg bij de overheid en hoofdstuk H van de organisatie van de gezondheidszorg bij de instellingen. In hoofdstuk 5 zullen dan de veranderingen die zich in de periode 1375-1905 in het 1okatiepatroon van de psychiatrische ziekenhuizen hebben voorgedaan worden besproken. In hoofdstuk 5 tenslotte volgt een diskussie naar aanleiding van de resultaten van dit onderzoek." ],
        [ sgpl:refersToConcept unesco:concept673 ;
            sgpl:subjectText "Multilokationele instellingen" ;
            sgpl:text_context "Vaak blijkt een instelling namelijk meerdere vestigingspunten te hebben. Stijnenbosch C1SB3, p.2141 gebruikt hiervoor de term multilokationele instellingen. Hieraan zal onder andere in het volgende hoofdstuk aandacht worden besteed." ] ;
    sgpl:thesisID 150 .

sgpl:Thesis151 a sgpl:SGPLThesis ;
    dcterms:creator "Martien de Vries",
        "Peter Jansen" ;
    dcterms:issued 1986 ;
    dcterms:title "PATIENTENSTROMEN IN MIDDEN-KENNEMERLAND" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Haarlem" ;
            sgpl:text_context "De belangstelling voor patiëntenstromen in Midden-Kennemerland is gelegen in de vraag of Midden-Kennemerland voor wat betreft de eerstelijnsgezondheidszorg wel een gesloten gebied is. Het is met name onduidelijk of er inwoners van Velsen gebruik maken van eerstelijnsvoorzieningen in Haarlem of Bloemendaal. Daarnaast is het ook onbekend in hoeverre er sprake is van patiëntenstromen tussen de vijf gemeenten zelf." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745675 ;
            sgpl:spatialText "Velsen-Noord" ;
            sgpl:text_context "3.5 Geografische kenmerken. De gemeente Velsen valt duidelijk uiteen in een aantal woonkernen, te weten Velsen-Noord en Velsen-Zuid, IJmuiden, Driehuis en Santpoort-Noord en Santpoort-Zuid. Het aaneengrenzen van bebouwing tussen Beverwijk en Heemskerk en tussen Santpoort-Zuid en Bloemendaal en Haarlem is eveneens goed te zien (zie figuur 3.1)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Wij willen tenslotte onze begeleiders Ad van Elzakker en Martin Stijnenbosch hartelijk danken voor hun steun en adviezen bij het tot stand komen van deze scriptie. Utrecht, september 1986. Peter Jansen Martien de Vries." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Santpoort-Zuid" ;
            sgpl:text_context "Ten zuiden van de sub-regio liggen de gemeenten Bloemendaal en Haarlem. Aangezien de bevolkingsconcentraties van de noordelijke delen van deze gemeenten bijna aaneengrenzen met Santpoort-Zuid (gemeente Velsen), zoals blijkt uit figuur 3.1, mag worden verwacht dat hier grensoverschrijdende patiëntenstromen in de eerstelijn kunnen optreden. Naast deze twee gemeenten zijn er rond de regiogrens geen gebieden die direkt van invloed kunnen zijn op de patiëntenstromen in Midden-Kennemerland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758998 ;
            sgpl:spatialText "gemeenten Beverwijk" ;
            sgpl:text_context "Midden-Kennemerland is een sub-regio van de gezondheidszorgregio Kennemerland, één van de drie integrale invoeringsgebieden van de Wet Voorzieningen Gezondheidszorg (WVG). De regio Midden-Kennemerland omvat de gemeenten Beverwijk, Castricum, Heemskerk, Uitgeest en Velsen. Deze vijf gemeenten hebben ter ondersteuning van het experiment WVG in 1984 het buro WVG opgericht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7302154 ;
            sgpl:spatialText "Midden-Kennemerland" ;
            sgpl:text_context "Voor planningsdoeleinden is Nederland ingedeeld in 25 gezondheidszorgregio's. Midden-Kennemerland is een sub-regio van de gezondheidszorgregio Kennemerland, één van de drie integrale invoeringsgebieden van de Wet Voorzieningen Gezondheidszorg (WVG). De regio Midden-Kennemerland omvat de gemeenten Beverwijk, Castricum, Heemskerk, Uitgeest en Velsen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758804 ;
            sgpl:spatialText "Bloemendaal" ;
            sgpl:text_context "De belangstelling voor patiëntenstromen in Midden-Kennemerland is gelegen in de vraag of Midden-Kennemerland voor wat betreft de eerstelijnsgezondheidszorg wel een gesloten gebied is. Het is met name onduidelijk of er inwoners van Velsen gebruik maken van eerstelijnsvoorzieningen in Haarlem of Bloemendaal. Daarnaast is het ook onbekend in hoeverre er sprake is van patiëntenstromen tussen de vijf gemeenten zelf." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In de sociale geografie is er een toenemende belangstelling waarneembaar voor ontwikkelingen binnen de gezondheidszorg. Voor planningsdoeleinden is Nederland ingedeeld in 25 gezondheidszorgregio's. Midden-Kennemerland is een sub-regio van de gezondheidszorgregio Kennemerland, één van de drie integrale invoeringsgebieden van de Wet Voorzieningen Gezondheidszorg (WVG)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept412 ;
            sgpl:subjectText "eerstelijnsgezondheidszorg" ;
            sgpl:text_context "Dit onderzoek naar patiëntenstromen in de eerstelijn kan worden gezien in het kader van de tweede activiteit. De belangstelling voor patiëntenstromen in Midden-Kennemerland is gelegen in de vraag of Midden-Kennemerland voor wat betreft de eerstelijnsgezondheidszorg wel een gesloten gebied is. Het is met name onduidelijk of er inwoners van Velsen gebruik maken van eerstelijnsvoorzieningen in Haarlem of Bloemendaal." ],
        [ sgpl:refersToConcept unesco:concept1564 ;
            sgpl:subjectText "patiëntenstromen" ;
            sgpl:text_context "Het onderzoek is tot stand gekomen via een stage bij het Buro Wet Voorzieningen Gezondheidszorg (WVG) Midden-Kennemerland. Tijdens het onderzoek is een vestigingsregeling voor huisartsen van kracht geworden, waardoor het onderwerp patiëntenstromen meer actualiteitswaarde heeft gekregen. Een verkorte versie van dit onderzoek is in brochurevorm reeds verschenen en verkrijgbaar bij het Buro WVG (postbus 1301, 1900 BH Castricum)." ],
        [ sgpl:refersToConcept unesco:concept11776 ;
            sgpl:subjectText "intergemeentelijke patiëntenstromen" ;
            sgpl:text_context "Gezien bovenstaande kan de probleemstelling voor dit onderzoek als volgt worden geformuleerd: IS ER IN MIDDEN-KENNEMERLAND SPRAKE VAN INTERGEMEENTELIJKE PATIENTENSTROMEN IN DE EERSTELIJNSGEZONDHEIDSZORG ? ZO JA, IN WELKE OPZICHTEN ONDERSCHEIDEN DE GRENSOVERSCHRIJDENDE PATIËNTEN ZICH VAN DE OVERIGEN ?" ],
        [ sgpl:refersToConcept unesco:concept11776 ;
            sgpl:subjectText "intergemeentelijke patiëntenstromen" ;
            sgpl:text_context "Gezien bovenstaande kan de probleemstelling voor dit onderzoek als volgt worden geformuleerd: IS ER IN MIDDEN-KENNEMERLAND SPRAKE VAN INTERGEMEENTELIJKE PATIENTENSTROMEN IN DE EERSTELIJNSGEZONDHEIDSZORG ? ZO JA, IN WELKE OPZICHTEN ONDERSCHEIDEN DE GRENSOVERSCHRIJDENDE PATIËNTEN ZICH VAN DE OVERIGEN ?" ],
        [ sgpl:refersToConcept unesco:concept1564 ;
            sgpl:subjectText "patiëntenstromen" ;
            sgpl:text_context "Het onderzoek is tot stand gekomen via een stage bij het Buro Wet Voorzieningen Gezondheidszorg (WVG) Midden-Kennemerland. Tijdens het onderzoek is een vestigingsregeling voor huisartsen van kracht geworden, waardoor het onderwerp patiëntenstromen meer actualiteitswaarde heeft gekregen. Een verkorte versie van dit onderzoek is in brochurevorm reeds verschenen en verkrijgbaar bij het Buro WVG (postbus 1301, 1900 BH Castricum)." ],
        [ sgpl:refersToConcept unesco:concept412 ;
            sgpl:subjectText "eerstelijnsgezondheidszorg" ;
            sgpl:text_context "Dit onderzoek naar patiëntenstromen in de eerstelijn kan worden gezien in het kader van de tweede activiteit. De belangstelling voor patiëntenstromen in Midden-Kennemerland is gelegen in de vraag of Midden-Kennemerland voor wat betreft de eerstelijnsgezondheidszorg wel een gesloten gebied is. Het is met name onduidelijk of er inwoners van Velsen gebruik maken van eerstelijnsvoorzieningen in Haarlem of Bloemendaal." ] ;
    sgpl:thesisID 151 .

sgpl:Thesis153 a sgpl:SGPLThesis ;
    dcterms:creator "J. Mulder",
        "N.L.M. Landuyt" ;
    dcterms:issued 1986 ;
    dcterms:title "NEDERLANDSE ONDERNEMINGEN IN DE VERENIGDE STATEN",
        "vestigingsgedrag van de Nederlandse bedrijvigheid" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4197000 ;
            sgpl:spatialText "Georgia" ;
            sgpl:text_context "De staten die een significant verschil vertoonden ten aanzien van het aantal gevestigde bedrijven hebben we gesepareerd (zie figuur 3.1). Dit zijn: New York (94), Californië (40), Texas (34), Georgia (26) en New Jersey (24). In de overige 31 staten zijn 147 bedrijven gevestigd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:5101760 ;
            sgpl:spatialText "New Jersey" ;
            sgpl:text_context "De staten die een significant verschil vertoonden ten aanzien van het aantal gevestigde bedrijven hebben we gesepareerd (zie figuur 3.1). Dit zijn: New York (94), Californië (40), Texas (34), Georgia (26) en New Jersey (24). In de overige 31 staten zijn 147 bedrijven gevestigd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:5128638 ;
            sgpl:spatialText "New York" ;
            sgpl:text_context "De staten die een significant verschil vertoonden ten aanzien van het aantal gevestigde bedrijven hebben we gesepareerd (zie figuur 3.1). Dit zijn: New York (94), Californië (40), Texas (34), Georgia (26) en New Jersey (24). In de overige 31 staten zijn 147 bedrijven gevestigd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:4140963 ;
            sgpl:spatialText "Washington (DC)" ;
            sgpl:text_context "Virginia heeft het voordeel dicht bij Washington (DC) te liggen. Tevens werd door een aantal bedrijven gezegd, dat het leefklimaat van Virginia het beste overeenkomt met het Nederlandse. Voorts heeft Virginia goede toeleverings- en verbindingsmogelijkheden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Sunbelt-steden" ;
            sgpl:text_context "Na 1970 hebben zich in de Verenigde Staten een aantal opmerkelijke ontwikkelingen voltrokken in het stedelijk systeem (Eysberg, 1984).: - Op nationaal niveau een toenemende en na 1970 sterk versnelde groei van de zogenaamde Sunbelt-steden van de zuidelijke staten ten koste van de Snowbelt-steden van het noordoosten. - Op regionaal niveau het ontstaan van stadsgewesten door metropolen die functioneel geïntegreerd raakten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "de Verenigde Staten" ;
            sgpl:text_context "In het kader van ons afstudeeronderzoek aan de Rijksuniversiteit Utrecht hebben wij deze scriptie geschreven over Nederlandse ondernemingen in de Verenigde Staten. Dit economisch geografisch onderzoek is uitgevoerd aan de hand van een literatuurstudie en gegevensbestand van alle Nederlandse vestigingen in de Verenigde Staten. Bovendien hebben we een uitgebreide enquête gehouden onder een twintigtal moederbedrijven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4736286 ;
            sgpl:spatialText "Texas" ;
            sgpl:text_context "De staten die een significant verschil vertoonden ten aanzien van het aantal gevestigde bedrijven hebben we gesepareerd (zie figuur 3.1). Dit zijn: New York (94), Californië (40), Texas (34), Georgia (26) en New Jersey (24). In de overige 31 staten zijn 147 bedrijven gevestigd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6692534 ;
            sgpl:spatialText "Californië" ;
            sgpl:text_context "De staten die een significant verschil vertoonden ten aanzien van het aantal gevestigde bedrijven hebben we gesepareerd (zie figuur 3.1). Dit zijn: New York (94), Californië (40), Texas (34), Georgia (26) en New Jersey (24). In de overige 31 staten zijn 147 bedrijven gevestigd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Het afgelopen decennium heeft Europa een beeld van sociale en politieke onrust te zien gegeven. Arbeidsbewegingen werden steeds militanter en in sommige landen dreigde het regeringsbeleid een sterke bocht naar links te maken. Gevolg hiervan was dat de lonen en belastingen stegen en dat de overheid zich steeds meer met het bedrijfsleven ging bemoeien." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Dit gegeven, meer Nederlandse vestigingen in de Verenigde Staten en weinig informatie hierover, biedt een interessant uitgangspunt voor onderzoek. Deze scriptie handelt dan ook over de Nederlandse ondernemingen in de Verenigde Staten. Het is algemeen bekend, dat Nederland de laatste jaren de grootste buitenlandse investeerder in de Verenigde Staten is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6254928 ;
            sgpl:spatialText "Virginia" ;
            sgpl:text_context "De voordelen van deze staat zijn onder andere: dichtbij het financiële centrum van New York, gemakkelijke verbinding met Nederland en de aanwezigheid van grote afzetgebieden in de omgeving. Virginia heeft het voordeel dicht bij Washington (DC) te liggen. Tevens werd door een aantal bedrijven gezegd, dat het leefklimaat van Virginia het beste overeenkomt met het Nederlandse." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "West-Duitsland" ;
            sgpl:text_context "Vanaf 1970 tot 1980 stegen de directe investeringen van buitenlandse ondernemingen in de Verenigde Staten jaarlijks gemiddeld met ruim 30% (McConnell, 1983, p.338). De belangrijkste investerende landen in de V.S. zijn: Nederland, Groot-Brittanie, Canada, West-Duitsland, Frankrijk Zwitserland (zie tabel 2.1) en sinds een aantal jaren ook Japan. Deze landen vertonen afhankelijk van hun achtergronden, doelstellingen en strategie meer of minder verschillend locationeel gedrag." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "vestigingsgedrag" ;
            sgpl:text_context "In dit hoofdstuk zal het spreidingspatroon van alle Nederlandse vestigingen in de Verenigde Staten bekeken worden, alsmede de ontwikkeling hiervan in de tijd. Uit bovenstaande kunnen we concluderen dat het Nederlands vestigingsgedrag in de Verenigde Staten niet bijzonder afwijkt van dat van de overige buitenlandse en met name Europese bedrijven. In dit hoofdstuk kwam duidelijk naar voren dat de meeste Nederlandse bedrijven zich in New York vestigen (meer dan 25%)." ],
        [ sgpl:refersToConcept unesco:concept11040 ;
            sgpl:subjectText "buitenlandse investeringen" ;
            sgpl:text_context "De Eclectische theorie van Dunning wijst erop dat ondernemingen in het buitenland gaan investeren indien aan twee basisvoorwaarden is voldaan namelijk: Ten eerste als het voor de onderneming voordeliger is haar overzeese activiteiten te internaliseren in vergelijking met het exporteren van goederen of het licentieren van productie naar buitenlandse bedrijven. In de jaren zeventig vond een enorme toename in het niveau van de buitenlandse investeringen in de industri&euml;le productie plaats. Het grootste deel van deze groei was voor rekening van nauwelijks meer dan vierhonderd grote multinationale ondernemingen die op mondiale schaal opereerden." ],
        [ sgpl:refersToConcept unesco:concept9679 ;
            sgpl:subjectText "multinationale ondernemingen" ;
            sgpl:text_context "In dit hoofdstuk wordt de organisatie en ruimtelijke structuur van de multinational in zijn algemeenheid besproken. Vanaf eind jaren zestig is de omvang van de multinationale ondernemingen om verschillende redenen toegenomen. Deze redenen zijn onder andere ontwikkelingen in de productietechnologie en communicatie, het vormen van handelsblokken (zoals bijvoorbeeld de EEG) en het zich ontwikkelen van kapitaal-, arbeids- en grondstoffenmarkten op wereldniveau." ],
        [ sgpl:refersToConcept unesco:concept11040 ;
            sgpl:subjectText "buitenlandse investeringen" ;
            sgpl:text_context "De Eclectische theorie van Dunning wijst erop dat ondernemingen in het buitenland gaan investeren indien aan twee basisvoorwaarden is voldaan namelijk: Ten eerste als het voor de onderneming voordeliger is haar overzeese activiteiten te internaliseren in vergelijking met het exporteren van goederen of het licentieren van productie naar buitenlandse bedrijven. In de jaren zeventig vond een enorme toename in het niveau van de buitenlandse investeringen in de industri&euml;le productie plaats. Het grootste deel van deze groei was voor rekening van nauwelijks meer dan vierhonderd grote multinationale ondernemingen die op mondiale schaal opereerden." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "vestigingsgedrag" ;
            sgpl:text_context "In dit hoofdstuk zal het spreidingspatroon van alle Nederlandse vestigingen in de Verenigde Staten bekeken worden, alsmede de ontwikkeling hiervan in de tijd. Uit bovenstaande kunnen we concluderen dat het Nederlands vestigingsgedrag in de Verenigde Staten niet bijzonder afwijkt van dat van de overige buitenlandse en met name Europese bedrijven. In dit hoofdstuk kwam duidelijk naar voren dat de meeste Nederlandse bedrijven zich in New York vestigen (meer dan 25%)." ],
        [ sgpl:refersToConcept unesco:concept9679 ;
            sgpl:subjectText "multinationale ondernemingen" ;
            sgpl:text_context "In dit hoofdstuk wordt de organisatie en ruimtelijke structuur van de multinational in zijn algemeenheid besproken. Vanaf eind jaren zestig is de omvang van de multinationale ondernemingen om verschillende redenen toegenomen. Deze redenen zijn onder andere ontwikkelingen in de productietechnologie en communicatie, het vormen van handelsblokken (zoals bijvoorbeeld de EEG) en het zich ontwikkelen van kapitaal-, arbeids- en grondstoffenmarkten op wereldniveau." ] ;
    sgpl:thesisID 153 .

sgpl:Thesis154 a sgpl:SGPLThesis ;
    dcterms:creator "Els Molenaar",
        "Job Posner" ;
    dcterms:issued 1986 ;
    dcterms:title "MODEL VAN EEN MARKETING-INFORMATIESYSTEEM VOOR HET TOERISTISCH-RECREATIEF PRODUCT VAN DE STAD UTRECHT",
        "Utrecht stad naar mijn hart",
        "VERSLAGEN VAN LEERONDERZOEK G & P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "VERSLAGEN VAN LEERONDERZOEK G & P QcD vakgroep toegepaste geografie en ruimtelijke planning Transitorium II, Heidelberglaan 2, De Uithof, UTRECHT (030)532044. uniroreitoit to Utrecht. RIJKSUNIVERSITEIT UTRECHT 1688 6594 4 t-pit Utrecht 1986." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stad Utrecht" ;
            sgpl:text_context "MODEL VAN EEN MARKETING-INFORMATIESYSTEEM VOOR HET TOERISTISCH-RECREATIEF PRODUCT VAN DE STAD UTRECHT. Els Molenaar Job Posner Utrecht 1986. VERSLAGEN VAN LEERONDERZOEK G & P QcD vakgroep toegepaste geografie en ruimtelijke planning Transitorium II, Heidelberglaan 2, De Uithof, UTRECHT (030)532044." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "Op het regionale niveau mag aangenomen worden dat de omringende steden ten aanzien van bepaalde onderdelen van het toeristisch-recreatief product een concurrentiepositie innemen (vgl.Amersfoort als vergadercentrum, Nieuwegein als shopping- centrum, etc.). Het is niet altijd mogelijk of zelfs wenselijk alle gegevens betreffende de activiteiten van de concurrenten te verzamelen. Daarom moet er gezocht worden naar een methode waarmee zoveel mogelijk van de gewenste gegevens verzameld kunnen worden op relatief eenvoudige wijze en in een kort tijdsbestek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Hoog Catharijne" ;
            sgpl:text_context "De stad is goed bereikbaar, is rijk aan musea en andere bezienswaardigheden, er zijn voldoende culturele voorzieningen, het bezit de unieke combinatie van Hoog Catharijne met daarop aansluitend de oude binnenstad en de hele stad ademt een gezellige sfeer uit. Utrecht heeft genoeg toeristische en recreatieve mogelijkheden om te kunnen concurreren met steden als Amsterdam en Den Haag. In dit kader is door de gemeente Utrecht en de KvK voor Utrecht en omstreken aan de Grontmij N.V. de opdracht verstrekt te onderzoeken of, en op welke manier, het product \"Utrecht\" beter verkocht kan worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Utrecht heeft genoeg toeristische en recreatieve mogelijkheden om te kunnen concurreren met steden als Amsterdam en Den Haag. In dit kader is door de gemeente Utrecht en de KvK voor Utrecht en omstreken aan de Grontmij N.V. de opdracht verstrekt te onderzoeken of, en op welke manier, het product \"Utrecht\" beter verkocht kan worden. Deze opdracht heeft geleid tot het ontstaan van de nota \"Utrecht hart van Nederland\", opgesteld en uitgegeven door de Grontmij (zomer 1985)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Uit de nota \"Utrecht hart van Nederland\"(1985), een onderzoek ten behoeve van de uitwerking marketing en promotie van het toeristisch-recreatief product van de stad Utrecht, uitgevoerddoor het advies- en ingenieursbureau Grontmij N.V., is naar voren gekomen dat het toeristisch beleid voor de stad Utrecht gediend zal zijn met de opzet van een adequaat marketing-informatie-systeem (m.i.s.). In opdracht van de Grontmij, en in samenwerking met de Kamer van Koophandel en Fabrieken voor Utrecht e.o. en de afdeling onderzoek van de R.O.V.U., is het voor U liggende rapport ontstaan. Het ontwerpen van een model van een marketing-informatiesysteem voor het toeristisch-recreatief product stad Utrecht vond plaats in de periode november 1985 - mei 1986." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Op het regionale niveau mag aangenomen worden dat de omringende steden ten aanzien van bepaalde onderdelen van het toeristisch-recreatief product een concurrentiepositie innemen (vgl.Amersfoort als vergadercentrum, Nieuwegein als shopping- centrum, etc.). Het is niet altijd mogelijk of zelfs wenselijk alle gegevens betreffende de activiteiten van de concurrenten te verzamelen. Daarom moet er gezocht worden naar een methode waarmee zoveel mogelijk van de gewenste gegevens verzameld kunnen worden op relatief eenvoudige wijze en in een kort tijdsbestek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Utrecht heeft genoeg toeristische en recreatieve mogelijkheden om te kunnen concurreren met steden als Amsterdam en Den Haag. In dit kader is door de gemeente Utrecht en de KvK voor Utrecht en omstreken aan de Grontmij N.V. de opdracht verstrekt te onderzoeken of, en op welke manier, het product \"Utrecht\" beter verkocht kan worden. Deze opdracht heeft geleid tot het ontstaan van de nota \"Utrecht hart van Nederland\", opgesteld en uitgegeven door de Grontmij (zomer 1985)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12658 ;
            sgpl:subjectText "toeristisch-recreatief product" ;
            sgpl:text_context "Het ontwerpen van een model van een marketing-informatiesysteem voor het toeristisch-recreatief product stad Utrecht vond plaats in de periode november 1985 - mei 1986, in het kader van de doctoraalscriptie economische geografie aan de Rijksuniversiteit te Utrecht (Vakgroep Toegepaste Geografie en Ruimtelijke Planning). Gezien onze opdracht is het van belang te bepalen in hoeverre bepaalde aspecten van het toeristisch-recreatief product opgenomen dienen te worden in het model van het m.i.s. Bovendien moet er naar gestreeft worden een gebruiksvriendelijk informatiesysteem op te zetten, teneinde de doelmatigheid te kunnen waarborgen." ],
        [ sgpl:refersToConcept unesco:concept493 ;
            sgpl:subjectText "marketing-informatiesysteem" ;
            sgpl:text_context "Deze twee-assentheorie houdt in dat de ontwikkelingsmogelijkheden voor toerisme en recreatie op twee assen zijn gelegen, namelijk de zakelijke as, gevormd door de Jaarbeurs, de NS, Hoog Catharijne en het winkelareaal oude binnenstad, en de as gevormd door het waterlint met als concentratiegebied de Oudegracht. Een van de conclusies in het rapport is dat het toeristisch beleid gediend zal zijn met de opzet van een adequaat marketing-informatiesysteem (m.i.s.), teneinde de inspanningen en de resultaten van de promotieactiviteiten te kunnen meten en aanvullende informatie, o.a. over de doelgroepen, voor de beleidsbepaling ten aanzien van de promotiecampagne te kunnen leveren. Op haar beurt heeft de Grontmij het Geografisch Instituut van de Rijksuniversiteit Utrecht benaderd met het verzoek een m.i.s. te ontwerpen voor het toeristisch-recreatief product van de stad Utrecht." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "city-marketing" ;
            sgpl:text_context "Deze opdracht heeft geleid tot het ontstaan van de nota \"Utrecht hart van Nederland\", opgesteld en uitgegeven door de Grontmij (zomer 1985). De verkoopbevordering van het product \"stad\" laat zich omschrijven door de term city-marketing. De city-marketing met betrekking tot Utrecht bestaat uit een drietal elementen die zich als volgt verhouden: verdere ontwikkeling van toeristische- en recreatieve mogelijkheden in Utrecht, stimuleren van de bestaande bedrijvigheid en bedrijvenaquisitie en bevorderen van de handel." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "city-marketing" ;
            sgpl:text_context "Deze opdracht heeft geleid tot het ontstaan van de nota \"Utrecht hart van Nederland\", opgesteld en uitgegeven door de Grontmij (zomer 1985). De verkoopbevordering van het product \"stad\" laat zich omschrijven door de term city-marketing. De city-marketing met betrekking tot Utrecht bestaat uit een drietal elementen die zich als volgt verhouden: verdere ontwikkeling van toeristische- en recreatieve mogelijkheden in Utrecht, stimuleren van de bestaande bedrijvigheid en bedrijvenaquisitie en bevorderen van de handel." ],
        [ sgpl:refersToConcept unesco:concept12658 ;
            sgpl:subjectText "toeristisch-recreatief product" ;
            sgpl:text_context "Het ontwerpen van een model van een marketing-informatiesysteem voor het toeristisch-recreatief product stad Utrecht vond plaats in de periode november 1985 - mei 1986, in het kader van de doctoraalscriptie economische geografie aan de Rijksuniversiteit te Utrecht (Vakgroep Toegepaste Geografie en Ruimtelijke Planning). Gezien onze opdracht is het van belang te bepalen in hoeverre bepaalde aspecten van het toeristisch-recreatief product opgenomen dienen te worden in het model van het m.i.s. Bovendien moet er naar gestreeft worden een gebruiksvriendelijk informatiesysteem op te zetten, teneinde de doelmatigheid te kunnen waarborgen." ],
        [ sgpl:refersToConcept unesco:concept493 ;
            sgpl:subjectText "marketing-informatiesysteem" ;
            sgpl:text_context "Deze twee-assentheorie houdt in dat de ontwikkelingsmogelijkheden voor toerisme en recreatie op twee assen zijn gelegen, namelijk de zakelijke as, gevormd door de Jaarbeurs, de NS, Hoog Catharijne en het winkelareaal oude binnenstad, en de as gevormd door het waterlint met als concentratiegebied de Oudegracht. Een van de conclusies in het rapport is dat het toeristisch beleid gediend zal zijn met de opzet van een adequaat marketing-informatiesysteem (m.i.s.), teneinde de inspanningen en de resultaten van de promotieactiviteiten te kunnen meten en aanvullende informatie, o.a. over de doelgroepen, voor de beleidsbepaling ten aanzien van de promotiecampagne te kunnen leveren. Op haar beurt heeft de Grontmij het Geografisch Instituut van de Rijksuniversiteit Utrecht benaderd met het verzoek een m.i.s. te ontwerpen voor het toeristisch-recreatief product van de stad Utrecht." ] ;
    sgpl:thesisID 154 .

sgpl:Thesis155 a sgpl:SGPLThesis ;
    dcterms:creator "Gerard Westerveld",
        "Klaas-Piet Peereboom" ;
    dcterms:issued 1986 ;
    dcterms:title "GEÏNTEGREERDE BEDRIJFSPROJECTEN IN DE PROVINCIE UTRECHT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "In Amsterdam was in het begin van 1986 sprake van een redelijk evenwicht op de markt, in Utrecht daarentegen een tekort (VGM,jan 1986). Het overgrote deel van het land kent echter een groot overschot aan kantoorruimte en bedrijfsruimte. Deze situatie doet zich eigenlijk al voor vanaf 1978 en men verwacht dat hierin voorlopig weinig verandering zal komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Het is een knooppunt van autowegen, spoor- en waterwegen en ook de nabijheid van Schiphol is voor veel bedrijven een reden zich in deze provincie te vestigen. Over het algemeen het goede woonklimaat van Utrecht een belangrijk vestigingsfactor. De ontwikkelaars die een geïntegreerd bedrijfsproject in Utrecht hebben gerealiseerd noemden allen deze argumenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751316 ;
            sgpl:spatialText "Maarssen" ;
            sgpl:text_context "Maarssen De situatie in Maarssen is sterk vergelijkbaar met die in Nieuwegein. Ook hier vinden grote uitbreidingen plaats. Het gemeentelijk beleid en de ligging nabij een snelweg vertonen overeenkomsten. Maarssen is echter kleiner van omvang dan Nieuwegein en het beschikt niet over de groeistad status." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Nieuwegein Dit is een van de gemeenten waar grote uitbreidingen plaatsgevonden hebben of nog plaatsvinden. Als groeigemeente probeert het zich niet alleen als grote forensenstad van Utrecht te profileren maar streeft het naar een gunstige woon-werk balans. Nieuwegein heeft in vergelijking met Utrecht een ruimhartig beleid, met de mogelijkheid grond te kopen en snelle procedures als het gaat om inpassing in de stedebouwkundige voorschriften." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758927 ;
            sgpl:spatialText "Bilthoven" ;
            sgpl:text_context "In de Meern zal een zakencentrum komen van 11500 vierkante meter bedrijfsruimte en 4000 vierkante meter kantoorruimte. Bilthoven In deze gemeente ligt het het stadsdeelcentrum ’de Kwinkelier’ bestaande uit kantoren, winkels en openbare voorzieningen. De bereikbaarheid van het complex is niet optimaal, maar het ligt gunstig midden in de gemeente." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "de Randstad" ;
            sgpl:text_context "Als Nederland als geheel wordt bekeken blijkt dat het overgrote deel van de kantoren in de Randstad geconcentreerd is en blijft (o.a. Hanemaayer e.a. 1981). Volgens Heelsbergen en de Smidt (1982) kunnen een aantal factoren de vestiging van kantoren daar verklaren. De eerste is de arbeidsmarkt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Utrecht is van deze gemeenten de grootste vestigingsplaats voor bedrijven. Niet alleen de bevolkingsconcentratie maar ook de centrale ligging, het goede openbaar vervoer en niet in het minst de aantrekkingskracht van Hoog-Catharijne en de Jaarbeurs zijn belangrijke verklarende factoren. De leegstand in de nieuwbouw van bedrijfshuisvesting is vrij klein en het huurprijsniveau is relatief hoog maar wel stabiel." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759544 ;
            sgpl:spatialText "Baarn" ;
            sgpl:text_context "Buiten de 9 genoemde gemeenten in de provincie Utrecht zijn er nauwelijks grote vestigingsplaatsen voor bedrijven. Baarn Hier is het kleinschalige project ’Brlnkzicht’ gelegen, een integratie van kantoren,winkels en woningen. De ligging van het project is vrij goed omdat het tussen twee winkelstraten in ligt zodat het a.h.w. een sleutelfunctie heeft." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751687 ;
            sgpl:spatialText "Leusden" ;
            sgpl:text_context "Leusden Evenals Zeist is Leusden een aantrekkelijke woongemeente. Een groot deel van de productieve bevolking werkt elders vooral in Amersfoort. Voornamelijk voor de verzorging van de bevolking ligt er in Leusden-centrum het complex de Hamershof." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "de provincie Utrecht" ;
            sgpl:text_context "Bovendien willen we dr. M.H. Stijnenbosch en Prof. dr. De Smidt bedanken voor hun inspanningen het onderzoek op te starten. Deze scriptie behandelt een vastgoed-onderwerp nl. geïntegreerde bedrijfsprojecten in de provincie Utrecht. De keuze van het onderwerp werd bepaald door het feit dat tot op heden weinig geografische onderzoek is verricht naar de ontwikkeling van grootschalige vastgoedprojecten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743977 ;
            sgpl:spatialText "Zeist" ;
            sgpl:text_context "Zeist Dit is een typische woonstad met weinig bedrijvigheid. De gemeente is minder actief bedrljven-wervend dan Nieuwegein en Maarssen, maar het vormt ook geen groeistad. Nochtans is er een grote vraag naar kantoorruimte en kent de gemeente weinig leegstand." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5725 ;
            sgpl:subjectText "geïntegreerde bedrijfsprojecten" ;
            sgpl:text_context "Naar aanleiding hiervan wordt een doctoraal-scriptie geschreven. Deze scriptie behandelt een vastgoed-onderwerp nl. geïntegreerde bedrijfsprojecten in de provincie Utrecht. De keuze van het onderwerp werd bepaald door het feit dat tot op heden weinig geografische onderzoek is verricht naar de ontwikkeling van grootschalige vastgoedprojecten." ],
        [ sgpl:refersToConcept unesco:concept448 ;
            sgpl:subjectText "projectontwikkeling" ;
            sgpl:text_context "In toenemende mate werden grootschalige projecten gerealiseerd (Toornend,J.,1983). Onder projectontwikkeling verstaan we: het voor eigen risico ontwikkelen, organiseren, coördineren, uitvoeren (of doen uitvoeren) van taken die nodig zijn voor het realiseren van onroerend goed. Projectontwikkeling vindt globaal plaats via de volgende stappen: Door middel van marktonderzoek wordt de kans op verkoop of verhuur van een project nagegaan, hoewel ook voor de vrije markt wordt gebouwd." ],
        [ sgpl:refersToConcept unesco:concept13608 ;
            sgpl:subjectText "vastgoedmarkt" ;
            sgpl:text_context "Paragraaf 1.2. gaat in op de onderzoeksopzet van deze studie. Hoofdstuk 2 gaat in op de structuur van de vastgoedmarkt. Doel hierbij is vooral de werking van de vrije vastgoedmarkt weer te geven: dat gedeelte van de markt voor commercieel onroerend goed dat is bestemd voor verhuur of verkoop aan nog onbekende gebruikers." ],
        [ sgpl:refersToConcept unesco:concept13608 ;
            sgpl:subjectText "vastgoedmarkt" ;
            sgpl:text_context "Paragraaf 1.2. gaat in op de onderzoeksopzet van deze studie. Hoofdstuk 2 gaat in op de structuur van de vastgoedmarkt. Doel hierbij is vooral de werking van de vrije vastgoedmarkt weer te geven: dat gedeelte van de markt voor commercieel onroerend goed dat is bestemd voor verhuur of verkoop aan nog onbekende gebruikers." ],
        [ sgpl:refersToConcept unesco:concept5725 ;
            sgpl:subjectText "geïntegreerde bedrijfsprojecten" ;
            sgpl:text_context "Naar aanleiding hiervan wordt een doctoraal-scriptie geschreven. Deze scriptie behandelt een vastgoed-onderwerp nl. geïntegreerde bedrijfsprojecten in de provincie Utrecht. De keuze van het onderwerp werd bepaald door het feit dat tot op heden weinig geografische onderzoek is verricht naar de ontwikkeling van grootschalige vastgoedprojecten." ],
        [ sgpl:refersToConcept unesco:concept448 ;
            sgpl:subjectText "projectontwikkeling" ;
            sgpl:text_context "In toenemende mate werden grootschalige projecten gerealiseerd (Toornend,J.,1983). Onder projectontwikkeling verstaan we: het voor eigen risico ontwikkelen, organiseren, coördineren, uitvoeren (of doen uitvoeren) van taken die nodig zijn voor het realiseren van onroerend goed. Projectontwikkeling vindt globaal plaats via de volgende stappen: Door middel van marktonderzoek wordt de kans op verkoop of verhuur van een project nagegaan, hoewel ook voor de vrije markt wordt gebouwd." ] ;
    sgpl:thesisID 155 .

sgpl:Thesis156 a sgpl:SGPLThesis ;
    dcterms:creator "Marianne Wiegersma",
        "Sander Reith" ;
    dcterms:issued 1986 ;
    dcterms:title "Analyse van het appartementenbestand en onderzoek onder eigenaar-verhuurders van appartementen in Mariahoeve en Staten-kwartier, twee wijken in Den Haag.",
        "DE TOEKOMST VAN VERHUURDE EN LEEGSTAANDE APPARTEMENTEN IN DEN HAAG" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Transvaal" ;
            sgpl:text_context "8,8 Het onderzoeksgebied Wanneer we de spreiding van de appartementen over Den Haag bekijken, dan valt op dat 64^ van het totaal aantal verleende splitsingsvergunningen betrekking heeft op Ualkenboskwartier, SchiIdersbuurt, Regentessekwartier, Transvaal en de Bomen- en Bloemenbuurt (Hoogland, 13B4). Tussen de wijken bestaat een grote diversiteit in het appartementenbestand." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:11525098 ;
            sgpl:spatialText "Regentessekwartier" ;
            sgpl:text_context "8,8 Het onderzoeksgebied Wanneer we de spreiding van de appartementen over Den Haag bekijken, dan valt op dat 64^ van het totaal aantal verleende splitsingsvergunningen betrekking heeft op Ualkenboskwartier, SchiIdersbuurt, Regentessekwartier, Transvaal en de Bomen- en Bloemenbuurt (Hoogland, 13B4). Tussen de wijken bestaat een grote diversiteit in het appartementenbestand." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Frederik Hendriklaan" ;
            sgpl:text_context "Naast een qua aantal en kwaliteit goed ontwikkeld winkelapparaat, geconcentreerd aan de Frederik Hendriklaan, valt vooral de aanwezigheid van enkele culturele voorzieningen op (het Haags Gemeentemu- seum en het Congresgebouw}. Een aantal panden dat voorheen een woonfunctie had, is thans in gebruik als kantoor (Hoogland, 19B4)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Elviraland" ;
            sgpl:text_context "In enkele gevallen echter, heeft deze situatie wel dege- lijk tot achterstallig onderhoud geleid (Elviraland, Roggekamp). Deze complexen zijn dan ook niet in handen van institutionele beleggers, maar van exploitanten. Het vooruitzicht de Uereniging van Eigenaren te moeten \"wekken\" (met alle administratieve \"rompslomp\" van dien), weerhoudt de beleggers er in het algemeen van hun bezit \"aan te breken\" (d.w.z. het verkopen van één of enkele appartementen uit een complex dat ze in z’n geheel bezit- ten) ." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "In Amsterdam nam het aantal appartementsrechten in de voor-oorlogse bebouwing toe van 9.000 in 1974 tot 11.000 in 1979. In Rotterdam steeg dit aantal van 1.000 in 1974 tot 15.000 in 1979 (Maas, 1991). Aanvankelijk vond splitsing behal- ve in Rotterdam, vooral plaats in de oudere stadsdelen (19e- en vroeg EOe-eeuwse wijken), na 1975 echter ook in de nieuwere wijken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "SchiIdersbuurt" ;
            sgpl:text_context "8,8 Het onderzoeksgebied Wanneer we de spreiding van de appartementen over Den Haag bekijken, dan valt op dat 64^ van het totaal aantal verleende splitsingsvergunningen betrekking heeft op Ualkenboskwartier, SchiIdersbuurt, Regentessekwartier, Transvaal en de Bomen- en Bloemenbuurt (Hoogland, 13B4). Tussen de wijken bestaat een grote diversiteit in het appartementenbestand." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751191 ;
            sgpl:spatialText "Mariahoeve" ;
            sgpl:text_context "Veel appartementen worden echter nog verhuurd. Dit onderzoek sluit aan op onderzoek dat eerder verricht is onder eigenaar-bewoners in Statenkwartier en Hariahoeve. Het is bedoeld om een completer beeld van appartementensplitsing en horizontale verkoop te verkrijgen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:11525080 ;
            sgpl:spatialText "Bomen- en Bloemenbuurt" ;
            sgpl:text_context "8,8 Het onderzoeksgebied Wanneer we de spreiding van de appartementen over Den Haag bekijken, dan valt op dat 64^ van het totaal aantal verleende splitsingsvergunningen betrekking heeft op Ualkenboskwartier, SchiIdersbuurt, Regentessekwartier, Transvaal en de Bomen- en Bloemenbuurt (Hoogland, 13B4). Tussen de wijken bestaat een grote diversiteit in het appartementenbestand." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Aanleiding voor de keuze van dit onderwerp was het onderzoek naar appartementensplitsing en horizontale ver- koop in Den Haag, dat eerder uitgevoerd is door vier stu- denten van de Urije Universiteit in Amsterdam. Dm verge- lijking met dit onderzoek mogelijk te maken, zijn dezelf- de wijken van Den Haag als onderzoeksgebied gekozen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Laakkwartier" ;
            sgpl:text_context "Tussen de wijken bestaat een grote diversiteit in het appartementenbestand. Zo bestaat b.v. in Laakkwartier 7S?s (d.i. 3738 appartementen) van de totale woningvoorraad uit appartementen, terwijl dit voor Statenkwartier op 31 december 1383 \"slechts\" 47,7/S (d.i.1774 appartementen) bedraagt. Ook het soort woning dat opgesplitst is in appartementen verschilt per wijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Ualkenboskwartier" ;
            sgpl:text_context "8,8 Het onderzoeksgebied Wanneer we de spreiding van de appartementen over Den Haag bekijken, dan valt op dat 64^ van het totaal aantal verleende splitsingsvergunningen betrekking heeft op Ualkenboskwartier, SchiIdersbuurt, Regentessekwartier, Transvaal en de Bomen- en Bloemenbuurt (Hoogland, 13B4). Tussen de wijken bestaat een grote diversiteit in het appartementenbestand." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het particuliere woningbezit is groot in vergelijking met geheel Nederland. Net als in Nederland als geheel neemt dit particuliere woningbezit af. In 1330 bedroeg het percentage woningen in handen van particulieren nog B3^ van de totale woningvoorraad, in 1961 bedroeg dit 7S5£, in 13B0 70*; en in 13BS is dit 66,1^." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Margarethaland" ;
            sgpl:text_context "In dit aantal zijn ook de nieuwe appartementen aan Margarethaland nog niet meegerekend' Uan de 1863 appartementen in Statenkwartier worden ieder geval 1136 (61,04? door eigenaar-bewoners bewoond' Waarschijnlijk ligt dit percentage zelfs hoger, aangezi® een groot gedeelte van de als eigenaar-verhuurder boek staande eigenaren verhuisd bleek te zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "□crzaken hiervan Na 136E — de verschillen in bouwactiviteiten per sector. nemen de bouwactiviteiten in de particuliere huursector in de Randstad sterk af, De Randstad behoort tot het niet-geliberaliseerde gebied^ , waar de huren zo goed als gelijk moeten blijven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "DE TOEKOMST UAN UERHUURDE EN LEEGSTAANDE APPARTEMENTEN IN DEN HAAG Analyse van het appartementenbestand en onderzoek onder eigenaar-verhuurders van appartementen in Mariahoeve en Staten- kwartier, twee wijken in Den Haag. Sander Reith Marianne UJiegersma RIJKSUNIVERSITEIT UTRECHT" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746826 ;
            sgpl:spatialText "Statenkwartier" ;
            sgpl:text_context "Tussen de wijken bestaat een grote diversiteit in het appartementenbestand. Zo bestaat b.v. in Laakkwartier 7S?s (d.i. 3738 appartementen) van de totale woningvoorraad uit appartementen, terwijl dit voor Statenkwartier op 31 december 1383 \"slechts\" 47,7/S (d.i.1774 appartementen) bedraagt. Ook het soort woning dat opgesplitst is in appartementen verschilt per wijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "VOORWOORD Dit rapport, geschreven in het kader van de studie sociale geografie aan de Rijksuniversiteit te Utrecht, vormt onze doctoraalscriptie. Aanleiding voor de keuze van dit onderwerp was het onderzoek naar appartementensplitsing en horizontale ver- koop in Den Haag, dat eerder uitgevoerd is door vier stu- denten van de Urije Universiteit in Amsterdam." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744989 ;
            sgpl:spatialText "gemeente Wassenaar" ;
            sgpl:text_context "Dok het winkelcentrum, dat in het midden van de wijk ligt, heeft een relatief hoog voorzieningenniveau. Tenslotte draagt ook het feit dat Mariahoeve aan de gemeente Wassenaar grenst misschien bij aan de hoge status van de wijk (DiJkman, (19B5). Beide wijken worden dus gekenmerkt door een hoge status en een hoog voorzieningenniveau." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Roggekamp" ;
            sgpl:text_context "In enkele gevallen echter, heeft deze situatie wel dege- lijk tot achterstallig onderhoud geleid (Elviraland, Roggekamp). Deze complexen zijn dan ook niet in handen van institutionele beleggers, maar van exploitanten. Het vooruitzicht de Uereniging van Eigenaren te moeten \"wekken\" (met alle administratieve \"rompslomp\" van dien), weerhoudt de beleggers er in het algemeen van hun bezit \"aan te breken\" (d.w.z. het verkopen van één of enkele appartementen uit een complex dat ze in z’n geheel bezit- ten) ." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "horizontale verkoop" ;
            sgpl:text_context "Een belangrijk begrip hierbij is het appartementsrecht. Splitsing en horizontale verkoop brengt in principe meer op dan verkoop van het pand in zijn geheel. Bij verkoop van het pand in zijn geheel is namelijk vaak een gedeelte als huurwoning bestemd en huurwoningen hebben een lagere waarde." ],
        [ sgpl:refersToConcept unesco:concept8849 ;
            sgpl:subjectText "particuliere huursector" ;
            sgpl:text_context "Tot slot wordt in de onderzoeksopzet uiteengezet hoe het onderzoek zal worden aangepakt. In dit hoofdstuk wordt eerst een algemeen kader geschetst, waarin aandacht wordt gevestigd op ontwikkelingen van de sectoren op de woningmarkt, en met name op die van de particuliere huursector. Hierbij wordt gekeken naar de voor- en nadelen en naar de oorzaken van de afname van deze sector." ],
        [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "appartementensplitsing" ;
            sgpl:text_context "Hierbij wordt gekeken naar de voor- en nadelen en naar de oorzaken van de afname van deze sector. Daarna wordt dieper ingegaan op het verschijnsel appartementensplitsing als een van de oorzaken van de afname van de particuliere huursector. Er wordt behandeld wat appartementensplitsing inhoudt en er worden enige cijfers genoemd." ],
        [ sgpl:refersToConcept unesco:concept8849 ;
            sgpl:subjectText "particuliere huursector" ;
            sgpl:text_context "Tot slot wordt in de onderzoeksopzet uiteengezet hoe het onderzoek zal worden aangepakt. In dit hoofdstuk wordt eerst een algemeen kader geschetst, waarin aandacht wordt gevestigd op ontwikkelingen van de sectoren op de woningmarkt, en met name op die van de particuliere huursector. Hierbij wordt gekeken naar de voor- en nadelen en naar de oorzaken van de afname van deze sector." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "horizontale verkoop" ;
            sgpl:text_context "Een belangrijk begrip hierbij is het appartementsrecht. Splitsing en horizontale verkoop brengt in principe meer op dan verkoop van het pand in zijn geheel. Bij verkoop van het pand in zijn geheel is namelijk vaak een gedeelte als huurwoning bestemd en huurwoningen hebben een lagere waarde." ],
        [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "appartementensplitsing" ;
            sgpl:text_context "Hierbij wordt gekeken naar de voor- en nadelen en naar de oorzaken van de afname van deze sector. Daarna wordt dieper ingegaan op het verschijnsel appartementensplitsing als een van de oorzaken van de afname van de particuliere huursector. Er wordt behandeld wat appartementensplitsing inhoudt en er worden enige cijfers genoemd." ] ;
    sgpl:thesisID 156 .

sgpl:Thesis157 a sgpl:SGPLThesis ;
    dcterms:creator "Toon Weerts" ;
    dcterms:issued 1986 ;
    dcterms:title "ZUID OOST NEDERLAND, VERKEERSVRAAGSTUK ?",
        "een onderzoek naar de hoofdwegenstruktuur in Zuid-Oostelijk Nederland" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmegen" ;
            sgpl:text_context "In het uiterste oosten van Noord Brabant en Noord en Midden Limburg moet deze gestalte krijgen in de aanleg van de A 73 (Nijmegen - Maasbracht) en de A 77 (Boxmeer — Duitse grens — Links Rheinische Autobahn). De A 77 en het noordelijke deel van de A 73 (Nijmegen - Boxmeer) zullen in oktober 1986 worden opengesteld. De A 73 wordt gezien als de ontbrekende schakel in de noord — zuid verbinding in het oostelijk deel van Nederland, terwijl het eerder genoemde noordelijke deel van deze meer dan 90 kilometer lange nieuwe autosnelweg samen met de A 77 en de Links Rheinische Autobahn op Duits grondgebied, een nieuwe snelle verbinding moet gaan vormen tussen het zuidelijk deel van de Randstad en het Roergebied in de Bondsrepub1iek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747351 ;
            sgpl:spatialText "s Hertogenbosch" ;
            sgpl:text_context "Ook de A 2(01) behoeft verbetering. Met name het gedeelte tussen 's Hertogenbosch en Eindhoven voldoet niet meer aan de eisen die gesteld moeten worden aan een dergelijke verbinding van de eerste orde, de hoofdverbinding tussen de Randstad en het zuid - oosten van Nederland. De verbetering van het nu bestaande tracé lijkt niet onwaarschijnlijk maar het is niet uit te sluiten dat in een tracenota een nieuw tracé aan de orde zal komen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord Brabant" ;
            sgpl:text_context "De toegenomen mobiliteit heeft geleid tot een toename van het autogebruik en veroorzaakt daardoor op een aantal wegen van ons land een toenemende verkeersdruk met als gevolg kapaciteitsproblemen en kongestie. In zuid — oost Nederland wordt men ook met deze problematiek gekonfronteerd en in antwoord daarop wordt door de direkties Noord Brabant en Limburg van Rijkswaterstaat gewerkt aan de realisering van een nieuwe hoofdwegenstru.ktuur voor dit gebied. In het uiterste oosten van Noord Brabant en Noord en Midden Limburg moet deze gestalte krijgen in de aanleg van de A 73 (Nijmegen - Maasbracht) en de A 77 (Boxmeer — Duitse grens — Links Rheinische Autobahn)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "zuid — oost Nederland" ;
            sgpl:text_context "De toegenomen mobiliteit heeft geleid tot een toename van het autogebruik en veroorzaakt daardoor op een aantal wegen van ons land een toenemende verkeersdruk met als gevolg kapaciteitsproblemen en kongestie. In zuid — oost Nederland wordt men ook met deze problematiek gekonfronteerd en in antwoord daarop wordt door de direkties Noord Brabant en Limburg van Rijkswaterstaat gewerkt aan de realisering van een nieuwe hoofdwegenstru.ktuur voor dit gebied. In het uiterste oosten van Noord Brabant en Noord en Midden Limburg moet deze gestalte krijgen in de aanleg van de A 73 (Nijmegen - Maasbracht) en de A 77 (Boxmeer — Duitse grens — Links Rheinische Autobahn)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "In het Brabantse deel van het onderzoeksgebied worden voorbereidingen getroffen om te komen tot de aanleg van een nieuwe eerste orde verbinding van het stadsgewest Nijmegen/Arnhem naar het stadsgewest Eindhoven/Hel mond, de A 50 die vanaf Oss via Uden doorgetrokken zou moeten worden naar de A 67 ten oosten van de stad Eindhoven. Ook de A 2(01) behoeft verbetering. Met name het gedeelte tussen 's Hertogenbosch en Eindhoven voldoet niet meer aan de eisen die gesteld moeten worden aan een dergelijke verbinding van de eerste orde, de hoofdverbinding tussen de Randstad en het zuid - oosten van Nederland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Limburg" ;
            sgpl:text_context "De toegenomen mobiliteit heeft geleid tot een toename van het autogebruik en veroorzaakt daardoor op een aantal wegen van ons land een toenemende verkeersdruk met als gevolg kapaciteitsproblemen en kongestie. In zuid — oost Nederland wordt men ook met deze problematiek gekonfronteerd en in antwoord daarop wordt door de direkties Noord Brabant en Limburg van Rijkswaterstaat gewerkt aan de realisering van een nieuwe hoofdwegenstru.ktuur voor dit gebied. In het uiterste oosten van Noord Brabant en Noord en Midden Limburg moet deze gestalte krijgen in de aanleg van de A 73 (Nijmegen - Maasbracht) en de A 77 (Boxmeer — Duitse grens — Links Rheinische Autobahn)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746631,
                geonames:2748481 ;
            sgpl:spatialText "studiegebied" ;
            sgpl:text_context "2 Beschrijving van het studiegebied 2.1 Inleiding. In dit hoofdstuk zal de bestaande toestand in het studiegebied aan de orde komen voorzover van belang voor de te beschouwen infrastrukturele aspekten. 2.2 Begrenzing van het studiegebied. Globaal kan de begrenzing van het studiegebied als volgt worden weergegeven; In het oosten vormd de Rijksgrens de begrenzing, in het noorden de rivier de Waal. De westelijke begrenzing wordt gevormd door de A 2 terwijl de lijn Stamproy - Posterholt de zuidelijke begrenzing vormd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "de Randstad" ;
            sgpl:text_context "De A 73 wordt gezien als de ontbrekende schakel in de noord — zuid verbinding in het oostelijk deel van Nederland, terwijl het eerder genoemde noordelijke deel van deze meer dan 90 kilometer lange nieuwe autosnelweg samen met de A 77 en de Links Rheinische Autobahn op Duits grondgebied, een nieuwe snelle verbinding moet gaan vormen tussen het zuidelijk deel van de Randstad en het Roergebied in de Bondsrepub1iek. In het Brabantse deel van het onderzoeksgebied worden voorbereidingen getroffen om te komen tot de aanleg van een nieuwe eerste orde verbinding van het stadsgewest Nijmegen/Arnhem naar het stadsgewest Eindhoven/Hel mond, de A 50 die vanaf Oss via Uden doorgetrokken zou moeten worden naar de A 67 ten oosten van de stad Eindhoven. Ook de A 2(01) behoeft verbetering." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745641 ;
            sgpl:spatialText "Venlo" ;
            sgpl:text_context "Het tracé van de A 73 is gekozen volgens de variant 3, subvarianten Cl F2 D2, uit de tracenota Rijksweg 73 \"Ruggegraat van Limburg\", dit.27)(b.02) Globaal verloopt dit tracé van Boxmeer via Venray en Horst naar Venlo, kruist de Maas via de aan te leggen Zuiderbrug en gaat op de oostelijke Maasoever naar Roermond en uiteindelijk Maasbracht waar aansluiting gevonden wordt op de A 2. De intentie van dit onderzoek is, meer duidelijkheid te verschaf-fen in de mobi1iteitsontwikkeling van de laatste jaren en de gevolgen daarvan voor de kapaciteit van het bestaande wegennet in het studiegebied." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748000 ;
            sgpl:spatialText "Roermond" ;
            sgpl:text_context "Het tracé van de A 73 is gekozen volgens de variant 3, subvarianten Cl F2 D2, uit de tracenota Rijksweg 73 \"Ruggegraat van Limburg\", dit.27)(b.02) Globaal verloopt dit tracé van Boxmeer via Venray en Horst naar Venlo, kruist de Maas via de aan te leggen Zuiderbrug en gaat op de oostelijke Maasoever naar Roermond en uiteindelijk Maasbracht waar aansluiting gevonden wordt op de A 2. De intentie van dit onderzoek is, meer duidelijkheid te verschaf-fen in de mobi1iteitsontwikkeling van de laatste jaren en de gevolgen daarvan voor de kapaciteit van het bestaande wegennet in het studiegebied." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4696 ;
            sgpl:subjectText "hoofdwegenstruktuur" ;
            sgpl:text_context "De toegenomen mobiliteit heeft geleid tot een toename van het autogebruik en veroorzaakt daardoor op een aantal wegen van ons land een toenemende verkeersdruk met als gevolg kapaciteitsproblemen en kongestie. In zuid — oost Nederland wordt men ook met deze problematiek gekonfronteerd en in antwoord daarop wordt door de direkties Noord Brabant en Limburg van Rijkswaterstaat gewerkt aan de realisering van een nieuwe hoofdwegenstruktuur voor dit gebied. In het uiterste oosten van Noord Brabant en Noord en Midden Limburg moet deze gestalte krijgen in de aanleg van de A 73 (Nijmegen - Maasbracht) en de A 77 (Boxmeer — Duitse grens — Links Rheinische Autobahn)." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "mobiliteitsontwikkeling" ;
            sgpl:text_context "Alleen van Rijksweg A 73 is, afgezien van het gedeelte dat nu in uitvoering is, het traceverloop bekend. De intentie van dit onderzoek is, meer duidelijkheid te verschaffen in de mobiliteitsontwikkeling van de laatste jaren en de gevolgen daarvan voor de kapaciteit van het bestaande wegennet in het studiegebied. Hieraan zal ruim aandacht worden gegeven in de hoofdstukken 4 en 5 van deze nota." ],
        [ sgpl:refersToConcept unesco:concept5254 ;
            sgpl:subjectText "verkeersafwikkelings-problemen" ;
            sgpl:text_context "Het voor U liggende werk is het resultaat van een doktoraal onderzoek hetgeen voornamelijk werd uitgevoerd in het jaar 1985. Hierin staan de verkeersafwikkelings-problemen in zuid oost Nederland centraal, met het oog op de plannen van de Rijksoverheid met betrekking tot de wegenaanleg in dit gebied. De standpunten vanuit de diverse maatschappelijke sektoren hieromtrent, liggen nogal ver uit elkaar." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "mobiliteitsontwikkeling" ;
            sgpl:text_context "Alleen van Rijksweg A 73 is, afgezien van het gedeelte dat nu in uitvoering is, het traceverloop bekend. De intentie van dit onderzoek is, meer duidelijkheid te verschaffen in de mobiliteitsontwikkeling van de laatste jaren en de gevolgen daarvan voor de kapaciteit van het bestaande wegennet in het studiegebied. Hieraan zal ruim aandacht worden gegeven in de hoofdstukken 4 en 5 van deze nota." ],
        [ sgpl:refersToConcept unesco:concept4696 ;
            sgpl:subjectText "hoofdwegenstruktuur" ;
            sgpl:text_context "De toegenomen mobiliteit heeft geleid tot een toename van het autogebruik en veroorzaakt daardoor op een aantal wegen van ons land een toenemende verkeersdruk met als gevolg kapaciteitsproblemen en kongestie. In zuid — oost Nederland wordt men ook met deze problematiek gekonfronteerd en in antwoord daarop wordt door de direkties Noord Brabant en Limburg van Rijkswaterstaat gewerkt aan de realisering van een nieuwe hoofdwegenstruktuur voor dit gebied. In het uiterste oosten van Noord Brabant en Noord en Midden Limburg moet deze gestalte krijgen in de aanleg van de A 73 (Nijmegen - Maasbracht) en de A 77 (Boxmeer — Duitse grens — Links Rheinische Autobahn)." ],
        [ sgpl:refersToConcept unesco:concept5254 ;
            sgpl:subjectText "verkeersafwikkelings-problemen" ;
            sgpl:text_context "Het voor U liggende werk is het resultaat van een doktoraal onderzoek hetgeen voornamelijk werd uitgevoerd in het jaar 1985. Hierin staan de verkeersafwikkelings-problemen in zuid oost Nederland centraal, met het oog op de plannen van de Rijksoverheid met betrekking tot de wegenaanleg in dit gebied. De standpunten vanuit de diverse maatschappelijke sektoren hieromtrent, liggen nogal ver uit elkaar." ] ;
    sgpl:thesisID 157 .

sgpl:Thesis158 a sgpl:SGPLThesis ;
    dcterms:creator "Guido Derksen",
        "Wim van der Zanden" ;
    dcterms:issued 1987 ;
    dcterms:title "ACHTERSTANDSBUURT EN ONDERWIJSPRESTATIE",
        "Een onderzoek naar onderwijsprestaties in Utrechtse achterstandsbuurten" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Een onderzoek naar onderwijsprestaties in Utrechtse achterstandsbuurten. Guido Derksen en Wim van der Zanden Utrecht, 1987. VERSLAGEN VAN LEERONDERZOEK G & P vakgroep toegepaste geografie en ruimtelijke planning." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Onderzoek naar deze relaties is in Nederland nog nauwelijks verricht, hoewel inzicht in de problematiek van groot belang kan zijn bij het maken van beleidskeuzes, welke zich richten op het verbeteren van de onderwijssituatie in achterstandsgebieden. Daarmee kan, gezien de sleutelfunctie van het onderwijs in het doorbreken van achterstandssituaties, ook de algemene achterstand van groepen in deze gebieden verbeterd worden. In dit onderzoek zullen we daarom trachten meer inzicht te verschaffen in voornoemde relaties." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "J.S. de Rijkstraat" ;
            sgpl:text_context "De buurten zijn op grond van dit onderzoek gerangschikt naar mate van achterstand; dit is gebeurd op basis van een achterstandsscore die voor iedere buurt bepaald is. De achterstandsbuurten waar .gëenquêteerd is zijn: Ondiep (24+91), J.S.de Rijkstraat (93), Laan van Nieuw-Guinea (83), Acaciastraat (90) en Achter-Oudwijk (43+95). De niet-achterstandsbuurten zijn: Halve Maan (86), Schildersbuurt (42) en Oog in Al (85) (fig. 3.3.)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Verenigde Staten" ;
            sgpl:text_context "Verschil in de kwaliteit van het aanbod van onderwijsvoorzieningen met betrekking tot onderwijsprestaties blijkt van weinig invloed te zijn. Het in 1966 in de Verenigde Staten gepubliceerde Coleman Report toonde aan dat verschillen tussen scholen een verwaarloosbaar effect hadden op de onderwijsprestaties vergeleken met verschillen in achtergronden thuis. Onderwijsmaatregelen als hervorming van de lesprogramma's, desegregatie, verruiming van de geldelijke middelen alsook de kwaliteit en ervaring van de leerkrachten bleken nauwelijks van invloed op de onderwijsprestaties (VERNON, 1979, p.147-148)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Groot-Brittanië" ;
            sgpl:text_context "In 1980 brengt het Sociaal Cultureel Planburo het cahier \"Sociale achterstand in wijken en gemeenten\" uit, waarin voor alle CBS-buurten en gemeenten in het land een maat voor sociale achterstand is berekend. EDWARDS (1975-1) signaleert de groeiende belangstelling ook in Groot-Brittanië: regeringsprogramma's als de 'Community Development Projects', het 'Urban Programme' en het 'Education Priority Area programme' wijzen op de groeiende interesse in en concentratie op achterstandsgebieden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749573 ;
            sgpl:spatialText "Oog in Al" ;
            sgpl:text_context "De buurten zijn op grond van dit onderzoek gerangschikt naar mate van achterstand; dit is gebeurd op basis van een achterstandsscore die voor iedere buurt bepaald is. De achterstandsbuurten waar .gëenquêteerd is zijn: Ondiep (24+91), J.S.de Rijkstraat (93), Laan van Nieuw-Guinea (83), Acaciastraat (90) en Achter-Oudwijk (43+95). De niet-achterstandsbuurten zijn: Halve Maan (86), Schildersbuurt (42) en Oog in Al (85) (fig. 3.3.)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Achter-Oudwijk" ;
            sgpl:text_context "De buurten zijn op grond van dit onderzoek gerangschikt naar mate van achterstand; dit is gebeurd op basis van een achterstandsscore die voor iedere buurt bepaald is. De achterstandsbuurten waar .gëenquêteerd is zijn: Ondiep (24+91), J.S.de Rijkstraat (93), Laan van Nieuw-Guinea (83), Acaciastraat (90) en Achter-Oudwijk (43+95). De niet-achterstandsbuurten zijn: Halve Maan (86), Schildersbuurt (42) en Oog in Al (85) (fig. 3.3.)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "In dit onderzoek hebben we daarom geprobeerd na te gaan welke invloed het wonen in een achterstandsgebied zou kunnen hebben op de onderwijssituatie aldaar. Het onderzoek is gehouden in een aantal buurten in de gemeente Utrecht. De buurten werden geselecteerd op basis van een gemeentelijk onderzoeksrapport over de mate van achterstand van de Utrechtse buurten (ROHDE & SOUVEREIN, 1983)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Laan van Nieuw-Guinea" ;
            sgpl:text_context "De buurten zijn op grond van dit onderzoek gerangschikt naar mate van achterstand; dit is gebeurd op basis van een achterstandsscore die voor iedere buurt bepaald is. De achterstandsbuurten waar .gëenquêteerd is zijn: Ondiep (24+91), J.S.de Rijkstraat (93), Laan van Nieuw-Guinea (83), Acaciastraat (90) en Achter-Oudwijk (43+95). De niet-achterstandsbuurten zijn: Halve Maan (86), Schildersbuurt (42) en Oog in Al (85) (fig. 3.3.)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrechtse achterstandsbuurten" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT ACHTERSTANDSBUURT EN ONDERWIJSPRESTATIE. Een onderzoek naar onderwijsprestaties in Utrechtse achterstandsbuurten. Guido Derksen en Wim van der Zanden Utrecht, 1987." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Acaciastraat" ;
            sgpl:text_context "De buurten zijn op grond van dit onderzoek gerangschikt naar mate van achterstand; dit is gebeurd op basis van een achterstandsscore die voor iedere buurt bepaald is. De achterstandsbuurten waar .gëenquêteerd is zijn: Ondiep (24+91), J.S.de Rijkstraat (93), Laan van Nieuw-Guinea (83), Acaciastraat (90) en Achter-Oudwijk (43+95). De niet-achterstandsbuurten zijn: Halve Maan (86), Schildersbuurt (42) en Oog in Al (85) (fig. 3.3.)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2653822 ;
            sgpl:spatialText "Cardiff" ;
            sgpl:text_context "In de praktijk is het dikwijls zo dat achterstand op verscheidene terreinen tegelijk optreedt. Dit kan geïllustreerd worden aan de hand van een studie van HERBERT (1975, p.367) over achterstand in Cardiff. Hij constateerde dat er zowel in de binnenstad als in de buitenwijken van Cardiff gebieden voorkomen, waar men een achterstand heeft op een aantal door hem geselecteerde terreinen, namelijk huisvesting, werkgelegenheid, onderwijsniveau en criminaliteit." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6843496 ;
            sgpl:spatialText "Halve Maan" ;
            sgpl:text_context "De buurten zijn op grond van dit onderzoek gerangschikt naar mate van achterstand; dit is gebeurd op basis van een achterstandsscore die voor iedere buurt bepaald is. De achterstandsbuurten waar .gëenquêteerd is zijn: Ondiep (24+91), J.S.de Rijkstraat (93), Laan van Nieuw-Guinea (83), Acaciastraat (90) en Achter-Oudwijk (43+95). De niet-achterstandsbuurten zijn: Halve Maan (86), Schildersbuurt (42) en Oog in Al (85) (fig. 3.3.)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:11525083 ;
            sgpl:spatialText "Schildersbuurt" ;
            sgpl:text_context "De buurten zijn op grond van dit onderzoek gerangschikt naar mate van achterstand; dit is gebeurd op basis van een achterstandsscore die voor iedere buurt bepaald is. De achterstandsbuurten waar .gëenquêteerd is zijn: Ondiep (24+91), J.S.de Rijkstraat (93), Laan van Nieuw-Guinea (83), Acaciastraat (90) en Achter-Oudwijk (43+95). De niet-achterstandsbuurten zijn: Halve Maan (86), Schildersbuurt (42) en Oog in Al (85) (fig. 3.3.)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2648110 ;
            sgpl:spatialText "Greater London" ;
            sgpl:text_context "SMITH (1979) waarschuwde echter voor het gevaar van het vaststellen van probleemgebieden, met name op een geaggregeerd niveau. Hij illustreerde dit aan de hand van een case-study over Greater London, waar op een geaggregeerd niveau van ’boroughs’ een duidelijk ruimtelijk patroon van meervoudige achterstand te zien was. Op een lager niveau echter bleek dat er binnen de boroughs aanzienlijke verschillen waren wat betreft de verspreiding van de aspecten van achterstand, en dat er nauwelijks een regelmatig patroon te herkennen was." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Ondiep" ;
            sgpl:text_context "De buurten zijn op grond van dit onderzoek gerangschikt naar mate van achterstand; dit is gebeurd op basis van een achterstandsscore die voor iedere buurt bepaald is. De achterstandsbuurten waar .gëenquêteerd is zijn: Ondiep (24+91), J.S.de Rijkstraat (93), Laan van Nieuw-Guinea (83), Acaciastraat (90) en Achter-Oudwijk (43+95). De niet-achterstandsbuurten zijn: Halve Maan (86), Schildersbuurt (42) en Oog in Al (85) (fig. 3.3.)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3574 ;
            sgpl:subjectText "Achterstandsbuurt" ;
            sgpl:text_context "Werken de externe factoren een hoge motivatie in de hand, dan zullen de verstandelijke vermogens zich sterk ontwikkelen en daarmee zullen tevens de schoolprestaties goed zijn. In dit onderzoek wordt namelijk onderzocht welke van deze externe factoren nu precies van belang zijn voor de onderwijsprestaties in een achterstandsbuurt, en in welke mate ze dat zijn. Een groot probleem echter is de vraag in hoeverre, naast de externe factoren, ook erfelijke factoren van belang zijn voor de ontwikkeling van de verstandelijke vermogens ( het IQ ) en daarmee voor de onderwijsprestaties." ],
        [ sgpl:refersToConcept unesco:concept6939 ;
            sgpl:subjectText "Culture of poverty" ;
            sgpl:text_context "Gedacht kan worden aan stimulering en mogelijkheden die ouders hun kinderen geven om met een groot aantal verschillende situaties om te gaan, aan verwachtingen en aan aanmoedigingen van de ouders wat betreft de schoolprestaties. In dit onderzoek worden al deze factoren beschouwd als deel uitmakend van een geheel, de 'culture of poverty'. In paragraaf 2.5. zal dit begrip nader uiteengezet worden." ],
        [ sgpl:refersToConcept unesco:concept6707 ;
            sgpl:subjectText "Onderwijsprestatie" ;
            sgpl:text_context "Slechte onderwijsprestaties als gevolg van slechte huisvesting hangt dus weer samen met een lage sociaal-economische status van de ouders, en het is deze onderlinge verbondenheid die het zo moeilijk maakt om de invloed van slechte huisvesting op zich te meten. Uit een onderzoek van DAVIE et al (1972,p.55-57) naar de relatie tussen slechte huisvesting en onderwijsprestaties blijkt dat een hoge woningbezetting (meer dan 1,5 personen per kamer) en een gebrek aan voorzieningen in de woning een aanzienlijke achterstand in onderwijsprestaties kan opleveren. Verschil in de kwaliteit van het aanbod van onderwijsvoorzieningen met betrekking tot onderwijsprestaties blijkt van weinig invloed te zijn." ],
        [ sgpl:refersToConcept unesco:concept6939 ;
            sgpl:subjectText "Culture of poverty" ;
            sgpl:text_context "Gedacht kan worden aan stimulering en mogelijkheden die ouders hun kinderen geven om met een groot aantal verschillende situaties om te gaan, aan verwachtingen en aan aanmoedigingen van de ouders wat betreft de schoolprestaties. In dit onderzoek worden al deze factoren beschouwd als deel uitmakend van een geheel, de 'culture of poverty'. In paragraaf 2.5. zal dit begrip nader uiteengezet worden." ],
        [ sgpl:refersToConcept unesco:concept6707 ;
            sgpl:subjectText "Onderwijsprestatie" ;
            sgpl:text_context "Slechte onderwijsprestaties als gevolg van slechte huisvesting hangt dus weer samen met een lage sociaal-economische status van de ouders, en het is deze onderlinge verbondenheid die het zo moeilijk maakt om de invloed van slechte huisvesting op zich te meten. Uit een onderzoek van DAVIE et al (1972,p.55-57) naar de relatie tussen slechte huisvesting en onderwijsprestaties blijkt dat een hoge woningbezetting (meer dan 1,5 personen per kamer) en een gebrek aan voorzieningen in de woning een aanzienlijke achterstand in onderwijsprestaties kan opleveren. Verschil in de kwaliteit van het aanbod van onderwijsvoorzieningen met betrekking tot onderwijsprestaties blijkt van weinig invloed te zijn." ],
        [ sgpl:refersToConcept unesco:concept3574 ;
            sgpl:subjectText "Achterstandsbuurt" ;
            sgpl:text_context "Werken de externe factoren een hoge motivatie in de hand, dan zullen de verstandelijke vermogens zich sterk ontwikkelen en daarmee zullen tevens de schoolprestaties goed zijn. In dit onderzoek wordt namelijk onderzocht welke van deze externe factoren nu precies van belang zijn voor de onderwijsprestaties in een achterstandsbuurt, en in welke mate ze dat zijn. Een groot probleem echter is de vraag in hoeverre, naast de externe factoren, ook erfelijke factoren van belang zijn voor de ontwikkeling van de verstandelijke vermogens ( het IQ ) en daarmee voor de onderwijsprestaties." ] ;
    sgpl:thesisID 158 .

sgpl:Thesis159 a sgpl:SGPLThesis ;
    dcterms:creator "E.M.S. DIJK",
        "R. VERHOEF" ;
    dcterms:issued 1987 ;
    dcterms:title "Een onderzoek naar de ontwikkeling van woonlastenquoten in de Kinkerbuurt",
        "WOONLASTEN EN INKOMENS IN DE STADSVERNIEUWING" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Kinkerbuurt" ;
            sgpl:text_context "De keuze is uiteindelijk gevallen op een complex in de Kinkerbuurt. Het wordt begrensd door de Jac. van Lennepkade, Tollensstraat, Jac. van Lennepstraat en de ten Katestraat. Het complex werd in de loop van 1976 opgeleverd en kan in principe vanaf deze datum worden gevolgd in zijn ontwikkeling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "19e eeuwse wijken" ;
            sgpl:text_context "In het algemeen wordt aangenomen, dat de 19e eeuwse wijken huisvesting bieden aan de lagere inkomensgroepen. Een ons inziens logische aanname, immers, in deze wijken bevindt zich de goedkope woningvoorraad van Amsterdam. Bezien we het gemiddeld belastbaar inkomen van de huishoudens in Amsterdam dan blijkt dit in verschillende jaren onder het landelijke gemiddelde te liggen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Stadsvernieuwing is voor deze bewoners vaak de enige manier om hun woonsituatie te verbeteren (Koops, 1981). In Amsterdam is men onder het motto 'Bouwen voor de buurt' steeds meer tot een beleid gegroeid dat rekening houdt met de behoeften en de mogelijkheden van de oorspronkelijke bewoners van de stadsvernieuwingsgebieden. Garantie/budgethuren, de instelling van de individuele huursubsidie, gewenningssubsidies en dergelijke zijn maatregelen, die de nieuwbouw in de stadsvernieuwingsgebieden binnen het bereik van de oorspronkelijke buurtbewoners moesten brengen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743698 ;
            sgpl:spatialText "Zuid-Holland" ;
            sgpl:text_context "Alleen al per regio kan het gemiddeld gasverbruik per gezinshuishouden verschillen. In 1979 was dit verbruik in bijvoorbeeld de provincie Drente 4309 m3, in Zuid-Holland beliep dit cijfer in hetzelfde jaar 2494 m3 (IWW, 1982). De inschatting van de ontwikkeling van dit deel van de gebruikskosten op nationaal niveau lijkt dan ook, zo niet onmogelijk, dan toch wel weinig zinvol." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In dit hoofdstuk zal aandacht besteed worden aan de woonlasten- en inkomensontwikkeling in Nederland. Nagegaan zal worden welke prijsstijgingen de voornaamste woonlastencomponenten de laatste 10 jaar hebben doorgemaakt. Verder zal aandacht besteed worden aan de verdeling van woonlasten over verschillende inkomenscategorieën." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756631 ;
            sgpl:spatialText "provincie Drente" ;
            sgpl:text_context "Alleen al per regio kan het gemiddeld gasverbruik per gezinshuishouden verschillen. In 1979 was dit verbruik in bijvoorbeeld de provincie Drente 4309 m3, in Zuid-Holland beliep dit cijfer in hetzelfde jaar 2494 m3 (IWW, 1982). De inschatting van de ontwikkeling van dit deel van de gebruikskosten op nationaal niveau lijkt dan ook, zo niet onmogelijk, dan toch wel weinig zinvol." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Jac. van Lennepkade" ;
            sgpl:text_context "De keuze is uiteindelijk gevallen op een complex in de Kinkerbuurt. Het wordt begrensd door de Jac. van Lennepkade, Tollensstraat, Jac. van Lennepstraat en de ten Katestraat. Het complex werd in de loop van 1976 opgeleverd en kan in principe vanaf deze datum worden gevolgd in zijn ontwikkeling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Deze problemen uitten zich al in huurachterstanden en te late betalingen van de energierekening bij bewoners. In 1983 meldde Rotterdam bijvoorbeeld al zo'n 8 miljoen gulden aan huurachterstanden. De vraag die uit het voorgaande voortvloeit is nu, of de aangegeven ontwikkelingen invloed hebben op het verhuisgedrag van individuen en, meer in het algemeen, of deze ontwikkelingen gevolgen hebben voor de sociale samenstelling van een stadsvernieuwingsbuurt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "station Schiphol" ;
            sgpl:text_context "Voor de meting van de graaddagen gebruikt men dan ook 18 verschillende meetstations. In ons geval zijn de metingen van het station Schiphol relevant. Als voorbeeld geven we hieronder het aantal graaddagen per maand voor de jaren 1983, 1984 en 1985 voor dit station." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3618 ;
            sgpl:subjectText "woonlasten" ;
            sgpl:text_context "Redenen voor deze aandacht liggen onder meer in het feit, dat de woonlastenontwikkeling een stijgende lijn vertoont en de inkomensontwikkeling daarentegen stagneert of zelfs een dalende tendens laat zien. Elk huishouden heeft woonlasten; ze vormen een belangrijk onderdeel van het bestedingspatroon van de huishoudens en zijn nauwelijks substitueerbaar. In dit licht bezien, is de verhouding tussen de woonlasten en het inkomen direct bepalend voor de welvaartspositie van de huishoudens." ],
        [ sgpl:refersToConcept unesco:concept594 ;
            sgpl:subjectText "inkomensontwikkeling" ;
            sgpl:text_context "De laatste jaren staat de ontwikkeling van de woonlasten volop in de belangstelling. Redenen voor deze aandacht liggen onder meer in het feit, dat de woonlastenontwikkeling een stijgende lijn vertoont en de inkomensontwikkeling daarentegen stagneert of zelfs een dalende tendens laat zien. Elk huishouden heeft woonlasten; ze vormen een belangrijk onderdeel van het bestedingspatroon van de huishoudens en zijn nauwelijks substitueerbaar." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Immers, de subsurbanisatiegolf van de zestiger en zeventiger jaren en het jarenlange verval van de woningen in de steden hebben indertijd een proces van selectieve migratie op gang gebracht, waardoor de laagste inkomensgroepen in de stad achterbleven. Stadsvernieuwing is voor deze bewoners vaak de enige manier om hun woonsituatie te verbeteren (Koops, 1981). In Amsterdam is men onder het motto 'Bouwen voor de buurt' steeds meer tot een beleid gegroeid dat rekening houdt met de behoeften en de mogelijkheden van de oorspronkelijke bewoners van de stadsvernieuwingsgebieden." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Immers, de subsurbanisatiegolf van de zestiger en zeventiger jaren en het jarenlange verval van de woningen in de steden hebben indertijd een proces van selectieve migratie op gang gebracht, waardoor de laagste inkomensgroepen in de stad achterbleven. Stadsvernieuwing is voor deze bewoners vaak de enige manier om hun woonsituatie te verbeteren (Koops, 1981). In Amsterdam is men onder het motto 'Bouwen voor de buurt' steeds meer tot een beleid gegroeid dat rekening houdt met de behoeften en de mogelijkheden van de oorspronkelijke bewoners van de stadsvernieuwingsgebieden." ],
        [ sgpl:refersToConcept unesco:concept3618 ;
            sgpl:subjectText "woonlasten" ;
            sgpl:text_context "Redenen voor deze aandacht liggen onder meer in het feit, dat de woonlastenontwikkeling een stijgende lijn vertoont en de inkomensontwikkeling daarentegen stagneert of zelfs een dalende tendens laat zien. Elk huishouden heeft woonlasten; ze vormen een belangrijk onderdeel van het bestedingspatroon van de huishoudens en zijn nauwelijks substitueerbaar. In dit licht bezien, is de verhouding tussen de woonlasten en het inkomen direct bepalend voor de welvaartspositie van de huishoudens." ],
        [ sgpl:refersToConcept unesco:concept594 ;
            sgpl:subjectText "inkomensontwikkeling" ;
            sgpl:text_context "De laatste jaren staat de ontwikkeling van de woonlasten volop in de belangstelling. Redenen voor deze aandacht liggen onder meer in het feit, dat de woonlastenontwikkeling een stijgende lijn vertoont en de inkomensontwikkeling daarentegen stagneert of zelfs een dalende tendens laat zien. Elk huishouden heeft woonlasten; ze vormen een belangrijk onderdeel van het bestedingspatroon van de huishoudens en zijn nauwelijks substitueerbaar." ] ;
    sgpl:thesisID 159 .

sgpl:Thesis160 a sgpl:SGPLThesis ;
    dcterms:creator "D.L. Loman",
        "J.F. Durian" ;
    dcterms:issued 1987 ;
    dcterms:title "AUTOGIS ONDER DE LOEP" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "1. dataverwerking van een onderzoek omtrent eerstelijnsgezondheidszorg in Utrecht, 2. analyse van de uitslagen van de Gemeenteraadsverkiezingen en de Tweede Kamerverkiezingen in 1986 in resp. de gemeente en de provincie Utrecht, 3. dataverwerking van een onderzoek onder bezoekers aan het zwembad Den Hommel." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Hardware 2.4 Praktijktoepassingen 2.4.1. Het proefprojekt met de gemeente Utrecht Hoofdstuk 3 Ervaringen uit de AutoGIS-praktijk 26. 3.1 Inleiding 3.2 Het aggregeren van gebieden in MOSS." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Den Hommel" ;
            sgpl:text_context "2. analyse van de uitslagen van de Gemeenteraadsverkiezingen en de Tweede Kamerverkiezingen in 1986 in resp. de gemeente en de provincie Utrecht, 3. dataverwerking van een onderzoek onder bezoekers aan het zwembad Den Hommel. Van elk onderzoek worden de werkzaamheden weergegeven voor zover uitgevoerd met AutoGIS." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Aan het eind van de jaren zeventig resulteerde dit in de vaststelling van de GORE- standaard. Sinds het begin van de jaren tachtig beweegt Europa zich ook op dit terrein en is met een eigen norm gekomen: Graphical Kernal System (GKS). Deze standaard heeft zowel in de Verenigde Staten als in Europa ingang gevonden, en men verwacht dat deze norm de kern wordt van volgende generaties GIS." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Erasmus Universiteit Rotterdam" ;
            sgpl:text_context "\"Vrees voor degradatie van (moeizaam verworven) kennis is vaak de onuit gesproken drijfveer achter het verzet tegen de introductie van nieuwe ontwikkelingen.\" Prof.Dr. J. Verhoeff Erasmus Universiteit Rotterdam. INHOUD Inhoudsopgave 3." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT AUTOGIS ONDER DE LOEP. J.F. Durian D.L. Loman RIJKSUNIVERSITEIT UTRECHT. RIJIteonluereiiGil ta Utrecht RE^iaihook Caniwa} Uithol \"Vrees voor degradatie van (moeizaam verworven) kennis is vaak de onuit gesproken drijfveer achter het verzet tegen de introductie van nieuwe ontwikkelingen.\"" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Verenigde Staten" ;
            sgpl:text_context "Sinds het begin van de jaren tachtig beweegt Europa zich ook op dit terrein en is met een eigen norm gekomen: Graphical Kernal System (GKS). Deze standaard heeft zowel in de Verenigde Staten als in Europa ingang gevonden, en men verwacht dat deze norm de kern wordt van volgende generaties GIS. In het verleden werd veel minder aandacht besteed aan kartografische bewerkingen, zodat veel gebruikers naast een GIS een kartografisch systeem hadden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De vraagstelling van het voorliggende onderzoek luidt als volgt: Wat zijn de verschillende mogelijkheden en toepassingen die een Geografisch Informatiesysteem, in het bijzonder AutoGIS, biedt; welke voor- en nadelen zijn aan de te onderscheiden analyse- en weergavemethoden verbonden? Hiervoor is zoals gezegd gebruik gemaakt van het pakket AutoGIS, dat als een van de weinige systemen van kategorie 3 (p.14) in Nederland operationeel is. In het kader van dit exploratieve onderzoek zijn kwalitatieve en kwantitatieve vergelijkingen gemaakt tussen de diverse AutoGIS- mogelijkheden (wat levert betere resultaten op, wat gaat sneller, eenvoudiger etc.)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept17188 ;
            sgpl:subjectText "overlay-techniek" ;
            sgpl:text_context "Naast selektie van bestaande gegevens (variabelen) is het mogelijk om met behulp van rekenkundige bewerkingen nieuwe variabelen te kreëeren, die op hun beurt in beeld kunnen worden gebracht. Zo ontstaat een vrijwel onbeperkte \"stapel\" kaarten, die door selektie en samenvoeging (de overlay-techniek) in elke gewenste kombinatie grafisch kan worden weergegeven. Daarnaast zijn er diverse mogelijkheden voor bewerking van deze kaarten door het inbouwen van voorwaarden over het weer te geven kaartgedeelte, bijvoorbeeld door kleuring, uitvergroting of het aangeven van een zgn. bufferzone." ],
        [ sgpl:refersToConcept unesco:concept17000 ;
            sgpl:subjectText "Geografische Informatie Systemen" ;
            sgpl:text_context "Diverse toepassingen zijn te vinden op het gebied van gegevensbeheer, statistische analyse en kaartproduktie. Een ontwikkeling van de laatste 20 jaar op dit vlak vormen de zogenaamde Geografische Informatie Systemen. Het principe van een Geografisch Informatie Systeem (GIS) is het samenbrengen van de bovengenoemde toepassingsvelden: gegevensbeheer, statistische analyse en kaartproduktie (Ottens en Harts, 1985)." ],
        [ sgpl:refersToConcept unesco:concept378 ;
            sgpl:subjectText "sociaal-geografisch onderzoek" ;
            sgpl:text_context "Hoofdstuk 3 behandelt de tijdens het proefprojekt opgedane ervaringen wat dieper. In hoofdstuk 4 wordt door de auteurs zelf een aantal mogelijke sociaal-geografische onderzoeksvragen gesteld en wordt bekeken in hoeverre AutoGIS behulpzaam kan zijn bij het oplossen van deze problemen. In het laatste hoofdstuk, hoofdstuk 5, wordt een en ander samengevat en van konkluderende opmerkingen voorzien." ],
        [ sgpl:refersToConcept unesco:concept378 ;
            sgpl:subjectText "sociaal-geografisch onderzoek" ;
            sgpl:text_context "Hoofdstuk 3 behandelt de tijdens het proefprojekt opgedane ervaringen wat dieper. In hoofdstuk 4 wordt door de auteurs zelf een aantal mogelijke sociaal-geografische onderzoeksvragen gesteld en wordt bekeken in hoeverre AutoGIS behulpzaam kan zijn bij het oplossen van deze problemen. In het laatste hoofdstuk, hoofdstuk 5, wordt een en ander samengevat en van konkluderende opmerkingen voorzien." ],
        [ sgpl:refersToConcept unesco:concept17188 ;
            sgpl:subjectText "overlay-techniek" ;
            sgpl:text_context "Naast selektie van bestaande gegevens (variabelen) is het mogelijk om met behulp van rekenkundige bewerkingen nieuwe variabelen te kreëeren, die op hun beurt in beeld kunnen worden gebracht. Zo ontstaat een vrijwel onbeperkte \"stapel\" kaarten, die door selektie en samenvoeging (de overlay-techniek) in elke gewenste kombinatie grafisch kan worden weergegeven. Daarnaast zijn er diverse mogelijkheden voor bewerking van deze kaarten door het inbouwen van voorwaarden over het weer te geven kaartgedeelte, bijvoorbeeld door kleuring, uitvergroting of het aangeven van een zgn. bufferzone." ],
        [ sgpl:refersToConcept unesco:concept17000 ;
            sgpl:subjectText "Geografische Informatie Systemen" ;
            sgpl:text_context "Diverse toepassingen zijn te vinden op het gebied van gegevensbeheer, statistische analyse en kaartproduktie. Een ontwikkeling van de laatste 20 jaar op dit vlak vormen de zogenaamde Geografische Informatie Systemen. Het principe van een Geografisch Informatie Systeem (GIS) is het samenbrengen van de bovengenoemde toepassingsvelden: gegevensbeheer, statistische analyse en kaartproduktie (Ottens en Harts, 1985)." ] ;
    sgpl:thesisID 160 .

sgpl:Thesis161 a sgpl:SGPLThesis ;
    dcterms:creator "Elske van Gorkum",
        "Mirjam Andriessen" ;
    dcterms:issued 1987 ;
    dcterms:title "Bewijzen rurale centra boeren een dienst?",
        "Een onderzoek naar het funktioneren van dienstencentra in rurale ontwikkeling, het voorbeeld van de cercle Tominian, Mali" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Dami" ;
            sgpl:text_context "Ten slotte grote dorpen op ruime afstand van Tominian, die niet over eigen voorzieningen beschikken en waar men voor alle dagelijkse en niet-dagelijkse behoeften aangewezen is op Tominian of andere plaatsen. Voorbeelden van dergelijke dorpen zijn Diarani en Dami. Vervolgens werden uit elke kategorie ''e''en of enkele dorpen gekozen voor de enqu''ete." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "regio Ségou" ;
            sgpl:text_context "Hoofdstuk twee geeft een korte schets van het nationaal en regionaal kader waarbinnen de cercle Tominan een plaats heeft. Tenslotte wordt de sociaal-ekonomische positie van de cercle tominian binnen de regio Segou nader bepaald. De eerste twee hoofdstukken vormen, aan de hand van literatuur, een theoretisch en regionaal-geografisch raamwerk dat inzicht verschaft in de positie van de cercle Tominian." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2449060 ;
            sgpl:spatialText "Tominian-ville" ;
            sgpl:text_context "Het onderzoek in de cercle Tominian, waarin aandacht wordt besteed aan de rol van dienstverlening en dienstencentra in de rurale ontwikkeling van de cercle Tominian, behoort tot de eerste cyclus van het PROUST-projekt. De nadruk in het onderzoek lag op een analyse van de sociaal-ekonomische struktuur van Tominian-ville en haar ommeland en de faktoren die aanbod en gebruik van diensten be'invloeden. Het onderzoek werd uitgevoerd van juli 1985 tot en met januari 1986." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2453866 ;
            sgpl:spatialText "Mali" ;
            sgpl:text_context "Het onderzoek geschiedt in samenwerking met het Institut des Sciences Humaines in Bamako, Mali. Het onderzoek in de cercle Tominian, waarin aandacht wordt besteed aan de rol van dienstverlening en dienstencentra in de rurale ontwikkeling van de cercle Tominian, behoort tot de eerste cyclus van het PROUST-projekt. De nadruk in het onderzoek lag op een analyse van de sociaal-ekonomische struktuur van Tominian-ville en haar ommeland en de faktoren die aanbod en gebruik van diensten be'invloeden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "arrondissement Central" ;
            sgpl:text_context "De analyse van de sociaal-ekonomische struktuur van het centrum Tominian en het omliggende platteland is voornamelijk gebaseerd op een enqu''ete onder huishoudens in Tominian-ville en een vijftal dorpen in de omgeving. Om praktische redenen werden deze dorpen het arrondissement Central, waarin Tominian-ville gelegen is, gekozen. De selektie van de dorpen komt in het vervolg aan de orde." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2449060 ;
            sgpl:spatialText "cercle Tominian" ;
            sgpl:text_context "In de voor u liggende skriptie worden de resultaten gepresenteerd van een onderzoek naar het funktioneren van Tominian als dienstencentrum voor de rurale ontwikkeling van haar ommeland. De cercle Tominian is een administratieve regio van ruim 6.300 vierkante kilometer, gelegen in Centraal-Mali. In en rond haar gelijknamige hoofdstad heeft dit onderzoek plaatsgehad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2356105 ;
            sgpl:spatialText "Sadian" ;
            sgpl:text_context "Deze dorpen kunnen een school, een landbouwvoorlichter of een kleine markt bezitten. Twee voorbeelden hiervan zijn Sadian en Yasso. Ten slotte grote dorpen op ruime afstand van Tominian, die niet over eigen voorzieningen beschikken en waar men voor alle dagelijkse en niet-dagelijkse behoeften aangewezen is op Tominian of andere plaatsen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2453866 ;
            sgpl:spatialText "Centraal-Mali" ;
            sgpl:text_context "In de voor u liggende skriptie worden de resultaten gepresenteerd van een onderzoek naar het funktioneren van Tominian als dienstencentrum voor de rurale ontwikkeling van haar ommeland. De cercle Tominian is een administratieve regio van ruim 6.300 vierkante kilometer, gelegen in Centraal-Mali. In en rond haar gelijknamige hoofdstad heeft dit onderzoek plaatsgehad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2451778 ;
            sgpl:spatialText "San" ;
            sgpl:text_context "Vervolgens werd in San, de dichtst bij de cercle Tominian gelegen stad en tevens regionale hoofdstad voor een aantal diensten, het literatuuronderzoek voortgezet. In San bevindt zich de enige bibliotheek die over informatie betreffende de cercle Tominian beschikt. Het is een priv''e-bibliotheek van een pater-antropoloog, die al dertig jaar in de regio woont." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Hanekuy" ;
            sgpl:text_context "Vervolgens werden uit elke kategorie ''e''en of enkele dorpen gekozen voor de enqu''ete. Uit de tweede kategorie werd Sadian gekozen en het nabijgelegen Hanekuy. Uit de laatste kategorie viel de keus op Dami." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept446 ;
            sgpl:subjectText "Rurale ontwikkeling" ;
            sgpl:text_context "Ontwikkelingsdeskundigen zijn het er over eens dat het platteland, dat altijd als basis voor stedelijke ontwikkelingen heeft moeten dienen en dat meestal verreweg het grootste bevolkingsaandeel herbergt in ontwikkelingslanden, te lang verwaarloosd is. Vele overheden van ontwikkelingslanden stelden derhalve in de zeventiger jaren 'rurale ontwikkeling' centraal in hun beleid. Het begrip rurale ontwikkeling, ter indikatie van een streven naar verbetering van de sociaal-ekonomische omstandigheden waarin de plattelandsbevolking verkeert, is echter evenzeer breed als vaag." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "Dienstencentra" ;
            sgpl:text_context "In hoofdstuk één wordt de theoretische achtergrond van rurale en regionale ontwikkeling toegelicht. Bijzondere aandacht is er voor rurale dienstencentra en de potentiële rol van de in deze centra aangeboden diensten om plattelandsontwikkeling te stimuleren. Vervolgens komen verschillende visies op de rol van rurale centra in plattelandsontwikkeling aan de orde en tenslotte worden de twee komponenten van dienstverlening -aanbod en gebruik- besproken." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "Dienstverlening" ;
            sgpl:text_context "Gebruiksbepalende faktoren werden derhalve niet of slechts marginaal opgenomen in beschouwingen over rurale ontwikkeling door middel van rurale dienstverlening. In deze skriptie wordt gepoogd een bijdrage te leveren om in deze leemte in de theorievorming rond de rurale dienstverlening te voorzien. De dienstverlening in de cercle Tominian -een administratieve regio in centraal Mali- is van verschillende invalshoeken bekeken om de werkelijke rol van haar hoofdstad Tominian als dienstencentrum voor de ontwikkeling van het ommeland te bepalen." ],
        [ sgpl:refersToConcept unesco:concept446 ;
            sgpl:subjectText "Rurale ontwikkeling" ;
            sgpl:text_context "Ontwikkelingsdeskundigen zijn het er over eens dat het platteland, dat altijd als basis voor stedelijke ontwikkelingen heeft moeten dienen en dat meestal verreweg het grootste bevolkingsaandeel herbergt in ontwikkelingslanden, te lang verwaarloosd is. Vele overheden van ontwikkelingslanden stelden derhalve in de zeventiger jaren 'rurale ontwikkeling' centraal in hun beleid. Het begrip rurale ontwikkeling, ter indikatie van een streven naar verbetering van de sociaal-ekonomische omstandigheden waarin de plattelandsbevolking verkeert, is echter evenzeer breed als vaag." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "Dienstverlening" ;
            sgpl:text_context "Gebruiksbepalende faktoren werden derhalve niet of slechts marginaal opgenomen in beschouwingen over rurale ontwikkeling door middel van rurale dienstverlening. In deze skriptie wordt gepoogd een bijdrage te leveren om in deze leemte in de theorievorming rond de rurale dienstverlening te voorzien. De dienstverlening in de cercle Tominian -een administratieve regio in centraal Mali- is van verschillende invalshoeken bekeken om de werkelijke rol van haar hoofdstad Tominian als dienstencentrum voor de ontwikkeling van het ommeland te bepalen." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "Dienstencentra" ;
            sgpl:text_context "In hoofdstuk één wordt de theoretische achtergrond van rurale en regionale ontwikkeling toegelicht. Bijzondere aandacht is er voor rurale dienstencentra en de potentiële rol van de in deze centra aangeboden diensten om plattelandsontwikkeling te stimuleren. Vervolgens komen verschillende visies op de rol van rurale centra in plattelandsontwikkeling aan de orde en tenslotte worden de twee komponenten van dienstverlening -aanbod en gebruik- besproken." ] ;
    sgpl:thesisID 161 .

sgpl:Thesis162 a sgpl:SGPLThesis ;
    dcterms:creator "B.F. Welter",
        "F.H.W.M. de Heus",
        "P.P. van Kleij" ;
    dcterms:issued 1987 ;
    dcterms:title "Mogelijkheden voor coördinatie op het gebied van de ruimtelijke ordening in het stadsgewest Utrecht",
        "RUIMTELIJK PLANNEN EN BESTUREN IN HET STADSGEWEST UTRECHT: EEN NIEUWE START?",
        "VERSLAGEN VAN LEERONDERZOEK G & P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "regio \"Groot Utrecht\"" ;
            sgpl:text_context "In het kader van een doctoraalscriptie sociale geografie aan de RUU is ons enige tijd geleden de mogelijkheid geboden een onderzoek te doen naar een mogelijk(e) structuurplan(ning) in de regio \"Groot Utrecht\". Een van de eerste eisen die toen door de makers van deze nota aan de probleemstelling werd gesteld was dat de uitkomsten van het onderzoek voor de ruimtelijke ordenings prak- tijk, zoals die zich momenteel in het onderzoeksgebied afspeelt, van belang zouden kunnen zijn. Daartoe werd in de oriUnteringsfase van het onderzoek aanvankelijk een probleemstelling opgesteld aan de hand van literatuur- studie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753557 ;
            sgpl:spatialText "Houten" ;
            sgpl:text_context "Met de onwil van Midden-Utrecht om voor Zuid-Oost Utrecht te bouwen, de aflopende groeitaak voor Houten en eveneens een nog toenemende woningbehoefte in de eigen gemeente in het achter- hoofd, zal De Bilt toch richting Amersfoort moeten kijken. Het zal echter slechts om het meepikken van graantjes gaan. De Bilt zal toch, zo goed als het gaat, zelf haar problemen moeten oplossen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "Ten negende en als laatste kan de onzekerheid ten aanzien van de gewesten worden genoemd. Per 19 december 1985 hebben Provinciale Staten voor de provincie Utrecht 3 regio's vastgesteld. Stof voor discussie leverde de indeling van De Bilt, Zeist en Bunnik op." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "De aantrekkelijkheid van deze afbakening is gelegen in de geografisch georiënteerde criteria en het feit dat er geen bestuurlijk onoverkomelijke grenzen worden overschreden (lees: provinciegrenzen). Het gebied is sterk nodaal afgebakend. De oriëntatie op Utrecht staat er in cetraal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In 1974 wordt vervolgens het concept-structuurschets Bestuurlijke organisatie gepubliceerd. In deze schets wordt een indeling van Nederland in 44 bestuursrayons gegeven, die zich lenen voor de instelling van gewesten of nieuwe gemeenten. Over de bestuurlijke status, die de erin genoemde territoriale eenheden moeten krij- gen, worden geen uitspraken gedaan (Modder, p. 16)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "Terughoudendheid bij Amersfoort om inwoners uit de regio Zeist, waarbij ook De Bilt hoort, op te vangen, doet weinig goeds voorspellen. Met de onwil van Midden-Utrecht om voor Zuid-Oost Utrecht te bouwen, de aflopende groeitaak voor Houten en eveneens een nog toenemende woningbehoefte in de eigen gemeente in het achter- hoofd, zal De Bilt toch richting Amersfoort moeten kijken. Het zal echter slechts om het meepikken van graantjes gaan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758105 ;
            sgpl:spatialText "Bunnik" ;
            sgpl:text_context "Na 1992 heeft Bunnik volgens recente berekening nog 400 woningen extra nodig om die functie naar behoren te kunnen vervullen. In het voorontwerp streekplan (Provincie Utrecht, p. 71) wordt echter gesteld, dat de randvoorwaarden voor onder andere de drie bovengenoemde gemeenten van een dusdanig gewicht zijn, dat een (aanzienlijke) uitbreiding van het stedelijk gebied boven de bestaande plancapaciteit ongewenst is. Wordt daar strict de hand aan gehouden en blijkt de prognose juist te zijn, dan zal Bunnik tegen die tijd in de problemen komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743977 ;
            sgpl:spatialText "Zeist" ;
            sgpl:text_context "Op basis van woon/werkrelaties, voorzieningenoriëntaties en openbaar vervoersverbindingen komt de provincie tot een stadsgewest waartoe de volgende gemeenten worden gerekend: Utrecht, Maarssen, Maartensdijk, De Bilt, Zeist, Bunnik, Houten, Nieuwegein, IJsselstein, Vleuten-De Meern en Harmelen (voorontwerp streekplan p.9). De aantrekkelijkheid van deze afbakening is gelegen in de geografisch georiënteerde criteria en het feit dat er geen bestuurlijk onoverkomelijke grenzen worden overschreden (lees: provinciegrenzen). Het gebied is sterk nodaal afgebakend." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stadsgewest Utrecht" ;
            sgpl:text_context "Het leek derhalve niet zinvol op dat moment dieper in te gaan op de mogelijkheden tot een zeer ingrijpende samenwerking, die bij een intergemeentelijk structuurplan noodzakelijk is. Het doel en de doelstellingen werden daarom in de loop van het onderzoek zodanig bijgesteld, dat het eindrapport nu de ondertitel draagt: \"Mogelijkheden voor coördinatie op het gebied van de ruimtelijke ordening in het stadsgewest Utrecht\". In deze scriptie is geprobeerd aspecten met betrekking tot de ruimtelijke ordening uit de intergemeentelijke samenwerking te lichten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "Midden Utrecht" ;
            sgpl:text_context "Voor de afbakening van het onderzoeksgebied is aansluiting ge- zocht bij een bestaand beeld van het stadsgewest Utrecht. Gekozen is voor het gebied dat overeenkomt met hetstreekplandeelgebied \"Midden Utrecht\" zoals omschreven in het voorontwerp streekplan Utrecht van mei 1984. Op basis van woon/werkrelaties, voorzieningenoriëntaties en openbaar vervoersverbindingen komt de provincie tot een stadsgewest waartoe de volgende gemeenten worden gerekend: Utrecht, Maarssen, Maartensdijk, De Bilt, Zeist, Bunnik, Houten, Nieuwegein, IJsselstein, Vleuten-De Meern en Harmelen (voorontwerp streekplan p.9)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1843 ;
            sgpl:subjectText "agglomeratieproblematiek" ;
            sgpl:text_context "Van Ruller (p. 227) noemt deze agglomeratieproblemen. Drie typen, tevens fasen in de ontwikkeling van de agglomeratieproblematiek worden door zowel van Ruller (p. 119-123) als Brasz (p- 18-19) onderscheiden. Deze zijn achtereenvolgens de randproblematiek, de expansieproblematiek en de structuurproblematiek." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "ruimtelijke ordening" ;
            sgpl:text_context "De kernstad zal dan welllicht in grote problemen komen. Samenwerking op het gebied van de ruimtelijke ordening, een regionaal beleid van onderop, werd daarom in het belang van alle agglomeratie-gemeenten noodzakelijk geacht. Willen gemeenten echter tot de intentie komen om het probleem aan te pakken, dan is daarvoor meer nodig." ],
        [ sgpl:refersToConcept unesco:concept6587 ;
            sgpl:subjectText "intergemeentelijke samenwerking" ;
            sgpl:text_context "Het doel en de doelstellingen werden daarom in de loop van het onderzoek zodanig bijgesteld, dat het eindrapport nu de ondertitel draagt: \"Mogelijkheden voor coördinatie op het gebied van de ruimtelijke ordening in het stadsgewest Utrecht\". In deze scriptie is geprobeerd aspecten met betrekking tot de ruimtelijke ordening uit de intergemeentelijke samenwerking te lichten. Daartoe werden gesprekken gevoerd met ambtenaren van r.o. van alle gemeenten in het onderzoeksgebied." ],
        [ sgpl:refersToConcept unesco:concept1843 ;
            sgpl:subjectText "agglomeratieproblematiek" ;
            sgpl:text_context "Van Ruller (p. 227) noemt deze agglomeratieproblemen. Drie typen, tevens fasen in de ontwikkeling van de agglomeratieproblematiek worden door zowel van Ruller (p. 119-123) als Brasz (p- 18-19) onderscheiden. Deze zijn achtereenvolgens de randproblematiek, de expansieproblematiek en de structuurproblematiek." ],
        [ sgpl:refersToConcept unesco:concept6587 ;
            sgpl:subjectText "intergemeentelijke samenwerking" ;
            sgpl:text_context "Het doel en de doelstellingen werden daarom in de loop van het onderzoek zodanig bijgesteld, dat het eindrapport nu de ondertitel draagt: \"Mogelijkheden voor coördinatie op het gebied van de ruimtelijke ordening in het stadsgewest Utrecht\". In deze scriptie is geprobeerd aspecten met betrekking tot de ruimtelijke ordening uit de intergemeentelijke samenwerking te lichten. Daartoe werden gesprekken gevoerd met ambtenaren van r.o. van alle gemeenten in het onderzoeksgebied." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "ruimtelijke ordening" ;
            sgpl:text_context "De kernstad zal dan welllicht in grote problemen komen. Samenwerking op het gebied van de ruimtelijke ordening, een regionaal beleid van onderop, werd daarom in het belang van alle agglomeratie-gemeenten noodzakelijk geacht. Willen gemeenten echter tot de intentie komen om het probleem aan te pakken, dan is daarvoor meer nodig." ] ;
    sgpl:thesisID 162 .

sgpl:Thesis163 a sgpl:SGPLThesis ;
    dcterms:creator "Margot Klute" ;
    dcterms:issued 1987 ;
    dcterms:title "Een aanzet tot diskussie over de vraag of het verschil maakt om als man of als vrouw het ontwikkelingswerk en het leven met een vaste partner met elkaar te kombineren",
        "ONTWIKKELINGSWERK EN PRIVELEVEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2460596 ;
            sgpl:spatialText "hoofdstad Bamako" ;
            sgpl:text_context "Mijn veldwerk van zes maanden ontrolde zich in Mali, waar ik een onderzoek deed naar de migratie van mannen en vrouwen naar de hoofdstad Bamako. Tijdens dat verblijf in Mali (West Afrika), wonend in Bamako nabij het veldkantoor van de Stichting Nederlandse Vrijwilligers (SNV), maakte ik kennis met diverse ontwikkelingswerkers in dienst van DGIS en SNV. Het trof me hoe groot de invloed was van het langdurig verblijven in een Derde Wereldland, in dit geval Mali, op het privé-leven van deze mensen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2452655 ;
            sgpl:spatialText "landbouwprojekt in Niono" ;
            sgpl:text_context "Ook de partners en kinderen. Op een grootschalig landbouwprojekt in Niono overviel me dit gevoel van beklemming, te weinig afstand tussen privé en werk, het sterkst. Wonen met twee-en-dertig Nederlanders (achttien volwassenen en veertien kinderen) op een kluitje, elkaar konstant zien en meemaken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745088 ;
            sgpl:spatialText "Wageningen" ;
            sgpl:text_context "Het bijvak luidt Niet Westerse Sociologie, in het bijzonder de positie van de vrouw in ontwikkelingslanden. Het wordt gedoceerd aan de Landbouw Hogeschool in Wageningen (sinds kort de landbouwuniversiteit). In dit geval wordt niet de positie van vrouwen in ontwikkelingslanden nader belicht, maar de positie van Nederlandse vrouwen die willen werken in ontwikkelingslanden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751385 ;
            sgpl:spatialText "Lunteren" ;
            sgpl:text_context "Verder mijn huisgenoten op de Johan de Wittstraat, omdat zij heerlijk blijven koken ook al verzuim ik soms die taak, omdat ze regelmatig dingen van mij onder de neus gedrukt krijgen en omdat ze vele telefoontjes in ontvangst nemen als ik afwezig ben. Tenslotte, de familie van de Bosch in Lunteren, want bij hen ben ik een week lang in de watten gelegd toen ik met de uitwerking van de interviews worstelde. Jullie allemaal, hartelijk dank." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Vrouwen worden daartoe vergeleken met mannen. Op dit moment wordt in Nederland door de overheid een positief discriminatiebeleid gevoerd ten aanzien van vrouwen. Dit houdt in dat wanneer vrouwen en mannen op dezelfde baan solliciteren, bij gelijke geschiktheid de voorkeur wordt gegeven aan een vrouw." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2361809 ;
            sgpl:spatialText "Burkina Faso" ;
            sgpl:text_context "SAMEN WERK OP EEN KONTRAKT. In augustus worden wij uitgezonden door SNV naar Burkina Faso en gaan daar werken in een streekonwikkelingsprojekt. Binnen het projekt vullen we de funktie elk voor de helft in, Marleen als voorlichtingskundige en ik als landbouwkundige." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Want die groep mensen kan het meest belang hebben bij de informatie die wordt geboden. Het kader waarin de skriptie is geschreven, is als driemaands bijvak van de afstudeerrichting Sociale Geografie van Ontwikkelingslanden (SGO) aan de Rijksuniversiteit te Utrecht. Het bijvak luidt Niet Westerse Sociologie, in het bijzonder de positie van de vrouw in ontwikkelingslanden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255146 ;
            sgpl:spatialText "Afrika" ;
            sgpl:text_context "Ook mijn gunstige herinneringen aan verblijven in Afrika en Zuid-Amerika deelden mee in het positieve besluit richting SGO. Tegelijkertijd wilde ik zoveel mogelijk loopbaan-perspektieven openhouden: ontwikkelingswerk, onderzoek, onderwijs. Tenslotte speelde het gevoel dat ik nu nog jong ben me parten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255150 ;
            sgpl:spatialText "Zuid-Amerika" ;
            sgpl:text_context "Ook mijn gunstige herinneringen aan verblijven in Afrika en Zuid-Amerika deelden mee in het positieve besluit richting SGO. Tegelijkertijd wilde ik zoveel mogelijk loopbaan-perspektieven openhouden: ontwikkelingswerk, onderzoek, onderwijs. Tenslotte speelde het gevoel dat ik nu nog jong ben me parten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2453866 ;
            sgpl:spatialText "Mali" ;
            sgpl:text_context "Veel konkreter dan dat reikte dat vermoeden toen niet. Mijn veldwerk van zes maanden ontrolde zich in Mali, waar ik een onderzoek deed naar de migratie van mannen en vrouwen naar de hoofdstad Bamako. Tijdens dat verblijf in Mali (West Afrika), wonend in Bamako nabij het veldkantoor van de Stichting Nederlandse Vrijwilligers (SNV), maakte ik kennis met diverse ontwikkelingswerkers in dienst van DGIS en SNV." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept594 ;
            sgpl:subjectText "ontwikkelingswerk" ;
            sgpl:text_context "Zij maakten deel uit van het werk; juist ook van het welbevinden van de ontwikkelingswerker. Iedereen sprak over ontwikkelingswerk en iedereen zat in het ontwikkelingswerk. Ook de partners en kinderen." ],
        [ sgpl:refersToConcept unesco:concept8557 ;
            sgpl:subjectText "twee-carrière partnerschap" ;
            sgpl:text_context "De moeite met het loskomen van deze eigen socialisatie en het zoeken naar nieuwe omgangsvormen is de taak waar hedendaagse mannen en vrouwen, met name wanneer zij eikaars partners zijn, voor staan. Over het partnerschap met twee carrières en de problemen die dat oplevert op het moment dat overplaatsing, ofwel uit elkaar plaatsing van beide partners zich voordoet zijn al diverse studies verschenen. Hoe ontwikkelt dit fenomeen zich nu als één van beide partners het plan heeft en er reëel naar toewerkt duurzaam uitgezonden te worden." ],
        [ sgpl:refersToConcept unesco:concept4813 ;
            sgpl:subjectText "vaste partner" ;
            sgpl:text_context "In dit onderzoek wordt echter maar één bepaald gebied van het privéleven bekeken. De aandacht wordt specifiek gericht op het hebben van en het streven naar een relatie met één vaste partner. De invloed die deze speciale relatie enerzijds kan ondervinden en anderzijds kan uitoefenen op het besluit om in een Derde Wereldland te werken vormt het onderwerp van deze skriptie." ],
        [ sgpl:refersToConcept unesco:concept8557 ;
            sgpl:subjectText "twee-carrière partnerschap" ;
            sgpl:text_context "De moeite met het loskomen van deze eigen socialisatie en het zoeken naar nieuwe omgangsvormen is de taak waar hedendaagse mannen en vrouwen, met name wanneer zij eikaars partners zijn, voor staan. Over het partnerschap met twee carrières en de problemen die dat oplevert op het moment dat overplaatsing, ofwel uit elkaar plaatsing van beide partners zich voordoet zijn al diverse studies verschenen. Hoe ontwikkelt dit fenomeen zich nu als één van beide partners het plan heeft en er reëel naar toewerkt duurzaam uitgezonden te worden." ],
        [ sgpl:refersToConcept unesco:concept594 ;
            sgpl:subjectText "ontwikkelingswerk" ;
            sgpl:text_context "Zij maakten deel uit van het werk; juist ook van het welbevinden van de ontwikkelingswerker. Iedereen sprak over ontwikkelingswerk en iedereen zat in het ontwikkelingswerk. Ook de partners en kinderen." ],
        [ sgpl:refersToConcept unesco:concept4813 ;
            sgpl:subjectText "vaste partner" ;
            sgpl:text_context "In dit onderzoek wordt echter maar één bepaald gebied van het privéleven bekeken. De aandacht wordt specifiek gericht op het hebben van en het streven naar een relatie met één vaste partner. De invloed die deze speciale relatie enerzijds kan ondervinden en anderzijds kan uitoefenen op het besluit om in een Derde Wereldland te werken vormt het onderwerp van deze skriptie." ] ;
    sgpl:thesisID 163 .

sgpl:Thesis164 a sgpl:SGPLThesis ;
    dcterms:creator "Jeanet Kullberg" ;
    dcterms:issued 1987 ;
    dcterms:title "Bolsward",
        "ontstaansgeschiedenis en ruimtelijke ontwikkeling" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Omstreeks 1380 kreeg Bolsward, volgens de Atlas van Historische Vestingwerken in Nederland, haar eerste versterking, een stenen ommuring. Over het trajekt zijn geen gegevens voor handen. De tweede omwalling dateert, volgens dezelfde bron, uit 1524." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Friesland" ;
            sgpl:text_context "Rond 200 voor Chr. breidde de bewoning zich uit en bij het begin van de jaartelling was centraal Westergo, samen met de streek rond Leeuwarden en noordelijk Oostergo, het dichtst bevolkt binnen Friesland. Tijdens de laat-Romeinse transgressie van ca. 250-600 na Chr., liep de bewoning terug. Onbekend is in hoeverre naast de verslechterde milieukondities, sociaal-ekonomische faktoren hiertoe bijdroegen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756759 ;
            sgpl:spatialText "Dokkum" ;
            sgpl:text_context "De aanwezigheid van twee, mogelijk zelfs drie terpen, heeft een belangrijke rol gespeeld bij de ruimtelijke ontwikkeling van Bolsward. Door de ligging van de terpen en de ruimtelijke inrichting ervan, is in een vroeg stadium een aanzienlijk deel van de latere plattegrond vastgelegd. Om die redenen wordt de stad, evenals Leeuwarden en Dokkum, wel tot het type der terpsteden gerekend." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758682 ;
            sgpl:spatialText "Bolsward" ;
            sgpl:text_context "\"Bolsward, ontstaansgeschiedenis en ruimtelijke ontwikkeling\", is in opdracht van de Rijksdienst voor de Monumentenzorg samengesteld, in het kader van de aanwijzing van de stad Bolsward als beschermd stadsgezicht. Doel van dit onderzoek was om zicht te krijgen op de historische en stedebouwkundige waarden van de stad. De plattegrond en de bebouwing zoals die er tegenwoordig uitzien, vormen het uitgangspunt bij het beschrijven van de geschiedenis." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744743 ;
            sgpl:spatialText "Westergo" ;
            sgpl:text_context "Daar werden onder de huidige Martinikerk de fundamenten van een Romaans, tufstenen kerkje gevonden, van omstreeks de lie eeuw. Het kerkje was opvallend klein voor het middelpunt van het dekanaat Westergo. Bolsward was tot in de loop van de 13e eeuw hoofd van het dekanaat Westergo, totdat deze funktie in 1329 gedeeld werd met Franeker." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Noorder Haaitzebuurt" ;
            sgpl:text_context "In de 33 jaar tussen 1798 en 1831, is het aandeel katholieken in wijk A gedaald en in wijk D toegenomen. In de Noorder en Zuider Haaitzebuurt (wijk D en E), waarin de Martini- en Broerekerk liggen, bestaat ongeveer driekwart van de bewoners uit hervormden. In de overige wijken is dat ruim de helft." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751792 ;
            sgpl:spatialText "Leeuwarden" ;
            sgpl:text_context "De aanwezigheid van twee, mogelijk zelfs drie terpen, heeft een belangrijke rol gespeeld bij de ruimtelijke ontwikkeling van Bolsward. Door de ligging van de terpen en de ruimtelijke inrichting ervan, is in een vroeg stadium een aanzienlijk deel van de latere plattegrond vastgelegd. Om die redenen wordt de stad, evenals Leeuwarden en Dokkum, wel tot het type der terpsteden gerekend." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758682 ;
            sgpl:spatialText "de huidige binnenstad" ;
            sgpl:text_context "In ruimtelijk opzicht gold in principe de beperking tot de huidige binnenstad, het gedeelte binnen de omgrachting, omdat daar de grens van het te beschermen gebied ligt. Niettemin krijgen ook enkele laat-19e-eeuwse uitbreidingen buiten de grachten de aandacht, omdat ze stedebouwkundig fraaie elementen vormen. De beschreven periode beslaat de hele wordingsgeschiedenis van de stad, vanaf de eerste bewoning, die van voor de jaartelling dateert, tot het heden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "De voor U liggende scriptie over Bolsward werd vervaardigd in het kader van de doktoraalopleiding historische geografie aan de Rijksuniversiteit Utrecht. Het betoog werd geschreven in opdracht van de Rijksdienst voor de Monumentenzorg, waar ik enkele maanden in stageverband mocht werken. Graag wil ik de heren Hans Harten en Lammert Prins van respektievelijk de R.U. en de R.D.M.Z., hartelijk bedanken voor hun enthousiaste begeleiding." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755249,
                geonames:2755812 ;
            sgpl:spatialText "Fries-Groningse terpengebied" ;
            sgpl:text_context "Om de terpen van Bolsward in een ruimer kader te kunnen plaatsen, volgt eerst een algemene inleiding over het Fries-Groningse terpengebied en de diverse typen terpen die in de literatuur onderscheiden worden. Terpen zijn door de mens opgeworpen heuvels die bescherming moesten bieden tegen periodieke overstromingen in de tijd dat daartoe nog geen dijken waren aangelegd. Voor het Fries-Groningse terpengebied gaat het dan om de periode vanaf de vroege ijzertijd (ca. 600 voor Chr.) tot de late Middeleeuwen (ca. 1200 na Chr.), een periode die wordt aangeduid als 'de terpentijd'." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept448 ;
            sgpl:subjectText "stadsontwikkeling" ;
            sgpl:text_context "De muntvondsten geven daarom wel een beeld van de Friese handel en het lokale marktverkeer maar niet van het aantal kooplieden dat in de verschillende marktplaatsen woonde. Een niet eenduidig beantwoorde vraag is wat de motor voor stadsontwikkeling was. De vraag is of de niet-agrarische beroepsbevolking bestond uit kooplieden die handel over grote afstand bedreven, uit handelaren met een regionaal verzorgende funktie of uit beide." ],
        [ sgpl:refersToConcept unesco:concept17072 ;
            sgpl:subjectText "terpen" ;
            sgpl:text_context "De aanwezigheid van twee, mogelijk zelfs drie terpen, heeft een belangrijke rol gespeeld bij de ruimtelijke ontwikkeling van Bolsward. Door de ligging van de terpen en de ruimtelijke inrichting ervan, is in een vroeg stadium een aanzienlijk deel van de latere plattegrond vastgelegd. Om die redenen wordt de stad, evenals Leeuwarden en Dokkum, wel tot het type der terpsteden gerekend." ],
        [ sgpl:refersToConcept unesco:concept5706 ;
            sgpl:subjectText "handelsfunktie" ;
            sgpl:text_context "Staveren is geen terpnederzetting maar wel een belangrijke handelsplaats, gelegen aan een zijrivier van het Vlie (de kustlijn lag destijds verder westwaarts dan tegenwoordig). De vroege handelsfunktie van Bolsward, Dokkum en Leeuwarden, wordt niet alleen aannemelijk door de struktuur van de terp en de gunstige ligging aan vaarwegen; op lle-eeuwse munten, die vooral in Skandinavie en het Oostzeegebied gevonden werden, staan de namen van deze plaatsen, alsook die van Staveren, afgebeeld. De meeste van de gevonden munten zijn afkomstig uit Dokkum, Leeuwarden en Staveren." ],
        [ sgpl:refersToConcept unesco:concept5706 ;
            sgpl:subjectText "handelsfunktie" ;
            sgpl:text_context "Staveren is geen terpnederzetting maar wel een belangrijke handelsplaats, gelegen aan een zijrivier van het Vlie (de kustlijn lag destijds verder westwaarts dan tegenwoordig). De vroege handelsfunktie van Bolsward, Dokkum en Leeuwarden, wordt niet alleen aannemelijk door de struktuur van de terp en de gunstige ligging aan vaarwegen; op lle-eeuwse munten, die vooral in Skandinavie en het Oostzeegebied gevonden werden, staan de namen van deze plaatsen, alsook die van Staveren, afgebeeld. De meeste van de gevonden munten zijn afkomstig uit Dokkum, Leeuwarden en Staveren." ],
        [ sgpl:refersToConcept unesco:concept17072 ;
            sgpl:subjectText "terpen" ;
            sgpl:text_context "De aanwezigheid van twee, mogelijk zelfs drie terpen, heeft een belangrijke rol gespeeld bij de ruimtelijke ontwikkeling van Bolsward. Door de ligging van de terpen en de ruimtelijke inrichting ervan, is in een vroeg stadium een aanzienlijk deel van de latere plattegrond vastgelegd. Om die redenen wordt de stad, evenals Leeuwarden en Dokkum, wel tot het type der terpsteden gerekend." ],
        [ sgpl:refersToConcept unesco:concept448 ;
            sgpl:subjectText "stadsontwikkeling" ;
            sgpl:text_context "De muntvondsten geven daarom wel een beeld van de Friese handel en het lokale marktverkeer maar niet van het aantal kooplieden dat in de verschillende marktplaatsen woonde. Een niet eenduidig beantwoorde vraag is wat de motor voor stadsontwikkeling was. De vraag is of de niet-agrarische beroepsbevolking bestond uit kooplieden die handel over grote afstand bedreven, uit handelaren met een regionaal verzorgende funktie of uit beide." ] ;
    sgpl:thesisID 164 .

sgpl:Thesis165 a sgpl:SGPLThesis ;
    dcterms:creator "ANJA VAN LEEUWEN" ;
    dcterms:issued 1987 ;
    dcterms:title "APPARTEMENTENSPLITSING EN LEEGSTAND",
        "EEN ONDERZOEK NAAR DE LANGDURIGE LEEGSTAND VAN VOOROORLOGSE APPARTEMENTEN IN ROTTERDAM" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Dit rapport werd geschreven als doctoraalscriptie ter afsluiting van mijn studie Sociale Geografie aan het Geografisch Instituut van de Rijksuniversiteit Utrecht. Het onderzoek is verricht in het kader van een stage bij de afdeling Onderzoek van de Dienst Volkshuisvesting van de gemeente Rotterdam. Mijn dank gaat uit naar Drs. Jan van Weesep en Ir. Elbert Raadsen voor hun deskundige begeleiding en steun." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Tarwewijk" ;
            sgpl:text_context "Op 1 oktober 1986 stonden van deze categorie in het onderzoeksgebied 811 appartementen leeg, dit is 4,9%. Wijken met een hoog aantal leegstaande appartementen zijn: de Tarwewijk, Bergpolder en Blijdorp. De eigenaren van de woningen waren voor 30% eigenaar-bewoners, 1% was in handen van institutionele beleggers, 24% van B.V.'s en 45% van 'andere natuurlijke personen', 70% was dus een voormalige huurwoning." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Bekend is dat op 1 april 1986, 27% van de totale leegstand in de vier grote gemeenten Amsterdam, Rotterdam, Den Haag en Utrecht was gesitueerd, terwijl hun aandeel in de woningvoorraad slechts 16,% bedraagt (Maandstatistiek Bouwnijverheid, 1987). De leegstand in woningen die reeds eerder bewoond zijn geweest is in deze vier steden groot. Dertig procent van de totale omvang van deze vorm van leegstand treft men hier aan, voornamelijk in de vooroorlogse wijken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "1.1 Leegstandsbegrippen en -vormen 8. 1.2 De leegstand in Nederland vanaf de Tweede Wereldoorlog 10. 1.3 Het appartementsrecht H 1.4 De appartementensector in Nederland 12." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "APPARTEMENTENSPLITSING EN LEEGSTAND. EEN ONDERZOEK NAAR DE LANGDURIGE LEEGSTAND VAN VOOROORLOGSE APPARTEMENTEN IN ROTTERDAM. ANJA VAN LEEUWEN JULI 1987." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Blijdorp" ;
            sgpl:text_context "Op 1 oktober 1986 stonden van deze categorie in het onderzoeksgebied 811 appartementen leeg, dit is 4,9%. Wijken met een hoog aantal leegstaande appartementen zijn: de Tarwewijk, Bergpolder en Blijdorp. De eigenaren van de woningen waren voor 30% eigenaar-bewoners, 1% was in handen van institutionele beleggers, 24% van B.V.'s en 45% van 'andere natuurlijke personen', 70% was dus een voormalige huurwoning." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Bergpolder" ;
            sgpl:text_context "Op 1 oktober 1986 stonden van deze categorie in het onderzoeksgebied 811 appartementen leeg, dit is 4,9%. Wijken met een hoog aantal leegstaande appartementen zijn: de Tarwewijk, Bergpolder en Blijdorp. De eigenaren van de woningen waren voor 30% eigenaar-bewoners, 1% was in handen van institutionele beleggers, 24% van B.V.'s en 45% van 'andere natuurlijke personen', 70% was dus een voormalige huurwoning." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "gemeente Rotterdam" ;
            sgpl:text_context "Het onderzoek is verricht in het kader van een stage bij de afdeling Onderzoek van de Dienst Volkshuisvesting van de gemeente Rotterdam. Mijn dank gaat uit naar Drs. Jan van Weesep en Ir. Elbert Raadsen voor hun deskundige begeleiding en steun. Tevens wil ik alle medewerkers van de afdeling Onderzoek bedanken die altijd weer de tijd vonden om mij met raad en daad bij te staan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "de tweede en derde Ring" ;
            sgpl:text_context "De aanleiding om de leegstand van vooroorlogse appartementen aan een nader onderzoek te onderwerpen was het hoge leegstandspercentage in de tweede en derde Ring. In eerdere leegstandsonderzoeken werd geconcludeerd dat vooral in de appartementensector de leegstand verontrustende vormen aannam, met name van woningen in particulier eigendom. Deze leegstand zou gedeeltelijk speculatief van aard zijn." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept678 ;
            sgpl:subjectText "Langdurige leegstand" ;
            sgpl:text_context "Verder behoren leegstaande slooppanden en de stadsvernieuwingsleegstand tot de categorie 'onvermijdbaar'. De te vermijden leegstand, ofwel langdurige leegstand van vier maanden of langer, is onder te verdelen in verborgen, speculatieve en discrepantieleegstand. Deze laatste vorm is het gevolg van het niet op elkaar aansluiten van vraag en aanbod op de woningmarkt." ],
        [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "Appartementensplitsing" ;
            sgpl:text_context "Het is dan in principe mogelijk een pand met meerdere woningen per appartement te verkopen, de zogenaamde horizontale verkoop. Appartementensplitsing en horizontale verkoop komt zowel bij nieuwbouw voor, waarbij de splitsing en de verkoop doorgaans direkt na de bouw worden geregeld, als bij bestaande bouw, waarbij het dan meestal gaat om verhuurde woningen. In verband met de gemeenschappelijke ruimten en bouwdelen is in 1972 wettelijk geregeld dat de appartementeneigenaars een vereniging vormen." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "Horizontale verkoop" ;
            sgpl:text_context "Vanaf 1969 werd door het opheffen van een aantal beperkingen de toegang tot de particuliere woningmarkt makkelijker. Bepaalde omstandigheden aan vraag- en aanbodzijde werkten een stijging van horizontale verkoop in de hand. Aan de aanbodzijde bijvoorbeeld speelden bepaalde marktregulerende maatregelen zoals huurprijsbinding een rol." ],
        [ sgpl:refersToConcept unesco:concept678 ;
            sgpl:subjectText "Langdurige leegstand" ;
            sgpl:text_context "Verder behoren leegstaande slooppanden en de stadsvernieuwingsleegstand tot de categorie 'onvermijdbaar'. De te vermijden leegstand, ofwel langdurige leegstand van vier maanden of langer, is onder te verdelen in verborgen, speculatieve en discrepantieleegstand. Deze laatste vorm is het gevolg van het niet op elkaar aansluiten van vraag en aanbod op de woningmarkt." ],
        [ sgpl:refersToConcept unesco:concept2712 ;
            sgpl:subjectText "Appartementensplitsing" ;
            sgpl:text_context "Het is dan in principe mogelijk een pand met meerdere woningen per appartement te verkopen, de zogenaamde horizontale verkoop. Appartementensplitsing en horizontale verkoop komt zowel bij nieuwbouw voor, waarbij de splitsing en de verkoop doorgaans direkt na de bouw worden geregeld, als bij bestaande bouw, waarbij het dan meestal gaat om verhuurde woningen. In verband met de gemeenschappelijke ruimten en bouwdelen is in 1972 wettelijk geregeld dat de appartementeneigenaars een vereniging vormen." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "Horizontale verkoop" ;
            sgpl:text_context "Vanaf 1969 werd door het opheffen van een aantal beperkingen de toegang tot de particuliere woningmarkt makkelijker. Bepaalde omstandigheden aan vraag- en aanbodzijde werkten een stijging van horizontale verkoop in de hand. Aan de aanbodzijde bijvoorbeeld speelden bepaalde marktregulerende maatregelen zoals huurprijsbinding een rol." ] ;
    sgpl:thesisID 165 .

sgpl:Thesis166 a sgpl:SGPLThesis ;
    dcterms:creator "A.H. Zandee",
        "C.M.L. Mouwens" ;
    dcterms:issued 1987 ;
    dcterms:title "Een onderzoek naar de ontwikkelingsaspecten van Teleport Office park te Amsterdam",
        "Teleport Amsterdam" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747129 ;
            sgpl:spatialText "Sloterdijk" ;
            sgpl:text_context "Hiermee tracht men de internationale concurrentiepositie veilig te stellen. Een ander voorbeeld hiervan is Teleport Amsterdam, met als kloppend hart Teleport Office Park (T.O.P.) te Sloterdijk. Het project is een samenwerkingsverband van de gemeente Amsterdam, de Vastgoed Ontwikkelingsmaatschappij (V.O.M.) en de P.T.T.." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:5125771 ;
            sgpl:spatialText "Manhattan" ;
            sgpl:text_context "Het telecommuniceren via een eigen netwerk i.p.v. via het netwerk van de lokale B.O.C. is sindsdien bekend geworden als 'bypassing'. Een voorbeeld van een dergelijke ontwikkeling vinden we in Manhattan, waar vele kantoren ertoe overgingen een schotel op het dak te plaatsen. Dit leidde echter al snel tot problemen; de diverse micro-golf signalen kruisten elkaar waardoor vervorming van de berichtgeving optrad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "de vier grote steden van Nederland" ;
            sgpl:text_context "Utrecht.augustus '87 Rijksuniversiteit Utrecht Vakgroep stadsstudies Heidelberglaan 2 Onder leiding van prof. dr. A.M.J. Kreukels is bij de vakgroep Stadsstudies van de Rijksuniversiteit Utrecht in september 1983 de projectgroep \"de vier grote steden\" opgericht. Doel van de projectgroep is recente ontwikkelingen in de ruimtelijke planning van de vier grote steden de bestuderen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Om de toepassingen van telematica tot ontwikkeling te doen komen zijn echter grootscheepse investeringen in de telecommunicatie-infrastructuur nodig, waarbij vele belangen gemoeid zijn. In dit kader zijn in Nederland diverse telematica-projecten gestart, zoals bijvoorbeel Cargonaut op Schiphol en Intis in de Rotterdamse haven. Beide projecten hebben ten doel resp. het luchtvaart- en scheepvaarttransport sneller (en dus goedkoper) te doen verlopen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdamse regio" ;
            sgpl:text_context "In hoofdstuk 4 zal ingegaan worden op het belang van telematica voor het bedrijfsleven en de gevolgen hiervan voor het beleid. In aansluiting hierop zal ingegaan worden op de economische structuur van de Amsterdamse regio. In hoofdstuk 5 wordt de focus verkleind tot Teleport Amsterdam en zullen achtereenvolgens het projectverloop, de planinhoud en het theoretisch kader aan de orde komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "westelijk havengebied van Amsterdam" ;
            sgpl:text_context "Goede telecommunicatieve voorzieningen zijn voor het bedrijfsleven van groot belang voor de bedrijfsvoering. Een bewijs hiervan is o.a. de telex die bedrijven in het westelijk havengebied van Amsterdam onlangs aan minister Smit-Kroes van Verkeer en Waterstaat hebben gestuurd n.a.v. het feit dat ze telefonisch practisch onbereikbaar waren. Ook automatisering is van groot belang voor de bedrijfsvoering; het gaat erom of de organisatie m.b.v. geavanceerde informatiesystemen haar concurrentiepositie kan versterken en of zij leveranciers en afnemers kan binden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Teleport Office Park" ;
            sgpl:text_context "Hiermee tracht men de internationale concurrentiepositie veilig te stellen. Een ander voorbeeld hiervan is Teleport Amsterdam, met als kloppend hart Teleport Office Park (T.O.P.) te Sloterdijk. Het project is een samenwerkingsverband van de gemeente Amsterdam, de Vastgoed Ontwikkelingsmaatschappij (V.O.M.) en de P.T.T.." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Teleport Amsterdam" ;
            sgpl:text_context "Hiermee tracht men de internationale concurrentiepositie veilig te stellen. Een ander voorbeeld hiervan is Teleport Amsterdam, met als kloppend hart Teleport Office Park (T.O.P.) te Sloterdijk. Het project is een samenwerkingsverband van de gemeente Amsterdam, de Vastgoed Ontwikkelingsmaatschappij (V.O.M.) en de P.T.T.." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "In dit kader zijn in Nederland diverse telematica-projecten gestart, zoals bijvoorbeel Cargonaut op Schiphol en Intis in de Rotterdamse haven. Beide projecten hebben ten doel resp. het luchtvaart- en scheepvaarttransport sneller (en dus goedkoper) te doen verlopen. Hiermee tracht men de internationale concurrentiepositie veilig te stellen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Dankzij hun bereidwillige medewerking hebben wij ruim 400 bedrijven in de regio Amsterdam een enquete toe kunnen zenden. Utrecht, augustus 1987 Caroline Mouwens Rianne Zandee 1: INLEIDING. De laatste decennia is het werken met informatie steeds belangrijker geworden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747890 ;
            sgpl:spatialText "Rotterdamse haven" ;
            sgpl:text_context "In dit kader zijn in Nederland diverse telematica-projecten gestart, zoals bijvoorbeel Cargonaut op Schiphol en Intis in de Rotterdamse haven. Beide projecten hebben ten doel resp. het luchtvaart- en scheepvaarttransport sneller (en dus goedkoper) te doen verlopen. Hiermee tracht men de internationale concurrentiepositie veilig te stellen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept522 ;
            sgpl:subjectText "Teleportconcept" ;
            sgpl:text_context "In de nu volgende paragrafen zal uiteengezet worden hoe en waarom teleports zijn ontstaan en op welke manier het teleport-concept zich ontwikkeld heeft. Het ontstaan van teleports moet geheel en al geplaatst worden binnen de Amerikaanse context. Drie oorzaken kunnen worden aangegeven voor het ontstaan en de snelle groei van het aantal teleports in de V.S.: 1. de hoge kosten van (met name het lange afstands-) telefoonverkeer, als gevolg van een snel groeiende vraag 2. de groeiende beschikbaarheid van communicatie-satellieten 3. het uiteenvallen van AT&T in diverse Bell Operating Companies (B.O.C.'s) in 1982." ],
        [ sgpl:refersToConcept unesco:concept5824 ;
            sgpl:subjectText "Telematica" ;
            sgpl:text_context "Een belangrijke ontwikkeling bij de groei naar een informatiemaatschappij is de integratie van informatieverwerking met behulp van computers en informatietransport met behulp van telecommunicatie. Dit samengaan van computers en telecommunicatie noemt men TELEMATICA. Van de toepassingen van telematica wordt veel verwacht." ],
        [ sgpl:refersToConcept unesco:concept2708 ;
            sgpl:subjectText "Intelligente gebouwen" ;
            sgpl:text_context "De ontwikkeling van vastgoedprojecten als onderdeel van teleports hangt nauw samen met de ontwikkeling van 'smart buildings', de zgn. intelligente gebouwen. Een intelligent gebouw wordt wel omschreven als een \"zelfdenkend gebouw, dat met computers en electronische systemen als hersenen en zenuwgestel efficiënte beslissingen kan nemen die de operationele- en beheerskosten kunnen reduceren en de arbeidsproductiviteit kunnen verhogen\" (Dubbs: 1985, p.190). Enkele voorbeelden hiervan zijn: -bewakings- en toerekeningssystemen voor telecommunicatie, gebouwenautomatisering enz." ],
        [ sgpl:refersToConcept unesco:concept522 ;
            sgpl:subjectText "Teleportconcept" ;
            sgpl:text_context "In de nu volgende paragrafen zal uiteengezet worden hoe en waarom teleports zijn ontstaan en op welke manier het teleport-concept zich ontwikkeld heeft. Het ontstaan van teleports moet geheel en al geplaatst worden binnen de Amerikaanse context. Drie oorzaken kunnen worden aangegeven voor het ontstaan en de snelle groei van het aantal teleports in de V.S.: 1. de hoge kosten van (met name het lange afstands-) telefoonverkeer, als gevolg van een snel groeiende vraag 2. de groeiende beschikbaarheid van communicatie-satellieten 3. het uiteenvallen van AT&T in diverse Bell Operating Companies (B.O.C.'s) in 1982." ],
        [ sgpl:refersToConcept unesco:concept2708 ;
            sgpl:subjectText "Intelligente gebouwen" ;
            sgpl:text_context "De ontwikkeling van vastgoedprojecten als onderdeel van teleports hangt nauw samen met de ontwikkeling van 'smart buildings', de zgn. intelligente gebouwen. Een intelligent gebouw wordt wel omschreven als een \"zelfdenkend gebouw, dat met computers en electronische systemen als hersenen en zenuwgestel efficiënte beslissingen kan nemen die de operationele- en beheerskosten kunnen reduceren en de arbeidsproductiviteit kunnen verhogen\" (Dubbs: 1985, p.190). Enkele voorbeelden hiervan zijn: -bewakings- en toerekeningssystemen voor telecommunicatie, gebouwenautomatisering enz." ],
        [ sgpl:refersToConcept unesco:concept5824 ;
            sgpl:subjectText "Telematica" ;
            sgpl:text_context "Een belangrijke ontwikkeling bij de groei naar een informatiemaatschappij is de integratie van informatieverwerking met behulp van computers en informatietransport met behulp van telecommunicatie. Dit samengaan van computers en telecommunicatie noemt men TELEMATICA. Van de toepassingen van telematica wordt veel verwacht." ] ;
    sgpl:thesisID 166 .

sgpl:Thesis167 a sgpl:SGPLThesis ;
    dcterms:creator "Josefine Oberhausen" ;
    dcterms:issued 1987 ;
    dcterms:title "Een kwantitatieve benadering voor de praktijk",
        "VESTIGINGSPLAATSONDERZOEK VOOR DE DETAILHANDEL" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het uitgangspunt voor dit onderzoek is het feit dat vestigings-plaatsonderzoek voor de detailhandel in toenemende mate een cruciale positie inneemt binnen het bedrijfsgebeuren. Kwantitatief gezien zijn aanbod en vraag in de nederlandse detailhandel al op elkaar afgestemd. Als gevolg van de steeds sterker wordende concurrentiedruk en de telkens veranderende consumentenbehoeften wordt het steeds maeilijker een goede lokatie te vinden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "1 Check—list. Lijst van de opgenomen filialen. Amersfoort Axel Bergen op Zoom Boxtel Didam Doetinchen Driebergen Genderingen (Ulft) Gouda Maaastricht Oestgeest Purmerend Roosendaal Sommelsdijk Terneuzen Tilburg Valkenswaard Venlo Waalwijk Weert Winterswijk Zundert Zutphen. 3 Lijst van verwachte invloedsfaktoren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912,
                geonames:2747373,
                geonames:2747891,
                geonames:2759794 ;
            sgpl:spatialText "grote steden Amsterdam, Rotterdam, Den Haag en Utrecht" ;
            sgpl:text_context "1. Gemeenten waar de sociale samenstelling van de bevolking een redelijke besteding mogelijk maakt zonder uitzonderlijk grote derving door diefstal. Hiermee zijn dus in eerste instantie de grote steden Amsterdam, Rotterdam, Den Haag en Utrecht uitgesloten, waarbij echter enkele buitenwijken van deze steden wel in aanmerking komen. 2. Gemeenten waar reeds een goede naamsbekendheid is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747034 ;
            sgpl:spatialText "Soest" ;
            sgpl:text_context "De Hermans Groep beschikt over drie distributiecentra in respectievelijk Monster, Almere en Gilze— Rijen. Het hoofdkantoor bevindt zich in Soest. De onderneming heeft als doelstelling per jaar met 10 nieuwe filialen uit te breiden en de omzet per m2 vvo te verhogen (tot circa f 250,—/m2 wo/w )." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755249,
                geonames:2755812,
                geonames:2756631 ;
            sgpl:spatialText "provincies Groningen, Friesland, Drente" ;
            sgpl:text_context "Deze vestigingen bevinden zich met uitzondering van de provincies Groningen, Friesland, Drente en een gedeelte van Overijssel, in het gehele land. Volgens het A.G.B.(Attwood, Interact en Niam) was het marktaandeel van de Hermans Groep in het algemene levensmiddelen—assortiment in 1981 en 1982 3,5%, daalde in 1983/84 tot 3,17. en had in 1987 een nationaal marktaandeel van 2,7%. In de 3 zuidelijke provincies scoorde Hermans 4,4%." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Gilze— Rijen" ;
            sgpl:text_context "De laatste jaren is de circa 3300 werknemers tellende onderneming bewust de weg van opvoering van de kwaliteit van de winkels en het aanbod ingeslagen; het assortiment bestaat inmiddels uit circa 1900 artikelen. De Hermans Groep beschikt over drie distributiecentra in respectievelijk Monster, Almere en Gilze— Rijen. Het hoofdkantoor bevindt zich in Soest." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maaastricht" ;
            sgpl:text_context "1 Check—list. Lijst van de opgenomen filialen. Amersfoort Axel Bergen op Zoom Boxtel Didam Doetinchen Driebergen Genderingen (Ulft) Gouda Maaastricht Oestgeest Purmerend Roosendaal Sommelsdijk Terneuzen Tilburg Valkenswaard Venlo Waalwijk Weert Winterswijk Zundert Zutphen. 3 Lijst van verwachte invloedsfaktoren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "RU Utrecht" ;
            sgpl:text_context "Het voor U liggende verslag is een doctoraalscriptie, welke een onderdeel vormt van de studie \"sociale geografie\" bij de vakgroep Toegepaste Geografie en Ruimtelijke Planning (G8.P) van de RU Utrecht. Het onderzoek werd verricht in verband met een stage bij de Hermans Groep. Bij de totstandkoming van dit rapport ben ik door veel mensen en instanties geholpen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750630 ;
            sgpl:spatialText "Monster" ;
            sgpl:text_context "De laatste jaren is de circa 3300 werknemers tellende onderneming bewust de weg van opvoering van de kwaliteit van de winkels en het aanbod ingeslagen; het assortiment bestaat inmiddels uit circa 1900 artikelen. De Hermans Groep beschikt over drie distributiecentra in respectievelijk Monster, Almere en Gilze— Rijen. Het hoofdkantoor bevindt zich in Soest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759879 ;
            sgpl:spatialText "Almere" ;
            sgpl:text_context "De laatste jaren is de circa 3300 werknemers tellende onderneming bewust de weg van opvoering van de kwaliteit van de winkels en het aanbod ingeslagen; het assortiment bestaat inmiddels uit circa 1900 artikelen. De Hermans Groep beschikt over drie distributiecentra in respectievelijk Monster, Almere en Gilze— Rijen. Het hoofdkantoor bevindt zich in Soest." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2226 ;
            sgpl:subjectText "Regressie-analyse" ;
            sgpl:text_context "Op dit punt, waar de verklaringskracht van de korrelatie-analyse ophoudt (wel of geen samenhang), gaat de regressie-analyse verder en zoekt een antwoord op de nog open blijvende vraag naar de aard van de samenhang. Indien er een samenhang bestaat tussen twee variabelen kan de regressie-analyse, als de waarde van X bekend is, een voorspelling maken van de waarde van variabele Y. De regressie-analyse heeft tot doel de aard van de afhankelijkheid tussen de onderzochte variabelen te bepalen." ],
        [ sgpl:refersToConcept unesco:concept7430 ;
            sgpl:subjectText "Vestigingsplaatsonderzoek" ;
            sgpl:text_context "Het onderzoek werd tijdens een stage bij de Hermans Groep B.V. (Jac Hermans Supermarkten) verricht. Het uitgangspunt voor dit onderzoek is het feit dat vestigingsplaatsonderzoek voor de detailhandel in toenemende mate een cruciale positie inneemt binnen het bedrijfsgebeuren. Kwantitatief gezien zijn aanbod en vraag in de nederlandse detailhandel al op elkaar afgestemd." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "Detailhandel" ;
            sgpl:text_context "Het uitgangspunt voor dit onderzoek is het feit dat vestigingsplaatsonderzoek voor de detailhandel in toenemende mate een cruciale positie inneemt binnen het bedrijfsgebeuren. Kwantitatief gezien zijn aanbod en vraag in de nederlandse detailhandel al op elkaar afgestemd. Als gevolg van de steeds sterker wordende concurrentiedruk en de telkens veranderende consumentenbehoeften wordt het steeds moeilijker een goede lokatie te vinden." ],
        [ sgpl:refersToConcept unesco:concept2226 ;
            sgpl:subjectText "Regressie-analyse" ;
            sgpl:text_context "Op dit punt, waar de verklaringskracht van de korrelatie-analyse ophoudt (wel of geen samenhang), gaat de regressie-analyse verder en zoekt een antwoord op de nog open blijvende vraag naar de aard van de samenhang. Indien er een samenhang bestaat tussen twee variabelen kan de regressie-analyse, als de waarde van X bekend is, een voorspelling maken van de waarde van variabele Y. De regressie-analyse heeft tot doel de aard van de afhankelijkheid tussen de onderzochte variabelen te bepalen." ],
        [ sgpl:refersToConcept unesco:concept7430 ;
            sgpl:subjectText "Vestigingsplaatsonderzoek" ;
            sgpl:text_context "Het onderzoek werd tijdens een stage bij de Hermans Groep B.V. (Jac Hermans Supermarkten) verricht. Het uitgangspunt voor dit onderzoek is het feit dat vestigingsplaatsonderzoek voor de detailhandel in toenemende mate een cruciale positie inneemt binnen het bedrijfsgebeuren. Kwantitatief gezien zijn aanbod en vraag in de nederlandse detailhandel al op elkaar afgestemd." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "Detailhandel" ;
            sgpl:text_context "Het uitgangspunt voor dit onderzoek is het feit dat vestigingsplaatsonderzoek voor de detailhandel in toenemende mate een cruciale positie inneemt binnen het bedrijfsgebeuren. Kwantitatief gezien zijn aanbod en vraag in de nederlandse detailhandel al op elkaar afgestemd. Als gevolg van de steeds sterker wordende concurrentiedruk en de telkens veranderende consumentenbehoeften wordt het steeds moeilijker een goede lokatie te vinden." ] ;
    sgpl:thesisID 167 .

sgpl:Thesis168 a sgpl:SGPLThesis ;
    dcterms:creator "Jochem Pleijsier" ;
    dcterms:issued 1987 ;
    dcterms:title "Doktoraal-skriptie Sociale Geografie van de Ontwikkelingslanden",
        "Migratie naar en vanuit Ciudad Cuauhtemoc" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "San Antonio vlakte" ;
            sgpl:text_context "Cuauhtemoc is strategisch gebouwd aan de voet van een heuvelrij, welke midden uit de San Antonio vlakte opdoemt. De stad telt zo'n 60.000 inwoners (1985) en is een belangrijk ekonomisch- en distributiecentrum. Dit is de reden waarom er goede spoorwegverbindingen zijn met Chihuahua (120 km oostelijk), de VS; El Paso (475 km noordelijk) en de westkust; Topolobampo (500 km westelijk)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3827409 ;
            sgpl:spatialText "Cd. Cuauhtemoc" ;
            sgpl:text_context "Voor U ligt de doktoraal-skriptie, welke een uitwerking is van Ihet onderzoek over migratie naar en vanuit Cd. Cuauhtemoc, een stad in Noord-Mexico. Dit onderzoek is verricht in het kader van een reeks urbane studies in Mexico, met name de deelstaat IChihuahua, van de vakgroep Sociale Geografie van Ontwikkelingslanden (S.G.O). Het veldwerk vond plaats in de periode september 1985 tot januari 1986." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3827409 ;
            sgpl:spatialText "gemeente Cuauhtemoc" ;
            sgpl:text_context "Daarnaast werden diverse diepte-interviews afgenomen met sleutelinformanten, zoals: het hoofd rurale zaken van de gemeente Cuauhtemoc, de burgemeester, enkele ondernemers, enzovoorts. Verder bleek het nuttig (on)gepubliceerde rapporten (o.a. van DESEC, de Chihuahuense Ekonomische Ontwikkelingsmaatschappij) en kranten in het onderzoek te betrekken. Hoewel het onderzoek vnl. in de stad plaatsvond, werden ook enkele plattelandskernen bezocht, om zo een waarheidsgetrouw beeld te verkrijgen van de oorzaken van de migratie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3816728 ;
            sgpl:spatialText "Tierra y Libertad" ;
            sgpl:text_context "Deze wijken zijn vrij homogeen van samenstelling, evenals de armste en recentste wijken van de stad: Tierra y Libertad (uiterste westen) en Emiliano Zapata (uiterste oosten). Tierra y Libertad is in 1983 ontstaan door bezetting van gronden van de ejido Cuauhtemoc (de ejido is boerenkooperatie welke grond van de staat verbouwd). Het \"Comitee Defense Popular\" (volksbeschermingskomitee, dat in Noord-Mexico aktief is en zich inzet voor arme bevolkingsgroepen) heeft gezorgd voor een versnelde onteigening van de grond zodat in onze veldwerkperiode (van okt'85 tot jan'86) grote delen van de grond al bebouwd waren." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4014336 ;
            sgpl:spatialText "deelstaat Chihuahua" ;
            sgpl:text_context "Dit onderzoek is verricht in het kader van een reeks urbane studies in Mexico, met name de deelstaat Chihuahua, van de vakgroep Sociale Geografie van Ontwikkelingslanden (S.G.O). Het veldwerk vond plaats in de periode september 1985 tot januari 1986. Het is voor mij in alle opzichten een boeiende en leerzame ervaring geweest om in een Zuid-Amerikaans land onderzoek te verrichten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3996063 ;
            sgpl:spatialText "Mexico" ;
            sgpl:text_context "Het onderzoek heeft allereerst als doel om een algemeen overzicht, een verkenning te geven van de stad Cuauhtemoc in situationele en sociaal-ekonomische zin. Dit terwille van verder onderzoek in Mexico door de vakgroep Sociale Geografie van Ontwikkelingslanden (S.G.O). Deze verkenning, weergegeven in hoofdstuk 1, zal tevens als achtergrondinformatie dienen voor de hoofddoelstelling van het onderzoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3996063 ;
            sgpl:spatialText "Noord-Mexico" ;
            sgpl:text_context "Voor U ligt de doktoraal-skriptie, welke een uitwerking is van Ihet onderzoek over migratie naar en vanuit Cd. Cuauhtemoc, een stad in Noord-Mexico. Dit onderzoek is verricht in het kader van een reeks urbane studies in Mexico, met name de deelstaat IChihuahua, van de vakgroep Sociale Geografie van Ontwikkelingslanden (S.G.O). Het veldwerk vond plaats in de periode september 1985 tot januari 1986." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept13118 ;
            sgpl:subjectText "Arbeidsmobiliteit" ;
            sgpl:text_context "Door het stedelijke karakter van het onderzoek zal de nadruk komen te liggen op migratie naar de stad Cuauhtemoc, met name vanuit de rurale gebieden. Daarnaast zullen ook andere te onderscheiden vormen van migratie zoals de migratie uit de stad, de retourraigratie en de arbeidsmobiliteit, enige aandacht krijgen. Dit alles zal uitgewerkt worden in paragraaf 3.2." ],
        [ sgpl:refersToConcept unesco:concept1723 ;
            sgpl:subjectText "Mennonieten" ;
            sgpl:text_context "Want kijken we in de direkte omgeving, vooral ten noorden van de stad, dan valt het op dat er zeer veel kleine dorpen liggen. Hier leven, nog afgezien van de mexicaanse dorpen, 43.090 traditionele Mennonieten in symbiose met Cuauhtemoc. Zij zijn voor hun verkoop en inkoop van Cuauhtemoc ekonomisch afhankelijk, en de stad heeft zijn huidige status grotendeels te danken aan de Mennonieten." ],
        [ sgpl:refersToConcept unesco:concept11238 ;
            sgpl:subjectText "Fruitteeltgebied" ;
            sgpl:text_context "Zij zijn voor hun verkoop en inkoop van Cuauhtemoc ekonomisch afhankelijk, en de stad heeft zijn huidige status grotendeels te danken aan de Mennonieten. Cuauhtemoc ligt als grote stad te midden van een recentelijk ontwikkeld omvangrijk fruitteeltgebied (vnl. appels) en plukt dan ook mede de vruchten van deze belangrijke ekonomische peiler van deze streek. Deze drie geografische faktoren, namelijk: de poort tot de Si&euml;rra Madre, centrum van de Mennonietenkolonies en het centrum van de appel teelt maken in hoofdzaak Cuauhtemoc tot een regionaal centrum van ekonomische aktiviteiten van diverse aard." ],
        [ sgpl:refersToConcept unesco:concept11238 ;
            sgpl:subjectText "Fruitteeltgebied" ;
            sgpl:text_context "Zij zijn voor hun verkoop en inkoop van Cuauhtemoc ekonomisch afhankelijk, en de stad heeft zijn huidige status grotendeels te danken aan de Mennonieten. Cuauhtemoc ligt als grote stad te midden van een recentelijk ontwikkeld omvangrijk fruitteeltgebied (vnl. appels) en plukt dan ook mede de vruchten van deze belangrijke ekonomische peiler van deze streek. Deze drie geografische faktoren, namelijk: de poort tot de Si&euml;rra Madre, centrum van de Mennonietenkolonies en het centrum van de appel teelt maken in hoofdzaak Cuauhtemoc tot een regionaal centrum van ekonomische aktiviteiten van diverse aard." ],
        [ sgpl:refersToConcept unesco:concept13118 ;
            sgpl:subjectText "Arbeidsmobiliteit" ;
            sgpl:text_context "Door het stedelijke karakter van het onderzoek zal de nadruk komen te liggen op migratie naar de stad Cuauhtemoc, met name vanuit de rurale gebieden. Daarnaast zullen ook andere te onderscheiden vormen van migratie zoals de migratie uit de stad, de retourraigratie en de arbeidsmobiliteit, enige aandacht krijgen. Dit alles zal uitgewerkt worden in paragraaf 3.2." ],
        [ sgpl:refersToConcept unesco:concept1723 ;
            sgpl:subjectText "Mennonieten" ;
            sgpl:text_context "Want kijken we in de direkte omgeving, vooral ten noorden van de stad, dan valt het op dat er zeer veel kleine dorpen liggen. Hier leven, nog afgezien van de mexicaanse dorpen, 43.090 traditionele Mennonieten in symbiose met Cuauhtemoc. Zij zijn voor hun verkoop en inkoop van Cuauhtemoc ekonomisch afhankelijk, en de stad heeft zijn huidige status grotendeels te danken aan de Mennonieten." ] ;
    sgpl:thesisID 168 .

sgpl:Thesis169 a sgpl:SGPLThesis ;
    dcterms:creator "J.H.R. van der Schuit",
        "R. Ruesink" ;
    dcterms:issued 1987 ;
    dcterms:title "HUISHOUDENSMIGRATIE IN STEDELIJKE HERSTRUCTURERINGSGEBIEDEN: DE SITUATIE IN DE STAD UTRECHT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "de stad Utrecht" ;
            sgpl:text_context "HUISHOUDENSMIGRATIE IN STEDELIJKE HERSTRUCTURERINGSGEBIEDEN: DE SITUATIE IN DE STAD UTRECHT. HUISHOUDENSMIGRATIE IN STEDELIJKE HERSTRUCTURERINGSGEBIEDEN: DE SITUATIE IN DE STAD UTRECHT. November 1987 R. Ruesink." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Wijk C" ;
            sgpl:text_context "Enkele stadsvernieuwingsbuurten kenmerken zich door veel Mediterrane en niet-Nederlandse huishoudens (onder andere Lombok, 1e en 2e Daalsebuurt), terwijl één buurt (Wijk C) juist weinig Mediterranen telt. Andere buurten huisvesten relatief veel jongeren (hoofd huishouden 20 — 34 jaar). Dit betreft veelal centraal gelegen buurten (Breedstraat, Plompetorengracht, Wittevrouwen, Vogelenbuurt)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Oude Stad Noord" ;
            sgpl:text_context "Het gehanteerde schakelschema en de problemen daarmee komen aan de orde in bijlage 4. De 17 gebieden zijn: 1. Oude Stad Noord 10. Wittevrouwen 2. Oude Stad Zuid 11. Buiten Wittevrouwen 3. 1e Daalsebuurt/Pijlsweerd 12. Oudwijk 4. 2e Daalsebuurt/Ondiep 13. Dichterswijk/Croeselaan 5. Nieuw Zuilen 14. Rivierenwijk 6. Ledig Erf 15. Kanaalstraat 7. Hoogstraat 16. Lombok/Laan v Nieuw-Guinea 8. Vogelenbuurt 17. Majellapark 9. Lauwerecht. Een kaart van deze 17 gebieden is opgenomen in bijlage 3." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "de provincie Utrecht" ;
            sgpl:text_context "4.4.1 Percentage binnengemeentelijke migratie. 4.4.2 Percentage migratie van en naar de provincie Utrecht. 4.4.3 Percentage migratie van en naar Nederland en het buitenland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "4.4.2 Percentage migratie van en naar de provincie Utrecht. 4.4.3 Percentage migratie van en naar Nederland en het buitenland. 4.4.4 Percentage binnenverhuizers." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Bij de voorbereiding van het Meerjarenplan Stadsvernieuwing 1986 - 1990 van de gemeente Utrecht is de behoefte naar voren gekomen aan een diepgaande analyse van de verhuisprocessen in de Utrechtse stadsbuurten, met het oog op de invloed van deze processen op de bevolkingsontwikkeling in die buurten. De achtergrond van de behoefte van de gemeente Utrecht aan een diepteonderzoek ten behoeve van het herstructureringsbeleid is de selectieve migratie uit de stad. Gezinnen met kinderen en midden en hogere inkomensgroepen vertrekken, waardoor in de steden een oververtegenwoordiging ontstaat van jonge alleenstaanden en ouderen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stadsvernieuwingsgebieden van de gemeente Utrecht" ;
            sgpl:text_context "In het kader van dit leeronderzoek is de studie beperkt tot een analyse van de verhuisstromen van (te bepalen) huishoudenscategorieën in de stadsvernieuwingsgebieden van de gemeente Utrecht middels een typologie op basis van de samenstelling van de verhuisstromen. Een verdere uitdieping van de op te stellen typering wordt bereikt middels het relateren van het aantal verhuizers aan de bevolkingsomvang voor elke categorie huishoudens, een beschrijving van een aantal woningkenmerken van het type stadsvernieuwingsgebied en een analyse van de herkomst en bestemming van de stromen verhuizenden huishoudenscategorieën. Om te bepalen in hoeverre bepaalde aspecten van het woonmilieu in de diverse stadsvernieuwingsgebieden van invloed zijn op de aard en omvang van de verhuisstromen wordt onderzoek verricht naar de samenhang of mobiliteit met stadsvernieuwingsgebiedskenmerken, waaronder de herstructurerings- oftewel de stadsvernieuwingsactiviteiten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "Tilburg" ;
            sgpl:text_context "Everaers & Musterd brengen naar voren dat in Tilburg bepaalde woongebieden door jonge alleenstaanden worden \"overgenomen\". De ontwikkelende bevolkingsstructuur krijgt door deze processen een steeds eenzijdiger karakter, waarbij enkele vraagtekens gezet kunnen worden (denk aan draagvlak buurt en voorzieningen) (p.307). Ook doen zich processen voor waarbij de sterkere partijen op de woningmarkt in bepaalde woongebieden verdwijnen en zwakkeren naar voren komen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751496 ;
            sgpl:spatialText "Lombok" ;
            sgpl:text_context "Enkele stadsvernieuwingsbuurten kenmerken zich door veel Mediterrane en niet-Nederlandse huishoudens (onder andere Lombok, 1e en 2e Daalsebuurt), terwijl één buurt (Wijk C) juist weinig Mediterranen telt. Andere buurten huisvesten relatief veel jongeren (hoofd huishouden 20 — 34 jaar). Dit betreft veelal centraal gelegen buurten (Breedstraat, Plompetorengracht, Wittevrouwen, Vogelenbuurt)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6621526 ;
            sgpl:spatialText "oude binnenstad" ;
            sgpl:text_context "Als gekeken wordt naar andere bevolkingskenmerken dan de omvang van de onderscheiden huishoudenscategorieën dan valt op dat in dit cluster gemiddeld relatief weinig Mediterranen (6%). Wat betreft de woningkenmerken heeft dit cluster dat een groot deel van de oude binnenstad omvat de oudste woningvoorraad. Ruim 73% van de woningen is voor 1931 gebouwd." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "Huishoudensmigratie" ;
            sgpl:text_context "Samengevat komt het op het volgende neer. Uitgaande van de hypothese dat verschillen in stadsvernieuwingsactiviteiten, in woningvoorraad en in bevolkingssamenstelling karakteristieke verschillen in de aard en omvang van de huishoudensmigratie tot gevolg heeft, wordt in dit hoofdstuk een groepering van de stadsvernieuwingsgebieden in clusters tot stand gebracht met behulp van een geautomatiseerde clusteranalyse-techniek. Als basisgegevens voor de analyse zijn de scores van het door ons onderscheiden zestal huishoudenscategorieën op de mobiliteit per stadsvernieuwingsgebied genomen en het migratiesaldo." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "Mobiliteit" ;
            sgpl:text_context "Everaers & Musterd zijn in hun studie \"Bevolkingsverandering in stadsbuurten\" (1984) vooral ingegaan op de verschillen in omvang van de mobiliteit uitgesplitst naar categoriën huishoudens. Ze presenteren (p. 307) een schema (zie fig. 2.3.4.) van een empirisch model van de mobiliteit in de buurten geordend naar bouwperiode in middelgrote Nederlandse gemeenten en de daarmee samenhangende bevolkingsstructuurveranderingsprocessen. Het op deze wijze beschrijven van de mobiliteitsprocessen tussen buurten in de gemeente (aard, omvang, richting verhuisstromen en groeperen van buurten) biedt houvast voor beleidsvoerders, met name ten aanzien van de denkwijze over de dynamiek en beïnvloedingsmogelijkheden van de woningmarkt (Everaers & Musterd, 1984, p. 308) en de bevolkingssamenstelling." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwingsgebieden" ;
            sgpl:text_context "Analyse van deze samenhang geeft aanwijzingen over de mogelijkheden om de via stadsvernieuwingsactiviteiten de mobiliteit en zo de bevolkingssamenstelling van stadsbuurten te beïnvloeden. De onderzoekseenheden in het leeronderzoek zijn beperkt tot de stadsvernieuwingsgebieden omdat deze gebieden gekenmerkt worden door een sterk veranderende woningvoorraad qua kwaliteit en kwantiteit (ook ten opzichte van elkaar), hetgeen specifieke mobiliteitspatronen tot gevolg kan hebben. Andere redenen om de onderzoekseenheden te beperken zijn gelegen in de beschikbaarheid en de omvang van de benodigde gegevensbestanden en niet in de laatste plaats in de ter beschikking staande tijd voor het leeronderzoek." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "Mobiliteit" ;
            sgpl:text_context "Everaers & Musterd zijn in hun studie \"Bevolkingsverandering in stadsbuurten\" (1984) vooral ingegaan op de verschillen in omvang van de mobiliteit uitgesplitst naar categoriën huishoudens. Ze presenteren (p. 307) een schema (zie fig. 2.3.4.) van een empirisch model van de mobiliteit in de buurten geordend naar bouwperiode in middelgrote Nederlandse gemeenten en de daarmee samenhangende bevolkingsstructuurveranderingsprocessen. Het op deze wijze beschrijven van de mobiliteitsprocessen tussen buurten in de gemeente (aard, omvang, richting verhuisstromen en groeperen van buurten) biedt houvast voor beleidsvoerders, met name ten aanzien van de denkwijze over de dynamiek en beïnvloedingsmogelijkheden van de woningmarkt (Everaers & Musterd, 1984, p. 308) en de bevolkingssamenstelling." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwingsgebieden" ;
            sgpl:text_context "Analyse van deze samenhang geeft aanwijzingen over de mogelijkheden om de via stadsvernieuwingsactiviteiten de mobiliteit en zo de bevolkingssamenstelling van stadsbuurten te beïnvloeden. De onderzoekseenheden in het leeronderzoek zijn beperkt tot de stadsvernieuwingsgebieden omdat deze gebieden gekenmerkt worden door een sterk veranderende woningvoorraad qua kwaliteit en kwantiteit (ook ten opzichte van elkaar), hetgeen specifieke mobiliteitspatronen tot gevolg kan hebben. Andere redenen om de onderzoekseenheden te beperken zijn gelegen in de beschikbaarheid en de omvang van de benodigde gegevensbestanden en niet in de laatste plaats in de ter beschikking staande tijd voor het leeronderzoek." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "Huishoudensmigratie" ;
            sgpl:text_context "Samengevat komt het op het volgende neer. Uitgaande van de hypothese dat verschillen in stadsvernieuwingsactiviteiten, in woningvoorraad en in bevolkingssamenstelling karakteristieke verschillen in de aard en omvang van de huishoudensmigratie tot gevolg heeft, wordt in dit hoofdstuk een groepering van de stadsvernieuwingsgebieden in clusters tot stand gebracht met behulp van een geautomatiseerde clusteranalyse-techniek. Als basisgegevens voor de analyse zijn de scores van het door ons onderscheiden zestal huishoudenscategorieën op de mobiliteit per stadsvernieuwingsgebied genomen en het migratiesaldo." ] ;
    sgpl:thesisID 169 .

sgpl:Thesis170 a sgpl:SGPLThesis ;
    dcterms:creator "A.G.F.J. VAN DER VOORN" ;
    dcterms:issued 1987 ;
    dcterms:title "NEDERLANDSE ONDERNEMINGEN IN HET VERENIGD KONINKRIJK",
        "een studie naar ontwikkelingen en achtergronden van Nederlandse investeringen overzee" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijks Universiteit Utrecht" ;
            sgpl:text_context "Voor U ligt thans het afstudeerrapport, dat tot stand is gekomen in het kader van de studie Economische Geografie aan de Rijks Universiteit Utrecht. Het betreft een economisch-geografisch onderzoek naar Nederlandse ondernemingen die over een of meer productie-eenheden in het Verenigd Koninkrijk beschikken. Dit onderzoek past in de reeks studies van het Geografisch Instituut betreffende de toenemende internationalisering van de Nederlandse economie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2635167 ;
            sgpl:spatialText "Groot-Brittannie" ;
            sgpl:text_context "Ter verdieping van de statistieken van De Nederlansche Bank, die op macro-economisch niveau de investeringsstromen naar het buitenland weergeven, vermag de economische geografie op niveau van een veldstudie hieraan een waardevolle bijdrage leveren. Aangezien op bedrijfsniveau een inventarisatie van Nederlandse productie vestigingen in Groot-Brittannie ontbreekt, werd het wenselijk geacht hierin verandering aan te brengen. Door middel van een interviewcampagne waarin ondernemingen met dochtervestigingen in Groot-Brittannie betrokken zijn, is dit deficit aan informatie grotendeels weggewerkt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2635167 ;
            sgpl:spatialText "Verenigd Koninkrijk" ;
            sgpl:text_context "Voor U ligt thans het afstudeerrapport, dat tot stand is gekomen in het kader van de studie Economische Geografie aan de Rijks Universiteit Utrecht. Het betreft een economisch-geografisch onderzoek naar Nederlandse ondernemingen die over een of meer productie-eenheden in het Verenigd Koninkrijk beschikken. Dit onderzoek past in de reeks studies van het Geografisch Instituut betreffende de toenemende internationalisering van de Nederlandse economie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het Nederlandse bedrijfsleven is in hoog tempo aan het internationaliseren. Nederland is momenteel, na de Verenigde Staten en het Verenigd Koninkrijk, de grootste buitenlandse investeerder ter wereld. Volgens het meest recent gepubliceerde totaaloverzicht van de Nederlandsche Bank had het Nederlands bedrijfsleven eind 1984 voor 144 miljard gulden in buitenlandse overnames en deelnemingen geïnvesteerd, 20% meer dan in het jaar daarvoor." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2637438 ;
            sgpl:spatialText "South East" ;
            sgpl:text_context "Van de 11 planregio's kreeg de South East de meeste arbeidsplaatsen erbij, maar relatief kwam dit neer op een toename van slechts 12%. Hierna volgde Yorkshire & Humberside met een toename van 38.000 arbeidsplaatsen, dat relatief gezien 141% betekende. Ook de Noordelijke regio's deden het goed: North kreeg er ruim 26.000 banen erbij (+107%) en North West 34.400 (+34%)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11040 ;
            sgpl:subjectText "Directe buitenlandse investeringen" ;
            sgpl:text_context "Zijn \"totaaltheorie\", ook wel OLI-paradigma genaamd (\"Organisation, Location, en Internalisation\") , legt vooral de nadruk op de voorwaarden waaraan voldaan moet worden, wil er van een geslaagde internationalisatie sprake zijn. Hij onderscheidt een drietal determinanten ter verklaring van de directe buitenlandse investeringen, nl. specifieke eigendomsvoordelen, interna 1isatievoordelen en locatie-specifieke voordelen. Ten eerste moet de aankomende multinationale onderneming kunnen beschikken over bepaalde competenties, die de vorm aannemen van economische voordelen." ],
        [ sgpl:refersToConcept unesco:concept5887 ;
            sgpl:subjectText "Locatiekeuze-proces" ;
            sgpl:text_context "Of er voor een productie-eenheid een nieuw bedrijf opge- opgericht wordt, of dat er alleen een nieuwe locatie gezocht wordt, of dat de handeIsvestiging zodanig wordt uitgebreid dat er productie kan plaatsvinden, zijn vragen die Hakanson onbeantwoord laat. In de laatste paragraaf van dit hoofdstuk komt het locatiekeuze-proces van ondernemingen aan de orde. Indien een onderneming besluit te internationaliseren, dan vraagt men zich vervolgens af waar dat plaats zal vinden." ],
        [ sgpl:refersToConcept unesco:concept8619 ;
            sgpl:subjectText "Internationalisering van de Nederlandse economie" ;
            sgpl:text_context "Het betreft een economisch-geografisch onderzoek naar Neder- landse ondernemingen die over een of meer productie-eenheden in het Verenigd Koninkrijk beschikken. Dit onderzoek past in de reeks studies van het Geografisch Instituut betreffende de toenemende internationali- sering van de Nederlandse economie. Ter verdieping van de statistieken van De Nederlansche Bank, die op macro-economisch niveau de investeringsstromen naar het buitenland weergeven, vermag de economische geografie op niveau van een veldstudie hieraan een waardevolle bijdrage leveren." ],
        [ sgpl:refersToConcept unesco:concept11040 ;
            sgpl:subjectText "Directe buitenlandse investeringen" ;
            sgpl:text_context "Zijn \"totaaltheorie\", ook wel OLI-paradigma genaamd (\"Organisation, Location, en Internalisation\") , legt vooral de nadruk op de voorwaarden waaraan voldaan moet worden, wil er van een geslaagde internationalisatie sprake zijn. Hij onderscheidt een drietal determinanten ter verklaring van de directe buitenlandse investeringen, nl. specifieke eigendomsvoordelen, interna 1isatievoordelen en locatie-specifieke voordelen. Ten eerste moet de aankomende multinationale onderneming kunnen beschikken over bepaalde competenties, die de vorm aannemen van economische voordelen." ],
        [ sgpl:refersToConcept unesco:concept8619 ;
            sgpl:subjectText "Internationalisering van de Nederlandse economie" ;
            sgpl:text_context "Het betreft een economisch-geografisch onderzoek naar Neder- landse ondernemingen die over een of meer productie-eenheden in het Verenigd Koninkrijk beschikken. Dit onderzoek past in de reeks studies van het Geografisch Instituut betreffende de toenemende internationali- sering van de Nederlandse economie. Ter verdieping van de statistieken van De Nederlansche Bank, die op macro-economisch niveau de investeringsstromen naar het buitenland weergeven, vermag de economische geografie op niveau van een veldstudie hieraan een waardevolle bijdrage leveren." ],
        [ sgpl:refersToConcept unesco:concept5887 ;
            sgpl:subjectText "Locatiekeuze-proces" ;
            sgpl:text_context "Of er voor een productie-eenheid een nieuw bedrijf opge- opgericht wordt, of dat er alleen een nieuwe locatie gezocht wordt, of dat de handeIsvestiging zodanig wordt uitgebreid dat er productie kan plaatsvinden, zijn vragen die Hakanson onbeantwoord laat. In de laatste paragraaf van dit hoofdstuk komt het locatiekeuze-proces van ondernemingen aan de orde. Indien een onderneming besluit te internationaliseren, dan vraagt men zich vervolgens af waar dat plaats zal vinden." ] ;
    sgpl:thesisID 170 .

sgpl:Thesis171 a sgpl:SGPLThesis ;
    dcterms:creator "J. van Berkel",
        "T.A.L. Leliveld" ;
    dcterms:issued 1988 ;
    dcterms:title "OPSLAGPANDEN IN DE GEMEENTE UTRECHT",
        "VERSLAGEN VAN LEERONDERZOEK G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Rijnsweerd/Uithof" ;
            sgpl:text_context "Tussen 1914 en 1945 vindt er geen stichting plaats van nieuwe werkgebieden. De nieuwe bedrijfsterreinen zijn; Overvecht (buurt 16), Kanaleneiland (buurt 74), Lage Weide (buurt 89), en Rijnsweerd/Uithof (buurt 48 en 49) met tertiaire bedrijvigheid. Afgezien van deze concentraties van werkgebieden die in 1979 voor 55 procent van de Utrechtse werkgelegenheid zorgde, is de rest van de bedrijvigheid vrij regelmatig over de stad verspreid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748815 ;
            sgpl:spatialText "Overvecht" ;
            sgpl:text_context "De eerste groep panden die uitsluitend voor opslag gebruikt worden, omvat 26 panden (36%). Deze zuivere bedrijfspanden zijn vooral in Overvecht, Kanaleneiland (niet alleen op de bedrijfsterreinen) en in de Stationsbuurt gevestigd, maar ook de Binnenstad biedt onderdak aan een relatief vrij groot aantal van deze panden. Ze bestaan meestal uit één bouwlaag, een derde deel van de bedrijfspanden bestaat uit twee of drie bouwlagen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746825 ;
            sgpl:spatialText "Stationsbuurt" ;
            sgpl:text_context "De eerste groep panden die uitsluitend voor opslag gebruikt worden, omvat 26 panden (36%). Deze zuivere bedrijfspanden zijn vooral in Overvecht, Kanaleneiland (niet alleen op de bedrijfsterreinen) en in de Stationsbuurt gevestigd, maar ook de Binnenstad biedt onderdak aan een relatief vrij groot aantal van deze panden. Ze bestaan meestal uit één bouwlaag, een derde deel van de bedrijfspanden bestaat uit twee of drie bouwlagen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6621526 ;
            sgpl:spatialText "Binnenstad" ;
            sgpl:text_context "De eerste groep panden die uitsluitend voor opslag gebruikt worden, omvat 26 panden (36%). Deze zuivere bedrijfspanden zijn vooral in Overvecht, Kanaleneiland (niet alleen op de bedrijfsterreinen) en in de Stationsbuurt gevestigd, maar ook de Binnenstad biedt onderdak aan een relatief vrij groot aantal van deze panden. Ze bestaan meestal uit één bouwlaag, een derde deel van de bedrijfspanden bestaat uit twee of drie bouwlagen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2752014 ;
            sgpl:spatialText "Lage Weide" ;
            sgpl:text_context "In Kanaalstraat-Vleutenseweg e.o. is de overige dienstverlening duidelijk ondervertegenwoordigd, maar de industrie is goed vertegenwoordigd. Deze is vooral op Lage Weide geconcentreerd. Dit bedrijfsterrein is Utrechts enige bedrijfsterrein met veel industrie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Zo laat een onderzoek in de noordelijke stadsvernieuwingsgebieden van Rotterdam zien dat opslagfuncties doorgaans zijn gehuisvest in kleine (max. 50 m2) en relatief goedkope ruimten (f20,- tot f50,- per m2) waaraan weinig eisen worden gesteld. Als deze panden door sloop of renovatie verloren gaan, zijn er weinig mogelijkheden voor verplaatsing van de opslagaktiviteit. De ruimten die in de aanbodzijde gerealiseerd worden, zijn grotendeels alleen geschikt voor andere bedrijfsmatige aktiviteiten, niet voor opslag (Gemeente Rotterdam, 1985, p.5)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753082 ;
            sgpl:spatialText "Kanaleneiland" ;
            sgpl:text_context "De eerste groep panden die uitsluitend voor opslag gebruikt worden, omvat 26 panden (36%). Deze zuivere bedrijfspanden zijn vooral in Overvecht, Kanaleneiland (niet alleen op de bedrijfsterreinen) en in de Stationsbuurt gevestigd, maar ook de Binnenstad biedt onderdak aan een relatief vrij groot aantal van deze panden. Ze bestaan meestal uit één bouwlaag, een derde deel van de bedrijfspanden bestaat uit twee of drie bouwlagen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdamse Jordaan" ;
            sgpl:text_context "Enerzijds wordt de nabijheid van de woning van de ondernemer als zeer belangrijk ervaren, anderzijds vormt de nabijheid van de hoofdvestiging, vergeleken met andere bedrijfssectoren, een relatief belangrijk vestigingsplaatsmotief (Geerling, 1978). Ook in een onderzoek van Abbink en van Keulen (Abbink en van Keulen, 1970, p.70) in de Amsterdamse Jordaan wordt deze laatste factor genoemd. In de noordelijke oude stad van Utrecht blijkt van bijna driekwart van de opslagruimten de hoofdvestiging zich in hetzelfde bestemmingsplangebied, dezelfde buurt, te bevinden als de opslagruimte (E.T.I., 1982a, p.40)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Voor vernieuwbouw is die marge 60 tot 120 gulden, voor nieuwbouw 70 tot 130 gulden (Guyt, 1985, p.27). Den Haag kent een soortgelijke problematiek. In de Haagse stadsvernieuwingsgebieden zijn tussen 1979 en 1982 door de gemeente 158 huurders van opslagpanden uitgeplaatst." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Het voor u liggende verslag is het resultaat van een onderzoek naar opslagpanden in de gemeente Utrecht. Het is tot stand gekomen in het kader van een leeronderzoek, dat het centrale onderdeel is in het vervolgdoctoraalprogramma Sociale Geografie aan de Rijksuniversiteit Utrecht. Doel van een leeronderzoek is het zich verwerven van vaardigheid in het doen van wetenschappelijk onderzoek en het maken van een verslag van de inhoudelijke uitkomsten." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept123 ;
            sgpl:subjectText "Vestigingsplaatsmotieven" ;
            sgpl:text_context "In een onderzoek van Geerling worden lage huisvestingskosten door de ondernemers als een belangrijk vestigingsplaatsmotief gezien. Hij wijst bovendien op twee andere vestigingsplaatsmotieven. Enerzijds wordt de nabijheid van de woning van de ondernemer als zeer belangrijk ervaren, anderzijds vormt de nabijheid van de hoofdvestiging, vergeleken met andere bedrijfssectoren, een relatief belangrijk vestigingsplaatsmotief (Geerling, 1978)." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Uit verschillende publikaties komt naar voren dat vooral stadsvernieuwingsgebieden voor opslagpanden problematisch zijn. Zo laat een onderzoek in de noordelijke stadsvernieuwingsgebieden van Rotterdam zien dat opslagfuncties doorgaans zijn gehuisvest in kleine (max. 50 m2) en relatief goedkope ruimten (f20,- tot f50,- per m2) waaraan weinig eisen worden gesteld. Als deze panden door sloop of renovatie verloren gaan, zijn er weinig mogelijkheden voor verplaatsing van de opslagaktiviteit." ],
        [ sgpl:refersToConcept unesco:concept2753 ;
            sgpl:subjectText "Opslagpanden" ;
            sgpl:text_context "Het extern opslaan van goederen vindt plaats in zogeheten opslagpanden. Onder een opslagpand wordt een bedrijfsvestiging verstaan, waarvan de hoofdaktiviteit het opslaan van goederen is. Het maakt deel uit van een onderneming en is derhalve nooit zelfstandig." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Uit verschillende publikaties komt naar voren dat vooral stadsvernieuwingsgebieden voor opslagpanden problematisch zijn. Zo laat een onderzoek in de noordelijke stadsvernieuwingsgebieden van Rotterdam zien dat opslagfuncties doorgaans zijn gehuisvest in kleine (max. 50 m2) en relatief goedkope ruimten (f20,- tot f50,- per m2) waaraan weinig eisen worden gesteld. Als deze panden door sloop of renovatie verloren gaan, zijn er weinig mogelijkheden voor verplaatsing van de opslagaktiviteit." ],
        [ sgpl:refersToConcept unesco:concept123 ;
            sgpl:subjectText "Vestigingsplaatsmotieven" ;
            sgpl:text_context "In een onderzoek van Geerling worden lage huisvestingskosten door de ondernemers als een belangrijk vestigingsplaatsmotief gezien. Hij wijst bovendien op twee andere vestigingsplaatsmotieven. Enerzijds wordt de nabijheid van de woning van de ondernemer als zeer belangrijk ervaren, anderzijds vormt de nabijheid van de hoofdvestiging, vergeleken met andere bedrijfssectoren, een relatief belangrijk vestigingsplaatsmotief (Geerling, 1978)." ],
        [ sgpl:refersToConcept unesco:concept2753 ;
            sgpl:subjectText "Opslagpanden" ;
            sgpl:text_context "Het extern opslaan van goederen vindt plaats in zogeheten opslagpanden. Onder een opslagpand wordt een bedrijfsvestiging verstaan, waarvan de hoofdaktiviteit het opslaan van goederen is. Het maakt deel uit van een onderneming en is derhalve nooit zelfstandig." ] ;
    sgpl:thesisID 171 .

sgpl:Thesis173 a sgpl:SGPLThesis ;
    dcterms:creator "Frank Bilsen",
        "Gerda Blom" ;
    dcterms:issued 1988 ;
    dcterms:title "CASE-STUDY VAN HET ZEEHELDENKWARTIER EN DUINOORD-ZUID",
        "WONEN IN DE BINNENSTAD VAN DEN HAAG" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "gemeente Den Haag" ;
            sgpl:text_context "Ter afsluiting van de studie sociale geografie aan de Rijksuniversiteit te Utrecht dient een eindexamenskriptie geschreven te worden. Contacten tussen de universiteit en de dienst Stadsontwikkeling en Grondzaken van de gemeente Den Haag hebben ertoe geleid dat vijf groepjes van elk twee studenten als afstudeerproject een onderzoek uit te werken kregen met als onderwerp het wonen in de binnenstad van Den Haag. Elk groepje heeft een gedeelte van de binnenstad als onderzoeksgebied genomen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Sweelinckplein en omgeving" ;
            sgpl:text_context "Duinoord-Zuid wordt in het zuiden begrenst door de Laan van Meerdervoort en aan de overige kanten door de in een grote boog lopende Groot Hertoginnelaan (zie kaart 2.1). Het vormt een onderdeel van de wijk Duinoord (wijknummer 11) en valt samen met volkstellingsblok 43, dat officieel 'Sweelinckplein en omgeving' wordt genoemd. Het Zeeheldenkwartier wordt aan de zuidkant begrenst door de Veenkade, aan de oostkant door de Toussaintkade, de Kortenaerkade en de Zeestraat, in het noorden door de Scheveningseweg, de Anna- Pauwlownastraat en de Laan van Meerdervoort en in het westen door de Waldeck-Piermontkade." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:11525079 ;
            sgpl:spatialText "Duinoord" ;
            sgpl:text_context "Duinoord-Zuid wordt in het zuiden begrenst door de Laan van Meerdervoort en aan de overige kanten door de in een grote boog lopende Groot Hertoginnelaan (zie kaart 2.1). Het vormt een onderdeel van de wijk Duinoord (wijknummer 11) en valt samen met volkstellingsblok 43, dat officieel 'Sweelinckplein en omgeving' wordt genoemd. Het Zeeheldenkwartier wordt aan de zuidkant begrenst door de Veenkade, aan de oostkant door de Toussaintkade, de Kortenaerkade en de Zeestraat, in het noorden door de Scheveningseweg, de Anna- Pauwlownastraat en de Laan van Meerdervoort en in het westen door de Waldeck-Piermontkade." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:11525099 ;
            sgpl:spatialText "Zeeheldenkwartier" ;
            sgpl:text_context "Met name zijn die stadsdelen geselecteerd waar de gemeente nauwelijks invloed heeft op de woonruimteverdeling en waar men zich veelal vrij kan vestigen. Het onderzoek in dit rapport zal zich beperken tot het Zeeheldenkwartier en Duinoord-Zuid (locatie en afbakening, zie paragraaf 2.1). Om de waardeoordelen van de bewoners en de ex-bewoners ten aanzien van de wijk te kunnen plaatsen is het noodzakelijk eerst een beeld te krijgen van het woonmilieu onder studie en van de verschillende deelmilieu's hierbinnen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Ter afsluiting van de studie sociale geografie aan de Rijksuniversiteit te Utrecht dient een eindexamenskriptie geschreven te worden. Contacten tussen de universiteit en de dienst Stadsontwikkeling en Grondzaken van de gemeente Den Haag hebben ertoe geleid dat vijf groepjes van elk twee studenten als afstudeerproject een onderzoek uit te werken kregen met als onderwerp het wonen in de binnenstad van Den Haag. Elk groepje heeft een gedeelte van de binnenstad als onderzoeksgebied genomen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Laan van Meerdervoort" ;
            sgpl:text_context "Duinoord-Zuid wordt in het zuiden begrenst door de Laan van Meerdervoort en aan de overige kanten door de in een grote boog lopende Groot Hertoginnelaan (zie kaart 2.1). Het vormt een onderdeel van de wijk Duinoord (wijknummer 11) en valt samen met volkstellingsblok 43, dat officieel 'Sweelinckplein en omgeving' wordt genoemd. Het Zeeheldenkwartier wordt aan de zuidkant begrenst door de Veenkade, aan de oostkant door de Toussaintkade, de Kortenaerkade en de Zeestraat, in het noorden door de Scheveningseweg, de Anna- Pauwlownastraat en de Laan van Meerdervoort en in het westen door de Waldeck-Piermontkade." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "1.1 Inleiding. Het proces van suburbanisatie, dat het ruimtelijke beeld van Nederland in de jaren 60 en begin jaren 70 zo duidelijk bepaalde heeft een nadelige invloed gehad op de ontwikkeling van de stad. De grote steden hebben inwoners, werkgelegenheid en voorzieningen verloren aan hun ommeland (Cortie & van de Ven, 1981, p.430)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "binnenstad van Den Haag" ;
            sgpl:text_context "Ter afsluiting van de studie sociale geografie aan de Rijksuniversiteit te Utrecht dient een eindexamenskriptie geschreven te worden. Contacten tussen de universiteit en de dienst Stadsontwikkeling en Grondzaken van de gemeente Den Haag hebben ertoe geleid dat vijf groepjes van elk twee studenten als afstudeerproject een onderzoek uit te werken kregen met als onderwerp het wonen in de binnenstad van Den Haag. Elk groepje heeft een gedeelte van de binnenstad als onderzoeksgebied genomen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:11525079 ;
            sgpl:spatialText "Duinoord-Zuid" ;
            sgpl:text_context "Met name zijn die stadsdelen geselecteerd waar de gemeente nauwelijks invloed heeft op de woonruimteverdeling en waar men zich veelal vrij kan vestigen. Het onderzoek in dit rapport zal zich beperken tot het Zeeheldenkwartier en Duinoord-Zuid (locatie en afbakening, zie paragraaf 2.1). Om de waardeoordelen van de bewoners en de ex-bewoners ten aanzien van de wijk te kunnen plaatsen is het noodzakelijk eerst een beeld te krijgen van het woonmilieu onder studie en van de verschillende deelmilieu's hierbinnen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "In de tweede helft van de jaren 70 is de leegloop uit de stad over zijn hoogtepunt heen. In Den Haag is na jarenlange bevolkingsafname in 1985 voor het eerst weer sprake van een lichte toename (Geurts, 1986, p. 15). Sommigen (Klaassen in Lambooy, 1982, p.32) spreken over een nieuwe fase in het ontwikkelingsproces van de stad : de reurbanisatie." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Binnenstedelijk woonmilieu" ;
            sgpl:text_context "In het kader van het binnenstadsplan is de dienst Stadsontwikkeling en Grondzaken (SOGZ) van de gemeente Den Haag in samenwerking met de Rijksuniversiteit Utrecht een onderzoek gestart in een groot deel van de Haagse binnenstad. Het doel van dit onderzoek Is na te gaan voor wie het binnenstedelijk woonmilieu een (on)aantrekkelijk leefgebied vormt. Van Ginkel (1979, p.74) omschrijft het begrip 'woonmilieu' als 'het geheel van in een gebied geldende externe condities, die op de vestiging en het wonen van huishoudens in dat gebied van invloed zijn'." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Slecht onderhoud en onderverhuring zijn de voornaamste oorzaken voor de snelle achteruitgang van veel panden, met name in het Zeeheldenkwartier. In bepaalde delen van die wijk was het verval zo erg, dat de gemeente Den Haag in 1981 besloot het Zeeheldenkwartier aan de lijst van stadsvernieuwingsgebieden toe te voegen. Duinoord-Zuid komt niet voor op deze lijst." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Woonlocatiekeuze" ;
            sgpl:text_context "In de laatste paragraaf wordt aan de hand van de probleemstelling de operationalisering van het onderzoek uiteengezet. In deze paragraaf wordt op basis van literatuur op het gebied van wonen en verhuizen een theoretisch framework opgesteld, dat het proces van de keuze van een woonlocatie beschrijft. De keuze van een woonlocatie is een proces dat bestaat uit twee fases." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Slecht onderhoud en onderverhuring zijn de voornaamste oorzaken voor de snelle achteruitgang van veel panden, met name in het Zeeheldenkwartier. In bepaalde delen van die wijk was het verval zo erg, dat de gemeente Den Haag in 1981 besloot het Zeeheldenkwartier aan de lijst van stadsvernieuwingsgebieden toe te voegen. Duinoord-Zuid komt niet voor op deze lijst." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Binnenstedelijk woonmilieu" ;
            sgpl:text_context "In het kader van het binnenstadsplan is de dienst Stadsontwikkeling en Grondzaken (SOGZ) van de gemeente Den Haag in samenwerking met de Rijksuniversiteit Utrecht een onderzoek gestart in een groot deel van de Haagse binnenstad. Het doel van dit onderzoek Is na te gaan voor wie het binnenstedelijk woonmilieu een (on)aantrekkelijk leefgebied vormt. Van Ginkel (1979, p.74) omschrijft het begrip 'woonmilieu' als 'het geheel van in een gebied geldende externe condities, die op de vestiging en het wonen van huishoudens in dat gebied van invloed zijn'." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Woonlocatiekeuze" ;
            sgpl:text_context "In de laatste paragraaf wordt aan de hand van de probleemstelling de operationalisering van het onderzoek uiteengezet. In deze paragraaf wordt op basis van literatuur op het gebied van wonen en verhuizen een theoretisch framework opgesteld, dat het proces van de keuze van een woonlocatie beschrijft. De keuze van een woonlocatie is een proces dat bestaat uit twee fases." ] ;
    sgpl:thesisID 173 .

sgpl:Thesis174 a sgpl:SGPLThesis ;
    dcterms:creator "Frank van Gemerden",
        "Michaël Steeghs",
        "Robert Breed" ;
    dcterms:issued 1988 ;
    dcterms:title "Een onderzoek naar de konflikten tussen ruimtegebruik en landschap in de stadsrandzone van Veenendaal",
        "LANDSCHAP IN DE STADSRANDZONE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de Blauwe Hel" ;
            sgpl:text_context "De Hel, 20 ha. groot, is eigendom van de Staat en in beheer bij Staatsbosbeheer, de Blauwe Hel, 15 ha. groot, is eigendom van Natuurmonumenten. In 1983 zijn beide reservaten aangewezen als \"beschermd natuurmonument\", vanwege hun landschappelijke en natuurwetenschappelijke betekenis (Beschikking Min. van Landbouw en Visserij, 1983). Hoofddoelstelling bij het beheer van de \" de Hel\" en \"de Blauwe Hel\", verder te noemen \"de Hel\", is het beschermen en mogelijk versterken van deze landschappelijke -en natuurwetenschappelijke waarden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Middenlaan" ;
            sgpl:text_context "De drie agrarische nevenbedrijven aan de Middenlaan zijn altijd nevenbedrijven geweest. In de toekomst zullen ze worden opgeheven om de grond vrij te maken voor woningbouw. De bedrijven aan de Middelbuurtseweg (tabel 5.4) waren voorheen agrarische hoofdbedrijven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745774 ;
            sgpl:spatialText "gemeente Veenendaal" ;
            sgpl:text_context "Op zoek naar vragen die er in de praktijk van de natuur,- milieu- en landschapsbescherming leven hebben we kontakt opgeno- men met de Stichtse Milieufederatie. De snelle groei van de gemeente Veenendaal en de daaruit voortvloeiende konflikten tussen stedelijke aktiviteiten en natuur,- en landschapswaarden werd door deze organisatie als een belangrijk probleemveld beschouwd. Door nu de vraag naar de aard van deze konflikten te plaatsen binnen het (konceptuele) kader van het aan het Geografisch Instituut verrichte stadsrandonderzoek was titel en thema van deze skriptie geboren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748184 ;
            sgpl:spatialText "buurgemeente Rhenen" ;
            sgpl:text_context "Vervolgens wordt het beleid, zoals dat uiteindelijk door de gemeente is vastgesteld, besproken. Visies en invloed vanuit provincie en buurgemeente Rhenen worden in dit hoofdstuk uiteengezet. Getracht wordt om de plaats die het landschap inneemt in het beleid ten aanzien van stedelijke uitbreidingen te verduidelijken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Middelbuurtseweg" ;
            sgpl:text_context "5.4. Agrarische neven- en hoofdbedrijven aan de Middelbuurtseweg, Veenendaal p. 28. In het verleden, rond 1950, heeft er uitschuiving van agrarische bedrijvigheid plaatsgevonden van de toenmalige stadsrand naar de Middelbuurtseweg. Bij de aanleg van het Industrieterrein II zijn enkele bedrijven verplaatst." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745774 ;
            sgpl:spatialText "Veenendaal" ;
            sgpl:text_context "De snelle groei van de gemeente Veenendaal en de daaruit voortvloeiende konflikten tussen stedelijke aktiviteiten en natuur,- en landschapswaarden werd door deze organisatie als een belangrijk probleemveld beschouwd. Door nu de vraag naar de aard van deze konflikten te plaatsen binnen het (konceptuele) kader van het aan het Geografisch Instituut verrichte stadsrandonderzoek was titel en thema van deze skriptie geboren. Al geruime tijd werkzaam op het gebied van het stadsrandonderzoek is Dhr. G.M.R.A. van Oort." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748468 ;
            sgpl:spatialText "landgoed \"Prattenburg\"" ;
            sgpl:text_context "Een groot deel van de Utrechtse Heuvelrug ten westen en zuidwesten van Veenendaal valt onder Boswachterij de Amerongse Berg, ongeveer 1100 hektare groot en onder beheer bij Staatsbosbeheer, en, ten zuidoosten daarvan, het partikuliere landgoed Prattenburg. in eigendom van de heer van Asch van Wijck. Op deze terreinen bevindt zich een min of meer aaneengesloten bosgebied, voornamelijk bestaande uit loofbos en gemengd bos." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756429 ;
            sgpl:spatialText "Ede" ;
            sgpl:text_context "Bovendien zijn nog eens 33% van de geënquêteerden afkomstig uit andere delen van Veenendaal. 19% van de geënquêteerden zijn afkomstig uit andere gemeenten, met name naburige (Ede, Rhenen). 5.3. Bedrijven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Dijkstraat" ;
            sgpl:text_context "Heel anders is de situatie in het gebied ten zuiden van de Dijkstraat, grenzend aan het uitbreidingsgebied Veenendaal West. Het gaat hier om een kleinschalig overgangsgebied, ingeklemd tussen de beboste Heuvelrug en de bebouwing van Veenendaal (West). Karakteristiek zijn de houtwallen en de kleine percelen ." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751385 ;
            sgpl:spatialText "Lunteren" ;
            sgpl:text_context "De mest is niet alleen van bedrijven uit het gebied afkomstig, maar van bedrijven uit de hele Vallei. Zelfs mest uit Ede en Lunteren wordt hier uitgereden. Botanisch is het gebied hierdoor nauwelijks interessant." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758898 ;
            sgpl:spatialText "Binnenveld" ;
            sgpl:text_context "Aantasting hiervan vindt reeds plaats doordat Ede zich in westelijke richting uitbreidt. Problematisch is verder het intensieve karakter van de veehouderij in het zogenaamde Binnenveld. Illegale ophogingen zijn meerdere malen gekonstateerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Universiteit Utrecht" ;
            sgpl:text_context "Utrecht, januari 1988. Universiteit Utrecht BIBLIOTHEEKCENTRUM UITHOF RIJKSUNIVERSITEIT TE UTRECHT" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757376 ;
            sgpl:spatialText "de Laan" ;
            sgpl:text_context "In dit hoofdstuk wordt ingegaan op de rol die de Laan speelt. De Laan is een partikulier terrein, in eigendom van de Erven C. Bos. In totaal is het gebied ongeveer 375 ha. groot." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759824 ;
            sgpl:spatialText "Boswachterij de Amerongse Berg" ;
            sgpl:text_context "6.3. Boswachterij de Amerongse Berg en het landgoed \"Prattenburg\" p. 39. 6.4. Konklusie p. 42. Hoofdstuk 7." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757561 ;
            sgpl:spatialText "de Hel" ;
            sgpl:text_context "Hoofddoelstelling bij het beheer van de \" de Hel\" en \"de Blauwe Hel\", verder te noemen \"de Hel\", is het beschermen en mogelijk versterken van deze landschappelijke -en natuurwetenschappelijke waarden. Vanwege de grote kwetsbaarheid van de vegetatie en het geringe opppervlak van het gebied is de Hel niet voor publiek toegankelijk. De Hel is een laatste restant van een vroeger in het zuidelijk deel van de Gelderse Vallei meer verbreid voorkomend terreintype." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747824 ;
            sgpl:spatialText "Ruisseveen" ;
            sgpl:text_context "7.1. Ruisseveen en Dijkstraat p. 43. Het Ruisseveen is op het moment van schrijven al grotendeels volgebouwd, tot vlak bij de Slaperdijk. Grootschalige verstedelijking heeft het landschap waar het in dit onderzoek om gaat doen verdwijnen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Cuneraweg" ;
            sgpl:text_context "7.2. Cuneraweg p. 44. Het overgangsgebied langs de Cuneraweg tot aan de Noordelijke Meentsteeg is landschappelijk gezien een voortzetting van het gebied ten zuiden van de Dijkstraat. Ten noorden van de zeer drukke Cuneraweg liggen nog enkele houtwallen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Industrieterrein II" ;
            sgpl:text_context "Door bedrijven op het Industrieterrein II wordt grondwater gewonnen. Voor deze grondwaterwinning zijn putten geslagen die de Eemkleilaag doorboren. Ook bij het slaan van heipalen voor fundering van de gebouwen is de kleilaag doorboord." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748864 ;
            sgpl:spatialText "Overberg" ;
            sgpl:text_context "De inloop van rekreanten is sinds de jaren '70 sterk toegenomen. Vanuit Veenendaal komen steeds meer rekreanten, en daarnaast zijn er de afgelopen jaren in Overberg een aantal campings ontstaan. Juist in de meest kwetsbare terreinen, zoals de venoevers, is veel inloop." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745774 ;
            sgpl:spatialText "stadsrandzone van Veenendaal" ;
            sgpl:text_context "In ons onderzoek hebben wij landschap als invalshoek gekozen. Dit betekent dat specifieke aandacht geschonken wordt aan de manier waarop, in ons geval, de ruimtelijke ontwikkelingen in de Veenendaalse stadsrandzone inwerken op het landschap. De keuze voor dit onderwerp is op twee verschillende gronden gemaakt." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept13188 ;
            sgpl:subjectText "landschappelijke konflikten" ;
            sgpl:text_context "Op zoek naar vragen die er in de praktijk van de natuur,- milieu- en landschapsbescherming leven hebben we kontakt opgenomen met de Stichtse Milieufederatie. De snelle groei van de gemeente Veenendaal en de daaruit voortvloeiende konflikten tussen stedelijke aktiviteiten en natuur,- en landschapswaarden werd door deze organisatie als een belangrijk probleemveld beschouwd. Door nu de vraag naar de aard van deze konflikten te plaatsen binnen het (konceptuele) kader van het aan het Geografisch Instituut verrichte stadsrandonderzoek was titel en thema van deze skriptie geboren." ],
        [ sgpl:refersToConcept unesco:concept13188 ;
            sgpl:subjectText "landschapsaantasting" ;
            sgpl:text_context "Hier wordt tevens een splitsing gemaakt tussen deel A en deel B van het onderzoek. Deel A gaat vooral over konkrete ruimtelijke situaties en ontwikkelingen die (mogelijk) aanleiding geven tot landschapsaantasting, deel B over het beleid dat met betrekking tot deze ruimtelijke ontwikkelingen gevoerd wordt. Hoofdstuk 5, 6 en 7 bevatten de resultaten van het onderzoek deel A." ],
        [ sgpl:refersToConcept unesco:concept16538 ;
            sgpl:subjectText "stadsrandzone" ;
            sgpl:text_context "Hoofdstuk 10 gaat in op de afgeleide effekten van stedelijke uitbreidingen. de rekreatie. Het beleid ten aanzien van kleinschalige, niet geplande ontwikkelingen in de stadsrandzone van Veenendaal komt in hoofdstuk 11 aan de orde. Een aantal konkrete gevallen worden beschreven ter verduidelijking." ],
        [ sgpl:refersToConcept unesco:concept13188 ;
            sgpl:subjectText "landschapsaantasting" ;
            sgpl:text_context "Hier wordt tevens een splitsing gemaakt tussen deel A en deel B van het onderzoek. Deel A gaat vooral over konkrete ruimtelijke situaties en ontwikkelingen die (mogelijk) aanleiding geven tot landschapsaantasting, deel B over het beleid dat met betrekking tot deze ruimtelijke ontwikkelingen gevoerd wordt. Hoofdstuk 5, 6 en 7 bevatten de resultaten van het onderzoek deel A." ],
        [ sgpl:refersToConcept unesco:concept13188 ;
            sgpl:subjectText "landschappelijke konflikten" ;
            sgpl:text_context "Op zoek naar vragen die er in de praktijk van de natuur,- milieu- en landschapsbescherming leven hebben we kontakt opgenomen met de Stichtse Milieufederatie. De snelle groei van de gemeente Veenendaal en de daaruit voortvloeiende konflikten tussen stedelijke aktiviteiten en natuur,- en landschapswaarden werd door deze organisatie als een belangrijk probleemveld beschouwd. Door nu de vraag naar de aard van deze konflikten te plaatsen binnen het (konceptuele) kader van het aan het Geografisch Instituut verrichte stadsrandonderzoek was titel en thema van deze skriptie geboren." ],
        [ sgpl:refersToConcept unesco:concept16538 ;
            sgpl:subjectText "stadsrandzone" ;
            sgpl:text_context "Hoofdstuk 10 gaat in op de afgeleide effekten van stedelijke uitbreidingen. de rekreatie. Het beleid ten aanzien van kleinschalige, niet geplande ontwikkelingen in de stadsrandzone van Veenendaal komt in hoofdstuk 11 aan de orde. Een aantal konkrete gevallen worden beschreven ter verduidelijking." ] ;
    sgpl:thesisID 174 .

sgpl:Thesis175 a sgpl:SGPLThesis ;
    dcterms:creator "Marja Lenssen",
        "Marlou Burgers" ;
    dcterms:issued 1988 ;
    dcterms:title "Een onderzoek naar de markthandel in de stad Mopti, Mali",
        "MOPTI ALS MARKTPLAATS" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2453348 ;
            sgpl:spatialText "ommeland van Mopti" ;
            sgpl:text_context "De doelstelling van het RESEMOS-projekt is, het analyseren van: - de sociaal-ekonomische struktuur van de stad Mopti en haar ommeland. De recente veranderingen in produktie- en levenswijzen en de faktoren die hierop van invloed zijn. De rol die steden spelen of kunnen spelen in de regionale ontwikke1ing." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Quartier de Commerce" ;
            sgpl:text_context "3.2 Bevolkingspyramide van Mopti (1976) 33. 3.3 Funktiekaart van het Quartier de Commerce en Charlotville 38. 3.4 Funktiekaart van het woongedeelte van Mopti 39." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2451778 ;
            sgpl:spatialText "San" ;
            sgpl:text_context "Voorafgaand aan de cycli rond Mopti werd onderzoek verricht rond de steden Djenné (het zgn. ISEDE-programma) en San (het zgn. ESES-programma). De doelstelling van het RESEMOS-projekt is, het analyseren van: - de sociaal-ekonomische struktuur van de stad Mopti en haar ommeland; - de recente veranderingen in produktie- en levenswijzen en de faktoren die hierop van invloed zijn; - de rol die steden spelen of kunnen spelen in de regionale ontwikke1ing; - verschillen tussen steden op verschillende niveau's van de urbane hiërarchie in Mali. De eerste, in 1983 gestarte fase betrof een eerste funktionele inventarisatie, met onderzoeken naar de handels-, ambachts-, industriële- en bouwsektor." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Het onderzoek maakt deel uit van het RESEMOS-projekt (\"Recherche Socio-économique de 1'Ensemble Urbain Mopti-Sévaré et sa Rëgion\"). Dit projekt is een samenwerkingsverband tussen de Vakgroep Sociale Geografie van Ontwikkelingslanden van de Rijksuniversiteit Utrecht en het \"Institut des Sciences Humaines\" te Bamako. Het projekt kan geplaatst worden in een onderzoeksprogramma, waarin de rol van kleine steden in ontwikkelingslanden centraal staat." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Binnendelta van de Niger" ;
            sgpl:text_context "Het ondervinden van konkurrentie door handelaren per sexe in % 71. 5.1 De lokatie van Mopti in de Binnendelta van de Niger in Mali 78. LIJST VAN TABELLEN." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2453348 ;
            sgpl:spatialText "Regio Mopti" ;
            sgpl:text_context "LIJST VAN FIGUREN. 3.1 Administratieve verdeling van de Regio Mopti (V) 31. 3.2 Bevolkingspyramide van Mopti (1976) 33." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2453348 ;
            sgpl:spatialText "Mopti" ;
            sgpl:text_context "INLEIDING. In deze skriptie worden de resultaten gepresenteerd van een onderzoek naar de markthandel in de stad Mopti in Mali. Het onderzoek maakt deel uit van het RESEMOS-projekt (\"Recherche Socio-économique de 1'Ensemble Urbain Mopti-Sévaré et sa Rëgion\")." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "West-Afrika" ;
            sgpl:text_context "In hoofdstuk 1 wordt aan de hand van enkele algemene theorieën over handel een kader geschetst waarbinnen het door ons uitgevoerde onderzoek geplaatst kan worden. Na deze theoretische inleiding wordt in hoofdstuk 2 in het kort ingegaan op de ontwikkeling van de handel in West-Afrika. Daarnaast wordt aandacht besteed aan de ontwikkelingsgeschiedenis van Mopti en het belang van de handel voor deze stad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2453866 ;
            sgpl:spatialText "Mali" ;
            sgpl:text_context "In deze skriptie worden de resultaten gepresenteerd van een onderzoek naar de markthandel in de stad Mopti in Mali. Het onderzoek maakt deel uit van het RESEMOS-projekt (\"Recherche Socio-économique de 1'Ensemble Urbain Mopti-Sévaré et sa Rëgion\"). Dit projekt is een samenwerkingsverband tussen de Vakgroep Sociale Geografie van Ontwikkelingslanden van de Rijksuniversiteit Utrecht en het \"Institut des Sciences Humaines\" te Bamako." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2458589 ;
            sgpl:spatialText "Djenné" ;
            sgpl:text_context "Voorafgaand aan de cycli rond Mopti werd onderzoek verricht rond de steden Djenné (het zgn. ISEDE-programma) en San (het zgn. ESES-programma). De doelstelling van het RESEMOS-projekt is, het analyseren van: - de sociaal-ekonomische struktuur van de stad Mopti en haar ommeland; - de recente veranderingen in produktie- en levenswijzen en de faktoren die hierop van invloed zijn; - de rol die steden spelen of kunnen spelen in de regionale ontwikke1ing; - verschillen tussen steden op verschillende niveau's van de urbane hiërarchie in Mali. De eerste, in 1983 gestarte fase betrof een eerste funktionele inventarisatie, met onderzoeken naar de handels-, ambachts-, industriële- en bouwsektor." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept13608 ;
            sgpl:subjectText "Markthandel" ;
            sgpl:text_context "Inleiding. In deze skriptie worden de resultaten gepresenteerd van een onderzoek naar de markthandel in de stad Mopti in Mali. Het onderzoek maakt deel uit van het RESEMOS-projekt (\"Recherche Socio-économique de 1'Ensemble Urbain Mopti-Sévaré et sa Rëgion\")." ],
        [ sgpl:refersToConcept unesco:mt6.70 ;
            sgpl:subjectText "Handelaren" ;
            sgpl:text_context "Daarnaast is er nog een groep van toeschouwers en voorbijgangers. Van de verschillende groepen marktparticipanten is de groep van de handelaren waarschijnlijk de meest komplexe. Omdat zij een centrale positie innemen in ons onderzoek, zullen we wat dieper op de verscheidenheid binnen deze groep ingaan." ],
        [ sgpl:refersToConcept unesco:concept9681 ;
            sgpl:subjectText "Vrouwelijke handelaren" ;
            sgpl:text_context "De handel speelt zodoende ook in de ekonomie van Mopti een belangrijke rol. In 1984 werd de grootste groep van de totale werkelijke beroepsbevolking gevormd door de vrouwelijke handelaren: bijna 20% (Van der Burg, 1987, p.29). Hiertoe behoren zowel de marktverkoopsters als de vele vrouwen, die voor hun woning een handeltje drijven of voedsel bereiden, dat ze vaak weer aan marktvrouwen verkopen." ],
        [ sgpl:refersToConcept unesco:concept9681 ;
            sgpl:subjectText "Vrouwelijke handelaren" ;
            sgpl:text_context "De handel speelt zodoende ook in de ekonomie van Mopti een belangrijke rol. In 1984 werd de grootste groep van de totale werkelijke beroepsbevolking gevormd door de vrouwelijke handelaren: bijna 20% (Van der Burg, 1987, p.29). Hiertoe behoren zowel de marktverkoopsters als de vele vrouwen, die voor hun woning een handeltje drijven of voedsel bereiden, dat ze vaak weer aan marktvrouwen verkopen." ],
        [ sgpl:refersToConcept unesco:mt6.70 ;
            sgpl:subjectText "Handelaren" ;
            sgpl:text_context "Daarnaast is er nog een groep van toeschouwers en voorbijgangers. Van de verschillende groepen marktparticipanten is de groep van de handelaren waarschijnlijk de meest komplexe. Omdat zij een centrale positie innemen in ons onderzoek, zullen we wat dieper op de verscheidenheid binnen deze groep ingaan." ],
        [ sgpl:refersToConcept unesco:concept13608 ;
            sgpl:subjectText "Markthandel" ;
            sgpl:text_context "Inleiding. In deze skriptie worden de resultaten gepresenteerd van een onderzoek naar de markthandel in de stad Mopti in Mali. Het onderzoek maakt deel uit van het RESEMOS-projekt (\"Recherche Socio-économique de 1'Ensemble Urbain Mopti-Sévaré et sa Rëgion\")." ] ;
    sgpl:thesisID 175 .

sgpl:Thesis176 a sgpl:SGPLThesis ;
    dcterms:creator "M. J. C. Busch",
        "Mattie Busch" ;
    dcterms:issued 1988 ;
    dcterms:title "INDUSTRIËLE TOELEVERING EN UITBESTEDING IN DE PROVINCIE UTRECHT: een verkenning" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743698,
                geonames:2749879 ;
            sgpl:spatialText "Noord- en Zuid-Holland" ;
            sgpl:text_context "Procentueel gezien blijkt het grootste gedeelte (40 tot 50%) van toelevering en uitbesteding zich af te spelen in een circel van 25 kilometer rond het bedrijf of binnen de eigen provincie. Buiten de provincie Utrecht spelen alleen Noord- en Zuid-Holland en Noord-Brabant nog enige rol van betekenis. Het opvallende feit dat geldwaarde van de levering op grotere afstand hoog ligt valt wellicht te verklaren uit het feit dat vooral toeleveranciers levering over grote afstand geen bezwaar vinden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "De bereikbaarheid van de provincie Utrecht is voor alle soorten van vervoer uitstekend te noemen. Voor het luchtverkeer ligt Schiphol niet onoverkomelijk ver weg. Voorts is Utrecht een groot landelijk spoorwegknooppunt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751316 ;
            sgpl:spatialText "Maarssen" ;
            sgpl:text_context "Opvallend is dat in en rond de stad Utrecht veel uitbestedende bedrijven zijn gevestigd. Van de 40 bedrijven zijn er 4 in Maarssen en 4 in Zeist gevestigd. In Nieuwegein liggen 3 bedrijven en in IJsselstein 2." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stad Utrecht" ;
            sgpl:text_context "De toeleverende en uitbestedende bedrijven blijken, gemeten naar omvang en bedrijfsactiviteiten niet te verschillen van het gemiddelde ge&euml;nqu&ecirc;teerde bedrijf. Opvallend is dat in en rond de stad Utrecht veel uitbestedende bedrijven zijn gevestigd. Van de 40 bedrijven zijn er 4 in Maarssen en 4 in Zeist gevestigd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "Buiten de provincie Utrecht spelen alleen Noord- en Zuid-Holland en Noord-Brabant nog enige rol van betekenis. Het opvallende feit dat geldwaarde van de levering op grotere afstand hoog ligt valt wellicht te verklaren uit het feit dat vooral toeleveranciers levering over grote afstand geen bezwaar vinden. De meeste comakerships liggen op minder dan 25 kilometer afstand van het bedrijf en in enkele gevallen zelfs binnen de gemeente waarin het bedrijf is gevestigd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "regio Amersfoort" ;
            sgpl:text_context "In de stad Utrecht zijn 4 bedrijven gevestigd. In de regio Amersfoort liggen 6 bedrijven: 2 in Soest, 2 in Baarn en 2 in Amersfoort. Voor de rest van de provincie spelen alleen de gemeenten Veenendaal en Mijdrecht met beide 3 bedrijven nog een rol." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelderland" ;
            sgpl:text_context "Opvallend is dat noch Flevoland, noch Gelderland -de beide andere aanliggende provincies- enige rol van betekenis vervullen. De relaties van deze populatie die buiten de provincie worden aangeknoopt liggen voornamelijk in de richting van Noord- en Zuid-Holland en Noord-Brabant. Over de vijfde onderzoeksvraag hoeft niet veel te worden gezegd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Voor U ligt het onderzoek 'Industriële toelevering en uitbesteding in de provincie Utrecht'. Dit onderzoek is gedaan in het kader van een doctorale afstudeerscriptie in de sociale geografie aan de Rijksuniversiteit te Utrecht. Toeleverende en uitbestedende relaties van bedrijven die gevestigd zijn binnen de provincie Utrecht worden aan de orde gesteld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1861060 ;
            sgpl:spatialText "Japan" ;
            sgpl:text_context "Deze laatste hebben immers meestal zeer lange en starre produktielijnen opgezet waarin veranderingen niet makkelijk zijn aan te brengen. In Japan werd het allereerst om het vergroten van de flexibiliteit uitbesteed. Grote bedrijven (voornamelijk autofabrikanten) concentreren zich op kernactiviteiten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745909 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "Over de rol die toeleverende en uitbestedende relaties in de vorming van een complex spelen is geen onderzoek bekend, sterker nog, naar de ruimtelijke patronen die worden veroorzaakt door toeleverende en uitbestedende relaties is praktisch geen onderzoek gepleegd. De doelstelling van dit onderzoek is een verkenning in het onderwerp toeleveren en uitbesteden te geven, waarbij inzicht wordt verkregen over hét ruimtelijke patroon dat is ontstaan in een regio (de provincie Utrecht) door bedrijven die toeleverende of uitbestedende relaties met andere bedrijven hebben en welke rol enkele moderne produktie-technische en technologische ontwikkelingen hierbij spelen. In het kader van de doelstelling is een zevental onderzoeksvragen geformuleerd waarop getracht zal worden antwoord te geven:" ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept607 ;
            sgpl:subjectText "Industriële toelevering" ;
            sgpl:text_context "Dit onderzoek is gedaan in het kader van een doctorale afstudeerscriptie in de sociale geografie aan de Rijksuniversiteit te Utrecht. Toeleverende en uitbestedende relaties van bedrijven die gevestigd zijn binnen de provincie Utrecht worden aan de orde gesteld. Daarbij wordt aandacht geschonken aan de verschillende samenwerkingsvormen en de introductie van nieuwe produktie-technische en technologische ontwikkelingen." ],
        [ sgpl:refersToConcept unesco:concept3401 ;
            sgpl:subjectText "Flexibele produktie-automatisering" ;
            sgpl:text_context "Flexibele produktie-automatisering (verder af te korten tot f.p.a.) is onontbeerlijk bij het streven naar een grotere flexibiliteit van de onderneming en de produktie. Onder f.p.a. wordt verstaan: het al dan niet met behulp van een computer sturen van werktuigen of produktieprocessen door middel van vooraf opgestelde programma's (NMB, 1985). Deze programma's kunnen al naar gelang de omstandigheden dat eisen worden aangepast (hierdoor worden deze programma's flexibel)." ],
        [ sgpl:refersToConcept unesco:concept659 ;
            sgpl:subjectText "Uitbesteding" ;
            sgpl:text_context "Gedurende de laatste 25 jaar hebben zich op het gebied van ondernemen nogal wat veranderingen voorgedaan. Eén van die veranderingen is de ontwikkeling dat steeds meer bedrijven delen van hun produktieproces gaan uitbesteden. Toeleveranciers nemen taken over die bedrijven vroeger zelf uitvoerden." ],
        [ sgpl:refersToConcept unesco:concept607 ;
            sgpl:subjectText "Industriële toelevering" ;
            sgpl:text_context "Dit onderzoek is gedaan in het kader van een doctorale afstudeerscriptie in de sociale geografie aan de Rijksuniversiteit te Utrecht. Toeleverende en uitbestedende relaties van bedrijven die gevestigd zijn binnen de provincie Utrecht worden aan de orde gesteld. Daarbij wordt aandacht geschonken aan de verschillende samenwerkingsvormen en de introductie van nieuwe produktie-technische en technologische ontwikkelingen." ],
        [ sgpl:refersToConcept unesco:concept659 ;
            sgpl:subjectText "Uitbesteding" ;
            sgpl:text_context "Gedurende de laatste 25 jaar hebben zich op het gebied van ondernemen nogal wat veranderingen voorgedaan. Eén van die veranderingen is de ontwikkeling dat steeds meer bedrijven delen van hun produktieproces gaan uitbesteden. Toeleveranciers nemen taken over die bedrijven vroeger zelf uitvoerden." ],
        [ sgpl:refersToConcept unesco:concept3401 ;
            sgpl:subjectText "Flexibele produktie-automatisering" ;
            sgpl:text_context "Flexibele produktie-automatisering (verder af te korten tot f.p.a.) is onontbeerlijk bij het streven naar een grotere flexibiliteit van de onderneming en de produktie. Onder f.p.a. wordt verstaan: het al dan niet met behulp van een computer sturen van werktuigen of produktieprocessen door middel van vooraf opgestelde programma's (NMB, 1985). Deze programma's kunnen al naar gelang de omstandigheden dat eisen worden aangepast (hierdoor worden deze programma's flexibel)." ] ;
    sgpl:thesisID 176 .

sgpl:Thesis177 a sgpl:SGPLThesis ;
    dcterms:creator "Leon Crommentuijn",
        "Marion Harms" ;
    dcterms:issued 1988 ;
    dcterms:title "BLIJVEN DE BINNENSTEDEN DE WOONGEBIEDEN VOOR DE JONGE EEN- EN TWEEPERSOONSHUISHOUDENS ?",
        "Een onderzoek in Rotterdam en Utrecht." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2752314 ;
            sgpl:spatialText "Kralingen" ;
            sgpl:text_context "In de jaren '70 veranderde de aanpak van de stadsvernieuwing. Deze tijd wordt gekenmerkt door de kleinschaligheid, het 'bouwen voor de buurt’ en de renovatie van oude woningen. Voorbeelden van deze benadering zijn talrijk en op vele plaatsen in alle steden, juist wel of nog net niet, afgerond. Als voorbeelden hiervoor kunnen we noemen Kralingen (voornamelijk renovatie) in Rotterdam en Pijlsweerd en Oudwijk (voornamelijk nieuwbouw) in Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745911 ;
            sgpl:spatialText "Gemeente Utrecht" ;
            sgpl:text_context "Verder willen we de gemeenten Utrecht en Rotterdam bedanken, voor het verstrekken van de steekproef gegevens. Onze dank gaat vooral uit naar de afdeling G.B.O.S. van de gemeente Rotterdam, met name naar de heer A. van Zundert voor de prettige samenwerking. Voorts willen wij onze kollega—studenten bedanken voor het enqueteren van de respondenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "het gebied binnen de singels" ;
            sgpl:text_context "Voor Utrecht ligt het eenvoudiger; de oude binnenstad is nog vrijwel geheel intakt. Hier is gekozen voor het gebied binnen de singels, met een kleine uitbreiding om praktische redenen. Dit is gebeurd, omdat de te gebruiken steekproef gegevens niet uit het gebied binnen de singels alleen verstrekt konden worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Toch zijn er al enkele voorbeelden van te noemen, zoals in Amsterdam de Stopera en het Oosterdok, In Den Haag de Schouwburg, in Rotterdam het plan Waterstad en in Utrecht de uitbreiding van de Jaarbeurs op het terrein van de Hojelkazerne en het winkelcentrum La Vie. Deze nieuwe aanpak is een vorm van ekonomische planning om het hart van de stad weer nieuw leven in te blazen. Het aksent ligt niet alleen meer op het wonen, maar ook op de bedrijvigheid in, en de levendigheid van, de stad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "De probleemstelling luidt aldus: \"Blijven de binnensteden de woongebieden voor de jonge één- en tweepersoonshuishoudens? Een onderzoek in Rotterdam en Utrecht. Verdere vragen die beantwoord zullen worden zijn: Komen deze jongeren oorspronkelijk uit de binnenstad, of uit andere wijken van de stad, dan wel van buiten de stad?" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Het herstel tekent zich vooral in de Noordvleugel van de Randstad af, niet in het Rotterdamse stadsgewest. Ondanks leegstand en onderbenutting van bedrijfsterreinen blijven de binnensteden aantrekkelijke gebieden, vanwege de centrale ligging en biedt deze omgeving genoeg mogelijkheden voor vernieuwing en kwalitatief hoogwaardige ekonomische funkties. Er wordt dan ook gesignaleerd, dat \"...hoewel de stadsrand en het stedelijk ommeland zich in kwantitatief opzicht tot belangrijke werkgebieden ontwikkeld hebben; vormen zij kwalitatief niet altijd een alternatief voor het grootstedelijk stadscentrum\"." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753557 ;
            sgpl:spatialText "Houten" ;
            sgpl:text_context "Deze overloop werd opgevangen in de zogenaamde groeikernen. Voor Utrecht werden op deze manier woningen gerealiseerd in de groeikernen Houten en Nieuwegein, voor Rotterdam gebeurde dit bijvoorbeeld in Capelle aan de IJssel. Een groot deel van de gezinnen die andere woonruimte zochten in Rotterdam werden echter nog opgevangen in de eigen gemeente." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "de binnenstad van Utrecht" ;
            sgpl:text_context "In Utrecht heeft men echter te maken met een vrijwel volgebouwde, monumentale binnenstad. Verder daalt hier de bevolking door de afname van de woningbezetting. Nieuwbouw zorgt alleen voor een vermindering van de bevolkingsdaling in de binnenstad van Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Recent blijkt er, uitgaande van een andere visie op het benutten van bepaalde lokaties voor woonbestemmingen, vooral in [bijv.] Amsterdam en Rotterdam aanzienlijk meer reserveruimte beschikbaar te zijn dan lange tijd werd aangenomen. Deze meer pro-stedelijke gedachte van de kompakte stad legt het aksent op het benutten van de ruimtelijke (over)kapaciteit. Tot nu toe komt dit vooral neer op een vormkoncept, wat wil zeggen dat het steeds gaat om fysieke ingrepen; zoals het bebouwen van braakliggende terreinen, of van bijvoorbeeld groenstroken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "de binnenstad van Rotterdam" ;
            sgpl:text_context "In de periode 1970-1987 heeft de gemeente Rotterdam een afname gekend van bijna 17 procent (G.B.O.S. Rotterdam). De binnenstad van Rotterdam (gedefinieerd als de wijken Stadsdriehoek, Cool en Centraal Station-kwartier) laat kwa bevolkingsaantallen een heel ander beeld zien (zie figuur 2.1.). Aanvankelijk daalde de bevolkingsomvang in de binnenstad sterk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Pijlsweerd" ;
            sgpl:text_context "Voorbeelden van deze benadering zijn talrijk en op vele plaatsen in alle steden, juist wel of nog net niet, afgerond. Als voorbeelden hiervoor kunnen we noemen Kralingen (voornamelijk renovatie) in Rotterdam en Pijlsweerd en Oudwijk (voornamelijk nieuwbouw) in Utrecht. Ook zijn talrijke woningblokken in de binnensteden gerenoveerd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "het AZU-terrein" ;
            sgpl:text_context "De gemeente Utrecht hanteert een gebiedsindeling die dit onderscheid niet mogelijk maakt. Deze toevoeging bestaat uit Hoog Catherijne, het AZU-terrein en de Vaartse buurt. Zie figuur 3.2." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Deze overloop werd opgevangen in de zogenaamde groeikernen. Voor Utrecht werden op deze manier woningen gerealiseerd in de groeikernen Houten en Nieuwegein, voor Rotterdam gebeurde dit bijvoorbeeld in Capelle aan de IJssel. Een groot deel van de gezinnen die andere woonruimte zochten in Rotterdam werden echter nog opgevangen in de eigen gemeente." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "De probleemstelling luidt aldus: \"Blijven de binnensteden de woongebieden voor de jonge één- en tweepersoonshuishoudens? Een onderzoek in Rotterdam en Utrecht. Verdere vragen die beantwoord zullen worden zijn: Komen deze jongeren oorspronkelijk uit de binnenstad, of uit andere wijken van de stad, dan wel van buiten de stad?" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912,
                geonames:2747891 ;
            sgpl:spatialText "de binnensteden van Rotterdam en Utrecht" ;
            sgpl:text_context "In het kader van het afstudeeronderzoek voor de studie Sociale Geografie, specialisatie Stad- en Plattelandsgeografie, aan de Rijksuniversiteit te Utrecht, hebben wij een onderzoek verricht in de binnensteden van Rotterdam en Utrecht. Het onderwerp van het onderzoek is door ons gekozen enerzijds omdat dit thema de laatste jaren vaak in het nieuws is geweest. Te denken valt aan de aandacht voor verschijnselen als ’gentrification’ en ‘yuppies’." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept16538 ;
            sgpl:subjectText "Urban conditioning" ;
            sgpl:text_context "Toch heeft men gekozen voor een stedelijke woonomgeving en blijft men in de toekomst hier ook voor kiezen. M.a.w. men is urbaan gekonditioneerd (theorie urban conditioning, zie Machielse, 1987, blz. 10). De twee (bovengenoemde) selektie-kriteria samen met enkele externe faktoren (o.a. toewijzingsbeleid, woningaanbod e.d.) hebben geleid tot een bepaalde woonsituatie." ],
        [ sgpl:refersToConcept unesco:concept10702 ;
            sgpl:subjectText "En- en tweepersoonshuishoudens" ;
            sgpl:text_context "Zal deze bevolkingsgroep, naarmate ze ouder wordt, overgaan tot gezinsvorming (samenwonen/trouwen/kinderen), of bewust blijven kiezen voor het handhaven van de huidige huishoudenssituatie (n dan wel twee personen)? De probleemstelling luidt aldus: 'Blijven de binnensteden de woongebieden voor de jonge n- en tweepersoonshuishoudens? Verdere vragen die beantwoord zullen worden zijn: Komen deze jongeren oorspronkelijk uit de binnenstad, of uit andere wijken van de stad, dan wel van buiten de stad?" ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Gentrification" ;
            sgpl:text_context "Het onderwerp van het onderzoek is door ons gekozen enerzijds omdat dit thema de laatste jaren vaak in het nieuws is geweest. Te denken valt aan de aandacht voor verschijnselen als 'gentrification' en 'yuppies'. Anderzijds omdat wij zelf tot de groep van jonge huishoudens behoren en een affiniteit hebben met dit onderwerp." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Gentrification" ;
            sgpl:text_context "Het onderwerp van het onderzoek is door ons gekozen enerzijds omdat dit thema de laatste jaren vaak in het nieuws is geweest. Te denken valt aan de aandacht voor verschijnselen als 'gentrification' en 'yuppies'. Anderzijds omdat wij zelf tot de groep van jonge huishoudens behoren en een affiniteit hebben met dit onderwerp." ],
        [ sgpl:refersToConcept unesco:concept10702 ;
            sgpl:subjectText "En- en tweepersoonshuishoudens" ;
            sgpl:text_context "Zal deze bevolkingsgroep, naarmate ze ouder wordt, overgaan tot gezinsvorming (samenwonen/trouwen/kinderen), of bewust blijven kiezen voor het handhaven van de huidige huishoudenssituatie (n dan wel twee personen)? De probleemstelling luidt aldus: 'Blijven de binnensteden de woongebieden voor de jonge n- en tweepersoonshuishoudens? Verdere vragen die beantwoord zullen worden zijn: Komen deze jongeren oorspronkelijk uit de binnenstad, of uit andere wijken van de stad, dan wel van buiten de stad?" ],
        [ sgpl:refersToConcept unesco:concept16538 ;
            sgpl:subjectText "Urban conditioning" ;
            sgpl:text_context "Toch heeft men gekozen voor een stedelijke woonomgeving en blijft men in de toekomst hier ook voor kiezen. M.a.w. men is urbaan gekonditioneerd (theorie urban conditioning, zie Machielse, 1987, blz. 10). De twee (bovengenoemde) selektie-kriteria samen met enkele externe faktoren (o.a. toewijzingsbeleid, woningaanbod e.d.) hebben geleid tot een bepaalde woonsituatie." ] ;
    sgpl:thesisID 177 .

sgpl:Thesis179 a sgpl:SGPLThesis ;
    dcterms:creator "Alette Froling" ;
    dcterms:issued 1988 ;
    dcterms:title "De invloed van bedrijfs-externe factoren op Servo Delden b.v." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Deze laatste zijn minder gevoelig voor economische omstandigheden en leveren een hogere toegevoegde waarde. In Europa wordt de concurrentie op de speciality-markt hierdoor heviger. In Afrika en in het Midden-Oosten komen er nieuwe commodity-producenten bij ." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2803138 ;
            sgpl:spatialText "Antwerpen" ;
            sgpl:text_context "Servo wil wel meer naar dit soort leveringen toe, maar vreest voor aanbod-onderbreking. In Antwerpen en Rotterdam zijn grote opslagtanks met produkten. Deze zijn meestal bij-produkten van grote bedrijven als Shell, die als grondstof voor Servo kunnen dienen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2757370 ;
            sgpl:spatialText "Servo Delden b.v." ;
            sgpl:text_context "Het was een grote wens van mij om mijn eigen afstudeer-onderzoek in stage-vorm binnen een bedrijf uit te voeren. Deze kon bij Servo Delden b.v. in vervulling gaan. Dit, dankzij het grote vertrouwen dat met name de heer B.H. Ameloh en Ir. R.J.M. Monninkhoff in mij stelden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2328926 ;
            sgpl:spatialText "Nigeria" ;
            sgpl:text_context "De oriëntatie op gebieden buiten Europa is sterker geworden. Dit komt vooral door een toename van de export naar Afrika, met name Nigeria. De olie-industrie is daar in 1979 ingeklapt, maar laatste jaren is de produktie weer toegenomen, omdat de voorraden op waren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3175395 ;
            sgpl:spatialText "Italië" ;
            sgpl:text_context "De ogen moeten daarbij vooral op Italië gericht worden. Italiaanse producenten hebben nu nog te maken met extreem hoge kosten bij de export van produkten. Deze vallen straks weg." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "vakgroep toegepaste geografie en ruimtelijke planning. Transitorium II, Heidelberglaan 2, De Uithof, UTRECHT (030)532044. De invloed van bedrijfs-externe factoren op Servo Delden b. v." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Servo wil wel meer naar dit soort leveringen toe, maar vreest voor aanbod-onderbreking. In Antwerpen en Rotterdam zijn grote opslagtanks met produkten. Deze zijn meestal bij-produkten van grote bedrijven als Shell, die als grondstof voor Servo kunnen dienen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De omzet van de Nederlandse chemische industrie is tussen 1970 en 1987 gestegen van 8,7 miljard gulden tot 39,5 miljard. Voor de Nederlandse industrie als geheel was er een omzetstijging van 82,5 miljard tot 253,3 miljard gulden. Uit de geïndexeerde cijfers in figuur 3.5 blijkt, dat de chemische industrie een snellere groei vertoonde dan de totale Nederlandse industrie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "BRD" ;
            sgpl:text_context "Grondstoffen en emballage komen overwegend uit Europa. Emballage komt vooral uit Nederland en grondstoffen komen veel uit de BRD, omdat Servo veel bij Huls koopt. De inkopen van handelsprodukten zijn verplaatst vanuit Nederland naar de rest van de EG." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "In het licht van de \"company strategy\" moeten alle verf-additieven-vestigingen op het westelijk halfrond ondergebracht worden bij Servo. Zo is op 1 juli 19 88 Nuodex Colortrend Maastricht b.v., een producent van kleurpasta's voor verven en chemische smeermiddelen, van Hüls gekocht. In Frankrijk is de Nuodex-vestiging een zuiver handelskantoor." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5925 ;
            sgpl:subjectText "concurrentie-analyse" ;
            sgpl:text_context "Interne concurrentie is de concurrentie tussen de ondernemingen die in de bedrijfstak opereren. De grootte hiervan is nagegaan aan de hand van een concurrentie-analyse. Een portfolio van de door Servo in 1987 geproduceerde chemicaliën laat zien, dat drie van de veertien groepen chemicaliën een groeiende markt hebben en belangrijk zijn voor Servo naar toegevoegde waarde en volume." ],
        [ sgpl:refersToConcept unesco:concept17020 ;
            sgpl:subjectText "specialities" ;
            sgpl:text_context "Binnen de chemische produkten wordt onderscheid gemaakt tussen commodities en specialities. Specialities worden op basis van hun toepassings-mogelijkheden verkocht en worden in batch geproduceerd. De producenten van commodities in Europa hebben rationalisaties doorgevoerd en nemen meer specialities in hun pakket op." ],
        [ sgpl:refersToConcept unesco:concept2240 ;
            sgpl:subjectText "bedrijfs-externe factoren" ;
            sgpl:text_context "Daarbij valt te denken aan koersfluctuaties, veranderingen in wet-en regelgeving, veranderingen in produktvraag en -aanbod en veranderende concurrentieverhoudingen. Dit onderzoek betreft een case-study naar de invloed van bedrijfs-externe factoren op het chemische bedrijf Servo Delden b.v.. Om de invloed van bedrijfs-externe factoren op het bedrijf na te kunnen gaan is eerst in hoofdstuk twee een analyse gemaakt van de interne organisatie van Servo." ],
        [ sgpl:refersToConcept unesco:concept17020 ;
            sgpl:subjectText "specialities" ;
            sgpl:text_context "Binnen de chemische produkten wordt onderscheid gemaakt tussen commodities en specialities. Specialities worden op basis van hun toepassings-mogelijkheden verkocht en worden in batch geproduceerd. De producenten van commodities in Europa hebben rationalisaties doorgevoerd en nemen meer specialities in hun pakket op." ],
        [ sgpl:refersToConcept unesco:concept5925 ;
            sgpl:subjectText "concurrentie-analyse" ;
            sgpl:text_context "Interne concurrentie is de concurrentie tussen de ondernemingen die in de bedrijfstak opereren. De grootte hiervan is nagegaan aan de hand van een concurrentie-analyse. Een portfolio van de door Servo in 1987 geproduceerde chemicaliën laat zien, dat drie van de veertien groepen chemicaliën een groeiende markt hebben en belangrijk zijn voor Servo naar toegevoegde waarde en volume." ],
        [ sgpl:refersToConcept unesco:concept2240 ;
            sgpl:subjectText "bedrijfs-externe factoren" ;
            sgpl:text_context "Daarbij valt te denken aan koersfluctuaties, veranderingen in wet-en regelgeving, veranderingen in produktvraag en -aanbod en veranderende concurrentieverhoudingen. Dit onderzoek betreft een case-study naar de invloed van bedrijfs-externe factoren op het chemische bedrijf Servo Delden b.v.. Om de invloed van bedrijfs-externe factoren op het bedrijf na te kunnen gaan is eerst in hoofdstuk twee een analyse gemaakt van de interne organisatie van Servo." ] ;
    sgpl:thesisID 179 .

sgpl:Thesis180 a sgpl:SGPLThesis ;
    dcterms:creator "Marc van Lieshout",
        "Marcel Gerards" ;
    dcterms:issued 1988 ;
    dcterms:title "UITGEVERIJEN EN TELEMATICA" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754652 ;
            sgpl:spatialText "Heerlen" ;
            sgpl:text_context "Ook bij het Limburgs Dagblad in Heerlen worden zeven dagen per week complete pagina’s van de Nihon Keizai Shimbun ontvangen. Dit Japans economisch dagblad wordt sinds 1987 in 5000 exemplaren in Heerlen gedrukt. Voor deze verbindingen is een satellietverbinding noodzakelijk (Figuur 2.3.)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743477 ;
            sgpl:spatialText "Zwolle" ;
            sgpl:text_context "Zo wordt sinds 1983 een deel van de oplage van het NRC-Handelsblad, waarvan de redactie zetelt in het centrum van Rotterdam, gedrukt in Zwolle. Deze afstand wordt overbrugd met behulp van een analoge facsimile straalverbinding. Met deze stap bouwde de Nederlandse Dagblad Unie (NDU), uitgever van onder andere het NRC-Handelsblad, voort op enkele jaren daarvoor ingezette ontwikkelingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "centrum van Rotterdam" ;
            sgpl:text_context "Deze geografische binding wordt steeds minder noodzakelijk daar de communicatie langs telecommunicatieve weg kan verlopen. Zo wordt sinds 1983 een deel van de oplage van het NRC-Handelsblad, waarvan de redactie zetelt in het centrum van Rotterdam, gedrukt in Zwolle. Deze afstand wordt overbrugd met behulp van een analoge facsimile straalverbinding." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "In 1987 waren er 23 zelfstandige dagbladondernemingen in Nederland, waarvan de Telegraaf, Elsevier NDU en de Perscombinatie de grootsten zijn. Het VNU domineert de dagbladproductie in Noord-Brabant. Ook de krantensector is derhalve niet ontsnapt aan de concernvorming." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Deze ontwikkelingen begonnen in Nederland rond 1930 op gang te komen, maar de echt grote concernvorming is zeer recent en valt in de periode 1964-1974. De oorzaak van deze fusiegolf (alleen al vijfennegentig fusies in de boekensector) kan gezocht worden in de afschaffing van de verticale prijsbinding door de Europese commissie in 1962 (Brink, 1984, p. 45- 46). Naast deze enorme verwevenheid van een zeer groot aantal uitgeverijen door onderschikkende fusies (=opkopen) waar met name de Telegraaf en Sijthoff zich op richten, zijn het vooral de nevenschikkende fusies waarmee het VNU, Elsevier, Audet en de Perscombinatie zich sterk hebben gemaakt, die het zo moeilijk maken enig gestructureerd totaaloverzicht in opbouw van deze branche te verkrijgen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5256 ;
            sgpl:subjectText "Nieuwsmedia" ;
            sgpl:text_context "Bovendien dwingt een toenemende concurrentie dat productieprocessen zo efficiënt mogelijk verlopen. De nieuwsmedia spelen, met hun gidsfunctie in een draaikolk van informatie, een centrale rol. Het uiteindelijke doel van nieuwsmedia is het verschaffen van informatie, en zij leveren op die manier een bijdrage aan de communicatie tussen organisaties en personen." ],
        [ sgpl:refersToConcept unesco:concept3810 ;
            sgpl:subjectText "Uitgeverijen" ;
            sgpl:text_context "Reeds eerder zijn onderzoeken gedaan naar toepassingen en consequenties van telematica voor enkele bedrijfstakken/sectoren. Dit onderzoek sluit hierbij aan door de uitgeverijen nader te bestuderen. Deze bedrijfstak trok de aandacht, door veelvuldige berichten in de pers en media; over fusies en overnames, vernieuwingen in zowel het proces als de produkten." ],
        [ sgpl:refersToConcept unesco:concept5824 ;
            sgpl:subjectText "Telematica" ;
            sgpl:text_context "De verwerking van informatie geschiedt steeds meer via computers en informatietransport wordt in toenemende mate tot stand gebracht via telecommunicatie. Voor de integratie van deze activiteiten heeft het begrip telematica zijn intrede gedaan. De Smidt (1986, p. 27) beschouwt organisaties als informatieverwerkers die steeds meer een beroep zullen doen op telecommunicatie en voor informatietransport een gecombineerde aanwending van computers en telecommunicatie, dus telematica, inzetten." ],
        [ sgpl:refersToConcept unesco:concept5824 ;
            sgpl:subjectText "Telematica" ;
            sgpl:text_context "De verwerking van informatie geschiedt steeds meer via computers en informatietransport wordt in toenemende mate tot stand gebracht via telecommunicatie. Voor de integratie van deze activiteiten heeft het begrip telematica zijn intrede gedaan. De Smidt (1986, p. 27) beschouwt organisaties als informatieverwerkers die steeds meer een beroep zullen doen op telecommunicatie en voor informatietransport een gecombineerde aanwending van computers en telecommunicatie, dus telematica, inzetten." ],
        [ sgpl:refersToConcept unesco:concept3810 ;
            sgpl:subjectText "Uitgeverijen" ;
            sgpl:text_context "Reeds eerder zijn onderzoeken gedaan naar toepassingen en consequenties van telematica voor enkele bedrijfstakken/sectoren. Dit onderzoek sluit hierbij aan door de uitgeverijen nader te bestuderen. Deze bedrijfstak trok de aandacht, door veelvuldige berichten in de pers en media; over fusies en overnames, vernieuwingen in zowel het proces als de produkten." ],
        [ sgpl:refersToConcept unesco:concept5256 ;
            sgpl:subjectText "Nieuwsmedia" ;
            sgpl:text_context "Bovendien dwingt een toenemende concurrentie dat productieprocessen zo efficiënt mogelijk verlopen. De nieuwsmedia spelen, met hun gidsfunctie in een draaikolk van informatie, een centrale rol. Het uiteindelijke doel van nieuwsmedia is het verschaffen van informatie, en zij leveren op die manier een bijdrage aan de communicatie tussen organisaties en personen." ] ;
    sgpl:thesisID 180 .

sgpl:Thesis181 a sgpl:SGPLThesis ;
    dcterms:creator "Harold Harleman",
        "Peter van der Loos" ;
    dcterms:issued 1988 ;
    dcterms:title "Een kwalitatief onderzoek naar logistieke dienstverlening aan buitenlandse verladers door Nederlandse transport- en expeditiebedrijven",
        "MEER DAN ROTTERDAM EN SCHIPHOL ALLEEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279858 ;
            sgpl:spatialText "Rijnmond" ;
            sgpl:text_context "Deze probleemstelling zou getoetst worden door interviews met buitenlandse ondernemingen die een Europees distributiecentrum in Nederland gevestigd hebben én die een vervoersekonomische relatie met Rotterdam en Schiphol onderhouden. Vooraf heeft om de operationalisering van deze probleemstelling verder uit te werken, een gespreksronde plaatsgevonden met een beperkt aantal personen in de onderzoeks- en beleidssfeer die vanuit hun funktie zicht hebben op de ontwikkelingen ten aanzien van Rijnmond en Schiphol. Uit deze gesprekken is naar voren gekomen dat onderzoek in de richting die de probleemstelling aangeeft, weinig zinvol is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2803138 ;
            sgpl:spatialText "Antwerpen" ;
            sgpl:text_context "Het vertrek naar België zou niet alleen betekend hebben een verlies van vierhonderd duizend te verwerken kontainers per jaar, maar het zou vooral ingehouden hebben dat de main port-positie ten aanzien van de kontainerbehandeling aangetast zou worden (zie paragraaf 4.3). Het mogelijk vertrek van Sealand naar Antwerpen of Zeebrugge werd toegeschreven aan het lagere kostenniveau van de Belgische havens en aan de bereidheid van de Belgische overheid om de beurs eens flink open te trekken. Schiphol is duur: \"De kostenontwikkeling... plaatst Schiphol hoog in de middenmoot van Europese luchthavens, met een neiging hier boven uit te gaan\" (Commissie Van der Zwan, 1986)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Westelijk Havengebied van Amsterdam" ;
            sgpl:text_context "Voorbeelden die in de literatuur herhaaldelijk naar voren komen, zijn de Amerikaanse multinationals IBM en ITT. Een ander voorbeeld is de Japanse autofabrikant Nissan. Dit bedrijf heeft in het Westelijk Havengebied van Amsterdam een opslag- en distributiecentrum voor \"motor parts\". Vanuit dit distributiecentrum worden de onderdelen op aanvraag naar de Europese dealers verzonden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759887 ;
            sgpl:spatialText "Almelo" ;
            sgpl:text_context "Dat de vestiging van een distributiecentrum ook van min of meer toevallige omstandigheden kan afhangen maakte het interview met de heer Olde Olthof duidelijk. Toen Texas Instruments voor de beslissing over de vestiging van een Europees distributiecentrum stond, beschikte men in Almelo over een produktievestiging waar op dat moment voldoende ruimte was voor de lokatie van het dis- tributiecentrum. Andere redenen waarom destijds gekozen is voor vestiging in Nederland zijn: -de ruime import- en exportervaring van Nederland; -de politieke stabiliteit in Nederland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "De ekonomische ontwikkelingsmogelijkheden van Nederland in het Europese krachtenveld worden voor een belangrijk deel in verband gebracht met de gateway-funkties van Rotterdam en Schiphol. Nadruk wordt in de Vierde nota gelegd op de noodzaak van de versterking van de positie van Rotterdam als (kontainer)-haven en Schiphol als luchtvrachthaven en de verbetering van de achterlandverbindingen van deze vervoersknooppunten. Momenteel maakt het goederentransport in nauw onderlinge samenhang met de industriële produktie een snelle herstrukturering door." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745641 ;
            sgpl:spatialText "Venlo" ;
            sgpl:text_context "Aanvullend werd opgemerkt dat ten aanzien van de beschikbaarheid van bedrijfsterrein het beleid van gemeenten een belangrijke rol kan spelen. Gemeenten als Venlo, Veghel, Nieuwegein en Hazeldonk zijn erg \"distributie-minded\". Mede door deze houding ziet men daar koncentraties van dit soort aktiviteiten ontstaan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "De ekonomische ontwikkelingsmogelijkheden van Nederland in het Europese krachtenveld worden voor een belangrijk deel in verband gebracht met de gateway-funkties van Rotterdam en Schiphol. Nadruk wordt in de Vierde nota gelegd op de noodzaak van de versterking van de positie van Rotterdam als (kontainer)-haven en Schiphol als luchtvrachthaven en de verbetering van de achterlandverbindingen van deze vervoersknooppunten. Momenteel maakt het goederentransport in nauw onderlinge samenhang met de industriële produktie een snelle herstrukturering door." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In de onlangs verschenen Vierde nota over de ruimtelijke ordening wordt de internationale distributiefunktie van Nederland sterk benadrukt. De ekonomische ontwikkelingsmogelijkheden van Nederland in het Europese krachtenveld worden voor een belangrijk deel in verband gebracht met de gateway-funkties van Rotterdam en Schiphol. Nadruk wordt in de Vierde nota gelegd op de noodzaak van de versterking van de positie van Rotterdam als (kontainer)-haven en Schiphol als luchtvrachthaven en de verbetering van de achterlandverbindingen van deze vervoersknooppunten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmegen" ;
            sgpl:text_context "Voor de vier overige landen werd een gedetailleerd keuzeproces opgezet dat zich koncentreerde op de vier volgende hoofdpunten: distributiemogelijkheden, beschikbaarheid van personeel, datakommunikatievoorzieningen en financiële regelingen. Binnen Nederland werd Nijmegen als vestigingslokatie geselek- teerd. Overwegingen die een rol bij de selektie binnen Nederland hebben gespeeld, waren onder andere de aanwezigheid van voldoende ruimte, huisvestingsmogelijkheden voor personeel en de aanslui- ting op snelwegen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745634 ;
            sgpl:spatialText "Venray" ;
            sgpl:text_context "Het internationale expeditiebedrijf Frans Maas uit Venlo en de kopieermachinefabrikant Rank Xerox uit Venray hebben samen een integraal transportbesturingssysteem ontwikkeld, waarmee pro- duktie en transport volledig op elkaar afgestemd worden. Met dit systeem valt niet alleen het transport maar ook het voorraad- beheer volledig onder de verantwoordelijkheid van Frans Maas. Om de integratie mogelijk te maken zijn de informatiesystemen van Frans Maas en Rank Xerox on-line met elkaar verbonden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept155 ;
            sgpl:subjectText "just-in-time" ;
            sgpl:text_context "Een logistiek koncept dat de laatste jaren sterk aan belang wint, is de produktie op afroep. Deze benadering wordt aangeduid met de term just-in-time-production (JITP) en is er op gericht (bijna) geheel zonder voorraden te produceren (zero stock principle). Dit is mogelijk doordat de produktie en de bestelling van grondstoffen en halffabrikaten zo lang mogelijk worden uitgesteld." ],
        [ sgpl:refersToConcept unesco:concept12783 ;
            sgpl:subjectText "internationalisering" ;
            sgpl:text_context "De opkomende flexibele automatisering en de sterk toegenomen aandacht voor logistiek alsmede de voortgaande internationalisering van het bedrijfsleven hebben grote invloed op het goederentransportproces. Deze invloed komt tot uitdrukking in organisatorische en technologische veranderingen in het transport, alsook in het toenemend belang van informatiesystemen en de veranderende betekenis van vervoersknooppunten in de (internationale) transportketens. In eerste instantie heeft dit onderzoek zich gericht op een mogelijke samenhang tussen de knooppuntfunkties van Rotterdam en Schiphol." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "logistieke dienstverlening" ;
            sgpl:text_context "Uiteindelijk heeft deze gespreksronde geleid tot de vaststelling van een nieuwe probleemstelling, te weten: Op welke wijze wordt er door Nederlandse transport- en expeditiebedrijven inhoud gegeven aan de distributiefunktie van Nederland en welke rol speelt de logistieke dienstverlening hierin? De geselekteerde transport- en expeditiebedrijven hebben voor het uitvoeren van hun internationale distributieaktiviteiten veelal aansluiting(en) op een zee- en/of luchthaven." ],
        [ sgpl:refersToConcept unesco:concept155 ;
            sgpl:subjectText "just-in-time" ;
            sgpl:text_context "Een logistiek koncept dat de laatste jaren sterk aan belang wint, is de produktie op afroep. Deze benadering wordt aangeduid met de term just-in-time-production (JITP) en is er op gericht (bijna) geheel zonder voorraden te produceren (zero stock principle). Dit is mogelijk doordat de produktie en de bestelling van grondstoffen en halffabrikaten zo lang mogelijk worden uitgesteld." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "logistieke dienstverlening" ;
            sgpl:text_context "Uiteindelijk heeft deze gespreksronde geleid tot de vaststelling van een nieuwe probleemstelling, te weten: Op welke wijze wordt er door Nederlandse transport- en expeditiebedrijven inhoud gegeven aan de distributiefunktie van Nederland en welke rol speelt de logistieke dienstverlening hierin? De geselekteerde transport- en expeditiebedrijven hebben voor het uitvoeren van hun internationale distributieaktiviteiten veelal aansluiting(en) op een zee- en/of luchthaven." ],
        [ sgpl:refersToConcept unesco:concept12783 ;
            sgpl:subjectText "internationalisering" ;
            sgpl:text_context "De opkomende flexibele automatisering en de sterk toegenomen aandacht voor logistiek alsmede de voortgaande internationalisering van het bedrijfsleven hebben grote invloed op het goederentransportproces. Deze invloed komt tot uitdrukking in organisatorische en technologische veranderingen in het transport, alsook in het toenemend belang van informatiesystemen en de veranderende betekenis van vervoersknooppunten in de (internationale) transportketens. In eerste instantie heeft dit onderzoek zich gericht op een mogelijke samenhang tussen de knooppuntfunkties van Rotterdam en Schiphol." ] ;
    sgpl:thesisID 181 .

sgpl:Thesis182 a sgpl:SGPLThesis ;
    dcterms:creator "Robert Hassink" ;
    dcterms:issued 1988 ;
    dcterms:title "INNOVATIEBEVORDERING IN BADEN-WUERTTEMBERG",
        "Op zoek naar een verklaring voor een economisch succes" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2867714 ;
            sgpl:spatialText "regio Munchen" ;
            sgpl:text_context "Van de twee zuidelijke deelstaten Beieren en Bad en-Wur t temberg is bij de eerste duidelijk sprake van een concentratie van economische groei in de regio Munchen, ter- wijl Baden-Wurttemberg zich kenmerkt door kleine regionale groeiverschi11en. Omdat het uit regionaal-politiek opzicht interessant is om te kijken naar een succes gebied met gespreide economische groei, is gekozen voor een nadere bestudering van de deelstaat Baden-Wurttemberg. Voor het regionale beleid in Nederland is het leerzaam om te k ij ken naar het zelforganiserend vermogen van zo’n succesregio." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "West-Duitsland" ;
            sgpl:text_context "Deze verschuivingen voltrekken zich tevens binnen landen. Dit hoofdstuk bekijkt de economische verschuivingen binnen West-Duitsland. Onder deze verschuivingen moet niet alleen het migreren van mensen en bedrijven van de ene naar de andere regio verstaan worden, maar vooral de verschillen in economische ontwikkeling tussen de ene en de andere regio." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2946447 ;
            sgpl:spatialText "Bonn" ;
            sgpl:text_context "Daarbij is niet alleen gebruik gemaakt van verschillende bibliotheken in Nederland, maar ook van documentatiecentra in Bonn. Voor hoofdstuk 4 zijn in de laatste twee weken van juni zo’n 25 interviews afgenomen met kleine innovatieve bedrijven en technologiebevorderende instanties in verschillende delen van Baden-Wurttemberg. Daarnaast zijn tijdens die reis ook verschillende litatuurbronnen gevonden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Bondsrepubliek Duitsland" ;
            sgpl:text_context "De heer R. Hassink biedt in de voor U liggende doctoraalscriptie economische geografie een analyse van de verschuiving van het economisch zwaartepunt in de Bondsrepubliek Duitsland. Binnen dit kader bespreekt hij het economisch profiel van Baden-Wurttemberg en maakt hij een doorsteek naar de innovatieve bedrijvigheid in deze deelstaat. De praktijk van de innovatiebevordering in de onderscheidene regio’s wordt aan de hand van tijdens veldwerk verzameld materiaal en talrijke interviews uitvoerig geschetst." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2953481 ;
            sgpl:spatialText "Baden-WÜrttemberg" ;
            sgpl:text_context "Het komt steeds meer aan op wat dan heet het zelforganiserend vermogen van de regio met benutting van eigen potenties. Welke potenties heeft zo’n groeiregio, in dit geval Baden-WÜrttemberg? In dit voormalige armenhuis van Europa huist nu een veelheid van uiterst groeizame innovatieve bedrijven, waarbij vooral de rol van het midden- en kleinbedrijf in het oog springt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Deze publicatie fungeert tevens als achtergronddocument voor een werkbezoek van Nederlandse experts inzake regionaal innovatiebeleid aan Baden-WÜrttemberg in september 1988, georganiseerd door STOGO. In dit voormalige armenhuis van Europa huist nu een veelheid van uiterst groeizame innovatieve bedrijven, waarbij vooral de rol van het midden- en kleinbedrijf in het oog springt. Voor het Nederlandse regionaal technologiebeleid is dit een belangwekkende uitdaging om aan de eigen inspanningen de spiegel voor te houden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2951839 ;
            sgpl:spatialText "Beieren" ;
            sgpl:text_context "Van de twee zuidelijke deelstaten Beieren en Bad en-Wur t temberg is bij de eerste duidelijk sprake van een concentratie van economische groei in de regio Munchen, ter- wijl Baden-Wurttemberg zich kenmerkt door kleine regionale groeiverschi11en. Omdat het uit regionaal-politiek opzicht interessant is om te kijken naar een succes gebied met gespreide economische groei, is gekozen voor een nadere bestudering van de deelstaat Baden-Wurttemberg. Voor het regionale beleid in Nederland is het leerzaam om te k ij ken naar het zelforganiserend vermogen van zo’n succesregio." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2825297 ;
            sgpl:spatialText "Stuttgart" ;
            sgpl:text_context "Zo concentreert de economische ontwikkeling in Beieren zich voornamelijk in de regio Munchen, terwijl binnen de deelstaat Baden-Wurttemberg vooral het noordelijke deel (Stuttgart, Karlsruhe, Mannheim) van economisch belang is. In de tweede plaats wijzen de indicatoren veelal op de ontwikkelingen van bepaalde economische gegevens. Deze ontwikkelingen geven lang niet altijd aan dat het Zuiden een economische voorsprong heeft op het Noorden, maar dat het Zuiden bezig is aan een inhaalrace (van Rijn, 1987, p.85)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2873891 ;
            sgpl:spatialText "Mannheim" ;
            sgpl:text_context "Zo concentreert de economische ontwikkeling in Beieren zich voornamelijk in de regio Munchen, terwijl binnen de deelstaat Baden-Wurttemberg vooral het noordelijke deel (Stuttgart, Karlsruhe, Mannheim) van economisch belang is. In de tweede plaats wijzen de indicatoren veelal op de ontwikkelingen van bepaalde economische gegevens. Deze ontwikkelingen geven lang niet altijd aan dat het Zuiden een economische voorsprong heeft op het Noorden, maar dat het Zuiden bezig is aan een inhaalrace (van Rijn, 1987, p.85)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2892794 ;
            sgpl:spatialText "Karlsruhe" ;
            sgpl:text_context "Zo concentreert de economische ontwikkeling in Beieren zich voornamelijk in de regio Munchen, terwijl binnen de deelstaat Baden-Wurttemberg vooral het noordelijke deel (Stuttgart, Karlsruhe, Mannheim) van economisch belang is. In de tweede plaats wijzen de indicatoren veelal op de ontwikkelingen van bepaalde economische gegevens. Deze ontwikkelingen geven lang niet altijd aan dat het Zuiden een economische voorsprong heeft op het Noorden, maar dat het Zuiden bezig is aan een inhaalrace (van Rijn, 1987, p.85)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept113 ;
            sgpl:subjectText "regionaal technologiebeleid" ;
            sgpl:text_context "In hoeverre is er in Baden-Wurttemberg sprake van een specifieke oververtegenwoordiging van innovatieve bedrijvigheid en met welke externe factoren worden deze bedrijven in deze deelstaat geconfronteerd? Wat is de aard van het regionale technologiebeleid in Baden-Wurttemberg en wat zijn de economische en ruimtelijke effecten en voorwaarden voor dat beleid? Wat kan de Nederlandse overheid leren van het technologie-adviesnetwerk in Baden-Wurttemberg?" ],
        [ sgpl:refersToConcept unesco:concept17170 ;
            sgpl:subjectText "innovatiebevordering" ;
            sgpl:text_context "Baden-Wurttemberg vervult, als het gaat om technologiepolitiek op deelstaatniveau, een voortrekkersrol in West-Duitland. De innovatiebevordering in Baden-Wurttemberg heeft al een zeer lange traditie. Al in de vorige eeuw werd door Ferdinand von Steinbeis en Heinrich Meidinger begonnen met een industrie- en innovatiebevorderend beleid." ],
        [ sgpl:refersToConcept unesco:concept2600 ;
            sgpl:subjectText "technologietransfer" ;
            sgpl:text_context "De technologiepolitiek die vanaf 1978 in Baden-Wurttemberg ontstaat, kent drie zwaartepunten (Ministerium fur Wissenschaft und Kunst Baden-Wurttemberg, 1987, p.27). Vervolgens is de technologietransfer een belangrijk onderdeel van de technologiepolitiek in Baden-Wurttemberg. In de volgende paragraaf zal hier verder op in worden gegaan." ],
        [ sgpl:refersToConcept unesco:concept113 ;
            sgpl:subjectText "regionaal technologiebeleid" ;
            sgpl:text_context "In hoeverre is er in Baden-Wurttemberg sprake van een specifieke oververtegenwoordiging van innovatieve bedrijvigheid en met welke externe factoren worden deze bedrijven in deze deelstaat geconfronteerd? Wat is de aard van het regionale technologiebeleid in Baden-Wurttemberg en wat zijn de economische en ruimtelijke effecten en voorwaarden voor dat beleid? Wat kan de Nederlandse overheid leren van het technologie-adviesnetwerk in Baden-Wurttemberg?" ],
        [ sgpl:refersToConcept unesco:concept2600 ;
            sgpl:subjectText "technologietransfer" ;
            sgpl:text_context "De technologiepolitiek die vanaf 1978 in Baden-Wurttemberg ontstaat, kent drie zwaartepunten (Ministerium fur Wissenschaft und Kunst Baden-Wurttemberg, 1987, p.27). Vervolgens is de technologietransfer een belangrijk onderdeel van de technologiepolitiek in Baden-Wurttemberg. In de volgende paragraaf zal hier verder op in worden gegaan." ],
        [ sgpl:refersToConcept unesco:concept17170 ;
            sgpl:subjectText "innovatiebevordering" ;
            sgpl:text_context "Baden-Wurttemberg vervult, als het gaat om technologiepolitiek op deelstaatniveau, een voortrekkersrol in West-Duitland. De innovatiebevordering in Baden-Wurttemberg heeft al een zeer lange traditie. Al in de vorige eeuw werd door Ferdinand von Steinbeis en Heinrich Meidinger begonnen met een industrie- en innovatiebevorderend beleid." ] ;
    sgpl:thesisID 182 .

sgpl:Thesis183 a sgpl:SGPLThesis ;
    dcterms:creator "A. Loggers",
        "J. Hogenbirk" ;
    dcterms:issued 1988 ;
    dcterms:title "1983 - 1988",
        "Dynamiek van de commerciële vastgoedmarkt" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Het overheidsbeleid met betrekking tot de kantoren en bedrijfsruimtesector is onlangs verwoord in de Vierde Nota over de Ruimtelijke Ordening. In deze nota wordt gekozen voor de bevordering van economische ontwikkelingen in een beperkt aantal 'stedelijke knooppunten': Amsterdam, Rotterdam, Den Haag, Utrecht, Groningen, Enschede/Hengelo, Arnhem-Nijmegen, Eindhoven en Maastricht/Heerlen. Onderzocht zal worden welke rol de gekozen stedelijke knooppunten in de onderzochte periode hebben gespeeld op de vastgoedmarkt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Flevopolders" ;
            sgpl:text_context "Evenals het totale metrage van de in gebruik zijnde kantoorruimte is het aanbod het hoogste in de vier grote steden. Eveneens aanzienlijke aanbodvolumen zijn aanwezig geweest in de gebieden rond Den Haag (onder andere Zoetermeer, Rijswijk en Voorburg), de Flevopolders en Eindhoven. Naast de vier grote steden vallen zij in de hoogste aanbodscategorie (boven de 25.000 m2 jaarlijks)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:10173839 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "In Amsterdam, Rotterdam, Eindhoven en opvallenderwijs Den Haag zijn de meeste meters opgenomen door deze gebruikerscategorie; Utrecht bleef qua opname hierbij achter. Ook rond Schiphol en de Flevopolders is een relatief omvangrijk metrage verhandeld. Ten oosten van Utrecht (centaal gelegen in Nederland) ligt de opname eveneens op een hoog niveau." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Groot-Utrecht" ;
            sgpl:text_context "Een verklaring hiervoor is dat in de software-branche voornamelijk wordt gewerkt met standaardpakketten en minder met een op de individuele cliënt toegesneden product. Het heeft geleid tot een sterke concentratie van deze branche in Groot-Utrecht (Utrecht inclusief Nieuwegein, Maarssen, Vleuten-De Meern, Houten en Zeist). In Amsterdam is in de beschouwde periode ruim 75.000 m2 door de computersector opgenomen op de vrije markt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "De doelstelling van dit onderzoek is daarom de volgende: 'Het geven van een beeld van de ontwikkelingen op de vastgoedmarkt, met als invalshoek een ruimtelijke vergelijking tussen gebieden, met name tussen de Randstad en overig Nederland, tussen steden en de omliggende regio's en tussen gebieden binnen de steden.' Uit deze doelstelling zijn een aantal onderzoekvragen te selecteren:" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "de vier grote steden" ;
            sgpl:text_context "In de beschouwde periode heeft het aanbod voor een groot aantal van deze gebieden minimaal 15.000 m2 bedragen. Evenals het totale metrage van de in gebruik zijnde kantoorruimte is het aanbod het hoogste in de vier grote steden. Eveneens aanzienlijke aanbodvolumen zijn aanwezig geweest in de gebieden rond Den Haag (onder andere Zoetermeer, Rijswijk en Voorburg), de Flevopolders en Eindhoven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam Zuidoost" ;
            sgpl:text_context "Rotterdam is uiteraard een van deze gebieden, evenals Schiphol en omgeving. Opvallend is de grote opname van transport- en opslagbedrijven langs de A2 tussen Utrecht en Amsterdam (Maarssenbroek en Amsterdam Zuidoost). Resumerend kan gesteld worden dat de opname van bedrijfsruimte op de vrije markt voornamelijk plaats heeft gevonden in de sectoren industrie en openbare nutsbedrijven, handels- en reparatiebedrijven en transport en opslag bedrijven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Het overheidsbeleid met betrekking tot de kantoren en bedrijfsruimtesector is onlangs verwoord in de Vierde Nota over de Ruimtelijke Ordening. In deze nota wordt gekozen voor de bevordering van economische ontwikkelingen in een beperkt aantal 'stedelijke knooppunten': Amsterdam, Rotterdam, Den Haag, Utrecht, Groningen, Enschede/Hengelo, Arnhem-Nijmegen, Eindhoven en Maastricht/Heerlen. Onderzocht zal worden welke rol de gekozen stedelijke knooppunten in de onderzochte periode hebben gespeeld op de vastgoedmarkt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het voor U liggende verslag is het resultaat van een onderzoek dat is uitgevoerd in het kader van een doctoraalstudie economische geografie aan de Rijksuniversiteit Utrecht. Er zal worden getracht een beeld te geven van de ontwikkelingen op de kantoor- en bedrijfsruimtemarkt in Nederland in de jaren 1983-1988. Het onderzoek is uitgevoerd in opdracht van en samenwerking met Zadelhoff Makelaars & Co. C.V.." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Het overheidsbeleid met betrekking tot de kantoren en bedrijfsruimtesector is onlangs verwoord in de Vierde Nota over de Ruimtelijke Ordening. In deze nota wordt gekozen voor de bevordering van economische ontwikkelingen in een beperkt aantal 'stedelijke knooppunten': Amsterdam, Rotterdam, Den Haag, Utrecht, Groningen, Enschede/Hengelo, Arnhem-Nijmegen, Eindhoven en Maastricht/Heerlen. Onderzocht zal worden welke rol de gekozen stedelijke knooppunten in de onderzochte periode hebben gespeeld op de vastgoedmarkt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "overig Nederland" ;
            sgpl:text_context "De doelstelling van dit onderzoek is daarom de volgende: 'Het geven van een beeld van de ontwikkelingen op de vastgoedmarkt, met als invalshoek een ruimtelijke vergelijking tussen gebieden, met name tussen de Randstad en overig Nederland, tussen steden en de omliggende regio's en tussen gebieden binnen de steden.' Uit deze doelstelling zijn een aantal onderzoekvragen te selecteren:" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Het overheidsbeleid met betrekking tot de kantoren en bedrijfsruimtesector is onlangs verwoord in de Vierde Nota over de Ruimtelijke Ordening. In deze nota wordt gekozen voor de bevordering van economische ontwikkelingen in een beperkt aantal 'stedelijke knooppunten': Amsterdam, Rotterdam, Den Haag, Utrecht, Groningen, Enschede/Hengelo, Arnhem-Nijmegen, Eindhoven en Maastricht/Heerlen. Onderzocht zal worden welke rol de gekozen stedelijke knooppunten in de onderzochte periode hebben gespeeld op de vastgoedmarkt." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept669 ;
            sgpl:subjectText "bedrijfsruimte" ;
            sgpl:text_context "In het onderzoek komen zowel de kantoren- als de bedrijfsruimtesector aan bod, terwijl ook het onderscheid tussen beide sectoren zal worden aangegeven. Er is gekozen voor een ondergrens van 500 m2 (bruto) voor kantoren en van 750 m2 voor bedrijfsruimte, zodat kleine aanbodobjecten en transacties buiten beschouwing kunnen worden gelaten. Onder bedrijfsruimte wordt in dit onderzoek productie- en distributieruimten verstaan." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "zakelijke dienstverlening" ;
            sgpl:text_context "Voor deze merendeels contactgevoelige bedrijven wordt aan agglomeratie-voordelen veel betekenis gehecht in de vestigingsplaatskeuze. Met name de Randstad kent dientengevolge een relatief omvangrijke zakelijke dienstverlening. In toenemende mate vindt er een internationalisering plaats van zakelijke dienstverlening, hetgeen inhoudt dat er steeds meer diensten worden geëxporteerd (nu ongeveer 107. van de omzet)." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "kantorenmarkt" ;
            sgpl:text_context "De verwachting is dat in de nabije toekomst de zakelijke dienstverlening nog in arbeidsvolume toe zal nemen. Deze groei er. het aangaan van samenwerkingsverbanden zal mogelijk resulteren in aanzienlijke ontwikkelingen op de kantorenmarkt. B.2. HET AANBOD. Welke omvang en eigenschappen heeft het aanbod?" ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "zakelijke dienstverlening" ;
            sgpl:text_context "Voor deze merendeels contactgevoelige bedrijven wordt aan agglomeratie-voordelen veel betekenis gehecht in de vestigingsplaatskeuze. Met name de Randstad kent dientengevolge een relatief omvangrijke zakelijke dienstverlening. In toenemende mate vindt er een internationalisering plaats van zakelijke dienstverlening, hetgeen inhoudt dat er steeds meer diensten worden geëxporteerd (nu ongeveer 107. van de omzet)." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "kantorenmarkt" ;
            sgpl:text_context "De verwachting is dat in de nabije toekomst de zakelijke dienstverlening nog in arbeidsvolume toe zal nemen. Deze groei er. het aangaan van samenwerkingsverbanden zal mogelijk resulteren in aanzienlijke ontwikkelingen op de kantorenmarkt. B.2. HET AANBOD. Welke omvang en eigenschappen heeft het aanbod?" ],
        [ sgpl:refersToConcept unesco:concept669 ;
            sgpl:subjectText "bedrijfsruimte" ;
            sgpl:text_context "In het onderzoek komen zowel de kantoren- als de bedrijfsruimtesector aan bod, terwijl ook het onderscheid tussen beide sectoren zal worden aangegeven. Er is gekozen voor een ondergrens van 500 m2 (bruto) voor kantoren en van 750 m2 voor bedrijfsruimte, zodat kleine aanbodobjecten en transacties buiten beschouwing kunnen worden gelaten. Onder bedrijfsruimte wordt in dit onderzoek productie- en distributieruimten verstaan." ] ;
    sgpl:thesisID 183 .

sgpl:Thesis185 a sgpl:SGPLThesis ;
    dcterms:creator "P.H.M. van Laarhoven",
        "Peter van Laarhoven" ;
    dcterms:issued 1988 ;
    dcterms:title "DISTRIBUTIE - PLANOLOGISCH ONDERZOEK IN DE NIEUWBOUWWIJK HAAGSE BEEMDEN IN BREDA",
        "De mogelijkheden om tot realisering van een wijkwinkelcentrum te komen" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Resteren" ;
            sgpl:text_context "Voor de winkelstruktuur werd daarin uitgegaan van een wijknivo waarin naast een wijkwinkelcentrum in Heksenwiel plaats is voor twee buurtwinkelcentra in de buurten Gageldonk en Paradijs en een steunpunt in de buurt Resteren (zie figuur 1.1; pagina 6). De laatste jaren zijn er nogal wat beleidsaanpassingen geweest ten aanzien van de ontwikkeling van Haagse Beemden. Vooral van belang voor de winkelvoorzieningen zijn dat:" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Overkroeten" ;
            sgpl:text_context "Momenteel wordt het buurtplan voor het noordelijke gebied Heksenwiel/Overkroeten opgesteld (gem. Breda, 1988). In dit buurtplan wordt het juridische toelatings- kader van het globaal bestemmingsplan vertaald in operationele uitgangspunten en randvoorwaarden voor de bouwplannen. In genoemd buurtplan wordt gedacht aan het realiseren van het wijkcentrum in één keer omdat alleen dan kwaliteit gewaar- borgd lijkt te kunnen worden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Muizenberg" ;
            sgpl:text_context "In plaats daarvan komt het buurtwinkelcentrum \"De Berg\" op de grens tussen de buurten Resteren en Muizenberg. Het geplande winkelcentrum in de buurt Gageldonk blijft op buurtnivo gehandhaafd. Aan de hand van tussentijdse (deel)studies is besloten dat in principe het nivo van bewinkeling op wijknivo gehandhaafd kan blijven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Voorwoord Deze rapportage dient ter afronding van mijn studie Sociale Geografie aan de Fakulteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het vormt een weergave van een distributie-planologisch onderzoek dat ik in de nieuwbouwwijk Haagse Beemden in de gemeente Breda verricht heb. De keuze van een studieprojekt in Breda was voor mij voor de handliggend omdat ik werkzaam was en nog steeds ben bij de Sociografische Dienst van de gemeente Breda." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda-Noord" ;
            sgpl:text_context "De overwegingen die een rol hebben gespeeld bij het handhaven van een eventueel te realiseren wijkwinkelcentrum in de buurt Heksenwiel zijn dat: a. Bestudering van de uitbreidingsmogelijkheden van het reeds aanwezige buurt- winkelcentrum in Gageldonk tot wijkwinkelcentrum toonde aan dat een en ander niet realiseerbaar is. b. Bij situering van het wijkcentrum aan de westzijde van het plangebied is te verwachten dat voor veel inwoners van Haagse Beemden het in Breda-Noord gelegen wijkwinkelcentrum Moerwijk (zie figuur 3.1; pagina 22) aantrekkelijker zal blijven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "de binnenstad van Breda" ;
            sgpl:text_context "Wanneer sprake is van noodgedwongen gebruik van winkels buiten de wijk Haagse Beemden dan blijkt dat bij de dagelijkse winkels het winkelcentrum Meerwijk veruit het meest wordt genoemd als winkellokatie. Bij de niet-dagelijkse winkels is de binnenstad van Breda van groot belang (tabel 3.5). De vragen 37 en 38 hebben betrekking op het tot de beschikking hebben van een auto en het gebruik daarvan bij het bezoek aan zes met name genoemde winkellokaties." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Heksenwiel" ;
            sgpl:text_context "Voor de winkelstruktuur werd daarin uitgegaan van een wijknivo waarin naast een wijkwinkelcentrum in Heksenwiel plaats is voor twee buurtwinkelcentra in de buurten Gageldonk en Paradijs en een steunpunt in de buurt Resteren (zie figuur 1.1; pagina 6). De laatste jaren zijn er nogal wat beleidsaanpassingen geweest ten aanzien van de ontwikkeling van Haagse Beemden. Vooral van belang voor de winkelvoorzieningen zijn dat:" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748720 ;
            sgpl:spatialText "Paradijs" ;
            sgpl:text_context "Voor de winkelstruktuur werd daarin uitgegaan van een wijknivo waarin naast een wijkwinkelcentrum in Heksenwiel plaats is voor twee buurtwinkelcentra in de buurten Gageldonk en Paradijs en een steunpunt in de buurt Resteren (zie figuur 1.1; pagina 6). De laatste jaren zijn er nogal wat beleidsaanpassingen geweest ten aanzien van de ontwikkeling van Haagse Beemden. Vooral van belang voor de winkelvoorzieningen zijn dat:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750753 ;
            sgpl:spatialText "Moerwijk" ;
            sgpl:text_context "Bij situering van het wijkcentrum aan de westzijde van het plangebied is te verwachten dat voor veel inwoners van Haagse Beemden het in Breda-Noord gelegen wijkwinkelcentrum Moerwijk (zie figuur 3.1; pagina 22) aantrekkelijker zal blijven. Momenteel zijn de twee buurtwinkelcentra gerealiseerd. Het winkelcentrum \"De Berg\" is in oktober 1987 geopend." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759259 ;
            sgpl:spatialText "Belcrum" ;
            sgpl:text_context "Bij de 'eigen centra' kwamen de solitair gelegen supermarkten in de buurt Belcrum vaak naar voren. Om die reden is Belcrum dan ook later als aparte kategorie toegevoegd. Per branche is nu na te gaan waar de bewoners van Haagse Beemden meestal hun winkels bezoeken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755774 ;
            sgpl:spatialText "Gageldonk" ;
            sgpl:text_context "Voor de winkelstruktuur werd daarin uitgegaan van een wijknivo waarin naast een wijkwinkelcentrum in Heksenwiel plaats is voor twee buurtwinkelcentra in de buurten Gageldonk en Paradijs en een steunpunt in de buurt Resteren (zie figuur 1.1; pagina 6). De laatste jaren zijn er nogal wat beleidsaanpassingen geweest ten aanzien van de ontwikkeling van Haagse Beemden. Vooral van belang voor de winkelvoorzieningen zijn dat:" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755034 ;
            sgpl:spatialText "Haagse Beemden" ;
            sgpl:text_context "Het vormt een weergave van een distributie-planologisch onderzoek dat ik in de nieuwbouwwijk Haagse Beemden in de gemeente Breda verricht heb. De keuze van een studieprojekt in Breda was voor mij voor de handliggend omdat ik werkzaam was en nog steeds ben bij de Sociografische Dienst van de gemeente Breda. De begeleiding vanuit de Vakgroep Toegepaste Geografie & Ruimtelijke Planning, waarbinnen ik mijn studie heb verricht, berustte bij de heer drs." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748448 ;
            sgpl:spatialText "Prinsenbeek" ;
            sgpl:text_context "Het zuidelijk deel van de wijk richt zich in belangrijkere mate op de Lunet. Ook vanuit het westelijk deel is er een grotere oriëntatie op de Lunet. Dit gebied oriënteert zich ook frekwenter op de winkels in Prinsenbeek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "Het vormt een weergave van een distributie-planologisch onderzoek dat ik in de nieuwbouwwijk Haagse Beemden in de gemeente Breda verricht heb. De keuze van een studieprojekt in Breda was voor mij voor de handliggend omdat ik werkzaam was en nog steeds ben bij de Sociografische Dienst van de gemeente Breda. De begeleiding vanuit de Vakgroep Toegepaste Geografie & Ruimtelijke Planning, waarbinnen ik mijn studie heb verricht, berustte bij de heer drs." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "gemeente Breda" ;
            sgpl:text_context "Deze rapportage dient ter afronding van mijn studie Sociale Geografie aan de Fakulteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het vormt een weergave van een distributie-planologisch onderzoek dat ik in de nieuwbouwwijk Haagse Beemden in de gemeente Breda verricht heb. De keuze van een studieprojekt in Breda was voor mij voor de handliggend omdat ik werkzaam was en nog steeds ben bij de Sociografische Dienst van de gemeente Breda." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7877 ;
            sgpl:subjectText "Distributie-planologisch onderzoek" ;
            sgpl:text_context "Deze in het buurtplan neergelegde ideeën stemmen niet overeen met het globale bestemmingsplan (gem. Breda, 1986) en met een adviesnota, geschreven naar aanleiding van het globale bestemmingsplan, van de Provinciale Planologische Commissie (P.P.C., 1987). De Provinciale Planologische Commissie verleent slechts dan goedkeuring aan het onderdeel winkelvoorzieningen in het buurtplan als ten aanzien van dat onderdeel een hernieuwd distributie-planologisch onderzoek gehouden wordt. De achtergronden van deze beslissing zijn niet nader gespecificeerd weergegeven." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "Koopgedrag" ;
            sgpl:text_context "Bij de beschrijving daarvan wordt een tweedeling aangebracht. Enerzijds wordt aandacht besteed aan branches die voorkomen in de 'voedings- en genotmiddelen sektor' en anderzijds wordt het koopgedrag in branches uit de 'sektor van de duurzame en overige goederen' belicht. Alvorens in de paragrafen 3.3.b respektievelijk 3.3.C dit koopgedrag in beide sektoren te beschrijven, zal een aantal algemene enquête-resultaten de revue passeren (paragraaf 3.3.a)." ],
        [ sgpl:refersToConcept unesco:concept649 ;
            sgpl:subjectText "Winkelvoorzieningen" ;
            sgpl:text_context "Naast de gemeente (Dienst Economische Zaken en Werkgelegenheid, Sociografische Dienst) en het Rijksconsulentschap voor Handel, Ambachten en Diensten heeft ook het bedrijfsleven (Kamer van Koophandel en Fabrieken, winkeliersverenigingen) zitting in deze werkgroep. In deze werkgroep wordt aandacht besteed aan de gewenste situatie ten aanzien van de winkelvoorzieningen in de buurten en wijken van Breda. In dat kader zijn onder andere doelstellingen geformuleerd." ],
        [ sgpl:refersToConcept unesco:concept7877 ;
            sgpl:subjectText "Distributie-planologisch onderzoek" ;
            sgpl:text_context "Deze in het buurtplan neergelegde ideeën stemmen niet overeen met het globale bestemmingsplan (gem. Breda, 1986) en met een adviesnota, geschreven naar aanleiding van het globale bestemmingsplan, van de Provinciale Planologische Commissie (P.P.C., 1987). De Provinciale Planologische Commissie verleent slechts dan goedkeuring aan het onderdeel winkelvoorzieningen in het buurtplan als ten aanzien van dat onderdeel een hernieuwd distributie-planologisch onderzoek gehouden wordt. De achtergronden van deze beslissing zijn niet nader gespecificeerd weergegeven." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "Koopgedrag" ;
            sgpl:text_context "Bij de beschrijving daarvan wordt een tweedeling aangebracht. Enerzijds wordt aandacht besteed aan branches die voorkomen in de 'voedings- en genotmiddelen sektor' en anderzijds wordt het koopgedrag in branches uit de 'sektor van de duurzame en overige goederen' belicht. Alvorens in de paragrafen 3.3.b respektievelijk 3.3.C dit koopgedrag in beide sektoren te beschrijven, zal een aantal algemene enquête-resultaten de revue passeren (paragraaf 3.3.a)." ],
        [ sgpl:refersToConcept unesco:concept649 ;
            sgpl:subjectText "Winkelvoorzieningen" ;
            sgpl:text_context "Naast de gemeente (Dienst Economische Zaken en Werkgelegenheid, Sociografische Dienst) en het Rijksconsulentschap voor Handel, Ambachten en Diensten heeft ook het bedrijfsleven (Kamer van Koophandel en Fabrieken, winkeliersverenigingen) zitting in deze werkgroep. In deze werkgroep wordt aandacht besteed aan de gewenste situatie ten aanzien van de winkelvoorzieningen in de buurten en wijken van Breda. In dat kader zijn onder andere doelstellingen geformuleerd." ] ;
    sgpl:thesisID 185 .

sgpl:Thesis186 a sgpl:SGPLThesis ;
    dcterms:creator "B. van Rheenen",
        "Bert van Rheenen" ;
    dcterms:issued 1988 ;
    dcterms:title "\"case-study\": de visserskoöperatie in Bintulu, Sarawak, 1985",
        "KOÖPERATIE : EEN KANS VOOR EKONOMISCH ZWAKKE GROEPEN ?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:1733038 ;
            sgpl:spatialText "Sarawak" ;
            sgpl:text_context "Sarawak, sinds 1963 een van de staten van de Federatie \"Malaysia\", ligt in Oost-Maleisië, d.w.z. op de noordwest kust van het eiland Borneo. Sarawak is de grootste staat van de Federatie: met 124.450 km2 omvat het 38 % van de totale landoppervlakte. De staat is opgedeeld in zeven Divisies, die elk weer onderverdeeld zijn in Distrikten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1733045 ;
            sgpl:spatialText "West-Maleisië" ;
            sgpl:text_context "Dit samenwerkingsverband heeft geleid tot een aantal vissers-onderzoeken in West-Maleisië, Sabah en Sarawak. In laatstgenoemde staat werden op uitnodiging van SERU-Sarawak sociaal-ekonomische onderzoeken verricht naar de status van vissers en hun toegang tot en gebruik van overheidssteun. In 1985 werd onderzoek gedaan in Bintulu, waarin de veranderende mogelijkheden van de visserij (als gevolg van moderne, industriële ontwikkelingen, gebaseerd op de vondst van aardgas en -olie in de regio) centraal stonden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1735634 ;
            sgpl:spatialText "Kuching" ;
            sgpl:text_context "Bintulu-Town (zie kaart 3) is gelegen aan de kust, ongeveer 360 km ten noordoosten van Kuching, de hoofdstad van de Staat. De meeste grote kampongs in het Distrikt liggen in de nabijheid van Bintulu-Town; Kuala Tatau en Tatau liggen verder weg (resp. 30 en 35 km ten zuidwesten). Een grote rivier, de Kemena, doorstroomt het Distrikt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Sociaal Geografisch Instituut, Rijksuniversiteit Utrecht, Vakgroep Sociale Geografie der Ontwikkelingslanden. Utrecht, juli 1988. Bert van Rheenen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1733045 ;
            sgpl:spatialText "Maleisië" ;
            sgpl:text_context "In Kuala Lumpur werd informatie ingewonnen over de algemene en rurale ontwikkelingspolitiek van Maleisië bij de SERU (\"Social Economie Research Unit\") en de Geografische afdeling van de \"Universiti Malaya\". Meer specifieke informatie betreffende huidige ontwikkelingen van de visserij op nationaal en regionaal nivo werd verkregen bij het hoofdkantoor van MFD (\"Marine Fisheries Department\") en LKIM (\"Lembaga Kemajuan Ikan Malaysia\"; d.i. het \"Fisheries Development Board Malaysia\"). In Kuching werd een algemeen inzicht verschaft in de huidige sociaal-ekonomische status van de vissers in Sarawak en de overheidspolitiek ten aanzien van problemen in rurale gebieden, met name de visserlj-regio1s langs de kust." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Vierde Divisie" ;
            sgpl:text_context "De Vierde Divisie, met als hoofdstad Miri, ligt in het westen en deels in het centrale gedeelte van Sarawak. De totale landoppervlakte van deze Divisie is 38.953 km2, hetgeen overeenkomt met 31 % van de totale landoppervlakte van Sarawak. De Vierde Divisie is opgedeeld in drie Distrikten: - Miri Distrikt; - Baram Distrikt; - Bintulu Distrikt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1737486 ;
            sgpl:spatialText "het centrum van Bintulu Town" ;
            sgpl:text_context "Anno 1988 is er inmiddels een besluit genomen omtrent de lokatie van het visserij-komplex, namelijk buiten het centrum van Bintulu Town op de noordelijke oever van de Kemena, tussen Bintulu-Town en de Kemena brug. Het merendeel van de vissers (dat een mening heeft omtrent de lokatie van het komplex) blijkt echter voor vestiging nabij het huidige stadscentrum te zijn: dicht bij de monding van de rivier en dicht bij de vismarkt (en dus dicht bij de konsument). Hoofdstuk 4.3.3: \"Agricultural Bank Malysia\" (BPM)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1738050 ;
            sgpl:spatialText "Miri" ;
            sgpl:text_context "De Vierde Divisie, met als hoofdstad Miri, ligt in het westen en deels in het centrale gedeelte van Sarawak. De totale landoppervlakte van deze Divisie is 38.953 km2, hetgeen overeenkomt met 31 % van de totale landoppervlakte van Sarawak. De Vierde Divisie is opgedeeld in drie Distrikten: - Miri Distrikt; - Baram Distrikt; - Bintulu Distrikt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:1737486 ;
            sgpl:spatialText "Bintulu Distrikt" ;
            sgpl:text_context "De Vierde Divisie is opgedeeld in drie Distrikten: - Miri Distrikt; - Baram Distrikt; - Bintulu Distrikt. Bintulu Distrikt beslaat een oppervlakte van 11.844 km2 (dit is 9,5 % van de totale landoppervlakte van Sarawak). Bintulu-Town (zie kaart 3) is gelegen aan de kust, ongeveer 360 km ten noordoosten van Kuching, de hoofdstad van de Staat." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "\"case-study\": de visserskoöperatie in Bintulu, Sarawak, 1985 - B. van Rheenen Utrecht, Juli 1988 Sociaal Geografisch Instituut, Rijksuniversiteit Utrecht, Vakgroep Sociale Geografie der Ontwikkelingslanden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:1733038 ;
            sgpl:spatialText "de Vierde Divisie in Sarawak" ;
            sgpl:text_context "Lijst van tabellen ..................................................vi Kaart 1: Lokatie van de Vierde Divisie in Sarawak (1985) ............vii Kaart 2: Lokatie van Bintulu Distrikt in de Vierde Divisie, Sarawak (1985) ...........................viii" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:1735398 ;
            sgpl:spatialText "Kuala Tatau" ;
            sgpl:text_context "Er werd besloten de volgende kampongs in het onderzoek te betrekken: -bij Bintulu: kg. Masjid, kg. Dato, kg. Baru, kg. Jepak; -ten zuidwesten van Bintulu: kg. Kuala Tatau. Op basis van informatie uit een onderzoek van het MFD in 1983, de registratie van vissers met licensie bij MFD-Bintulu, de registratie van PN-leden bij LKIM-Bintulu, werd een enquete opgesteld voor zogenaamde \"boat-operators\" en voor bemanningsleden, betreffende de algemeen sociaal-ekonomische situatie van vissers, de veranderende mogelijkheden van visserij." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "De probleemstelling luidt: in hoeverre is het mogelijk (gebleken) om koöperaties, zoals ontstaan en ontwikkelde in West-Europa rond het midden van de vorige eeuw, over te brengen naar een niet-Westerse sociaal-ekonomische kontext, met als \"case-study\": een visserskoöperatie in Bintulu, Sarawak, 1985. De onderzoeksvragen die uit de probleemstelling voortvloeien, zijn: (i) in welke sociaal-ekonomische kontext zijn koöperaties als formele organisatievorm in het Westen ontstaan, en welke rollen hebben daarbij gespeeld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:1737486 ;
            sgpl:spatialText "Bintulu" ;
            sgpl:text_context "In laatstgenoemde staat werden op uitnodiging van SERU-Sarawak sociaal-ekonomische onderzoeken verricht naar de status van vissers en hun toegang tot en gebruik van overheidssteun. In 1985 werd onderzoek gedaan in Bintulu, waarin de veranderende mogelijkheden van de visserij (als gevolg van moderne, industriële ontwikkelingen, gebaseerd op de vondst van aardgas en -olie in de regio) centraal stonden. De resultaten van deze \"issues\" werden in een eindrapport vastgelegd (Munneke c.s.: \"Fishing in Sarawak, Malaysia: changing Opportunities in the Bintulu Area, Fourth Division\", Utrecht, 1987)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1733039 ;
            sgpl:spatialText "Sabah" ;
            sgpl:text_context "Dit samenwerkingsverband heeft geleid tot een aantal vissers-onderzoeken in West-Maleisië, Sabah en Sarawak. In laatstgenoemde staat werden op uitnodiging van SERU-Sarawak sociaal-ekonomische onderzoeken verricht naar de status van vissers en hun toegang tot en gebruik van overheidssteun. In 1985 werd onderzoek gedaan in Bintulu, waarin de veranderende mogelijkheden van de visserij (als gevolg van moderne, industriële ontwikkelingen, gebaseerd op de vondst van aardgas en -olie in de regio) centraal stonden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10917 ;
            sgpl:subjectText "visserskoöperatie" ;
            sgpl:text_context "In 1985 werd onderzoek gedaan in Bintulu, waarin de veranderende mogelijkheden van de visserij (als gevolg van moderne, industriële ontwikkelingen, gebaseerd op de vondst van aardgas en -olie in de regio) centraal stonden. Eveneens belangrijk in dit onderzoek is de plaatselijke visserskoöperatie: in hoeverre is deze in staat de belangen van leden/vissers te behartigen? De resultaten van deze deelstudie en de beantwoording van bovengestelde vraag zijn in deze skriptie verwerkt (hoofdstuk 4)." ],
        [ sgpl:refersToConcept unesco:concept10918 ;
            sgpl:subjectText "traditionele visserij" ;
            sgpl:text_context "Sleutelbegrippen van de NAP zijn \"stijgende produktie\" en \"efficiëntie\"; de overheidshulp richt zich speciaal op ongeorganiseerde kleine agrarische producenten, die grotendeels overeenkomen met de bovengenoemde armoedegroepen. Omdat de produktie van traditionele (zee)visserij-sektor tussen 1980 en 1985 met zo'n 6 % gedaald is (voornamelijk door overbevissing) heeft de Maleise overheid maatregelen geïntroduceerd om te voorkomen dat de visgronden nog verder verarmen. In Sarawak zijn het voornamelijk inheemse bevolkingsgroepen, werkzaam als \"shifting cultivators\" en traditionele vissers die het grootste aantal arme huishoudens tellen." ],
        [ sgpl:refersToConcept unesco:concept1737 ;
            sgpl:subjectText "agrarische ontwikkelingsstrategie" ;
            sgpl:text_context "In hoeverre is \"koöperatie\" een middel om de produktiviteit van vissers te verhogen en daarmee betere inkomensmogelijkheden te kreëren. Of algemener geformuleerd: in hoeverre is \"koöperatie\" een geschikt (onder)deel van een agrarische ontwikkelingsstrategie. De voorbereiding van deze skriptie valt in een viertal delen uiteen: voorbereiding in Nederland op het veldwerk in Bintulu, Sarawak (september 1984-februari 1985), bestaande uit kolleges Rurale en Agrarische Ontwikkelingsproblematiek, Ekonomie van Ontwikkelingslanden, Onderzoeksmethodologie, \"Bahasa Malaysia\", en het bestuderen van literatuur betreffende Maleisië en Sarawak in het algemeen, en de kleine visserij in het bijzonder." ],
        [ sgpl:refersToConcept unesco:concept1737 ;
            sgpl:subjectText "agrarische ontwikkelingsstrategie" ;
            sgpl:text_context "In hoeverre is \"koöperatie\" een middel om de produktiviteit van vissers te verhogen en daarmee betere inkomensmogelijkheden te kreëren. Of algemener geformuleerd: in hoeverre is \"koöperatie\" een geschikt (onder)deel van een agrarische ontwikkelingsstrategie. De voorbereiding van deze skriptie valt in een viertal delen uiteen: voorbereiding in Nederland op het veldwerk in Bintulu, Sarawak (september 1984-februari 1985), bestaande uit kolleges Rurale en Agrarische Ontwikkelingsproblematiek, Ekonomie van Ontwikkelingslanden, Onderzoeksmethodologie, \"Bahasa Malaysia\", en het bestuderen van literatuur betreffende Maleisië en Sarawak in het algemeen, en de kleine visserij in het bijzonder." ],
        [ sgpl:refersToConcept unesco:concept10917 ;
            sgpl:subjectText "visserskoöperatie" ;
            sgpl:text_context "In 1985 werd onderzoek gedaan in Bintulu, waarin de veranderende mogelijkheden van de visserij (als gevolg van moderne, industriële ontwikkelingen, gebaseerd op de vondst van aardgas en -olie in de regio) centraal stonden. Eveneens belangrijk in dit onderzoek is de plaatselijke visserskoöperatie: in hoeverre is deze in staat de belangen van leden/vissers te behartigen? De resultaten van deze deelstudie en de beantwoording van bovengestelde vraag zijn in deze skriptie verwerkt (hoofdstuk 4)." ],
        [ sgpl:refersToConcept unesco:concept10918 ;
            sgpl:subjectText "traditionele visserij" ;
            sgpl:text_context "Sleutelbegrippen van de NAP zijn \"stijgende produktie\" en \"efficiëntie\"; de overheidshulp richt zich speciaal op ongeorganiseerde kleine agrarische producenten, die grotendeels overeenkomen met de bovengenoemde armoedegroepen. Omdat de produktie van traditionele (zee)visserij-sektor tussen 1980 en 1985 met zo'n 6 % gedaald is (voornamelijk door overbevissing) heeft de Maleise overheid maatregelen geïntroduceerd om te voorkomen dat de visgronden nog verder verarmen. In Sarawak zijn het voornamelijk inheemse bevolkingsgroepen, werkzaam als \"shifting cultivators\" en traditionele vissers die het grootste aantal arme huishoudens tellen." ] ;
    sgpl:thesisID 186 .

sgpl:Thesis187 a sgpl:SGPLThesis ;
    dcterms:creator "Jeroen de Roos" ;
    dcterms:issued 1988 ;
    dcterms:title "RANDSTAD EN TELECOMMUNICATIE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "vier grote Randstad-gewesten" ;
            sgpl:text_context "Het geeft een samenvatting van een aantal aspekten rond het thema 'Randstad en telecommunicatie’. Kernpunten zijn ten eerste de relatieve positie van de Randstad in het nederlandse telecommunicatie-netwerk en ten tweede de meest recente ontwikkelingen in de vier grote Randstad-gewesten t.a.v. telecommunicatie en bedrijvigheid. Op deze plaats wil ik een aantal personen bedanken die bij de totstandkoming van deze scriptie van groot belang zijn geweest." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755251,
                geonames:2755476 ;
            sgpl:spatialText "distrikten Goes en Groningen" ;
            sgpl:text_context "De distriktcentrales vormen een maasvormiog net, d.w.z. elke distriktcentrale is met elke andere distriktcentrale verbonden. Het gebruik van overloopcentrales is nodig wanneer het verkeer tussen twee distriktcentrales gering is (bijv, tussen de distrikten Goes en Groningen) of als door en groot aanbod het verkeer niet via rechtstreekse verbindingen tussen de twee distriktcentrales kan worden afgewikkeld. Distrikten waar overloop centrales gevestigd zijn zijn Amsterdam, Rotterdam, Eindhoven en Zwolle." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam-Oost" ;
            sgpl:text_context "De lokaties waar veel bedrijven in de zakelijke dienstverle-ning zich vestigen zijn Amsterdam-Z.0. (vestiging van o.a. NMB en Amro) en Buitenveldert. Daarnaast vestigt dit type bedrijven zich veel langs de Westelijke Ringweg, in Amsterdam-Oost, het centrum (o.a. langs de te ontwikkelen IJ-oevers) en in Sloterdijk. De gemeente streeFt ernaar bedrijven in de telecommunicatie en inFbrmatie-industrie te vestigen in het centrum en in Sloterdijk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Het belang van Schiphol voor de economie van Nederland wordt ook door de provincie Utrecht onderkent en men probeert dan ook te profiteren van de uitstralingseffecten hiervan. Deze effekten zijn nu al merkbaar gezien het feit dat in Utrecht al Schiphol gebonden aktiviteiten gevestigd zijn. Deze aktiviteiten behoren o.a. tot de distributieve sektor." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "polder Galecop" ;
            sgpl:text_context "Er wordt ook onderzoek gedaan naar de mogelijkheden voor de aanleg van een z.g.n. 4e generatie bedrj j-Fsterrein. De plaats waar dit geheel tot ontwikkeling moet worden gebracht is de polder Galecop in het noorden van Nieuwegein. De -Faciliteiten die deze lokatie aantrekkelijk moeten maken zijn o.a. veel groen, extra -Faciliteiten op telecommunicatiegebied (waaronder value added networks), hotels, luxe winkels en recreatieve mogelijkheden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373,
                geonames:2747891,
                geonames:2759793 ;
            sgpl:spatialText "gemeenten Amsterdam, Den Haag en Rotterdam" ;
            sgpl:text_context "Op deze plaats wil ik een aantal personen bedanken die bij de totstandkoming van deze scriptie van groot belang zijn geweest. Daarnaast die personen die mij bereidwillig te woord wilden staan bij de gemeenten Amsterdam, Den Haag en Rotterdam, bij de provincie Utrecht én bij de PTT-T distrikten Amsterdam, Den Haag, Rotterdam en Utrecht. Nieuwegein, 20 april 1988" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Daarnaast die personen die mij bereidwillig te woord wilden staan bij de gemeenten Amsterdam, Den Haag en Rotterdam, bij de provincie Utrecht én bij de PTT-T distrikten Amsterdam, Den Haag, Rotterdam en Utrecht. Nieuwegein, 20 april 1988 Jeroen de Roos. INHOUDSOPGAVE" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Het geeft een samenvatting van een aantal aspekten rond het thema 'Randstad en telecommunicatie’. Kernpunten zijn ten eerste de relatieve positie van de Randstad in het nederlandse telecommunicatie-netwerk en ten tweede de meest recente ontwikkelingen in de vier grote Randstad-gewesten t.a.v. telecommunicatie en bedrijvigheid. Op deze plaats wil ik een aantal personen bedanken die bij de totstandkoming van deze scriptie van groot belang zijn geweest." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "provincie Utrecht" ;
            sgpl:text_context "Op deze plaats wil ik een aantal personen bedanken die bij de totstandkoming van deze scriptie van groot belang zijn geweest. Daarnaast die personen die mij bereidwillig te woord wilden staan bij de gemeenten Amsterdam, Den Haag en Rotterdam, bij de provincie Utrecht én bij de PTT-T distrikten Amsterdam, Den Haag, Rotterdam en Utrecht. Nieuwegein, 20 april 1988" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In dit hoofdstuk zal aangetoond worden dat ook op telecommunicatie-gebied de Randstad een alles overheersende positie inneemt. De Randstad binnen telecommunicerend Nederland. Om het belang van de Randstad voor telecommunicerend Nederland aan te tonen worden cijfers gebruikt over de intensiteiten van telefoonverkeer tussen distriktcentrales." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5824 ;
            sgpl:subjectText "telematica" ;
            sgpl:text_context "In het kader hiervan wordt ook aandacht geschonken aan de telecommunicatie-Faciliteiten die binnen de vier gewesten aangelegd worden om hun positie binnen het telecommunicatie-net te versterken om zodoende hun produktie-milieu te verbeteren. Ter afsluiting zal tevens de rol van de telematica in de toekomst, zoals deze o.a. door de overheid gezien wordt, beschreven worden. De kern van de scriptie wordt dan weergegeven door de volgende probleemstel1inq: wat is de positie van de Randstad in telecommunicerend Nederland en wat is het belang van de vier Randstad-gewesten voor telecommunicatie-intensieve bedrijvigheid." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "zakelijke dienstverlening" ;
            sgpl:text_context "Doordat dit onderzoek over een aantal jaren is gedaan kunnen ook uitspraken gedaan worden over de mate waarin eventuele veranderingen in die positie opgetreden zijn. Daarnaast zal geprobeerd worden een verband te leggen tussen zakelijke dienstverlening en telefoonverkeer. Als slot van dit hoofdstuk worden in paragraaf 3.4 enkele concluderende opmerkingen gemaakt." ],
        [ sgpl:refersToConcept unesco:concept3785 ;
            sgpl:subjectText "ISDN" ;
            sgpl:text_context "Wanneer dit gebeurt is kan de nederlandse PTT beslissingen nemen over de eerste toepassingen van ISDN-faci liteiten. Wanneer deze projekten naar behoren lopen zal de capaciteit van het ISDN sterk worden uitgebreid en als standaardprodukt rond 1991 door de PTT in heel Nederland worden aangeboden. Het plan is dat vij-F jaar na de algemene introductie 57. van het totaal aantal telefoonaansluitingen een ISDN-aansluiting zal zijn." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "zakelijke dienstverlening" ;
            sgpl:text_context "Doordat dit onderzoek over een aantal jaren is gedaan kunnen ook uitspraken gedaan worden over de mate waarin eventuele veranderingen in die positie opgetreden zijn. Daarnaast zal geprobeerd worden een verband te leggen tussen zakelijke dienstverlening en telefoonverkeer. Als slot van dit hoofdstuk worden in paragraaf 3.4 enkele concluderende opmerkingen gemaakt." ],
        [ sgpl:refersToConcept unesco:concept3785 ;
            sgpl:subjectText "ISDN" ;
            sgpl:text_context "Wanneer dit gebeurt is kan de nederlandse PTT beslissingen nemen over de eerste toepassingen van ISDN-faci liteiten. Wanneer deze projekten naar behoren lopen zal de capaciteit van het ISDN sterk worden uitgebreid en als standaardprodukt rond 1991 door de PTT in heel Nederland worden aangeboden. Het plan is dat vij-F jaar na de algemene introductie 57. van het totaal aantal telefoonaansluitingen een ISDN-aansluiting zal zijn." ],
        [ sgpl:refersToConcept unesco:concept5824 ;
            sgpl:subjectText "telematica" ;
            sgpl:text_context "In het kader hiervan wordt ook aandacht geschonken aan de telecommunicatie-Faciliteiten die binnen de vier gewesten aangelegd worden om hun positie binnen het telecommunicatie-net te versterken om zodoende hun produktie-milieu te verbeteren. Ter afsluiting zal tevens de rol van de telematica in de toekomst, zoals deze o.a. door de overheid gezien wordt, beschreven worden. De kern van de scriptie wordt dan weergegeven door de volgende probleemstel1inq: wat is de positie van de Randstad in telecommunicerend Nederland en wat is het belang van de vier Randstad-gewesten voor telecommunicatie-intensieve bedrijvigheid." ] ;
    sgpl:thesisID 187 .

sgpl:Thesis188 a sgpl:SGPLThesis ;
    dcterms:creator "Michiel R. Scheffer" ;
    dcterms:issued 1988 ;
    dcterms:title "RUIMTE VOOR CONFECTIE",
        "VERANDERINGSPROCESSEN IN DE EUROPESE KLEDINGINDUSTRIE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Strategisch management, sectorstructuren, linkages en de gevolgen van productievernieuwing voor de arbeidsvraag zijn belangrijke thema’s voor het toekomstig onderzoek. In dit onderzoek richten we ons aan de hand van deze thema’s, op een Europees niveau op een sector die sterk in beweging is en in onze ogen een waardevolle case-study biedt: de confectieindustrie. Met de textielindustrie die we een later stadium zullen onderzoeken, kan de confectieindustrie gezien worden als een barometer en een laboratorium voor industriële veranderingen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2990117 ;
            sgpl:spatialText "Nord-Pas-de-Calais (F)" ;
            sgpl:text_context "Ons onderzoek heeft zich niet gericht op het onderzoeken van success-stories (zie Camagni en Rabelotti, 1988), maar tracht de veranderingsprocessen binnen regio’s te begrijpen. De regio’s, North-West (GB), Nord-Pas-de-Calais (F), Oost en West Vlaanderen (B), Noord-Brabant en Twente/Achterhoek (NL), zijn traditionele vestigingsgebieden van de confectieindustrie sinds het einde van de vorige eeuw, en zijn in alle gevallen ontstaan in de nabijheid van de textielindustrie. In alle gebieden is de industrie ontstaan uit lokaal ondernemerschap en kent de industrie een industrieel karakter(2)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2794055 ;
            sgpl:spatialText "het Kortrijkse" ;
            sgpl:text_context "In tegenstelling tot de andere regio’s hebben we in dit gebied een vrij groot aantal grote bedrijven met meer vestigingen. In Vlaanderen, stelt Vlasschenbroek (1978) dat in het Gentse en het Kortrijkse de confectiebedrijven na de oorlog voortgekomen zijn uit weverijen. De situatie in Vlaanderen is in zoverre bijzonder dat beide provincies met 43% van de werkgelegenheid, een dominante positie in de landelijke confectienijverheid innemen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6940309 ;
            sgpl:spatialText "Silicon Valley" ;
            sgpl:text_context "De eerste weg noemt hij \"reindustrialization\" rond high-tech complexen waarbij rijpe industrieën worden afgeschreven, en snel worden gesaneerd, en nieuwe activiteiten de basis voroen voor de productiestructuur. Via \"regional technology policies\" wordt getracht complexen te creeren zoals wij deze aantreffen in de Silicon Valley, het M4 Corridor, of rond Grenoble. Voor vele gebieden, stelt hij, is dit geen haalbare kaart." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746058,
                geonames:2749990,
                geonames:2760027 ;
            sgpl:spatialText "Noord-Brabant en Twente/Achterhoek (NL)" ;
            sgpl:text_context "Ons onderzoek heeft zich niet gericht op het onderzoeken van success-stories (zie Camagni en Rabelotti, 1988), maar tracht de veranderingsprocessen binnen regio’s te begrijpen. De regio’s, North-West (GB), Nord-Pas-de-Calais (F), Oost en West Vlaanderen (B), Noord-Brabant en Twente/Achterhoek (NL), zijn traditionele vestigingsgebieden van de confectieindustrie sinds het einde van de vorige eeuw, en zijn in alle gevallen ontstaan in de nabijheid van de textielindustrie. In alle gebieden is de industrie ontstaan uit lokaal ondernemerschap en kent de industrie een industrieel karakter(2)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2797656 ;
            sgpl:spatialText "het Gentse" ;
            sgpl:text_context "In tegenstelling tot de andere regio’s hebben we in dit gebied een vrij groot aantal grote bedrijven met meer vestigingen. In Vlaanderen, stelt Vlasschenbroek (1978) dat in het Gentse en het Kortrijkse de confectiebedrijven na de oorlog voortgekomen zijn uit weverijen. De situatie in Vlaanderen is in zoverre bijzonder dat beide provincies met 43% van de werkgelegenheid, een dominante positie in de landelijke confectienijverheid innemen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2641227 ;
            sgpl:spatialText "North-West (GB)" ;
            sgpl:text_context "Ons onderzoek heeft zich niet gericht op het onderzoeken van success-stories (zie Camagni en Rabelotti, 1988), maar tracht de veranderingsprocessen binnen regio’s te begrijpen. De regio’s, North-West (GB), Nord-Pas-de-Calais (F), Oost en West Vlaanderen (B), Noord-Brabant en Twente/Achterhoek (NL), zijn traditionele vestigingsgebieden van de confectieindustrie sinds het einde van de vorige eeuw, en zijn in alle gevallen ontstaan in de nabijheid van de textielindustrie. In alle gebieden is de industrie ontstaan uit lokaal ondernemerschap en kent de industrie een industrieel karakter(2)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2783770,
                geonames:2789733 ;
            sgpl:spatialText "Oost en West Vlaanderen (B)" ;
            sgpl:text_context "Ons onderzoek heeft zich niet gericht op het onderzoeken van success-stories (zie Camagni en Rabelotti, 1988), maar tracht de veranderingsprocessen binnen regio’s te begrijpen. De regio’s, North-West (GB), Nord-Pas-de-Calais (F), Oost en West Vlaanderen (B), Noord-Brabant en Twente/Achterhoek (NL), zijn traditionele vestigingsgebieden van de confectieindustrie sinds het einde van de vorige eeuw, en zijn in alle gevallen ontstaan in de nabijheid van de textielindustrie. In alle gebieden is de industrie ontstaan uit lokaal ondernemerschap en kent de industrie een industrieel karakter(2)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "VOORWOORD. Voor U ligt het eindverslag van het onderzoek \"Ruimte voor Confectie, vernieuwingsprocessen in de confectieindustrie in Europa\", totstand gekomen tussen Oktober 1987 en Mei 1988 als doctoraalonderzoek aan het Geografisch Instituut van de Rijksuniversiteit Utrecht. Het onderzoek is voortgekomen uit een denkproces over de industriële toekomst van Europa, en de rol van nieuwe technologieën in industriële veranderingen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Bassin Minier" ;
            sgpl:text_context "In alle subsectoren zien we vooral bedrijven die vooral in opdracht van Parijse modehuizen werken, of voor de grote distributie. Het lijkt de \"faconniers\" in het Bassin Minier beter te vergaan. Op deze wijze zet zich de verschuiving van de confectie vanuit de Vlaamse metropool naar het mijnbekken op een andere wijze voort dan in de jaren ’60 toen veel bedrijven met regionale steunmaatregelen zich in de regio vestigden (Bidermann, Levi-Strauss)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12328 ;
            sgpl:subjectText "Confectieindustrie" ;
            sgpl:text_context "Strategisch management, sectorstructuren, linkages en de gevolgen van productievernieuwing voor de arbeidsvraag zijn belangrijke thema’s voor het toekomstig onderzoek. In dit onderzoek richten we ons aan de hand van deze thema’s, op een Europees niveau op een sector die sterk in beweging is en in onze ogen een waardevolle case-study biedt: de confectieindustrie. Met de textielindustrie die we een later stadium zullen onderzoeken, kan de confectieindustrie gezien worden als een barometer en een laboratorium voor industriële veranderingen." ],
        [ sgpl:refersToConcept unesco:concept3401 ;
            sgpl:subjectText "Flexibele productieautomatisering" ;
            sgpl:text_context "De EG(1985) hanteert het begrip ontrijping eveneens op een ruimere wijze dan Abernathy. Zij plaatsen ontrijping in het kader van de mogelijkheden die de FPA schept in het automatiseren van kleine serie productie. Dit betekent dat traditionele sectoren over kunnen schakelen van een ambachtelijke productie naar een geautomatiseerde productie." ],
        [ sgpl:refersToConcept unesco:concept6364 ;
            sgpl:subjectText "Dematuratie" ;
            sgpl:text_context "In dit verband kan gesproken worden van een omslag van \"economies of scale\" naar \"economies of scope\". In deze context vindt dematuratie plaats als: \"...epochal or disruptive innovation(...)makes obsolete existing capita! equipment, labor skills, materials, components, management expertise and organizational capabilities.\" In de definitie van Abernathy e.a., beperkt het begrip dematuratie zich tot radicale productinnovaties, die een hernieuwd zoekproces bij producent en consument naar nieuwe productconcepten teweeg brengt." ],
        [ sgpl:refersToConcept unesco:concept6364 ;
            sgpl:subjectText "Dematuratie" ;
            sgpl:text_context "In dit verband kan gesproken worden van een omslag van \"economies of scale\" naar \"economies of scope\". In deze context vindt dematuratie plaats als: \"...epochal or disruptive innovation(...)makes obsolete existing capita! equipment, labor skills, materials, components, management expertise and organizational capabilities.\" In de definitie van Abernathy e.a., beperkt het begrip dematuratie zich tot radicale productinnovaties, die een hernieuwd zoekproces bij producent en consument naar nieuwe productconcepten teweeg brengt." ],
        [ sgpl:refersToConcept unesco:concept12328 ;
            sgpl:subjectText "Confectieindustrie" ;
            sgpl:text_context "Strategisch management, sectorstructuren, linkages en de gevolgen van productievernieuwing voor de arbeidsvraag zijn belangrijke thema’s voor het toekomstig onderzoek. In dit onderzoek richten we ons aan de hand van deze thema’s, op een Europees niveau op een sector die sterk in beweging is en in onze ogen een waardevolle case-study biedt: de confectieindustrie. Met de textielindustrie die we een later stadium zullen onderzoeken, kan de confectieindustrie gezien worden als een barometer en een laboratorium voor industriële veranderingen." ],
        [ sgpl:refersToConcept unesco:concept3401 ;
            sgpl:subjectText "Flexibele productieautomatisering" ;
            sgpl:text_context "De EG(1985) hanteert het begrip ontrijping eveneens op een ruimere wijze dan Abernathy. Zij plaatsen ontrijping in het kader van de mogelijkheden die de FPA schept in het automatiseren van kleine serie productie. Dit betekent dat traditionele sectoren over kunnen schakelen van een ambachtelijke productie naar een geautomatiseerde productie." ] ;
    sgpl:thesisID 188 .

sgpl:Thesis189 a sgpl:SGPLThesis ;
    dcterms:creator "Jacqueline Sellink" ;
    dcterms:issued 1988 ;
    dcterms:title "OUDE BOMEN MOET JE NIET VERPLANTEN",
        "Woonbehoeften, passende huisvesting en problemen bij het zelfstandig wonen van enkele Utrechtse hoog-bejaarden" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Deze informatie is voor een groot deel gebaseerd op de resultaten van een door de ROVU uitgevoerd onderzoek, weergegeven in de nota \"zelfstandige ouderenhuisvesting, Utrecht\". Verwacht wordt dat in Utrecht de trend van de afgelopen jaren (stabilisatie van de totale groep ouderen waarbinnen het aandeel hoog-bejaarden stijgt) zal voortzetten. Dit heeft gevolgen voor onder meer de groei van het aantal alleenstaanden als ook voor de vraag naar specifieke woon- en zorgvoorzieningen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6698635 ;
            sgpl:spatialText "Lunetten" ;
            sgpl:text_context "Kwalitatief sluiten vraag en aanbod niet aan. Daarnaast blijkt er een slechte verdeling van de voor ouderen geschikte woonruimte over de stad, er zijn grote (over—) concentraties in Lunetten en vooral Overvecht. Deze sluit onvoldoende aan op de vraag vanuit de verschillende wijken waardoor ouderen gedwongen worden uit hun huidige woning en woonomgeving weg te trekken of in hun huidige woonsituatie te blijven terwijl ze dan verstoten blijven van eventuele noodzakelijke hulp." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748815 ;
            sgpl:spatialText "Overvecht" ;
            sgpl:text_context "Kwalitatief sluiten vraag en aanbod niet aan. Daarnaast blijkt er een slechte verdeling van de voor ouderen geschikte woonruimte over de stad, er zijn grote (over—) concentraties in Lunetten en vooral Overvecht. Deze sluit onvoldoende aan op de vraag vanuit de verschillende wijken waardoor ouderen gedwongen worden uit hun huidige woning en woonomgeving weg te trekken of in hun huidige woonsituatie te blijven terwijl ze dan verstoten blijven van eventuele noodzakelijke hulp." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "VOORWOORD Het voorliggende verslag is het resultaat van een afstudeeronderzoek dat verricht is binnen de vakgroep Toegepaste Geografie en Ruimtelijke Planning (G & P) aan de faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit te Utrecht. Het onderzoek is uitgevoerd in de periode maart - november 1988." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "de stad Utrecht" ;
            sgpl:text_context "Vandaar dat in dit onderzoek is gekozen voor een meer persoonlijke benadering. Het onderzoek heeft betrekking op ouderen uit de stad Utrecht waar via een steekproef onder de zelfstandig wonende ouderen van 70 jaar en ouder, 22 vrije-interviews zijn gevoerd. Er is gekozen alleen met ouderen van boven de 70 jaar te praten omdat er van uitgegaan is dat ouderen rond deze leeftijd vaak alleen komen te staan en/of hulp nodig hebben." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Ouderen in woningen die zijn aangepast. Deze nota is in 1988 door de dienst Ruimtelijke Ordening en Volkshuisvesting van de gemeente Utrecht (ROVU) uitgebracht (zie ook hoofdstuk 4). Daar wordt ingegaan op de resultaten van een enquete gehouden onder 3500 in Utrecht wonende leden van ouderenbonden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het patroon van vergrijzing in de stad Utrecht verschilt, net als in de andere grote steden, van het landelijke beeld. In de jaren zeventig nam het aantal ouderen sterker toe dan in Nederland als geheel. Het huidige percentage 65-plussers ligt op zo'n 14% versus 12% in Nederland." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8242 ;
            sgpl:subjectText "Zelfstandig wonen" ;
            sgpl:text_context "De doelstelling van deze studie is een onderzoek onder zelfstandig wonende ouderen in hun huisvestingssituatie. Dit om te zien in hoeverre problemen het zelfstandig wonen bemoeilijken en of er voor deze problemen een oplossing is zonder dat er sprake is van een verhuizing. Hiertoe is gekomen na een analyse van beschikbaar matariaal over de woonbehoeften van ouderen." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Woontussenvoorzieningen" ;
            sgpl:text_context "Het belangrijkste onderscheidend element voor een typering van woonvormen voor ouderen is de mate van zorgverlening. Woontussenvoorzieningen (WTV's) zijn weliswaar zelfstandige woonvormen (veelal gebouwd als bejaarden- of ouderenwoning), maar ze beschikken daarnaast over complex gebonden, aanvullende vormen van maatschappelijke dienstverlening. In de praktijk worden het service- of zorgwoningen, aanleunwoningen, kangeroewoningen, serviceflats of bejaardenhoven genoemd." ],
        [ sgpl:refersToConcept unesco:concept1673 ;
            sgpl:subjectText "Ouderenhuisvesting" ;
            sgpl:text_context "Om te komen tot een oplossing van de doelstelling is het nuttig vooraf in te gaan op de theorievorming rond ouderenhuisvesting. Veranderde woonbehoefte van ouderen worden in de theorieën gezien als een resultante van een toetreding tot een andere levensfase, vaak gekoppeld aan leeftijd. Dit versterkt of verslapt de binding met de woning, heeft invloed op de financiële middelen en op het ruimtegebruik." ],
        [ sgpl:refersToConcept unesco:concept8242 ;
            sgpl:subjectText "Zelfstandig wonen" ;
            sgpl:text_context "De doelstelling van deze studie is een onderzoek onder zelfstandig wonende ouderen in hun huisvestingssituatie. Dit om te zien in hoeverre problemen het zelfstandig wonen bemoeilijken en of er voor deze problemen een oplossing is zonder dat er sprake is van een verhuizing. Hiertoe is gekomen na een analyse van beschikbaar matariaal over de woonbehoeften van ouderen." ],
        [ sgpl:refersToConcept unesco:concept1673 ;
            sgpl:subjectText "Ouderenhuisvesting" ;
            sgpl:text_context "Om te komen tot een oplossing van de doelstelling is het nuttig vooraf in te gaan op de theorievorming rond ouderenhuisvesting. Veranderde woonbehoefte van ouderen worden in de theorieën gezien als een resultante van een toetreding tot een andere levensfase, vaak gekoppeld aan leeftijd. Dit versterkt of verslapt de binding met de woning, heeft invloed op de financiële middelen en op het ruimtegebruik." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Woontussenvoorzieningen" ;
            sgpl:text_context "Het belangrijkste onderscheidend element voor een typering van woonvormen voor ouderen is de mate van zorgverlening. Woontussenvoorzieningen (WTV's) zijn weliswaar zelfstandige woonvormen (veelal gebouwd als bejaarden- of ouderenwoning), maar ze beschikken daarnaast over complex gebonden, aanvullende vormen van maatschappelijke dienstverlening. In de praktijk worden het service- of zorgwoningen, aanleunwoningen, kangeroewoningen, serviceflats of bejaardenhoven genoemd." ] ;
    sgpl:thesisID 189 .

sgpl:Thesis190 a sgpl:SGPLThesis ;
    dcterms:creator "Arend Smits",
        "Stefan Funnekotter" ;
    dcterms:issued 1988 ;
    dcterms:title "DE ROL VAN REGIONALE LUCHTHAVENS IN HET INTERNATIONALE GOEDERENVERVOER" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "De Rotterdamse haven is nog steeds de grootste ter wereld, maar ondervindt hevige concurrentie van buitenlandse zeehavens, zoals Antwerpen en Hamburg. Schiphol behoort zo langzamerhand tot de grootste luchthavens van Europa en wil uitgroeien tot de \"Gateway to Europe\", maar heeft ook met geduchte concurrenten te maken. In een periode zoals deze, waarin verkeers- en vervoersvraagstukken binnen en buiten de politiek \"hot items\" zijn, is het interessant onderzoek te kunnen doen naar een onderwerp dat hiermee verband houdt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "gemeente Rotterdam" ;
            sgpl:text_context "Deze gegevens hebben betrekking op enkele algemene gegevens van de luchthavens (2.1), de omvang van het goederenvervoer (2.2), de samenstelling van de af- en aanvoer via de luchthavens (2.3) en het aandeel van het geregelde en ongeregelde vervoer in het totale vervoer (2.4). Rotterdam Airport ligt in de gemeente Rotterdam, ten noordwesten van de stad. Qua wegverbindingen is de luchthaven goed ontsloten; enkele kilometers in zuidelijke richting loopt de autosnelweg Hoek van Holland-Gouda en westelijk ligt de snelweg Rotterdam-Den Haag." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht Airport (Beek)" ;
            sgpl:text_context "Het is nuttig om te onderzoeken welke functie regionale luchthavens vervullen in de Nederlandse luchtvrachtsector. De aandacht is uitgegaan naar twee luchthavens, Maastricht Airport (Beek) en Rotterdam Airport (Zestienhoven), aangezien dit de twee enige regionale luchthavens zijn vanwaar luchtvracht wordt gevlogen. Dit rapport is het resultaat van ruim een half jaar onderzoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2635167 ;
            sgpl:spatialText "Groot-Brittannië" ;
            sgpl:text_context "Dat bedrijven Maastricht Airport als hub gekozen hebben hoeft echter niet te betekenen dat luchtvracht ook daadwerkelijk via deze luchthaven wordt gevlogen. Zo is Maastricht Airport de hub van British Airways Cargo voor het continent, maar alle goederen komen met de vrachtwagen uit Groot-Brittannië, of gaan daar naar toe (zogenaamde trucking). Ook Van Gend & Loos werkt volgens het hub-and-spoke systeem, maar beperkt zich zoals gezegd uitsluitend tot het wegvervoer." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam Airport (Zestienhoven)" ;
            sgpl:text_context "Het is nuttig om te onderzoeken welke functie regionale luchthavens vervullen in de Nederlandse luchtvrachtsector. De aandacht is uitgegaan naar twee luchthavens, Maastricht Airport (Beek) en Rotterdam Airport (Zestienhoven), aangezien dit de twee enige regionale luchthavens zijn vanwaar luchtvracht wordt gevlogen. Dit rapport is het resultaat van ruim een half jaar onderzoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Zuid-Limburg" ;
            sgpl:text_context "Rotterdam Airport ligt in de gemeente Rotterdam, ten noordwesten van de stad. Maastricht Airport ligt in Zuid-Limburg, in de nabijheid van Maastricht (ca. 10 km.), Heerlen (25 km.) en Aken (40 km.) en is als het ware ingeklemd in een driehoek van autosnelwegen. Deze garanderen een snelle verbinding van en naar de agglomeraties Maastricht, Luik en Aken (en verderop het Ruhrgebied)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Stefan Funnekotter Arend Smits RIJKSUNIVERSITEIT TE UTRECHT 1856 8752. De afgelopen twee, drie jaar is de discussie over Nederland als distributieland en de problematiek rond het daarmee samenhangende vervoer in alle hevigheid losgebarsten. Door overvolle autosnelwegen, veroorzaakt door het woonwerkverkeer, staat de traditioneel sterke positie van Nederland in het internationale goederenvervoer onder druk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279858 ;
            sgpl:spatialText "Rijnmond" ;
            sgpl:text_context "Beide luchthavens geven over de afgelopen twaalf jaar een groei te zien in het aandeel van het geregelde vervoer in het totale goederenvervoer. De goederen die via Rotterdam Airport vervoerd worden lijken een sterk verband te vertonen met de in de regio aanwezige bedrijvigheid (tuinbouwproducten uit het Westland en industriële producten uit de Rijnmond). In dit hoofdstuk worden de ontwikkelingen die in de voorgaande hoofdstukken besproken zijn in hun onderling verband geplaatst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744633 ;
            sgpl:spatialText "Westland" ;
            sgpl:text_context "Beide luchthavens geven over de afgelopen twaalf jaar een groei te zien in het aandeel van het geregelde vervoer in het totale goederenvervoer. De goederen die via Rotterdam Airport vervoerd worden lijken een sterk verband te vertonen met de in de regio aanwezige bedrijvigheid (tuinbouwproducten uit het Westland en industriële producten uit de Rijnmond). In dit hoofdstuk worden de ontwikkelingen die in de voorgaande hoofdstukken besproken zijn in hun onderling verband geplaatst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "de Europese markten" ;
            sgpl:text_context "Nederland is van oudsher een transportgericht land. De gunstige ligging ten opzichte van de wereldzeeën enerzijds en de Europese markten anderzijds (BRD) heeft ertoe geleid, dat een relatief groot deel van de Nederlandse economie gericht is op deze vervoers- en distributiefunctie. Een land waarvan de economie in sterke mate afhankelijk is van het internationale (goederen)vervoer zal alert moeten zijn op veranderingen binnen de wereldeconomie, die andere vervoersstromen zullen genereren." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1959 ;
            sgpl:subjectText "Luchtgoederenvervoer" ;
            sgpl:text_context "Daarna zullen deze ontwikkelingen in verband worden gebracht met de luchtvaart, hetgeen in dit rapport onderwerp van onderzoek is. Hierbij zal worden geschetst op welke wijze deze veranderingen doorwerken op het (lucht)goederenvervoer en welke rol de regionale luchthavens daarbij vervullen. In 1.2 komen de logistieke ontwikkelingen in de productie en in 1.3 de ontwikkelingen in het internationale (lucht)goederenvervoer aan bod." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "Externe logistieke dienstverlening" ;
            sgpl:text_context "Het is voor producenten daarom vaak rendabel om deze activiteiten uit te besteden aan gespecialiseerde bedrijven die de kennis en uitrusting hiervoor hebben. Men spreekt in dit verband van externe logistieke dienstverlening. Hiermee wordt bedoeld \"het verzorgen van de logistieke functie van de verlader door de vervoerder\" (Vlaar, 1986, p.80)." ],
        [ sgpl:refersToConcept unesco:concept6086 ;
            sgpl:subjectText "Hub-and-spoke-systeem" ;
            sgpl:text_context "De laatste jaren is er een opkomst van de zogenaamde \"rond-de-wereld-diensten\", waarmee bedoeld wordt dat een maatschappij haar diensten over de gehele aardbol verleent. Samenhangend hiermee is de opkomst van een nieuw verschijnsel, namelijk dat van het \"hub-and-spoke-systeem\". Bij dit systeem wordt per \"regio\" (dit kan bijvoorbeeld een continent zijn) alle vracht verzameld op één centraal punt (de hub)." ],
        [ sgpl:refersToConcept unesco:mt6.65 ;
            sgpl:subjectText "Externe logistieke dienstverlening" ;
            sgpl:text_context "Het is voor producenten daarom vaak rendabel om deze activiteiten uit te besteden aan gespecialiseerde bedrijven die de kennis en uitrusting hiervoor hebben. Men spreekt in dit verband van externe logistieke dienstverlening. Hiermee wordt bedoeld \"het verzorgen van de logistieke functie van de verlader door de vervoerder\" (Vlaar, 1986, p.80)." ],
        [ sgpl:refersToConcept unesco:concept6086 ;
            sgpl:subjectText "Hub-and-spoke-systeem" ;
            sgpl:text_context "De laatste jaren is er een opkomst van de zogenaamde \"rond-de-wereld-diensten\", waarmee bedoeld wordt dat een maatschappij haar diensten over de gehele aardbol verleent. Samenhangend hiermee is de opkomst van een nieuw verschijnsel, namelijk dat van het \"hub-and-spoke-systeem\". Bij dit systeem wordt per \"regio\" (dit kan bijvoorbeeld een continent zijn) alle vracht verzameld op één centraal punt (de hub)." ],
        [ sgpl:refersToConcept unesco:concept1959 ;
            sgpl:subjectText "Luchtgoederenvervoer" ;
            sgpl:text_context "Daarna zullen deze ontwikkelingen in verband worden gebracht met de luchtvaart, hetgeen in dit rapport onderwerp van onderzoek is. Hierbij zal worden geschetst op welke wijze deze veranderingen doorwerken op het (lucht)goederenvervoer en welke rol de regionale luchthavens daarbij vervullen. In 1.2 komen de logistieke ontwikkelingen in de productie en in 1.3 de ontwikkelingen in het internationale (lucht)goederenvervoer aan bod." ] ;
    sgpl:thesisID 190 .

sgpl:Thesis191 a sgpl:SGPLThesis ;
    dcterms:creator "Frank Studulski",
        "Hidde Toet" ;
    dcterms:issued 1988 ;
    dcterms:title "Vergrijzen in de grote stad." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3382998 ;
            sgpl:spatialText "Suriname" ;
            sgpl:text_context "De lichte stijging van het totaal vruchtbaarheidscijfer in de vier grote steden, ingezet omstreeks 1982, kan mogelijk verklaard worden door de hoge TVC's onder de buitenlandse immigranten uit onder andere Turkije, Marokko en Suriname. Een andere mogelijke verklaring voor de stijging van het totale vruchtbaarheidscijfer tussen 1977 en 1986 in de steden zou kunnen zijn dat een aantal vrouwen het krijgen van kinderen heeft uitgesteld tot een latere leeftijd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Een belangrijk demografisch verschijnsel dat de Nederlandse samenleving bezighoudt, is de veroudering van de bevolking; de vergrijzing, en de voorzieningen voor ouderen. In deze scriptie is onderzocht hoe het gebruik van ouderenvoorzieningen in de vier grote steden en Nederland is veranderd in de periode 1972-1986. Met behulp van dit gegeven en een bevolkingsprognose is een raming gemaakt van het gebruik van specifieke ouderenvoorzieningen in de grote steden en Nederland voor de periode 1986-2000." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Vergrijzing heeft zich in de steden sterker ontwikkeld dan elders. Hierbij zullen we ons richten op de vier grote steden (Amsterdam, Rotterdam, Den Haag en Utrecht). Voor de vier grote steden wordt verwacht dat in de toekomst de veroudering van de bevolking zal gaan afnemen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2542007 ;
            sgpl:spatialText "Marokko" ;
            sgpl:text_context "De lichte stijging van het totaal vruchtbaarheidscijfer in de vier grote steden, ingezet omstreeks 1982, kan mogelijk verklaard worden door de hoge TVC's onder de buitenlandse immigranten uit onder andere Turkije, Marokko en Suriname. Een andere mogelijke verklaring voor de stijging van het totale vruchtbaarheidscijfer tussen 1977 en 1986 in de steden zou kunnen zijn dat een aantal vrouwen het krijgen van kinderen heeft uitgesteld tot een latere leeftijd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Pas in de tweede helft van de zestiger jaren begon in Nederland het vruchtbaarheidsniveau te dalen. De ontwikkeling van het verouderingsproces is in Nederland zodoende pas later ingezet dan elders in Europa. De lichte stijging van het totaal vruchtbaarheidscijfer in de vier grote steden, ingezet omstreeks 1982, kan mogelijk verklaard worden door de hoge TVC's onder de buitenlandse immigranten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Yugoslavië" ;
            sgpl:text_context "In Zweden is circa 17% van de bevolking bejaard, terwijl dit in Yugoslavië circa 8% is (Maandstatistiek van de bevolking, CBS, 1987/5, p.5). Niet alleen tussen landen maar ook binnen Nederland blijken regionale verschillen te bestaan wat betreft de verouderings- ontwikkeling. Zo bleek in de grote steden van Nederland de verouderingsontwikkeling anders te zijn dan in andere delen van het land." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "de vier grote steden" ;
            sgpl:text_context "Vooral het individualiseringsproces, wwardoor ouderen langer zelfstandig willen blijven leven, speelt tegenwoordig een grote rol in dit geheel. In deze scriptie is onderzocht hoe het gebruik van ouderenvoorzieningen in de vier grote steden en Nederland is veranderd in de periode 1972-1986. Met behulp van dit gegeven en een bevolkingsprognose is een raming gemaakt van het gebruik van specifieke ouderenvoorzieningen in de grote steden en Nederland voor de periode 1986-2000." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "de grote steden van Nederland" ;
            sgpl:text_context "Niet alleen tussen landen maar ook binnen Nederland blijken regionale verschillen te bestaan wat betreft de verouderings- ontwikkeling. Zo bleek in de grote steden van Nederland de verouderingsontwikkeling anders te zijn dan in andere delen van het land. De veroudering in de vier grote steden is niet zo zeer 'erger' dan elders, maar anders." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2661886 ;
            sgpl:spatialText "Zweden" ;
            sgpl:text_context "Als de Nederlandse ontwikkeling vergeleken wordt met die van andere Europese landen, dan blijkt dat Nederland een relatief jonge bevolking heeft. In Zweden is circa 17% van de bevolking bejaard, terwijl dit in Yugoslavië circa 8% is (Maandstatistiek van de bevolking, CBS, 1987/5, p.5). Niet alleen tussen landen maar ook binnen Nederland blijken regionale verschillen te bestaan wat betreft de verouderings- ontwikkeling." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Vergrijzing heeft zich in de steden sterker ontwikkeld dan elders. Hierbij zullen we ons richten op de vier grote steden (Amsterdam, Rotterdam, Den Haag en Utrecht). Voor de vier grote steden wordt verwacht dat in de toekomst de veroudering van de bevolking zal gaan afnemen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijks Universiteit te Utrecht" ;
            sgpl:text_context "VOORWOORD Dit is een doctoraal-scriptie geschreven in het kader van de specialisatie-richting demo-geografie van de studie sociale geografie aan de Rijks Universiteit te Utrecht. Deze specialisatie-richting houdt zich bezig met bevolkings- geografie en demografie. Er is binnen de specialisatie een niet- Westerse en een Westerse richting te onderscheiden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "gemeente 'sGravenhage" ;
            sgpl:text_context "GEBRUIKTE LITERATUUR Ontwerpplan bejaardenoorden gemeente 'sGravenhage, 1986-1990. Voor de toekomst verwacht men dat er, gezien de huidige trends in de demografische ontwikkelingen, belangrijke veranderingen in het beleid optreden. Als het aantal jongeren afneemt en als het aantal ouderen toeneemt zullen daar beleidsconsequenties aan verbonden moeten worden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Vergrijzing heeft zich in de steden sterker ontwikkeld dan elders. Hierbij zullen we ons richten op de vier grote steden (Amsterdam, Rotterdam, Den Haag en Utrecht). Voor de vier grote steden wordt verwacht dat in de toekomst de veroudering van de bevolking zal gaan afnemen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:298795 ;
            sgpl:spatialText "Turkije" ;
            sgpl:text_context "De lichte stijging van het totaal vruchtbaarheidscijfer in de vier grote steden, ingezet omstreeks 1982, kan mogelijk verklaard worden door de hoge TVC's onder de buitenlandse immigranten uit onder andere Turkije, Marokko en Suriname. Een andere mogelijke verklaring voor de stijging van het totale vruchtbaarheidscijfer tussen 1977 en 1986 in de steden zou kunnen zijn dat een aantal vrouwen het krijgen van kinderen heeft uitgesteld tot een latere leeftijd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Vergrijzing heeft zich in de steden sterker ontwikkeld dan elders. Hierbij zullen we ons richten op de vier grote steden (Amsterdam, Rotterdam, Den Haag en Utrecht). Voor de vier grote steden wordt verwacht dat in de toekomst de veroudering van de bevolking zal gaan afnemen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1670 ;
            sgpl:subjectText "dubbele vergrijzing" ;
            sgpl:text_context "Verwacht wordt dat met name het aandeel hoogbejaarden binnen de bevolking van 55 jaar en ouder zal gaan toenemen in de komende jaren. Deze dubbele vergrijzing is van belang daar de behoefte aan zorgvoorzieningen onder hoogbejaarden relatief groter is. Als de Nederlandse ontwikkeling vergeleken wordt met die van andere Europese landen, dan blijkt dat Nederland een relatief jonge bevolking heeft." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "compacte stad" ;
            sgpl:text_context "Rond 1983 ontwikkelde zich de idee van de compacte stad. De compacte stad-gedachte is erop gericht de overloop van de bevolking, naar de gebieden rond de steden, te beperken door het bepalen van bouwlocaties voor het bouwen van woningen, en het creëeren van werkgelegenheid en voorzieningen in de steden. Verwacht wordt dat absoluut gezien de effecten van deze compacte stad-gedachte beperkt zullen zijn, door financiële beperkingen, de bestaande stedelijke structuur en de waardering van de stedelijke bevolking zelf." ],
        [ sgpl:refersToConcept unesco:concept1673 ;
            sgpl:subjectText "ouderenvoorzieningen" ;
            sgpl:text_context "Daarnaast is het beleid dat gevoerd wordt ten aanzien van ouderenvoorzieningen belangrijk, zowel op nationaal als gemeentelijk niveau, omdat binnen het beleid keuzes worden gemaakt ten aanzien van de besteding van de financiële middelen, die beschikbaar zijn gesteld voor voorzieningen voor ouderen. Het gebruik van ouderenvoorzieningen in de vier grote steden en het beleid dat gevoerd wordt ten aanzien van deze ouderenvoorzieningen zullen in dit onderzoek belicht worden. Dit onderzoek zal steunen op vier kern-elementen." ],
        [ sgpl:refersToConcept unesco:concept1670 ;
            sgpl:subjectText "dubbele vergrijzing" ;
            sgpl:text_context "Verwacht wordt dat met name het aandeel hoogbejaarden binnen de bevolking van 55 jaar en ouder zal gaan toenemen in de komende jaren. Deze dubbele vergrijzing is van belang daar de behoefte aan zorgvoorzieningen onder hoogbejaarden relatief groter is. Als de Nederlandse ontwikkeling vergeleken wordt met die van andere Europese landen, dan blijkt dat Nederland een relatief jonge bevolking heeft." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "compacte stad" ;
            sgpl:text_context "Rond 1983 ontwikkelde zich de idee van de compacte stad. De compacte stad-gedachte is erop gericht de overloop van de bevolking, naar de gebieden rond de steden, te beperken door het bepalen van bouwlocaties voor het bouwen van woningen, en het creëeren van werkgelegenheid en voorzieningen in de steden. Verwacht wordt dat absoluut gezien de effecten van deze compacte stad-gedachte beperkt zullen zijn, door financiële beperkingen, de bestaande stedelijke structuur en de waardering van de stedelijke bevolking zelf." ],
        [ sgpl:refersToConcept unesco:concept1673 ;
            sgpl:subjectText "ouderenvoorzieningen" ;
            sgpl:text_context "Daarnaast is het beleid dat gevoerd wordt ten aanzien van ouderenvoorzieningen belangrijk, zowel op nationaal als gemeentelijk niveau, omdat binnen het beleid keuzes worden gemaakt ten aanzien van de besteding van de financiële middelen, die beschikbaar zijn gesteld voor voorzieningen voor ouderen. Het gebruik van ouderenvoorzieningen in de vier grote steden en het beleid dat gevoerd wordt ten aanzien van deze ouderenvoorzieningen zullen in dit onderzoek belicht worden. Dit onderzoek zal steunen op vier kern-elementen." ] ;
    sgpl:thesisID 191 .

sgpl:Thesis192 a sgpl:SGPLThesis ;
    dcterms:creator "Peter van der Waerden" ;
    dcterms:issued 1988 ;
    dcterms:title "Onderzoek naar en modellering van het parkeerplaatskeuzegedrag van winkelcentrumbezoekers",
        "PARKEERPLAATSKEUZEGEDRAG VAN WINKELCENTRUMBEZOEKERS",
        "VERSLAGEN VAN LEERONDERZOEK G & P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "UTRECHT" ;
            sgpl:text_context "vakgroep toegepaste geografie en ruimtelijke planning. Transitorium II, Heidelberglaan 2, De Uithof, UTRECHT (030)532044. VOORWOORD In dit rapport is verslag gedaan van een onderzoek naar parkeerplaats- keuzegedrag van winkelcentrumbezoekers." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "Tilburg" ;
            sgpl:text_context "Zo vond Van Dinteren (1983) in een onderzoek in Nijmegen dat automobilisten parkeerplaatsen mijden omdat ze de parkeertarieven niet aksepteren. In Tilburg is na verhoging van de parkeertarrieven in de binnenstad eenzelfde effekt gekonstateerd (DHV, 1983). Van der Goot (1983) komt met zijn model tot de konklusie dat konsumenten een groot belang hechten aan de parkeerkosten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751792 ;
            sgpl:spatialText "Leeuwarden" ;
            sgpl:text_context "In geen van de vraaggerichte studies vindt een toetsing plaats van de ontwikkelde modellen aan een situatie waarin iets is veranderd. DHV (1983), Vergelijking parkeermaatregelen Leeuwarden en Tilburg. Studie in opdracht van het Ministerie van Verkeer en Waterstaat." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "de Kempen" ;
            sgpl:text_context "De herkomstgebieden zijn zo gekozen dat wordt verwacht dat ze gericht zijn op een deel van de parkeerakkomodatie. Automobilisten die niet uit Veldhoven komen zijn ondergebracht in drie herkomstgebieden, te weten: Eindhoven, de Kempen en overig. Tussen de woonlokatie van de automobilist en de gekozen parkeerplaats bestaat een duidelijk verband." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmegen" ;
            sgpl:text_context "Met name bij winkelen kan een beperking van de parkeerduur een nadeel zijn, omdat de duur van het winkelen op het moment van parkeren meestal nog niet vaststaat. Zo vond Van Dinteren (1983) in een onderzoek in Nijmegen dat automobilisten parkeerplaatsen mijden omdat ze de parkeertarieven niet aksepteren. In Tilburg is na verhoging van de parkeertarrieven in de binnenstad eenzelfde effekt gekonstateerd (DHV, 1983)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745706 ;
            sgpl:spatialText "Citycentrum te Veldhoven" ;
            sgpl:text_context "In dit rapport is verslag gedaan van een onderzoek naar parkeerplaats- keuzegedrag van winkelcentrumbezoekers. Het onderzoek heeft plaatsgevonden in het Citycentrum te Veldhoven. Doel van het onderzoek is meer inzicht te krijgen in de faktoren die een rol spelen bij de keuze van een parkeerplaats door winkelcentrumbezoekers en de modellering van het parkeerplaatskeuzegedrag." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "de binnenstad van Tilburg" ;
            sgpl:text_context "Zo vond Van Dinteren (1983) in een onderzoek in Nijmegen dat automobilisten parkeerplaatsen mijden omdat ze de parkeertarieven niet aksepteren. In Tilburg is na verhoging van de parkeertarrieven in de binnenstad eenzelfde effekt gekonstateerd (DHV, 1983). Van der Goot (1983) komt met zijn model tot de konklusie dat konsumenten een groot belang hechten aan de parkeerkosten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745704 ;
            sgpl:spatialText "gemeente Veldhoven" ;
            sgpl:text_context "Als onderzoekslokatie voor het onderzoek naar parkeerplaatskeuzegedrag van winkelcentrumbezoekers is gekozen voor het Citycentrum in de gemeente Veldhoven. De gemeente Veldhoven telt ongeveer 40.000 inwoners, verdeeld over negen wijken. Elk van deze wijken heeft een eigen winkelcentrum (kaart 1)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Technische Universiteit Eindhoven" ;
            sgpl:text_context "De specialisatie waarbinnen het onderzoek valt is ekonomische geografie. De werkzaamheden voor het onderzoek zijn voor een groot deel uitgevoerd bij de sektie Urbanistiek van de Technische Universiteit Eindhoven. Deze sektie houdt zich onder andere bezig met individueel ruimtelijk keuzegedrag." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "vakgroep toegepaste geografie en ruimtelijke planning. Transitorium II, Heidelberglaan 2, De Uithof, UTRECHT (030)532044. VOORWOORD In dit rapport is verslag gedaan van een onderzoek naar parkeerplaats- keuzegedrag van winkelcentrumbezoekers." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "Winkelgedrag" ;
            sgpl:text_context "Voor het verkrijgen van inzicht in het gedrag van winkelcentrumbezoekers kan gebruik worden gemaakt van mathematische modellen. Uit onderzoek (Borgers en Timmermans, 1986) is gebleken dat het winkelgedrag van konsumenten binnen een winkelcentrum wordt beïnvloed door de ruimtelijke struktuur van het centrum. Het punt waar de konsument het winkelcentrum binnenkomt (zogenaamd 'entry-point') speelt hierbij een belangrijke rol." ],
        [ sgpl:refersToConcept unesco:concept17116 ;
            sgpl:subjectText "Multinomiale logit model" ;
            sgpl:text_context "Vanwege het betrekkelijk eenvoudige rekenwerk wordt in de praktijk meestal de zogenaamde Dubbel Exponentiële-verdeling gebruikt. Uitgaande van deze verdeling kan het multinomiale logit model worden afgeleid (zie bijvoorbeeld Hensher en Johnson, 1981). Het multinomiale logit model is een diskreet keuzemodel." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Parkeerplaatskeuzegedrag" ;
            sgpl:text_context "Het verkrijgen van inzicht in de faktoren die een rol spelen bij de keuze van parkeerplaatsen door winkelcentrumbezoekers om zodoende de effekten van veranderingen in deze faktoren te kunnen voorspellen. Er wordt met name ingegaan op het verband tussen het parkeerplaatskeuzegedrag van automobilisten en hun winkelgedrag in het Citycentrum in Veldhoven. Het gevonden verband wordt weergegeven in een model voor parkeerplaatskeuzegedrag van winkelcentrumbezoekers." ],
        [ sgpl:refersToConcept unesco:concept17116 ;
            sgpl:subjectText "Multinomiale logit model" ;
            sgpl:text_context "Vanwege het betrekkelijk eenvoudige rekenwerk wordt in de praktijk meestal de zogenaamde Dubbel Exponentiële-verdeling gebruikt. Uitgaande van deze verdeling kan het multinomiale logit model worden afgeleid (zie bijvoorbeeld Hensher en Johnson, 1981). Het multinomiale logit model is een diskreet keuzemodel." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Parkeerplaatskeuzegedrag" ;
            sgpl:text_context "Het verkrijgen van inzicht in de faktoren die een rol spelen bij de keuze van parkeerplaatsen door winkelcentrumbezoekers om zodoende de effekten van veranderingen in deze faktoren te kunnen voorspellen. Er wordt met name ingegaan op het verband tussen het parkeerplaatskeuzegedrag van automobilisten en hun winkelgedrag in het Citycentrum in Veldhoven. Het gevonden verband wordt weergegeven in een model voor parkeerplaatskeuzegedrag van winkelcentrumbezoekers." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "Winkelgedrag" ;
            sgpl:text_context "Voor het verkrijgen van inzicht in het gedrag van winkelcentrumbezoekers kan gebruik worden gemaakt van mathematische modellen. Uit onderzoek (Borgers en Timmermans, 1986) is gebleken dat het winkelgedrag van konsumenten binnen een winkelcentrum wordt beïnvloed door de ruimtelijke struktuur van het centrum. Het punt waar de konsument het winkelcentrum binnenkomt (zogenaamd 'entry-point') speelt hierbij een belangrijke rol." ] ;
    sgpl:thesisID 192 .

sgpl:Thesis193 a sgpl:SGPLThesis ;
    dcterms:creator "Roline de Wilde" ;
    dcterms:issued 1988 ;
    dcterms:title "Maasoever Effect Rapportage",
        "VERSLAGEN VAN LEERONDERZOEK G & P",
        "een onderzoek naar de effecten van de activiteiten van de Stichting Maasoevers, met betrekking tot de oprichting van een public private partnership, op de ideeën en het gedrag van de watersportaanbieders." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Maasoevergebied" ;
            sgpl:text_context "De doelstelling van het onderzoek luidt als volgt: Inzicht verkrijgen in de vraag of de activiteiten van de Stichting Maasoevers met betrekking tot de oprichting van een p.p.p. effect hebben gehad op de ideeën en het gedrag van zowel commerciële als niet-commerciële watersportaanbieders in het Maasoevergebied. Het onderzoek heeft plaatsgevonden in de vorm van een stage bij de Stichting Maasoevers. De kennis die nodig was om de uit de doelstelling geformuleerde onderzoeksvragen te beantwoorden ís verkregen door literatuurstudie, gestructureerde telefonische enquetes onder bijna vijftig watersportaanbieders en diepte-interviews met twaalf aanbieders en veertien betrokken instanties." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749990,
                geonames:2755634 ;
            sgpl:spatialText "Brabantse en Gelderse Maasoevergebied" ;
            sgpl:text_context "Naast privatisering als middel voor het, meer marktgericht, tot stand brengen van een toeristisch-recreatief product, is er ook de mogelijkheid van een public-private partnership (p-p-p-). De Stichting Maasoevers is in het Brabantse en Gelderse Maasoevergebied bezig met het opzetten van zo'n p-pep. De in dit verslag beschreven case-study van het Maasoevergebied moet daarom ook gezien worden als een bijdrage aan het bovengenoemde onderzoek van de werkgroep Recreatie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759309 ;
            sgpl:spatialText "gemeente Beers" ;
            sgpl:text_context "Verder zijn er met betrekking tot de Kraaijenbergse Pla ssen via de gemeente Beers onderhandelingen geweest met meerdere projectontwikkelaars. Deze haakten, volgens een woordvoerder van het Streekgewest Land van Cuijk, om twee redenen af: Ten eerste vanwege de aantrekkelijkheid van de locatie ten opzichte van andere potentiele locaties en ten tweede vanwege onduidelijkheden op planologisch gebied. Zeer recent zijn er contacten afgebroken met een amerikaanse investeerder, die interesse had in de gezamenlijke exploitatie van drie bungalowparken op verschillende locaties in en nabij het Maasoevergebied." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990,
                geonames:2755634 ;
            sgpl:spatialText "provincies Gelderland en Noord-Brabant" ;
            sgpl:text_context "Bij de vaststelling van de directe invloedssfeer wordt uitgegaan van een straal van + vijf kilometer aan beide zijden van de Maas. Het gebied valt binnen de grenzen van de provincies Gelderland en Noord-Brabant én voor een klein gedeelte binnen de provincie Limburg. De in 2.1 beschreven ontwikkelingen binnen de toeristisch-recreatieve sector leidden ertoe dat ook de provincies Gelderland en Noord-Brabant een Toeristisch Recreatief Ontwikkelingsplan (TROP) hebben opgesteld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747351 ;
            sgpl:spatialText "Stadsgewest 's-Hertogenbosch" ;
            sgpl:text_context "Tenslotte gaat mijn dank uít naar alle geënqueteerde en geïnterviewde aanbieders en vertegenwoordigers van instanties voor hun bereidwillige medewerking en naar de medewerkers van het Stadsgewest 's-Hertogenbosch die mij tijdens mijn onderzoek behulpzaam zijn geweest. Utrecht, juli 1988, Roline de Wilde. Rijksuniversite te Uirecht Bikiiaook Ceutsem Gitrof." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De in dit verslag beschreven case-study van het Maasoevergebied moet daarom ook gezien worden als een bijdrage aan het bovengenoemde onderzoek van de werkgroep Recreatie. Het is de eerste keer dat er ín Nederland op zo'n groot schaalniveau binnen de toeristisch=-recreatieve sector een p.pep. wordt opgezet. Voordat de realisering van deze p.p.p. een feit is zullen er de nodige hindernissen genomen moeten worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744156 ;
            sgpl:spatialText "Woudrichem" ;
            sgpl:text_context "Het Maasoevergebied omvat de Maasoevers tussen Woudrichem en het voormalig pontveer Cuijk en Mook. In figuur 3.1 wordt het Maasoevergebied en die gebieden die binnen de directe invloedsfer van de Maas vallen (het berekeningsgebied) weergegeven. Bij de vaststelling van de directe invloedssfeer wordt uitgegaan van een straal van + vijf kilometer aan beide zijden van de Maas." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750621 ;
            sgpl:spatialText "Mook" ;
            sgpl:text_context "Het Maasoevergebied omvat de Maasoevers tussen Woudrichem en het voormalig pontveer Cuijk en Mook. In figuur 3.1 wordt het Maasoevergebied en die gebieden die binnen de directe invloedsfer van de Maas vallen (het berekeningsgebied) weergegeven. Bij de vaststelling van de directe invloedssfeer wordt uitgegaan van een straal van + vijf kilometer aan beide zijden van de Maas." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Midden-Limburgse maasplassen" ;
            sgpl:text_context "Naar aanleiding hiervan is de Werkgroep Recreatie van de Landbouwuniversiteite Wageningen bezig met een onderzoek naar de effecten van commercialisering op de watersport en sportvisserij. Het grootste gedeelte van het onderzoek heeft betrekking op de privatisering van de Midden-Limburgse maasplassen. Hier worden de gevolgen onderzocht van de overdracht van eigendom en beheer van de plassen aan de particuliere onderneming Aqua Terra (zie projectvoorstel Werkgroep Recreatie, 1987)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757874 ;
            sgpl:spatialText "Cuijk" ;
            sgpl:text_context "Het Maasoevergebied omvat de Maasoevers tussen Woudrichem en het voormalig pontveer Cuijk en Mook. In figuur 3.1 wordt het Maasoevergebied en die gebieden die binnen de directe invloedsfer van de Maas vallen (het berekeningsgebied) weergegeven. Bij de vaststelling van de directe invloedssfeer wordt uitgegaan van een straal van + vijf kilometer aan beide zijden van de Maas." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755358 ;
            sgpl:spatialText "gemeente Grave" ;
            sgpl:text_context "In die tijd stond de gemeente nogal argwanend tegenover verdere ontgrondingen. Zowel de gemeente Grave als Mook hebben een stads-tropje opgesteld. In Mook is men inmiddels begonnen met de uitvoering hiervan." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "toeristisch-recreatieve sector" ;
            sgpl:text_context "In dit doctoraal onderzoek is het Maasoeverproject als case-study voor de oprichting van een public private partnership binnen de toeristisch-recreatieve sector bestudeerd. De belangstelling voor p-p-p.'s binnen deze sector is het gevolg van de, sinds het eind van de jaren zeventig optredende, herbezinning op de taken van de overheid en de onder andere als gevolg daarvan toenemende commercialisering van toeristisch-recreatieve voorzieningen. De doelstelling van het onderzoek luidt als volgt: Inzicht verkrijgen in de vraag of de activiteiten van de Stichting Maasoevers met betrekking tot de oprichting van een p.p.p. effect hebben gehad op de ideeën en het gedrag van zowel commerciële als niet-commerciële watersportaanbieders in het Maasoevergebied." ],
        [ sgpl:refersToConcept unesco:concept17072 ;
            sgpl:subjectText "publiek-private samenwerking" ;
            sgpl:text_context "Meestal wordt er van uitgegaan dat het bij een p.p-p… gaat om een vorm van gecoordineerd handelen door publieke en private partijen. Het begrip public-private partnership, ook wel publiek-private samenwerking genoemd, kan en wordt op verschillende manieren geïnterpreteerd. Onder de publieke partij wordt over het algemeen het rijk, de provincie en de gemeenten verstaan." ],
        [ sgpl:refersToConcept unesco:concept14444 ;
            sgpl:subjectText "watersportaanbieders" ;
            sgpl:text_context "Het onderzoek is verricht ín het kader van het doctoraalexamen Economische Geografie van de Rijksuniversiteit Utrecht en het doctoraalvak Recreatiekunde van de Landbouw Universiteit Wageningen. Maasoever Effect Rapportage: een onderzoek naar de effecten van de activiteiten van de Stichting Maasoevers, met betrekking tot de oprichting van een public private partnership, op de ideeën en het gedrag van de watersportaanbieders, is het verslag van een leeronderzoek dat heeft plaatsgevonden in de vorm van een stage bij de Stichting Maasoevers. Allereerst wil ik drs. J.G. Borchert (RUU) bedanken voor zíjn begeleiding en drs. We. Harmsen voor het mij wegwijs maken binnen de ingewikkelde structuur van de Stichting Maasoevers." ],
        [ sgpl:refersToConcept unesco:concept17072 ;
            sgpl:subjectText "publiek-private samenwerking" ;
            sgpl:text_context "Meestal wordt er van uitgegaan dat het bij een p.p-p… gaat om een vorm van gecoordineerd handelen door publieke en private partijen. Het begrip public-private partnership, ook wel publiek-private samenwerking genoemd, kan en wordt op verschillende manieren geïnterpreteerd. Onder de publieke partij wordt over het algemeen het rijk, de provincie en de gemeenten verstaan." ],
        [ sgpl:refersToConcept unesco:concept370 ;
            sgpl:subjectText "toeristisch-recreatieve sector" ;
            sgpl:text_context "In dit doctoraal onderzoek is het Maasoeverproject als case-study voor de oprichting van een public private partnership binnen de toeristisch-recreatieve sector bestudeerd. De belangstelling voor p-p-p.'s binnen deze sector is het gevolg van de, sinds het eind van de jaren zeventig optredende, herbezinning op de taken van de overheid en de onder andere als gevolg daarvan toenemende commercialisering van toeristisch-recreatieve voorzieningen. De doelstelling van het onderzoek luidt als volgt: Inzicht verkrijgen in de vraag of de activiteiten van de Stichting Maasoevers met betrekking tot de oprichting van een p.p.p. effect hebben gehad op de ideeën en het gedrag van zowel commerciële als niet-commerciële watersportaanbieders in het Maasoevergebied." ],
        [ sgpl:refersToConcept unesco:concept14444 ;
            sgpl:subjectText "watersportaanbieders" ;
            sgpl:text_context "Het onderzoek is verricht ín het kader van het doctoraalexamen Economische Geografie van de Rijksuniversiteit Utrecht en het doctoraalvak Recreatiekunde van de Landbouw Universiteit Wageningen. Maasoever Effect Rapportage: een onderzoek naar de effecten van de activiteiten van de Stichting Maasoevers, met betrekking tot de oprichting van een public private partnership, op de ideeën en het gedrag van de watersportaanbieders, is het verslag van een leeronderzoek dat heeft plaatsgevonden in de vorm van een stage bij de Stichting Maasoevers. Allereerst wil ik drs. J.G. Borchert (RUU) bedanken voor zíjn begeleiding en drs. We. Harmsen voor het mij wegwijs maken binnen de ingewikkelde structuur van de Stichting Maasoevers." ] ;
    sgpl:thesisID 193 .

sgpl:Thesis194 a sgpl:SGPLThesis ;
    dcterms:creator "G.J. Zoetbrood" ;
    dcterms:issued 1988 ;
    dcterms:title "Een studie naar de besluitvorming omtrent experimenten met nieuwe tele-informatiediensten.",
        "Waarheen leidt de kabel ?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De moeizame opzet van kabelexperimenten in Nederland heeft de aanleiding gevormd voor dit onderzoek naar de achtergronden van de besluitvorming omtrent experimenten met nieuwe tele-informatiediensten. Uitgaande van de bestaande problematiek is er naar gestreefd een integraal praktijkgericht onderzoek uit te voeren naar het verband tussen de rollen van belanghebbende organisaties bij experimenten, het doen van onderzoek in de opzetfase van experimenten en de voorwaarden die de betrokken organisaties stellen aan een experimenteergebied. Deze scriptie is zowel bestemd als achtergrondstudie voor hen die werkzaam zijn op dit terrein als voor de niet-ingewijde lezer." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744102 ;
            sgpl:spatialText "Zaltbommel" ;
            sgpl:text_context "Voorbeelden hiervan zijn het Kabelexperiment Zuid-Limburg, VNU's Ditzitel projekt, Kabelcommunicatieprojekt Zaltbommel en van recenter datum de Proeftuin Telematica Noord-Brabant en het op de vier grote Randstadsteden gerichte Telebox projekt. De resultaten van deze experimenten zijn vooralsnog niet succesvol te noemen en de opzet verloopt trager dan verwacht. In deze experimenten komen vormen van samenwerking tot stand tussen zeer diverse belanghebbende organisaties uit het bedrijfsleven en nationale en lagere overheden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754652 ;
            sgpl:spatialText "Heerlen" ;
            sgpl:text_context "De zgn. bovenbouw, waardoor een hybride netwerk wordt verkregen, wordt uitbesteed aan de combinatie ITT-/Philips/Robert Schmitz B.V. voor het netwerkgedeelte in de plaatsen Heerlen en Maastricht, terwijl het netgedeelte in Kerkrade, waar tweeweg-kabel wordt aangelegd door Deltakabel geleverd wordt. De PTT neemt de koppeling tussen beide netten voor haar rekening en de aanleg van speciale PTT-lijnen ten behoeve van het experiment. In januari 1985 komt de Ministerraad met een laatste voorstel: 65 miljoen gulden wordt beschikbaar gesteld voor kabelexperimenten, waarvan 59 miljoen voor Zuid-Limburg en het overige deel wordt aan VNU ter beschikking wordt gesteld voor het opzetten van het hybride net in Amsterdam." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "de vier grote Randstadsteden" ;
            sgpl:text_context "Voorbeelden hiervan zijn het Kabelexperiment Zuid-Limburg, VNU's Ditzitel projekt, Kabelcommunicatieprojekt Zaltbommel en van recenter datum de Proeftuin Telematica Noord-Brabant en het op de vier grote Randstadsteden gerichte Telebox projekt. De resultaten van deze experimenten zijn vooralsnog niet succesvol te noemen en de opzet verloopt trager dan verwacht. In deze experimenten komen vormen van samenwerking tot stand tussen zeer diverse belanghebbende organisaties uit het bedrijfsleven en nationale en lagere overheden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "De zgn. bovenbouw, waardoor een hybride netwerk wordt verkregen, wordt uitbesteed aan de combinatie ITT-/Philips/Robert Schmitz B.V. voor het netwerkgedeelte in de plaatsen Heerlen en Maastricht, terwijl het netgedeelte in Kerkrade, waar tweeweg-kabel wordt aangelegd door Deltakabel geleverd wordt. De PTT neemt de koppeling tussen beide netten voor haar rekening en de aanleg van speciale PTT-lijnen ten behoeve van het experiment. In januari 1985 komt de Ministerraad met een laatste voorstel: 65 miljoen gulden wordt beschikbaar gesteld voor kabelexperimenten, waarvan 59 miljoen voor Zuid-Limburg en het overige deel wordt aan VNU ter beschikking wordt gesteld voor het opzetten van het hybride net in Amsterdam." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2752923 ;
            sgpl:spatialText "Kerkrade" ;
            sgpl:text_context "De zgn. bovenbouw, waardoor een hybride netwerk wordt verkregen, wordt uitbesteed aan de combinatie ITT-/Philips/Robert Schmitz B.V. voor het netwerkgedeelte in de plaatsen Heerlen en Maastricht, terwijl het netgedeelte in Kerkrade, waar tweeweg-kabel wordt aangelegd door Deltakabel geleverd wordt. De PTT neemt de koppeling tussen beide netten voor haar rekening en de aanleg van speciale PTT-lijnen ten behoeve van het experiment. In januari 1985 komt de Ministerraad met een laatste voorstel: 65 miljoen gulden wordt beschikbaar gesteld voor kabelexperimenten, waarvan 59 miljoen voor Zuid-Limburg en het overige deel wordt aan VNU ter beschikking wordt gesteld voor het opzetten van het hybride net in Amsterdam." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Zuid-Limburg" ;
            sgpl:text_context "Voorbeelden hiervan zijn het Kabelexperiment Zuid-Limburg, VNU's Ditzitel projekt, Kabelcommunicatieprojekt Zaltbommel en van recenter datum de Proeftuin Telematica Noord-Brabant en het op de vier grote Randstadsteden gerichte Telebox projekt. De resultaten van deze experimenten zijn vooralsnog niet succesvol te noemen en de opzet verloopt trager dan verwacht. In deze experimenten komen vormen van samenwerking tot stand tussen zeer diverse belanghebbende organisaties uit het bedrijfsleven en nationale en lagere overheden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Bij de keuze van het Amsterdamse Ditzitel projekt is de potentiële omvang van het hier aanwezige omvangrijke kabelnet een voorname overweging geweest, ten behoeve waarvan concessies zijn gedaan op het gebied van de diversiteit van de mogelijk aan te bieden diensten. De te bereiken potentiële gebruikersgroep via het gekozen technische systeem is echter aanzienlijk kleiner, waardoor de effectieve omvang in werkelijkheid minder aantrekkelijk is. Vraagtekens worden met name door dienstenaanbieders en informatieleveranciers gezet bij de omvang en de stimulerende regionale context van het Limburgse experiment." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "Voorbeelden hiervan zijn het Kabelexperiment Zuid-Limburg, VNU's Ditzitel projekt, Kabelcommunicatieprojekt Zaltbommel en van recenter datum de Proeftuin Telematica Noord-Brabant en het op de vier grote Randstadsteden gerichte Telebox projekt. De resultaten van deze experimenten zijn vooralsnog niet succesvol te noemen en de opzet verloopt trager dan verwacht. In deze experimenten komen vormen van samenwerking tot stand tussen zeer diverse belanghebbende organisaties uit het bedrijfsleven en nationale en lagere overheden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "G.J. Zoetbrood. Doctoraalonderzoek economische geografie, faculteit der ruimtelijke wetenschappen, Rijksuniversiteit Utrecht. ’s—Gravenhage, maart 1988. Begeleiders: Prof.Dr.M. de Smldt. Vakgroep Toegepaste Geografie en Rulmtell|Ke Planning." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8013 ;
            sgpl:subjectText "innovatie-diffusie" ;
            sgpl:text_context "In kabelexperimenten kunnen als gevolg van de integratie van de bestaande PTT - en kabeltelevisienetten interactieve videotexdiensten worden aangeboden, waardoor het aanbod van een scala aan nieuwe diensten technisch mogelijk is. Bij de innovatie-diffusie van nieuwe tele-informatiediensten zijn naast de markt- en technische-factoren, vooral de niet-marktfactoren en sociaal-politieke variabelen van invloed op de marktstructuur. Hoewel op de consumentenmarkt van nieuwe tele-informatiediensten, \"technology push\" overheerst, is de benadering van de potentiële gebruiker om tot de acceptatie van nieuwe diensten te komen een voornaam probleem." ],
        [ sgpl:refersToConcept unesco:concept4363 ;
            sgpl:subjectText "kabelexperimenten" ;
            sgpl:text_context "Deze gebruikerstoepassingen dienen een zodanige meerwaarde te hebben, waardoor het gebruik aantrekkelijk wordt. In kabelexperimenten kunnen als gevolg van de integratie van de bestaande PTT - en kabeltelevisienetten interactieve videotexdiensten worden aangeboden, waardoor het aanbod van een scala aan nieuwe diensten technisch mogelijk is. Bij de innovatie-diffusie van nieuwe tele-informatiediensten zijn naast de markt- en technische-factoren, vooral de niet-marktfactoren en sociaal-politieke variabelen van invloed op de marktstructuur." ],
        [ sgpl:refersToConcept unesco:concept3349 ;
            sgpl:subjectText "tele-informatiediensten" ;
            sgpl:text_context "Het gebied van onderzoek ligt op het raakvlak van economische geografie, marketing en externe organisatie en het onderzoek is derhalve breed van opzet. De moeizame opzet van kabelexperimenten in Nederland heeft de aanleiding gevormd voor dit onderzoek naar de achtergronden van de besluitvorming omtrent experimenten met nieuwe tele-informatiediensten. Uitgaande van de bestaande problematiek is er naar gestreefd een integraal praktijkgericht onderzoek uit te voeren naar het verband tussen de rollen van belanghebbende organisaties bij experimenten, het doen van onderzoek in de opzetfase van experimenten en de voorwaarden die de betrokken organisaties stellen aan een experimenteergebied." ],
        [ sgpl:refersToConcept unesco:concept4363 ;
            sgpl:subjectText "kabelexperimenten" ;
            sgpl:text_context "Deze gebruikerstoepassingen dienen een zodanige meerwaarde te hebben, waardoor het gebruik aantrekkelijk wordt. In kabelexperimenten kunnen als gevolg van de integratie van de bestaande PTT - en kabeltelevisienetten interactieve videotexdiensten worden aangeboden, waardoor het aanbod van een scala aan nieuwe diensten technisch mogelijk is. Bij de innovatie-diffusie van nieuwe tele-informatiediensten zijn naast de markt- en technische-factoren, vooral de niet-marktfactoren en sociaal-politieke variabelen van invloed op de marktstructuur." ],
        [ sgpl:refersToConcept unesco:concept8013 ;
            sgpl:subjectText "innovatie-diffusie" ;
            sgpl:text_context "In kabelexperimenten kunnen als gevolg van de integratie van de bestaande PTT - en kabeltelevisienetten interactieve videotexdiensten worden aangeboden, waardoor het aanbod van een scala aan nieuwe diensten technisch mogelijk is. Bij de innovatie-diffusie van nieuwe tele-informatiediensten zijn naast de markt- en technische-factoren, vooral de niet-marktfactoren en sociaal-politieke variabelen van invloed op de marktstructuur. Hoewel op de consumentenmarkt van nieuwe tele-informatiediensten, \"technology push\" overheerst, is de benadering van de potentiële gebruiker om tot de acceptatie van nieuwe diensten te komen een voornaam probleem." ],
        [ sgpl:refersToConcept unesco:concept3349 ;
            sgpl:subjectText "tele-informatiediensten" ;
            sgpl:text_context "Het gebied van onderzoek ligt op het raakvlak van economische geografie, marketing en externe organisatie en het onderzoek is derhalve breed van opzet. De moeizame opzet van kabelexperimenten in Nederland heeft de aanleiding gevormd voor dit onderzoek naar de achtergronden van de besluitvorming omtrent experimenten met nieuwe tele-informatiediensten. Uitgaande van de bestaande problematiek is er naar gestreefd een integraal praktijkgericht onderzoek uit te voeren naar het verband tussen de rollen van belanghebbende organisaties bij experimenten, het doen van onderzoek in de opzetfase van experimenten en de voorwaarden die de betrokken organisaties stellen aan een experimenteergebied." ] ;
    sgpl:thesisID 194 .

sgpl:Thesis195 a sgpl:SGPLThesis ;
    dcterms:creator "P. Almekinders" ;
    dcterms:issued 1989 ;
    dcterms:title "BEVOLKINGSVERANDERINGEN IN DE BINNENSTAD VAN DEN HAAG",
        "verhuisstromen in de buurten Kortenbos, Uilebomen en Zuidwal" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743646 ;
            sgpl:spatialText "Zuidwal" ;
            sgpl:text_context "Zoals ook in het voorwoord vermeld zijn binnen het zelfde probleemveld meerdere buurten in de centrale delen van de stad onderzocht. Het aandeel van dit onderzoek in dit grotere kader heeft zich tot de buurten Kortenbos, Zuidwal en Uilebomen beperkt. Deze buurten zijn drie van de vier buurten die de wijk 'het Centrum' vormen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Het voor u liggende onderzoeksverslag is geschreven als afstudeerproject in het kader van de studie Sociale Geografie aan de Rijksuniversiteit Utrecht. Het onderwerp van dit onderzoek is aangedragen door de Dienst Stadsontwikkeling en Grondzaken van de Gemeente • s-Gravenhage. Het verzoek om onderzoek te verrichten naar bevolkingsveranderingen en woonmilieukarakteristieken in de binnenstad van Den Haag is uitgevoerd door meerdere studenten en heeft geresulteerd in vijf afzonderlijke onderzoeksverslagen ieder betrekking hebbend op een ander deel van de Haagse binnenstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "In samenhang met de gepleegde stadsvernieuwing kent het onderzoeksgebied relatief veel bezit van sociale verhuurders en wordt het als gevolg daarvan als gemeentelijk bemiddelingsgebied aangemerkt. In de binnenstad van Amsterdam bijvoorbeeld is de woningvoorraad in de periode 1982-1986 met bijna tien procent gegroeid (gemeente Amsterdam, 1986). In samenhang met de gepleegde stadsvernieuwing kent het onderzoeksgebied relatief veel bezit van sociale verhuurders en wordt het als gevolg daarvan als gemeentelijk bemiddelingsgebied aangemerkt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Kortenbos" ;
            sgpl:text_context "Zoals ook in het voorwoord vermeld zijn binnen het zelfde probleemveld meerdere buurten in de centrale delen van de stad onderzocht. Het aandeel van dit onderzoek in dit grotere kader heeft zich tot de buurten Kortenbos, Zuidwal en Uilebomen beperkt. Deze buurten zijn drie van de vier buurten die de wijk 'het Centrum' vormen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Dit rapport is tot stand gekomen onder begeleiding van J. van Weesep vanuit Utrecht en F. Geurts vanuit Den Haag. Verder wil ik R. van Kempen bedanken voor zijn bijdragen aan het theoretische gedeelte. Voorwoord 2 Inhoudsopgave 3 Hoofdstuk 1 Doelstelling en theoretisch kader 5" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Uilebomen" ;
            sgpl:text_context "Zoals ook in het voorwoord vermeld zijn binnen het zelfde probleemveld meerdere buurten in de centrale delen van de stad onderzocht. Het aandeel van dit onderzoek in dit grotere kader heeft zich tot de buurten Kortenbos, Zuidwal en Uilebomen beperkt. Deze buurten zijn drie van de vier buurten die de wijk 'het Centrum' vormen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "de binnenstad van Den Haag" ;
            sgpl:text_context "Het onderwerp van dit onderzoek is aangedragen door de Dienst Stadsontwikkeling en Grondzaken van de Gemeente • s-Gravenhage. Het verzoek om onderzoek te verrichten naar bevolkingsveranderingen en woonmilieukarakteristieken in de binnenstad van Den Haag is uitgevoerd door meerdere studenten en heeft geresulteerd in vijf afzonderlijke onderzoeksverslagen ieder betrekking hebbend op een ander deel van de Haagse binnenstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In het eerste decennium na de oorlog was het bouwen in Nederland voornamelijk gericht op het wegwerken van de acute woningnood. Grote, gelijkvormige complexen werden in snel tempo in de steden gebouwd, hetgeen de kwaliteit van de woningen niet altijd ten goede kwam (Boelhouwer & Dieleman, 1986). Ondanks de sterke uitbreiding van de woningvoorraad namen de vertreksaldi van de drie grootste steden sterk toe en deze bereikten een hoogtepunt in de periode 1966-1973 (Dieleman & De Smidt, 1986; Jobse, 1986)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747372 ;
            sgpl:spatialText "Gemeente 's-Gravenhage" ;
            sgpl:text_context "Het voor u liggende onderzoeksverslag is geschreven als afstudeerproject in het kader van de studie Sociale Geografie aan de Rijksuniversiteit Utrecht. Het onderwerp van dit onderzoek is aangedragen door de Dienst Stadsontwikkeling en Grondzaken van de Gemeente • s-Gravenhage. Het verzoek om onderzoek te verrichten naar bevolkingsveranderingen en woonmilieukarakteristieken in de binnenstad van Den Haag is uitgevoerd door meerdere studenten en heeft geresulteerd in vijf afzonderlijke onderzoeksverslagen ieder betrekking hebbend op een ander deel van de Haagse binnenstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Voorhout" ;
            sgpl:text_context "Deze buurten zijn drie van de vier buurten die de wijk 'het Centrum' vormen. De vierde buurt, Voorhout, verschilt duidelijk op tal van punten van de andere drie en is daarom buiten beschouwing gelaten. De begrenzing van de buurten is overgenomen van de buurtindeling die het gemeentebestuur van Den Haag zelf hanteerd." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "Verhuisstromen" ;
            sgpl:text_context "Of het karakteristieke woonmilieu van Kortenbos, Uilebomen en Zuidwal werkelijk aantrekkelijk is voor de genoemde bevolkingscategorieën is dus niet zeker. In de volgende hoofdstukken worden verhuisredenen en waardering voor het woonmilieu van geënqueteerde vestigers en vertrekkers besproken en zal blijken of het woonmilieu van doorslaggevend gewicht is of dat de beschikbaarheid van passende woonruimte de verhuisstromen bepaalt. Hoofdstuk 3 RESULTATEN VAN DE SURVEY: NAAR EEN TYPERING VAN DE INSTROMERS." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Binnenstedelijk woonmilieu" ;
            sgpl:text_context "De eerste doelstelling is het uitduiden van in- en uitstroom van bevolking in een buurt. De tweede is het opsporen van aantrekkelijke (of onaantrekkelijke) karakteristieken van het binnenstedelijke woonmilieu. Met deze tweeledige doelstelling voor ogen luidt de centrale vraag van ons onderzoek als volgt: voor welke bevolkingscategorieën vormt het binnenstedelijk woonmilieu een aantrekkelijke woonplaats (en voor welke niet)?" ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "In de drie onderzoeksbuurten is de laatste jaren veel gebeurd op het gebied van vernieuwing en herinrichting van de bebouwing. Talrijke grote en kleine stadsvernieuwingsprojecten zijn gerealiseerd. Een eerste indruk van de onderzoeksbuurten is als volgt." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "In de drie onderzoeksbuurten is de laatste jaren veel gebeurd op het gebied van vernieuwing en herinrichting van de bebouwing. Talrijke grote en kleine stadsvernieuwingsprojecten zijn gerealiseerd. Een eerste indruk van de onderzoeksbuurten is als volgt." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "Verhuisstromen" ;
            sgpl:text_context "Of het karakteristieke woonmilieu van Kortenbos, Uilebomen en Zuidwal werkelijk aantrekkelijk is voor de genoemde bevolkingscategorieën is dus niet zeker. In de volgende hoofdstukken worden verhuisredenen en waardering voor het woonmilieu van geënqueteerde vestigers en vertrekkers besproken en zal blijken of het woonmilieu van doorslaggevend gewicht is of dat de beschikbaarheid van passende woonruimte de verhuisstromen bepaalt. Hoofdstuk 3 RESULTATEN VAN DE SURVEY: NAAR EEN TYPERING VAN DE INSTROMERS." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Binnenstedelijk woonmilieu" ;
            sgpl:text_context "De eerste doelstelling is het uitduiden van in- en uitstroom van bevolking in een buurt. De tweede is het opsporen van aantrekkelijke (of onaantrekkelijke) karakteristieken van het binnenstedelijke woonmilieu. Met deze tweeledige doelstelling voor ogen luidt de centrale vraag van ons onderzoek als volgt: voor welke bevolkingscategorieën vormt het binnenstedelijk woonmilieu een aantrekkelijke woonplaats (en voor welke niet)?" ] ;
    sgpl:thesisID 195 .

sgpl:Thesis196 a sgpl:SGPLThesis ;
    dcterms:creator "P. C. M. J. Boijmans" ;
    dcterms:issued 1989 ;
    dcterms:title "BEDRIJFS- EN INNOVATIECENTRA (BICs) IN DE GRENSREGIO'S BINNEN DE EUROPESE GEMEENSCHAP" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Euregio" ;
            sgpl:text_context "Een optimale benutting van het endogeen ontwikkelingspotentieel, als gevolg van de gunstige internationale ligging, lijkt deze regio* s in staat te stellen hun relatieve achterstandspositie t. o. v. de verschillende nationale centra op te hef fen. Voor een meer gedetailleerde regionale vergelijking zijn 8 grensregio's, afgebeeld in kaart 2. 2, geselecteerde: -Deens-Duitse grensregio (DK/D) -Eems-Dollard regio (D/NL) -Euregio (D/NL) -Grensregio Rij n-Maas-Noord (D/NL) -Benelux Middengebied (B/NL) -Euregio Maas-Rijn (B/NL/D) -Sarre-Lor-Lux regio (D/F/L) -Nord-Pas de Calais-Kent (F/GB). Binnen deze 8 grensregio' s varieert de mate van grensoverschrijdende samenwerking sterk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2960313,
                geonames:2997550 ;
            sgpl:spatialText "Sarre-Lor-Lux regio" ;
            sgpl:text_context "Een optimale benutting van het endogeen ontwikkelingspotentieel, als gevolg van de gunstige internationale ligging, lijkt deze regio* s in staat te stellen hun relatieve achterstandspositie t. o. v. de verschillende nationale centra op te hef fen. Voor een meer gedetailleerde regionale vergelijking zijn 8 grensregio's, afgebeeld in kaart 2. 2, geselecteerde: -Deens-Duitse grensregio (DK/D) -Eems-Dollard regio (D/NL) -Euregio (D/NL) -Grensregio Rij n-Maas-Noord (D/NL) -Benelux Middengebied (B/NL) -Euregio Maas-Rijn (B/NL/D) -Sarre-Lor-Lux regio (D/F/L) -Nord-Pas de Calais-Kent (F/GB). Binnen deze 8 grensregio' s varieert de mate van grensoverschrijdende samenwerking sterk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Grensregio Rijn-Maas-Noord" ;
            sgpl:text_context "Een optimale benutting van het endogeen ontwikkelingspotentieel, als gevolg van de gunstige internationale ligging, lijkt deze regio* s in staat te stellen hun relatieve achterstandspositie t. o. v. de verschillende nationale centra op te hef fen. Voor een meer gedetailleerde regionale vergelijking zijn 8 grensregio's, afgebeeld in kaart 2. 2, geselecteerde: -Deens-Duitse grensregio (DK/D) -Eems-Dollard regio (D/NL) -Euregio (D/NL) -Grensregio Rij n-Maas-Noord (D/NL) -Benelux Middengebied (B/NL) -Euregio Maas-Rijn (B/NL/D) -Sarre-Lor-Lux regio (D/F/L) -Nord-Pas de Calais-Kent (F/GB). Binnen deze 8 grensregio' s varieert de mate van grensoverschrijdende samenwerking sterk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:1861060 ;
            sgpl:spatialText "Japan" ;
            sgpl:text_context "Op het gebied van technologie en innovatie heeft de EG een groeiende achterstand op de Verenigde Staten en Japan. In deze landen ligt het technologisch ontwikkelingspeil op een hoger niveau, met name in de electro-technische industrie en informatica. Ook het aandeel van de uitgaven voor 0&0 in het bruto regionaal product ligt in beide landen op een hoger niveau dan in iedere EG-lidstaat (zie figuur 1. 3)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "de grensregio' s binnen de Europese Gemeenschap" ;
            sgpl:text_context "Daarbij is de samenwerking tussen overheid en bedrijfsleven en andere regionaal verantwoordelijke instanties cruciaal, zodat er sprake is van een zo breed mogelijk regionaal draagvlak. In welke mate kunnen deze BI Cs nu een structurele bijdrage leveren aan de opbloei van de regionale economie van de grensregio' s binnen de Europese Gemeenschap? De grensregio' s zijn in zekere mate het slachtoffer van de nog steeds niet volledige economische integratie binnen die Gemeenschap." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "de Verenigde Staten" ;
            sgpl:text_context "Op het gebied van technologie en innovatie heeft de EG een groeiende achterstand op de Verenigde Staten en Japan. In deze landen ligt het technologisch ontwikkelingspeil op een hoger niveau, met name in de electro-technische industrie en informatica. Ook het aandeel van de uitgaven voor 0&0 in het bruto regionaal product ligt in beide landen op een hoger niveau dan in iedere EG-lidstaat (zie figuur 1. 3)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6692168 ;
            sgpl:spatialText "Benelux Middengebied" ;
            sgpl:text_context "Een optimale benutting van het endogeen ontwikkelingspotentieel, als gevolg van de gunstige internationale ligging, lijkt deze regio* s in staat te stellen hun relatieve achterstandspositie t. o. v. de verschillende nationale centra op te hef fen. Voor een meer gedetailleerde regionale vergelijking zijn 8 grensregio's, afgebeeld in kaart 2. 2, geselecteerde: -Deens-Duitse grensregio (DK/D) -Eems-Dollard regio (D/NL) -Euregio (D/NL) -Grensregio Rij n-Maas-Noord (D/NL) -Benelux Middengebied (B/NL) -Euregio Maas-Rijn (B/NL/D) -Sarre-Lor-Lux regio (D/F/L) -Nord-Pas de Calais-Kent (F/GB). Binnen deze 8 grensregio' s varieert de mate van grensoverschrijdende samenwerking sterk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT. BEDRIJFS- EN INNOVATIECENTRA (BICs) IN DE GRENSREGIO' S BINNEN DE EUROPESE GEMEENSCHAP. P. C. M. J. Boi j mans." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:11609038,
                geonames:2990117 ;
            sgpl:spatialText "Nord-Pas de Calais-Kent" ;
            sgpl:text_context "Een optimale benutting van het endogeen ontwikkelingspotentieel, als gevolg van de gunstige internationale ligging, lijkt deze regio* s in staat te stellen hun relatieve achterstandspositie t. o. v. de verschillende nationale centra op te hef fen. Voor een meer gedetailleerde regionale vergelijking zijn 8 grensregio's, afgebeeld in kaart 2. 2, geselecteerde: -Deens-Duitse grensregio (DK/D) -Eems-Dollard regio (D/NL) -Euregio (D/NL) -Grensregio Rij n-Maas-Noord (D/NL) -Benelux Middengebied (B/NL) -Euregio Maas-Rijn (B/NL/D) -Sarre-Lor-Lux regio (D/F/L) -Nord-Pas de Calais-Kent (F/GB). Binnen deze 8 grensregio' s varieert de mate van grensoverschrijdende samenwerking sterk." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2800866 ;
            sgpl:spatialText "Brussel" ;
            sgpl:text_context "De scriptie wordt afgesloten met een conclusie. Het onderzoek is gecombineerd met een stage van 5 maanden bij de Commissie van de Europese Gemeenschappen op het Directoraat Generaal voor Regionaal Beleid (DG XVI) te Brussel. Tijdens deze periode zijn ook enkele bezoeken gebracht aan BICs en secretari aten van grensregio' s voor het afnemen van interviews." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Euregio Maas-Rijn" ;
            sgpl:text_context "Een optimale benutting van het endogeen ontwikkelingspotentieel, als gevolg van de gunstige internationale ligging, lijkt deze regio* s in staat te stellen hun relatieve achterstandspositie t. o. v. de verschillende nationale centra op te hef fen. Voor een meer gedetailleerde regionale vergelijking zijn 8 grensregio's, afgebeeld in kaart 2. 2, geselecteerde: -Deens-Duitse grensregio (DK/D) -Eems-Dollard regio (D/NL) -Euregio (D/NL) -Grensregio Rij n-Maas-Noord (D/NL) -Benelux Middengebied (B/NL) -Euregio Maas-Rijn (B/NL/D) -Sarre-Lor-Lux regio (D/F/L) -Nord-Pas de Calais-Kent (F/GB). Binnen deze 8 grensregio' s varieert de mate van grensoverschrijdende samenwerking sterk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Eems-Dollard regio" ;
            sgpl:text_context "Een optimale benutting van het endogeen ontwikkelingspotentieel, als gevolg van de gunstige internationale ligging, lijkt deze regio* s in staat te stellen hun relatieve achterstandspositie t. o. v. de verschillende nationale centra op te hef fen. Voor een meer gedetailleerde regionale vergelijking zijn 8 grensregio's, afgebeeld in kaart 2. 2, geselecteerde: -Deens-Duitse grensregio (DK/D) -Eems-Dollard regio (D/NL) -Euregio (D/NL) -Grensregio Rij n-Maas-Noord (D/NL) -Benelux Middengebied (B/NL) -Euregio Maas-Rijn (B/NL/D) -Sarre-Lor-Lux regio (D/F/L) -Nord-Pas de Calais-Kent (F/GB). Binnen deze 8 grensregio' s varieert de mate van grensoverschrijdende samenwerking sterk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2623032,
                geonames:2921044 ;
            sgpl:spatialText "Deens-Duitse grensregio" ;
            sgpl:text_context "Een optimale benutting van het endogeen ontwikkelingspotentieel, als gevolg van de gunstige internationale ligging, lijkt deze regio* s in staat te stellen hun relatieve achterstandspositie t. o. v. de verschillende nationale centra op te hef fen. Voor een meer gedetailleerde regionale vergelijking zijn 8 grensregio's, afgebeeld in kaart 2. 2, geselecteerde: -Deens-Duitse grensregio (DK/D) -Eems-Dollard regio (D/NL) -Euregio (D/NL) -Grensregio Rij n-Maas-Noord (D/NL) -Benelux Middengebied (B/NL) -Euregio Maas-Rijn (B/NL/D) -Sarre-Lor-Lux regio (D/F/L) -Nord-Pas de Calais-Kent (F/GB). Binnen deze 8 grensregio' s varieert de mate van grensoverschrijdende samenwerking sterk." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4271 ;
            sgpl:subjectText "grensregio's" ;
            sgpl:text_context "Daarbij is de samenwerking tussen overheid en bedrijfsleven en andere regionaal verantwoordelijke instanties cruciaal, zodat er sprake is van een zo breed mogelijk regionaal draagvlak. In welke mate kunnen deze BICs nu een structurele bijdrage leveren aan de opbloei van de regionale economie van de grensregio's binnen de Europese Gemeenschap? De grensregio's zijn in zekere mate het slachtoffer van de nog steeds niet volledige economische integratie binnen die Gemeenschap." ],
        [ sgpl:refersToConcept unesco:concept17170 ;
            sgpl:subjectText "innovatiepotentieel" ;
            sgpl:text_context "De onderlinge vergelijking van de ontwikkelingskansen van de 8 geselecteerde grensregio's is dan ook vooral toegespitst op deze thema's. De vraag die eigenlijk centraal staat in dit hoofdstuk is hoe groot het innovatiepotentieel van de 8 geselecteerde grensregio's is. Daartoe zijn 6 indicatoren geselecteerd, afgebeeld in figuur 2.1, die samen het regionaal innovatiepotentieel bepalen." ],
        [ sgpl:refersToConcept unesco:concept4893 ;
            sgpl:subjectText "bedrijfs- en innovatiecentra" ;
            sgpl:text_context "Daarbij komt als logisch gevolg van de sterke regionale oriëntatie, dat het regionaal beleid meer gedecentraliseerd wordt. Een van de initiatieven, afkomstig van de Europese Commissie gebaseerd op het hierboven geschetste beleid, vormen de bedrijfs- en innovatiecentra (BICs). Deze BICs zijn regionaal georiënteerde instanties, die trachten het midden- en kleinbedrijf (met name startende ondernemers) te ondersteunen op alle mogelijke terreinen (informatie, opleiding, financiering, huisvesting, technologie-overdracht)." ],
        [ sgpl:refersToConcept unesco:concept17170 ;
            sgpl:subjectText "innovatiepotentieel" ;
            sgpl:text_context "De onderlinge vergelijking van de ontwikkelingskansen van de 8 geselecteerde grensregio's is dan ook vooral toegespitst op deze thema's. De vraag die eigenlijk centraal staat in dit hoofdstuk is hoe groot het innovatiepotentieel van de 8 geselecteerde grensregio's is. Daartoe zijn 6 indicatoren geselecteerd, afgebeeld in figuur 2.1, die samen het regionaal innovatiepotentieel bepalen." ],
        [ sgpl:refersToConcept unesco:concept4893 ;
            sgpl:subjectText "bedrijfs- en innovatiecentra" ;
            sgpl:text_context "Daarbij komt als logisch gevolg van de sterke regionale oriëntatie, dat het regionaal beleid meer gedecentraliseerd wordt. Een van de initiatieven, afkomstig van de Europese Commissie gebaseerd op het hierboven geschetste beleid, vormen de bedrijfs- en innovatiecentra (BICs). Deze BICs zijn regionaal georiënteerde instanties, die trachten het midden- en kleinbedrijf (met name startende ondernemers) te ondersteunen op alle mogelijke terreinen (informatie, opleiding, financiering, huisvesting, technologie-overdracht)." ],
        [ sgpl:refersToConcept unesco:concept4271 ;
            sgpl:subjectText "grensregio's" ;
            sgpl:text_context "Daarbij is de samenwerking tussen overheid en bedrijfsleven en andere regionaal verantwoordelijke instanties cruciaal, zodat er sprake is van een zo breed mogelijk regionaal draagvlak. In welke mate kunnen deze BICs nu een structurele bijdrage leveren aan de opbloei van de regionale economie van de grensregio's binnen de Europese Gemeenschap? De grensregio's zijn in zekere mate het slachtoffer van de nog steeds niet volledige economische integratie binnen die Gemeenschap." ] ;
    sgpl:thesisID 196 .

sgpl:Thesis197 a sgpl:SGPLThesis ;
    dcterms:creator "Maurice Bovée" ;
    dcterms:issued 1989 ;
    dcterms:title "NETWERKEN IN DE ITALIAANSE KLEDINGINDUSTRIE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3169921 ;
            sgpl:spatialText "wolregio Prato" ;
            sgpl:text_context "Hoofdstuk 5 dient ter verduidelijking van de voorgaande hoofdstukken, hierin worden twee case-studies op basis van literatuur behandeld te weten het bedrijf Benetton en de wolregio Prato. Wolregio Prato, een network of firms. Het laagste geografisch analysenivo is aan de orde in hoofdstuk 6." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3182163 ;
            sgpl:spatialText "Bergamo" ;
            sgpl:text_context "Het laagste geografisch analysenivo is aan de orde in hoofdstuk 6. Hier wordt verslag gedaan van de bevindingen, op basis van gesprekken en intervieuws, in de vier onderzoeksprovincies t.w. Vercelli (in Piemonte) en Bergamo (in Lombardije) als onderdeel van het noordelijk kerngebied en Vicenza (in Veneto) en Arezzo (in Toscana) als onderdeel van het Derde Italië (zie figuur 1). In alle hoofdstukken staat steeds het functioneren van netwerken centraal." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3164564 ;
            sgpl:spatialText "Vercelli" ;
            sgpl:text_context "Het laagste geografisch analysenivo is aan de orde in hoofdstuk 6. Hier wordt verslag gedaan van de bevindingen, op basis van gesprekken en intervieuws, in de vier onderzoeksprovincies t.w. Vercelli (in Piemonte) en Bergamo (in Lombardije) als onderdeel van het noordelijk kerngebied en Vicenza (in Veneto) en Arezzo (in Toscana) als onderdeel van het Derde Italië (zie figuur 1). In alle hoofdstukken staat steeds het functioneren van netwerken centraal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Faculteit der Ruimtelijke Wetenschappen Rijksuniversiteit Utrecht. Maurice Bovèe juli 1989 RIJKSUNIVERSITEIT UTRECHT. Op de volgende pagina’s vindt u het verslag van het onderzoek \"netwerken in de Italiaanse kledingindustrie\"." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3173435 ;
            sgpl:spatialText "Milaan" ;
            sgpl:text_context "De keuze voor een onderzoek in Italië is logisch gezien mijn grote liefde voor dit land. De periode die ik heb doorgebracht aan de Universita Commerciale Luigi Bocconi in Milaan, was zeer leerzaam. De voornamelijk praktische problemen die ik daar steeds moest oplossen, hebben me het gevoel gegeven versterkt te zijn teruggekomen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3176219 ;
            sgpl:spatialText "Genua" ;
            sgpl:text_context "Milaan is juist een gedifferentiëerde en complexe stad, die voornamelijk draait op haar centrale functie in het noorden en fungeert als het financiëel centrum van Italië. Genua is de grote commerciële en industriestad met veel staatsbedrijven. Deze stad verliest momenteel zowel economische als regelende functies." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3175395 ;
            sgpl:spatialText "Italië" ;
            sgpl:text_context "Doctoraalonderzoek in de specialiatie economische geografie, Vakgroep Toegepaste Geografie en Ruimtelijke Planning, Faculteit der Ruimtelijke Wetenschappen Rijksuniversiteit Utrecht. NETWERKEN IN DE ITALIAANSE KLEDINGINDUSTRIE. Doctoraalonderzoek in de specialiatie economische geografie, Vakgroep Toegepaste Geografie en Ruimtelijke Planning, Faculteit der Ruimtelijke Wetenschappen Rijksuniversiteit Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3175395 ;
            sgpl:spatialText "Derde Italië" ;
            sgpl:text_context "Sinds het midden van de jaren zeventig is de problematiek echter complexer geworden als gevolg van de onderkenning van het z.g. Derde Italië. Dit Derde Italië betreft het gebied dat ligt ten oosten en ten zuiden van het noordelijk industrieel kerngebied en ten noorden van de Mezzogiorno (o.a. Bagnasco 1977). Dit gebied wordt getypeerd door een kleinschalig gedecentraliseerd produktiesysteem met een grote flexibiliteit en dynamiek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3165524 ;
            sgpl:spatialText "Turijn" ;
            sgpl:text_context "Echter vergeleken met de meeste andere hooggeïndustrialiseerde landen is zelfs het kerngebied een regio van kleine bedrijven met een relatief groot aandeel voor de traditionele sectoren. Turijn is een echte \"one-company town\", die zich heeft ontwikkeld op basis van de naoorlogse groei in de autoindustrie. De grootschalige Fiatfabrieken zijn dan ook de belangrijkste bestaansbron van de stad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3164418 ;
            sgpl:spatialText "Vicenza" ;
            sgpl:text_context "Het laagste geografisch analysenivo is aan de orde in hoofdstuk 6. Hier wordt verslag gedaan van de bevindingen, op basis van gesprekken en intervieuws, in de vier onderzoeksprovincies t.w. Vercelli (in Piemonte) en Bergamo (in Lombardije) als onderdeel van het noordelijk kerngebied en Vicenza (in Veneto) en Arezzo (in Toscana) als onderdeel van het Derde Italië (zie figuur 1). In alle hoofdstukken staat steeds het functioneren van netwerken centraal." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3182882 ;
            sgpl:spatialText "Arezzo" ;
            sgpl:text_context "Het laagste geografisch analysenivo is aan de orde in hoofdstuk 6. Hier wordt verslag gedaan van de bevindingen, op basis van gesprekken en intervieuws, in de vier onderzoeksprovincies t.w. Vercelli (in Piemonte) en Bergamo (in Lombardije) als onderdeel van het noordelijk kerngebied en Vicenza (in Veneto) en Arezzo (in Toscana) als onderdeel van het Derde Italië (zie figuur 1). In alle hoofdstukken staat steeds het functioneren van netwerken centraal." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3175395 ;
            sgpl:spatialText "noordelijk industrieel kerngebied" ;
            sgpl:text_context "Sinds het midden van de jaren zeventig is de problematiek echter complexer geworden als gevolg van de onderkenning van het z.g. Derde Italië. Dit Derde Italië betreft het gebied dat ligt ten oosten en ten zuiden van het noordelijk industrieel kerngebied en ten noorden van de Mezzogiorno (o.a. Bagnasco 1977). Dit gebied wordt getypeerd door een kleinschalig gedecentraliseerd produktiesysteem met een grote flexibiliteit en dynamiek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:12511203 ;
            sgpl:spatialText "Mezzogiorno" ;
            sgpl:text_context "Sinds het midden van de jaren zeventig is de problematiek echter complexer geworden als gevolg van de onderkenning van het z.g. Derde Italië. Dit Derde Italië betreft het gebied dat ligt ten oosten en ten zuiden van het noordelijk industrieel kerngebied en ten noorden van de Mezzogiorno (o.a. Bagnasco 1977). Dit gebied wordt getypeerd door een kleinschalig gedecentraliseerd produktiesysteem met een grote flexibiliteit en dynamiek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3182043 ;
            sgpl:spatialText "Biella" ;
            sgpl:text_context "Vicenza tenslotte heeft veel huiden- en wolindustrie (CESDIT 1988, p 73). Vercelli heeft een beroemd wolregio rond de stad Biella. Bergamo heeft een enorme onderkledingindustrie." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4877 ;
            sgpl:subjectText "productieve decentralisatie" ;
            sgpl:text_context "Ten slotte spelen de al eerder genoemde voordelen van het Derde Italië nog een rol: de polycentrale stedelijke struktuur, de arbeiders en de maatschappelijke consensus. De keuze voor de produktieve decentralisatie vloeit voort uit het grote aantal voordelen dat er mee te behalen is. Zo is bijvoorbeeld het belastingsysteem sterk in het voordeel van kleine bedrijven." ],
        [ sgpl:refersToConcept unesco:concept4300 ;
            sgpl:subjectText "flexibele specialisatie" ;
            sgpl:text_context "Sabel (1986, p 83-87) bouwt een theorie rondom deze voordelen die inhoudt dat als gevolg van een verregaande standaardisatie van technologie en produkt, de arbeidskosten de doorslaggevende factor zijn in de concurrentie op het gebied van de massaprodukten. Hij stelt dan ook dat de grootschalige produktiemethode voor de rijke landen zal verdwijnen en plaats maakt voor de flexibele specialisatie, voor de produktie van unieke produkten in kleine series. Dit betekent voor Italië een voorsprong op de rest van de rijke landen daar het deze produktiemethode al op grote schaal toepast." ],
        [ sgpl:refersToConcept unesco:concept12328 ;
            sgpl:subjectText "kledingindustrie" ;
            sgpl:text_context "Er komt bovendien een veelheid aan netwerkrelaties en samenwerkingsverbanden tussen bedrijven voor. Deze struktuur komt het duidelijkst tot uitdrukking in de kledingindustrie (King 1985, p 136-170). Onder meer hierom is deze sector dan ook onderwerp van studie." ],
        [ sgpl:refersToConcept unesco:concept4300 ;
            sgpl:subjectText "flexibele specialisatie" ;
            sgpl:text_context "Sabel (1986, p 83-87) bouwt een theorie rondom deze voordelen die inhoudt dat als gevolg van een verregaande standaardisatie van technologie en produkt, de arbeidskosten de doorslaggevende factor zijn in de concurrentie op het gebied van de massaprodukten. Hij stelt dan ook dat de grootschalige produktiemethode voor de rijke landen zal verdwijnen en plaats maakt voor de flexibele specialisatie, voor de produktie van unieke produkten in kleine series. Dit betekent voor Italië een voorsprong op de rest van de rijke landen daar het deze produktiemethode al op grote schaal toepast." ],
        [ sgpl:refersToConcept unesco:concept4877 ;
            sgpl:subjectText "productieve decentralisatie" ;
            sgpl:text_context "Ten slotte spelen de al eerder genoemde voordelen van het Derde Italië nog een rol: de polycentrale stedelijke struktuur, de arbeiders en de maatschappelijke consensus. De keuze voor de produktieve decentralisatie vloeit voort uit het grote aantal voordelen dat er mee te behalen is. Zo is bijvoorbeeld het belastingsysteem sterk in het voordeel van kleine bedrijven." ],
        [ sgpl:refersToConcept unesco:concept12328 ;
            sgpl:subjectText "kledingindustrie" ;
            sgpl:text_context "Er komt bovendien een veelheid aan netwerkrelaties en samenwerkingsverbanden tussen bedrijven voor. Deze struktuur komt het duidelijkst tot uitdrukking in de kledingindustrie (King 1985, p 136-170). Onder meer hierom is deze sector dan ook onderwerp van studie." ] ;
    sgpl:thesisID 197 .

sgpl:Thesis198 a sgpl:SGPLThesis ;
    dcterms:creator "Ard Broeze",
        "Peter Breel" ;
    dcterms:issued 1989 ;
    dcterms:title "Een onderzoek naar het ombouwen van niet-woonpanden tot woningen in een deel van de stad Utrecht.",
        "NIEUWE FUNCTIES IN OUDE VORMEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stad Utrecht" ;
            sgpl:text_context "Voor u ligt een scriptie over het ombouwen van panden met een andere dan een woonfunctie naar woningen. Deze scriptie is de neerslag van het onderzoek dat hiernaar gedaan is in een deel van de stad Utrecht. Scriptie en onderzoek zijn verricht in het kader van het vervolgdoctoraal programma van de studierichting Sociale Geografie aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de singels" ;
            sgpl:text_context "De stad Utrecht is gekozen omdat de beide onderzoekers in Utrecht wonen en enigszins bekend zijn met de stad. Binnen de stad Utrecht zijn de volgende stadsdelen uitgekozen als onderzoeksgebieden: -de binnenstad; -de singels; -de Maliebaan; -het Wilhelminapark. Deze keuze is gemaakt omdat in deze gebieden de meeste panden met een andere dan een woonfunctie te vinden zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Het St Antonius ziekenhuis verhuisde in 1983 naar Nieuwegein. Op één deel van het Antoniusterrein werd het revalidatiecentrum de Hoogstraat gebouwd. Het tweede deel van het ziekenhuisterrein werd, conform het beleidsuitgangspunt in het bestemmingsplan, tot woongebied bestemd (zie figuur 6)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrechtse binnenstad" ;
            sgpl:text_context "Vervolgens zullen enkele in het recente verleden naar een woonfunctie gewijzigde panden besproken worden. In het vierde hoofdstuk zullen dan de criteria ontwikkeld worden aan de hand waarvan een inventarisatie gemaakt kan worden van de potentiële voorraad om te bouwen panden in de Utrechtse binnenstad, de buitenrand van de singels, de Maliebaan en het WiIhelminapark en naaste omgeving. Hoofdstuk 1 Begripsdefiniëring, onderzoeksbegrenzingen, probleemstelling en operationalisatie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Maliebaan" ;
            sgpl:text_context "Binnen de stad Utrecht zijn de volgende stadsdelen uitgekozen als onderzoeksgebieden: -de binnenstad; -de singels; -de Maliebaan; -het Wilhelminapark. Deze keuze is gemaakt omdat in deze gebieden de meeste panden met een andere dan een woonfunctie te vinden zijn. Men kan dus aannemen dat in deze gebieden het potentiële aantal tot woningen om te bouwen panden het grootst is." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:8063319 ;
            sgpl:spatialText "Wilhelminapark" ;
            sgpl:text_context "Binnen de stad Utrecht zijn de volgende stadsdelen uitgekozen als onderzoeksgebieden: -de binnenstad; -de singels; -de Maliebaan; -het Wilhelminapark. Deze keuze is gemaakt omdat in deze gebieden de meeste panden met een andere dan een woonfunctie te vinden zijn. Men kan dus aannemen dat in deze gebieden het potentiële aantal tot woningen om te bouwen panden het grootst is." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10989 ;
            sgpl:subjectText "Functieveranderingen" ;
            sgpl:text_context "Meestal zal hier echter geen beleid aan ten grondslag hebben gelegen en waren deze wijzigingen dan ook ongestructureerd. De laatste jaren lijkt het echter of er meer lijn is gekomen in de richting van de -Functieveranderingen. Meestal betreft het nu het wijzigen van een (deel) van een pand met een niet-woonfunctie naar een woonfunctie." ],
        [ sgpl:refersToConcept unesco:concept5917 ;
            sgpl:subjectText "Herbestemming" ;
            sgpl:text_context "Figuur 1 laat een aantal mogelijke functieomzettingen van panden zien. De functieverandering die in ons onderzoek centraal staat is de herbestemming van verschillende soorten panden tot woningen. Het gaat dus om al de panden die een andere dan een woonfunctie hebben vervuld maar nu zijn, of in de toekomst worden, omgebouwd tot woningen." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Compacte stad" ;
            sgpl:text_context "Meestal betreft het nu het wijzigen van een (deel) van een pand met een niet-woonfunctie naar een woonfunctie. Deze vorm van hergebruik van panden past goed in het concept van de compacte stad dat door veel steden gehanteerd wordt in hun ruimtelijk beleid. Het compacte stad concept spitst zich toe op versterking van de stad waarbij de nadruk ligt op het bestaande stedelijke gebied." ],
        [ sgpl:refersToConcept unesco:concept10989 ;
            sgpl:subjectText "Functieveranderingen" ;
            sgpl:text_context "Meestal zal hier echter geen beleid aan ten grondslag hebben gelegen en waren deze wijzigingen dan ook ongestructureerd. De laatste jaren lijkt het echter of er meer lijn is gekomen in de richting van de -Functieveranderingen. Meestal betreft het nu het wijzigen van een (deel) van een pand met een niet-woonfunctie naar een woonfunctie." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Compacte stad" ;
            sgpl:text_context "Meestal betreft het nu het wijzigen van een (deel) van een pand met een niet-woonfunctie naar een woonfunctie. Deze vorm van hergebruik van panden past goed in het concept van de compacte stad dat door veel steden gehanteerd wordt in hun ruimtelijk beleid. Het compacte stad concept spitst zich toe op versterking van de stad waarbij de nadruk ligt op het bestaande stedelijke gebied." ],
        [ sgpl:refersToConcept unesco:concept5917 ;
            sgpl:subjectText "Herbestemming" ;
            sgpl:text_context "Figuur 1 laat een aantal mogelijke functieomzettingen van panden zien. De functieverandering die in ons onderzoek centraal staat is de herbestemming van verschillende soorten panden tot woningen. Het gaat dus om al de panden die een andere dan een woonfunctie hebben vervuld maar nu zijn, of in de toekomst worden, omgebouwd tot woningen." ] ;
    sgpl:thesisID 198 .

sgpl:Thesis199 a sgpl:SGPLThesis ;
    dcterms:creator "WIM DEKKERS" ;
    dcterms:issued 1989 ;
    dcterms:title "PC-GIS EN DE BESTEMMINGSPLAN-PRAKTIJK" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745088 ;
            sgpl:spatialText "Wageningse uiterwaarden" ;
            sgpl:text_context "Bij planvorming kan gedacht worden aan het gebruik van GIS bij de voorbereiding van bestemmingsplannen. Van Lammeren (1985) heeft in een case-study over de Wageningse uiterwaarden aangetoond dat GIS inderdaad een belangrijk hulpmiddel kan zijn bij het opstellen van een bestemmingsplan. Haar ervaring is opgedaan met het gebruik van het informatiesysteem voor nadere afweging van lokaties, wegtrace’s en veiligheidszones rond petrochemische installaties en kerncentrales." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Tenslotte wil ik mijn begeleider dr. J.J. Harts en- ook alle anderen die op een positieve manier hebben bijgedragen aan de totstandkoming van dit onderzoek, hiervoor dankzeggen. Wim Dekkers Utrecht, december 1988. Hoofdstuk 1: Onderzoeksopzet en probleemstelling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "VERSLAGEN VAN LEERONDERZOEK G & P vakgroep toegepaste geografie en ruimtelijke planning. Transitorium II, Heidelberglaan 2, De Uithof, UTRECHT (030)532044. 82 PC-GIS EN DE BESTEMMINGSPLAN- PRAKTIJK." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Romeinse Rijk" ;
            sgpl:text_context "De allereerste kaarten waren vooral navigatiemiddelen en hulpmiddel bij de oorlogvoering. In het Romeinse Rijk speelden kaarten een belangrijks rol bij de uitvoering van het bestuur over zo’n groot rijk. In de 15-de eeuw werden speciale overheidsdiensten opgericht om topografische overzichtskaarten van het land te maken." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5507 ;
            sgpl:subjectText "bestemmingsplannen" ;
            sgpl:text_context "In hoofdstuk 2 wordt GIS belicht. Hoofdstuk 3 behandelt bestemmingsplannen. Naast de wettelijke regelgeving komt hierbij ook vooral de praktische uitvoering aan de orde." ],
        [ sgpl:refersToConcept unesco:concept17000 ;
            sgpl:subjectText "Geografische Informatie Systemen" ;
            sgpl:text_context "Cp alle drie deze gebieden, het vervaardigen van kaarten, de statistische analyse en hot gegevensbeheer, bestaat al een langs automatiseringstrcditie. Deze drie zijn samengebracht in één programma. Dit zijn de Geografische Informatie Systemen (GIS). Hiermee kunnen cp een snelle en eenvoudige manier gegevens worden cpgeslagsn, analyses worden verricht en de uitkomsten van de analyses kunnen zichtbaar gemaakt worden op ccmputergetekende kaarten." ],
        [ sgpl:refersToConcept unesco:concept5446 ;
            sgpl:subjectText "globale bestemmingsplan" ;
            sgpl:text_context "De nieuwe regelgeving bevat aanknopingspunten cm te komen tot meer programmatische en beleidsmatige bestemmingsplannen, waarbij ook de flexibiliteit van het plan voorop staat. Dit nieuwe, zogenaamde globale bestemmingsplan wordt gekenmerkt door een hoog abstraotienivo, een behoefte aan omvangrijke en steeds recents gegevensbestanden en veelzijdige analysetechnieken (Das, 12S7). Van hieruit wordt tot de volgende probleemstelling gekomen: ”De recentelijke wijziging van de Wet op de Ruimtelijke Ordening zal leiden tot een veelvuldig-gebruik van een nieuw soort bestemmingsplan voor het bestaande stedelijke gebied." ],
        [ sgpl:refersToConcept unesco:concept17000 ;
            sgpl:subjectText "Geografische Informatie Systemen" ;
            sgpl:text_context "Cp alle drie deze gebieden, het vervaardigen van kaarten, de statistische analyse en hot gegevensbeheer, bestaat al een langs automatiseringstrcditie. Deze drie zijn samengebracht in één programma. Dit zijn de Geografische Informatie Systemen (GIS). Hiermee kunnen cp een snelle en eenvoudige manier gegevens worden cpgeslagsn, analyses worden verricht en de uitkomsten van de analyses kunnen zichtbaar gemaakt worden op ccmputergetekende kaarten." ],
        [ sgpl:refersToConcept unesco:concept5507 ;
            sgpl:subjectText "bestemmingsplannen" ;
            sgpl:text_context "In hoofdstuk 2 wordt GIS belicht. Hoofdstuk 3 behandelt bestemmingsplannen. Naast de wettelijke regelgeving komt hierbij ook vooral de praktische uitvoering aan de orde." ],
        [ sgpl:refersToConcept unesco:concept5446 ;
            sgpl:subjectText "globale bestemmingsplan" ;
            sgpl:text_context "De nieuwe regelgeving bevat aanknopingspunten cm te komen tot meer programmatische en beleidsmatige bestemmingsplannen, waarbij ook de flexibiliteit van het plan voorop staat. Dit nieuwe, zogenaamde globale bestemmingsplan wordt gekenmerkt door een hoog abstraotienivo, een behoefte aan omvangrijke en steeds recents gegevensbestanden en veelzijdige analysetechnieken (Das, 12S7). Van hieruit wordt tot de volgende probleemstelling gekomen: ”De recentelijke wijziging van de Wet op de Ruimtelijke Ordening zal leiden tot een veelvuldig-gebruik van een nieuw soort bestemmingsplan voor het bestaande stedelijke gebied." ] ;
    sgpl:thesisID 199 .

sgpl:Thesis200 a sgpl:SGPLThesis ;
    dcterms:creator "Jan Peter Everhard" ;
    dcterms:issued 1989 ;
    dcterms:title "CASE STUDY : GWRV OP HET TRAJECT NEDERLAND - MUNCHEN",
        "KANSEN VAN GECOMBINEERD WEG RAIL VERVOER IN NEDERLAND NA 1992",
        "Onderzoek naar de keuzesituatie tussen wegtransport en GWRV onder grote en middelgrote transportondernemingen" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT. KANSEN VAN GECOMBINEERD WEG RAIL VERVOER IN NEDERLAND NA 1992. CASE STUDY : GWRV OP HET TRAJECT NEDERLAND - MUNCHEN." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord Brabant" ;
            sgpl:text_context "De terminal in Rotterdam zal in 1990 overgeplaatst worden naar het moderne Rail Service Centrum op de linker Maasoever. Een studie loopt naar de realisatie van een terminal in Noord Brabant in het begin van de jaren ’90. Uiteindelijk moet ook in het Noord Nederland een GWRV terminal opgezet worden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "KANSEN VAN GECOMBINEERD WEG RAIL VERVOER IN NEDERLAND NA 1992. CASE STUDY : GWRV OP HET TRAJECT NEDERLAND - MUNCHEN. Onderzoek naar de keuzesituatie tussen wegtransport en GWRV onder grote en middelgrote transportondernemingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748076 ;
            sgpl:spatialText "Rijswijk" ;
            sgpl:text_context "AfdAlino algemeen vervoereconomisch onderzoek. Polakw l 13, 2280 DZ Rijswijk. Dit onderzoek richt zich op Gecombineerd Weg Rail Vervoer (GWRV)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Nederland beschikt momenteel over drie terminals : Rotterdam, Venlo en sinds oktober 1988 ook Ede. De terminal in Rotterdam zal in 1990 overgeplaatst worden naar het moderne Rail Service Centrum op de linker Maasoever. Een studie loopt naar de realisatie van een terminal in Noord Brabant in het begin van de jaren ’90." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2930509 ;
            sgpl:spatialText "Emmerich" ;
            sgpl:text_context "Een tijdsduur van 19 uur voor zowel de heen als de terugrit is een minimale voorwaarde. Dit vereist oplossing van het knelpunt Emmerich’: de NS zal de wagons op de ochtend van aankomst direct moeten distribueren over de Nederlandse terminals. Een directe verbinding met een tijdsduur van 15 uur vanaf Rotterdam is gewenst." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "West Nederland" ;
            sgpl:text_context "Na 9 uur werktijd volgt een verplichte rust van 8 uur. Munchen is dus in principe vanuit West Nederland niet in een dag haalbaar. In de praktijk achten transporteurs in de meer oostelijke landsdelen het traject wel in een dag haalbaar." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "regio München" ;
            sgpl:text_context "Dit is onderzocht met behulp van stated preference analyse voor het traject Nederland - regio M nchen. Het tweede hoofdstuk bestaat uit de verschillende delen van het bronnenonderzoek. De eerste paragraaf behandelt de kenmerken van GWRV als deelmarkt van het internationale wegtransport." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Noord Nederland" ;
            sgpl:text_context "Een studie loopt naar de realisatie van een terminal in Noord Brabant in het begin van de jaren ’90. Uiteindelijk moet ook in het Noord Nederland een GWRV terminal opgezet worden. Vier hoofdassen komen voor GWRV in aanmerking :" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "Tilburg" ;
            sgpl:text_context "Het 0-scenario : de oude dienstregeling. Een transporteur vindt deze dienstregeling acceptabel en bruikbaar bij het huidige tarief, mits de terminal in Tilburg gerealiseerd wordt. De overige respondenten reageren afwijzend ; alleeno in de C situatie ( EG road pricing en hogere dieselaccijns) is een transporteur bereid om over te stappen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745641 ;
            sgpl:spatialText "Venlo" ;
            sgpl:text_context "Nederland beschikt momenteel over drie terminals : Rotterdam, Venlo en sinds oktober 1988 ook Ede. De terminal in Rotterdam zal in 1990 overgeplaatst worden naar het moderne Rail Service Centrum op de linker Maasoever. Een studie loopt naar de realisatie van een terminal in Noord Brabant in het begin van de jaren ’90." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "München" ;
            sgpl:text_context "KANSEN VAN GECOMBINEERD WEG RAIL VERVOER IN NEDERLAND NA 1992. CASE STUDY : GWRV OP HET TRAJECT NEDERLAND - MUNCHEN. Onderzoek naar de keuzesituatie tussen wegtransport en GWRV onder grote en middelgrote transportondernemingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2951839 ;
            sgpl:spatialText "Süd Bayern" ;
            sgpl:text_context "Hierbij is ook de relatie Nederland - ZO Duitsland gekwantificeerd. De regio rond M nchen is echter slechts een onderdeel van dit gebied, dat bestaat uit het Bundesland Bayern en groter is dan Nederland. Daarom is voor deze relatie alleen rekening gehouden met de regio M nchen als COROP-bestand ’S d Bayern’, bestaande uit de Regierungsbezirke Schwaben en Oberbayern." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756429 ;
            sgpl:spatialText "Ede" ;
            sgpl:text_context "Nederland beschikt momenteel over drie terminals : Rotterdam, Venlo en sinds oktober 1988 ook Ede. De terminal in Rotterdam zal in 1990 overgeplaatst worden naar het moderne Rail Service Centrum op de linker Maasoever. Een studie loopt naar de realisatie van een terminal in Noord Brabant in het begin van de jaren ’90." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept7515 ;
            sgpl:subjectText "Stated preference analyse" ;
            sgpl:text_context "Het gaat erom meer inzicht te krijgen in de afweging die potentiële gebruikers maken tussen GWRV en wegtransport. Dit is onderzocht met behulp van stated preference analyse voor het traject Nederland - regio München. Het tweede hoofdstuk bestaat uit de verschillende delen van het bronnenonderzoek." ],
        [ sgpl:refersToConcept unesco:concept14294 ;
            sgpl:subjectText "Wegtransport" ;
            sgpl:text_context "Het internationale transport zal extra toenemen met 40 %. Het wegtransport zal hiervan het meeste profiteren in een scenario van liberalisering (A) . Alleen in een meer milieugericht scenario (B) zal ook het railvervoer flink toenemen." ],
        [ sgpl:refersToConcept unesco:concept15809 ;
            sgpl:subjectText "Gecombineerd Weg Rail Vervoer" ;
            sgpl:text_context "Met het oog op het probleemveld is vooral het internationale transport van belang. Het onderwerp van deze studie is gecombineerd weg-rail vervoer (GWRV) ; deze vervoerwijze vormt een deelmarkt van het wegtransport. De essentie van GWRV is dat het hoofdtraject over de rails plaatsvindt tussen twee overslagpunten of terminals." ],
        [ sgpl:refersToConcept unesco:concept7515 ;
            sgpl:subjectText "Stated preference analyse" ;
            sgpl:text_context "Het gaat erom meer inzicht te krijgen in de afweging die potentiële gebruikers maken tussen GWRV en wegtransport. Dit is onderzocht met behulp van stated preference analyse voor het traject Nederland - regio München. Het tweede hoofdstuk bestaat uit de verschillende delen van het bronnenonderzoek." ],
        [ sgpl:refersToConcept unesco:concept15809 ;
            sgpl:subjectText "Gecombineerd Weg Rail Vervoer" ;
            sgpl:text_context "Met het oog op het probleemveld is vooral het internationale transport van belang. Het onderwerp van deze studie is gecombineerd weg-rail vervoer (GWRV) ; deze vervoerwijze vormt een deelmarkt van het wegtransport. De essentie van GWRV is dat het hoofdtraject over de rails plaatsvindt tussen twee overslagpunten of terminals." ],
        [ sgpl:refersToConcept unesco:concept14294 ;
            sgpl:subjectText "Wegtransport" ;
            sgpl:text_context "Het internationale transport zal extra toenemen met 40 %. Het wegtransport zal hiervan het meeste profiteren in een scenario van liberalisering (A) . Alleen in een meer milieugericht scenario (B) zal ook het railvervoer flink toenemen." ] ;
    sgpl:thesisID 200 .

sgpl:Thesis201 a sgpl:SGPLThesis ;
    dcterms:creator "R.Th.J.H. Joosten" ;
    dcterms:issued 1989 ;
    dcterms:title "Het Nederlands Spoorwegmuseum; een bezoekersonderzoek" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Noord-Holland" ;
            sgpl:text_context "Utrecht is als belangrijkste provincie vertegenwoordigd met 27%. Ook Noord- en Zuidholland vormen met 20% en 22% belangrijke herkomstprovincies voor het museum. De provincies Gelderland met 10% en Noordbrabant met 7% bezetten een vierde en een vijfde plaats." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Zuid-Nederland" ;
            sgpl:text_context "Mensen die in Zuid-Nederland wonen (Zeeland, Noord-Brabant, Limburg) bezoeken minder vaak een museum dan mensen uit andere provincies. Vooral uit de provincies Utrecht en Noord-Holland komen de meeste bezoekers. Tenslotte kan een verband worden gevonden tussen gemeentegrootte en museumbezoek.: hoe meer inwoners de woongemeente heeft, hoe meer men musea bezoekt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Centraal Station" ;
            sgpl:text_context "Ter gelegenheid van dit feest zal ook een toeristische treinverbinding tussen het Centraal Station en het museum tot stand worden gebracht. De ontwikkeling van het museum wordt door meerdere instanties ondersteund en past binnen het streven van de gemeente Utrecht de stad op toeristisch-recreatief gebied aan te pakken. Dit streven staat verwoord in het rapport \"Utrecht, hart van Nederland\" (GRONTMIJ, 1985) dat in een samenwerkingsverband tussen ondermeer gemeente Utrecht, de WV en de Kamer van Koophandel is geschreven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noordbrabant" ;
            sgpl:text_context "De provincies Gelderland met 10% en Noordbrabant met 7% bezetten een vierde en een vijfde plaats. Een soortgelijk beeld levert het Eindrapport Uitbreiding op. In vergelijking tot het HTS rapport geeft het herkomstbeeld van het bezoekersonderzoek uit 1988 een betere spreiding te zien." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Maliebaanstation" ;
            sgpl:text_context "Een van deze musea is het Nederlands Spoorwegmuseum, gehuisvest in het monumentale gebouw van het vroegere Maliebaanstation. Het museum biedt ruimte aan een grote collectie materieel op het perron en in het binnengedeelte zijn museumstukken van diverse aard, waaronder schilderijen en modellen, te zien. Vanwege de leeftijd van het Nederlands Spoorwegmuseum is de accommodatie en de presentatie verouderd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "het westen van Nederland" ;
            sgpl:text_context "De redenen hiervoor liggen voor de hand; het westen van Nederland is dichtbevolkt en mensen uit grote steden hebben een hogere cultuurparticipatie, hetgeen de musea op hun beurt weer aanzet tot het juist daar reklame maken. Het een en ander betekent dat het uitstippelen van een gezamenlijke marketingstrategie in het benaderen van deze provincies opgezet kan worden. Op deze manier worden schaalvoordelen behaald en kan men de mensen wijzen op de mogelijkheid van combinatiebezoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Limburg" ;
            sgpl:text_context "Mensen die in Zuid-Nederland wonen (Zeeland, Noord-Brabant, Limburg) bezoeken minder vaak een museum dan mensen uit andere provincies. Vooral uit de provincies Utrecht en Noord-Holland komen de meeste bezoekers. Tenslotte kan een verband worden gevonden tussen gemeentegrootte en museumbezoek.: hoe meer inwoners de woongemeente heeft, hoe meer men musea bezoekt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744011 ;
            sgpl:spatialText "Zeeland" ;
            sgpl:text_context "Mensen die in Zuid-Nederland wonen (Zeeland, Noord-Brabant, Limburg) bezoeken minder vaak een museum dan mensen uit andere provincies. Vooral uit de provincies Utrecht en Noord-Holland komen de meeste bezoekers. Tenslotte kan een verband worden gevonden tussen gemeentegrootte en museumbezoek.: hoe meer inwoners de woongemeente heeft, hoe meer men musea bezoekt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Dit streven staat verwoord in het rapport \"Utrecht, hart van Nederland\" (GRONTMIJ, 1985) dat in een samenwerkingsverband tussen ondermeer gemeente Utrecht, de WV en de Kamer van Koophandel is geschreven. Eén van de conclusies uit deze studie is dat het Nederlands Spoorwegmuseum behoefte heeft aan een goed marketing- en promotieplan. Een onderdeel van dit plan vormt een bezoekersonderzoek om over doelgroepen meer informatie te krijgen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelderland" ;
            sgpl:text_context "Ook Noord- en Zuidholland vormen met 20% en 22% belangrijke herkomstprovincies voor het museum. De provincies Gelderland met 10% en Noordbrabant met 7% bezetten een vierde en een vijfde plaats. Een soortgelijk beeld levert het Eindrapport Uitbreiding op." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "R.Th.J.H. Joosten Breda 1989 VERSLAGEN VAN LEERONDERZOEK G & P. Het Nederlands Spoorwegmuseum; een bezoekersonderzoek. R.Th.J.H. Joosten Breda 1989." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "de stad Utrecht" ;
            sgpl:text_context "1. Inleiding 1.1 Inleiding De stad Utrecht heeft op toeristisch-recreatief gebied heel wat attracties te bieden waaronder een aantal musea. Een van deze musea is het Nederlands Spoorwegmuseum, gehuisvest in het monumentale gebouw van het vroegere Maliebaanstation." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743698 ;
            sgpl:spatialText "Zuid-Holland" ;
            sgpl:text_context "Utrecht is als belangrijkste provincie vertegenwoordigd met 27%. Ook Noord- en Zuidholland vormen met 20% en 22% belangrijke herkomstprovincies voor het museum. De provincies Gelderland met 10% en Noordbrabant met 7% bezetten een vierde en een vijfde plaats." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Ter gelegenheid van dit feest zal ook een toeristische treinverbinding tussen het Centraal Station en het museum tot stand worden gebracht. De ontwikkeling van het museum wordt door meerdere instanties ondersteund en past binnen het streven van de gemeente Utrecht de stad op toeristisch-recreatief gebied aan te pakken. Dit streven staat verwoord in het rapport \"Utrecht, hart van Nederland\" (GRONTMIJ, 1985) dat in een samenwerkingsverband tussen ondermeer gemeente Utrecht, de WV en de Kamer van Koophandel is geschreven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Voor u ligt het onderzoeksverslag van een bezoekersonderzoek in het Nederlands Spoorwegmuseum te Utrecht in 1988. Het verslag is geschreven in het kader van de doctoraalscriptie sociale geografie aan de Rijksuniversiteit te Utrecht (Vakgroep Toegepaste Geografie en Ruimtelijke Planning). Hoewel de voorbereidingen voor het onderzoek reeds in 1987 zijn gestart, heeft de rapportage pas in april 1989 plaatsgevonden." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept16236 ;
            sgpl:subjectText "Bezoekersonderzoek" ;
            sgpl:text_context "Eén van de conclusies uit deze studie is dat het Nederlands Spoorwegmuseum behoefte heeft aan een goed marketing- en promotieplan. Een onderdeel van dit plan vormt een bezoekersonderzoek om over doelgroepen meer informatie te krijgen. Dit bezoekersonderzoek kreeg gestalte in deze afstudeeropdracht aan het Geografisch Instituut van de Rijksuniversiteit Utrecht." ],
        [ sgpl:refersToConcept unesco:concept12330 ;
            sgpl:subjectText "Bezoekersmarkt" ;
            sgpl:text_context "We kunnen nu de bezoekersmarkt met behulp van de drie onderscheiden kenmerken van de bezoekers in een model zichtbaar maken; In het model is de bezoekersmarkt in drie delen opgesplitst, namelijk in de reële bezoekers, de potentiële bezoekers en de niet-bezoekers. Het marktsegment reële bezoekers wordt gevormd door diegenen die het museum voor het eerst bezoeken, de nieuwe bezoekers, en door de herhalingsbezoekers; zij die het museum voor een tweede keer of vaker bezoeken." ],
        [ sgpl:refersToConcept unesco:concept11650 ;
            sgpl:subjectText "Doelgroepen" ;
            sgpl:text_context "Een onderdeel van dit plan vormt een bezoekersonderzoek om over doelgroepen meer informatie te krijgen. De eerste probleemstelling van het onderzoek luidt: \"welke doelgroepen bezoeken het Nederlands Spoorwegmuseum\". De term \"doelgroepen\" is afkomstig uit de marketingleer waarmee men consumenten tracht te omschrijven die op een aantal variabelen overeenkomsten vertonen." ],
        [ sgpl:refersToConcept unesco:concept12330 ;
            sgpl:subjectText "Bezoekersmarkt" ;
            sgpl:text_context "We kunnen nu de bezoekersmarkt met behulp van de drie onderscheiden kenmerken van de bezoekers in een model zichtbaar maken; In het model is de bezoekersmarkt in drie delen opgesplitst, namelijk in de reële bezoekers, de potentiële bezoekers en de niet-bezoekers. Het marktsegment reële bezoekers wordt gevormd door diegenen die het museum voor het eerst bezoeken, de nieuwe bezoekers, en door de herhalingsbezoekers; zij die het museum voor een tweede keer of vaker bezoeken." ],
        [ sgpl:refersToConcept unesco:concept16236 ;
            sgpl:subjectText "Bezoekersonderzoek" ;
            sgpl:text_context "Eén van de conclusies uit deze studie is dat het Nederlands Spoorwegmuseum behoefte heeft aan een goed marketing- en promotieplan. Een onderdeel van dit plan vormt een bezoekersonderzoek om over doelgroepen meer informatie te krijgen. Dit bezoekersonderzoek kreeg gestalte in deze afstudeeropdracht aan het Geografisch Instituut van de Rijksuniversiteit Utrecht." ],
        [ sgpl:refersToConcept unesco:concept11650 ;
            sgpl:subjectText "Doelgroepen" ;
            sgpl:text_context "Een onderdeel van dit plan vormt een bezoekersonderzoek om over doelgroepen meer informatie te krijgen. De eerste probleemstelling van het onderzoek luidt: \"welke doelgroepen bezoeken het Nederlands Spoorwegmuseum\". De term \"doelgroepen\" is afkomstig uit de marketingleer waarmee men consumenten tracht te omschrijven die op een aantal variabelen overeenkomsten vertonen." ] ;
    sgpl:thesisID 201 .

sgpl:Thesis202 a sgpl:SGPLThesis ;
    dcterms:creator "P.J.R. LETSCHERT" ;
    dcterms:issued 1989 ;
    dcterms:title "BELEGGINGSBELEID VAN INSTITUTIONELE BELEGGERS IN DE AMSTERDAMSE BINNENSTAD",
        "een onderzoek naar het afweegproces onder institutionele beleggers met betrekking tot het beleggen op de markt voor met name bestaande kantoorruimte in de Amsterdamse binnenstad" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "agglomeratie Amsterdam" ;
            sgpl:text_context "2.6 rendement en prestatievermogen van een kantoorgebouw 1 0. 2.7 kantoorlocaties in een grootstede lijk stadsgewest in het algemeen en in de agglomeratie Amsterdam in het bijzonder 1 2. 2.8 vestigingsplaatseisen van beleggers en gebruikers van kantoorpanden 1 2." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdamse binnenstad" ;
            sgpl:text_context "BELEGGINGSBELEID VAN INSTITUTIONELE BELEGGERS IN DE AMSTERDAMSE BINNENSTAD. een onderzoek naar het afweegproces onder institutionele beleggers met betrekking tot het beleggen op de markt voor met name bestaande kantoorruimte in de Amsterdamse binnenstad. PJ.R. LETSCHERT APRIL 1989." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT. BELEGGINGSBELEID VAN INSTITUTIONELE BELEGGERS IN DE AMSTERDAMSE BINNENSTAD. een onderzoek naar het afweegproces onder institutionele beleggers met betrekking tot het beleggen op de markt voor met name bestaande kantoorruimte in de Amsterdamse binnenstad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "HOOFDSTUK 1, INLEIDING-. Vanaf begin jaren tachtig hebben zich op de kantoorruimtemarkt in Amsterdam ontwikkelingen voorgedaan die voor de markt op zich, met name de laatste vier jaar, positief zijn te noemen, maar die voor het stadscentrum in ieder geval negatief te kwalificeren zijn. Hoewel het aanbod van kantoorruimte in Amsterdam sinds1984 flink is teruggelopen en sinds 1982 een duidelijke toeneming in het aantal kantoortransacties en aantal m2 valt waar te nemen, blijft de direct beschikbare hoeveelheid kantoorruimte relatief groot." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753801 ;
            sgpl:spatialText "Hoofddorp" ;
            sgpl:text_context "Mijn studiebegeleider, de heer drs. P.J. Korteweg, ben ik zeer erkentelijk voor zijn kritische en constructieve bijdrage aan de totstandkoming van dit verslag. HOOFDDORP, APRIL 1989. PJ.R. LETSCHERT GROTE BELT 358 a 2133 GL HOOFDDORP tel. 02503-14982 privé." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "binnenstad van Amsterdam" ;
            sgpl:text_context "Voor hen de noodzaak zich, om in de markt te blijven, te buigen over de vraag, wat er met hun panden zou moeten worden gedaan om ze concurrerend te houden of te krijgen ten opzichte van het grote aantal alternatieve mogelijkheden in de kantoornieuwbouw. Doelstelling van dit onderzoek is inzicht te krijgen in het beleggingsbeleid van institutionele beleggers met betrekking tot de kantoorruimtemarkt in de binnenstad van Amsterdam. Het accent zal hierbij komen te liggen op het afweegproces onder beleggers van (commercieel verouderde) kantoorpanden ten aanzien van de vraag of, en zo ja, hoe, een verouderd kantoorpand voor vragers op deze markt weer commercieel aantrekkelijk kan worden gemaakt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754999 ;
            sgpl:spatialText "gemeente Haarlemmermeer" ;
            sgpl:text_context "Dat een en ander heeft geleid tot dit verslag van het onderzoek is in het bijzonder te danken aan mijn echtgenote, Doutzen, die zich in meerdere opzichten heeft ingespannen om dit onderzoek en mijn studie in het algemeen tot een goed einde te brengen; één ervan was het uittypen van dit verslag. Het begrip dat 'mijn' afdelingshoofd, de heer drs. B. Abma, van de afdeling Planologie en Statistiek van de gemeente Haarlemmermeer voor mijn werk/studiesituatie heeft getoond, is voor mij een goede stimulans geweest. Bij mijn collega, stedebouwkundige AvB, de heer ing. B.J.H. Jansen, kon ik met al mijn vragen over (en problemen met) PC-gebruik en de lay-out van mijn verslag terecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "centrumgebied van Amsterdam" ;
            sgpl:text_context "4. het uit de markt nemen van kantoorruimte. Wel geeft het aan dat in potentie de mogelijkheid aanwezig is om compensatie te bieden aan het vertrek van (kantoor)bedrijvigheid uit het centrumgebied van Amsterdam [BEO, 1987, p. 5 en 6]. Het beleid van de gemeente Amsterdam is gericht op het behoud van werkgelegenheid in en het veelzijdige citykarakter van de binnenstad door beïnvloeding van het investeringsproces." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10861 ;
            sgpl:subjectText "institutionele beleggers" ;
            sgpl:text_context "Beleggers en andere eigenaren van kantoorpanden in de binnenstad zullen derhalve worden geconfronteerd met het probleem dat hun panden om bepaalde redenen met leegstand te maken kunnen krijgen. Doelstelling van dit onderzoek is inzicht te krijgen in het beleggingsbeleid van institutionele beleggers met betrekking tot de kantoorruimtemarkt in de binnenstad van Amsterdam. Het accent zal hierbij komen te liggen op het afweegproces onder beleggers van (commercieel verouderde) kantoorpanden ten aanzien van de vraag of, en zo ja, hoe, een verouderd kantoorpand voor vragers op deze markt weer commercieel aantrekkelijk kan worden gemaakt." ],
        [ sgpl:refersToConcept unesco:concept13884 ;
            sgpl:subjectText "afweegproces" ;
            sgpl:text_context "Doelstelling van dit onderzoek is inzicht te krijgen in het beleggingsbeleid van institutionele beleggers met betrekking tot de kantoorruimtemarkt in de binnenstad van Amsterdam. Het accent zal hierbij komen te liggen op het afweegproces onder beleggers van (commercieel verouderde) kantoorpanden ten aanzien van de vraag of, en zo ja, hoe, een verouderd kantoorpand voor vragers op deze markt weer commercieel aantrekkelijk kan worden gemaakt. Getracht zal worden duidelijkheid te krijgen welke factoren en informatie van (doorslaggevend) belang zijn in dit afweegproces." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "kantoorruimtemarkt" ;
            sgpl:text_context "In hoofdstuk 2 zullen allereerst het theoretisch kader en uitgangspunten van dit onderzoek worden uitgewerkt. Beschrijvingen van de kantoorruimtemarkt, de (institutionele) belegger als actor op deze markt, het begrip A1-locatie en vestigingsplaatseisen zullen hier onderdeel van uitmaken. Hoofdstuk 3 geeft specifieke informatie over de situatie op de Amsterdamse kantoorruimtemarkt, toegespitst op de binnenstad." ],
        [ sgpl:refersToConcept unesco:concept13884 ;
            sgpl:subjectText "afweegproces" ;
            sgpl:text_context "Doelstelling van dit onderzoek is inzicht te krijgen in het beleggingsbeleid van institutionele beleggers met betrekking tot de kantoorruimtemarkt in de binnenstad van Amsterdam. Het accent zal hierbij komen te liggen op het afweegproces onder beleggers van (commercieel verouderde) kantoorpanden ten aanzien van de vraag of, en zo ja, hoe, een verouderd kantoorpand voor vragers op deze markt weer commercieel aantrekkelijk kan worden gemaakt. Getracht zal worden duidelijkheid te krijgen welke factoren en informatie van (doorslaggevend) belang zijn in dit afweegproces." ],
        [ sgpl:refersToConcept unesco:concept10861 ;
            sgpl:subjectText "institutionele beleggers" ;
            sgpl:text_context "Beleggers en andere eigenaren van kantoorpanden in de binnenstad zullen derhalve worden geconfronteerd met het probleem dat hun panden om bepaalde redenen met leegstand te maken kunnen krijgen. Doelstelling van dit onderzoek is inzicht te krijgen in het beleggingsbeleid van institutionele beleggers met betrekking tot de kantoorruimtemarkt in de binnenstad van Amsterdam. Het accent zal hierbij komen te liggen op het afweegproces onder beleggers van (commercieel verouderde) kantoorpanden ten aanzien van de vraag of, en zo ja, hoe, een verouderd kantoorpand voor vragers op deze markt weer commercieel aantrekkelijk kan worden gemaakt." ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "kantoorruimtemarkt" ;
            sgpl:text_context "In hoofdstuk 2 zullen allereerst het theoretisch kader en uitgangspunten van dit onderzoek worden uitgewerkt. Beschrijvingen van de kantoorruimtemarkt, de (institutionele) belegger als actor op deze markt, het begrip A1-locatie en vestigingsplaatseisen zullen hier onderdeel van uitmaken. Hoofdstuk 3 geeft specifieke informatie over de situatie op de Amsterdamse kantoorruimtemarkt, toegespitst op de binnenstad." ] ;
    sgpl:thesisID 202 .

sgpl:Thesis203 a sgpl:SGPLThesis ;
    dcterms:creator "Ellen Maaskant" ;
    dcterms:issued 1989 ;
    dcterms:title "Specialisatie cq diversifikatie",
        "de rol van de vrouw binnen de bestaansstrategie" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3517812 ;
            sgpl:spatialText "San Sebastian Abasolo" ;
            sgpl:text_context "Ik heb voor het dorp San Sebastian Abasolo gekozen omdat dit een van de weinige dorpen in de omgeving van Rojas is waar ook, net als in Rojas, kaas gemaakt wordt. Verder speelde mee dat de gegevens onderling redelijk vergelijkbaar waren, mede vanwege het feit dat het onderzoek in Abasolo een jaar eerder had plaatsgevonden. De bestaansstrategieën van de peasants in Rojas de Cuauhtémoc zijn afwijkend van die van de peasants in nabij liggende dorpen, zoals San Sebastian Abasolo." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3515484 ;
            sgpl:spatialText "de vallei van Tlacolula" ;
            sgpl:text_context "Rojas ligt in het oostelijk deel van de centrale valleien van Oaxaca, in de vallei van Tlacolula (zie bijlage 1) op een hoogte van 1678 meter. De gemiddelde jaartemperatuur is 18'C, met een droge winter en een regentijd van eind mei tot begin oktober. Rojas heeft een bevolking die volledig uit mestiezen bestaat." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3522507 ;
            sgpl:spatialText "de vallei van Oaxaca" ;
            sgpl:text_context "Dit veldwerk heb ik in 1985 verricht in het dorp Rojas de Cuauhtémoc in de vallei van Oaxaca, Mexico. Hier heb ik, samen met Marian Blankman, 3 maanden gewoond en ons onderzoek gedaan. Ons leeronderzoek vond plaats binnen georganiseerd vakgroep verband en werd uitgevoerd in het kader van het lopende onderzoeksprogramma dat in november 1982 gestart werd in samenwerking met het Sociologisch Onderzoeksinstituut van de Universiteit \"Benito Juarez\" in Oaxaca, Mexico." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3522507 ;
            sgpl:spatialText "Oaxaca" ;
            sgpl:text_context "Dit veldwerk heb ik in 1985 verricht in het dorp Rojas de Cuauhtémoc in de vallei van Oaxaca, Mexico. Hier heb ik, samen met Marian Blankman, 3 maanden gewoond en ons onderzoek gedaan. Ons leeronderzoek vond plaats binnen georganiseerd vakgroep verband en werd uitgevoerd in het kader van het lopende onderzoeksprogramma dat in november 1982 gestart werd in samenwerking met het Sociologisch Onderzoeksinstituut van de Universiteit \"Benito Juarez\" in Oaxaca, Mexico." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3522507 ;
            sgpl:spatialText "Universiteit \"Benito Juarez\" in Oaxaca" ;
            sgpl:text_context "Ons leeronderzoek vond plaats binnen georganiseerd vakgroep verband en werd uitgevoerd in het kader van het lopende onderzoeksprogramma dat in november 1982 gestart werd in samenwerking met het Sociologisch Onderzoeksinstituut van de Universiteit \"Benito Juarez\" in Oaxaca, Mexico. Het onderzoek richtte zich in zijn totaliteit op de “overlevingsstrategieën van de peasanthuishoudens in de vallei van Oaxaca, Mexico. \" Een peasanthuishouden kan gezien worden als een eenheid van produktie (van gebruiks- en ruilwaarden) en als eenheid van reproduktie (op dagelijkse- en generatiegewijze basis)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747169 ;
            sgpl:spatialText "Sliedrecht" ;
            sgpl:text_context "En ten slotte bedank ik Ruud voor zijn steun, zorg en afleiding. Sliedrecht, juni 1989. INHOUD" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3801591 ;
            sgpl:spatialText "Rojas de Cuauhtémoc" ;
            sgpl:text_context "Een onderdeel van de doktoraalstudie Sociale Geografie van de Ontwikkelingslanden, waarmee ik op de Vrije Universiteit gestart ben, was het veldwerk/leeronderzoek in Oaxaca, Mexico. Dit veldwerk heb ik in 1985 verricht in het dorp Rojas de Cuauhtémoc in de vallei van Oaxaca, Mexico. Hier heb ik, samen met Marian Blankman, 3 maanden gewoond en ons onderzoek gedaan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3996063 ;
            sgpl:spatialText "Mexico" ;
            sgpl:text_context "Een onderdeel van de doktoraalstudie Sociale Geografie van de Ontwikkelingslanden, waarmee ik op de Vrije Universiteit gestart ben, was het veldwerk/leeronderzoek in Oaxaca, Mexico. Dit veldwerk heb ik in 1985 verricht in het dorp Rojas de Cuauhtémoc in de vallei van Oaxaca, Mexico. Hier heb ik, samen met Marian Blankman, 3 maanden gewoond en ons onderzoek gedaan." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1714 ;
            sgpl:subjectText "Bestaansstrategieën" ;
            sgpl:text_context "Dit terwijl de aktiviteiten van de peasants in San Sebastian Abasolo veel diverser zijn. waar nietemin ook geproduceerd wordt voor de markt. Mijn centrale vraag is nu: Wat voor gevolg hebben deze verschillen voor de rol van de vrouw binnen de bestaansstrategieën? Anders gezegd: Betekent specialisatie binnen een bestaansstrategie dat mannen voornamelijk verantwoordelijk zijn voor de produktieve aktiviteiten, terwijl diversifikatie inhoudt dat ook vrouwen een belangrijke produktieve rol spelen?" ],
        [ sgpl:refersToConcept unesco:concept600 ;
            sgpl:subjectText "Melkveeteelt" ;
            sgpl:text_context "Voor dit skriptie-verslag heb ik gekozen om een vergelijking te maken tussen twee dorpen, in plaats van alleen de situatie in Rojas de Cuauhtémoc te behandelen, aangezien Marian Blankman dat laatste al gedaan heeft in haar skriptie-verslag. Aangezien wij tijdens ons verblijf in Rojas de Cuauhtémoc al opgemerkt hadden dat Rojas een uitzondering vormde vergeleken met de andere dorpen in de omgeving vanwege de specialisatie in de melkveeteelt, leek het mij interessant om een vergelijking met zo'n ander dorp te maken op het gebied van overlevings- en bestaansstrategieën *2) en op het gebied van de arbeidsdeling tussen de geslachten. Ik heb voor het dorp San Sebastian Abasolo gekozen omdat dit een van de weinige dorpen in de omgeving van Rojas is waar ook. net als in Rojas, kaas gemaakt wordt." ],
        [ sgpl:refersToConcept unesco:concept8270 ;
            sgpl:subjectText "Arbeidsdeling tussen de geslachten" ;
            sgpl:text_context "Juist deze arbeidsdeling tussen de geslachten zal het zwaartepunt vormen van dit skriptie-verslag. Ik verwijs dan ook voor mijn visie op cq verklaring van het verschijnsel van de arbeidsdeling tussen de geslachten naar het theoretische hoofdstuk, zijnde hoofdstuk II. Voor dit skriptie-verslag heb ik gekozen om een vergelijking te maken tussen twee dorpen, in plaats van alleen de situatie in Rojas de Cuauhtémoc te behandelen, aangezien Marian Blankman dat laatste al gedaan heeft in haar skriptie-verslag. (Blankman 1987)" ],
        [ sgpl:refersToConcept unesco:concept8270 ;
            sgpl:subjectText "Arbeidsdeling tussen de geslachten" ;
            sgpl:text_context "Juist deze arbeidsdeling tussen de geslachten zal het zwaartepunt vormen van dit skriptie-verslag. Ik verwijs dan ook voor mijn visie op cq verklaring van het verschijnsel van de arbeidsdeling tussen de geslachten naar het theoretische hoofdstuk, zijnde hoofdstuk II. Voor dit skriptie-verslag heb ik gekozen om een vergelijking te maken tussen twee dorpen, in plaats van alleen de situatie in Rojas de Cuauhtémoc te behandelen, aangezien Marian Blankman dat laatste al gedaan heeft in haar skriptie-verslag. (Blankman 1987)" ],
        [ sgpl:refersToConcept unesco:concept1714 ;
            sgpl:subjectText "Bestaansstrategieën" ;
            sgpl:text_context "Dit terwijl de aktiviteiten van de peasants in San Sebastian Abasolo veel diverser zijn. waar nietemin ook geproduceerd wordt voor de markt. Mijn centrale vraag is nu: Wat voor gevolg hebben deze verschillen voor de rol van de vrouw binnen de bestaansstrategieën? Anders gezegd: Betekent specialisatie binnen een bestaansstrategie dat mannen voornamelijk verantwoordelijk zijn voor de produktieve aktiviteiten, terwijl diversifikatie inhoudt dat ook vrouwen een belangrijke produktieve rol spelen?" ],
        [ sgpl:refersToConcept unesco:concept600 ;
            sgpl:subjectText "Melkveeteelt" ;
            sgpl:text_context "Voor dit skriptie-verslag heb ik gekozen om een vergelijking te maken tussen twee dorpen, in plaats van alleen de situatie in Rojas de Cuauhtémoc te behandelen, aangezien Marian Blankman dat laatste al gedaan heeft in haar skriptie-verslag. Aangezien wij tijdens ons verblijf in Rojas de Cuauhtémoc al opgemerkt hadden dat Rojas een uitzondering vormde vergeleken met de andere dorpen in de omgeving vanwege de specialisatie in de melkveeteelt, leek het mij interessant om een vergelijking met zo'n ander dorp te maken op het gebied van overlevings- en bestaansstrategieën *2) en op het gebied van de arbeidsdeling tussen de geslachten. Ik heb voor het dorp San Sebastian Abasolo gekozen omdat dit een van de weinige dorpen in de omgeving van Rojas is waar ook. net als in Rojas, kaas gemaakt wordt." ] ;
    sgpl:thesisID 203 .

sgpl:Thesis205 a sgpl:SGPLThesis ;
    dcterms:creator "Paul van Maren" ;
    dcterms:issued 1989 ;
    dcterms:title "EEN ONDERZOEK NAAR WOONVOORKEUR EN WOONGEDRAG IN ROTTERDAM",
        "wonen op de singels" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Voorliggend rapport is een verslag van een onderzoek naar het wonen op de Rotterdamse singels. Dit onderzoek vond plaats in het kader van een stage gevolgt bij de dienst Stadsontwikkeling Rotterdam en in het kader van mijn doktoraalstudie sociale geografie aan de Rijksuniversiteit Utrecht. Op deze plaats wil ik de singelbewoners hartelijk danken voor hun medewerking aan het onderzoek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Bergsingel" ;
            sgpl:text_context "De nieuw gerealiseerde singels zijn: de Provenierssingel (1895), de Heemraadssingel (1893 en later) en de Essenburgsingel. Later volgen de Bergsingel (1915) en de Statensingel (1930). In deze studie wordt de aandacht beperkt tot de singels rond het centrum op de rechter Maasoever." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Scheepvaartkwartier" ;
            sgpl:text_context "De mogelijkheden voor processen als gentrification zijn in Rotterdam beperkt door het vrij geringe aanbod van karakteristieke panden. Alleen op de singels, het Scheepvaartkwartier en Kralingen vindt men dit aanbod. Omdat het gentrificationproces zich mogelijk voordoet op de singels in Rotterdam is het interessant om te weten of er recentelijk hogere inkomensgroepen op de singels zijn komen wonen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Voor de grote steden is het daarom belangrijk aandacht te besteden aan de woningbehoefte van midden- en hoge inkomensgroepen. In Rotterdam is in dit kader onlangs het stadsvernieuwingsbeleid bijgesteld. Daarin werd onderkend dat er de laatste 15 jaar te eenzijdig aandacht is besteed aan de woningvoorziening voor lagere inkomensgroepen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "In de grote steden in Nederland is er op verschillende manieren zichtbaar waar er al voor deze doelgroep gebouwd is of waar bestaande bebouwing verbeterd is door deze doelgroep. In Amsterdam is dit laatste het geval in de Jordaan waar het ’gentrification proces' zich op enkele grachten voltrokken heeft. Oude pakhuizen zijn opgeknapt en verbouwd tot luxe appartementen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "de binnenstad" ;
            sgpl:text_context "Oude pakhuizen zijn opgeknapt en verbouwd tot luxe appartementen. In een stad als Rotterdam zijn luxe nieuwe appartementen gebouwd aan de Maasoever en in de binnenstad. In vergelijking met Amsterdam bezit Rotterdam weinig gebieden in de bestaande bebouwing die voor de doelgroep geschikt zijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2752314 ;
            sgpl:spatialText "Kralingen" ;
            sgpl:text_context "De mogelijkheden voor processen als gentrification zijn in Rotterdam beperkt door het vrij geringe aanbod van karakteristieke panden. Alleen op de singels, het Scheepvaartkwartier en Kralingen vindt men dit aanbod. Omdat het gentrificationproces zich mogelijk voordoet op de singels in Rotterdam is het interessant om te weten of er recentelijk hogere inkomensgroepen op de singels zijn komen wonen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Heemraadssingel" ;
            sgpl:text_context "Nog voor de eeuwwisseling vindt er aanleg van nieuwe singels plaats als gevolg van een sterke toename van het inwonertal (tussen 1850 en 1900 steeg het aantal inwoners van 90.000 tot 320.000). De nieuw gerealiseerde singels zijn: de Provenierssingel (1895), de Heemraadssingel (1893 en later) en de Essenburgsingel. Later volgen de Bergsingel (1915) en de Statensingel (1930)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Provenierssingel" ;
            sgpl:text_context "Nog voor de eeuwwisseling vindt er aanleg van nieuwe singels plaats als gevolg van een sterke toename van het inwonertal (tussen 1850 en 1900 steeg het aantal inwoners van 90.000 tot 320.000). De nieuw gerealiseerde singels zijn: de Provenierssingel (1895), de Heemraadssingel (1893 en later) en de Essenburgsingel. Later volgen de Bergsingel (1915) en de Statensingel (1930)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753201 ;
            sgpl:spatialText "de Jordaan" ;
            sgpl:text_context "In de grote steden in Nederland is er op verschillende manieren zichtbaar waar er al voor deze doelgroep gebouwd is of waar bestaande bebouwing verbeterd is door deze doelgroep. In Amsterdam is dit laatste het geval in de Jordaan waar het ’gentrification proces' zich op enkele grachten voltrokken heeft. Oude pakhuizen zijn opgeknapt en verbouwd tot luxe appartementen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "gentrification" ;
            sgpl:text_context "In de grote steden in Nederland is er op verschillende manieren zichtbaar waar er al voor deze doelgroep gebouwd is of waar bestaande bebouwing verbeterd is door deze doelgroep. In Amsterdam is dit laatste het geval in de Jordaan waar het ’gentrification proces' zich op enkele grachten voltrokken heeft. Oude pakhuizen zijn opgeknapt en verbouwd tot luxe appartementen." ],
        [ sgpl:refersToConcept unesco:concept4147 ;
            sgpl:subjectText "woonbeleving" ;
            sgpl:text_context "Voordat op de onderzoeksvragen zoals in de inleiding beschreven kan worden ingegaan volgen eerst enkele beschouwingen vanuit de literatuur. Omdat we in eerste instantie meer inzicht in de woonomgeving van de singels willen krijgen zal worden ingegaan op achtergronden omtrent de woonomgeving en wel de woonbeleving van de bewoners. Daarna komen verhuisaspekten aan de orde." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "verhuisgeneigdheid" ;
            sgpl:text_context "Een indikator die belangrijk geacht wordt voor de beleving van de totale woonsituatie is de verhuisgeneigdheid. De verhuisgeneigdheid is een belangrijke indikator om de beleving van de woonsituatie te toetsen. Aan het wel of niet bestaan van verhuisplannen gaat eerst een beslissingsproces vooraf." ],
        [ sgpl:refersToConcept unesco:concept4147 ;
            sgpl:subjectText "woonbeleving" ;
            sgpl:text_context "Voordat op de onderzoeksvragen zoals in de inleiding beschreven kan worden ingegaan volgen eerst enkele beschouwingen vanuit de literatuur. Omdat we in eerste instantie meer inzicht in de woonomgeving van de singels willen krijgen zal worden ingegaan op achtergronden omtrent de woonomgeving en wel de woonbeleving van de bewoners. Daarna komen verhuisaspekten aan de orde." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "verhuisgeneigdheid" ;
            sgpl:text_context "Een indikator die belangrijk geacht wordt voor de beleving van de totale woonsituatie is de verhuisgeneigdheid. De verhuisgeneigdheid is een belangrijke indikator om de beleving van de woonsituatie te toetsen. Aan het wel of niet bestaan van verhuisplannen gaat eerst een beslissingsproces vooraf." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "gentrification" ;
            sgpl:text_context "In de grote steden in Nederland is er op verschillende manieren zichtbaar waar er al voor deze doelgroep gebouwd is of waar bestaande bebouwing verbeterd is door deze doelgroep. In Amsterdam is dit laatste het geval in de Jordaan waar het ’gentrification proces' zich op enkele grachten voltrokken heeft. Oude pakhuizen zijn opgeknapt en verbouwd tot luxe appartementen." ] ;
    sgpl:thesisID 205 .

sgpl:Thesis206 a sgpl:SGPLThesis ;
    dcterms:creator "Miriam Hueber" ;
    dcterms:issued 1989 ;
    dcterms:title "WIE BETAALT?",
        "de effecten van het Amsterdamse subsidiebeleid op de woningverbetering door eigenaar-bewoners" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "19-eeuwse gordel" ;
            sgpl:text_context "De ruimtelijke spreiding van de stadsvernieuwingsgebieden binnen de Gemeente Amsterdam geeft het volgende beeld (zie fig. 3.1): de 19-eeuwse gordel bestaat nagenoeg geheel uit het gebied van stadsvernieuwingsgebieden: de Staatslieden- en Frederik Hendrikbuurt, de Spaarndammer- en Zeeheldenbuurt, de Kinkerbuurt, de Pijp, de Oosterparkbuurt en de Dapperbuurt. In de historische binnenstad zijn drie stadsvernieuwingsgebieden: de Jordaan, de Gouden Reael en de Nieuwmarktbuurt. Een verdere uitbreiding van de stadsvernieuwingsgebieden binnen de historische binnenstad zou een te groot beslag op het Stadsvernieuwingsfonds leggen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753201 ;
            sgpl:spatialText "Jordaan" ;
            sgpl:text_context "In de historische binnenstad zijn drie stadsvernieuwingsgebieden: de Jordaan, de Gouden Reael en de Nieuwmarktbuurt. Een verdere uitbreiding van de stadsvernieuwingsgebieden binnen de historische binnenstad zou een te groot beslag op het Stadsvernieuwingsfonds leggen. De Indische Buurt bestaat grotendeels uit woningen die gebouwd zijn in het begin van de twintigste eeuw." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759793 ;
            sgpl:spatialText "Gemeente Amsterdam" ;
            sgpl:text_context "Sinds 1 januari 1985, de datum van het van kracht worden van de Wet op de Stads- en Dorpsvernieuwing (WSDV) is het, in het kader van de decentralisatie, de taak van de Gemeente Amsterdam het subsidiebeleid voor eigenaar-bewoners vast te stellen. Zo werd op 1 januari 1985 de 'Subsidieverordening Stadsvernieuwing Amsterdam 1985' van kracht waarin in hoofdstuk 2 van deze verordening de subsidieregelingen voor eigenaar-bewoners werden vastgelegd. Sinds de gemeente haar beleid in deze verordening heeft bepaald, is de verordening twee maal gewijzigd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "de Stopera" ;
            sgpl:text_context "Daarnaast hebben de prettige werksfeer en de beschikbare faciliteiten in het stadhuis te Amsterdam \"de Stopera\", waar deze scriptie grotendeels tot stand gekomen is eveneens het werken aan deze scriptie bevorderd. Tot slot een woord van dank aan de vele eigenaar-bewoners die hebben meegewerkt aan het onderzoek. Miriam Hueber Voorwoord Samenvatting" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Gordel 20-40" ;
            sgpl:text_context "Begonnen werd met een actief aanschrijfprogramma (zie paragraaf 3.3.), gekoppeld aan subsidies in de actiegebieden, de Postjesbuurt en de Rivierenbuurt en vanaf 1988 ook in de Admiralenbuurt. Het aanschrijvingsbeleid in de Gordel 20-40 is, uitgaande van de gedachte behoud van de woning voor de volkshuisvesting, alleen gericht op het buitenonderhoud (Anon 1984). In de Gordel 20-40 was op 1 januari 1983 gemiddeld 4,22 van de woningen in bezit van eigenaar-bewoners." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Noord" ;
            sgpl:text_context "Twee andere stadsvernieuwingsgebieden in Amsterdam, die echter niet onder de Subsidieverordening Stadsvernieuwing Amsterdam 1985 vallen, zijn Noord en Watergraafsmeer (beide uit de bouwperiode 1920-1940). Deze gebieden liggen in de stadsdeelraadgebieden waar het zittende stadsdeelraadbestuur de coördinatie van de stadsvernieuwing in haar takenpakket heeft. In Noord functioneert sinds december 1981 een stadsdeelraad en in Watergraafsmeer sinds mei 1987." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het opmerkelijke van deze tabel is een ongewone inkomensverdeling. Deze afwijkende inkomensverdeling maakt duidelijk dat relatief meer hogere inkomensgroepen van de subsidie gebruik maken dan op grond van de verdeling van de huishoudensinkomens in Nederland verwacht wordt. Een positief gegeven voor een beleidsevaluatie is dit niet." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Rivierenbuurt" ;
            sgpl:text_context "Begonnen werd met een actief aanschrijfprogramma (zie paragraaf 3.3.), gekoppeld aan subsidies in de actiegebieden, de Postjesbuurt en de Rivierenbuurt en vanaf 1988 ook in de Admiralenbuurt. Het aanschrijvingsbeleid in de Gordel 20-40 is, uitgaande van de gedachte behoud van de woning voor de volkshuisvesting, alleen gericht op het buitenonderhoud (Anon 1984). In de Gordel 20-40 was op 1 januari 1983 gemiddeld 4,22 van de woningen in bezit van eigenaar-bewoners." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Sinds 1985 is deze verordening twee keer gewijzigd. Teneinde de effecten van de wijzigingen van het subsidiebeleid van de gemeente Amsterdam te kunnen vaststellen, is voor dit onderzoek de groep eigenaar-bewoners die subsidie hebben ontvangen op grond van de subsidieverordening als onderzoekspopulatie gekozen. Binnen de onderzoekspopulatie wordt onderscheid gemaakt tussen drie groepen eigenaar-bewoners, zijnde de groepen eigenaar-bewoners die subsidie ontvingen op grond van respectievelijk de eerste, tweede en derde versie van de verordening." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Deze beleidsevaluatie van de Subsidieverordening Stadsvernieuwing Amsterdam 1985, hoofdstuk 2, is uitgevoerd in het kader van een stage bij de afdeling Volkshuisvesting bij de gemeente Amsterdam. Het verslag van deze beleidsevaluatie is tevens mijn doctoraalscriptie voor de specialisatie beleidsgeografie van de studie sociale geografie aan de Rijksuniversiteit te Utrecht. Zowel in de beginfase als in de eindfase van het onderzoek nam de relevantie van dit onderzoek toe." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Eind jaren zeventig, na jarenlange kritiek van de bevolking op het stadsvernieuwingsbeleid, werd mede onder druk van de economische recessie, het niet realiseren van de sloop/nieuwbouwprogramma's en de grote organisatorische druk van het gevoerde stadsvernieuwingsbeleid, het beleid gewijzigd. Een nieuw stadsvernieuwingsbeleid, gekenmerkt door behoud en herstel, kwam er voor in de plaats. De keuze voor dit beleid, gericht op het behouden en herstellen van de oude stad, kan duidelijk worden gemaakt aan de hand van de veranderde opvattingen over de stad." ],
        [ sgpl:refersToConcept unesco:concept415 ;
            sgpl:subjectText "Subsidiebeleid" ;
            sgpl:text_context "Over de invloed van het gemeentelijke stadsvernieuwingsbeleid op het onderhouds- en verbeteringsgedrag van de eigenaar-bewoners is op grond van andere onderzoeken nog niet veel bekend. Echter het subsidie- en aanschrijvingsbeleid ten aanzien van de eigenaar-bewoners, beiden onderdeel van het Amsterdamse stadsvernieuwingsbeleid, hebben op grond van hun werking een directe invloed op het verbetergedrag van de eigenaar-bewoners. Het subsidiebeleid voor de eigenaar-bewoners vastgelegd in de Subsidieverordening Stadsvernieuwing Amsterdam 1985, heeft als doelstelling de verbeteringsactiviteiten te stimuleren." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Woningverbetering" ;
            sgpl:text_context "In deze scriptie worden alle werkzaamheden die binnen de woning plaatsvinden - en veelal gericht zijn op verhoging van het woongerief - 'woontechnische verbeteringen' genoemd. Alle werkzaamheden aan het casco die hoofdzakelijk gericht zijn op het opheffen van bouwtechnische gebreken en achterstallig onderhoud vallen onder de noemer 'groot onderhoud'. Als echter over alle werkzaamheden aan de woning gesproken wordt, wordt meestal de term 'verbeteringen' (in ruime zin) gebruikt." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwing" ;
            sgpl:text_context "Eind jaren zeventig, na jarenlange kritiek van de bevolking op het stadsvernieuwingsbeleid, werd mede onder druk van de economische recessie, het niet realiseren van de sloop/nieuwbouwprogramma's en de grote organisatorische druk van het gevoerde stadsvernieuwingsbeleid, het beleid gewijzigd. Een nieuw stadsvernieuwingsbeleid, gekenmerkt door behoud en herstel, kwam er voor in de plaats. De keuze voor dit beleid, gericht op het behouden en herstellen van de oude stad, kan duidelijk worden gemaakt aan de hand van de veranderde opvattingen over de stad." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Woningverbetering" ;
            sgpl:text_context "In deze scriptie worden alle werkzaamheden die binnen de woning plaatsvinden - en veelal gericht zijn op verhoging van het woongerief - 'woontechnische verbeteringen' genoemd. Alle werkzaamheden aan het casco die hoofdzakelijk gericht zijn op het opheffen van bouwtechnische gebreken en achterstallig onderhoud vallen onder de noemer 'groot onderhoud'. Als echter over alle werkzaamheden aan de woning gesproken wordt, wordt meestal de term 'verbeteringen' (in ruime zin) gebruikt." ],
        [ sgpl:refersToConcept unesco:concept415 ;
            sgpl:subjectText "Subsidiebeleid" ;
            sgpl:text_context "Over de invloed van het gemeentelijke stadsvernieuwingsbeleid op het onderhouds- en verbeteringsgedrag van de eigenaar-bewoners is op grond van andere onderzoeken nog niet veel bekend. Echter het subsidie- en aanschrijvingsbeleid ten aanzien van de eigenaar-bewoners, beiden onderdeel van het Amsterdamse stadsvernieuwingsbeleid, hebben op grond van hun werking een directe invloed op het verbetergedrag van de eigenaar-bewoners. Het subsidiebeleid voor de eigenaar-bewoners vastgelegd in de Subsidieverordening Stadsvernieuwing Amsterdam 1985, heeft als doelstelling de verbeteringsactiviteiten te stimuleren." ] ;
    sgpl:thesisID 206 .

sgpl:Thesis207 a sgpl:SGPLThesis ;
    dcterms:creator "ing. M. van Noordenne" ;
    dcterms:issued 1989 ;
    dcterms:title "HET GROENE HART VAN BINNEN NAAR BUITEN",
        "Stemmen uit het 'groen'",
        "een onderzoek naar de visie van de grootste gemeenten in het middengebied van de Randstad op de ruimtelijke ordening ervan" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Deze nota gaat in op de gewenste ruimtelijke inrichting van Nederland in de periode tot het jaar 2015. Na het voeren van overleg, verlenen van inspraak en inwinnen van advies verscheen op 17 december 1988 de op een aantal punten bij gestelde regeringsbeslissing (deel d). Medio mei 1989 zou de Kamer-behandeling hebben plaatsgevonden, ware het niet, dat de regering het twee weken voordien voor gezien hield." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759875 ;
            sgpl:spatialText "Alphen a/d Rijn" ;
            sgpl:text_context "Uit de inspraakreacties van het Intergemeentelijk Overlegorgaan Rijnstreek, de Regionaal Economisch Overleggen Midden-Holland en Rijn- en Bollenstreek alsmede uit die van de gemeenten Gouda en Alphen a/d Rijn kon vergelijkbare kritiek op de nota worden opgemaakt. Het ISMH vond niets terug over economische ontwikkelingen/ potenties in het Groene Hart. Bovendien bestaat er ook sterke samenhang met economische en afgeleide ontwikkelingen in de omringende stadsgewesten, hetgeen in de nota niet ter sprake komt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Zonder het nationale karakter van de Vierde nota geweld aan te doen, kan gezegd worden, dat de Randstad de spil is waar het in de nota om draait. Maar liefst circa zeventig beleidsuitspraken hebben betrekking op de Randstad (Miltenburg, 1989). De Randstad is te scheiden in de stedelijke Randstad, zijnde de ring van middelgrote en grote stadsgewesten, en het Groene Hart." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "middengebied van de Randstad" ;
            sgpl:text_context "HET GROENE HART VAN BINNEN NAAR BUITEN. Stemmen uit het 'groen', een onderzoek naar de visie van de grootste gemeenten in het middengebied van de Randstad op de ruimtelijke ordening ervan. Verslag van leeronderzoek van ing." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Groene Hart" ;
            sgpl:text_context "GEOGRAFISCH INSTITUUT RIJKSUNIVERSITEIT UTRECHT. HET GROENE HART VAN BINNEN NAAR BUITEN. Stemmen uit het 'groen', een onderzoek naar de visie van de grootste gemeenten in het middengebied van de Randstad op de ruimtelijke ordening ervan." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Midden-Holland" ;
            sgpl:text_context "Er groeide bij het ISMH gezien het voorgaande behoefte aan een meer integrale benadering van de toekomstige ruimtelijke ontwikkeling van de regio Midden-Holland (233.432 inw. per 1-1-1989). Besloten werd een stage-onderzoek te laten uitvoeren. Het ISMH streeft bestuurlijk niet naar een gemeenschappelijke 'Midden-Holland'-visie of een ruimtelijk plan voor de regio, maar opteert voor het volgen van de ontwikkelingen op dit vlak en het bundelen van de gemeentelijke opvattingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "HET GROENE HART VAN BINNEN NAAR BUITEN. Verslag van leeronderzoek van ing. M. van Noordenne. Rijksuniversiteit Utrecht Faculteit der Ruimtelijke Wetenschapppen Vakgroep G&P Midden-Holland Gouda Utrecht/Gouda, november 1989." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912,
                geonames:2747373,
                geonames:2747891,
                geonames:2759794 ;
            sgpl:spatialText "de vier grote steden, Amsterdam, Den Haag, Rotterdam en Utrecht" ;
            sgpl:text_context "Hfdstk 1 bevat de probleemomschrijving (par. 1.1) en een verantwoording van de inrichting van het onderzoek (par. 1.2). Met de aanduiding 'Groene Hart' wordt het gebied tussen de vier grote steden, Amsterdam, Den Haag, Rotterdam en Utrecht, bedoeld. Het 'Groene Hart' is een conceptie, het is een denkbeeldige constructie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "stedelijke Randstad" ;
            sgpl:text_context "De Randstad is te scheiden in de stedelijke Randstad, zijnde de ring van middelgrote en grote stadsgewesten, en het Groene Hart. De meeste en meest dynamische ontwikkelingen in de (nabije) toekomst zullen in de visie van de nota (moeten) plaatsvinden in de stedelijke Randstad. Daar gaat dit onderzoek verder niet op in." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755420 ;
            sgpl:spatialText "Gouda" ;
            sgpl:text_context "Het Intergemeentelijk Samenwerkingsorgaan Midden-Holland (ISMH), een op grond van de Wet Gemeenschappelijke Regelingen functionerend samenwerkingsverband van zestien gemeenten in het gebied met en rond Gouda, was blijkens de inspraakreactie bepaald niet gelukkig met de behandeling van het Groene Hart in de Vierde nota. Uit de inspraakreacties van het Intergemeentelijk Overlegorgaan Rijnstreek, de Regionaal Economisch Overleggen Midden-Holland en Rijn- en Bollenstreek alsmede uit die van de gemeenten Gouda en Alphen a/d Rijn kon vergelijkbare kritiek op de nota worden opgemaakt. Het ISMH vond niets terug over economische ontwikkelingen/ potenties in het Groene Hart." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "Vierde nota over de ruimtelijke ordening" ;
            sgpl:text_context "De Vierde nota over de ruimtelijke ordening is het regeringsantwoord op verander (en) de omstandigheden. En men wil verder kijken. 'Nederland in 2015, daar wordt nu aan gewerkt', is daarom het motto van de nota." ],
        [ sgpl:refersToConcept unesco:concept2318 ;
            sgpl:subjectText "Groene Hart" ;
            sgpl:text_context "Zonder het nationale karakter van de Vierde nota geweld aan te doen, kan gezegd worden, dat de Randstad de spil is waar het in de nota om draait. De Randstad is te scheiden in de stedelijke Randstad, zijnde de ring van middelgrote en grote stadsgewesten, en het Groene Hart. De meeste en meest dynamische ontwikkelingen in de (nabije) toekomst zullen in de visie van de nota (moeten) plaatsvinden in de stedelijke Randstad." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "Ruimtelijke ordening" ;
            sgpl:text_context "De Vierde nota over de ruimtelijke ordening is het regeringsantwoord op verander (en) de omstandigheden. De visie van deze gemeenten, zowel op zichzelf als op het bovengemeentelijk vlak (Randstad, Groene Hart) wat betreft de toekomstige ruimtelijke ordening van vooral de 'niet-groene' (wonen, werken, verzorging, mobiliteit), maar ook de 'groene' functies (landbouw, natuur en landschap, toerisme/recreatie, milieu (hygiëne)) zou centraal moeten komen te staan in het onderzoek. De Randstad (en daarmee ook het Groene Hart) staat in velerlei opzicht in het brandpunt van de belangstelling/actualiteit." ],
        [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "Vierde nota over de ruimtelijke ordening" ;
            sgpl:text_context "De Vierde nota over de ruimtelijke ordening is het regeringsantwoord op verander (en) de omstandigheden. En men wil verder kijken. 'Nederland in 2015, daar wordt nu aan gewerkt', is daarom het motto van de nota." ],
        [ sgpl:refersToConcept unesco:concept2318 ;
            sgpl:subjectText "Groene Hart" ;
            sgpl:text_context "Zonder het nationale karakter van de Vierde nota geweld aan te doen, kan gezegd worden, dat de Randstad de spil is waar het in de nota om draait. De Randstad is te scheiden in de stedelijke Randstad, zijnde de ring van middelgrote en grote stadsgewesten, en het Groene Hart. De meeste en meest dynamische ontwikkelingen in de (nabije) toekomst zullen in de visie van de nota (moeten) plaatsvinden in de stedelijke Randstad." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "Ruimtelijke ordening" ;
            sgpl:text_context "De Vierde nota over de ruimtelijke ordening is het regeringsantwoord op verander (en) de omstandigheden. De visie van deze gemeenten, zowel op zichzelf als op het bovengemeentelijk vlak (Randstad, Groene Hart) wat betreft de toekomstige ruimtelijke ordening van vooral de 'niet-groene' (wonen, werken, verzorging, mobiliteit), maar ook de 'groene' functies (landbouw, natuur en landschap, toerisme/recreatie, milieu (hygiëne)) zou centraal moeten komen te staan in het onderzoek. De Randstad (en daarmee ook het Groene Hart) staat in velerlei opzicht in het brandpunt van de belangstelling/actualiteit." ] ;
    sgpl:thesisID 207 .

sgpl:Thesis208 a sgpl:SGPLThesis ;
    dcterms:creator "Sylvia Smit" ;
    dcterms:issued 1989 ;
    dcterms:title "IN THEORIE EN PRAKTIJK",
        "TOERISTISCH-RECREATIEVE CITY-MARKETING" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In de onder b/c. geschetste situatie zal op korte termijn verandering moeten komen, Indien meer gemeenten zich concurrerend op de toeristisch-recreatieve markt willen bewegen en aldus profiteren van de financieel-economische kansen die hier liggen. Ook voor de (Inter)nationale marktpositie van Nederland als vakantieland is dit van belang. Uit een nadere confrontatie tussen theorie en praktijk en met inachtneming van de belangrijkste organisatorische randvoorwaarden kunnen tot slot de volgende aanbevelingen geformuleerd worden om tot verbetering van de huidige situatie te komen:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "De belangrijkste kenmerken van het regionaal beleid in deze periode zijn in de eerste plaats de voortzetting van het traditionele stimuleringsbeleid, waarbij voor zwakke gebieden bulten het westen van het land (globaal de Randstad) voorrangs- en subsidieregelingen gelden en in de tweede plaats de realisatie van een zogenaamd 'ontwikkelingsbeleid’, waarbij gestreefd wordt naar een zo groot mogelijke bijdrage vanuit de regio’s aan de nationale welvaartsontwikkeling. Samenvattend streeft de nationale overheid In deze periode naar een zoveel mogelijk gelijke ontwikkeling van heel Nederland. Hiervoor worden diverse (financiële) middelen ter beschikking gesteld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederlandse gemeenten" ;
            sgpl:text_context "City-marketing krijgt In Nederlandse gemeenten steeds meer aandacht. In de eerste plaats worden city-marketingactrvrtelten ontplooit met als doel het aantrekken van (industriële) bedrijvigheid. City-marketing is echter ook toepasbaar op andere terreinen van het gemeentelijk beleid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756669 ;
            sgpl:spatialText "Dordrecht" ;
            sgpl:text_context "Voor zover bekend heeft alleen het Bureau voor Onderzoek en Statistiek van de gemeente Dordrecht (Zwart, 1987) ooit verslag gedaan van een evaluatie-onderzoek aangaande promotionele activiteiten In het kader van clty-marketing. Het betrof hier een onderzoek naar imagowijzlging en verbetering van de short-list positie van Dordrecht als gevolg van een advertentiecampagne. Probleem bij dergelijk onderzoek is dat nooit exact is na te gaan welke veranderingen het gevolg zijn van de marketingactiviteiten en welke als gevolg van andere invloeden zijn opgetreden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "Voorbeelden van dergelijke kernelementen zijn de Utrechtse domtoren, het Oude Stijl Jazz-festival in Breda, de Eftellng In Kaatsheuvel etc. De primaire aantrekkingskracht van het toeristisch-recreatief aanbod ligt echter niet uitsluitend In de voorzieningen. Identificatie van het toeristisch-recreatief produkt kan het beste gebeuren door de verschillende produktonderdelen te zien als een verzameling primaire of kernelementen enerzijds en secundaire of afgeleide elementen anderzijds (Jansen-Verbeke, 1988)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "westen van het land" ;
            sgpl:text_context "De belangrijkste kenmerken van het regionaal beleid in deze periode zijn in de eerste plaats de voortzetting van het traditionele stimuleringsbeleid, waarbij voor zwakke gebieden bulten het westen van het land (globaal de Randstad) voorrangs- en subsidieregelingen gelden en in de tweede plaats de realisatie van een zogenaamd 'ontwikkelingsbeleid’, waarbij gestreefd wordt naar een zo groot mogelijke bijdrage vanuit de regio’s aan de nationale welvaartsontwikkeling. Samenvattend streeft de nationale overheid In deze periode naar een zoveel mogelijk gelijke ontwikkeling van heel Nederland. Hiervoor worden diverse (financiële) middelen ter beschikking gesteld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753156 ;
            sgpl:spatialText "Kaatsheuvel" ;
            sgpl:text_context "Voorbeelden van dergelijke kernelementen zijn de Utrechtse domtoren, het Oude Stijl Jazz-festival in Breda, de Eftellng In Kaatsheuvel etc. De primaire aantrekkingskracht van het toeristisch-recreatief aanbod ligt echter niet uitsluitend In de voorzieningen. Identificatie van het toeristisch-recreatief produkt kan het beste gebeuren door de verschillende produktonderdelen te zien als een verzameling primaire of kernelementen enerzijds en secundaire of afgeleide elementen anderzijds (Jansen-Verbeke, 1988)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Deze scriptie vormt de afronding van mijn studie economische geografie aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Door mijn werk vertrouwd met het aandachtsveld toerisme en recreatie, en door mijn studie geïnteresseerd geraakt In het verschijnsel city-marketing, was het onderwerp, toeristisch-recreatieve city-marketing In theorie en praktijk, snel gevonden. De begeleiding van deze scriptie was in handen van Drs." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2224 ;
            sgpl:subjectText "sterkte-zwakte onderzoek" ;
            sgpl:text_context "In gemeenten waar niet of onvoldoende sprake Is van een procesmatig uitgevoerd toeristisch-recreatief city-marketingbeleid zijn de belangrijkste knelpunten: het ontbreken van een sterkte-zwakte onderzoek en een marktanalyse (respectivelijk in 68% en 52% van de ondervraagde gemeenten). Een zwakke tot geheel ontbrekende samenhang tussen doelgroepenafbakening en prioriteitenstelling voor wat betreft uitbreiding en/of verbetering van het toeristlsch-recreatlef aanbod In de gemeente. De kans op succes van een onvoldoende gefundeerd beleid of een beleid waarin tussen de verschillende beleidselementen en/of -fasen (te) weinig samenhang bestaat, is beduidend kleiner dan van een procesmatig uitgevoerd beleid." ],
        [ sgpl:refersToConcept unesco:concept12330 ;
            sgpl:subjectText "toeristisch-recreatieve city-marketing" ;
            sgpl:text_context "Op basis van deze literatuurstudie is geconcludeerd dat city-marketing voor gemeenten een bruikbare methode Is voor het realiseren en op de markt brengen van een toeristisch-recreatief aanbod met maximale afzetmogelijkheden. Er kan in dit geval gesproken worden van toeristisch-recreatieve city-marketing. Het toeristisch-recreatieve city-marketingproces kan in grote lijnen worden uitgevoerd volgens algemeen geldende city-marketingprincipes, zij het dat het complexe karakter van het produkt en het onvoorspelbare gedrag van de onoverzichtelijke markt specifieke eisen aan het marketingplan en de uitvoering ervan stellen." ],
        [ sgpl:refersToConcept unesco:concept10308 ;
            sgpl:subjectText "marktgerichte werkwijze" ;
            sgpl:text_context "De totstandkoming en uitvoering van een goed toeristlsch-recreatlef city-marketingbeleid is alleen mogelijk binnen een bedrijfsmatige, marktgericht handelende organisatie. Onafhankelijk van de afdeling waar uiteindelijk de verantwoording voor en de coördinatie van de toeristisch-recreatieve city-marketingactiviteiten komen te liggen, moeten zowel de betrokkenen op deze afdeling als alle andere betrokkenen zich een marktgerichte werkwijze eigen gemaakt hebben en overtuigd zijn van het nut hiervan. Dit moet derhalve eerste prioriteit krijgen op de weg naar ontwikkeling van een volwaardig toeristisch-recreatief city-marketingbeleid." ],
        [ sgpl:refersToConcept unesco:concept2224 ;
            sgpl:subjectText "sterkte-zwakte onderzoek" ;
            sgpl:text_context "In gemeenten waar niet of onvoldoende sprake Is van een procesmatig uitgevoerd toeristisch-recreatief city-marketingbeleid zijn de belangrijkste knelpunten: het ontbreken van een sterkte-zwakte onderzoek en een marktanalyse (respectivelijk in 68% en 52% van de ondervraagde gemeenten). Een zwakke tot geheel ontbrekende samenhang tussen doelgroepenafbakening en prioriteitenstelling voor wat betreft uitbreiding en/of verbetering van het toeristlsch-recreatlef aanbod In de gemeente. De kans op succes van een onvoldoende gefundeerd beleid of een beleid waarin tussen de verschillende beleidselementen en/of -fasen (te) weinig samenhang bestaat, is beduidend kleiner dan van een procesmatig uitgevoerd beleid." ],
        [ sgpl:refersToConcept unesco:concept10308 ;
            sgpl:subjectText "marktgerichte werkwijze" ;
            sgpl:text_context "De totstandkoming en uitvoering van een goed toeristlsch-recreatlef city-marketingbeleid is alleen mogelijk binnen een bedrijfsmatige, marktgericht handelende organisatie. Onafhankelijk van de afdeling waar uiteindelijk de verantwoording voor en de coördinatie van de toeristisch-recreatieve city-marketingactiviteiten komen te liggen, moeten zowel de betrokkenen op deze afdeling als alle andere betrokkenen zich een marktgerichte werkwijze eigen gemaakt hebben en overtuigd zijn van het nut hiervan. Dit moet derhalve eerste prioriteit krijgen op de weg naar ontwikkeling van een volwaardig toeristisch-recreatief city-marketingbeleid." ],
        [ sgpl:refersToConcept unesco:concept12330 ;
            sgpl:subjectText "toeristisch-recreatieve city-marketing" ;
            sgpl:text_context "Op basis van deze literatuurstudie is geconcludeerd dat city-marketing voor gemeenten een bruikbare methode Is voor het realiseren en op de markt brengen van een toeristisch-recreatief aanbod met maximale afzetmogelijkheden. Er kan in dit geval gesproken worden van toeristisch-recreatieve city-marketing. Het toeristisch-recreatieve city-marketingproces kan in grote lijnen worden uitgevoerd volgens algemeen geldende city-marketingprincipes, zij het dat het complexe karakter van het produkt en het onvoorspelbare gedrag van de onoverzichtelijke markt specifieke eisen aan het marketingplan en de uitvoering ervan stellen." ] ;
    sgpl:thesisID 208 .

sgpl:Thesis209 a sgpl:SGPLThesis ;
    dcterms:creator "Harry van Everdingen",
        "Jeroen Tieman" ;
    dcterms:issued 1989 ;
    dcterms:title "Een onderzoek naar ontwikkelingen in de bevolking en de woningbouw in relatie tot het ruimtelijk beleid",
        "SUBURBANISATIE IN HET GROENE HART" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Het voor U liggende stuk is een verslag geschreven in het kader van de vak-groep Toegepaste Geografie & Ruimtelijke Planning (faculteit der Ruimtelijke Wetenschappen) aan de Rijksuniversiteit te Utrecht. Het rapport betreft een verslaglegging van een belangrijk onderdeel van de studie: Het leeronderzoek. \"Het doel van leeronderzoek is het zich verwerven van vaardigheden in het doen van wetenschappelijk onderzoek en het maken van een verslag van de inhoudelijke uitkomsten\" (Studiegids ’88-’89)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De woningbouwgegevens weerspiegelen de gegevens van de bevolkingsontwikkelingen. De ontwikkelingen zijn vergeleken met het Groene Hart en met Nederland als totaal. De gemeenten zijn naar provincie, gemeentegrootte en urbanisatiegraad ingedeeld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Groene Hart" ;
            sgpl:text_context "In een aantal rijksnota’s en andere publicaties wordt het begrip Groene Hart gehanteerd. Daarmee wordt dan een al dan niet duidelijk begrensd gebied tussen de 4 grote steden bedoeld. Dit deel van het Westen van Nederland dient volgens die publicaties haar openheid te behouden en moet dus worden gevrijwaard van verstedelijking." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751435 ;
            sgpl:spatialText "Lopik" ;
            sgpl:text_context "Er werden 4 clusters onderscheiden, waarvan er drie zijn gebruikt ter selectie van casestudies (cluster 2 vervalt vanwege de grootte en de groeitaak van de 2 gemeenten). Er zijn drie gemeenten geselecteerd: Leidschendam, Bodegraven en Lopik. Via gesprekken met vertegenwoordigeres van de gemeenten en van woningbouwverenigingen is het volgende beeld naar voren gekomen:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759874 ;
            sgpl:spatialText "Alphen aan den Rijn" ;
            sgpl:text_context "De grote gemeenten in het Groene Hart (o.a. Alphen aan den Rijn) zijn vanaf 1973 het sterkst in zowel bevolking als in woningvoorraad gegroeid. Het ruimtelijk beleid van de overheid, gericht op de bundeling van groei in grotere kernen, lijkt dus succes te hebben gehad. Dit komt ook tot uiting in de (grotere) migratiecijfers voor deze groep van grootste gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Noord-Holland" ;
            sgpl:text_context "Het onderzoeksgebied bestond uit 89 gemeenten (geen groeikernen), verdeeld over de drie Groene Hart-provincies Noord-Holland, Zuid-Holland en Utrecht. Voor de periode tussen en 1-1-1988 zijn voor de 89 gemeenten de volgende gegevens verzameld en geïnterpreteerd: Bevolkingsgegevens: De jaarlijkse en totale groei van de bevolking, alsmede de de verdeling naar natuurlijke aanwas en migratie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751769 ;
            sgpl:spatialText "Leidschendam" ;
            sgpl:text_context "Er werden 4 clusters onderscheiden, waarvan er drie zijn gebruikt ter selectie van casestudies (cluster 2 vervalt vanwege de grootte en de groeitaak van de 2 gemeenten). Er zijn drie gemeenten geselecteerd: Leidschendam, Bodegraven en Lopik. Via gesprekken met vertegenwoordigeres van de gemeenten en van woningbouwverenigingen is het volgende beeld naar voren gekomen:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "het middengebied van de Randstad" ;
            sgpl:text_context "Heeft het verstedelijkingsbeleid zoals dat door de verschillende overheidsnivo’s (rijk en provincie) is geformuleerd en ingevuld (zoals spreidingsbeleid, groeikernenbeleid, bufferzonebeleid en open houden van het middengebied) ook daadwerkelijk het middengebied van de Randstad open gehouden, óf Is er sprake van een toenemende druk op dit gebied wat betreft het wonen, en zo ja: Hoe en in welke mate manifesteert dit zich, en welke rol speelt het gemeentelijke r.o.- en volkshuisvestingsbeleid hierbij? In hoeverre speelt de Vierde Nota in op bovenstaande problematiek?" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758765 ;
            sgpl:spatialText "Bodegraven" ;
            sgpl:text_context "Er werden 4 clusters onderscheiden, waarvan er drie zijn gebruikt ter selectie van casestudies (cluster 2 vervalt vanwege de grootte en de groeitaak van de 2 gemeenten). Er zijn drie gemeenten geselecteerd: Leidschendam, Bodegraven en Lopik. Via gesprekken met vertegenwoordigeres van de gemeenten en van woningbouwverenigingen is het volgende beeld naar voren gekomen:" ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Woningbouwontwikkelingen" ;
            sgpl:text_context "In de tweede onderzoeksfase zijn de gegevens van de onderzoekspopultatie verzameld. Voornamelijk aan de hand van CBS-statistieken (dit bleek van belang te zijn voor de onderzoeksconclusies!!) zijn voor de onderzoekspopulatie de bevolkings- en woningbouwontwikkelingen nagegaan. Het onderzoeksgebied bestond uit 89 gemeenten (geen groeikernen), verdeeld over de drie Groene Hart-provincies Noord-Holland, Zuid-Holland en Utrecht." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Suburbanisatie" ;
            sgpl:text_context "Het ruimtelijk proces van suburbanisatie heeft beide aspecten beleefd. Suburbanisatie kan als volgt worden gedefinieerd: \"Suburbanisatie is het verschijnsel dat in toenemende mate stedelijke activiteiten zich losmaken van het eigenlijke stedelijke gebied en zich verspreiden over een groot, van oorsprong typisch landelijk gebied rondom de stad of agglomeratie\" (MVRO,1979,p.l 12). Hoewel de verschillende stedelijke activiteiten vaak niet los van elkaar kunnen worden gezien, blijft dit onderzoek beperkt tot suburbanisatie van het wonen." ],
        [ sgpl:refersToConcept unesco:concept5185 ;
            sgpl:subjectText "Ruimtelijk beleid" ;
            sgpl:text_context "In de voorgaande hoofdstukken is vanuit twee kanten aandacht besteed aan het verschijnsel van spontane suburbanisatie in het Groene Hart als bedreiging voor de aantasting van dit gebied. Aan de ene kant is het ruimtelijk beleid door de overheid belicht, aan de andere kant zijn de feitelijke ontwikkelingen in de bevolking en de woningbouw bestudeerd. Dit afsluitende hoofdstuk beoogt beide aspecten met elkaar in relatie te brengen." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Suburbanisatie" ;
            sgpl:text_context "Het ruimtelijk proces van suburbanisatie heeft beide aspecten beleefd. Suburbanisatie kan als volgt worden gedefinieerd: \"Suburbanisatie is het verschijnsel dat in toenemende mate stedelijke activiteiten zich losmaken van het eigenlijke stedelijke gebied en zich verspreiden over een groot, van oorsprong typisch landelijk gebied rondom de stad of agglomeratie\" (MVRO,1979,p.l 12). Hoewel de verschillende stedelijke activiteiten vaak niet los van elkaar kunnen worden gezien, blijft dit onderzoek beperkt tot suburbanisatie van het wonen." ],
        [ sgpl:refersToConcept unesco:concept5185 ;
            sgpl:subjectText "Ruimtelijk beleid" ;
            sgpl:text_context "In de voorgaande hoofdstukken is vanuit twee kanten aandacht besteed aan het verschijnsel van spontane suburbanisatie in het Groene Hart als bedreiging voor de aantasting van dit gebied. Aan de ene kant is het ruimtelijk beleid door de overheid belicht, aan de andere kant zijn de feitelijke ontwikkelingen in de bevolking en de woningbouw bestudeerd. Dit afsluitende hoofdstuk beoogt beide aspecten met elkaar in relatie te brengen." ],
        [ sgpl:refersToConcept unesco:concept6401 ;
            sgpl:subjectText "Woningbouwontwikkelingen" ;
            sgpl:text_context "In de tweede onderzoeksfase zijn de gegevens van de onderzoekspopultatie verzameld. Voornamelijk aan de hand van CBS-statistieken (dit bleek van belang te zijn voor de onderzoeksconclusies!!) zijn voor de onderzoekspopulatie de bevolkings- en woningbouwontwikkelingen nagegaan. Het onderzoeksgebied bestond uit 89 gemeenten (geen groeikernen), verdeeld over de drie Groene Hart-provincies Noord-Holland, Zuid-Holland en Utrecht." ] ;
    sgpl:thesisID 209 .

sgpl:Thesis21 a sgpl:SGPLThesis ;
    dcterms:creator "F.P. ten Kate" ;
    dcterms:issued 1954 ;
    dcterms:title "DE INVLOED VAN HET GEOGRAFISCH MILIEU OP DE DUITSE VELDTOCHT IN DE SOVJET-UNIE IN 1941" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:690791 ;
            sgpl:spatialText "de Oekraïne" ;
            sgpl:text_context "De Duitse leiding wist, dat vooral in de Oekraïne de bevolking doorgaans het Sovjet-bewind niet was toegedaan, voorname- lijk t.g.v. de landnationalisatie. Zo kon de Duitse leiding ver- wachten, dat de bevolking de Wehrmacht welwillend tegemoet zou treden. En haar zou steunen, wanneer zij een \"Vrije Oekraïnse Re- gering\" zou oprichten, de de gewenste hervormingen zou doorvoeren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2803095 ;
            sgpl:spatialText "de Ardennen" ;
            sgpl:text_context "En het standaardvoor- beeld van verkeerde interpretatie van milieu-invloeden vormt wel de Maarschalk Pétain, op wiens door zijn enorm prestige geschraagd gezag de Conseil de Défense Supérieur aannam, dat de Ardennen voor een modern aanvalsleger onpasserbaar waren, zodat de Maginotlinie niet langs de Maas behoefde te worden voortge- zet ! Juist de Ardennen, die in de Tweede Wereldoorlog het toneel van zo’n heftige strijd zijn geweest! En juist de doorbraak naar Sedan was de factor, die het meest bijdroeg tot de snelle onder- gang van het Franse leger in 1940!" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:498817 ;
            sgpl:spatialText "Leningrad" ;
            sgpl:text_context "Daarbij werd Hitler ook geïmponeerd door het feit dat na de val van Leningrad (nodig om de Oostzee te beveiligen en de verbinding met de Finnen tot stand te brengen, ook al blijft deze opmars een secundaire operatie, die de beslissing niet beïnvloedt) en Stalingrad beide \"Brutstatten des Bolschewismus” in Nazi-handen zouden zijn. Ik hnthoudt mij hier van een critiek; men zie daarvoor 49-27. Het gevolg was, dat besloten werd tot een excentrische divergerende aanval met 3 opmarsrichtingen, met de hoofdas op Leningrad, Moskou en Stalingrad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:472757 ;
            sgpl:spatialText "Stalingrad" ;
            sgpl:text_context "Daarbij werd Hitler ook geïmponeerd door het feit dat na de val van Leningrad (nodig om de Oostzee te beveiligen en de verbinding met de Finnen tot stand te brengen, ook al blijft deze opmars een secundaire operatie, die de beslissing niet beïnvloedt) en Stalingrad beide \"Brutstatten des Bolschewismus” in Nazi-handen zouden zijn. Ik hnthoudt mij hier van een critiek; men zie daarvoor 49-27. Het gevolg was, dat besloten werd tot een excentrische divergerende aanval met 3 opmarsrichtingen, met de hoofdas op Leningrad, Moskou en Stalingrad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:524901 ;
            sgpl:spatialText "Moskou" ;
            sgpl:text_context "De Generale Staf wenste het zwaartepmt te leggen op de aanval op Moskou, gezien de betekenis van dit \"brein\" van de Sovjet-Uuie voor een gecentraliseerde staat, en de industrie en de verkeers- ligging van de stad. Hitler daarentegen wenste zich vóór alle dingen mees- ter te maken van het rijke landbouw- en mijnbouw- en industrie- gebied van de Oekraïne en de Kaukasus (19-191,202). Het gevolg was, dat besloten werd tot een excentrische divergerende aanval met 3 opmarsrichtingen, met de hoofdas op Leningrad, Moskou en Stalingrad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:8354411 ;
            sgpl:spatialText "de toendra" ;
            sgpl:text_context "Op kaart 2 zien we hoe de toendra zich uitstrekt langs de Noordkust van de Sovjet-Unie over een variërende breedte. Het operatietoneel lag van 1941-45 ten Westen van Moermansk 50 tot 100 km breed, op het Kolaschiereiland (8-2/21,7-62/6, 9-85/97). Het gehele gebied ligt binnen de poolcirkel." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2975349 ;
            sgpl:spatialText "Sedan" ;
            sgpl:text_context "Juist de Ardennen, die in de Tweede Wereldoorlog het toneel van zo’n heftige strijd zijn geweest! En juist de doorbraak naar Sedan was de factor, die het meest bijdroeg tot de snelle onder- gang van het Franse leger in 1940! Uit dit voorbeeld blijkt overduidelijk, van hoeveel belang een juiste waardering van de milieu-invloeden is, juist voor de meest hooggeplaatste leiders, en tevens, hoezeer het die leiders daaraan nog kan ontbreken!" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:8354411 ;
            sgpl:spatialText "Sovjet-Unie" ;
            sgpl:text_context "DE INVLOED VAN HET GEOGRAFISCH MILIEU OP DE DUITSE VELDTOCHT IN DE SOVJET-UNIE IN 1941. Doctoraalscriptie van F.P.ten Kate, soc.geogr’.cand Utrecht, 31 Maart 1954. Op deze bladzijden is geprobeerd een beeld te geven van de invloed, die het geografisch milieu heeft uitgeoefend op de Duitse veldtocht in de Sovjet-Unie in 1941, op de mis- lukking daarvan, tot het invallen van de dooi in het voorjaar van 1942." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "DE INVLOED VAN HET GEOGRAFISCH MILIEU OP DE DUITSE VELDTOCHT IN DE SOVJET-UNIE IN 1941. Doctoraalscriptie van F.P.ten Kate, soc.geogr’.cand Utrecht, 31 Maart 1954. Op deze bladzijden is geprobeerd een beeld te geven van de invloed, die het geografisch milieu heeft uitgeoefend op de Duitse veldtocht in de Sovjet-Unie in 1941, op de mis- lukking daarvan, tot het invallen van de dooi in het voorjaar van 1942." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:546554 ;
            sgpl:spatialText "Kolaschiereiland" ;
            sgpl:text_context "Het operatietoneel lag van 1941-45 ten Westen van Moermansk 50 tot 100 km breed, op het Kolaschiereiland (8-2/21,7-62/6, 9-85/97). Het gehele gebied ligt binnen de poolcirkel. Door de werking van de Golfstroom wordt de kou echter getemperd (gem. Julitemperatuur 12°C., gem.Januaritemperatuur -10°C.)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept172 ;
            sgpl:subjectText "Militaire Geografie" ;
            sgpl:text_context "De kennis van deze invloed is dus voor allen, die met de oorlogvoering te maken hebben, van het grootste belang. De studie van de invloed, die het geografisch milieu op de oorlogvoering uitoefent, is de taak van de Militaire Geografie (Military Geography, Géographie Militaire, Kriegsgeographie). In het verleden is deze studie slechts zelden op wetenschappelijke wijze verricht." ],
        [ sgpl:refersToConcept unesco:concept172 ;
            sgpl:subjectText "Geografisch milieu" ;
            sgpl:text_context "Men zou deze uitspraak de zinspreuk van de Militaire Geografie kunnen noemen. De moderne oorlogvoering wordt in al haar geledingen beïnvloed door het geografisch milieu (waarover later meer). De kennis van deze invloed is dus voor allen, die met de oorlogvoering te maken hebben, van het grootste belang." ],
        [ sgpl:refersToConcept unesco:concept8105 ;
            sgpl:subjectText "Winteroorlog" ;
            sgpl:text_context "Van de tweede fase zal ik alleen in het kort weergeven hoe de beide legerleidingen bij het maken van hun veldtochtsplannen door het geografisch milieu beïnvloed werden (Hoofdstuk III). Omdat het klimaat in deze oorlog zo’n beslissende rol heeft gespeeld is in een apart hoofdstuk de Winteroorlog behandeld (hoofdstuk VIII). Ook hierbij is niet naar volledigheid gestreefd; dat is in het verband van een scriptie niet mogelijk." ],
        [ sgpl:refersToConcept unesco:concept172 ;
            sgpl:subjectText "Geografisch milieu" ;
            sgpl:text_context "Men zou deze uitspraak de zinspreuk van de Militaire Geografie kunnen noemen. De moderne oorlogvoering wordt in al haar geledingen beïnvloed door het geografisch milieu (waarover later meer). De kennis van deze invloed is dus voor allen, die met de oorlogvoering te maken hebben, van het grootste belang." ],
        [ sgpl:refersToConcept unesco:concept172 ;
            sgpl:subjectText "Militaire Geografie" ;
            sgpl:text_context "De kennis van deze invloed is dus voor allen, die met de oorlogvoering te maken hebben, van het grootste belang. De studie van de invloed, die het geografisch milieu op de oorlogvoering uitoefent, is de taak van de Militaire Geografie (Military Geography, Géographie Militaire, Kriegsgeographie). In het verleden is deze studie slechts zelden op wetenschappelijke wijze verricht." ],
        [ sgpl:refersToConcept unesco:concept8105 ;
            sgpl:subjectText "Winteroorlog" ;
            sgpl:text_context "Van de tweede fase zal ik alleen in het kort weergeven hoe de beide legerleidingen bij het maken van hun veldtochtsplannen door het geografisch milieu beïnvloed werden (Hoofdstuk III). Omdat het klimaat in deze oorlog zo’n beslissende rol heeft gespeeld is in een apart hoofdstuk de Winteroorlog behandeld (hoofdstuk VIII). Ook hierbij is niet naar volledigheid gestreefd; dat is in het verband van een scriptie niet mogelijk." ] ;
    sgpl:thesisID 21 .

sgpl:Thesis210 a sgpl:SGPLThesis ;
    dcterms:creator "E.J.G. Boerrigter" ;
    dcterms:issued 1990 ;
    dcterms:title "DE REACTIE VAN WINKELIERS OP EEN STADSVERNIEUWINGSPLAN",
        "VERSLAGEN VAN LEERONDERZOEK G & P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Met name in de vier grote steden in Nederland is dit duidelijk te zien: het IJ-centraal en het oostelijk havengebied in Amsterdam, de kop van Zuid en Waterstad in Rotterdam, het gebied Spuikwar- tier, Centraal Station en Utrechtse Baan in Den Haag en het Utrecht City Project in Utrecht. Al deze plannen bevinden zich echter nog in de voorbereidingsfase. Deze trend van ingrijpende projekten om de binnenstad nieuw leven in te blazen beperkt zich echter niet tot de vier grote steden in Nederland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Verenigde Staten" ;
            sgpl:text_context "Dergelijke projecten vonden hun oorsprong in de Verenigde Staten. Als antwoord op het proces van verpaupering en ontvolking van de binnensteden zijn in enkele miljoenensteden in de Verenigde Staten voor delen van de binnenstad stadsvernieuwingsplannen van de overheid en private investeerders tot stand gekomen. Door middel van zeer hoge investeringen in korte tijd in grootschalige projecten moest de neerwaartse ontwikkeling omgebogen worden in een positieve ontwikkeling." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759820 ;
            sgpl:spatialText "Gemeente Amersfoort" ;
            sgpl:text_context "Deze grootschalige projecten zullen ongetwijfeld invloed hebben op het ondernemersgedrag van de winkeliers in het projektgebied. In deze scriptie zal nader ingegaan worden op het grootschalige herstructureringsplan in de Gemeente Amersfoort. De toekomstige ontwikkelingen zijn vastgelegd in een stadsvernieuwingsplan, wat nog in voorbereiding is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Met name in de vier grote steden in Nederland is dit duidelijk te zien: het IJ-centraal en het oostelijk havengebied in Amsterdam, de kop van Zuid en Waterstad in Rotterdam, het gebied Spuikwar- tier, Centraal Station en Utrechtse Baan in Den Haag en het Utrecht City Project in Utrecht. Al deze plannen bevinden zich echter nog in de voorbereidingsfase. Deze trend van ingrijpende projekten om de binnenstad nieuw leven in te blazen beperkt zich echter niet tot de vier grote steden in Nederland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "Deze trend van ingrijpende projekten om de binnenstad nieuw leven in te blazen beperkt zich echter niet tot de vier grote steden in Nederland. Voorbeelden hiervan zijn Maastricht, Groningen, Leeuwarden, Tilburg, Geleen, Helmond, Capelle aan de IJsel, Arnhem en Amersfoort (BUIT, 1989, p.57). Deze grootschalige projecten zullen ongetwijfeld invloed hebben op het ondernemersgedrag van de winkeliers in het projektgebied." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:4347778 ;
            sgpl:spatialText "Baltimore" ;
            sgpl:text_context "Door middel van zeer hoge investeringen in korte tijd in grootschalige projecten moest de neerwaartse ontwikkeling omgebogen worden in een positieve ontwikkeling. Een aantal van deze projecten was succesvol (o.a. in Baltimore en in Boston), waardoor de bin- nensteden opnieuw tot bloei kwamen. Verscheidene Europese landen, waaronder ook Nederland, ontwik- kelden soortgelijke projecten in de jaren 80 om de neergang in de eigen binnensteden te bestrijden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "binnenstad van Amerfoort" ;
            sgpl:text_context "De toekomstige ontwikkelingen zijn vastgelegd in een stadsvernieuwingsplan, wat nog in voorbereiding is. Hierbij staat centraal de detailhandel in de binnenstad van Amerfoort. In het onderzoek zal geprobeerd worden te achterhalen in hoeverre het stadsvernieuwingsplan, dat nog in voorbereiding is, dus nog niet is uitgevoerd, in deze fase invloed heeft op het ondernemersgedrag van de huidige detail- handel in de binnenstad van Amersfoort." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Met name in de vier grote steden in Nederland is dit duidelijk te zien: het IJ-centraal en het oostelijk havengebied in Amsterdam, de kop van Zuid en Waterstad in Rotterdam, het gebied Spuikwar- tier, Centraal Station en Utrechtse Baan in Den Haag en het Utrecht City Project in Utrecht. Al deze plannen bevinden zich echter nog in de voorbereidingsfase. Deze trend van ingrijpende projekten om de binnenstad nieuw leven in te blazen beperkt zich echter niet tot de vier grote steden in Nederland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Langestraat" ;
            sgpl:text_context "De bewinkeling heeft een sterk lineaire structuur in de binnenstad. Vanaf de Stadsring, de Utrechtse en de Arnhemse straat, loopt het winkelgebied via de Langestraat en de Kamp naar de andere kant van de Stadsring. Aan de binnenzijde van de Stadsring zijn vrijwel geen winkels gevestigd, waardoor het kernwinkelapparaat zich nauwelijks naar buiten presenteert." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Met name in de vier grote steden in Nederland is dit duidelijk te zien: het IJ-centraal en het oostelijk havengebied in Amsterdam, de kop van Zuid en Waterstad in Rotterdam, het gebied Spuikwar- tier, Centraal Station en Utrechtse Baan in Den Haag en het Utrecht City Project in Utrecht. Al deze plannen bevinden zich echter nog in de voorbereidingsfase. Deze trend van ingrijpende projekten om de binnenstad nieuw leven in te blazen beperkt zich echter niet tot de vier grote steden in Nederland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Mogelijkheden daartoe worden gezien in enkele grootschalige herstructureringsprojekten, gelegen in of nabij de binnenstad. Met name in de vier grote steden in Nederland is dit duidelijk te zien: het IJ-centraal en het oostelijk havengebied in Amsterdam, de kop van Zuid en Waterstad in Rotterdam, het gebied Spuikwar- tier, Centraal Station en Utrechtse Baan in Den Haag en het Utrecht City Project in Utrecht. Al deze plannen bevinden zich echter nog in de voorbereidingsfase." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de Kamp" ;
            sgpl:text_context "Vanaf de Stadsring, de Utrechtse en de Arnhemse straat, loopt het winkelgebied via de Langestraat en de Kamp naar de andere kant van de Stadsring. Aan de binnenzijde van de Stadsring zijn vrijwel geen winkels gevestigd, waardoor het kernwinkelapparaat zich nauwelijks naar buiten presenteert. Om het lineaire karakter van het kernwinkelapparaat te verbeteren is het de bedoeling om een winkelcircuit te creëren, waarbij ook de winkels in het Centraal Stadsgebied bij betrokken worden (zie figuur 2.)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Centraal Stadsgebied" ;
            sgpl:text_context "In het kader van het stadsvernieuwingsplan wordt onder het Centraal Stadsgebied verstaan een deel van de historische binnenstad, met name het westelijke deel van de schil om de stadskern, het westelijk van de stadsring aansluitende gebied ten zuidwesten van de binnenstad, het stationsgebied en omgeving en het bedrijvencentrum aan de noordzijde van de spoorlijn (STADS- VERNIEUWINGSPLAN, 1989, p.4). Het plangebied heeft een oppervlakte van ca. 12 ha (zie figuur 1). Er worden in het plan drie zwaartepunten onderscheiden: de binnenstad, het stationsgebied en het gebied Koppel/Soesterkwartier." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:4930956 ;
            sgpl:spatialText "Boston" ;
            sgpl:text_context "Door middel van zeer hoge investeringen in korte tijd in grootschalige projecten moest de neerwaartse ontwikkeling omgebogen worden in een positieve ontwikkeling. Een aantal van deze projecten was succesvol (o.a. in Baltimore en in Boston), waardoor de bin- nensteden opnieuw tot bloei kwamen. Verscheidene Europese landen, waaronder ook Nederland, ontwik- kelden soortgelijke projecten in de jaren 80 om de neergang in de eigen binnensteden te bestrijden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "Deze trend van ingrijpende projekten om de binnenstad nieuw leven in te blazen beperkt zich echter niet tot de vier grote steden in Nederland. Voorbeelden hiervan zijn Maastricht, Groningen, Leeuwarden, Tilburg, Geleen, Helmond, Capelle aan de IJsel, Arnhem en Amersfoort (BUIT, 1989, p.57). Deze grootschalige projecten zullen ongetwijfeld invloed hebben op het ondernemersgedrag van de winkeliers in het projektgebied." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept17186 ;
            sgpl:subjectText "Ondernemersgedrag" ;
            sgpl:text_context "In het onderzoek zal geprobeerd worden te achterhalen in hoeverre het stadsvernieuwingsplan, dat nog in voorbereiding is, dus nog niet is uitgevoerd, in deze fase invloed heeft op het ondernemersgedrag van de huidige detailhandel in de binnenstad van Amersfoort. Samengevat luidt de probleemstelling van dit onderzoek: \"Welke invloed heeft de herstructurering van het centrum van Amersfoort op het ondernemersgedrag van de huidige detailhandel in de binnenstad van Amerfoort\". De ruimtelijke gevolgen van het stadsvernieuwingsplan op de detailhandel in Amerfoort zal benvloed worden door de verschillende kenmerken van de ondernemers." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwingsplan" ;
            sgpl:text_context "De toekomstige ontwikkelingen zijn vastgelegd in een stadsvernieuwingsplan, wat nog in voorbereiding is. In het onderzoek zal geprobeerd worden te achterhalen in hoeverre het stadsvernieuwingsplan, dat nog in voorbereiding is, dus nog niet is uitgevoerd, in deze fase invloed heeft op het ondernemersgedrag van de huidige detailhandel in de binnenstad van Amersfoort. Bij het onderzoek zijn de volgende vragen gesteld: Wat is de kennis van de winkeliers van de stadsvernieuwingsplannen en hoe hebben zij hun informatie verkregen ?" ],
        [ sgpl:refersToConcept unesco:concept10018 ;
            sgpl:subjectText "Ruimtelijke impact-analyse" ;
            sgpl:text_context "Een onderzoek om de uit- eenlopende ruimtelijke gevolgen van een belangrijke ingreep in het ruimtelijk systeem vast te stellen of te voorspellen wordt een ruimtelijke impact-analyse of ruimtelijke impact-assessment genoemd (BUIT, 1989, p.13). In het algemeen kan gesteld worden dat het hoofddoel van een impact- analyse is dat een compleet en systematisch beeld van de effecten van beleidsbeslissingen of van de gevolgen van exogene verschui- vingen in een bepaald systeem verkregen worden (NIJKAMP, 1982, p.89). De ruimtelijke impact-analyse geeft dus een beeld van de ruim- telijke gevolgen." ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "Stadsvernieuwingsplan" ;
            sgpl:text_context "De toekomstige ontwikkelingen zijn vastgelegd in een stadsvernieuwingsplan, wat nog in voorbereiding is. In het onderzoek zal geprobeerd worden te achterhalen in hoeverre het stadsvernieuwingsplan, dat nog in voorbereiding is, dus nog niet is uitgevoerd, in deze fase invloed heeft op het ondernemersgedrag van de huidige detailhandel in de binnenstad van Amersfoort. Bij het onderzoek zijn de volgende vragen gesteld: Wat is de kennis van de winkeliers van de stadsvernieuwingsplannen en hoe hebben zij hun informatie verkregen ?" ],
        [ sgpl:refersToConcept unesco:concept17186 ;
            sgpl:subjectText "Ondernemersgedrag" ;
            sgpl:text_context "In het onderzoek zal geprobeerd worden te achterhalen in hoeverre het stadsvernieuwingsplan, dat nog in voorbereiding is, dus nog niet is uitgevoerd, in deze fase invloed heeft op het ondernemersgedrag van de huidige detailhandel in de binnenstad van Amersfoort. Samengevat luidt de probleemstelling van dit onderzoek: \"Welke invloed heeft de herstructurering van het centrum van Amersfoort op het ondernemersgedrag van de huidige detailhandel in de binnenstad van Amerfoort\". De ruimtelijke gevolgen van het stadsvernieuwingsplan op de detailhandel in Amerfoort zal benvloed worden door de verschillende kenmerken van de ondernemers." ],
        [ sgpl:refersToConcept unesco:concept10018 ;
            sgpl:subjectText "Ruimtelijke impact-analyse" ;
            sgpl:text_context "Een onderzoek om de uit- eenlopende ruimtelijke gevolgen van een belangrijke ingreep in het ruimtelijk systeem vast te stellen of te voorspellen wordt een ruimtelijke impact-analyse of ruimtelijke impact-assessment genoemd (BUIT, 1989, p.13). In het algemeen kan gesteld worden dat het hoofddoel van een impact- analyse is dat een compleet en systematisch beeld van de effecten van beleidsbeslissingen of van de gevolgen van exogene verschui- vingen in een bepaald systeem verkregen worden (NIJKAMP, 1982, p.89). De ruimtelijke impact-analyse geeft dus een beeld van de ruim- telijke gevolgen." ] ;
    sgpl:thesisID 210 .

sgpl:Thesis211 a sgpl:SGPLThesis ;
    dcterms:creator "Daan Bours",
        "Ron Moonen" ;
    dcterms:issued 1990 ;
    dcterms:title "IN DE RANDSTAD",
        "TELECOMMUNICATIE EN BEDRIJFSLOCATIE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747129 ;
            sgpl:spatialText "Teleport Sloterdijk" ;
            sgpl:text_context "De PABX in de kelders van het WTC in A'dam zuid is in gebruik genomen na de aansluiting van het WTC op het glasvezelnet in 1986. De PABX op Teleport Sloterdijk is geïnstalleerd in het bedrijfsverzamelgebouw \"Busitel\" en is in gebruik genomen met de opening van dit gebouw in 1988. Ook deze PABX is aangesloten op het glasvezelnet." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Onderzoek kan op verschillende niveau's plaatsvinden. In deze scriptie gaat het om de vier stadsgewesten in de Randstad: Amsterdam, Den Haag, Rotterdam en Utrecht. De verantwoording van deze keus is gelegen in het feit dat de Randstad zowel in economisch als in telecommunicatief opzicht het zwaartepunt van Nederland is." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "de Randstad" ;
            sgpl:text_context "Voor u ligt de scriptie \"Telecommunicatie en bedrijfslocatie in de Randstad\". Centraal in deze scriptie staat de invloed van telecommunicatie-infrastructuur op de bedrijfslocatie: er zal gezocht worden naar gunstige locaties voor bedrijven uit het oogpunt van het gebruik van bepaalde telecommunicatievoorzieningen. De scriptie is het resultaat van een leeronderzoek dat wij hebben uitgevoerd als doctoraalstudenten sociale geografie aan de Vakgroep Toegepaste Geografie en Ruimtelijke Planning van de Faculteit der Ruimtelijke Wetenschappen van de R.U. Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743856 ;
            sgpl:spatialText "Zoetermeer" ;
            sgpl:text_context "Twee bestaande projecten zijn het Study en Workpark Laakhaven en het Campusproject Zoetermeer. Laakhaven moet een \"knooppunt van brains\" worden dat nieuwe bedrijven en kantoren in de sfeer van informatica en nieuwe productie-technologie aantrekt. Met het Campusproject beoogt men een kantorenpark te realiseren waarin de eigen identiteit van de gebruiker gestalte kan krijgen: het gaat om kleinere, solitaire kantooreenheden met technologisch hoogwaardige faciliteiten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Laakhaven" ;
            sgpl:text_context "Twee bestaande projecten zijn het Study en Workpark Laakhaven en het Campusproject Zoetermeer. Laakhaven moet een \"knooppunt van brains\" worden dat nieuwe bedrijven en kantoren in de sfeer van informatica en nieuwe productie-technologie aantrekt. Met het Campusproject beoogt men een kantorenpark te realiseren waarin de eigen identiteit van de gebruiker gestalte kan krijgen: het gaat om kleinere, solitaire kantooreenheden met technologisch hoogwaardige faciliteiten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Onderzoek kan op verschillende niveau's plaatsvinden. In deze scriptie gaat het om de vier stadsgewesten in de Randstad: Amsterdam, Den Haag, Rotterdam en Utrecht. De verantwoording van deze keus is gelegen in het feit dat de Randstad zowel in economisch als in telecommunicatief opzicht het zwaartepunt van Nederland is." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Onderzoek kan op verschillende niveau's plaatsvinden. In deze scriptie gaat het om de vier stadsgewesten in de Randstad: Amsterdam, Den Haag, Rotterdam en Utrecht. De verantwoording van deze keus is gelegen in het feit dat de Randstad zowel in economisch als in telecommunicatief opzicht het zwaartepunt van Nederland is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De geografie, als ruimtelijke wetenschap, heeft altijd al in ruime mate belangstelling getoond voor de voorwaarden, mogelijkheden en effecten van afstandsoverbrugging binnen de ruimte. De visie op de ruimtelijke organisatie in Nederland is neergelegd in de Vierde Nota Ruimtelijke Ordening. Deze nota, uitgegeven in maart 1988, bevat de plannen van de regering aangaande het ruimtelijke beleid en geeft de beleidslijnen aan tot het jaar 2015." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:10173839 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Ook andere projecten zoals het NS Rail Service Centrum Rotterdam en Transpolis Schiphol wijzen op het belang van telecommunicatie in het transport (Inlandterminals en transportcentra in Nederland, Rom bulletin, nr.11, nov. 1988). In een ander rapport, van de Dienst Ruimtelijke Ordening Amsterdam (p.3, 1986) wordt gezegd: \"Met name bij de groothandel, het transport en bankwezen goede gebruiksmogelijkheden van zeer grote databanken steeds essentiëler worden voor de concurrentie. Bankwezen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Onderzoek kan op verschillende niveau's plaatsvinden. In deze scriptie gaat het om de vier stadsgewesten in de Randstad: Amsterdam, Den Haag, Rotterdam en Utrecht. De verantwoording van deze keus is gelegen in het feit dat de Randstad zowel in economisch als in telecommunicatief opzicht het zwaartepunt van Nederland is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759793 ;
            sgpl:spatialText "de gemeente Amsterdam" ;
            sgpl:text_context "Ten tweede wordt hiermee getracht te voorkomen dat bedrijven zich in de toekomst naar de randgemeenten zullen verplaatsen door gebrek aan kantooruitbreidingsmogelijkheden in de gemeente Amsterdam zelf. Tot aan de kantorennota van 1983 waarin de prioriteit gegeven wordt aan de uitgifte van terreinen in Sloterdijk, blijft het slechts bij plannen. In dat jaar zoekt het adviesbureau OD 205 naar een locatie om een integraal plan te ontwikkelen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758946 ;
            sgpl:spatialText "Bijlmermeer" ;
            sgpl:text_context "Tenslotte hebben de drie bedrijfsklassen een oververtegenwoordiging van vestigingen in een aantal aangrenzende buurten in het noorden en in zuid-oost (Bijlmermeer en omgeving). In tegenstelling tot de drie hierboven besproken bedrijfsklassen zijn de groothandel en de transportsector meer oververtegenwoordigd in de, ten opzichte van het stadscentrum, perifeer gelegen buurten. Beide zijn oververtegenwoordigd in landelijk west en in zuid." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept522 ;
            sgpl:subjectText "Teleportconcept" ;
            sgpl:text_context "Teleports zijn vooral gericht op grootgebruikers van omvangrijke bestanden van informatie die met hoge snelheid en accuratesse over grote afstanden worden getransporteerd. Het Teleportconcept beoogt door het locaal aanbieden van een moderne telecommunicatie-infrastructuur, in combinatie met een aantal daarop aansluitende voorzieningen en diensten, de relatieve attractiviteit van het productiemilieu voor bedrijven te verhogen (zie paragraaf 1.3). Het bovenstaande moet veelal geplaatst worden binnen een concept van \"city-marketing\" zoals dat thans door vele gemeenten gehanteerd wordt (de Smidt, van Butselaar, de Vet, 1984, p.43)." ],
        [ sgpl:refersToConcept unesco:concept527 ;
            sgpl:subjectText "telecommunicatie-infrastructuur" ;
            sgpl:text_context "Voor u ligt de scriptie \"Telecommunicatie en bedrijfslocatie in de Randstad\". Centraal in deze scriptie staat de invloed van telecommunicatie-infrastructuur op de bedrijfslocatie: er zal gezocht worden naar gunstige locaties voor bedrijven uit het oogpunt van het gebruik van bepaalde telecommunicatievoorzieningen. De scriptie is het resultaat van een leeronderzoek dat wij hebben uitgevoerd als doctoraalstudenten sociale geografie aan de Vakgroep Toegepaste Geografie en Ruimtelijke Planning van de Faculteit der Ruimtelijke Wetenschappen van de R.U. Utrecht." ],
        [ sgpl:refersToConcept unesco:concept12334 ;
            sgpl:subjectText "bedrijfslocatie" ;
            sgpl:text_context "Met name in de Randstad zijn reeds enige projecten op dit gebied gerealiseerd, maar ook de rest van Nederland zal in deze ontwikkeling zeker niet achterblijven. In deze scriptie wordt gekeken naar de invloed van telecommunicatie-infrastructuur op de bedrijfslocatie. Er van uitgaande dat deze invloed uitoefent op het locatiekeuzeproces, heeft het onderzoek de volgende doelstelling: het zoeken van gunstige locaties voor bedrijven uit het oogpunt van het gebruik van bepaalde telecommunicatievoorzieningen." ],
        [ sgpl:refersToConcept unesco:concept527 ;
            sgpl:subjectText "telecommunicatie-infrastructuur" ;
            sgpl:text_context "Voor u ligt de scriptie \"Telecommunicatie en bedrijfslocatie in de Randstad\". Centraal in deze scriptie staat de invloed van telecommunicatie-infrastructuur op de bedrijfslocatie: er zal gezocht worden naar gunstige locaties voor bedrijven uit het oogpunt van het gebruik van bepaalde telecommunicatievoorzieningen. De scriptie is het resultaat van een leeronderzoek dat wij hebben uitgevoerd als doctoraalstudenten sociale geografie aan de Vakgroep Toegepaste Geografie en Ruimtelijke Planning van de Faculteit der Ruimtelijke Wetenschappen van de R.U. Utrecht." ],
        [ sgpl:refersToConcept unesco:concept12334 ;
            sgpl:subjectText "bedrijfslocatie" ;
            sgpl:text_context "Met name in de Randstad zijn reeds enige projecten op dit gebied gerealiseerd, maar ook de rest van Nederland zal in deze ontwikkeling zeker niet achterblijven. In deze scriptie wordt gekeken naar de invloed van telecommunicatie-infrastructuur op de bedrijfslocatie. Er van uitgaande dat deze invloed uitoefent op het locatiekeuzeproces, heeft het onderzoek de volgende doelstelling: het zoeken van gunstige locaties voor bedrijven uit het oogpunt van het gebruik van bepaalde telecommunicatievoorzieningen." ],
        [ sgpl:refersToConcept unesco:concept522 ;
            sgpl:subjectText "Teleportconcept" ;
            sgpl:text_context "Teleports zijn vooral gericht op grootgebruikers van omvangrijke bestanden van informatie die met hoge snelheid en accuratesse over grote afstanden worden getransporteerd. Het Teleportconcept beoogt door het locaal aanbieden van een moderne telecommunicatie-infrastructuur, in combinatie met een aantal daarop aansluitende voorzieningen en diensten, de relatieve attractiviteit van het productiemilieu voor bedrijven te verhogen (zie paragraaf 1.3). Het bovenstaande moet veelal geplaatst worden binnen een concept van \"city-marketing\" zoals dat thans door vele gemeenten gehanteerd wordt (de Smidt, van Butselaar, de Vet, 1984, p.43)." ] ;
    sgpl:thesisID 211 .

sgpl:Thesis212 a sgpl:SGPLThesis ;
    dcterms:creator "Christianne Derks" ;
    dcterms:issued 1990 ;
    dcterms:title "HOGER TECHNISCH WERK IN ZUID-LIMBURG: GRENZELOZE MOGELIJKHEDEN?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De omzetting van kennis en technieken in rendabele economische activiteiten is mede afhankelijk van een goed geschoolde beroepsbevolking. De prognoses van het CBS wijzen erop dat na een lichte toename tot het jaar 2000, de beroepsbevolking in Nederland sterk zal dalen, doordat de instroom de grotere uitstroom niet meer compenseert. Nu reeds treedt een daling op van de instroom van jongeren op LBO-niveau in het arbeidsproces." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748179 ;
            sgpl:spatialText "Euregio Maas-Rijn" ;
            sgpl:text_context "De geografische ligging van Zuid-Limburg daarentegen biedt mogelijkheden tot verkleining van dit probleem. Zuid-Limburg vormt namelijk samen met de deelgebieden Aken, Belgisch Limburg en Luik, de Euregio Maas-Rijn. Gezien de toenemende internationalisatie in West-Europa is het de vraag of de Euregio in de toekomst als een regionale arbeidsmarkt (in dit geval met betrekking tot hoger technisch opgeleiden) gezien kan worden en/of dat de regionale mobiliteit toeneemt, dat wil zeggen het verhuizen voor werk of door middel van pendelen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "Deze scriptie is geschreven in het kader van de studie sociale geografie met als specialisatierichting economische geografie aan de Rijksuniversiteit Utrecht. De eerste aanzet hiertoe is gegeven door een stage bij het Economisch Technologisch Instituut Limburg te Maastricht. Op deze plaats wil ik het ETIL bedanken voor het verlenen van een stageplaats, alle gesprekspersonen voor het beschikbaar stellen van tijd en informatie en de scriptiebegeleiders drs. Heleen van Camp en prof. dr. M. de Smidt voor hun begeleiding." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "West-Europa" ;
            sgpl:text_context "Zuid-Limburg vormt namelijk samen met de deelgebieden Aken, Belgisch Limburg en Luik, de Euregio Maas-Rijn. Gezien de toenemende internationalisatie in West-Europa is het de vraag of de Euregio in de toekomst als een regionale arbeidsmarkt (in dit geval met betrekking tot hoger technisch opgeleiden) gezien kan worden en/of dat de regionale mobiliteit toeneemt, dat wil zeggen het verhuizen voor werk of door middel van pendelen. Doel van dit onderzoek is het inzichtelijk maken van de volgende aspecten van de internationalisatie oftewel Euregionalisatie van de arbeidsmarkt voor hoger technisch geschoolden in Zuid-Limburg:" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Zuid-Limburg" ;
            sgpl:text_context "In de volgende drie hoofdstukken wordt de discrepantie tussen vraag en aanbod van hoger technisch geschoolden in een breder kader geplaatst. In de hoofdstukken vijf en zes wordt de in hoofdstuk vier als mogelijke oplossing geopperde internationalisatie aan de hand van een case-study over Zuid-Limburg uitgewerkt. De sociaal-economische situatie van Zuid-Limburg en de Euregio Maas-Rijn wordt in het vijfde hoofdstuk toegelicht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2958781 ;
            sgpl:spatialText "Aken" ;
            sgpl:text_context "De geografische ligging van Zuid-Limburg daarentegen biedt mogelijkheden tot verkleining van dit probleem. Zuid-Limburg vormt namelijk samen met de deelgebieden Aken, Belgisch Limburg en Luik, de Euregio Maas-Rijn. Gezien de toenemende internationalisatie in West-Europa is het de vraag of de Euregio in de toekomst als een regionale arbeidsmarkt (in dit geval met betrekking tot hoger technisch opgeleiden) gezien kan worden en/of dat de regionale mobiliteit toeneemt, dat wil zeggen het verhuizen voor werk of door middel van pendelen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Utrecht, augustus 1990. Deze scriptie is geschreven in het kader van de studie sociale geografie met als specialisatierichting economische geografie aan de Rijksuniversiteit Utrecht. De eerste aanzet hiertoe is gegeven door een stage bij het Economisch Technologisch Instituut Limburg te Maastricht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2792411 ;
            sgpl:spatialText "Luik" ;
            sgpl:text_context "Zuid-Limburg vormt namelijk samen met de deelgebieden Aken, Belgisch Limburg en Luik, de Euregio Maas-Rijn. Gezien de toenemende internationalisatie in West-Europa is het de vraag of de Euregio in de toekomst als een regionale arbeidsmarkt (in dit geval met betrekking tot hoger technisch opgeleiden) gezien kan worden en/of dat de regionale mobiliteit toeneemt, dat wil zeggen het verhuizen voor werk of door middel van pendelen. Doel van dit onderzoek is het inzichtelijk maken van de volgende aspecten van de internationalisatie oftewel Euregionalisatie van de arbeidsmarkt voor hoger technisch geschoolden in Zuid-Limburg:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2792348 ;
            sgpl:spatialText "Belgisch Limburg" ;
            sgpl:text_context "De geografische ligging van Zuid-Limburg daarentegen biedt mogelijkheden tot verkleining van dit probleem. Zuid-Limburg vormt namelijk samen met de deelgebieden Aken, Belgisch Limburg en Luik, de Euregio Maas-Rijn. Gezien de toenemende internationalisatie in West-Europa is het de vraag of de Euregio in de toekomst als een regionale arbeidsmarkt (in dit geval met betrekking tot hoger technisch opgeleiden) gezien kan worden en/of dat de regionale mobiliteit toeneemt, dat wil zeggen het verhuizen voor werk of door middel van pendelen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754652 ;
            sgpl:spatialText "Heerlen" ;
            sgpl:text_context "De universiteiten leiden mensen op voor geheel Nederland, zodat de vraag vanuit de bedrijven mede daardoor landelijk geori&euml;nteerd is. Op het niveau van hoger technisch onderwijs heeft Zuid-Limburg de beschikking over &eacute;&eacute;n instelling, namelijk de hogere technische school in Heerlen. In Nederland zijn er gemiddeld in elk COROP-gebeid 1 a 2 van deze instellingen te vinden, zodat Zuid-Limburg hier geen uitzonderingspositie inneemt." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept9781 ;
            sgpl:subjectText "Hoger technisch onderwijs" ;
            sgpl:text_context "De aanwezigheid van hogere onderwijsinstellingen is een belangrijke voorwaarde voor een goed produktiemilieu. De opleiding van hoger technisch geschoold personeel vindt in Nederland op twee niveaus plaats. Ten eerste het hoger technisch beroepsonderwijs, waar de hogere technische scholen, de hogere laboratoriumscholen en de hogere zeevaartscholen deel van uitmaken." ],
        [ sgpl:refersToConcept unesco:concept14685 ;
            sgpl:subjectText "Arbeidsmarkt voor hoger technisch geschoolden" ;
            sgpl:text_context "Zuid-Limburg vormt namelijk samen met de deelgebieden Aken, Belgisch Limburg en Luik, de Euregio Maas-Rijn. Gezien de toenemende internationalisatie in West-Europa is het de vraag of de Euregio in de toekomst als een regionale arbeidsmarkt (in dit geval met betrekking tot hoger technisch opgeleiden) gezien kan worden en/of dat de regionale mobiliteit toeneemt, dat wil zeggen het verhuizen voor werk of door middel van pendelen. Doel van dit onderzoek is het inzichtelijk maken van de volgende aspecten van de internationalisatie oftewel Euregionalisatie van de arbeidsmarkt voor hoger technisch geschoolden in Zuid-Limburg:" ],
        [ sgpl:refersToConcept unesco:concept12783 ;
            sgpl:subjectText "Internationalisatie" ;
            sgpl:text_context "In het vierde hoofdstuk worden de achtergronden van de aansluitingsproblematiek van hoger technisch geschoolden toegelicht en eventuele oplossingsmogelijkheden aangedragen. In de hoofdstukken vijf en zes wordt de in hoofdstuk vier als mogelijke oplossing geopperde internationalisatie aan de hand van een case-study over Zuid-Limburg uitgewerkt. De sociaal-economische situatie van Zuid-Limburg en de Euregio Maas-Rijn wordt in het vijfde hoofdstuk toegelicht." ],
        [ sgpl:refersToConcept unesco:concept9781 ;
            sgpl:subjectText "Hoger technisch onderwijs" ;
            sgpl:text_context "De aanwezigheid van hogere onderwijsinstellingen is een belangrijke voorwaarde voor een goed produktiemilieu. De opleiding van hoger technisch geschoold personeel vindt in Nederland op twee niveaus plaats. Ten eerste het hoger technisch beroepsonderwijs, waar de hogere technische scholen, de hogere laboratoriumscholen en de hogere zeevaartscholen deel van uitmaken." ],
        [ sgpl:refersToConcept unesco:concept12783 ;
            sgpl:subjectText "Internationalisatie" ;
            sgpl:text_context "In het vierde hoofdstuk worden de achtergronden van de aansluitingsproblematiek van hoger technisch geschoolden toegelicht en eventuele oplossingsmogelijkheden aangedragen. In de hoofdstukken vijf en zes wordt de in hoofdstuk vier als mogelijke oplossing geopperde internationalisatie aan de hand van een case-study over Zuid-Limburg uitgewerkt. De sociaal-economische situatie van Zuid-Limburg en de Euregio Maas-Rijn wordt in het vijfde hoofdstuk toegelicht." ],
        [ sgpl:refersToConcept unesco:concept14685 ;
            sgpl:subjectText "Arbeidsmarkt voor hoger technisch geschoolden" ;
            sgpl:text_context "Zuid-Limburg vormt namelijk samen met de deelgebieden Aken, Belgisch Limburg en Luik, de Euregio Maas-Rijn. Gezien de toenemende internationalisatie in West-Europa is het de vraag of de Euregio in de toekomst als een regionale arbeidsmarkt (in dit geval met betrekking tot hoger technisch opgeleiden) gezien kan worden en/of dat de regionale mobiliteit toeneemt, dat wil zeggen het verhuizen voor werk of door middel van pendelen. Doel van dit onderzoek is het inzichtelijk maken van de volgende aspecten van de internationalisatie oftewel Euregionalisatie van de arbeidsmarkt voor hoger technisch geschoolden in Zuid-Limburg:" ] ;
    sgpl:thesisID 212 .

sgpl:Thesis213 a sgpl:SGPLThesis ;
    dcterms:creator "Jerry Haket" ;
    dcterms:issued 1990 ;
    dcterms:title "Sociale controle en vandalisme",
        "bewonersreacties ten aanzien van vandalisme in de Haagse wijken Morgenstond en Moerwijk" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Leyveg" ;
            sgpl:text_context "In het originele plan van Dudok was aan deze straat woonbebouwing gedacht. In een later stadium werd in het centrale gedeelte van de Leyveg een winkelcentrum toegevoegd, dat nu nog steeds als stadsdeelcentrum functioneert. Ook in deze wijk verd hoogbouw gerealiseerd hoewel deze plaatsen minder markant zijn dan in Moervijk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747373,
                geonames:2750607,
                geonames:2750753 ;
            sgpl:spatialText "de Haagse wijken Morgenstond en Moerwijk" ;
            sgpl:text_context "Verslagen leeronderzoek G. en P. Sociale controle en vandalisme bevonersreacties ten aanzien van vandalisme in de Haagse wijken Morgenstond en Moerwijk Jerry Haket December 1990 Rijksuniversiteit te Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750607 ;
            sgpl:spatialText "Morgenstond" ;
            sgpl:text_context "In Morgenstond verloopt deze overgang tussen de voor-oorlogse en na-oorlogse bouv veel minder geleidelijk. De aandelen gesloten en geopende verkavelingen liggen in Morgenstond beduidend lager dan in Moervijk. De strokenverkaveling, bouvkranen hoeven minder vaak te vorden verplaatst, is in Moervijk bijna niet toegepast." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750753 ;
            sgpl:spatialText "Moerwijk" ;
            sgpl:text_context "Driekwart van de ondervraagden in beide wijken woont in een voning waarvan het hoofdvoonvertrek is gesitueerd op de eerste vier bouwlagen. De variatie in het type voning in Moervijk, de oudste na-oorlogse vijk is gering. Er zijn voornamelijk voningen met een open trappenhuis gebouwd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748075 ;
            sgpl:spatialText "Rijswijk" ;
            sgpl:text_context "Beide wijken worden in het zuiden door de stadsrandzone begrensd, zie kaart 3.2. Deze groene zone werkt als een buffer tussen de gemeenten Den Haag en Rijswijk. De bewoners van de twee vijken kunnen gebruik maken van de talrijke functies die een stadsrandzone te bieden heeft: wandelpaadjes, parken, kinderboerderijen, sportvelden, volkstuinen etc." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Jerry Haket December 1990 Rijksuniversiteit te Utrecht BIBLIOTHEEK CENTRUM UiTHOF RIJKSUNIVERSITEIT TE UTRECHT." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Jan Luyckenlaan en omgeving" ;
            sgpl:text_context "In tegenstelling tot het ruimtelijk patroon van vandalisme in Morgenstond vaar meerdere deelgebieden met een hoog jaarlijks gemiddelde konden worden aangewezen is er in Hoerwijk eigenlijk maar een deelgebied met een hoog gemiddelde: de Jan Luyckenlaan en omgeving, zie kaart 5.2. Dit deelgebied is veel minder grootschalig dan de drie genoemde deelgebieden in Morgenstond. In dit voonbuurtje vaar voornamelijk wordt gewoond is ook een winkelcentrum op buurtniveau te vinden en een kerkgebouw." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "In 1945 kon de balans van vijf bezettingsjaren worden opgemaakt: er waren 8.373 woningen verloren gegaan, 1.394 werden zwaar beschadigd en maar liefst 18.309 raakten licht beschadigd. Dat vil zeggen dat deze tvee vijken samen bijna 10Z van de totale Haagse woningvoorraad bevatten (gemeente Den Haag, 1987c, p.25,), verspreid over circa 350 hectare grond (gemeente Den Haag, 1988, bijlage 4). In een hoog tempo werden er woningwet voningen uit de grond gestampt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6621506 ;
            sgpl:spatialText "Zuiderpark" ;
            sgpl:text_context "De overgang tussen de bebouwing uit de gordel '20 - '40 en het zuidvestelijk stadsdeel vordt bepaald door het Zuiderpark, dat aan een veelheid van recreatieve functies ruimte biedt. Morgenstond vordt in het noorden begrensd door het terrein van het ziekenhuis Leyenburg. Op dit terrein vorden naast deze functie nog verscheidene andere functies geïntegreerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Dit controlerende toezicht vordt sociale controle genoemd. In Nederland werd het begrip sociale controle, in ruimere zin, omschreven als: 'het geheel van factoren, dat bepaalde evenwichtstoestanden in een sociaal systeem handhaaft of herstelt', (van Doom en Lammere, 1959, p. 214). In deze definitie zijn drie elementen aanwezig: 1. het handhavende of herstellende geheel van factoren." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6521 ;
            sgpl:subjectText "sociale controle" ;
            sgpl:text_context "Bij de discussies die op dat ogenblik verden gevoerd viel op dat er steeds werd gezocht naar mogelijkheden om sociale controle te kunnen vergroten. In een enthousiaste vlaag van verstandsverbijstering heb ik de vraag naar mij toegetrokken of mensen vel sociale controle uitoefenen ten aanzien van criminaliteit. Het is aan mijn begeleidster bij dit onderzoek, Anita Tervelle, te danken dat hier niet een 500 pagina's tellend onderzoek voor u ligt vaarin sociale controle ten aanzien van alle vormen van criminaliteit wordt bestudeerd." ],
        [ sgpl:refersToConcept unesco:concept195 ;
            sgpl:subjectText "gebouwde omgeving" ;
            sgpl:text_context "1.5 preventie: vandalisme en de ruimtelijke strategieBn. Vanuit een stedebouwkundige visie onderzoeken van der Voordt en van Vegen de samenhang tussen kenmerken van de gebouwde omgeving en de kenmerken van het crimineel gedrag (van der Voordt en van Vegen, 1986, p. 8). Door middel van stedebouwkundige vormgeving proberen zij een (woon)omgeving te ontwerpen die een kwaliteit bezit waardoor mensen aanwezig zullen zijn." ],
        [ sgpl:refersToConcept unesco:concept7160 ;
            sgpl:subjectText "vandalisme" ;
            sgpl:text_context "De kosten van een vernieling kunnen variëren van een paar tientjes tot een paar duizend gulden. Vandalisme vordt door het veelvuldig voorkomen als een maatschappelijk probleem ervaren. De ontwikkeling van een aanpak van dit probleem is vereist." ],
        [ sgpl:refersToConcept unesco:concept7160 ;
            sgpl:subjectText "vandalisme" ;
            sgpl:text_context "De kosten van een vernieling kunnen variëren van een paar tientjes tot een paar duizend gulden. Vandalisme vordt door het veelvuldig voorkomen als een maatschappelijk probleem ervaren. De ontwikkeling van een aanpak van dit probleem is vereist." ],
        [ sgpl:refersToConcept unesco:concept6521 ;
            sgpl:subjectText "sociale controle" ;
            sgpl:text_context "Bij de discussies die op dat ogenblik verden gevoerd viel op dat er steeds werd gezocht naar mogelijkheden om sociale controle te kunnen vergroten. In een enthousiaste vlaag van verstandsverbijstering heb ik de vraag naar mij toegetrokken of mensen vel sociale controle uitoefenen ten aanzien van criminaliteit. Het is aan mijn begeleidster bij dit onderzoek, Anita Tervelle, te danken dat hier niet een 500 pagina's tellend onderzoek voor u ligt vaarin sociale controle ten aanzien van alle vormen van criminaliteit wordt bestudeerd." ],
        [ sgpl:refersToConcept unesco:concept195 ;
            sgpl:subjectText "gebouwde omgeving" ;
            sgpl:text_context "1.5 preventie: vandalisme en de ruimtelijke strategieBn. Vanuit een stedebouwkundige visie onderzoeken van der Voordt en van Vegen de samenhang tussen kenmerken van de gebouwde omgeving en de kenmerken van het crimineel gedrag (van der Voordt en van Vegen, 1986, p. 8). Door middel van stedebouwkundige vormgeving proberen zij een (woon)omgeving te ontwerpen die een kwaliteit bezit waardoor mensen aanwezig zullen zijn." ] ;
    sgpl:thesisID 213 .

sgpl:Thesis214 a sgpl:SGPLThesis ;
    dcterms:creator "G.J.A. Meijerink" ;
    dcterms:issued 1990 ;
    dcterms:title "Bedrijfsterreinen in Oost-Nederland",
        "Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra: Zwolle Enschede-Hengelo de stedendriehoek Apeldoorn-Deventer-Zutphen Arnhem-Nijmegen" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743608,
                geonames:2756987,
                geonames:2759706 ;
            sgpl:spatialText "de stedendriehoek Apeldoorn-Deventer-Zutphen" ;
            sgpl:text_context "Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra Zwolle, Enschede-Hengelo, de stedendriehoek Apeldoorn-Deventer-Zutphen en Arnhem-Nijmegen. Bedrijfsterreinen in Oost-Nederland. Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra: Zwolle Enschede-Hengelo de stedendriehoek Apeldoorn-Deventer-Zutphen Arnhem-Nijmegen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2743477 ;
            sgpl:spatialText "Zwolle" ;
            sgpl:text_context "Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra Zwolle, Enschede-Hengelo, de stedendriehoek Apeldoorn-Deventer-Zutphen en Arnhem-Nijmegen. Bedrijfsterreinen in Oost-Nederland. Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra: Zwolle Enschede-Hengelo de stedendriehoek Apeldoorn-Deventer-Zutphen Arnhem-Nijmegen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750053,
                geonames:2759661 ;
            sgpl:spatialText "Arnhem-Nijmegen" ;
            sgpl:text_context "Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra Zwolle, Enschede-Hengelo, de stedendriehoek Apeldoorn-Deventer-Zutphen en Arnhem-Nijmegen. Bedrijfsterreinen in Oost-Nederland. Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra: Zwolle Enschede-Hengelo de stedendriehoek Apeldoorn-Deventer-Zutphen Arnhem-Nijmegen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Oost-Nederland" ;
            sgpl:text_context "Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra Zwolle, Enschede-Hengelo, de stedendriehoek Apeldoorn-Deventer-Zutphen en Arnhem-Nijmegen. Bedrijfsterreinen in Oost-Nederland. Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra: Zwolle Enschede-Hengelo de stedendriehoek Apeldoorn-Deventer-Zutphen Arnhem-Nijmegen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756987 ;
            sgpl:spatialText "de gemeente Deventer" ;
            sgpl:text_context "Het onderzoek is mede tot stand gekomen dankzij de medewerking van het Bureau Goudappel Coffeng (BGC) te Deventer. Voor de begeleiding van het onderzoek wil ik de heren Atzema van de Rijksuniversiteiten Van Dinteren van BGC bedanken. Mijn bijzondere waardering wil ik uitspreken aan mijn collega, de heer Venema, van de Dienst Stedelijke Ontwikkeling van de gemeente Deventer." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759705 ;
            sgpl:spatialText "de gemeente Apeldoorn" ;
            sgpl:text_context "Overzicht van de bedrijfsterreinen in de gemeente Deventer (1/1/1990). Overzicht van de bedrijfsterreinen in de gemeente Apeldoorn (1/1/1990). Overzicht van de bedrijfsterreinen in de gemeente Zutphen (1/1/1990)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754394,
                geonames:2756071 ;
            sgpl:spatialText "Enschede-Hengelo" ;
            sgpl:text_context "Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra Zwolle, Enschede-Hengelo, de stedendriehoek Apeldoorn-Deventer-Zutphen en Arnhem-Nijmegen. Bedrijfsterreinen in Oost-Nederland. Een onderzoek naar de beschikbaarheid, structuur en differentiatie van bedrijfsterreinen in de stedelijke centra: Zwolle Enschede-Hengelo de stedendriehoek Apeldoorn-Deventer-Zutphen Arnhem-Nijmegen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Provincie Gelderland" ;
            sgpl:text_context "Hiervan wil ik noemen de heer Te Poele (gemeente Deventer), de heer Van Lieshout (BGC), de heer Schoemaker, die het tekenwerk heeft verzorgd, en de heren Ellenbroek (Provincie Overijssel), Bos (O.O.M.), Viersen (PWE-Gelderland), Drewes en Lelyveld van Cingelshouck (Provincie Gelderland). Vorden, november 1990. Geert Meijerink." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "VOORWOORD. Deze scriptie is geschreven ter afronding van de studie Sociale Geografie aan de Rijksuniversiteit te Utrecht. Het is een verslag van het leeronderzoek dat ik heb uitgevoerd in het kader van de specialisatie Economische Geografie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Uit onderzoek blijkt dat ondernemers bedrijfsterreinen in de eigen regio zeer belangrijk vinden (Pellenbarg 1985). Afgezien van de in 1985 gepubliceerde nota Collectieve Bedrijfsterreinen in Nederland van Bak ontbreekt recent onderzoek naar de beschikbaarheid en structuur van bedrijfsterreinen en de daarop gevestigde bedrijvigheid. In de eerste plaats bood de aanleg en exploitatie van bedrijfsterreinen in Nederland lange tijd nauwelijks risico’s." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Bedrijfsterreinen" ;
            sgpl:text_context "Voor de uitoefening van activiteiten hebben de bedrijven ruimte en faciliteiten nodig. De gemeenten zijn bevoegd locaties te bestemmen en te verkopen als bedrijfsterrein. Uit onderzoek blijkt dat ondernemers bedrijfsterreinen in de eigen regio zeer belangrijk vinden (Pellenbarg 1985)." ],
        [ sgpl:refersToConcept unesco:concept4510 ;
            sgpl:subjectText "Differentiatie" ;
            sgpl:text_context "In deze studie over de aanbodzijde wordt de term ‘segmentatie’ dan ook niet in deze zin gebruikt. Het beschrijven en indelen van het aanbod wordt, evenals in de marketing gebruikelijk, aangegeven met het begrip ‘differentiatie’ (Pride and Ferrell 1989). De differentiatie van bedrijfsterreinen is in korte tijd populair geworden in het ruimtelijk en economisch beleid van de overheden." ],
        [ sgpl:refersToConcept unesco:concept17185 ;
            sgpl:subjectText "Bereikbaarheidsprofiel" ;
            sgpl:text_context "In hoofdstuk 3 komt de differentiatie in het onderzoeksgebied aan de orde aan de hand van de ouderdom van de terreinen. In hoofdstuk 4 wordt de differentiatie beschreven aan de hand van het bereikbaarheidsprofiel. Tevens vindt een confrontatie plaats tussen het mobiliteitsprofiel van de bedrijven en het bereikbaarheidsprofiel van de terreinen." ],
        [ sgpl:refersToConcept unesco:concept4510 ;
            sgpl:subjectText "Differentiatie" ;
            sgpl:text_context "In deze studie over de aanbodzijde wordt de term ‘segmentatie’ dan ook niet in deze zin gebruikt. Het beschrijven en indelen van het aanbod wordt, evenals in de marketing gebruikelijk, aangegeven met het begrip ‘differentiatie’ (Pride and Ferrell 1989). De differentiatie van bedrijfsterreinen is in korte tijd populair geworden in het ruimtelijk en economisch beleid van de overheden." ],
        [ sgpl:refersToConcept unesco:concept17185 ;
            sgpl:subjectText "Bereikbaarheidsprofiel" ;
            sgpl:text_context "In hoofdstuk 3 komt de differentiatie in het onderzoeksgebied aan de orde aan de hand van de ouderdom van de terreinen. In hoofdstuk 4 wordt de differentiatie beschreven aan de hand van het bereikbaarheidsprofiel. Tevens vindt een confrontatie plaats tussen het mobiliteitsprofiel van de bedrijven en het bereikbaarheidsprofiel van de terreinen." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "Bedrijfsterreinen" ;
            sgpl:text_context "Voor de uitoefening van activiteiten hebben de bedrijven ruimte en faciliteiten nodig. De gemeenten zijn bevoegd locaties te bestemmen en te verkopen als bedrijfsterrein. Uit onderzoek blijkt dat ondernemers bedrijfsterreinen in de eigen regio zeer belangrijk vinden (Pellenbarg 1985)." ] ;
    sgpl:thesisID 214 .

sgpl:Thesis215 a sgpl:SGPLThesis ;
    dcterms:creator "S. VAN MUISWINKEL" ;
    dcterms:issued 1990 ;
    dcterms:title "EEN INVENTARISATIE VAN DE HUISVESTINGSSITUATIE, DE WOONWENSEN EN EVENTUELE KNELPUNTEN VAN ZELFSTANDIG WONENDE OUDEREN",
        "OUDEREN IN VOORBURG" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Voorburg is trouwens ouder dan Den Haag, want in de tijd van de Romeinen bouwden dezen hier hun vloot basis Forum Hadriani waarvan op het huidige ’Arentsburch1 bij opgravingen resten gevonden zijn. Het huidige Voorburg heeft in overwegende mate het karakter van een woongemeente, wat vele eeuwen daarvoor ook al het geval was, getuige de vele buitenplaatsen en kastelen die hier nog te vinden zijn. De meeste inwoners van Voorburg, die deel uit maken van de beroepsbevolking, werken in de agglomeratie Den Haag, veelal in overheidsdienst (bijvoorbeeld Centraal Bureau voor de Statistiek)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Voorburg Noord Oud" ;
            sgpl:text_context "Als we naar het percentage 55-plussers per wijk kijken dan zien we dat de wijken Centrum, Voorburg Noord Oud, Voorburg Oost en Damsigt onder het gemiddelde zitten (resp. 29%, 27%, 27% en 22%). De wijk Essesteijn scoort het hoogste: ruim 38% van deze wijk is 55 jaar of ouder. In Essesteijn zijn het vooral eengezinswoningen (veelal koop) waar de 55-plussers wonen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "s Gravenhage" ;
            sgpl:text_context "Voorburg is een ruim 40.000 inwoners tellende gemeente in de provincie Zuid-Holland. De gemeente ligt tussen 's Gravenhage Leidschendam en Rijswijk in. Als gevolg van de ruimtelijke problemen van het aangrenzende 's Gravenhage is in 1956 een sterke groei van Voorburg begonnen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Voorburg West" ;
            sgpl:text_context "In de wijken Centrum en Voorburg West bestaat echter ruim een derde deel van de groep 55-plussers uit ouderen van 75 jaar of ouder (resp. 38.5% en 32.4%). In de andere wijken is het aandeel 75-plussers veel lager. In Voorburg kan nauwelijks nog nieuwbouw gerealiseerd worden, zodat geprobeerd zal moeten worden op zodanige wijze met de bestaande woningvoorraad om te gaan dat in de behoeften van ouderen kan worden voorzien." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743856 ;
            sgpl:spatialText "Zoetermeer" ;
            sgpl:text_context "Bekijken we de gemeenten van vestiging, dan valt op dat ruim 60% binnen de agglomeratie blijft. Vooral de gemeenten Zoetermeer (trekt veel jonge gezinnen) en Den Haag zijn in trek. Al geldt wel voor Den Haag dat zich een ongeveer even grote stroom in Voorburg vestigt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748076 ;
            sgpl:spatialText "Rijswijk" ;
            sgpl:text_context "Voorburg is een ruim 40.000 inwoners tellende gemeente in de provincie Zuid-Holland. De gemeente ligt tussen 's Gravenhage Leidschendam en Rijswijk in. Als gevolg van de ruimtelijke problemen van het aangrenzende 's Gravenhage is in 1956 een sterke groei van Voorburg begonnen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743698 ;
            sgpl:spatialText "provincie Zuid-Holland" ;
            sgpl:text_context "Allereerst zal in paragraaf 2.2 een beeld gegeven worden van de gemeente Voorburg. Voorburg is een ruim 40.000 inwoners tellende gemeente in de provincie Zuid-Holland. De gemeente ligt tussen 's Gravenhage Leidschendam en Rijswijk in." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "1.1. Inleiding. De bevolking van Nederland vergrijst in toenemende mate. Dit beeft.zijn weerslag op vele maatschappelijke terreinen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756004 ;
            sgpl:spatialText "wijk Essesteijn" ;
            sgpl:text_context "Als we naar het percentage 55-plussers per wijk kijken dan zien we dat de wijken Centrum, Voorburg Noord Oud, Voorburg Oost en Damsigt onder het gemiddelde zitten (resp. 29%, 27%, 27% en 22%). De wijk Essesteijn scoort het hoogste: ruim 38% van deze wijk is 55 jaar of ouder. In Essesteijn zijn het vooral eengezinswoningen (veelal koop) waar de 55-plussers wonen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:11525041 ;
            sgpl:spatialText "wijken Centrum" ;
            sgpl:text_context "Als we naar het percentage 55-plussers per wijk kijken dan zien we dat de wijken Centrum, Voorburg Noord Oud, Voorburg Oost en Damsigt onder het gemiddelde zitten (resp. 29%, 27%, 27% en 22%). De wijk Essesteijn scoort het hoogste: ruim 38% van deze wijk is 55 jaar of ouder. In Essesteijn zijn het vooral eengezinswoningen (veelal koop) waar de 55-plussers wonen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Damsigt" ;
            sgpl:text_context "Als we naar het percentage 55-plussers per wijk kijken dan zien we dat de wijken Centrum, Voorburg Noord Oud, Voorburg Oost en Damsigt onder het gemiddelde zitten (resp. 29%, 27%, 27% en 22%). De wijk Essesteijn scoort het hoogste: ruim 38% van deze wijk is 55 jaar of ouder. In Essesteijn zijn het vooral eengezinswoningen (veelal koop) waar de 55-plussers wonen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745321 ;
            sgpl:spatialText "gemeente Voorburg" ;
            sgpl:text_context "Om antwoord te kunnen geven op de vraag hoe gemeenten iets kunnen doen op het gebied van de huisvesting voor ouderen is in dit onderzoek een Nederlandse gemeente centraal gesteld. Gekozen is voor de gemeente Voorburg. In de volgende paragraaf zal het begrip ouderen besproken worden, wie behoren tot deze groep, en wat zijn hun kenmerken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751769 ;
            sgpl:spatialText "Leidschendam" ;
            sgpl:text_context "Voorburg is een ruim 40.000 inwoners tellende gemeente in de provincie Zuid-Holland. De gemeente ligt tussen 's Gravenhage Leidschendam en Rijswijk in. Als gevolg van de ruimtelijke problemen van het aangrenzende 's Gravenhage is in 1956 een sterke groei van Voorburg begonnen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Arentsburch" ;
            sgpl:text_context "Voorburg is trouwens ouder dan Den Haag, want in de tijd van de Romeinen bouwden dezen hier hun vloot basis Forum Hadriani waarvan op het huidige ’Arentsburch1 bij opgravingen resten gevonden zijn. Het huidige Voorburg heeft in overwegende mate het karakter van een woongemeente, wat vele eeuwen daarvoor ook al het geval was, getuige de vele buitenplaatsen en kastelen die hier nog te vinden zijn. De meeste inwoners van Voorburg, die deel uit maken van de beroepsbevolking, werken in de agglomeratie Den Haag, veelal in overheidsdienst (bijvoorbeeld Centraal Bureau voor de Statistiek)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "agglomeratie Den Haag" ;
            sgpl:text_context "Het huidige Voorburg heeft in overwegende mate het karakter van een woongemeente, wat vele eeuwen daarvoor ook al het geval was, getuige de vele buitenplaatsen en kastelen die hier nog te vinden zijn. De meeste inwoners van Voorburg, die deel uit maken van de beroepsbevolking, werken in de agglomeratie Den Haag, veelal in overheidsdienst (bijvoorbeeld Centraal Bureau voor de Statistiek). Voorburg is een vergrijsde gemeente." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Het rapport \"Ouderen in Voorburg: Een inventarisatie van de huisvestingssituatie, de woonwensen en eventuele knelpunten van zelfstandig wonende ouderen\" is geschreven in het kader van de doctoraal studie Sociale Geografie bij de vakgroep Toegepaste Geografie en Planologie (G&P) aan de Rijksuniversiteit Utrecht. Het onderzoek heeft plaats gevonden van september 1989 tot november 1990. Ik hoop de gemeente Voorburg duidelijkheid te hebben verschaft omtrent de verschillende groepen ouderen en hun behoeften en knelpunten." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8242 ;
            sgpl:subjectText "Zelfstandig wonen" ;
            sgpl:text_context "Voor bepaalde bewoners zal integratie van huisvesting en zorgverlening noodzakelijk zijn. Voor andere bewoners zal juist het zelfstandig blijven wonen mogelijk zijn. Het belangrijkste uitgangspunt van het rijksbeleid met betrekking tot ouderenhuisvesting is dat ouderen zolang mogelijk zelfstandig moeten kunnen blijven wonen." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Aanleunwoningen" ;
            sgpl:text_context "Op dit moment financiert de gemeente al een en ander voor deze groep. Te denken valt aan maaltijdvoorziening, alarmering, bouw van aanleunwoningen en vervoer. Op sommige punten is dat echter niet voldoende en op andere sluit het niet helemaal aan op wat men wil." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Ouderenhuisvesting" ;
            sgpl:text_context "Voor andere bewoners zal juist het zelfstandig blijven wonen mogelijk zijn. Het belangrijkste uitgangspunt van het rijksbeleid met betrekking tot ouderenhuisvesting is dat ouderen zolang mogelijk zelfstandig moeten kunnen blijven wonen. Dit sluit aan bij de wensen van ouderen zelf." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Ouderenhuisvesting" ;
            sgpl:text_context "Voor andere bewoners zal juist het zelfstandig blijven wonen mogelijk zijn. Het belangrijkste uitgangspunt van het rijksbeleid met betrekking tot ouderenhuisvesting is dat ouderen zolang mogelijk zelfstandig moeten kunnen blijven wonen. Dit sluit aan bij de wensen van ouderen zelf." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "Aanleunwoningen" ;
            sgpl:text_context "Op dit moment financiert de gemeente al een en ander voor deze groep. Te denken valt aan maaltijdvoorziening, alarmering, bouw van aanleunwoningen en vervoer. Op sommige punten is dat echter niet voldoende en op andere sluit het niet helemaal aan op wat men wil." ],
        [ sgpl:refersToConcept unesco:concept8242 ;
            sgpl:subjectText "Zelfstandig wonen" ;
            sgpl:text_context "Voor bepaalde bewoners zal integratie van huisvesting en zorgverlening noodzakelijk zijn. Voor andere bewoners zal juist het zelfstandig blijven wonen mogelijk zijn. Het belangrijkste uitgangspunt van het rijksbeleid met betrekking tot ouderenhuisvesting is dat ouderen zolang mogelijk zelfstandig moeten kunnen blijven wonen." ] ;
    sgpl:thesisID 215 .

sgpl:Thesis216 a sgpl:SGPLThesis ;
    dcterms:creator "E.A.G. Postma" ;
    dcterms:issued 1990 ;
    dcterms:title "De zuidwaartse trek en het Nederlands bedrijfsleven",
        "STANDPLAATS NOORDRIJN-WESTFALEN/DUESSELDORF" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2951839 ;
            sgpl:spatialText "Beieren" ;
            sgpl:text_context "Verder zal met de zuidelijke deelstaten in de Bondsrepubliek Duitsland met name Beieren en Baden-Württemberg bedoeld worden (dus exclusief Hessen/Frankfurt) en met de noordelijke deelstaten met name Bremen, Hamburg, Sleeswijk-Holstein, Nedersaksen en Noordrijn-Westfalen. Wordt als eerste indicator voor de regionaal-economische ontwikkeling in de Bondsrepubliek de arbeidsmarkt in ogenschouw genomen dan valt op dat de werkgelegenheidscijfers tussen 1980 en 1985 in Beieren en Baden-Württemberg gelijk bleven of iets toenamen terwijl zij in de noordelijke deelstaten daalden met tussen de 3,4 en 4,9 procent (Hassink, 1988, p.7). Hoe groot de regionale verschillen zijn qua werkgelegenheid blijkt ook uit de ranglijst van 'Arbeitsamtsbezirken' wat betreft toe -en afname van arbeidsplaatsen over de periode 1980-1986." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2861876 ;
            sgpl:spatialText "Noordrijn-Westfalen" ;
            sgpl:text_context "In het kader van mijn studie Economische Geografie aan de Rijksuniversiteit Utrecht heb ik een onderzoek gedaan onder Nederlandse vestigingen in Noordrijn-Westfalen/Düsseldorf. Hierbij stond centraal in hoeverre de zuidwaartse trek binnen de Bondsrepubliek Duitsland en de herstrukturering en heroriëntatie binnen Noordrijn-Westfalen een rol spelen voor deze Nederlandse vestigingen. Om dit na te gaan, zijn allereerst deze ruimtelijk-economische ontwikkelingen doorgelicht aan de hand van literatuurstudie en analyse van statistische gegevens." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2843198 ;
            sgpl:spatialText "Ruhrgebied" ;
            sgpl:text_context "Wat zijn de ruimtelijke karakterstieken van Noordrijn-Westfalen ? Welke rol speelt de heroriëntatie en herstrukturering in Noordrijn-Westfalen/Ruhrgebied ? Welke positie neemt Düsseldorf binnen Noordrijn-Westfalen in ?" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2867711 ;
            sgpl:spatialText "München" ;
            sgpl:text_context "De eerste tien 'Arbeitsamtsbezirken' die de ranglijst met een relatieve toename van het aantal arbeidsplaatsen aanvoeren, zijn alle in Beieren of Baden-Württemberg te vinden. Meestal betreft het hier 'Arbeitsamtsbezirken' die rondom Stuttgart en München liggen. De toename varieert van 11,1 % in Waiblingen (in de buurt van Stuttgart) tot 6,2 % in Donauwörth (in Beieren)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2825297 ;
            sgpl:spatialText "Stuttgart" ;
            sgpl:text_context "De eerste tien 'Arbeitsamtsbezirken' die de ranglijst met een relatieve toename van het aantal arbeidsplaatsen aanvoeren, zijn alle in Beieren of Baden-Württemberg te vinden. Meestal betreft het hier 'Arbeitsamtsbezirken' die rondom Stuttgart en München liggen. De toename varieert van 11,1 % in Waiblingen (in de buurt van Stuttgart) tot 6,2 % in Donauwörth (in Beieren)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2934691 ;
            sgpl:spatialText "Duisburg" ;
            sgpl:text_context "De toename varieert van 11,1 % in Waiblingen (in de buurt van Stuttgart) tot 6,2 % in Donauwörth (in Beieren). De ranglijst van 'Arbeitsamtsbezirken' met een relatief verlies aan arbeidsplaatsen wordt aangevoerd door Duisburg (-13,0 %). Verder zijn onder de eerste tien 'Arbeitsamtsbezirken' op deze ranglijst Dortmund (-8,4 %), Gelsenkirchen (-7,8 %), Oberhausen (-7,7 %) en Bochum (-6,6 %) te vinden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2934246 ;
            sgpl:spatialText "Düsseldorf" ;
            sgpl:text_context "Wat zijn de kenmerken en is de aard van de onderzochte Nederlandse bedrijven in Düsseldorf ? Wat zijn de motieven en achtergronden van de onderzochte bedrijven om zich in de Bondsrepubliek en in het bijzonder in Noordrijn-Westfalen/Düsseldorf te vestigen ? Wat is de visie en reaktie qua vestigingspatroon van de onderzochte Nederlandse bedrijven in Noordrijn-Westfalen op de ruimtelijk-economische ontwikkelingen in zowel de zuidelijke deelstaten als in Noordrijn-Westfalen ?" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Van Nederlandse zijde wordt vaak de vrees uitgesproken voor de gevolgen hiervan. Nederland zou perifeer komen te liggen ten opzichte van de nieuwe economische kerngebieden in de Bondsrepubliek. Dit zou nadelige gevolgen kunnen hebben voor de distributiefunktie en exportfunktie van Nederland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2953481 ;
            sgpl:spatialText "Baden-Württemberg" ;
            sgpl:text_context "Verder zal met de zuidelijke deelstaten in de Bondsrepubliek Duitsland met name Beieren en Baden-Württemberg bedoeld worden (dus exclusief Hessen/Frankfurt) en met de noordelijke deelstaten met name Bremen, Hamburg, Sleeswijk-Holstein, Nedersaksen en Noordrijn-Westfalen. Wordt als eerste indicator voor de regionaal-economische ontwikkeling in de Bondsrepubliek de arbeidsmarkt in ogenschouw genomen dan valt op dat de werkgelegenheidscijfers tussen 1980 en 1985 in Beieren en Baden-Württemberg gelijk bleven of iets toenamen terwijl zij in de noordelijke deelstaten daalden met tussen de 3,4 en 4,9 procent (Hassink, 1988, p.7). Hoe groot de regionale verschillen zijn qua werkgelegenheid blijkt ook uit de ranglijst van 'Arbeitsamtsbezirken' wat betreft toe -en afname van arbeidsplaatsen over de periode 1980-1986." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Bondsrepubliek Duitsland" ;
            sgpl:text_context "Het afgelopen decennium heeft de verschuiving van het economisch zwaartepunt binnen de Bondsrepubliek Duitsland veel publiciteit gekregen. In deze periode kon een trek naar het Zuiden binnen de Bondsrepubliek geconstateerd worden. Er wordt gesproken van een 'Süd-Nord-Gefälle'." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12813 ;
            sgpl:subjectText "Süd-Nord-Gefälle" ;
            sgpl:text_context "In deze periode kon een trek naar het Zuiden binnen de Bondsrepubliek geconstateerd worden. Er wordt gesproken van een \"Süd-Nord-Gefalle\". Van Nederlandse zijde wordt vaak de vrees uitgesproken voor de gevolgen hiervan." ],
        [ sgpl:refersToConcept unesco:concept10315 ;
            sgpl:subjectText "Herstrukturering" ;
            sgpl:text_context "Het is echter de vraag in hoeverre er tegenwoordig werkelijk sprake is van een \"Süd-Nord-Gefalle\" binnen de Bondsrepubliek. Ook gezien het feit dat de heroriëntatie en herstrukturering in Noordrijn-Westfalen/Ruhrgebied eindelijk op gang lijkt te komen. Het Nederlandse bedrijfsleven is in Noordrijn-Westfalen sterk vertegenwoordigd." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Vestigingspatroon" ;
            sgpl:text_context "Tijdens het veldwerkonderzoek voor deze studie is de visie en reaktie van het Nederlandse bedrijfsleven in Noordrijn-Westfalen op de ruimtelijk-economische ontwikkelingen in zowel het Zuiden van de Bondsrepubliek als in Noordrijn-Westfalen verkend. Het vestigingspatroon van de Nederlandse bedrijven in Noordrijn-Westfalen staat hierbij centraal. De probleemstelling is derhalve als volgt geformuleerd:" ],
        [ sgpl:refersToConcept unesco:concept10315 ;
            sgpl:subjectText "Herstrukturering" ;
            sgpl:text_context "Het is echter de vraag in hoeverre er tegenwoordig werkelijk sprake is van een \"Süd-Nord-Gefalle\" binnen de Bondsrepubliek. Ook gezien het feit dat de heroriëntatie en herstrukturering in Noordrijn-Westfalen/Ruhrgebied eindelijk op gang lijkt te komen. Het Nederlandse bedrijfsleven is in Noordrijn-Westfalen sterk vertegenwoordigd." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Vestigingspatroon" ;
            sgpl:text_context "Tijdens het veldwerkonderzoek voor deze studie is de visie en reaktie van het Nederlandse bedrijfsleven in Noordrijn-Westfalen op de ruimtelijk-economische ontwikkelingen in zowel het Zuiden van de Bondsrepubliek als in Noordrijn-Westfalen verkend. Het vestigingspatroon van de Nederlandse bedrijven in Noordrijn-Westfalen staat hierbij centraal. De probleemstelling is derhalve als volgt geformuleerd:" ],
        [ sgpl:refersToConcept unesco:concept12813 ;
            sgpl:subjectText "Süd-Nord-Gefälle" ;
            sgpl:text_context "In deze periode kon een trek naar het Zuiden binnen de Bondsrepubliek geconstateerd worden. Er wordt gesproken van een \"Süd-Nord-Gefalle\". Van Nederlandse zijde wordt vaak de vrees uitgesproken voor de gevolgen hiervan." ] ;
    sgpl:thesisID 216 .

sgpl:Thesis217 a sgpl:SGPLThesis ;
    dcterms:creator "Tjitte Prins" ;
    dcterms:issued 1990 ;
    dcterms:title "DE FLEVOSPOORLIJN OPNIEUW GEWOGEN",
        "ex post evaluatie van een aanlegbeslissing" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Voor u ligt het leeronderzoek, dat de afsluiting vormt van mijn (deeltijd)studie sociale geografie aan de Rijksuniversiteit te Utrecht (R.U.U.). Dit onderzoek is, voor zover ik weet, de enige (eerste?) in zijn soort. Dit betekent dat er vaak gezocht moet worden naar een geschikte methode van onderzoek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Flevopolders" ;
            sgpl:text_context "Momenteel is het verkeers- en vervoersbeleid, mede door het uitkomen van het SW II volop in beweging, hieraan wordt in deze studie echter nauwelijks aandacht besteed. Over de aanleg van een spoorlijn naar de Flevopolders wordt al bijna net zo lang gesproken, als over de aanleg van de polders zelf. Zo vermeldt de Tweede Nota voor de Ruimtelijke Ordening uit 1966 nadrukkelijk, dat de woongebieden in de Zuidelijke IJsselmeerpolders ontsloten zouden worden door een raillijn." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750517 ;
            sgpl:spatialText "Naardermeer" ;
            sgpl:text_context "Echter van de zijde van natuur- en milieubescherming werden grote bezwaren ingebracht tegen het gekozen tracé op het oude land. Vervolgens werden alternatieve tracé's ontwikkeld, die het natuurgebied het Naardermeer op grotere afstand passeerden dan oorspronkelijk gekozen tracé. Na analyse, overleg en advisering van en over de varianten stelde de Minister van V & W het oorspronkelijke tracé wederom vast in juni 1980, zij het dat dit tracé 500 meter in westelijke richting werd verschoven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6544259 ;
            sgpl:spatialText "Almere" ;
            sgpl:text_context "Bij de concrete invulling van de woongebieden in het oostelijk gedeelte van de polders, vastgesteld in 1968, werd uitgegaan van de raillijn, waar toen nog geen besluit over was genomen. In 1971 werden er ambtelijke adviezen uitgebracht, waarin voorgesteld werd om naast Lelystad nog een stad -het meerkernige Almere- aan te leggen, die in het jaar 2000 tussen de 125.000 en 200.000 inwoners zou hebben. In de Nota Volkshuisvesting uit 1972 stelt de regering de geplande omvang van Almere vast op minimaal 100.000 en maximaal 200.000 inwoners." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744904 ;
            sgpl:spatialText "Weesp" ;
            sgpl:text_context "Medewerking van de Tweede Kamer werd het oorspronkelijke tracé gewijzigd in het zogenaamde badkuiptracé, dat de Oostvaardersplassen minder zou belasten. De opening van de Flevospoorlijn vond plaats op 29 mei 1987 voor het gedeelte Weesp-Almere en 1 juni 1988 voor het resterende gedeelte Almere-Lelystad. De opening van de spoorlijn heeft nogal ingrijpende gevolgen gehad voor de busontsluiting van Almere en Lelystad: het aantal buslijnen en de frequentie werd aanzienlijk teruggebracht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3319179 ;
            sgpl:spatialText "provincie Flevoland" ;
            sgpl:text_context "Ter voorbereiding van de aanleg-beslissing had aan het maken van een echte raming meer aandacht besteed moeten worden. De actuele raming van de provincie Flevoland voor het jaar 1994 komt voor zowel Lelystad als Almere bijna de helft lager uit dan de oorspronkelijke raming. Gezien bovenstaande moet wellicht niet teveel waarde worden gehecht aan de raming van 1994, dit doet nog vrezen dat het aantal inwoners nog lager uit kan vallen dan geraamd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751738 ;
            sgpl:spatialText "Lelystad" ;
            sgpl:text_context "Bij de concrete invulling van de woongebieden in het oostelijk gedeelte van de polders, vastgesteld in 1968, werd uitgegaan van de raillijn, waar toen nog geen besluit over was genomen. In 1971 werden er ambtelijke adviezen uitgebracht, waarin voorgesteld werd om naast Lelystad nog een stad -het meerkernige Almere- aan te leggen, die in het jaar 2000 tussen de 125.000 en 200.000 inwoners zou hebben. In de Nota Volkshuisvesting uit 1972 stelt de regering de geplande omvang van Almere vast op minimaal 100.000 en maximaal 200.000 inwoners." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754952 ;
            sgpl:spatialText "Hakkelaarsbrug" ;
            sgpl:text_context "De doelstelling van het zoveel mogelijk voldoen aan de eisen van woon- en leefmilieu is vaag geformuleerd en omvat de aspecten luchtverontreinigende stoffen, geluidhinder en visuele hinder, die allen een andere benadering behoeven. In Muiden, Hakkelaarsbrug in het kader van de tracé-vaststelling geluidsschermen geplaatst zijn. In Muiden wordt, afhankelijk van de windrichting, wel eens (minimaal) geklaagd over geluidhinder." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "In 1971 werden er ambtelijke adviezen uitgebracht, waarin voorgesteld werd om naast Lelystad nog een stad -het meerkernige Almere- aan te leggen, die in het jaar 2000 tussen de 125.000 en 200.000 inwoners zou hebben. Specifiek m.b.t. de Flevospoorlijn in stelt het SW I, dat aanleg noodzakelijk is i.v.m. de verstedelijkingstaakstelling van Almere en Lelystad in relatie tot Amsterdam (deel d (1979) en e (1981) , blz. 14). Voorts stelt het SW I dat: schade aan landbouw, het natuurlijk milieu en het landschap dient zoveel mogelijk te worden vermeden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750569 ;
            sgpl:spatialText "gemeente Muiden" ;
            sgpl:text_context "Ten tijde van de tracévaststellingsprocedure is dit onderwerp m.n. door de gemeente Muiden aan de orde gesteld. Er zal d.m.v. interviews onderzocht worden of er naar de mening van de betrokken gemeentelijke overheden in Muiden en Weesp afdoende maatregelen zijn genomen. Hypothese: De Flevospoorlijn veroorzaakt volgens de meest betrokken gemeenten geen geluidhinder." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Verstedelijking" ;
            sgpl:text_context "Dit kan slechts voor een deel verklaard worden door de achter blijvende inwoneraantallen; - de verstedelijking, aangezien de uitgangspunten op dit punt al korte tijd na het nemen van de aanlegbeslissing, niet worden gehaald. Hier is duidelijk gewerkt met ondeugdelijke ramingen." ],
        [ sgpl:refersToConcept unesco:concept10498 ;
            sgpl:subjectText "Ex post evaluatie" ;
            sgpl:text_context "Ook wordt nagegaan welk beeld er van de relevante effecten ten tijde van de aanlegbeslissing is gegeven en hoe deze effecten achteraf zijn uitgevallen. Het doel van deze ex post evaluatie is: Te achterhalen of de aanvankelijk gestelde doelen en gebruikte argumenten, die de basis vormden voor de beslissing tot de aanleg van Flevospoorlijn, na ingebruikname vervuld danwel geldig zijn. Hoofdstuk 2: BESCHRIJVING EN ANALYSE." ],
        [ sgpl:refersToConcept unesco:concept631 ;
            sgpl:subjectText "Flevospoorlijn" ;
            sgpl:text_context "Bovengenoemde evaluaties blijven echter beperkt in aantal en ook beperkt tot enkele in het oog springende items. In deze studie zal de aanleg van de Flevospoorlijn onderzocht worden. Waarom de Flevospoorlijn als onderzoeksobject?" ],
        [ sgpl:refersToConcept unesco:concept631 ;
            sgpl:subjectText "Flevospoorlijn" ;
            sgpl:text_context "Bovengenoemde evaluaties blijven echter beperkt in aantal en ook beperkt tot enkele in het oog springende items. In deze studie zal de aanleg van de Flevospoorlijn onderzocht worden. Waarom de Flevospoorlijn als onderzoeksobject?" ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Verstedelijking" ;
            sgpl:text_context "Dit kan slechts voor een deel verklaard worden door de achter blijvende inwoneraantallen; - de verstedelijking, aangezien de uitgangspunten op dit punt al korte tijd na het nemen van de aanlegbeslissing, niet worden gehaald. Hier is duidelijk gewerkt met ondeugdelijke ramingen." ],
        [ sgpl:refersToConcept unesco:concept10498 ;
            sgpl:subjectText "Ex post evaluatie" ;
            sgpl:text_context "Ook wordt nagegaan welk beeld er van de relevante effecten ten tijde van de aanlegbeslissing is gegeven en hoe deze effecten achteraf zijn uitgevallen. Het doel van deze ex post evaluatie is: Te achterhalen of de aanvankelijk gestelde doelen en gebruikte argumenten, die de basis vormden voor de beslissing tot de aanleg van Flevospoorlijn, na ingebruikname vervuld danwel geldig zijn. Hoofdstuk 2: BESCHRIJVING EN ANALYSE." ] ;
    sgpl:thesisID 217 .

sgpl:Thesis218 a sgpl:SGPLThesis ;
    dcterms:creator "J.G. Bakebrede",
        "T.W.M. v.d. Meer" ;
    dcterms:issued 1991 ;
    dcterms:title "LITERATUURSTUDIE",
        "STADSGIDS LONDON" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2635167 ;
            sgpl:spatialText "Groot-Brittannië" ;
            sgpl:text_context "Dat 'Londinium' in de derde eeuw nog steeds de provincie- hoofdstad was en financieel centrum voor heel Groot-Brittannië is gebleken uit opgravingen. In de tweede helft van de derde eeuw werd zelfs een munt gevestigd in de stad. De stadsbevolking was nogal cosmopolitisch van samenstelling." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "City of Westminster" ;
            sgpl:text_context "In hoofdstuk IV, 'Van twee kernen tot een stad', worden de ontwikkelingen in de periode van ±1550 tot ±1850 beschreven. In enkele duidelijk te onderscheiden bouwgolven worden de beide kernen Westminster en de City of London aan elkaar vast gebouwd. De bijzondere grondbezitsverhoudingen en het imperialisme hebben een onmiskenbare invloed op de ruimtelijke structuur." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Mayfair" ;
            sgpl:text_context "De handel op Rusland en de Baltische staten werd bijvoorbeeld geregeld in 'The Baltic'. De bouwgolf uitte zich in de periode 1713-1740 op vier grote landgoederen in (het huiaige) hayfair en even ten noorden van Oxford Street. Hieruit resulteerden onder andere Burlington Gardens, en de Hanover, Berkeley, Grosvenor en Cavendish Squares (zie ook afb. 4.3 p.32)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "London" ;
            sgpl:text_context "Dit is ons werkdocument vervaardigd ten behoeve van ons doctoraal leeronderzoek GE met de werktitel Stadsgids London. Het doel van dit werkdocument is om aan de hand van secundaire bronnenstudie een verklaring te vinden voor de huidige verschijningsvorm van de Central Area van London. Reeds tijdens de eerste bespreking over ons leeronderzoek, met Dr. J.Verduin, is afgesproken dat we het onderwerp van de stadsgids zouden beperken tot da Central Area." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "West End" ;
            sgpl:text_context "De winkeliers trokken steeds meer naar het West End, vooral vanwege de aanwezigheid van goede vervoers- mogelijkheden. West End, van oudsher het gebied niet uitgeproken woon-, uitgaans- en seizoensgebonden handelsfuncties, kon zich zo ontwikkelen tot een zóne met een steeds duidelijker winkel- en uitgaansfunctie, waarbij de uitgaans- functie zich concentreerde in en rond Soho en Covent Garden. De City zelf werd door de suburbane ontwikkelingen en depopu- latie meer en meer een financieel en commercieel centrum." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2652222 ;
            sgpl:spatialText "Covent Garden" ;
            sgpl:text_context "Charles I had vastomlijnde en autocratische ideeën omtrent architectuur en de ruimtelijke orde van London. Door fikse tegenwerking werd er weinig van de ideeën van de commissie gerealiseerd, behalve in een nu welbekende buurt, Covent Garden en rond Lincoln's Inn. De grond waarop in de periode 1630-1640 Covent Garden werd ontwikkeld behoorde tot de Bedford Estate." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "Central Area" ;
            sgpl:text_context "Het doel van dit werkdocument is om aan de hand van secundaire bronnenstudie een verklaring te vinden voor de huidige verschijningsvorm van de Central Area van London. Reeds tijdens de eerste bespreking over ons leeronderzoek, met Dr. J.Verduin, is afgesproken dat we het onderwerp van de stadsgids zouden beperken tot da Central Area. Een praktische reden daarvoor is de omvang van de stad als geheel en dus de omvang van de literatuurstudie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6545247 ;
            sgpl:spatialText "Belgravia" ;
            sgpl:text_context "Na 1821, na de conversie van Buckingham House in een paleis, werd het aantrekkelijk de Grosvenor Estate ten zuidwesten daarvan te ontwikkelen. Het deftige Belgravia werd aangelegd rond de Belgrave en Eaton Squares, onder leiding van de aannemer/architect Cubitt. Dok in Belgravia werden weer buurteenheden ontwikkeld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6545173 ;
            sgpl:spatialText "Soho" ;
            sgpl:text_context "De winkeliers trokken steeds meer naar het West End, vooral vanwege de aanwezigheid van goede vervoers- mogelijkheden. West End, van oudsher het gebied niet uitgeproken woon-, uitgaans- en seizoensgebonden handelsfuncties, kon zich zo ontwikkelen tot een zóne met een steeds duidelijker winkel- en uitgaansfunctie, waarbij de uitgaans- functie zich concentreerde in en rond Soho en Covent Garden. De City zelf werd door de suburbane ontwikkelingen en depopu- latie meer en meer een financieel en commercieel centrum." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6545249 ;
            sgpl:spatialText "Pimlico" ;
            sgpl:text_context "Na Belgravia werd het zuidelijke deel van de Grosvenor Estate ontwikkeld tot de wat minder luxueuze wijk Pimlico met huizen voor de middenklassen die zich toch wilden spiegelen aan de hogere klassen in Belgravia. Kenmerkend voor Pimlico zijn de lange straten met eenvormige, meestal wit gepleisterde huizen die ieder zijn voorzien van een portiek met pilaren om wat meer aanzien te geven, met daarnaast natuurlijk de vele squares en mews. De straten liggen bijna allemaal in een hoek van 45 graden ten opzichte van de rivier." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "City of London" ;
            sgpl:text_context "In hoofdstuk IV, 'Van twee kernen tot een stad', worden de ontwikkelingen in de periode van ±1550 tot ±1850 beschreven. In enkele duidelijk te onderscheiden bouwgolven worden de beide kernen Westminster en de City of London aan elkaar vast gebouwd. De bijzondere grondbezitsverhoudingen en het imperialisme hebben een onmiskenbare invloed op de ruimtelijke structuur." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10989 ;
            sgpl:subjectText "Functieverandering" ;
            sgpl:text_context "Op vele plekken in en net buiten de Central Area is sprake van functieveranderingen tegelijk met of door ingrijpende veranderingen in de fysiek-ruimtelijke structuur. In andere buurten is sprake van sluipende functieverandering ondanks, vaak felle, strijd om behoud van \"de buurt\". Voorzover mogelijk zijn de literatuurverwijzingen per alinea gebundeld in één noot." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Scattered city" ;
            sgpl:text_context "In de Middeleeuwen (hoofdstuk III) vond er een ruimtelijke uitsortering van activiteiten plaats in London, terwijl als bestaans- en groeifactor de politiek-strategische ging overheersen. Tevens werd de aanzet gegeven tot de zo kenmerkende ontwikkeling van London tot \"scattered city\". In hoofdstuk IV, \"Van twee kernen tot een stad\", worden de ontwikkelingen in de periode van ±1550 tot ±1850 beschreven." ],
        [ sgpl:refersToConcept unesco:concept11415 ;
            sgpl:subjectText "Fysische geografie" ;
            sgpl:text_context "Vanwege het aanvankelijke belang van de site kenmerken geven we eerst een beknopt overzicht van da fysische geografie van London en omgeving (hoofdstuk I). In de rest van het werkdocument is de fysische geografie ondergeschikt aan de sociale geografie van London en omgeving, omdat de bewoners van London de verdere ruimtelijke ontwikkeling van de stad hebben bepaald door gebruik te maken van de ruimte zoals zij die zagen. In de Romeinse tijd (hoofdstuk II) werd London gesticht uit militair-strategische overwegingen." ],
        [ sgpl:refersToConcept unesco:concept11415 ;
            sgpl:subjectText "Fysische geografie" ;
            sgpl:text_context "Vanwege het aanvankelijke belang van de site kenmerken geven we eerst een beknopt overzicht van da fysische geografie van London en omgeving (hoofdstuk I). In de rest van het werkdocument is de fysische geografie ondergeschikt aan de sociale geografie van London en omgeving, omdat de bewoners van London de verdere ruimtelijke ontwikkeling van de stad hebben bepaald door gebruik te maken van de ruimte zoals zij die zagen. In de Romeinse tijd (hoofdstuk II) werd London gesticht uit militair-strategische overwegingen." ],
        [ sgpl:refersToConcept unesco:concept447 ;
            sgpl:subjectText "Scattered city" ;
            sgpl:text_context "In de Middeleeuwen (hoofdstuk III) vond er een ruimtelijke uitsortering van activiteiten plaats in London, terwijl als bestaans- en groeifactor de politiek-strategische ging overheersen. Tevens werd de aanzet gegeven tot de zo kenmerkende ontwikkeling van London tot \"scattered city\". In hoofdstuk IV, \"Van twee kernen tot een stad\", worden de ontwikkelingen in de periode van ±1550 tot ±1850 beschreven." ],
        [ sgpl:refersToConcept unesco:concept10989 ;
            sgpl:subjectText "Functieverandering" ;
            sgpl:text_context "Op vele plekken in en net buiten de Central Area is sprake van functieveranderingen tegelijk met of door ingrijpende veranderingen in de fysiek-ruimtelijke structuur. In andere buurten is sprake van sluipende functieverandering ondanks, vaak felle, strijd om behoud van \"de buurt\". Voorzover mogelijk zijn de literatuurverwijzingen per alinea gebundeld in één noot." ] ;
    sgpl:thesisID 218 .

sgpl:Thesis219 a sgpl:SGPLThesis ;
    dcterms:creator "Christel Welhuis",
        "Elvira Engels",
        "Helma Boon" ;
    dcterms:issued 1991 ;
    dcterms:title "DE ROTTERDAMSE HAVEN: GOEDERENSTROMEN EN KNELPUNTEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279858 ;
            sgpl:spatialText "Rijnmond" ;
            sgpl:text_context "Problemen in de infrastructuur, de suprastructuur en in de organisatie van de verschillende inlandtransportvormen zijn hier debet aan. Niet alleen voor Rijnmond maar ook voor onze nationale economie is het van belang dat deze problemen opgelost worden. Regelmatig inventariseren van huidige knelpunten, vroegtijdig signaleren van nieuwe knelpunten en bekijken of het beleid voldoende oplossingen voor de knelpunten aandraagt, kan de positie van Rijnmond veiligstellen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751280 ;
            sgpl:spatialText "Maasvlakte" ;
            sgpl:text_context "Voor de toekomst worden er vooral problemen verwacht in het containervervoer. Met name de toegankelijkheid van de Maasvlakte kan voor alle drie de modaliteiten tekortschieten. Immers de belangrijkste ontwikkelingen in de containersector zijn juist hier gepland." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279858 ;
            sgpl:spatialText "het Rijnmondgebied" ;
            sgpl:text_context "N.B. Waar in dit verslag de Rotterdamse haven of Rotterdam wordt genoemd, wordt het gehele Rijnmondgebied, inclusief de Maasvlakte, bedoeld (tenzij anders vermeld). Onder het Rijnmondgebied vallen de volgende havens/gemeenten: Albrandswaard, Barendrecht, Bernisse, Brielle, Capelle a/d IJssel, Hellevoetsluis, Krimpen a/d IJssel, Maassluis, Rozenburg, Ridderkerk, Rotterdam, Westvoorne, Schiedam, Spijkenisse en Vlaardingen (zie ook begrippenlijst achterin in dit verslag). In bovenstaande zijn de problemen van het Rijnmondgebied al enigszins naar voren gekomen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748647 ;
            sgpl:spatialText "Pernis" ;
            sgpl:text_context "Tevens behoort de ontsluiting van de wijk Pernis tot dit project. Deze wijk is namelijk heel slecht bereikbaar en de bewoners ondervinden veel last van de opstoppingen in het havengebied. Tijdens de interviews hebben wij de betreffende instanties en bedrijven de vraag voorgelegd of het ontsluitingsproject voldoende oplossing zal bieden om een redelijke bereikbaarheid van de Eem- en Waalhaven in de toekomst te kunnen garanderen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745128,
                geonames:2756397 ;
            sgpl:spatialText "Eem-/Waalhavengebied" ;
            sgpl:text_context "Relatief gezien nemen alleen de aandelen van de binnenvaart en het spoorvervoer toe. De te verwachten explosieve groei in containers zal ertoe leiden dat bepaalde havens, zoals het Eem-/Waalhavengebied en de Maasvlakte (zie bijlage 1 en 2), vervoers- en verkeersintensiever worden. Het is van essentieel belang dat knelpunten binnen en buiten deze havens opgelost worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het antwoord op deze vraag is bepalend voor de (toekomstige) positie van Rotterdam als mainport van Europa. Een belangrijk hoofdpunt in het beleid van de Rijksoverheid is het behoud en de versterking van Nederland als transport- en distributieland. De nadruk ligt hierbij op de achterlandverbindingen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "West-Duitsland" ;
            sgpl:text_context "De belangrijkste internationale goederenstromen richten zich op België en Luxemburg, West-Duitsland en Frankrijk (België en Luxemburg worden in de statistieken samengevoegd). Het aandeel van deze landen in de aanvoer is respectievelijk 12%, 54% en 14%. De afvoer toont een zelfde beeld met aandelen van respectievelijk 15%, 45% en 14% (zie bijlage 4, tabel 2)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Kunnen de knelpunten worden opgelost? Het antwoord op deze vraag is bepalend voor de (toekomstige) positie van Rotterdam als mainport van Europa. Een belangrijk hoofdpunt in het beleid van de Rijksoverheid is het behoud en de versterking van Nederland als transport- en distributieland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Voor u ligt de scriptie van ons afstudeeronderzoek Economische Geografie aan de Rijksuniversiteit Utrecht. Vele uren werk hebben bijgedragen tot dit uiteindelijke resultaat. Terugkijkend op de beginperiode van ons onderzoek in september, kunnen wij zeggen dat we enorm veel geleerd hebben over goederenvervoer, de haven van Rotterdam en haar plus- en minpunten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "de haven van Rotterdam" ;
            sgpl:text_context "Vele uren werk hebben bijgedragen tot dit uiteindelijke resultaat. Terugkijkend op de beginperiode van ons onderzoek in september, kunnen wij zeggen dat we enorm veel geleerd hebben over goederenvervoer, de haven van Rotterdam en haar plus- en minpunten. De colleges vervoerseconomie hebben hier zeker toe bijgedragen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4582 ;
            sgpl:subjectText "Inlandtransport" ;
            sgpl:text_context "De haven van Rotterdam vervult een belangrijke doorvoerfunctie voor het Westeuropese achterland. Voor het inlandtransport (het vervoer via weg, binnenvaart en spoor) is de afvoer vanaf de haven naar het achterland qua volume veel omvangrijker dan de aanvoer vanuit dit achterland. In de beschrijving van de goederenstromen van en naar het Rijnmondgebied is een onderscheid gemaakt naar binnenlands en internationaal vervoer." ],
        [ sgpl:refersToConcept unesco:concept656 ;
            sgpl:subjectText "Infrastructuur" ;
            sgpl:text_context "Regelmatig inventariseren van huidige knelpunten, vroegtijdig signaleren van nieuwe knelpunten en bekijken of het beleid voldoende oplossingen voor de knelpunten aandraagt, kan de positie van Rijnmond veiligstellen. Welke knelpunten (in de infrastructuur) treden er op in het Rijnmondgebied als gevolg van de omvangrijke goederenstromen over land, via het wegvervoer, het spoorvervoer en de binnenvaart, van en naar dit gebied? In welke mate wordt door het verkeers- en vervoersbeleid (waaronder het Structuurschema Verkeer en Vervoer II) geanticipeerd op de huidige en eventueel toekomstige knelpunten (in de infrastructuur)?" ],
        [ sgpl:refersToConcept unesco:concept6441 ;
            sgpl:subjectText "Containervervoer" ;
            sgpl:text_context "Het vervoer van containers, dat de afgelopen decennia een groot deel van het conventionele stukgoed heeft vervangen, zal blijven stijgen. Voor het vervoer van containers zal het gecombineerd vervoer van essentieel belang zijn. Hierbij worden de voordelen van de verschillende vervoersmodaliteiten gecombineerd." ],
        [ sgpl:refersToConcept unesco:concept4582 ;
            sgpl:subjectText "Inlandtransport" ;
            sgpl:text_context "De haven van Rotterdam vervult een belangrijke doorvoerfunctie voor het Westeuropese achterland. Voor het inlandtransport (het vervoer via weg, binnenvaart en spoor) is de afvoer vanaf de haven naar het achterland qua volume veel omvangrijker dan de aanvoer vanuit dit achterland. In de beschrijving van de goederenstromen van en naar het Rijnmondgebied is een onderscheid gemaakt naar binnenlands en internationaal vervoer." ],
        [ sgpl:refersToConcept unesco:concept656 ;
            sgpl:subjectText "Infrastructuur" ;
            sgpl:text_context "Regelmatig inventariseren van huidige knelpunten, vroegtijdig signaleren van nieuwe knelpunten en bekijken of het beleid voldoende oplossingen voor de knelpunten aandraagt, kan de positie van Rijnmond veiligstellen. Welke knelpunten (in de infrastructuur) treden er op in het Rijnmondgebied als gevolg van de omvangrijke goederenstromen over land, via het wegvervoer, het spoorvervoer en de binnenvaart, van en naar dit gebied? In welke mate wordt door het verkeers- en vervoersbeleid (waaronder het Structuurschema Verkeer en Vervoer II) geanticipeerd op de huidige en eventueel toekomstige knelpunten (in de infrastructuur)?" ],
        [ sgpl:refersToConcept unesco:concept6441 ;
            sgpl:subjectText "Containervervoer" ;
            sgpl:text_context "Het vervoer van containers, dat de afgelopen decennia een groot deel van het conventionele stukgoed heeft vervangen, zal blijven stijgen. Voor het vervoer van containers zal het gecombineerd vervoer van essentieel belang zijn. Hierbij worden de voordelen van de verschillende vervoersmodaliteiten gecombineerd." ] ;
    sgpl:thesisID 219 .

sgpl:Thesis22 a sgpl:SGPLThesis ;
    dcterms:creator "Phil.P.J.M. DANIELS" ;
    dcterms:issued 1956 ;
    dcterms:title "Een demografische studie.",
        "RELIGIEUZE GEZINDTE EN POLITIEKE VOORKEUR IN DE PROVINCIE OVERIJSSEL." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "noordwestelijk deel der provincie" ;
            sgpl:text_context "Er valt dan ook in 1899 een zekere koncen- tratie van buitenkerkelijkheid in het noordwestelijk deel der provincie te konstateren, naast de afzonderlijke stedelijke centra Deventer, Wijhe, Almelo, Hengelo en Enschede. Het opvallende, maar niet onverklaarbare (en hier ook zeker niet voor het eerst gesignaleerde) verschijnsel doet zich voor, dat er een korrelatie blijkt te bestaan tussen aantallen buitenkerkelijken en doopsgezinden. Giethoorn en Blokzijl zijn niet alleen de be- langrijkste koncentratiepunten der buitenkerkelijkheid in het Overijssel van 1899, zij zijn tevens met resp. 43,5 on 13,0;‘j de belangrijkste doopsgezinde centra." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755634 ;
            sgpl:spatialText "Gelders territoir" ;
            sgpl:text_context "Duidelijker nog dan deze cijfers doen toont het kaartbeeld deze vrijzinnige enclave met lage geboortecijfers gelegen in het grensgebied van Twente, Salland en de Graafschap, voornamelijk echter op Gelders territoir. Het kiesdistrikt Ommen dat voornamelijk Salland omvat: gemeenten Stad- en Ambt-Ommen, Gramsbergen, Stad- en Ambt-Hardenberg, Den Ham, Hellendoorn, Vriezenveen, Raalte en Holten - leverde 57,1% der stemmen voor de antirevolutionaire en 42,9% voor de liberale kandidaat, bij een opkomst van 81,7% der stemgerechtigden. De gereformeerden vormen in deze gemeenten ruim 20% der bevolking, de katholieken ongeveer 18,5%, de hervormden ruim 58%." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "PROVINCIE OVERIJSSEL" ;
            sgpl:text_context "RELIGIEUZE GEZINDTE EN POLITIEKE VOORKEUR IN DE PROVINCIE OVERIJSSEL. Een demografische studie. Doktoraal - skriptie door Phil.P.J.M. DANIELS." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746058 ;
            sgpl:spatialText "Twente" ;
            sgpl:text_context "Aldus krijgt men een gekorrigeerd beeld, dat Twente toont met een absolute meerderheid aan katholieken, waarbinnen slechts Enschede met 37 en hot omringende Lonnekor met 31,9% (tesamen de huidige gemeente Enschede uitmakend) een enclave vorrnenv. Bij dit katholieke gebied sluit, althans tot op zekere hoogte, het oude stadje Goor aan dat, hoewel reeds in 1597 van Spaans Staats geworden, toch nog ruim 25% katholieken tolt ). Meer westwaarts vindt men dan in centraal Salland een aantal gemeenten met tussen de 25 en 50$ katholieken: .Vierden, Hellen-doorn, Raalte (67,6$), Diepenveen, Heino en Dalfsen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Oversticht" ;
            sgpl:text_context "Deze studie wil, dankbaar gebruikmakend van de gegeven Nederlandse situatie, een poging doen langs demografische weg met behulp van overwegend statistische gegevens 1) door te dringen in de Overijsselse samenlevingsvormen, om aldus een bijdrage te leveren tot een beter inzicht in de individualiteit van het menselijk groepsbestaan binnen het oude Oversticht. Hoofdstuk I. De samenhang der religieuze gezindten en politieke partijen in Nederland. Wil men de samenhang tussen religieuze gezindte en politieke keuze in Nederland nagaan, dan stuit men onmiddellijk op het welbe-kende demografische probleem - sinds Kruyts dissertatie horhaalde- - lijk -." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Hoofdstuk I. De samenhang der religieuze gezindten en politieke partijen in Nederland. Hoofdstuk II. De negentiende eeuw.  1. 1059 7." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747775 ;
            sgpl:spatialText "Salland" ;
            sgpl:text_context "Bij dit katholieke gebied sluit, althans tot op zekere hoogte, het oude stadje Goor aan dat, hoewel reeds in 1597 van Spaans Staats geworden, toch nog ruim 25% katholieken tolt ). Lieer westwaarts vindt men dan in centraal Salland een aantal gemeenten met tussen de 25 en 50$ katholieken: .Vierden, Hellendoorn, Raalte (67,6$), Diepenveen, Heino en Dalfsen. Nog weste- lijken uiteindelijk treft men de handelsgeografische factor van de IJssel aan in gemeenten met een belangrijk katholiek volksdeel (20-35$): Deventer, Olst, V/ijhe, Zwollerlcerspel, Zwolle en IJsselmuiden (laatstgenoemde gemeente in her oorspronkelijke gedaante van voor 1937)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "de kop van Overijssel" ;
            sgpl:text_context "De immigranten die in Losser deze belangrijke verschuiving teweeg hebben gebracht werkten weliswaar in de Duitse textielfabrieken in en om Gronau, - maar het waren desondanks Nederlanders, voor een goed deel afkomstig uit de kop van Overijssel on het Friese veengebied, die zich in de onmiddellijke nabijheid der fabfieken, maar aan de Nederlandse zijde van de grens vestigden 5). Aldus wordt verklaard dat de gemeente Losser tussen de volkstellingen van 1889 en 1899 met ruim 2.500 zielen toeneemt, waarbij hot percentage der katholieken daalt van 91,3 tot 78,8, dat der hervormden echter stijgt van 7,6 tot 20,0. Overigens behoeft Ramaers samenvatting ook verder enige aanvulling,,." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749644 ;
            sgpl:spatialText "Oldenzaal" ;
            sgpl:text_context "Ramaer geeft er in zijn op dit gebied in Nederland baanbrekende studie 2) Ret volgende beeld van: ’Ih Overijsel zijn het de stadjes Oldenzaal en Ootmarsum, tot 1626 door de Spanjaarden bezet, met hunne omstreken, v/aar de meeste roomsch-katholieken wonen. De gemeenten, waar de katholieken de meerderheid hebben, zijn bovendien: ’.’/eerselo, Tubbergen, Denekamp, Losser, Borne, Haaksbergen, Stad en Ambt Delden. Verder is er een gedeelte met veel katholieken, met het middelpunt Raalte, in welke gemeente zelfs de meerderheid roomsch is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756071 ;
            sgpl:spatialText "huidige gemeente Enschede" ;
            sgpl:text_context "Aldus krijgt men een gekorrigeerd beeld, dat Twente toont met een absolute meerderheid aan katholieken, waarbinnen slechts Enschede met 37 en hot omringende Lonnekor met 31,9% (tesamen de huidige gemeente Enschede uitmakend) een enclave vorrnenv. Bij dit katholieke gebied sluit, althans tot op zekere hoogte, het oude stadje Goor aan dat, hoewel reeds in 1597 van Spaans Staats geworden, toch nog ruim 25% katholieken tolt ). Meer westwaarts vindt men dan in centraal Salland een aantal gemeenten met tussen de 25 en 50$ katholieken: .Vierden, Hellen-doorn, Raalte (67,6$), Diepenveen, Heino en Dalfsen." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5171 ;
            sgpl:subjectText "Religieuze gezindte" ;
            sgpl:text_context "Een der kerngegevens, maar tegelijkertijd een der moeilijkst hanteerbare - want hoe zal men de betekenis, d.w.z. de intensiteit der religieuze beleving, die de individualiteit van het groepsleven naar inhoud en verschijning in zo belangrijke mate mede bepaalt, uit de registreerbare, dus vrijwel uitsluitend kwantitatieve gegevens aflezen? Bij de opzet van een demografische studie mag men het daarom een gelukkige omstandigheid noemen, dat in Nederland religieuze gezindte en politieke voorkeur (nog) zo’n sterke samenhang vertonen. De telkens weerkerende verkiezingen en de doorwerking van hun uitslag in het landelijk, provinciaal en gemeentelijk beleid dwingen de staatsburger immers keer op keer tot een positie kiezen, althans tot een uitspraak, waartegenover de bij de tienjaarlijkse volkstelling verstrekte gegevens voor hem zonder politieke konsekwenties blijven." ],
        [ sgpl:refersToConcept unesco:concept5955 ;
            sgpl:subjectText "Politieke voorkeur" ;
            sgpl:text_context "Bij de opzet van een demografische studie mag men het daarom een gelukkige omstandigheid noemen, dat in Nederland religieuze gezindte en politieke voorkeur (nog) zo’n sterke samenhang vertonen. Door deze veelvuldige samenhang van politieke voorkeur met religieuze gezindte worden de demograaf nu echter korrelaties mogelijk gemaakt die, a.h.w. spiraalsgewijze, omcirkelend, een dichtere benadering van het religieuze moment mogelijk maken dan anders het geval zou zijn. Deze studie wil, dankbaar gebruikmakend van de gegeven Nederlandse situatie, een poging doen langs demografische weg met behulp van overwegend statistische gegevens door te dringen in de Overijsselse samenlevingsvormen, om aldus een bijdrage te leveren tot een beter inzicht in de individualiteit van het menselijk groepsbestaan binnen het oude Oversticht." ],
        [ sgpl:refersToConcept unesco:concept4110 ;
            sgpl:subjectText "Geboortefrequentie" ;
            sgpl:text_context "Naar huwelijksvruchtbaarheid vertoont het distrikt met een geboortefrekwentie van 140 à 165 (voor het Overijsselse deel alleen: idem) lagere cijfers dan de beide voorgaande en in feite de laagste van heel de provincie. Het minimum ligt hier in de gemeente Diepenheim (87,5% hervormden) met een waarde van 100 à 125. Onmiddellijk daarboven, met een frekwentie van 125 à 150, liggen Markelo (92,1% hervormden) en Goor (69,9% hervormden en 22,8% r.-k.) en in het Gelderse nog Lochem, Laren, Borculo, Neede en Ruurlo." ],
        [ sgpl:refersToConcept unesco:concept5955 ;
            sgpl:subjectText "Politieke voorkeur" ;
            sgpl:text_context "Bij de opzet van een demografische studie mag men het daarom een gelukkige omstandigheid noemen, dat in Nederland religieuze gezindte en politieke voorkeur (nog) zo’n sterke samenhang vertonen. Door deze veelvuldige samenhang van politieke voorkeur met religieuze gezindte worden de demograaf nu echter korrelaties mogelijk gemaakt die, a.h.w. spiraalsgewijze, omcirkelend, een dichtere benadering van het religieuze moment mogelijk maken dan anders het geval zou zijn. Deze studie wil, dankbaar gebruikmakend van de gegeven Nederlandse situatie, een poging doen langs demografische weg met behulp van overwegend statistische gegevens door te dringen in de Overijsselse samenlevingsvormen, om aldus een bijdrage te leveren tot een beter inzicht in de individualiteit van het menselijk groepsbestaan binnen het oude Oversticht." ],
        [ sgpl:refersToConcept unesco:concept4110 ;
            sgpl:subjectText "Geboortefrequentie" ;
            sgpl:text_context "Naar huwelijksvruchtbaarheid vertoont het distrikt met een geboortefrekwentie van 140 à 165 (voor het Overijsselse deel alleen: idem) lagere cijfers dan de beide voorgaande en in feite de laagste van heel de provincie. Het minimum ligt hier in de gemeente Diepenheim (87,5% hervormden) met een waarde van 100 à 125. Onmiddellijk daarboven, met een frekwentie van 125 à 150, liggen Markelo (92,1% hervormden) en Goor (69,9% hervormden en 22,8% r.-k.) en in het Gelderse nog Lochem, Laren, Borculo, Neede en Ruurlo." ],
        [ sgpl:refersToConcept unesco:concept5171 ;
            sgpl:subjectText "Religieuze gezindte" ;
            sgpl:text_context "Een der kerngegevens, maar tegelijkertijd een der moeilijkst hanteerbare - want hoe zal men de betekenis, d.w.z. de intensiteit der religieuze beleving, die de individualiteit van het groepsleven naar inhoud en verschijning in zo belangrijke mate mede bepaalt, uit de registreerbare, dus vrijwel uitsluitend kwantitatieve gegevens aflezen? Bij de opzet van een demografische studie mag men het daarom een gelukkige omstandigheid noemen, dat in Nederland religieuze gezindte en politieke voorkeur (nog) zo’n sterke samenhang vertonen. De telkens weerkerende verkiezingen en de doorwerking van hun uitslag in het landelijk, provinciaal en gemeentelijk beleid dwingen de staatsburger immers keer op keer tot een positie kiezen, althans tot een uitspraak, waartegenover de bij de tienjaarlijkse volkstelling verstrekte gegevens voor hem zonder politieke konsekwenties blijven." ] ;
    sgpl:thesisID 22 .

sgpl:Thesis220 a sgpl:SGPLThesis ;
    dcterms:creator "Ingeborg de Jong" ;
    dcterms:issued 1991 ;
    dcterms:title "ALS MARKETINGINSTRUMENT",
        "LEASING VAN KANTOORRUIMTE" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748000 ;
            sgpl:spatialText "Roermond" ;
            sgpl:text_context "Overeenkomst met het ABP (480 miljoen, rentepercentage 7.5 %) bestemd voor de bouw van Gerechtsgebouwen buiten de Randstad. Overeenkomst met PGGM (180 miljoen) ten behoeve van de belastingkantoren in Roermond en Venlo en het Gerechtshof in Den Bosch. Voor de belastingkantoren gaat het om een 15-jarig huurcontract met tussentijdse koopopties tegen vooraf vastgestelde prijzen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "de City" ;
            sgpl:text_context "In Londen echter is sprake geweest van een huurprijsstijging ondanks het feit dat er de afgelopen jaren veel kantoorruimte is bijgebouwd. In de City ligt de huur op ƒ 2.375,-/m2 bij een leegstandspercentage van 2% (niveau van de frictie leegstand). Londen vormt echter geen uitzondering." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "de Haagse departementen" ;
            sgpl:text_context "De RGD heeft inmiddels drie raam intentie-overeenkomsten gesloten. Overeenkomst in 1984 met het ABP (400 miljoen gulden, rentepercentage 8%, looptijd 30 jaar) bestemd voor de herhuisvesting van de Haagse departementen van de Ministeries van VROM en Sociale Zaken. Overeenkomst met het ABP (480 miljoen, rentepercentage 7.5 %) bestemd voor de bouw van Gerechtsgebouwen buiten de Randstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745641 ;
            sgpl:spatialText "Venlo" ;
            sgpl:text_context "Overeenkomst met het ABP (480 miljoen, rentepercentage 7.5 %) bestemd voor de bouw van Gerechtsgebouwen buiten de Randstad. Overeenkomst met PGGM (180 miljoen) ten behoeve van de belastingkantoren in Roermond en Venlo en het Gerechtshof in Den Bosch. Voor de belastingkantoren gaat het om een 15-jarig huurcontract met tussentijdse koopopties tegen vooraf vastgestelde prijzen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Verder valt op dat in andere Westeuropese landen de huurprijsverschillen tussen centrum- en perifere locaties veel groter zijn dan in Nederland het geval is. Zo heeft zich in Amsterdam de laatste jaren een geringe huurprijsstijging voorgedaan en bedraagt de huur op een goede locatie rond ƒ 365,-/m2 bij een leegstandspercentage van ongeveer 5 % van de voorraad. In Londen echter is sprake geweest van een huurprijsstijging ondanks het feit dat er de afgelopen jaren veel kantoorruimte is bijgebouwd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747351 ;
            sgpl:spatialText "Den Bosch" ;
            sgpl:text_context "Overeenkomst met het ABP (480 miljoen, rentepercentage 7.5 %) bestemd voor de bouw van Gerechtsgebouwen buiten de Randstad. Overeenkomst met PGGM (180 miljoen) ten behoeve van de belastingkantoren in Roermond en Venlo en het Gerechtshof in Den Bosch. Voor de belastingkantoren gaat om een 15-jarig huurcontract met tussentijdse koopopties tegen vooraf vastgestelde prijzen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "VERSLAGEN VAN LEERONDERZOEK G & P. )itorium II, Heidelberglaan 2, De Uithof, UTRECHT (030)532044. UBU BHZ 168." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Overeenkomst in 1984 met het ABP (400 miljoen gulden, rentepercentage 8%, looptijd 30 jaar) bestemd voor de herhuisvesting van de Haagse departementen van de Ministeries van VROM en Sociale Zaken. Overeenkomst met het ABP (480 miljoen, rentepercentage 7.5 %) bestemd voor de bouw van Gerechtsgebouwen buiten de Randstad. Overeenkomst met PGGM (180 miljoen) ten behoeve van de belastingkantoren in Roermond en Venlo en het Gerechtshof in Den Bosch." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Er is een vergelijking te trekken met de situatie op de Nederlandse kantorenmarkt. De economische groei die zich sinds 1983 in Nederland voordoet heeft op de kantorenmarkt geleid tot een toenemende vraag naar kantoorruimte. Aan deze vraag is ruimschoots tegemoet gekomen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2643743 ;
            sgpl:spatialText "Londen" ;
            sgpl:text_context "Zo heeft zich in Amsterdam de laatste jaren een geringe huurprijsstijging voorgedaan en bedraagt de huur op een goede locatie rond ƒ 365,-/m2 bij een leegstandspercentage van ongeveer 5 % van de voorraad. In Londen echter is sprake geweest van een huurprijsstijging ondanks het feit dat er de afgelopen jaren veel kantoorruimte is bijgebouwd. In de City ligt de huur op ƒ 2.375,-/m2 bij een leegstandspercentage van 2% (niveau van de frictie leegstand)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "Kantorenmarkt" ;
            sgpl:text_context "Er is een vergelijking te trekken met de situatie op de Nederlandse kantorenmarkt. De economische groei die zich sinds 1983 in Nederland voordoet heeft op de kantorenmarkt geleid tot een toenemende vraag naar kantoorruimte. Aan deze vraag is ruimschoots tegemoet gekomen." ],
        [ sgpl:refersToConcept unesco:concept11987 ;
            sgpl:subjectText "Leasing van kantoorruimte" ;
            sgpl:text_context "Dit onderzoeksdoel is nader uitgewerkt in de volgende probleemstelling; Welke partijen aan de aanbodzijde van de kantorenmarkt zijn, uitgaande van het huidige functioneren van de Nederlandse kantorenmarkt, geschikt en bereid om leasing van kantoorruimte aan te bieden? Aan de hand van deze probleemstelling is een aantal centrale vragen geformuleerd." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "Marketinginstrument" ;
            sgpl:text_context "In dit kader is het interessant om na te gaan of de aanbieders van kantoorruimte op deze behoefte kunnen en willen inspelen en - indien dit het geval is- op welke wijze ze dat het beste kunnen doen. Het doel van dit onderzoek is het bepalen door welke aktoren aan de aanbodzijde van de kantorenmarkt leasing van (nieuwbouw) kantoorruimte kan worden ingezet als marketinginstrument ter verruiming van de potentiële afzetmarkt en het vaststellen van de wijze waarop dit dan zou moeten gebeuren. Dit onderzoeksdoel is nader uitgewerkt in de volgende probleemstelling;" ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "Marketinginstrument" ;
            sgpl:text_context "In dit kader is het interessant om na te gaan of de aanbieders van kantoorruimte op deze behoefte kunnen en willen inspelen en - indien dit het geval is- op welke wijze ze dat het beste kunnen doen. Het doel van dit onderzoek is het bepalen door welke aktoren aan de aanbodzijde van de kantorenmarkt leasing van (nieuwbouw) kantoorruimte kan worden ingezet als marketinginstrument ter verruiming van de potentiële afzetmarkt en het vaststellen van de wijze waarop dit dan zou moeten gebeuren. Dit onderzoeksdoel is nader uitgewerkt in de volgende probleemstelling;" ],
        [ sgpl:refersToConcept unesco:concept524 ;
            sgpl:subjectText "Kantorenmarkt" ;
            sgpl:text_context "Er is een vergelijking te trekken met de situatie op de Nederlandse kantorenmarkt. De economische groei die zich sinds 1983 in Nederland voordoet heeft op de kantorenmarkt geleid tot een toenemende vraag naar kantoorruimte. Aan deze vraag is ruimschoots tegemoet gekomen." ],
        [ sgpl:refersToConcept unesco:concept11987 ;
            sgpl:subjectText "Leasing van kantoorruimte" ;
            sgpl:text_context "Dit onderzoeksdoel is nader uitgewerkt in de volgende probleemstelling; Welke partijen aan de aanbodzijde van de kantorenmarkt zijn, uitgaande van het huidige functioneren van de Nederlandse kantorenmarkt, geschikt en bereid om leasing van kantoorruimte aan te bieden? Aan de hand van deze probleemstelling is een aantal centrale vragen geformuleerd." ] ;
    sgpl:thesisID 220 .

sgpl:Thesis221 a sgpl:SGPLThesis ;
    dcterms:creator "Jurgen de Haan" ;
    dcterms:issued 1991 ;
    dcterms:title "G I S",
        "NAAR LEEFMILIEUKAART",
        "VAN VERKEERSMILIEUKAART" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "Tilburg" ;
            sgpl:text_context "Het vormt de afsluiting van de studie Sociale Geografie te Utrecht, die ik als vervolg op de Verkeersakademie te Tilburg heb gevolgd. In een steeds complexer wordende samenleving, waarbij milieuvervuiling en mobiliteitsgroei belangrijke problemen vormen, is een goede beleidsvoering noodzaak. Een GIS (Geografisch Informatie Systeem) kan hierbij een belangrijk hulpmiddel worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Het vormt de afsluiting van de studie Sociale Geografie te Utrecht, die ik als vervolg op de Verkeersakademie te Tilburg heb gevolgd. In een steeds complexer wordende samenleving, waarbij milieuvervuiling en mobiliteitsgroei belangrijke problemen vormen, is een goede beleidsvoering noodzaak. Een GIS (Geografisch Informatie Systeem) kan hierbij een belangrijk hulpmiddel worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Parijs" ;
            sgpl:text_context "In Parijs bleek uit onderzoek dat bij eenzelfde geluidnivo de hinderreacties beduidend minder waren in een mooie woonwijk, dan in een minder mooie buurt. Ook in een onderzoek in Amsterdam bleek een verband tussen geluidhinder en algemene tevredenheid met de woonomgeving te bestaan. Uit een onderzoek door het CBS in 1977 bleek geluidhinder van verkeer nauw samen te hangen met de urbanisatiegraad, het bouwjaar van het huis, het woningtype, de ligging van de woning en van het hoofdvertrek, de bouwtechnische kwaliteit en de satisfactie met de woonsituatie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Aan de hand van meetgegevens op tien verkeersstations in Utrecht, Amsterdam en Apeldoorn, zullen de resultaten jaarlijks worden verrekend met de van jaar tot jaar verschillende weersomstandigheden, veranderende emissies e.d. Het CAR-model kan slechts concentraties berekenen tussen 5 en 35 meter afstand van de wegas. Voor kleinere of grotere afstanden wordt dezelfde verdunningsfactor gebruikt als op 5 rep." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Bij deze wil ik dr. M. Kuypers-Linde bedanken voor haar begeleiding vanuit de Faculteit der Ruimtelijke Wetenschappen te Utrecht. Verder wil ik alle medewerkers van IRIS-int. b.v., in het bijzonder J.P. van Est, bedanken voor de begeleiding/samenwerking tijdens dit onderzoek en het beschikbaar stellen van het GIS SALADIN. Ook wil ik bij deze de medewerkers van de afdeling Verkeer (waar ik gedurende 10 maanden werkzaam was), Ruimtelijke Ordening, het Sociaal Geografisch Bureau, alsmede de coördinator van de buurtbeheergroepen en de voorzitter van de werkgroep \"Gezonde Stad\" te Dordrecht voor hun medewerking bedanken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756669 ;
            sgpl:spatialText "de binnenstad van de gemeente Dordrecht" ;
            sgpl:text_context "Dit onderzoek toont hoe een GIS bij kan dragen aan een integrale aanpak van het leefmilieu: verkeer, milieu (ook het sociale leefmilieu) en ruimtelijke ordening. Voor de binnenstad van de gemeente Dordrecht is een voorbeeld uitgewerkt. Bij deze wil ik dr. M. Kuypers-Linde bedanken voor haar begeleiding vanuit de Faculteit der Ruimtelijke Wetenschappen te Utrecht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756669 ;
            sgpl:spatialText "Dordrecht" ;
            sgpl:text_context "Eén van de gemeenten die een verkeersmilieukaart hebben is de gemeente Dordrecht. In het onderzoek is deze gemeente als voorbeeld genomen om een LMK (leefmilieukaart) te maken. Allereerst is een literatuurstudie gedaan." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2867711 ;
            sgpl:spatialText "München" ;
            sgpl:text_context "In de vorige paragraaf werd al aangehaald dat de verkeersmilieukaart een steeds belangrijker onderdeel wordt bij de verkeersplannen van een gemeente. Reeds in 1975 verscheen in München een handboek voor geluidkartering (Indicatief Studievoorstel, 1988). Ook in Nederland begon een aantal gemeenten met het vervaardigen van geluidnivokaarten (zie bijlage 3 voor de geluidnivokaart van Dordrecht)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756669 ;
            sgpl:spatialText "de oude binnenstad" ;
            sgpl:text_context "Hoewel uit de vorige paragraaf blijkt dat met de huidige bestanden nog geen goede leefmilieukaart is te maken, zal in deze paragraaf voor de oude binnenstad en de 19e Eeuwse Schil (zie kaart 03; op overige de kaarten als binnenstad aangeduid) toch een inventarisatie/analyse van het leefmilieu worden gemaakt. Op deze manier wordt getracht een beeld te geven van wat er mogelijk is als er goede bestanden gemaakt zouden worden. De volgende leefmilieukaarten zijn bij dit rapport gevoegd :" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756669 ;
            sgpl:spatialText "19e Eeuwse Schil" ;
            sgpl:text_context "Hoewel uit de vorige paragraaf blijkt dat met de huidige bestanden nog geen goede leefmilieukaart is te maken, zal in deze paragraaf voor de oude binnenstad en de 19e Eeuwse Schil (zie kaart 03; op overige de kaarten als binnenstad aangeduid) toch een inventarisatie/analyse van het leefmilieu worden gemaakt. Op deze manier wordt getracht een beeld te geven van wat er mogelijk is als er goede bestanden gemaakt zouden worden. De volgende leefmilieukaarten zijn bij dit rapport gevoegd :" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755251 ;
            sgpl:spatialText "Groningen" ;
            sgpl:text_context "In Groningen heeft men een methode opgezet om de kwaliteit van een buurt te bewaken en verval te voorkomen. Hierin hanteerd men enkele kwantitatieve indicatoren van stedelijk verval. Deze cijfers worden gerefereerd aan de landelijke cijfers." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Schil Oost" ;
            sgpl:text_context "Een meer integraal gerichte aanpak van het milieu-ruimtelijk beleid is in de milieuparagraaf van de Structuurvisie \"Schil Oost\" (1990). Deze structuurvisie gaat over het stadsdeel dat aan de oostelijke kant rond de binnenstad ligt. Eén van de vier hoofdstukken in dit rapport heet \"Milieuparagraaf\"." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Reeds in 1975 verscheen in München een handboek voor geluidkartering (Indicatief Studievoorstel, 1988). Ook in Nederland begon een aantal gemeenten met het vervaardigen van geluidnivokaarten (zie bijlage 3 voor de geluidnivokaart van Dordrecht). Uit een evaluatie van de Wet Geluidhinder bleek er voor de gemeenten geen stimulans te bestaan om geluidhinder bij de verkeersplannen te betrekken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759706 ;
            sgpl:spatialText "Apeldoorn" ;
            sgpl:text_context "Aan de hand van meetgegevens op tien verkeersstations in Utrecht, Amsterdam en Apeldoorn, zullen de resultaten jaarlijks worden verrekend met de van jaar tot jaar verschillende weersomstandigheden, veranderende emissies e.d. Het CAR-model kan slechts concentraties berekenen tussen 5 en 35 meter afstand van de wegas. Voor kleinere of grotere afstanden wordt dezelfde verdunningsfactor gebruikt als op 5 rep." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept17000 ;
            sgpl:subjectText "Geografische informatiesystemen" ;
            sgpl:text_context "Hoewel beiden afdelingen streven naar een beter leefmilieu wordt de (verschillende geografische) informatie die hierop betrekking heeft pas na de planvorming uitgewisseld. Met Geografische informatiesystemen (GIS) kunnen meerdere kaartlagen van hetzelfde gebied, maar met verschillende informatie, over elkaar worden gelegd en in één analyse worden gebruikt. Als deze eigenschap aan een VMK kan worden toegevoegd, kunnen wijzigingen in de intensiteit, en daarmee emissie van het verkeer, worden doorgerekend naar sociale- en ruimtelijke consequenties." ],
        [ sgpl:refersToConcept unesco:concept5264 ;
            sgpl:subjectText "Verkeersmilieukaart" ;
            sgpl:text_context "Wegen waar de 98-percentielwaarde boven de 15000 ug/m3 ligt moeten worden gesaneerd. Met de programmatuur kan een verkeersmilieukaart (VMK) worden gemaakt, waarvoor een gemeente per project 75% subsidie kan krijgen. In deze VMK zijn de volgende verkeerssituaties in kaart opgenomen: de huidige situatie, de toekomstige situatie bij ongewijzigd beleid, en de toekomstige situatie volgens de milieuhygiënische variant, waarbij de belasting door het verkeer (uitlaatgassen en lawaai) met een bepaalde hoeveelheid, door (verkeers-) maatregelen wordt verminderd, t.o.v. ongewijzigd beleid." ],
        [ sgpl:refersToConcept unesco:concept195 ;
            sgpl:subjectText "Leefmilieukaart" ;
            sgpl:text_context "In hoeverre kan een VMK (verkeersmilieukaart) gekoppeld worden aan een GIS (geografisch informatie systeem), en welke voordelen biedt dit? Het uiteindelijke doel van een koppeling tussen een GIS en een VMK is het integreren van verkeersmilieugegevens en andere gegevens betreffende het leefmilieu tot één \"leefmilieukaart\" (LMK). Met behulp van deze kaart kunnen verkeersplannen en bijvoorbeeld buurtbeheerplannen beter op elkaar afgestemd worden." ],
        [ sgpl:refersToConcept unesco:concept5264 ;
            sgpl:subjectText "Verkeersmilieukaart" ;
            sgpl:text_context "Wegen waar de 98-percentielwaarde boven de 15000 ug/m3 ligt moeten worden gesaneerd. Met de programmatuur kan een verkeersmilieukaart (VMK) worden gemaakt, waarvoor een gemeente per project 75% subsidie kan krijgen. In deze VMK zijn de volgende verkeerssituaties in kaart opgenomen: de huidige situatie, de toekomstige situatie bij ongewijzigd beleid, en de toekomstige situatie volgens de milieuhygiënische variant, waarbij de belasting door het verkeer (uitlaatgassen en lawaai) met een bepaalde hoeveelheid, door (verkeers-) maatregelen wordt verminderd, t.o.v. ongewijzigd beleid." ],
        [ sgpl:refersToConcept unesco:concept195 ;
            sgpl:subjectText "Leefmilieukaart" ;
            sgpl:text_context "In hoeverre kan een VMK (verkeersmilieukaart) gekoppeld worden aan een GIS (geografisch informatie systeem), en welke voordelen biedt dit? Het uiteindelijke doel van een koppeling tussen een GIS en een VMK is het integreren van verkeersmilieugegevens en andere gegevens betreffende het leefmilieu tot één \"leefmilieukaart\" (LMK). Met behulp van deze kaart kunnen verkeersplannen en bijvoorbeeld buurtbeheerplannen beter op elkaar afgestemd worden." ],
        [ sgpl:refersToConcept unesco:concept17000 ;
            sgpl:subjectText "Geografische informatiesystemen" ;
            sgpl:text_context "Hoewel beiden afdelingen streven naar een beter leefmilieu wordt de (verschillende geografische) informatie die hierop betrekking heeft pas na de planvorming uitgewisseld. Met Geografische informatiesystemen (GIS) kunnen meerdere kaartlagen van hetzelfde gebied, maar met verschillende informatie, over elkaar worden gelegd en in één analyse worden gebruikt. Als deze eigenschap aan een VMK kan worden toegevoegd, kunnen wijzigingen in de intensiteit, en daarmee emissie van het verkeer, worden doorgerekend naar sociale- en ruimtelijke consequenties." ] ;
    sgpl:thesisID 221 .

sgpl:Thesis222 a sgpl:SGPLThesis ;
    dcterms:creator "ROLAND HERMANS" ;
    dcterms:issued 1991 ;
    dcterms:title "EEN AANZET TOT EEN INDELING IN WOONMILIEUS VOOR DE WIJKEN TUINDORP, KANALENEILAND-NOORD EN LOMBOK",
        "WOONMILIEUS, HUISHOUDENSTYPEN EN WOONMILIEUVOORKEUREN IN UTRECHT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Wittevrouwen" ;
            sgpl:text_context "Het gaat daarbij om kamers of etages in bestaande huizen bij/van particulieren of nieuwe kamers (woonbeeld 2) met huurprijzen van 150 tot 350 gulden kaal. Daarbij zijn met name het vooroorlogs eengezinsrijtjeshuis in Wittevrouwen en Lombok met huurprijzen van 300 tot 550 kaal en nieuwbouw huurwoningen in de binnenstad (Wijk C en Springweg e.o.) met huurprijzen van 450 tot 650 gulden vaak genoemd. De meest gekozen woonbeelden zijn de foto's 1 (33%), 2 (23%), 5 (13%) en 12 (9%)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gehele stad Utrecht" ;
            sgpl:text_context "Dit rapport is het resultaat van mijn leeronderzoek ter afsluiting van mijn studie Sociale Geografie, specialisatie richting Stads- en Plattelandsgeografie, aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het onderzoek heeft plaatsgevonden op initiatief van de Dienst Volkshuisvesting van de gemeente Utrecht en heeft als doel om op basis van drie voorbeeld-wijken en -buurten, te weten Tuindorp, Kanaleneiland-Noord en Lombok, een aanzet te geven voor een woonmilieu-indeling voor de gehele stad Utrecht. Verder zal er inzicht worden gegeven in de verschillende Utrechtse woningzoekende huishoudenstypen en hun woon(milieu)voorkeuren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Wijk C" ;
            sgpl:text_context "Het gaat daarbij om kamers of etages in bestaande huizen bij/van particulieren of nieuwe kamers (woonbeeld 2) met huurprijzen van 150 tot 350 gulden kaal. Daarbij zijn met name het vooroorlogs eengezinsrijtjeshuis in Wittevrouwen en Lombok met huurprijzen van 300 tot 550 kaal en nieuwbouw huurwoningen in de binnenstad (Wijk C en Springweg e.o.) met huurprijzen van 450 tot 650 gulden vaak genoemd. De meest gekozen woonbeelden zijn de foto's 1 (33%), 2 (23%), 5 (13%) en 12 (9%)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Dit rapport is het resultaat van mijn leeronderzoek ter afsluiting van mijn studie Sociale Geografie, specialisatie richting Stads- en Plattelandsgeografie, aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het onderzoek heeft plaatsgevonden op initiatief van de Dienst Volkshuisvesting van de gemeente Utrecht en heeft als doel om op basis van drie voorbeeld-wijken en -buurten, te weten Tuindorp, Kanaleneiland-Noord en Lombok, een aanzet te geven voor een woonmilieu-indeling voor de gehele stad Utrecht. Verder zal er inzicht worden gegeven in de verschillende Utrechtse woningzoekende huishoudenstypen en hun woon(milieu)voorkeuren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Dit rapport is het resultaat van mijn leeronderzoek ter afsluiting van mijn studie Sociale Geografie, specialisatie richting Stads- en Plattelandsgeografie, aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het onderzoek heeft plaatsgevonden op initiatief van de Dienst Volkshuisvesting van de gemeente Utrecht en heeft als doel om op basis van drie voorbeeld-wijken en -buurten, te weten Tuindorp, Kanaleneiland-Noord en Lombok, een aanzet te geven voor een woonmilieu-indeling voor de gehele stad Utrecht. Verder zal er inzicht worden gegeven in de verschillende Utrechtse woningzoekende huishoudenstypen en hun woon(milieu)voorkeuren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Verder ben ik de volgende personen speciale dank verschuldigd, in de eerste plaats Koos Lieshout van de Sector Stedelijk Beleid van de Gemeente Utrecht en Jan van Weesep van de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht voor de prettige wijze van begeleiden en de waardevolle adviezen. Vervolgens wil ik Peter Bertholet van RIGO Research en Advies BV te Amsterdam bedanken voor het gebruik van de enquêtegegevens en zijn steun bij de verwerking en analyse van de onderzoeksgegevens. Verder bedank ik de medewerkers van de Sector Stedelijk Beleid die van mijn stage een plezierige en leerzame tijd hebben gemaakt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Kanaleneiland-Noord" ;
            sgpl:text_context "Dit rapport is het resultaat van mijn leeronderzoek ter afsluiting van mijn studie Sociale Geografie, specialisatie richting Stads- en Plattelandsgeografie, aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het onderzoek heeft plaatsgevonden op initiatief van de Dienst Volkshuisvesting van de gemeente Utrecht en heeft als doel om op basis van drie voorbeeld-wijken en -buurten, te weten Tuindorp, Kanaleneiland-Noord en Lombok, een aanzet te geven voor een woonmilieu-indeling voor de gehele stad Utrecht. Verder zal er inzicht worden gegeven in de verschillende Utrechtse woningzoekende huishoudenstypen en hun woon(milieu)voorkeuren." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746127 ;
            sgpl:spatialText "Tuindorp" ;
            sgpl:text_context "Dit rapport is het resultaat van mijn leeronderzoek ter afsluiting van mijn studie Sociale Geografie, specialisatie richting Stads- en Plattelandsgeografie, aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het onderzoek heeft plaatsgevonden op initiatief van de Dienst Volkshuisvesting van de gemeente Utrecht en heeft als doel om op basis van drie voorbeeld-wijken en -buurten, te weten Tuindorp, Kanaleneiland-Noord en Lombok, een aanzet te geven voor een woonmilieu-indeling voor de gehele stad Utrecht. Verder zal er inzicht worden gegeven in de verschillende Utrechtse woningzoekende huishoudenstypen en hun woon(milieu)voorkeuren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Ondanks het (bijna) opgeheven kwantitatieve woningtekort in Nederland zijn er nog grote regionale verschillen tussen vraag- en aanbodverhoudingen op de woningmarkt. In de Randstad is het kwantitatieve tekort nog steeds substantieel; echter deze wordt overtroffen door de kwalitatieve woningnood, die tot uitdrukking komt op specifieke deelmarkten (met name de grote steden). Daarnaast is begin jaren zeventig de belangstelling gegroeid voor woonwensen van andere huishoudens dan de traditionele gezinnen (Leeuwen, 1989)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751496 ;
            sgpl:spatialText "Lombok" ;
            sgpl:text_context "Dit rapport is het resultaat van mijn leeronderzoek ter afsluiting van mijn studie Sociale Geografie, specialisatie richting Stads- en Plattelandsgeografie, aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het onderzoek heeft plaatsgevonden op initiatief van de Dienst Volkshuisvesting van de gemeente Utrecht en heeft als doel om op basis van drie voorbeeld-wijken en -buurten, te weten Tuindorp, Kanaleneiland-Noord en Lombok, een aanzet te geven voor een woonmilieu-indeling voor de gehele stad Utrecht. Verder zal er inzicht worden gegeven in de verschillende Utrechtse woningzoekende huishoudenstypen en hun woon(milieu)voorkeuren." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "1. INLEIDING. 1.1 Aanleiding tot het onderzoek. Ondanks het (bijna) opgeheven kwantitatieve woningtekort in Nederland zijn er nog grote regionale verschillen tussen vraag- en aanbodverhoudingen op de woningmarkt. In de Randstad is het kwantitatieve tekort nog steeds substantieel; echter deze wordt overtroffen door de kwalitatieve woningnood, die tot uitdrukking komt op specifieke deelmarkten (met name de grote steden)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Dit rapport is het resultaat van mijn leeronderzoek ter afsluiting van mijn studie Sociale Geografie, specialisatie richting Stads- en Plattelandsgeografie, aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit Utrecht. Het onderzoek heeft plaatsgevonden op initiatief van de Dienst Volkshuisvesting van de gemeente Utrecht en heeft als doel om op basis van drie voorbeeld-wijken en -buurten, te weten Tuindorp, Kanaleneiland-Noord en Lombok, een aanzet te geven voor een woonmilieu-indeling voor de gehele stad Utrecht. Verder zal er inzicht worden gegeven in de verschillende Utrechtse woningzoekende huishoudenstypen en hun woon(milieu)voorkeuren." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10702 ;
            sgpl:subjectText "Huishoudenstypen" ;
            sgpl:text_context "Wat betreft het kwantitatieve woningtekort kent zeker ook het stadsgewest Utrecht op regionaal niveau een groot probleem. Een oplossing kan worden gevonden in het ontwikkelen van een sterk naar huishoudenstypen gedifferentieerd woningaanbod. Als kader voor het te voeren volkshuisvestingsbeleid zal de gemeente Utrecht daarom -meer dan in het verleden- aandacht schenken aan het aspect woonmilieu." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Woonmilieus" ;
            sgpl:text_context "Hoofdstuk 5 is gewijd aan een woonmilieutypologie en worden de onderscheiden woonmilieus besproken. De Dienst Volkshuisvesting Utrecht heeft gevraagd een typologie te maken van woonmilieus in de gehele stad. In deze studie is een aanzet gegeven door voor enkele voorbeeld-wijken of -buurten een gedetailleerde indeling te maken." ],
        [ sgpl:refersToConcept unesco:concept7109 ;
            sgpl:subjectText "Leefstijl" ;
            sgpl:text_context "Deze woonmilieu-ori'ntatie is anders dan die voor de 'traditionele' huishoudens, waardoor de vraagzijde van de woningmarkt ook kwalitatief verandert. Daarbij is van belang dat de verschillen in voorkeuren niet alleen worden bepaald door de samenstelling van het huishouden maar ook door de sociaal-economische positie en door de leefstijl (Bertholet en Berkers, 1989). De mogelijkheden van het aanbod &n de gedifferentieerde vraag van de verschillende huishoudenstypen hebben een ruimtelijke segregatie van verschillende bevolkingscategorie&n tot gevolg gehad, zowel binnen de grote steden, als tussen de steden en de omliggende woongebieden." ],
        [ sgpl:refersToConcept unesco:concept7109 ;
            sgpl:subjectText "Leefstijl" ;
            sgpl:text_context "Deze woonmilieu-ori'ntatie is anders dan die voor de 'traditionele' huishoudens, waardoor de vraagzijde van de woningmarkt ook kwalitatief verandert. Daarbij is van belang dat de verschillen in voorkeuren niet alleen worden bepaald door de samenstelling van het huishouden maar ook door de sociaal-economische positie en door de leefstijl (Bertholet en Berkers, 1989). De mogelijkheden van het aanbod &n de gedifferentieerde vraag van de verschillende huishoudenstypen hebben een ruimtelijke segregatie van verschillende bevolkingscategorie&n tot gevolg gehad, zowel binnen de grote steden, als tussen de steden en de omliggende woongebieden." ],
        [ sgpl:refersToConcept unesco:concept10702 ;
            sgpl:subjectText "Huishoudenstypen" ;
            sgpl:text_context "Wat betreft het kwantitatieve woningtekort kent zeker ook het stadsgewest Utrecht op regionaal niveau een groot probleem. Een oplossing kan worden gevonden in het ontwikkelen van een sterk naar huishoudenstypen gedifferentieerd woningaanbod. Als kader voor het te voeren volkshuisvestingsbeleid zal de gemeente Utrecht daarom -meer dan in het verleden- aandacht schenken aan het aspect woonmilieu." ],
        [ sgpl:refersToConcept unesco:concept12004 ;
            sgpl:subjectText "Woonmilieus" ;
            sgpl:text_context "Hoofdstuk 5 is gewijd aan een woonmilieutypologie en worden de onderscheiden woonmilieus besproken. De Dienst Volkshuisvesting Utrecht heeft gevraagd een typologie te maken van woonmilieus in de gehele stad. In deze studie is een aanzet gegeven door voor enkele voorbeeld-wijken of -buurten een gedetailleerde indeling te maken." ] ;
    sgpl:thesisID 222 .

sgpl:Thesis224 a sgpl:SGPLThesis ;
    dcterms:creator "Leonie van der Hoek",
        "Marielies Schelhaas" ;
    dcterms:issued 1991 ;
    dcterms:title "SOCIALE VEILIGHEID IN NIEUWEGEIN; VAN IDEE NAAR UITVOERING",
        "VERSLAGEN VAN LEERONDERZOEK G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Fokkesteeg" ;
            sgpl:text_context "Concreet voorbeeld hiervan is de bemoeienis van het bureau, na initiatief van bewoners, met de herinrichting van een plein in Fokkesteeg. Ook in overlegsituaties met woningbouwverenigingen komt het onderwerp nog wel eens ter sprake. Bij de totstandkoming van de nota Woningvoorraadbeheer zal met aspecten van sociale veiligheid rekening gehouden worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751769 ;
            sgpl:spatialText "Leidschendam" ;
            sgpl:text_context "Alvorens het uiteindelijke onderzoek te starten hebben we, aan de hand van drie selectiecriteria, in zeven referentiegemeenten een studie gedaan naar het actuele beleid op het gebied van sociale veiligheid en de bestuurlijke organisatie ervan. De zeven referentiegemeenten zijn Deventer, Eindhoven, Haarlem, Leiden, Leidschendam, Spijkenisse en Zoetermeer. De uitkomsten van deze studie zijn kort weergegeven in een overzichtsmatrix (figuur 3» p.28)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749131 ;
            sgpl:spatialText "Oudegein" ;
            sgpl:text_context "Nieuwegein is sinds 1971 voor het grootste deel nieuw gebouwd. De aanleg van een groot, midden in Nieuwegein gelegen stadspark op de plaats van een oud landgoed; Oudegein, behoud oude dorpskernen Jutphaas en Vreeswijk (Gemeente Nieuwegein, 1989 I). De wijken sluiten vaak slecht op elkaar aan en kennen een scherpe overgang." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753174 ;
            sgpl:spatialText "Jutphaas" ;
            sgpl:text_context "De commissie adviseerde tot het stichten van een satellietstad, die gebouwd moest worden rond de kernen Jutphaas, Vreeswijk en IJsselstein. IJsselstein haakte af en de twee dorpen Jutphaas en Vreeswijk gingen in 1971 op in de nieuwe gemeente Nieuwegein. Deze ontwikkeling strookte niet met de Tweede Nota Ruimtelijke Ordening uit 1966." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751773 ;
            sgpl:spatialText "Leiden" ;
            sgpl:text_context "Alvorens het uiteindelijke onderzoek te starten hebben we, aan de hand van drie selectiecriteria, in zeven referentiegemeenten een studie gedaan naar het actuele beleid op het gebied van sociale veiligheid en de bestuurlijke organisatie ervan. De zeven referentiegemeenten zijn Deventer, Eindhoven, Haarlem, Leiden, Leidschendam, Spijkenisse en Zoetermeer. De uitkomsten van deze studie zijn kort weergegeven in een overzichtsmatrix (figuur 3» p.28)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Dit onderzoek \"Sociale veiligheid in Nieuwegein, van idee naar uitvoering\" maakt deel uit van een breder onderzoek naar sociale veiligheid in Nieuwegein. Het onderzoek is verricht in opdracht van de gemeente Nieuwegein en begeleid door een ambtelijke, multidisciplinair samengestelde begeleidingsgroep. Aan dit onderzoeksverslag ligt een drietal probleemstellingen ten grondslag:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745195 ;
            sgpl:spatialText "Vreeswijk" ;
            sgpl:text_context "De commissie adviseerde tot het stichten van een satellietstad, die gebouwd moest worden rond de kernen Jutphaas, Vreeswijk en IJsselstein. IJsselstein haakte af en de twee dorpen Jutphaas en Vreeswijk gingen in 1971 op in de nieuwe gemeente Nieuwegein. Deze ontwikkeling strookte niet met de Tweede Nota Ruimtelijke Ordening uit 1966." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753557 ;
            sgpl:spatialText "Houten" ;
            sgpl:text_context "Deze ontwikkeling strookte niet met de Tweede Nota Ruimtelijke Ordening uit 1966. Hierin werd met name Houten aangewezen als groeikern en speelden Jutphaas en Vreeswijk nauwelijks een rol. De nieuwe gemeente Nieuwegein ontwikkelde zich verder wel volgens de ideeën van de Tweede Nota: gebundelde deconcentratie middels groeikernen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Galecop" ;
            sgpl:text_context "Bij de totstandkoming van de nota Woningvoorraadbeheer zal met aspecten van sociale veiligheid rekening gehouden worden. Bij de totstandkoming van het plan Galecop beijvert bureau Volkshuisvesting zich voor het onderbrengen van sociale veiligheid (samen met zaken als aanpasbaar bouwen) in de ”kwaliteiten”-beschrijving, zoals deze zal worden opgenomen in de toelichting op het bestemmingsplan. Binnen het gemeentelijk apparaat werkt Volkshuisvesting alleen formeel samen op het gebied van sociale veiligheid met andere bureaus in het kader van de begeleidingsgroep." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "gemeente Nieuwegein" ;
            sgpl:text_context "Immers, het is niet de bedoeling een zeer veilig maar daardoor onprettig leefbaar Nieuwegein te realiseren. We willen dat dit rapport als een handvat (of deurklink) zal zijn voor degenen die in de gemeente Nieuwegein te maken hebben met sociale veiligheid. Dit rapport kwam niet puur op eigen kracht tot stand." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753355 ;
            sgpl:spatialText "IJsselstein" ;
            sgpl:text_context "De commissie adviseerde tot het stichten van een satellietstad, die gebouwd moest worden rond de kernen Jutphaas, Vreeswijk en IJsselstein. IJsselstein haakte af en de twee dorpen Jutphaas en Vreeswijk gingen in 1971 op in de nieuwe gemeente Nieuwegein. Deze ontwikkeling strookte niet met de Tweede Nota Ruimtelijke Ordening uit 1966." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743856 ;
            sgpl:spatialText "Zoetermeer" ;
            sgpl:text_context "Alvorens het uiteindelijke onderzoek te starten hebben we, aan de hand van drie selectiecriteria, in zeven referentiegemeenten een studie gedaan naar het actuele beleid op het gebied van sociale veiligheid en de bestuurlijke organisatie ervan. De zeven referentiegemeenten zijn Deventer, Eindhoven, Haarlem, Leiden, Leidschendam, Spijkenisse en Zoetermeer. De uitkomsten van deze studie zijn kort weergegeven in een overzichtsmatrix (figuur 3» p.28)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "Alvorens het uiteindelijke onderzoek te starten hebben we, aan de hand van drie selectiecriteria, in zeven referentiegemeenten een studie gedaan naar het actuele beleid op het gebied van sociale veiligheid en de bestuurlijke organisatie ervan. De zeven referentiegemeenten zijn Deventer, Eindhoven, Haarlem, Leiden, Leidschendam, Spijkenisse en Zoetermeer. De uitkomsten van deze studie zijn kort weergegeven in een overzichtsmatrix (figuur 3» p.28)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Cityplaza" ;
            sgpl:text_context "Daarnaast is een zestal gesprekken gevoerd met vertegenwoordigers van betrokken organisaties en instellingen (\"de externen\"): N.V. Verenigd Streekvervoer Westnederland, de Federatie voor de Volkshuisvesting in Nieuwegein, de Vrouwen Advies Commissie voor de woningbouw (VAC), het samenwerkingsverband van drie ouderenbonden COSBO, de Stichting Platform Vreeswijk en de bewonersbelangenvereniging Cityplaza. Diverse nota's en publicaties hebben aanvullende informatie verschaft. Het resultaat is inzichtelijk gemaakt in figuur 4 en 5«" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746932 ;
            sgpl:spatialText "Spijkenisse" ;
            sgpl:text_context "Alvorens het uiteindelijke onderzoek te starten hebben we, aan de hand van drie selectiecriteria, in zeven referentiegemeenten een studie gedaan naar het actuele beleid op het gebied van sociale veiligheid and de bestuurlijke organisatie ervan. De zeven referentiegemeenten zijn Deventer, Eindhoven, Haarlem, Leiden, Leidschendam, Spijkenisse en Zoetermeer. De uitkomsten van deze studie zijn kort weergegeven in een overzichtsmatrix (figuur 3» p.28)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756987 ;
            sgpl:spatialText "Deventer" ;
            sgpl:text_context "Alvorens het uiteindelijke onderzoek te starten hebben we, aan de hand van drie selectiecriteria, in zeven referentiegemeenten een studie gedaan naar het actuele beleid op het gebied van sociale veiligheid en de bestuurlijke organisatie ervan. De zeven referentiegemeenten zijn Deventer, Eindhoven, Haarlem, Leiden, Leidschendam, Spijkenisse en Zoetermeer. De uitkomsten van deze studie zijn kort weergegeven in een overzichtsmatrix (figuur 3» p.28)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Haarlem" ;
            sgpl:text_context "Alvorens het uiteindelijke onderzoek te starten hebben we, aan de hand van drie selectiecriteria, in zeven referentiegemeenten een studie gedaan naar het actuele beleid op het gebied van sociale veiligheid en de bestuurlijke organisatie ervan. De zeven referentiegemeenten zijn Deventer, Eindhoven, Haarlem, Leiden, Leidschendam, Spijkenisse en Zoetermeer. De uitkomsten van deze studie zijn kort weergegeven in een overzichtsmatrix (figuur 3» p.28)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "Stedelijk beheer" ;
            sgpl:text_context "In deze paragraaf gaan we nader in op het beheer van de omgeving. Met stedelijk beheer wordt bedoeld dat beleid dat gericht is op de continue zorg voor het bestaande woon,- werk- en leefklimaat (Hortulanus, 1990). Stedelijk beheer omvat 'alle activiteiten van overheids- en particuliere instanties, particuliere eigenaren, bewoners en andere gebruikers die van invloed zijn op de kwaliteit van een bepaald gebied in zijn totaliteit en op de daarbinnen gelegen beheerobjecten, in het licht van de maatschappelijke functie die het gebied vervult' (Hortulanus, 19Ö7. p.11-12)." ],
        [ sgpl:refersToConcept unesco:concept396 ;
            sgpl:subjectText "Sociale vernieuwing" ;
            sgpl:text_context "In de periode dat wij met ons onderzoek bezig waren kreeg sociale vernieuwing landelijk en ook in Nieuwegein veel aandacht. Wat sociale vernieuwing is en hoe het in de toekomst gestalte moet krijgen is in de nota Sociale vernieuwing: opdracht en handreiking (Ministerie van Binnenlandse Zaken, 1990) uiteen gezet. Het idee van 'sociale vernieuwing' is door de rijksoverheid gelanceerd en heeft als doel het maatschappelijk functioneren van alle individuen in Nederland te bevorderen." ],
        [ sgpl:refersToConcept unesco:concept209 ;
            sgpl:subjectText "Sociale veiligheid" ;
            sgpl:text_context "Onder sociale onveiligheid wordt in de onderzoeksopzet van het onderzoek in Nieuwegein, en ook in dit onderzoek, verstaan: 'een situatie die onveilig is omdat mensen zich bedreigd voelen of de kans lopen feitelijk geconfronteerd te worden met criminaliteit, zoals geweld, inbraken en vandalisme (Gemeente Nieuwegein, 1989. p.2)'. Bij sociale veiligheid wordt onderscheid gemaakt tussen objectieve en subjectieve veiligheid. Objectieve onveiligheid is zichtbaar en voelbaar." ],
        [ sgpl:refersToConcept unesco:concept209 ;
            sgpl:subjectText "Sociale veiligheid" ;
            sgpl:text_context "Onder sociale onveiligheid wordt in de onderzoeksopzet van het onderzoek in Nieuwegein, en ook in dit onderzoek, verstaan: 'een situatie die onveilig is omdat mensen zich bedreigd voelen of de kans lopen feitelijk geconfronteerd te worden met criminaliteit, zoals geweld, inbraken en vandalisme (Gemeente Nieuwegein, 1989. p.2)'. Bij sociale veiligheid wordt onderscheid gemaakt tussen objectieve en subjectieve veiligheid. Objectieve onveiligheid is zichtbaar en voelbaar." ],
        [ sgpl:refersToConcept unesco:concept396 ;
            sgpl:subjectText "Sociale vernieuwing" ;
            sgpl:text_context "In de periode dat wij met ons onderzoek bezig waren kreeg sociale vernieuwing landelijk en ook in Nieuwegein veel aandacht. Wat sociale vernieuwing is en hoe het in de toekomst gestalte moet krijgen is in de nota Sociale vernieuwing: opdracht en handreiking (Ministerie van Binnenlandse Zaken, 1990) uiteen gezet. Het idee van 'sociale vernieuwing' is door de rijksoverheid gelanceerd en heeft als doel het maatschappelijk functioneren van alle individuen in Nederland te bevorderen." ],
        [ sgpl:refersToConcept unesco:concept2148 ;
            sgpl:subjectText "Stedelijk beheer" ;
            sgpl:text_context "In deze paragraaf gaan we nader in op het beheer van de omgeving. Met stedelijk beheer wordt bedoeld dat beleid dat gericht is op de continue zorg voor het bestaande woon,- werk- en leefklimaat (Hortulanus, 1990). Stedelijk beheer omvat 'alle activiteiten van overheids- en particuliere instanties, particuliere eigenaren, bewoners en andere gebruikers die van invloed zijn op de kwaliteit van een bepaald gebied in zijn totaliteit en op de daarbinnen gelegen beheerobjecten, in het licht van de maatschappelijke functie die het gebied vervult' (Hortulanus, 19Ö7. p.11-12)." ] ;
    sgpl:thesisID 224 .

sgpl:Thesis225 a sgpl:SGPLThesis ;
    dcterms:creator "J.A.L. Janssen" ;
    dcterms:issued 1991 ;
    dcterms:title "SPITSBUSSNELDIENSTEN",
        "VERSLAGEN VAN LEERONDERZOEK G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Na een wat aarzelende start is het Shuttle project thans succesvol te noemen qua aantal reizigers en het aantal ex-automobilisten (Verstrate, 1990, blz. 1). Zeer recentelijk is het Shuttle project Schiphol van start gegaan waarin 45 lijnen in zijn opgenomen (NZH et al, 1989). Naast deze grootschalige projecten zijn ook in een aantal andere regio's voorzieningen gecreëerd die specifiek op het woon-werkverkeer zijn gericht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam-Zuidoost" ;
            sgpl:text_context "Op een aantal punten zijn plannen al gerealiseerd in de afgelopen tijd. Het bekendste project is ongetwijfeld het Shuttle project dat in 1988 van start ging; deze bussen verzorgen vanuit woongebieden een rechtstreekse verbinding met Amsterdam-Zuidoost. Doel is om de automobilist over te halen voor het woon-werkverkeer het openbaar vervoer te gebruiken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "1.1 Introductie. De mobiliteit is in Nederland uitgegroeid tot een probleem van formaat. Kon aan de sterk toegenomen behoefte en verplaatsingen in de jaren -60 en 70 nog tegemoet worden gekomen door een snelle uitbreiding van het wegennet, halverwege de jaren -80 wordt erkend dat het zó niet langer gaat." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "De gemiddelde rijsnelheid van de spitsbussneldiensten bedraagt ongeveer 40 km/uur en ligt daarmee iets onder die van alle sneldiensten. De spitsbussneldiensten hebben hun eindpunt allemaal in agglomeraties; het merendeel van de spitsbussneldiensten is te vinden in de Randstad. De introductie van de spitsbussneldiensten kan, gemeten aan de bezettingen, een succes worden genoemd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Het aanbod van sneldiensten is redelijk gespreid over het land. Het vervoer is steeds gericht op de grote en grotere centra: Amsterdam, Den Haag, Rotterdam, Groningen, Enschede, Eindhoven, Zwolle en Nijmegen. Daarnaast moet gewezen worden op het sneldienstnet rond Schiphol (centrum) en Schiphol (oost)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "Mobiliteit" ;
            sgpl:text_context "In hoofdstuk twee wordt allereerst ingegaan op de mobiliteitsontwikkelingen en enkele achtergrondaspecten. De mobiliteit is in Nederland in de afgelopen dertig jaar sterk toegenomen; deze toename is grotendeels veroorzaakt door een explosieve groei van het autoverkeer. Uitgedrukt in reizigerskilometers is de totale mobiliteit in Nederland tussen 1960 en 1987 van 41 naar bijna 152 miljard reizigerskilometers gestegen." ],
        [ sgpl:refersToConcept unesco:concept13886 ;
            sgpl:subjectText "Normeringssysteem" ;
            sgpl:text_context "Gezien het specifieke karakter van de spitsbussneldiensten rijst de vraag of dergelijke voorzieningen op dezelfde wijze moeten worden behandeld als de conventionele streekvervoerlijnen. Het doel van deze studie is het ontwikkelen van een normeringssysteem voor spitsbussneldiensten. De opbouw van het rapport is als volgt: In hoofdstuk twee wordt allereerst ingegaan op de mobiliteitsontwikkelingen en enkele achtergrondaspecten." ],
        [ sgpl:refersToConcept unesco:concept16238 ;
            sgpl:subjectText "Spitsbussneldiensten" ;
            sgpl:text_context "In 1989 zijn, nadat de overheid voor een experiment gelden beschikbaar had gesteld, een aantal projecten gestart onder de naam spitsbussneldienst. Het doel van deze spitsbussneldiensten is om automobilisten uit de file te halen, waardoor de verkeersdruk wordt gereduceerd. Spitsbussneldiensten kunnen onder de huidige omstandigheden niet kostendekkend worden ge''xploiteerd; voor de experimentele periode is een bedrag beschikbaar gesteld door de overheid." ],
        [ sgpl:refersToConcept unesco:concept16238 ;
            sgpl:subjectText "Spitsbussneldiensten" ;
            sgpl:text_context "In 1989 zijn, nadat de overheid voor een experiment gelden beschikbaar had gesteld, een aantal projecten gestart onder de naam spitsbussneldienst. Het doel van deze spitsbussneldiensten is om automobilisten uit de file te halen, waardoor de verkeersdruk wordt gereduceerd. Spitsbussneldiensten kunnen onder de huidige omstandigheden niet kostendekkend worden ge''xploiteerd; voor de experimentele periode is een bedrag beschikbaar gesteld door de overheid." ],
        [ sgpl:refersToConcept unesco:concept10087 ;
            sgpl:subjectText "Mobiliteit" ;
            sgpl:text_context "In hoofdstuk twee wordt allereerst ingegaan op de mobiliteitsontwikkelingen en enkele achtergrondaspecten. De mobiliteit is in Nederland in de afgelopen dertig jaar sterk toegenomen; deze toename is grotendeels veroorzaakt door een explosieve groei van het autoverkeer. Uitgedrukt in reizigerskilometers is de totale mobiliteit in Nederland tussen 1960 en 1987 van 41 naar bijna 152 miljard reizigerskilometers gestegen." ],
        [ sgpl:refersToConcept unesco:concept13886 ;
            sgpl:subjectText "Normeringssysteem" ;
            sgpl:text_context "Gezien het specifieke karakter van de spitsbussneldiensten rijst de vraag of dergelijke voorzieningen op dezelfde wijze moeten worden behandeld als de conventionele streekvervoerlijnen. Het doel van deze studie is het ontwikkelen van een normeringssysteem voor spitsbussneldiensten. De opbouw van het rapport is als volgt: In hoofdstuk twee wordt allereerst ingegaan op de mobiliteitsontwikkelingen en enkele achtergrondaspecten." ] ;
    sgpl:thesisID 225 .

sgpl:Thesis226 a sgpl:SGPLThesis ;
    dcterms:creator "Anke Knaken" ;
    dcterms:issued 1991 ;
    dcterms:title "OUDEREN IN HOOGRAVEN",
        "Woonwensen en woonsituatie van ouderen in een vroeg na-oorlogse wijk in Utrecht" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "gemeente Utrecht" ;
            sgpl:text_context "Bij intramurale huisvesting vindt geen vergelijking plaats tussen de situatie in Utrecht en Nederland, omdat dit niet centraal staat in het onderzoek. De vergelijking vindt plaats op gegevens van de gemeente Utrecht (1988) en een NCIV-rapport (1988). Uit gegevens van het WBO-onderzoek 1985 blijkt dat bijna 60 procent van de ouderen in huurwoningen woont, maar dat percentage bedraagt in Utrecht bijna 80 procent." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Volgens de CBS-middenvariant voor de bevolkingsprognose zal in het jaar 2035 ongeveer 27 procent van de bevolking 65-plusser zijn. De vier grote steden zijn meer vergrijsd dan Nederland als geheel. Jobse (1986) schrijft dit toe aan twee processen: de verlenging van de levensduur en de geringe intergemeentelijke mobiliteit van deze groep in de voorgaande decennia." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912,
                geonames:2746222,
                geonames:2753676 ;
            sgpl:spatialText "Utrechtse wijk Hoograven en Tolsteeg" ;
            sgpl:text_context "Voorwoord. Voor U ligt het rapport van het onderzoek naar de woonsituatie en de woonwensen van ouderen (65+) in de Utrechtse wijk Hoograven en Tolsteeg. Dit onderzoek is verricht als afstudeerproject binnen de vakgroep Toegepaste Geografie en Ruimtelijke Planning (G & P) aan de faculteit der Ruimtelijke Wetenschappen aan de Rijksuniversiteit Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "De Uithof" ;
            sgpl:text_context "vakgroep toegepaste geografie en ruimtelijke planning ïisitorium II, Heidelberglaan 2, De Uithof, UTRECHT (030)532044. OUDEREN IN HOOGRAVEN. Woonwensen en woonsituatie van ouderen in een vroeg na-oorlogse wijk in Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746124 ;
            sgpl:spatialText "Tuindorp" ;
            sgpl:text_context "Het tegenovergestelde is het geval met de uitbreidingswijken van kort voor en na de Tweede Wereldoorlog. In Oog in Al, Tuindorp en Zuilen wonen naar verhouding zeer veel ouderen. In de wijken uit de jaren vijftig en zestig zal de vergrijzing sterk doorzetten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2743628 ;
            sgpl:spatialText "Zuilen" ;
            sgpl:text_context "Het tegenovergestelde is het geval met de uitbreidingswijken van kort voor en na de Tweede Wereldoorlog. In Oog in Al, Tuindorp en Zuilen wonen naar verhouding zeer veel ouderen. In de wijken uit de jaren vijftig en zestig zal de vergrijzing sterk doorzetten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753676 ;
            sgpl:spatialText "Hoograven" ;
            sgpl:text_context "Deze onderzoekmethode past goed bij een inventariserend onderzoek, dat ten doel heeft inzichten te verwerven in de verdeling van sommige kenmerken onder de onderzoekseenheden voor verder onderzoek. De onderzoeker selecteert respondenten op een verschijnsel: 65 jaar of ouder en woonachtig in dat deel van Hoograven dat stamt uit de jaren vijftig. 3. Theorie en empirie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749573 ;
            sgpl:spatialText "Oog in Al" ;
            sgpl:text_context "Het tegenovergestelde is het geval met de uitbreidingswijken van kort voor en na de Tweede Wereldoorlog. In Oog in Al, Tuindorp en Zuilen wonen naar verhouding zeer veel ouderen. In de wijken uit de jaren vijftig en zestig zal de vergrijzing sterk doorzetten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746222,
                geonames:2753676 ;
            sgpl:spatialText "Hoograven-Tolsteeg" ;
            sgpl:text_context "Tot slot worden in hoofdstuk 6 de conclusies gepresenteerd. 4. Onderzoeksgebied Hoograven-Tolsteeg is een woonwijk die deels uit de jaren vijftig stamt. De destijds jonge bevolking van veel gezinnen met kinderen is nu veranderd in een afnemende, meer vergrijsde bevolking, die een vrij groot vrouwenoverschot op hoge leeftijd kent." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Woonwensen er woonsituatie van ouderen in een vroeg na-oorlogse wijk in Utrecht Anke Knaken januari 1991 Utrecht." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1673 ;
            sgpl:subjectText "woonwensen van ouderen" ;
            sgpl:text_context "Relatief veel ouderen wonen in deze wijken, die gezien hun woningvoorraad en woonomgeving blootstaan aan verouderingsprocessen. Over woonwensen van ouderen is vrij veel bekend, maar kennis over woonwensen in relatie tot bepaalde wijken is schaars. De woningvoorraad van vroeg na-oorlogse wijken worden gekenmerkt door hoge percentages grote woningen, in meergezinshuizen zonder lift op bergruimtes." ],
        [ sgpl:refersToConcept unesco:concept3618 ;
            sgpl:subjectText "woningmarktgerichte belemmeringen" ;
            sgpl:text_context "De onderzoeksresultaten met betrekking tot de woonwensen en de belemmeringen op de woningmarkt worden hierna gegeven. De woningmarktgerichte belemmeringen zijn volgens de ouderen dan ook te wijten aan een tekort schietend aanbod, dat zich uit in lange wachttijden en/of geen geschikte woning. De ouderen zijn van mening dat zij wel zullen verhuizen en dat verbetering van de woonsituatie daar geen verandering in kan brengen." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "verhuisgeneigdheid" ;
            sgpl:text_context "Deze \"handicaps\" hebben tot gevolg dat zij langer staan ingeschreven en een lagere toewijzingskans hebben (Gemeente Utrecht, 1988, pp.67). Het resultaat is dat de verhuisgeneigdheid onder huurders van 60 jaar en ouder gering is, hetgeen de doorstroming op de sociale woningmarkt beperkt. Het absolute tekort op alle deelmarkten leidt tot een verdringingsproces." ],
        [ sgpl:refersToConcept unesco:concept1673 ;
            sgpl:subjectText "woonwensen van ouderen" ;
            sgpl:text_context "Relatief veel ouderen wonen in deze wijken, die gezien hun woningvoorraad en woonomgeving blootstaan aan verouderingsprocessen. Over woonwensen van ouderen is vrij veel bekend, maar kennis over woonwensen in relatie tot bepaalde wijken is schaars. De woningvoorraad van vroeg na-oorlogse wijken worden gekenmerkt door hoge percentages grote woningen, in meergezinshuizen zonder lift op bergruimtes." ],
        [ sgpl:refersToConcept unesco:concept3618 ;
            sgpl:subjectText "woningmarktgerichte belemmeringen" ;
            sgpl:text_context "De onderzoeksresultaten met betrekking tot de woonwensen en de belemmeringen op de woningmarkt worden hierna gegeven. De woningmarktgerichte belemmeringen zijn volgens de ouderen dan ook te wijten aan een tekort schietend aanbod, dat zich uit in lange wachttijden en/of geen geschikte woning. De ouderen zijn van mening dat zij wel zullen verhuizen en dat verbetering van de woonsituatie daar geen verandering in kan brengen." ],
        [ sgpl:refersToConcept unesco:concept427 ;
            sgpl:subjectText "verhuisgeneigdheid" ;
            sgpl:text_context "Deze \"handicaps\" hebben tot gevolg dat zij langer staan ingeschreven en een lagere toewijzingskans hebben (Gemeente Utrecht, 1988, pp.67). Het resultaat is dat de verhuisgeneigdheid onder huurders van 60 jaar en ouder gering is, hetgeen de doorstroming op de sociale woningmarkt beperkt. Het absolute tekort op alle deelmarkten leidt tot een verdringingsproces." ] ;
    sgpl:thesisID 226 .

sgpl:Thesis227 a sgpl:SGPLThesis ;
    dcterms:creator "M. Verstege",
        "M.R. Langeveld" ;
    dcterms:issued 1991 ;
    dcterms:title "TELEMATICA-ONTWIKKELINGEN IN HET BANKWEZEN",
        "VAN BARCELONA",
        "VERSLAGEN VAN LEERONDERZOEK G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3336901 ;
            sgpl:spatialText "Catalonie" ;
            sgpl:text_context "Zo bevroren de nationale banken alle tegoeden van Catalaanse particulieren, dit in tegenstelling tot de spaarbanken. Dit is thans een reden voor het gegeven dat spaarbanken zo sterk aanwezig zijn in Catalonie en de nationale banken in dit gebied minder makkelijk particuliere klanten aantrekken. De periode na de burger-oorlog tot de begin-jaren zestig, welke worden gekenmerkt door de dictatuur van Franco, wordt in de literatuur de \"bancaire status quo\" genoemd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In andere landen is videotex lang niet zo'n groot succes. In 1980 had ook Nederland zijn eigen videotex maar succesvol was dit niet. Blijkbaar waren de mensen nog niet toe aan telewinkelen, telebankieren en het zoeken van nummers in de electronische telefoongids." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3128760 ;
            sgpl:spatialText "Barcelona" ;
            sgpl:text_context "De agglomeratie Barcelona is een van de pijlers van de Spaanse economie en staat momenteel erg in de belangstelling vanwege de organisatie van de hier in 1992 te houden Olympische Spelen. In Barcelona is het bankwezen, net als in andere grote Spaanse steden, opvallend aanwezig. \"Geen straathoek zonder bankkantoor\" lijkt credo te zijn van de aldaar gevestigde banken en spaarbanken (cajas genaamd)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2510769 ;
            sgpl:spatialText "Spanje" ;
            sgpl:text_context "Een ieder, die wel eens een tijd in Spanje heeft doorgebracht, zal de ernstige tekortkomingen van het telefoonverkeer kunnen beamen. Telefonica houdt zich echter niet alleen bezig met telefoonverkeer, maar ook met datatransmissie (te vergelijken met PTT Telecom). Daartoe dienen het telefoonnetwerk en enkele andere specifiek daarvoor bestemde netwerken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3111199 ;
            sgpl:spatialText "Sabadell" ;
            sgpl:text_context "Als eerste werd de stedelijke agglomeratie van Barcelona als onderzoeksgebied gekozen. Buiten Barcelona is de belangrijkste plaats in dit gebied Sabadell. Kaart 1 Lokatie van het veldwerkgebied." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "M.Verstege GE 82 Faculteit der Ruimtelijke Wetenschappen, Rijksuniversiteit Utrecht Heidelberglaan 2, 3584 CS Utrecht, 030- 531399/532044 g/sy/ö2 / TELEMATICA-ONTWIKKELINGEN IN HET BANKWEZEN VAN BARCELONA." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:3128760 ;
            sgpl:spatialText "agglomeratie Barcelona" ;
            sgpl:text_context "Hoofdstuk 4: geeft een schets van Telefonica. Hoofdstuk 5: vermeldt de uitwerkingen van de interviews, die wij in februari 1991 met vertegenwoordigers van 12 Spaanse banken en spaarbanken in de agglomeratie Barcelona hebben gemaakt. Hoofdstuk 6: hierin zijn de samenvatting en de conclusies vervat." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3401 ;
            sgpl:subjectText "automatisering in het bankwezen" ;
            sgpl:text_context "Electronic Data Interchange (EDI) zijn minder bekend en worden op dit moment nog nauwelijks gebruikt. Met name in het bankwezen heeft telematica, maar ook de eerder in gang gezette automatisering, grote veranderingen veroorzaakt. Nadat het arbeidsintensieve rekenhandwerk was vervangen door computers kwamen er andere mogelijkheden voor de banken om nieuwe activiteiten te ontplooien." ],
        [ sgpl:refersToConcept unesco:concept7413 ;
            sgpl:subjectText "datatransmissie" ;
            sgpl:text_context "Datacommunicatie kan men omschrijven als de uitwisseling van informatie over grotere afstanden tussen computers en periferie of tussen computers onderling ( de meest gebruikte periferie is de terminal, die de directe interactie tussen een gebruiker en een computer verzorgt). In een datacommunicatie-systeem vindt ook fysieke overdracht van informatie plaats: datatransmissie (Silva dos Santos, 1989). Bij datacommunicatie is van belang dat het transport van data foutloos gebeurt." ],
        [ sgpl:refersToConcept unesco:concept6086 ;
            sgpl:subjectText "telematica-ontwikkelingen" ;
            sgpl:text_context "HOOFDSTUK 2 TELEMATICA-ONTWIKKELINGEN 2, 1 Inleiding. In dit hoofdstuk zullen een aantal telematica-ontwikkelingen worden behandeld. Paragraaf twee en drie gaan in op algemene ontwikkelingen en openbare netwerken." ],
        [ sgpl:refersToConcept unesco:concept7413 ;
            sgpl:subjectText "datatransmissie" ;
            sgpl:text_context "Datacommunicatie kan men omschrijven als de uitwisseling van informatie over grotere afstanden tussen computers en periferie of tussen computers onderling ( de meest gebruikte periferie is de terminal, die de directe interactie tussen een gebruiker en een computer verzorgt). In een datacommunicatie-systeem vindt ook fysieke overdracht van informatie plaats: datatransmissie (Silva dos Santos, 1989). Bij datacommunicatie is van belang dat het transport van data foutloos gebeurt." ],
        [ sgpl:refersToConcept unesco:concept3401 ;
            sgpl:subjectText "automatisering in het bankwezen" ;
            sgpl:text_context "Electronic Data Interchange (EDI) zijn minder bekend en worden op dit moment nog nauwelijks gebruikt. Met name in het bankwezen heeft telematica, maar ook de eerder in gang gezette automatisering, grote veranderingen veroorzaakt. Nadat het arbeidsintensieve rekenhandwerk was vervangen door computers kwamen er andere mogelijkheden voor de banken om nieuwe activiteiten te ontplooien." ],
        [ sgpl:refersToConcept unesco:concept6086 ;
            sgpl:subjectText "telematica-ontwikkelingen" ;
            sgpl:text_context "HOOFDSTUK 2 TELEMATICA-ONTWIKKELINGEN 2, 1 Inleiding. In dit hoofdstuk zullen een aantal telematica-ontwikkelingen worden behandeld. Paragraaf twee en drie gaan in op algemene ontwikkelingen en openbare netwerken." ] ;
    sgpl:thesisID 227 .

sgpl:Thesis228 a sgpl:SGPLThesis ;
    dcterms:creator "Elbert Spek" ;
    dcterms:issued 1991 ;
    dcterms:title "Een voorstel voor een ge%%ntegreerde gebiedsgerichte benadering via ruimtelijk en milieubeleid voor het IJsselmeer- en Markermeergebied.",
        "ROM-BELEID, MAATKOSTUUM VOOR HET IJSSELMEER/MARKERMEER?" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753361,
                geonames:7869931 ;
            sgpl:spatialText "IJsselmeer- en Markermeergebied" ;
            sgpl:text_context "ROM-BELEID, MAATKOSTUUM VOOR HET IJSSELMEER/MARKERMEER? Een voorstel voor een geïntegreerde gebiedsgerichte benadering via ruimtelijk en milieubeleid voor het IJsselmeer- en Markermeergebied. Afsluiting afstudeerscriptie Sociale Geografie/specialisatie Planologie Vakgroep Toegepaste Geografie en Planologie." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7869931 ;
            sgpl:spatialText "Markermeer" ;
            sgpl:text_context "Het Integraal Beleidsplan IJsselmeer èn het Interim Beheersplan Markermeer werden hiermee tot studienota’s. Voor het Markermeer werd met het oog op een eventuele inpoldering een Interim Beheersplan opgesteld. In oktober 1990 werd de PKB-Markerwaard echter van tafel geschoven, met als gevolg dat de minister besloot een Integraal Beheersplan IJsselmeer/Markermeer te laten opstellen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753377 ;
            sgpl:spatialText "IJmeer" ;
            sgpl:text_context "Het Markermeer wordt begrensd door de kustlijn van zuidelijk Flevoland, de noordelijke grens van het IJ-meer, de kust van Noord-Holland en de Houtribdijk. De reden dat het IJmeer niet is opgenomen heeft als oorzaak dat dit water reeds als ROM-gebied is aangewezen. Bovendien heeft het een geheel eigen problematiek (Amsterdam Nieuw-Oost en de Diemerzeedijk)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Provincie Friesland" ;
            sgpl:text_context "De stand van zaken per januari 1991 (de afsluitingsdatum van deze nota) is, dat er in feite twee beleidslijnen langs elkaar heen werken. Enerzijds wordt door de drie betrokken provincies (Friesland, Flevoland en Noord-Holland) voor het IJsselmeer een Interprovinciaal Beleidsplan opgesteld. Anderzijds wordt door directie Flevoland van Rijkswaterstaat een Integraal Beheersplan voor beide wateren opgesteld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749879 ;
            sgpl:spatialText "Provincie Noord-Holland" ;
            sgpl:text_context "Dit betrof een opdracht van de Vereniging tot Behoud van het IJsselmeer aan DHV. Hierna ben ik in aanraking gekomen met het ROM-gebiedenbeleid middels een stage bij de provincie Noord-Holland. Centraal in deze stage stond Schiphol als ROM-gebied en de relatie van deze regio met het streekplan Amsterdam-Noordzeekanaal." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Nu de Markerwaard voorlopig van de baan is, biedt een ROM-benadering een goed kader voor een nieuwe impuls aan het beleid voor het natte hart van Nederland. Er zijn een aantal zaken die pleiten vóór een ROM-aanpak. Een ROM-aanpak doet de nationale betekenis van het IJsselmeer/Markermeer meer tot zijn recht komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3319179 ;
            sgpl:spatialText "Provincie Flevoland" ;
            sgpl:text_context "De stand van zaken per januari 1991 (de afsluitingsdatum van deze nota) is, dat er in feite twee beleidslijnen langs elkaar heen werken. Enerzijds wordt door de drie betrokken provincies (Friesland, Flevoland en Noord-Holland) voor het IJsselmeer een Interprovinciaal Beleidsplan opgesteld. Anderzijds wordt door directie Flevoland van Rijkswaterstaat een Integraal Beheersplan voor beide wateren opgesteld." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Hierna ben ik in aanraking gekomen met het ROM-gebiedenbeleid middels een stage bij de provincie Noord-Holland. Centraal in deze stage stond Schiphol als ROM-gebied en de relatie van deze regio met het streekplan Amsterdam-Noordzeekanaal. Het daaruit voortgekomen rapport 'Plan van Aanpak Schiphol - Take off?' heeft als opstap naar deze kernnota gefunctioneerd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753361 ;
            sgpl:spatialText "IJsselmeer" ;
            sgpl:text_context "Er zijn echter wel verschillen in de beleidsmatige weg die beide gebieden gegaan zijn. Het beleid voor het IJsselmeer is van 1985 tot 1989 voor een groot deel bepaald door het Integraal Beleidsplan IJsselmeer dat door de Commissie IJsselmeer (COMIJS) diende te worden opgesteld. In 1989 echter hebben de provincies, onder andere vanwege de provinciale indeling van het watergebied, zich terughoudend ten opzichte van de COMIJS opgesteld en zijn over gegaan tot het opstellen van een eigen Interprovinciaal Beleidsplan IJsselmeer." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Markerwaard" ;
            sgpl:text_context "Voor het Markermeer werd met het oog op een eventuele inpoldering een Interim Beheersplan opgesteld. In oktober 1990 werd de PKB-Markerwaard echter van tafel geschoven, met als gevolg dat de minister besloot een Integraal Beheersplan IJsselmeer/Markermeer te laten opstellen. Het Integraal Beleidsplan IJsselmeer èn het Interim Beheersplan Markermeer werden hiermee tot studienota’s." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12717 ;
            sgpl:subjectText "Integraal Beleidsplan" ;
            sgpl:text_context "Er zijn echter wel verschillen in de beleidsmatige weg die beide gebieden gegaan zijn. Het beleid voor het IJsselmeer is van 1985 tot 1989 voor een groot deel bepaald door het Integraal Beleidsplan IJsselmeer dat door de Commissie IJsselmeer (COMIJS) diende te worden opgesteld. In 1989 echter hebben de provincies, onder andere vanwege de provinciale indeling van het watergebied, zich terughoudend ten opzichte van de COMIJS opgesteld en zijn over gegaan tot het opstellen van een eigen Interprovinciaal Beleidsplan IJsselmeer." ],
        [ sgpl:refersToConcept unesco:concept6105 ;
            sgpl:subjectText "ROM-beleid" ;
            sgpl:text_context "Ten eerste beoogd het een nieuw licht te werpen op het IJsselmeerbeleid. In de tweede plaats wil het een bijdrage leveren aan de discussie rond de geïntegreerde gebiedsgerichte benadering via ruimtelijk -en milieubeleid (ROM-beleid). Beleidsontwikkeling Het IJsselmeer en Markermeer hebben veel gemeenschappelijk, zowel wat betreft hun uiterlijke verschijningsvormen als de functies die beide wateren hebben." ],
        [ sgpl:refersToConcept unesco:concept5185 ;
            sgpl:subjectText "gebiedsgericht beleid" ;
            sgpl:text_context "Nadat er over het onderwerp al de nodige conferenties gehouden zijn wordt het eigenlijke onderwerp nog eens gedefinieerd: gebiedsgericht beleid. Deze nota handelt over dit gebiedsgericht beleid. Of beter: ROM-gebieden beleid." ],
        [ sgpl:refersToConcept unesco:concept12717 ;
            sgpl:subjectText "Integraal Beleidsplan" ;
            sgpl:text_context "Er zijn echter wel verschillen in de beleidsmatige weg die beide gebieden gegaan zijn. Het beleid voor het IJsselmeer is van 1985 tot 1989 voor een groot deel bepaald door het Integraal Beleidsplan IJsselmeer dat door de Commissie IJsselmeer (COMIJS) diende te worden opgesteld. In 1989 echter hebben de provincies, onder andere vanwege de provinciale indeling van het watergebied, zich terughoudend ten opzichte van de COMIJS opgesteld en zijn over gegaan tot het opstellen van een eigen Interprovinciaal Beleidsplan IJsselmeer." ],
        [ sgpl:refersToConcept unesco:concept5185 ;
            sgpl:subjectText "gebiedsgericht beleid" ;
            sgpl:text_context "Nadat er over het onderwerp al de nodige conferenties gehouden zijn wordt het eigenlijke onderwerp nog eens gedefinieerd: gebiedsgericht beleid. Deze nota handelt over dit gebiedsgericht beleid. Of beter: ROM-gebieden beleid." ],
        [ sgpl:refersToConcept unesco:concept6105 ;
            sgpl:subjectText "ROM-beleid" ;
            sgpl:text_context "Ten eerste beoogd het een nieuw licht te werpen op het IJsselmeerbeleid. In de tweede plaats wil het een bijdrage leveren aan de discussie rond de geïntegreerde gebiedsgerichte benadering via ruimtelijk -en milieubeleid (ROM-beleid). Beleidsontwikkeling Het IJsselmeer en Markermeer hebben veel gemeenschappelijk, zowel wat betreft hun uiterlijke verschijningsvormen als de functies die beide wateren hebben." ] ;
    sgpl:thesisID 228 .

sgpl:Thesis229 a sgpl:SGPLThesis ;
    dcterms:creator "Ben Thijssen",
        "Lena van der Valk" ;
    dcterms:issued 1991 ;
    dcterms:title "DE RECREATIEF-TOERISTISCHE POTENTIES VAN HET LANDELIJK GEBIED: Een sociaal-geografisch onderzoek naar de meetbaarheid van ontwikkelingskansen en mogelijkheden in de recreatief-toeristische sector." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755249 ;
            sgpl:spatialText "Provinciale Planologische Dienst Groningen" ;
            sgpl:text_context "De ontwikkelingsmogelijkheden van de verschillende gebieden zijn niet eenduidig, en daardoor niet algemeen vast te stellen. Een treffend voorbeeld hiervan vormt de beleidsstudie 'Toeristische potenties van de regio Lauwersmeer' van de Provinciale Planologische Dienst Groningen (1987, p. 1). Afgezien van de vermelding van het woord potentie in de titel van dit rapport wordt dit begrip nergens meer met name genoemd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746058 ;
            sgpl:spatialText "Twente" ;
            sgpl:text_context "Elke regio heeft zekere potenties, zo stelt het RPD-rapport, die, indien ze benut worden, bijdragen tot een verhoging van de regionale en nationale welvaart. Volgens het studierapport 'Imago en potenties van Twente. Een economisch-geografische analyse.' (Haverkate, 1987, p. 13) valt de belangstelling voor potenties te verklaren door het aan prioriteit inboetende regionaal stimuleringsbeleid van de Rijksoverheid. De terugtrekkende rol van de Rijksoverheid komt in de Vierde Nota over de Ruimtelijke Ordening (Ministerie van VROM, 1988) tot uitdrukking." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Behalve door Paulus werden wij bijgestaan door Ilco Springer, onze begeleider van het ministerie, die ook sociale geografie in Utrecht gestudeerd bleek te hebben. Veel van de toenmalige kroegen in Utrecht blijken nu nog te bestaan. Het leukste van de stage waren misschien nog wel de interviews met deskundigen op het gebied van de recreatie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Indien deze actoren in hecht georganiseerde samenwerkingsverbanden de krachten zoveel mogelijk bundelen, kan de recreatief-toeristische ontwikkeling van een regio worden gestimuleerd, geïnitieerd, georganiseerd en gecoördineerd. Wat betreft de regionale organisatie merken de Bruin en Koetsier (1988, p. 82) op dat de verschillen binnen Nederland in regionaal-economische dynamiek waarschijnlijk sterker samenhangen met verschillen in organiserend vermogen dan met verschillen in het productie-milieu (regio-kenmerken) in meer traditionele zin. Volgens Jansen-Verbeke (1990, p. 8) ligt de toeristische potentie van een plaats of een regio in de kombinatie van een aantal factoren, te weten:" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "Noord-West Overijssel" ;
            sgpl:text_context "Uit dit citaat blijkt, dat de recreatief-toeristische potenties van een gebied met name worden gezocht in factoren met betrekking tot het natuurlijk milieu (zoals bijvoorbeeld de aanwezigheid van plassen, meren en/of bossen). In de vierde nota worden in Ruimtelijk Ontwikkelings Perspectief 2 het Friese merengebied en Noord-West Overijssel en in Ruimtelijk Ontwikkelings Perspectief 5 het IJsselmeer, het Markermeer en de randmeren genoemd als gebieden met recreatief-toeristische potenties. Er wordt niet nader ingegaan op de invulling, de aard, van de recreatief- toeristische potenties van deze gebieden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "West- en Midden-Brabant" ;
            sgpl:text_context "Omdat gebruik wordt gemaakt van bestaand beschikbaar cijfermateriaal, is bij de keuze van casegebieden uitgegaan van de gebiedsindeling in toeristengebieden, die het CBS (Centraal Bureau voor de Statistiek) hanteert. De volgende casegebieden zijn gekozen: 1) (het toeristengebied) West- en Midden-Brabant; 2) (het toeristengebied) Zuid-Limburg. De casegebieden zijn in figuur 4.1 in kaart gebracht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Zuid-Limburg" ;
            sgpl:text_context "Omdat gebruik wordt gemaakt van bestaand beschikbaar cijfermateriaal, is bij de keuze van casegebieden uitgegaan van de gebiedsindeling in toeristengebieden, die het CBS (Centraal Bureau voor de Statistiek) hanteert. De volgende casegebieden zijn gekozen: 1) (het toeristengebied) West- en Midden-Brabant; 2) (het toeristengebied) Zuid-Limburg. De casegebieden zijn in figuur 4.1 in kaart gebracht." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10507 ;
            sgpl:subjectText "multicriteria evaluatie" ;
            sgpl:text_context "Tevens zullen kort de tegengekomen knelpunten in de aanpak aan de orde komen. De multi-criteria evaluatie (MCE) is een methode welke met name in de ruimtelijke planning grote populariteit geniet. Met behulp van de MCE-methode kan de geschiktheid van bepaalde gebieden voor bepaalde activiteiten beoordeeld worden." ],
        [ sgpl:refersToConcept unesco:concept12330 ;
            sgpl:subjectText "recreatief-toeristische potenties" ;
            sgpl:text_context "Daarnaast is niet duidelijk hoe deze recreatief-toeristische potenties vastgesteld dienen te worden. Bij de Directie Openluchtrecreatie van het Ministerie van Landbouw, Natuurbeheer en Visserij bleek belangstelling te bestaan voor het doen van een onderzoek naar de recreatief-toeristische potenties van het landelijke gebied van Nederland. De belangstelling van de Directie Openluchtrecreatie naar recratief-toeristische potenties als onderwerp van onderzoek werd mede ingegeven door haar huidige werkzaamheden aan de binnenkort uit te brengen Beleidsnota Openluchtrecreatie." ],
        [ sgpl:refersToConcept unesco:concept445 ;
            sgpl:subjectText "landelijk gebied" ;
            sgpl:text_context "Belangrijke criteria voor de selectie van deze gebieden vormen ondermeer de zwaarte van de problemen (hoe groot is het tekort aan recreatiemogelijkheden?) en de potentie van een gebied om tot een verdere uitbouw van de recreatief-toeristische sector te komen. De voorzieningen voor de openluchtrecreatie bevinden zich ruimtelijk gezien in een drietal typen gebieden: a) binnen het stedelijk gebied; b) in de stadsrandzónes; c) in het landelijk gebied. De openluchtrecreatie en het toerisme in het landelijk gebied richten zich op een aantal streken, die gekenmerkt worden door de aanwezigheid van aantrekkelijke en afwisselende landschappen, van natuurgebieden, cultuurhistorische elementen en specifiek recreatief-toeristische voorzieningen." ],
        [ sgpl:refersToConcept unesco:concept445 ;
            sgpl:subjectText "landelijk gebied" ;
            sgpl:text_context "Belangrijke criteria voor de selectie van deze gebieden vormen ondermeer de zwaarte van de problemen (hoe groot is het tekort aan recreatiemogelijkheden?) en de potentie van een gebied om tot een verdere uitbouw van de recreatief-toeristische sector te komen. De voorzieningen voor de openluchtrecreatie bevinden zich ruimtelijk gezien in een drietal typen gebieden: a) binnen het stedelijk gebied; b) in de stadsrandzónes; c) in het landelijk gebied. De openluchtrecreatie en het toerisme in het landelijk gebied richten zich op een aantal streken, die gekenmerkt worden door de aanwezigheid van aantrekkelijke en afwisselende landschappen, van natuurgebieden, cultuurhistorische elementen en specifiek recreatief-toeristische voorzieningen." ],
        [ sgpl:refersToConcept unesco:concept12330 ;
            sgpl:subjectText "recreatief-toeristische potenties" ;
            sgpl:text_context "Daarnaast is niet duidelijk hoe deze recreatief-toeristische potenties vastgesteld dienen te worden. Bij de Directie Openluchtrecreatie van het Ministerie van Landbouw, Natuurbeheer en Visserij bleek belangstelling te bestaan voor het doen van een onderzoek naar de recreatief-toeristische potenties van het landelijke gebied van Nederland. De belangstelling van de Directie Openluchtrecreatie naar recratief-toeristische potenties als onderwerp van onderzoek werd mede ingegeven door haar huidige werkzaamheden aan de binnenkort uit te brengen Beleidsnota Openluchtrecreatie." ],
        [ sgpl:refersToConcept unesco:concept10507 ;
            sgpl:subjectText "multicriteria evaluatie" ;
            sgpl:text_context "Tevens zullen kort de tegengekomen knelpunten in de aanpak aan de orde komen. De multi-criteria evaluatie (MCE) is een methode welke met name in de ruimtelijke planning grote populariteit geniet. Met behulp van de MCE-methode kan de geschiktheid van bepaalde gebieden voor bepaalde activiteiten beoordeeld worden." ] ;
    sgpl:thesisID 229 .

sgpl:Thesis23 a sgpl:SGPLThesis ;
    dcterms:creator "J. v. Grootenhuis" ;
    dcterms:issued 1956 ;
    dcterms:title "BLOEMENDAAL." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759951 ;
            sgpl:spatialText "Aerdenhout" ;
            sgpl:text_context "We moeten deze daarom verwisselen met de kaart, die al dadelijk een indeling aan de hand doet in Bloemendaal, Overveen, Aerdenhout en Vogelensangh. Bloemendaal en Overveen zijn de namen van oude dorpen, die ontstonden op de kruisingen van de oude N.Z. verbinding met de oudste O.W. verbindingen (P.Hoekstra, Bloemendaal, Proeve ener streek geschiedenis, 1947, blz. 38). In hun namen drukt zich hun ligging uit: Bloemendaal op de grens van de duinen en het lage land, dat gebruikt werd voor bloembollenteelt, Overveen aan de overzijde van de veenstrook, die Haarlem van de duinen scheidt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2744042 ;
            sgpl:spatialText "Zandvoort" ;
            sgpl:text_context "Het park werd in 1905 in exploitatie genomen, al in 1881 was een station vlakbij, aan de spoorweg Haarlem- Zandvoort. Van belang voor de ontwikkeling van Aerdenhout als villapark was de opening van de tramlijn Haarlem-Zandvoort in 1899, in 1904 doorgetrokken naar Amster dam. De halte Heemstede-Aerdenhout aan de spoorlijn Haarlem - q-. den Haagt pas in 1928 tot stand." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2755003 ;
            sgpl:spatialText "Haarlem" ;
            sgpl:text_context "In het laatste hoofdstuk komen de relaties van Bloemendaal met Haarlem en Amsterdam aan de orde. De conclusies zijn in de laatste twee hoofd stukken verwerkt. Met deze term wordt in het vervolg de gemeente aangeduid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Provinciaal Ziekenhuis" ;
            sgpl:text_context "In het uiterste N. van de gemeente ligt het Provinciaal Ziekenhuis (waarmee rekening gehouden moet worden bij de interpretatie van statistische gegevens) met woonbuurten voor zijn personeel. Aan de hand van deze landschaps-geografische analyse kunnen we Bloemendaal dus typeren als een woongemeente met een zeer speciaal karakter. De statistische bevestiging van de juistheid van deze typering levert een analyse van de bedrijfstelling 1950 en de forensenstatistiek 1947 (Rappart werkgroep)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2758804 ;
            sgpl:spatialText "Bloemendaal" ;
            sgpl:text_context "Inleiding Onze probleemstelling kan in drie woorden geformuleerd worden: Wat is Bloemendaal? Men zou hier al dadelijk tegen kunnen aanvoeren, dat blijkbaar stilzwijgend verondersteld wordt, dat Bloemendaal werkelijk \"is\", d.w.z. méér is dan een administratieve een-heid. Tegenover dit bezwaar kunnen wij ons alleen beroepen op het ervaringsfeit, dat Bloemendaal inderdaad het karakter van een geografische individualiteit bezit." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "In het laatste hoofdstuk komen de relaties van Bloemendaal met Haarlem en Amsterdam aan de orde. De conclusies zijn in de laatste twee hoofd stukken verwerkt. Met deze term wordt in het vervolg de gemeente aangeduid." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2748813 ;
            sgpl:spatialText "Overveen" ;
            sgpl:text_context "We moeten deze daarom verwisselen met de kaart, die al dadelijk een indeling aan de hand doet in Bloemendaal, Overveen, Aerdenhout en Vogelensangh. Bloemendaal en Overveen zijn de namen van oude dorpen, die ontstonden op de kruisingen van de oude N.Z. verbinding met de oudste O.W. verbindingen (P.Hoekstra, Bloemendaal, Proeve ener streek geschiedenis, 1947, blz. 38). In hun namen drukt zich hun ligging uit: Bloemendaal op de grens van de duinen en het lage land, dat gebruikt werd voor bloembollenteelt, Overveen aan de overzijde van de veenstrook, die Haarlem van de duinen scheidt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Vogelensangh" ;
            sgpl:text_context "We moeten deze daarom verwisselen met de kaart, die al dadelijk een indeling aan de hand doet in Bloemendaal, Overveen, Aerdenhout en Vogelensangh. Bloemendaal en Overveen zijn de namen van oude dorpen, die ontstonden op de kruisingen van de oude N.Z. verbinding met de oudste O.W. verbindingen (P.Hoekstra, Bloemendaal, Proeve ener streek geschiedenis, 1947, blz. 38). Vogelensangh^ in het uiterste Zuiden van de gemeente werd door de instroming niet bereikt." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758802 ;
            sgpl:spatialText "de oude Bloemendaalse weg" ;
            sgpl:text_context "Be grens tussen hei-de delen is zo duidelijk als een geograaf maar wensen kan. Zij wordtgevormd door de oude Bloemendaalse weg, en wat in het verlengde daarvan ligt, de \"ruggegraat\" van de ge-meente. Met recht wordt hier gesproken van een oude weg." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756472 ;
            sgpl:spatialText "Park Duin en Daal" ;
            sgpl:text_context "Eerste kenmerk van de woon-situatie in de oudste en bekendste parken, nl. Park Duin en Daal en Park Bloemendaal (kaart I, resp.1 en 2) ten W. van het dorp Bloemendaal, is de ruime verspreiding van de villa’s in de bossen. De villa's staan dus afzonderlijk, op sommigen is de term \"afgezonderd\" van toepassing. Deze staan vaak boven op het duin, in de ruimte er omheen is het bos gehandhaafd, het huis keert zich af van de weg en is van daaruit soms nauwelijks te zien." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept4670 ;
            sgpl:subjectText "woonforensen" ;
            sgpl:text_context "De statistische bevestiging van de juistheid van deze typering levert een analyse van de bedrijfstelling 1950 en de forensenstatistiek 1947 (Rapport werkgroep). De totale stuwende bevolking van de gemeente (stuwende bedrijfsbevolking, woonforensen, landbouwers, overschot aan renteniers) blijkt alsvolgt te zijn samengesteld: Woonforensen 66,4%, stuwende bedrijfsbevolking 24,6%, landbouwers 9%. Bloemendaal blijkt, met Rijswijk, Nieuwer-Amstel en Voorburg het hoogste percentage woonforensen te hebben van de bestudeerde gemeenten." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "villapark" ;
            sgpl:text_context "Achter deze dijk ziet hij het gesloten front van Haarlem's buitenwijken verrijzen. Dit deel is het best te karakteriseren als één groot villapark, slechts tussen Overveen en Aerdenhout onderbroken door in tact gebleven groot-grondbezit, naar het W. begrensd door de terreinen van de Amsterdamse waterleiding en het Nationale Park 'De Kennemerduinen'. De twee landschapselementen dragen dus verschillende woonvormen." ],
        [ sgpl:refersToConcept unesco:concept2713 ;
            sgpl:subjectText "woonideaal" ;
            sgpl:text_context "Waarschijnlijk was voor de Amsterdamse (en Haarlemse) kooplieden, bankiers en magistraten dit Bloemendaal een zuivere realisering van een romantisch gezellig woonideaal. De 'gewone man' uit Haarlem, Amsterdam en de Zaanstreek waardeerde Bloemendaal natuurlijk niet als woonideaal, maar had waarschijnlijk dezelfde romantische waardering als zijn fortuinlijkerbroeders voor de toen nog niet omrasterde bossen op de golvende heuvels, die dit deel van Bloemendaal tot een uniek eiland in het weide-landschap van Noord-Holland maakte. Bij duizenden stroomden zij naar het Pannekoekenhuisje in het Bloemendaalse Bos, naar Kraantje Lek met de beroemde (romantische) holle iep, en naar de Blinkert." ],
        [ sgpl:refersToConcept unesco:concept4670 ;
            sgpl:subjectText "woonforensen" ;
            sgpl:text_context "De statistische bevestiging van de juistheid van deze typering levert een analyse van de bedrijfstelling 1950 en de forensenstatistiek 1947 (Rapport werkgroep). De totale stuwende bevolking van de gemeente (stuwende bedrijfsbevolking, woonforensen, landbouwers, overschot aan renteniers) blijkt alsvolgt te zijn samengesteld: Woonforensen 66,4%, stuwende bedrijfsbevolking 24,6%, landbouwers 9%. Bloemendaal blijkt, met Rijswijk, Nieuwer-Amstel en Voorburg het hoogste percentage woonforensen te hebben van de bestudeerde gemeenten." ],
        [ sgpl:refersToConcept unesco:concept2713 ;
            sgpl:subjectText "woonideaal" ;
            sgpl:text_context "Waarschijnlijk was voor de Amsterdamse (en Haarlemse) kooplieden, bankiers en magistraten dit Bloemendaal een zuivere realisering van een romantisch gezellig woonideaal. De 'gewone man' uit Haarlem, Amsterdam en de Zaanstreek waardeerde Bloemendaal natuurlijk niet als woonideaal, maar had waarschijnlijk dezelfde romantische waardering als zijn fortuinlijkerbroeders voor de toen nog niet omrasterde bossen op de golvende heuvels, die dit deel van Bloemendaal tot een uniek eiland in het weide-landschap van Noord-Holland maakte. Bij duizenden stroomden zij naar het Pannekoekenhuisje in het Bloemendaalse Bos, naar Kraantje Lek met de beroemde (romantische) holle iep, en naar de Blinkert." ],
        [ sgpl:refersToConcept unesco:concept4252 ;
            sgpl:subjectText "villapark" ;
            sgpl:text_context "Achter deze dijk ziet hij het gesloten front van Haarlem's buitenwijken verrijzen. Dit deel is het best te karakteriseren als één groot villapark, slechts tussen Overveen en Aerdenhout onderbroken door in tact gebleven groot-grondbezit, naar het W. begrensd door de terreinen van de Amsterdamse waterleiding en het Nationale Park 'De Kennemerduinen'. De twee landschapselementen dragen dus verschillende woonvormen." ] ;
    sgpl:thesisID 23 .

sgpl:Thesis230 a sgpl:SGPLThesis ;
    dcterms:creator "Bert Slangen",
        "Frank van den Broek" ;
    dcterms:issued 1991 ;
    dcterms:title "BEDRIJFSVERVOERPLANNEN",
        "MARKETINGTECHNISCH BENADERD",
        "Maatwerk bij de be%%nvloeding van de vervoerswijzekeuze door toepassing van methoden en technieken uit de marketing." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "Deze gebieden zijn: - Utrecht: De Uithof/Rijnsweerd en Jaarbeurs. - Amsterdam: Zuidoost en Schiphol. - Den Haag: Bezuidenhout." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "de Randstad" ;
            sgpl:text_context "De sterke groei van de automobiliteit, die enerzijds een uiting is van de economische groei, maar anderzijds een bedreiging vormt voor de bereikbaarheid en leefbaarheid van met name de Randstad, vormt aanleiding voor talrijke discussies en studies. De prognoses voor de automobiliteit en het autobezit wijzen eveneens op een forse groei, hetgeen een grondige beschouwing noodzakelijk maakt over mogelijkheden om deze ontwikkelingen af te remmen of in goede banen te leiden. In dit hoofdstuk komt het verkeers- en vervoerbeleid zoals dat verwoord is in een aantal nota’s ter sprake." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "Voor deze proef zijn gebieden in de regio Groningen, Arnhem/Nijmegen en Amersfoort geselecteerd. Gezien de recente start is omtrent deze aanpak nog weinig zinnigs te zeggen. 2.3.3. Strategie 3; vervoermanagement bij individuele bedrijven." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "kantoorlocatie \"de Maas\"" ;
            sgpl:text_context "Dit werkstuk is de weerslag van ons leeronderzoek dat handelt over vervoermanagement i.c. bedrijfsvervoerplannen en marketing. Het bedrijfsvervoerplan voor kantoorlocatie \"de Maas\" heeft daarbij als inspiratiebron gediend. Als ’vaste bewoners’ van dit kantoorgebouw verkeerden we in de gelukkige positie om de wording en uitwerking van een van de eerste bedrijfsvervoerplannen in Nederland van nabij mee te maken." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "In het kader van het Bereikbaarheidsplan Randstad (BPR) wordt er momenteel in een zevental gebieden ervaring opgedaan met de gebiedsgewijze-aanpak. Deze gebieden zijn: - Utrecht: De Uithof/Rijnsweerd en Jaarbeurs. - Amsterdam: Zuidoost en Schiphol." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Als ’vaste bewoners’ van dit kantoorgebouw verkeerden we in de gelukkige positie om de wording en uitwerking van een van de eerste bedrijfsvervoerplannen in Nederland van nabij mee te maken. Gezien het braakliggende terrein van marketingtoepassing binnen verkeer en vervoer en geïnspireerd door \"de Maas\" hebben we een eerste poging gewaagd dit gebied te ontginnen. Hierbij zijn we gestimuleerd door drs. P. Donkersloot, docent planologie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "de Verenigde Staten van Amerika" ;
            sgpl:text_context "De in hoofdstuk 1 genoemde indirecte benadering van de overheid is gebaseerd op ervaringen in de Verenigde Staten van Amerika en Canada. De private sector is hier een wezenlijke rol gaan spelen bij het creëren van oplossingen op het gebied van de verkeers- en vervoerproblematiek. Deze activi- teiten vinden hun weerslag in zogenaamde Transportation Management Associations/Organisations (TMA’s of TMO’s)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "- Den Haag: Bezuidenhout. - Rotterdam: Kop van Zuid en \"De Maas\". In deze opsomming hebben \"de Jaarbeurs\", \"de Maas\" en \"de Kop van Zuid\" een aparte positie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:10173839 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "Een aantal grote bedrijven in Nederland, DAF en PHILIPS te Eindhoven en KLM te Schiphol kent reeds lange tijd systemen van personeelsvervoer. Volgens een onderzoek van de FNV (1990) zijn de systemen bij deze bedrijven representatief voor de in Nederland voorkomende vormen van personeelsvervoer. Bijlage 4 gaat nader in op deze bedrijfs- vervoer activiteiten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Den Haag" ;
            sgpl:text_context "Deze gebieden zijn: - Amsterdam: Zuidoost en Schiphol. - Den Haag: Bezuidenhout. - Rotterdam: Kop van Zuid en \"De Maas\"." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5887 ;
            sgpl:subjectText "vervoermanagement" ;
            sgpl:text_context "Dit spoor ligt in het verlengde van het experiment met het bedrijfsvervoerplan \"de Maas\". Het beleid van de indirecte benadering is onder de termen gebiedsgewijze en bedrijfsgerichte aanpak verwoord in SVV II, luik 4, spoor 30; getiteld \"Introductie vervoermanagement bij bedrijven en in bedrijfsgebieden door middel van het stimuleren van bedrijfsvervoerplannen\". Nu het bedrijf in spoor 30 verantwoordelijk gesteld wordt voor de vervoersproduktie van zijn werknemers ligt er een taak voor die bedrijven om door ingrijpen in de genoemde factoren de vervoerswijze-keuze te beïnvloeden." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "bedrijfsvervoerplannen" ;
            sgpl:text_context "Dit werkstuk is de weerslag van ons leeronderzoek dat handelt over vervoermanagement i.c. bedrijfsvervoerplannen en marketing. Het bedrijfsvervoerplan voor kantoorlocatie \"de Maas\" heeft daarbij als inspiratiebron gediend. Als 'vaste bewoners' van dit kantoorgebouw verkeerden we in de gelukkige positie om de wording en uitwerking van een van de eerste bedrijfsvervoerplannen in Nederland van nabij mee te maken." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "marketingmanagement" ;
            sgpl:text_context "Na de fase van strategische planvorming volgt het marketing-managementproces. Dit proces leidt tot het opstellen van een marketingplan. Het plan dient voor de sturing en coördinatie van de marketing-inspanningen." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "bedrijfsvervoerplannen" ;
            sgpl:text_context "Dit werkstuk is de weerslag van ons leeronderzoek dat handelt over vervoermanagement i.c. bedrijfsvervoerplannen en marketing. Het bedrijfsvervoerplan voor kantoorlocatie \"de Maas\" heeft daarbij als inspiratiebron gediend. Als 'vaste bewoners' van dit kantoorgebouw verkeerden we in de gelukkige positie om de wording en uitwerking van een van de eerste bedrijfsvervoerplannen in Nederland van nabij mee te maken." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "marketingmanagement" ;
            sgpl:text_context "Na de fase van strategische planvorming volgt het marketing-managementproces. Dit proces leidt tot het opstellen van een marketingplan. Het plan dient voor de sturing en coördinatie van de marketing-inspanningen." ],
        [ sgpl:refersToConcept unesco:concept5887 ;
            sgpl:subjectText "vervoermanagement" ;
            sgpl:text_context "Dit spoor ligt in het verlengde van het experiment met het bedrijfsvervoerplan \"de Maas\". Het beleid van de indirecte benadering is onder de termen gebiedsgewijze en bedrijfsgerichte aanpak verwoord in SVV II, luik 4, spoor 30; getiteld \"Introductie vervoermanagement bij bedrijven en in bedrijfsgebieden door middel van het stimuleren van bedrijfsvervoerplannen\". Nu het bedrijf in spoor 30 verantwoordelijk gesteld wordt voor de vervoersproduktie van zijn werknemers ligt er een taak voor die bedrijven om door ingrijpen in de genoemde factoren de vervoerswijze-keuze te beïnvloeden." ] ;
    sgpl:thesisID 230 .

sgpl:Thesis231 a sgpl:SGPLThesis ;
    dcterms:creator "Marca V.C. Wolfensberger" ;
    dcterms:issued 1991 ;
    dcterms:title "drie dorpen in Friesland",
        "regionale binding en kerkelijkheid" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747063 ;
            sgpl:spatialText "Sneek" ;
            sgpl:text_context "De verzorgingsniveaus kunnen per dorp sterk verschillen. De verwachting is dan dat de dagelijkse goederen in het eigen dorp gekocht zullen worden, de verbruikersgoederen in Sneek of IJlst en de duurzame goederen in Leeuwarden. Verder kan winkelgedrag sterk be)nvloed worden door de vervoermiddelen die men ter beschikking heeft." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753379 ;
            sgpl:spatialText "IJlst" ;
            sgpl:text_context "De verzorgingsniveaus kunnen per dorp sterk verschillen. De verwachting is dan dat de dagelijkse goederen in het eigen dorp gekocht zullen worden, de verbruikersgoederen in Sneek of IJlst en de duurzame goederen in Leeuwarden. Verder kan winkelgedrag sterk be)nvloed worden door de vervoermiddelen die men ter beschikking heeft." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "de provincie Friesland" ;
            sgpl:text_context "5.2 de keuze voor de provincie Friesland. Friesland het 'paradijs’ voor onderzoek 42. 5.3 Friesland onderverdeeld 44." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754712 ;
            sgpl:spatialText "Heeg" ;
            sgpl:text_context "In Heeg is de hervormde predikant Griffioen een oude bekende. Hij staat er al meer dan 22 jaar en hij wil er blijven tot zijn emeritaat. Weinig spannends meer te beleven, hij is er gewoon." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Wymbritseradeel" ;
            sgpl:text_context "Wymbritseradeel, 1664. Historisch geografische structuur Wymbritseradeel. Friesland, gemeentegrenzen en namen, 1971." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755781 ;
            sgpl:spatialText "Gaastmeer" ;
            sgpl:text_context "In de zomer wordt er één dienst per zondag gehouden. In Gaastmeer zijn ze vooruitstrevend. Of dit uit nood geboren is, maakt niet uit." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751792 ;
            sgpl:spatialText "Leeuwarden" ;
            sgpl:text_context "De verzorgingsniveaus kunnen per dorp sterk verschillen. De verwachting is dan dat de dagelijkse goederen in het eigen dorp gekocht zullen worden, de verbruikersgoederen in Sneek of IJlst en de duurzame goederen in Leeuwarden. Verder kan winkelgedrag sterk be)nvloed worden door de vervoermiddelen die men ter beschikking heeft." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Calvinistisch Nederland wordt gekenmerkt door het opgeheven vingertje, door rechtlijnigheid en moralisme, door hard werken en ascese, door zuinigheid, betweterigheid en stijfheid. Alle Nederlanders schijnen deze calvinistische trekjes te hebben, ongeacht of ze protestant, rooms-katholiek of onkerkelijk zijn. Het ’savoir vivre’ is aan anderen voorbehouden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2755812 ;
            sgpl:spatialText "Friesland" ;
            sgpl:text_context "Ik bied u een scriptie aan waar ik met zeer veel plezier aan gewerkt heb. Als u gewoon leuke zaken over Friesland lezen wilt, dan moet u deel twee en drie ter hand nemen. Deel één is wat zwaarder, maar zeker niet minder interessant." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749138 ;
            sgpl:spatialText "Oudega" ;
            sgpl:text_context "In Oudega zijn ze heel duidelijk; bijna de helft geeft als reden op dat mensen naar de kerk gaan ’ter versterking van geloof, omdat je gelooft en om kracht te krijgen.’ In Gaastmeer wordt deze reden ook door het grootste aandeel gezegd. Daarna geeft men in beide plaatsen de reden 'gewoonte, opvoeding en traditie’." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Noord-Oosten" ;
            sgpl:text_context "Of wel het gereformeerde Noord-Oosten, of wel het hervormde Zuid-Westen. Behalve dat de keuze voor het hervormde gebied als elegante middenoplossing gezien kan worden is bekendheid met het onderwerp een doorslaggevende factor geweest. Zo kwamen wij in het Zuid-Westen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Zuidwesthoek" ;
            sgpl:text_context "In welke van de vier gaan we onderzoek doen? Het wordt de Zuidwesthoek die zich typeert door een groot aandeel hervormden. Binnen de Zuidwesthoek kiezen we voor de gemeente Wymbritseradeel." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept14468 ;
            sgpl:subjectText "Regionale binding" ;
            sgpl:text_context "Al lezend en studerend is onze voorlopige werkvraag overgegaan in de volgende probleemstelling die richting geeft aan het uiteindelijke onderzoek. In hoeverre is de aard van de kerkelijkheid bepalend voor de verschillende mate en soorten van regionale binding van een bevolking, onderzocht op dorpsniveau? De probleemstelling en de achterliggende theorie zijn weer te geven als conceptueel model van de theorie: zie figuur 1.1." ],
        [ sgpl:refersToConcept unesco:concept5448 ;
            sgpl:subjectText "Nieuwe regionale geografie" ;
            sgpl:text_context "Er is veel aan de hand binnen de nieuwe regionale geografie. De nieuwe regionale geografie is op de meest essentiële punten wezenlijk anders dan de oude regionale geografie. De twee richtingen verschillen niet alleen op het methodologische vlak, maar ook in de achterliggende filosofie." ],
        [ sgpl:refersToConcept unesco:concept290 ;
            sgpl:subjectText "Kerkelijkheid" ;
            sgpl:text_context "Zo’n andere keus is bijvoorbeeld de godsdienstigheid, meer concreet de kerkelijkheid - dit laatste althans in die cultuurgebieden die gestempeld zijn door het Christendom. De kerkelijkheid is een algemeen proces dat zich bij uitstek leent om te illustreren dat algemene processen in concreto altijd een ruimtelijke dimensie in zich integreren. Zoals het kapitalisme als enkelvoudige oorzaak de geografische context niet uitputtend kan verklaren, net zo min kan de kerkelijkheid dat." ],
        [ sgpl:refersToConcept unesco:concept14468 ;
            sgpl:subjectText "Regionale binding" ;
            sgpl:text_context "Al lezend en studerend is onze voorlopige werkvraag overgegaan in de volgende probleemstelling die richting geeft aan het uiteindelijke onderzoek. In hoeverre is de aard van de kerkelijkheid bepalend voor de verschillende mate en soorten van regionale binding van een bevolking, onderzocht op dorpsniveau? De probleemstelling en de achterliggende theorie zijn weer te geven als conceptueel model van de theorie: zie figuur 1.1." ],
        [ sgpl:refersToConcept unesco:concept290 ;
            sgpl:subjectText "Kerkelijkheid" ;
            sgpl:text_context "Zo’n andere keus is bijvoorbeeld de godsdienstigheid, meer concreet de kerkelijkheid - dit laatste althans in die cultuurgebieden die gestempeld zijn door het Christendom. De kerkelijkheid is een algemeen proces dat zich bij uitstek leent om te illustreren dat algemene processen in concreto altijd een ruimtelijke dimensie in zich integreren. Zoals het kapitalisme als enkelvoudige oorzaak de geografische context niet uitputtend kan verklaren, net zo min kan de kerkelijkheid dat." ],
        [ sgpl:refersToConcept unesco:concept5448 ;
            sgpl:subjectText "Nieuwe regionale geografie" ;
            sgpl:text_context "Er is veel aan de hand binnen de nieuwe regionale geografie. De nieuwe regionale geografie is op de meest essentiële punten wezenlijk anders dan de oude regionale geografie. De twee richtingen verschillen niet alleen op het methodologische vlak, maar ook in de achterliggende filosofie." ] ;
    sgpl:thesisID 231 .

sgpl:Thesis232 a sgpl:SGPLThesis ;
    dcterms:creator "Christel Woutersen" ;
    dcterms:issued 1991 ;
    dcterms:title "Regionale verschillen in het gebruik van verpleeghuizen door ouderen",
        "Verslagen van leeronderzoek G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747373 ;
            sgpl:spatialText "Gemeente Den Haag" ;
            sgpl:text_context "Voor de psycho-geriatrische pati&euml;nten zijn minimaal 1,25 bedden per 100 inwoners van 65 jaar en ouder nodig. Voor de gemeenten Amsterdam, Rotterdam en Den Haag geldt naast de norm voor de totale bevolking een verhoogde norm van 2,9% van de inwoners van 65 jaar en ouder. De deelnorm van de psycho-geriatrie is voor deze steden minimaal 1,5%." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Ter afronding van de studie Sociale Geografie dient een student een doctoraalonderzoek te verrichten en hierover een afstudeerscriptie te schrijven. De onderwerpkeuze binnen de vakgroep Toegepaste Geografie en Planologie aan de Rijksuniversiteit Utrecht met de door mij gekozen specialisatierichting Economische Geografie is zeer divers. Ik heb gekozen voor een onderzoek in de gezondheidszorg." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3319179 ;
            sgpl:spatialText "Flevoland" ;
            sgpl:text_context "Uit figuur 1.3. blijkt dat de uitstroom voor de regio’s ’s-Gravenhage, Zwolle en Midden-Holland hoog is. Aangezien in Flevoland geen verpleeghuiscapaciteit is, kan alleen buiten de regio gebruik gemaakt worden van verpleeghuiscapaciteit, de uitstroom is dan ook 100%. Figuur 1.1. Indeling in gezondheidsregio’s ex artikel 3 WZV Gezondheidsregio’s 1." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Gemeente Rotterdam" ;
            sgpl:text_context "Voor de psycho-geriatrische pati&euml;nten zijn minimaal 1,25 bedden per 100 inwoners van 65 jaar en ouder nodig. Voor de gemeenten Amsterdam, Rotterdam en Den Haag geldt naast de norm voor de totale bevolking een verhoogde norm van 2,9% van de inwoners van 65 jaar en ouder. De deelnorm van de psycho-geriatrie is voor deze steden minimaal 1,5%." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990,
                geonames:2751596 ;
            sgpl:spatialText "Brabantse en Limburgse gezondheidsregio’s" ;
            sgpl:text_context "In de gezondheidsregio’s Groningen, Friesland, ’t Gooi, Kennemerland, ’s-Gravenhage en Zeeland is het aantal 80-plussers ten opzichte van het totaal aantal ouderen meer dan 23%. In met name de Brabantse en Limburgse gezondheidsregio’s is de bevolking minder \"dubbel vergrijsd\". In Flevoland is het aandeel van de 80-plussers ten opzichte van alle ouderen minder dan 10% (zie tabel 3.2. en figuur 3.2.)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759793 ;
            sgpl:spatialText "Gemeente Amsterdam" ;
            sgpl:text_context "Voor de psycho-geriatrische pati&euml;nten zijn minimaal 1,25 bedden per 100 inwoners van 65 jaar en ouder nodig. Voor de gemeenten Amsterdam, Rotterdam en Den Haag geldt naast de norm voor de totale bevolking een verhoogde norm van 2,9% van de inwoners van 65 jaar en ouder. De deelnorm van de psycho-geriatrie is voor deze steden minimaal 1,5%." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In 1995 zal dit waarschijnlijk gestegen zijn tot 13,3% en in 2000 tot 13,8%. Binnen Nederland is er sprake van regionale verschillen in de ontwikkeling van de vergrijzing. Zo is er in de grote steden op het moment sprake van een sterkere vergrijzing dan in de rest van Nederland." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5448 ;
            sgpl:subjectText "regionale verschillen" ;
            sgpl:text_context "Dit onderzoek kan derhalve beschouwd worden als een voorstudie in het kader van de advisering over het toekomstige normenstelsel. Met behulp van dit onderzoek zal getracht worden door een analyse van de bestaande regionale verschillen in het gebruik van verpleeghuizen een aantal variabelen voor te dragen die voor de normering van belang kunnen zijn. Aangezien ouderen, personen van 65 jaar en ouder, ruim 90% van het totale gebruik van verpleeghuisbedden veroorzaken, richt het onderzoek zich op het gebruik door deze bevolkingscategorie." ],
        [ sgpl:refersToConcept unesco:concept11779 ;
            sgpl:subjectText "verpleeghuiscapaciteit" ;
            sgpl:text_context "Naast de klinische functie is er in verpleeghuizen ook de mogelijkheid van dagbehandeling (ambulant). De behoefte aan verpleeghuiscapaciteit is uitgewerkt in de planningsrichtlijnen ex artikel 3 WZN? In de richtlijnen zijn namelijk de behoeftenormen opgenomen." ],
        [ sgpl:refersToConcept unesco:concept1670 ;
            sgpl:subjectText "dubbele vergrijzing" ;
            sgpl:text_context "Binnen de groep ouderen is bovendien sprake van een toename van de gemiddelde leeftijd. Deze veroudering, ook wel \"dubbele vergrijzing\" genoemd, betekent dat het aantal 80-plussers binnen de groep ouderen relatief toeneemt. Het absolute aantal ouderen nam toe van 794.491 in 1950, via 1.189.684 in 1965, via 1.615.324 in 1980 tot 1.906.048 in 1989." ],
        [ sgpl:refersToConcept unesco:concept11779 ;
            sgpl:subjectText "verpleeghuiscapaciteit" ;
            sgpl:text_context "Naast de klinische functie is er in verpleeghuizen ook de mogelijkheid van dagbehandeling (ambulant). De behoefte aan verpleeghuiscapaciteit is uitgewerkt in de planningsrichtlijnen ex artikel 3 WZN? In de richtlijnen zijn namelijk de behoeftenormen opgenomen." ],
        [ sgpl:refersToConcept unesco:concept5448 ;
            sgpl:subjectText "regionale verschillen" ;
            sgpl:text_context "Dit onderzoek kan derhalve beschouwd worden als een voorstudie in het kader van de advisering over het toekomstige normenstelsel. Met behulp van dit onderzoek zal getracht worden door een analyse van de bestaande regionale verschillen in het gebruik van verpleeghuizen een aantal variabelen voor te dragen die voor de normering van belang kunnen zijn. Aangezien ouderen, personen van 65 jaar en ouder, ruim 90% van het totale gebruik van verpleeghuisbedden veroorzaken, richt het onderzoek zich op het gebruik door deze bevolkingscategorie." ],
        [ sgpl:refersToConcept unesco:concept1670 ;
            sgpl:subjectText "dubbele vergrijzing" ;
            sgpl:text_context "Binnen de groep ouderen is bovendien sprake van een toename van de gemiddelde leeftijd. Deze veroudering, ook wel \"dubbele vergrijzing\" genoemd, betekent dat het aantal 80-plussers binnen de groep ouderen relatief toeneemt. Het absolute aantal ouderen nam toe van 794.491 in 1950, via 1.189.684 in 1965, via 1.615.324 in 1980 tot 1.906.048 in 1989." ] ;
    sgpl:thesisID 232 .

sgpl:Thesis233 a sgpl:SGPLThesis ;
    dcterms:creator "Tonja Amse" ;
    dcterms:issued 1992 ;
    dcterms:title "Promotie en bedrijfsacquisitie in regio Arnhem-Nijmegen",
        "REGIOMARKETING" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmegen" ;
            sgpl:text_context "Door de houding van het Rijk wordt deze houding nog eens bevorderd, aangezien aan grote steden een aparte status, 'stedelijk knooppunt',is toegekend in de verhouding lokale overheid en rijksoverheid. In de Vierde nota ruimtelijke ordening werden de steden Nijmegen en Arnhem gezamenlijk aangewezen als stedelijk knooppunt. Arnhem-Nijmegen heeft de status van stedelijk knooppunt gekregen op basis van hun (inter-)nationale positie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751607 ;
            sgpl:spatialText "regio 'Liemers'" ;
            sgpl:text_context "Doel: Verbetering van de produktiestructuur door middel van het leveren van een bijdrage aan het totstandkomen van nieuwe economische activiteiten in de regio 'Liemers'. Opgeheven: januari 1992. Bedrijfsregio Nijmegen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "oostelijk deel van de Over-Betuwe" ;
            sgpl:text_context "De regio wordt planologisch gekenmerkt door de aanwezigheid van twee sterke centrumgemeenten en het daartussen gelegen oostelijk deel van de Over-Betuwe, ook wel aangeduid als het tussengebied Arnhem-Nijmegen met Elst als voornaamste kern. De beide centrumgemeenten hebben elk hun eigen verzorgingsgebied en hebben zich lange tijd onafhankelijk van elkaar ontwikkeld. Arnhem meer als bestuurs- en kantorenstad, Nijmegen meer als universiteits- en bedrijvenstad." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750053,
                geonames:2759661 ;
            sgpl:spatialText "regio Arnhem-Nijmegen" ;
            sgpl:text_context "REGIOMARKETING. Promotie en bedrijfsacquisitie in regio Arnhem-Nijmegen. TON JA AMSE." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759661 ;
            sgpl:spatialText "Arnhem" ;
            sgpl:text_context "Door de houding van het Rijk wordt deze houding nog eens bevorderd, aangezien aan grote steden een aparte status, 'stedelijk knooppunt',is toegekend in de verhouding lokale overheid en rijksoverheid. In de Vierde nota ruimtelijke ordening werden de steden Nijmegen en Arnhem gezamenlijk aangewezen als stedelijk knooppunt. Arnhem-Nijmegen heeft de status van stedelijk knooppunt gekregen op basis van hun (inter-)nationale positie." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Europa" ;
            sgpl:text_context "Langzamerhand wordt echter steeds meer de vraag gesteld of citymarketing 'uit' raakt en regiomarketing 'in'. Steeds vaker wordt er door de rijksoverheid aangedrongen op samenwerking tussen verschillende gemeenten en als in 1992 de grenzen binnen Europa steeds meer vervagen, zullen de marktposities van regio's doorslaggevender worden. Aan de andere kant zijn er ook uitspraken die twijfel uiten over regiomarketing." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "bedrijfsregio Nijmegen" ;
            sgpl:text_context "De gemeente Beuningen voert van gemeentewege nauwelijks een promotie- en acquisitiebeleid, maar wel tot op zekere hoogte vanuit bedrijfsregio Nijmegen. Bij de gemeenten die wel een promotie- en acquisitiebeleid voeren is gekeken naar de doelgroep(en) van het beleid. De gemeenten hebben aangegeven of ze zich richten op bedrijven die al in de gemeente gevestigd zijn en/of op bedrijven in de regio en/of op bedrijven buiten de regio en/of bedrijven in het buitenland." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745088 ;
            sgpl:spatialText "Wageningen" ;
            sgpl:text_context "Uit tabel 5.2 blijkt dat de centrumgemeenten de hoogste prijzen per m2 hanteren samen met Wageningen en Heteren wat de prijs per m2 betreft gering is. Bovendien blijkt dat de kleinere gemeenten binnen het Rijk van Nijmegen, die buiten de Bedrijfsregio Nijmegen vallen, een aanmerkelijk lagere prijs per m2 hanteren. De gemeenten die buiten het Knooppunt Arnhem-Nijmegen liggen in Noord-Brabant en Limburg hanteren bijna gelijke prijzen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751596 ;
            sgpl:spatialText "Limburg" ;
            sgpl:text_context "De gemeenten die buiten het Knooppunt Arnhem-Nijmegen liggen in Noord-Brabant en Limburg hanteren bijna gelijke prijzen. Boxmeer en Cuyk hebben ook aangegeven dat wat de grondprijzen betreft er afstemming plaatsvindt met de omringende gemeenten. Wel geven de gemeente Cuyk en Nijmegen aan dat ze voor zichtlokaties aanzienlijk hogere prijzen hanteren (resp. ƒ 93,- en ƒ 140,-)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Rijk van Nijmegen" ;
            sgpl:text_context "Bovendien blijkt dat de kleinere gemeenten binnen het Rijk van Nijmegen, die buiten de Bedrijfsregio Nijmegen vallen, een aanmerkelijk lagere prijs per m2 hanteren. De gemeenten die buiten het Knooppunt Arnhem-Nijmegen liggen in Noord-Brabant en Limburg hanteren bijna gelijke prijzen. Boxmeer en Cuyk hebben ook aangegeven dat wat de grondprijzen betreft er afstemming plaatsvindt met de omringende gemeenten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "A.L. Amse. Houtmankade 93hs. 1013 MT Amsterdam. 020 - 620 TJ 39." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Sedert een aantal jaren worden de steden in Nederland op een andere wijze bekeken dan gebruikelijk was. In het begin van de jaren tachtig kwam de stedelijke problematiek steeds weer aan de orde in de vakliteratuur over steden. De problemen die zich in de steden concentreren zijn niet minder dringend geworden, maar thans wordt de stad meer optimistisch benaderd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "I acid lei. der Ruimtelijke Wetenschappen, Rijksuniversiteit Utrecht. I luide Iberglaan 2, 3584 CS Utrecht, 030-531399/532044. REGIOMARKETING." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750053,
                geonames:2759661 ;
            sgpl:spatialText "Knooppunt Arnhem-Nijmegen" ;
            sgpl:text_context "De gemeenten zijn gekozen op basis van het feit dat de twee WGR-regio's uitgangspunt zijn voor de bepaling van de omvang van Knooppunt Arnhem-Nijmegen (KAN), maar dat er tevens 4 gemeenten zijn die in aanmerking komen voor het lidmaatschap van Knooppunt Arnhem-Nijmegen. Van 25 gemeenten werd een reactie ontvangen ofwel 76 %. De populatie is ingedeeld in vijf grootteklassen, elk naar inwonertal, zodat een vergelijkend beeld kan worden verkregen tussen de dan ontstane populaties." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "De gemeenten die buiten het Knooppunt Arnhem-Nijmegen liggen in Noord-Brabant en Limburg hanteren bijna gelijke prijzen. Boxmeer en Cuyk hebben ook aangegeven dat wat de grondprijzen betreft er afstemming plaatsvindt met de omringende gemeenten. Wel geven de gemeente Cuyk en Nijmegen aan dat ze voor zichtlokaties aanzienlijk hogere prijzen hanteren (resp. ƒ 93,- en ƒ 140,-)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Duitsland" ;
            sgpl:text_context "Participanten publiek: Diverse gemeenten in Duitsland en Nederland, o.a. Arnhem, Nijmegen, Kleef en Emmerich. Doel: Te komen tot concrete projecten ten einde een deel van de EEG-subsidie bestemd voor grensoverschrijdende projecten beschikbaar te krijgen. Hoofdstuk 4 Het produkt: regio Arnhem-Nijmegen als vestigingsplaats voor bedrijven." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "citymarketing" ;
            sgpl:text_context "Steden gaan zich actief opstellen bij het aantrekken van bedrijven, bewoners en bezoekers. Deze marktgerichtheid van steden is in zeer korte tijd bekend geworden als citymarketing. Er zijn vele definities van citymarketing." ],
        [ sgpl:refersToConcept unesco:concept8751 ;
            sgpl:subjectText "regiomarketing" ;
            sgpl:text_context "Hij gaf hiermee aan dat het om zowel steden als regio's kan gaan. Bij het hanteren van marketingconcepten op grotere ruimtelijke eenheden dan steden of plaatsen, spreken we van regiomarketing. Ik zou graag het begrip 'plaatsmarketing' voor alle ruimtelijke eenheden willen invoeren, maar omdat citymarketing en regiomarketing de gebruikelijke begrippen zijn, zal ik deze begrippen ook aan houden." ],
        [ sgpl:refersToConcept unesco:concept511 ;
            sgpl:subjectText "bedrijfsacquisitie" ;
            sgpl:text_context "Daarna zal het promotie- en acquisitiebeleid van de gemeenten aan de orde komen. Acquisitie is het aantrekken c.q. werven van bedrijven met als belangrijkste doelstelling het versterken van de economische structuur. Het aktief verstrekken van relevante informatie aan geïnteresseerde bedrijven, een professionele promotie en een aktieve opstelling als intermediair bij het zoeken naar een geschikte lokatie, bij vergunningen verlenen en krediet verlening moet leiden tot nieuwe vestiging van bedrijven." ],
        [ sgpl:refersToConcept unesco:concept511 ;
            sgpl:subjectText "bedrijfsacquisitie" ;
            sgpl:text_context "Daarna zal het promotie- en acquisitiebeleid van de gemeenten aan de orde komen. Acquisitie is het aantrekken c.q. werven van bedrijven met als belangrijkste doelstelling het versterken van de economische structuur. Het aktief verstrekken van relevante informatie aan geïnteresseerde bedrijven, een professionele promotie en een aktieve opstelling als intermediair bij het zoeken naar een geschikte lokatie, bij vergunningen verlenen en krediet verlening moet leiden tot nieuwe vestiging van bedrijven." ],
        [ sgpl:refersToConcept unesco:concept8751 ;
            sgpl:subjectText "regiomarketing" ;
            sgpl:text_context "Hij gaf hiermee aan dat het om zowel steden als regio's kan gaan. Bij het hanteren van marketingconcepten op grotere ruimtelijke eenheden dan steden of plaatsen, spreken we van regiomarketing. Ik zou graag het begrip 'plaatsmarketing' voor alle ruimtelijke eenheden willen invoeren, maar omdat citymarketing en regiomarketing de gebruikelijke begrippen zijn, zal ik deze begrippen ook aan houden." ],
        [ sgpl:refersToConcept unesco:concept1545 ;
            sgpl:subjectText "citymarketing" ;
            sgpl:text_context "Steden gaan zich actief opstellen bij het aantrekken van bedrijven, bewoners en bezoekers. Deze marktgerichtheid van steden is in zeer korte tijd bekend geworden als citymarketing. Er zijn vele definities van citymarketing." ] ;
    sgpl:thesisID 233 .

sgpl:Thesis234 a sgpl:SGPLThesis ;
    dcterms:creator "Renske J. Bergsma" ;
    dcterms:issued 1992 ;
    dcterms:title "DE WONINGTOEWIJZING IN STADSVERNIEUWINGSGEBIEDEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam" ;
            sgpl:text_context "De leeronderzoeken handelen over verhuisgedrag van huishoudens in stadsvernieuwingsgebieden. De onderzoeken zijn uitgevoerd in de gemeenten Rotterdam en Amsterdam. In beide gemeenten zijn twee verschillende stadsvernieuwingsgebieden geselecteerd waar een groot aantal enquêtes is afgenomen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "De leeronderzoeken handelen over verhuisgedrag van huishoudens in stadsvernieuwingsgebieden. De onderzoeken zijn uitgevoerd in de gemeenten Rotterdam en Amsterdam. In beide gemeenten zijn twee verschillende stadsvernieuwingsgebieden geselecteerd waar een groot aantal enquêtes is afgenomen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Kinkerbuurt-Noord" ;
            sgpl:text_context "De cases die uit deze criteria zijn voortgekomen zijn in: Rotterdam: 1) Hillesluis (sterke groei aantal niet-Nederlanders) 2) Oude Noorden (middelmatige groei). Amsterdam: 1) Indische Buurt ten oosten van Molukkenstraat (snelle groei) 2) Kinkerbuurt-Noord (middelmatige groei)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Hillesluis" ;
            sgpl:text_context "De cases die uit deze criteria zijn voortgekomen zijn in: Rotterdam: 1) Hillesluis (sterke groei aantal niet-Nederlanders) 2) Oude Noorden (middelmatige groei). Amsterdam: 1) Indische Buurt ten oosten van Molukkenstraat (snelle groei) 2) Kinkerbuurt-Noord (middelmatige groei)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Indische Buurt Oost" ;
            sgpl:text_context "Vervolgens wordt elke zoveelste woning in de steekproef opgenomen. Om de verschillende wijken met elkaar te kunnen vergelijken zijn er per wijk evenveel enquêtes afgenomen. In Amsterdam kreeg in de Indische Buurt Oost 1 op de 34 woningen de introductiebrief, in de Kinkerbuurt 1 op de 23." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het aantal particuliere meergezins huurwoningen, gebouwd voor 1930. Het gemiddelde inkomen in de gemeente, gerelateerd aan het gemiddelde inkomen in Nederland. Het verzorgingsniveau van de gemeente." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Oude Noorden" ;
            sgpl:text_context "De cases die uit deze criteria zijn voortgekomen zijn in: Rotterdam: 1) Hillesluis (sterke groei aantal niet-Nederlanders) 2) Oude Noorden (middelmatige groei). Amsterdam: 1) Indische Buurt ten oosten van Molukkenstraat (snelle groei) 2) Kinkerbuurt-Noord (middelmatige groei)." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Ook de huidige woonsituatie kan aan de wensen van de bewoners aangepast worden door het gebruik van deze woonplek te wijzigen of de woonplek te verbouwen. Stadsvernieuwing levert een wezenlijke bijdrage hieraan. Woningen en woonomgeving ondergaan hiermee een verbetering om de leefbaarheid te vergroten." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "woningtoewijzing" ;
            sgpl:text_context "RIJKSUNIVERSITEIT TE UTRECHT 2284 866 1 VOORWOORD Deze scriptie is een verslag van een afstudeeronderzoek naar woningtoewijzing in de stadsvernieuwingsgebieden. Dit onderzoek is verricht als onderdeel van het doctoraalexamen sociale geografie, specialisatie stads- en plattelandsgeografie bij de faculteit Ruimtelijke wetenschappen aan de Rijksuniversiteit Utrecht." ],
        [ sgpl:refersToConcept unesco:concept1600 ;
            sgpl:subjectText "toewijzingsbeleid" ;
            sgpl:text_context "Na bestudering van beide onderzoeken en literatuur is een hoofdprobleemstelling ontstaan. Hoe functioneert het toewijzingsbeleid in stadsvernieuwingsgebieden in de gemeenten Rotterdam en Amsterdam? Bestaat er verschil in de wijze hoe niet-Nederlanders aan een woning komen?" ],
        [ sgpl:refersToConcept unesco:concept15971 ;
            sgpl:subjectText "stadsvernieuwing" ;
            sgpl:text_context "Ook de huidige woonsituatie kan aan de wensen van de bewoners aangepast worden door het gebruik van deze woonplek te wijzigen of de woonplek te verbouwen. Stadsvernieuwing levert een wezenlijke bijdrage hieraan. Woningen en woonomgeving ondergaan hiermee een verbetering om de leefbaarheid te vergroten." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "woningtoewijzing" ;
            sgpl:text_context "RIJKSUNIVERSITEIT TE UTRECHT 2284 866 1 VOORWOORD Deze scriptie is een verslag van een afstudeeronderzoek naar woningtoewijzing in de stadsvernieuwingsgebieden. Dit onderzoek is verricht als onderdeel van het doctoraalexamen sociale geografie, specialisatie stads- en plattelandsgeografie bij de faculteit Ruimtelijke wetenschappen aan de Rijksuniversiteit Utrecht." ],
        [ sgpl:refersToConcept unesco:concept1600 ;
            sgpl:subjectText "toewijzingsbeleid" ;
            sgpl:text_context "Na bestudering van beide onderzoeken en literatuur is een hoofdprobleemstelling ontstaan. Hoe functioneert het toewijzingsbeleid in stadsvernieuwingsgebieden in de gemeenten Rotterdam en Amsterdam? Bestaat er verschil in de wijze hoe niet-Nederlanders aan een woning komen?" ] ;
    sgpl:thesisID 234 .

sgpl:Thesis235 a sgpl:SGPLThesis ;
    dcterms:creator "Harriëtte Bongers" ;
    dcterms:issued 1992 ;
    dcterms:title "DE VERZELFSTANDIGING NADER BEKEKEN: WONINGCORPORATIES OP WEG NAAR SOCIAAL ONDERNEMERSCHAP",
        "VERSLAGEN VAN LEERONDERZOEK G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Vakgroep Toegepaste Geografie én Planologie. Utrecht, augustus 1992. VOORWOORD Deze scriptie is geschreven in het kader van mijn afstudeeronderzoek voor de studie Sociale Geografie met als specialisatie Planologie aan de Rijksuniversiteit te Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757345 ;
            sgpl:spatialText "Delftse" ;
            sgpl:text_context "Anderzijds verwacht men een inititatiefrijke opstelling van deze klant, waarbij een woonkrant wordt ingevoerd met informatie over het aanbod, waarop de woningzoekende kan reageren. Het gaat hierbij om een aangepaste vorm van het Delftse woontoewijzingssysteem (DOW, 1991). 6 CONCLUSIE." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750053 ;
            sgpl:spatialText "Nijmegen" ;
            sgpl:text_context "In het bijzonder wil ik Bart van der Laag bedanken voor zijn nuttige adviezen vooraf en zijn respons op het concept van deze scriptie. Daarnaast heb ik het buitengewoon op prijs gesteld dat Jaap van 't Hek van het GITP/Management Advies Bureau uit Nijmegen, met mij over het onderwerp van gedachte wilde wisselen. Het enthousiasme waarmee mevrouw L. Bolier me wat meer over Onze Woning heeft verteld, heeft me zeer aangesproken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756987 ;
            sgpl:spatialText "Deventer" ;
            sgpl:text_context "Als case is bovengenoemde vraag tevens voor een bestaande woningcorporatie gesteld: Hoe denkt woningbouwvereniging Onze Woning uit Deventer in te spelen op de verzelfstandiging? Deze vraag is grotendeels in stageverband beantwoord, doordat er is deelgenomen aan een project van Companen betreffende de opstelling van een strategisch beleidsplan voor deze woning- bouwvereniging." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2753874 ;
            sgpl:spatialText "Holten" ;
            sgpl:text_context "In Deventer zelf behoort Onze Woning samen met nog een andere corporatie tot de grootste verhuurders in de sociale huursector. Naast bezit in Deventer heeft de corporatie ook noemenswaardig bezit in de aangrenzende gemeenten Diepenveen en Holten. De doelstelling het uitsluitend werkzaam zijn in het belang van de volkshuisvesting in de gemeente Deventer, Diepenveen en Holten tracht 'Onze Woning' vorm te geven door: het stichten en in stand houden van woningen die aan de eisen van de tijd beantwoorden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Non-profit verhuur komt in alle Westeuropese landen voor. Nederland neemt echter een unieke positie in. De sociale huursector neemt er maar liefst 42% van de woningvoorraad voor haar rekening (Companen (1), 1992)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756875 ;
            sgpl:spatialText "Diepenveen" ;
            sgpl:text_context "In Deventer zelf behoort Onze Woning samen met nog een andere corporatie tot de grootste verhuurders in de sociale huursector. Naast bezit in Deventer heeft de corporatie ook noemenswaardig bezit in de aangrenzende gemeenten Diepenveen en Holten. De doelstelling het uitsluitend werkzaam zijn in het belang van de volkshuisvesting in de gemeente Deventer, Diepenveen en Holten tracht 'Onze Woning' vorm te geven door: het stichten en in stand houden van woningen die aan de eisen van de tijd beantwoorden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759661 ;
            sgpl:spatialText "Arnhem" ;
            sgpl:text_context "Gezien de aard van het onderwerp heeft dit onderzoek een beschrijvend karakter. Dit onderzoek heeft gedeeltelijk in stageverband plaatsgevonden bij Companen: adviesgroep voor beleid; onderzoek en planning te Arnhem. De laatste deelvraag is daar grotendeels beantwoord doordat er deelgenomen is aan het project betreffende de opstelling van een strategisch beleidsplan voor de woningbouwvereniging Onze Woning uit Deventer." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept3399 ;
            sgpl:subjectText "verzelfstandiging" ;
            sgpl:text_context "Vervolgens is antwoord gegeven op de vraag wat de verzelfstandiging formeel gezien inhoudt. De belangrijkste drijfveer voor de huidige verzelfstandiging is de discussie omtrent de betaalbaarheid en effectiviteit van de volkshuisvesting. Deze gedachtengang vindt zijn weerslag voor de woningcorporatie met name in drie rapporten die elkaar min of meer completeren." ],
        [ sgpl:refersToConcept unesco:concept17186 ;
            sgpl:subjectText "sociaal ondernemerschap" ;
            sgpl:text_context "Woningcorporaties staan hierdoor op een keerpunt. Een keerpunt, omdat de overgang naar financiële zelfstandigheid gepaard gaat met de omslag van een voornamelijk uitvoerende organisatie; sterk afhankelijk van overheidsregels naar sociaal ondernemerschap: van doorgeefluik naar kok. Dit vertaalt zich in een andere rationaliteit, een andere machtssituatie en een andere bedrijfscultuur." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "Besluit Beheer Sociale Huursector" ;
            sgpl:text_context "Advies inzake het Besluit Beheer Sociale Huursector (RAVO, 1992). De inhoud van deze rapporten zal zich in 1993 voor woningcorporaties in wetgeving vertalen, door de invoering van het Besluit Beheer Sociale Huursector (BBSH), dat het BTIV gaat vervangen. In essentie komt deze formele verzelfstandiging op het volgende neer." ],
        [ sgpl:refersToConcept unesco:concept17186 ;
            sgpl:subjectText "sociaal ondernemerschap" ;
            sgpl:text_context "Woningcorporaties staan hierdoor op een keerpunt. Een keerpunt, omdat de overgang naar financiële zelfstandigheid gepaard gaat met de omslag van een voornamelijk uitvoerende organisatie; sterk afhankelijk van overheidsregels naar sociaal ondernemerschap: van doorgeefluik naar kok. Dit vertaalt zich in een andere rationaliteit, een andere machtssituatie en een andere bedrijfscultuur." ],
        [ sgpl:refersToConcept unesco:concept3399 ;
            sgpl:subjectText "verzelfstandiging" ;
            sgpl:text_context "Vervolgens is antwoord gegeven op de vraag wat de verzelfstandiging formeel gezien inhoudt. De belangrijkste drijfveer voor de huidige verzelfstandiging is de discussie omtrent de betaalbaarheid en effectiviteit van de volkshuisvesting. Deze gedachtengang vindt zijn weerslag voor de woningcorporatie met name in drie rapporten die elkaar min of meer completeren." ],
        [ sgpl:refersToConcept unesco:concept7889 ;
            sgpl:subjectText "Besluit Beheer Sociale Huursector" ;
            sgpl:text_context "Advies inzake het Besluit Beheer Sociale Huursector (RAVO, 1992). De inhoud van deze rapporten zal zich in 1993 voor woningcorporaties in wetgeving vertalen, door de invoering van het Besluit Beheer Sociale Huursector (BBSH), dat het BTIV gaat vervangen. In essentie komt deze formele verzelfstandiging op het volgende neer." ] ;
    sgpl:thesisID 235 .

sgpl:Thesis236 a sgpl:SGPLThesis ;
    dcterms:creator "Jan-Willem Boots" ;
    dcterms:issued 1992 ;
    dcterms:title "AANBEVELINGEN OP BASIS VAN EEN ANALYSE VAN EEN TWEETAL PLANNEN VOOR HERINRICHTING VAN WEGEN",
        "ONDERZOEK NAAR DE TOEPASSINGSMOGELIJKHEDEN VAN ELEMENTEN UIT DE STRATEGISCHE PLANNINGSMETHODIEK BIJ PROJEKTPLANNEN IN KLEINERE GEMEENTEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3337388 ;
            sgpl:spatialText "Vlaanderen" ;
            sgpl:text_context "Het projekt valt binnen een programma van het Belgische ministerie van Openbare Werken geheten: Programma voor leefbare bebouwde kommen door herinrich- ting van de doortochten van hoofdwegen in Vlaanderen. Het doel van dit programma is dat de verkeersleefbaarheid van bebouwde kommen die door bij het Rijk in beheer en eigendom zijnde wegen worden doorsneden, wordt verbeterd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "AANBEVELINGEN OP BASIS VAN EEN ANALYSE VAN EEN TWEETAL PLANNEN VOOR HERINRICHTING VAN WEGEN RIJKSUNIVERSITEIT UTRECHT FACULTEIT DER RUIMTELIJKE WETENSCHAPPEN VAKGROEP TOEGEPASTE GEOGRAFIE EN PLANOLOGIE. DOCTORAALSCRIPTIE Jan-Wlllem Boots maart 1992 i682." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de gemeente Zeeland" ;
            sgpl:text_context "Vervolgens zullen, gelet op het hierboven vermelde doel van het leeronderzoek, die elementen worden gedestilleerd die als referentiekader dienen bij de analyse van een tweetal min of meer vergelijkbare planprocessen: 1. het planproces van de herinrichting van de Kerkstraat—/ Udenseweg in de gemeente Zeeland 2. het in het kader van dit leeronderzoek doorlopen plan- proces van de herinrichting van de Gewestweg N—719 in de gemeente Heusden-Zolder (België). Beide planprocessen hebben een vergelijkbaar onderwerp, maar kennen een sterk verschillende werkwijze." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Amerika" ;
            sgpl:text_context "Reeds in 1978 pleit Kreukels (Kreukels, 1978) voor toepassing van de strategische planning in de ruimtelijke planning. In die tijd vindt deze plannings- methodiek, voor wat betreft de publieke sector, met name toepassing in Amerika. Voor de Nederlandse situatie geldt, in de huidige periode, dat strategische planning vooral terrein wint in de grotere steden en op Provinciaal- en Rijksnivo." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "In die tijd vindt deze plannings- methodiek, voor wat betreft de publieke sector, met name toepassing in Amerika. Voor de Nederlandse situatie geldt, in de huidige periode, dat strategische planning vooral terrein wint in de grotere steden en op Provinciaal- en Rijksnivo. In het voorliggende rapport zal middels een nadere bestudering van de kenmerken en achtergronden van de strategische planning en de analyse van planprocessen worden getracht aanbevelingen en conclusies te formuleren met betrekking tot de toepassing van elementen uit de strategische planning op een kleiner schaalnivo, met name in kleine gemeenten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7669241 ;
            sgpl:spatialText "de gemeente Heusden-Zolder" ;
            sgpl:text_context "Vervolgens zullen, gelet op het hierboven vermelde doel van het leeronderzoek, die elementen worden gedestilleerd die als referentiekader dienen bij de analyse van een tweetal min of meer vergelijkbare planprocessen: 1. het planproces van de herinrichting van de Kerkstraat—/ Udenseweg in de gemeente Zeeland 2. het in het kader van dit leeronderzoek doorlopen plan- proces van de herinrichting van de Gewestweg N—719 in de gemeente Heusden-Zolder (België). Beide planprocessen hebben een vergelijkbaar onderwerp, maar kennen een sterk verschillende werkwijze." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "de binnenstad van Amsterdam" ;
            sgpl:text_context "Nederlandse voorbeelden van toegepaste strategische planning op gemeentelijk nivo zijn vooralsnog slechts terug te vinden in grote steden: (een aantal willekeurige voorbeelden) Plan van aanpak voor de binnenstad van Amsterdam Nota vernieuwing van Rotterdam. Onderzoek naar prioriteiten lokaties voor investeringen in Eindhoven." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2802361 ;
            sgpl:spatialText "België" ;
            sgpl:text_context "Via een Bel- gische dochteronderneming mocht offerte worden uitgebracht voor een ruimtelijk ontwikkelingsplan voor de gemeente Maasmechelen in België. Met de gemeente Maasmechelen werd overeenge- komen dat een voorstel zou worden uitgewerkt for een planpro- cedure gebaseerd op de strategische planningsmethodiek. Helaas mocht het planproces geen doorgang vinden en deed zich op korte termijn geen vergelijkbaar planproces voor." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "In mei 19 8 6 kreeg Buro Kragten BV van de gemeente Zeeland in Noord-Brabant het verzoek aan te geven op welke wijze zij de problematiek van de Udenseweg en de Kerkstraat zou aanpakken, welke werkzaamheden hiervoor noodzakelijk zijn en welke kosten hiermee zijn gemoeid. De gemeente Zeeland is een kleine gemeente in het noord- oosten van Brabant. De kom Zeeland telt ca. 4500 inwoners en is ontstaan als een lintvormige nederzetting langs de regiona- le verbinding Uden-Reek-Ravenstein." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2791535 ;
            sgpl:spatialText "de gemeente Maasmechelen" ;
            sgpl:text_context "Via een Bel- gische dochteronderneming mocht offerte worden uitgebracht voor een ruimtelijk ontwikkelingsplan voor de gemeente Maasmechelen in België. Met de gemeente Maasmechelen werd overeenge- komen dat een voorstel zou worden uitgewerkt for een planpro- cedure gebaseerd op de strategische planningsmethodiek. Helaas mocht het planproces geen doorgang vinden en deed zich op korte termijn geen vergelijkbaar planproces voor." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "procesplanning" ;
            sgpl:text_context "Van het proces van de planvorming en besluitvorming werd echter niet afgeweken. De planning uit deze periode, die duurde tot eind jaren 70, wordt als gevolg van de nadruk op het proces van de planning aangeduid als procesplanning. Eind jaren 70/begin jaren 80 ontwikkelen zich een aantal economische en maatschappelijke verschuivingen die een invloed hebben op het planningsdenken." ],
        [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "planningstheorie" ;
            sgpl:text_context "In dit hoofdstuk wordt het theoretisch kader weergegeven van waaruit de doelstelling en de probleemstelling van het onderzoek worden beschouwd. In het eerste deel van dit hoofdstuk zal kort de ontwikkeling van de planningstheorie in Nederland van na de tweede Wereldoorlog worden gekenschetst. Belangrijk is het hierbij de relatie tussen de ontwikkelingen in de samenleving en de ontwikkeling van de planning te leren kennen." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "strategische planning" ;
            sgpl:text_context "De strategische planningsbenadering heeft zijn oorsprong in de bedrijfsplanning, waar deze planningsmethode tot ontwikkeling kwam in de jaren '60 en '70. Reeds in 1978 pleit Kreukels (Kreukels, 1978) voor toepassing van de strategische planning in de ruimtelijke planning. In die tijd vindt deze planningsmethodiek, voor wat betreft de publieke sector, met name toepassing in Amerika." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "strategische planning" ;
            sgpl:text_context "De strategische planningsbenadering heeft zijn oorsprong in de bedrijfsplanning, waar deze planningsmethode tot ontwikkeling kwam in de jaren '60 en '70. Reeds in 1978 pleit Kreukels (Kreukels, 1978) voor toepassing van de strategische planning in de ruimtelijke planning. In die tijd vindt deze planningsmethodiek, voor wat betreft de publieke sector, met name toepassing in Amerika." ],
        [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "procesplanning" ;
            sgpl:text_context "Van het proces van de planvorming en besluitvorming werd echter niet afgeweken. De planning uit deze periode, die duurde tot eind jaren 70, wordt als gevolg van de nadruk op het proces van de planning aangeduid als procesplanning. Eind jaren 70/begin jaren 80 ontwikkelen zich een aantal economische en maatschappelijke verschuivingen die een invloed hebben op het planningsdenken." ],
        [ sgpl:refersToConcept unesco:concept14053 ;
            sgpl:subjectText "planningstheorie" ;
            sgpl:text_context "In dit hoofdstuk wordt het theoretisch kader weergegeven van waaruit de doelstelling en de probleemstelling van het onderzoek worden beschouwd. In het eerste deel van dit hoofdstuk zal kort de ontwikkeling van de planningstheorie in Nederland van na de tweede Wereldoorlog worden gekenschetst. Belangrijk is het hierbij de relatie tussen de ontwikkelingen in de samenleving en de ontwikkeling van de planning te leren kennen." ] ;
    sgpl:thesisID 236 .

sgpl:Thesis237 a sgpl:SGPLThesis ;
    dcterms:creator "Saskia Bor" ;
    dcterms:issued 1992 ;
    dcterms:title "Verhuurbaarheidsproblemen in de naoorlogse sociale huursector en de rol van de toegelaten instelling in de oplossing daarvan." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2757715 ;
            sgpl:spatialText "winkelcentrum de Bus" ;
            sgpl:text_context "Sindsdien zijn verschillende projecten gestart om de situatie in het gebied te verbeteren, zoals het Werkgelegenheidsproject Helmond-Noord en het project Preventie Kleine Criminaliteit. Daarnaast bestaan er plannen om het winkelcentrum de Bus (zie figuur 4.1) grondig op te knappen. In opdracht van Companen heeft een bedrijf uit Rotterdam de woon- en bouwtechnische staat van het complex onderzocht." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Binderen" ;
            sgpl:text_context "De zeven flats staan in de wijk de Eeuwsels die tesamen met de wijken Binderen en Bloem-en Paardevelden Helmond-Noord vormen. Het complex is op circa vier kilometer afstand van het stadscentrum gelegen. De Nieuwe Aa aan de noord-en oostzijde, plus een natuurgebied dat aansluit op de Zuid-Willemsvaart aan de westzijde, werken als een barrihre, zodat het gebied weliswaar op het centrum georihnteerd is, doch er is slechts sprake van een doorgaande route." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759661 ;
            sgpl:spatialText "Arnhem" ;
            sgpl:text_context "Dit is gedaan in het kader van een stage bij het bureau Companen te Arnhem. Alle relevante gegevens ten aanzien van het complex zijn mij door Companen ter beschikking gesteld. Het tweede deel van het onderzoek heeft bestaan uit een schriftelijke enquate onder een aantal sociale verhuurders in Noord-Brabant, die met verhuurbaarheidsproblemen te kampen hebben gehad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "De kwantitatieve woningnood is inmiddels, vooral buiten de grote steden, grotendeels opgelost. Als we de leegstand in Nederland bezien, blijkt dat die steeds rond de 2% van de totale woningvoorraad schommelt. Een laag percentage, noodzakelijk voor een goede doorstroming op de woningmarkt, de zogenaamde frictieleegstand." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de Eeuwsels" ;
            sgpl:text_context "De zeven flats staan in de wijk de Eeuwsels die tesamen met de wijken Binderen en Bloem-en Paardevelden Helmond-Noord vormen. Het complex is op circa vier kilometer afstand van het stadscentrum gelegen. De Nieuwe Aa aan de noord-en oostzijde, plus een natuurgebied dat aansluit op de Zuid-Willemsvaart aan de westzijde, werken als een barrihre, zodat het gebied weliswaar op het centrum georihnteerd is, doch er is slechts sprake van een doorgaande route." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758946 ;
            sgpl:spatialText "Bijlmer" ;
            sgpl:text_context "In de media wordt veel aandacht besteed aan problemen die in naoorlogse wijken spelen, met de Bijlmer als wellicht het meest sprekende voorbeeld. Sloopberichten komen steeds vaker in het nieuws. Goed wonen is van groot belang voor een ieders welzijn." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754447 ;
            sgpl:spatialText "Helmond" ;
            sgpl:text_context "In de eerste plaats is in het kader van een stage bij Bureau Companen in Arnhem onderzoek gedaan naar een complex in Helmond, dat met grote leegstandsproblemen te kampen heeft. De leegstand in het complex was voor de verhuurder aanleiding om een onderzoek te laten instellen door Companen met als opdracht het aandragen van een aantal mogelijke oplossingen op complexniveau om de leegstand terug te dringen. Aan de ene kant heeft een case-studie nadelen vanwege de beperkte generaliseerbaarheid van de resultaten." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754447 ;
            sgpl:spatialText "Helmond-Noord" ;
            sgpl:text_context "De zeven flats staan in de wijk de Eeuwsels die tesamen met de wijken Binderen en Bloem-en Paardevelden Helmond-Noord vormen. Het complex is op circa vier kilometer afstand van het stadscentrum gelegen. De Nieuwe Aa aan de noord-en oostzijde, plus een natuurgebied dat aansluit op de Zuid-Willemsvaart aan de westzijde, werken als een barrihre, zodat het gebied weliswaar op het centrum georihnteerd is, doch er is slechts sprake van een doorgaande route." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:3319179 ;
            sgpl:spatialText "Flevoland" ;
            sgpl:text_context "In 1989 is dit percentage teruggelopen tot 43.4. Daaruit blijkt dat er relatief veel van deze complexen in Flevoland en Friesland te vinden zijn. Brabant, Gelderland, Utrecht en Noord-Holland bezitten relatief weinig woningen in 5%-complexen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit Utrecht" ;
            sgpl:text_context "Het rapport dat voor U ligt is het resultaat van mijn doctoraalonderzoek, specialisatie planologie aan de Rijksuniversiteit Utrecht. Het handelt over verhuurbaarheidsproblemen in de naoorlogse sociale huursector en de specifieke rol van de verhuurder daarin. Het onderzoek heeft bestaan uit drie delen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746695 ;
            sgpl:spatialText "Stiphout" ;
            sgpl:text_context "In 1968 worden delen van Aarle Rixtel, Bakel Deurne, Mierlo Someren en geheel Stiphout geannexeerd, omdat er geen ruimte meer binnen Helmond is om aan de toenemende vraag naar woningen te voldoen. Het plan omvat drie complexen eengezinswoningen en acht complexen van in totaal 381 meergezinswoningen (deze acht complexen de ' Jagershoven zijn gesloopt). De eengezinswoningen worden gebouwd middels een arbeidsbesparende systeembouw, die in drie jaareenheden zijn gebouwd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "Overeenkomstig de doelstellingen van een groeistad heeft Helmond een overloopfunctie voor vestigers uit de regio zoals uit de volgende tabel is op te maken. Vooral het migratiesaldo met Eindhoven is sterk positief. De migranten bestaan vooral uit jonge 1-en 2-persoonshuishoudens." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749450 ;
            sgpl:spatialText "Oosterhout" ;
            sgpl:text_context "In het laatste deel is onderzoek gedaan naar de maatregelen die een verhuurder kan treffen om verhuurbaarheidsproblemen op te lossen of te voorkomen, waarbij tevens is gekeken naar de financiele gevolgen daarvan. Dit is gedaan aan de hand van het complex in Helmond, waarvoor berekeningen zijn gemaakt van de kosten van onder andere grootonderhoud en sloop, en aan de hand van een complex te Oosterhout dat recent een grootonderhoudsbeurt heeft gehad. Alle mensen die op enigerlei wijze betrokken zijn geweest bij de drie deelonderzoeken, wil ik bij deze hartelijk danken." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Bloem-en Paardevelden" ;
            sgpl:text_context "In 1967 wordt aan de noordkant van de Bloem-en Paardevelden een begin gemaakt met de aanleg van de Eeuwsels. Begonnen wordt met de aanleg van de Eeuwsels I (westzijde) waarin 797 laagbouwwoningen worden gebouwd binnen het traditioneel verkavelingstype, met buurtstraten die uitkomen op de woonstraten die weer uitkomen op de wijkweg. Met de aanleg van het overige gedeelte van de Eeuwsels, wordt pas in 1972 begonnen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749990 ;
            sgpl:spatialText "Noord-Brabant" ;
            sgpl:text_context "Het onderzoek heeft bestaan uit drie delen. Het tweede deel van het onderzoek heeft bestaan uit een schriftelijke enquate onder een aantal sociale verhuurders in Noord-Brabant, die met verhuurbaarheidsproblemen te kampen hebben gehad. In het laatste deel is onderzoek gedaan naar de maatregelen die een verhuurder kan treffen om verhuurbaarheidsproblemen op te lossen of te voorkomen, waarbij tevens is gekeken naar de financiele gevolgen daarvan." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept8849 ;
            sgpl:subjectText "Sociale huursector" ;
            sgpl:text_context "Het handelt over verhuurbaarheidsproblemen in de naoorlogse sociale huursector en de specifieke rol van de verhuurder daarin. Het onderzoek naar verhuurbaarheidsproblemen beperkt zich tot woningen in de sociale huursector in het bezit van woningcorporaties en gemeentelijke woningbedrijven, de zogenaamde 'toegelaten instellingen'. In de woningwet zijn voorwaarden vastgelegd waaronder corporaties kunnen worden 'toegelaten'." ],
        [ sgpl:refersToConcept unesco:concept5570 ;
            sgpl:subjectText "Verhuurbaarheidsproblemen" ;
            sgpl:text_context "Minder gewenste complexen kunnen, als gevolg hiervan, met verhuurbaarheidsproblemen te maken krijgen. Deze verhuurbaarheidsproblemen kunnen resulteren in een structurele leegstand en verloedering van een complex. Het betreft hier voornamelijk naoorlogse middelhoog- en hoogbouwcomplexen." ],
        [ sgpl:refersToConcept unesco:concept673 ;
            sgpl:subjectText "Toegelaten instelling" ;
            sgpl:text_context "In de woningwet zijn voorwaarden vastgelegd waaronder corporaties kunnen worden 'toegelaten'. De toegelaten instelling heeft een sociale taakstelling, dwz dat zij uitsluitend in het belang van de volkshuisvesting -hiermee worden de woning en de directe woonomgeving bedoeld- werkzaam dient te zijn. Eventuele winsten mogen alleen aangewend worden voor dit belang." ],
        [ sgpl:refersToConcept unesco:concept673 ;
            sgpl:subjectText "Toegelaten instelling" ;
            sgpl:text_context "In de woningwet zijn voorwaarden vastgelegd waaronder corporaties kunnen worden 'toegelaten'. De toegelaten instelling heeft een sociale taakstelling, dwz dat zij uitsluitend in het belang van de volkshuisvesting -hiermee worden de woning en de directe woonomgeving bedoeld- werkzaam dient te zijn. Eventuele winsten mogen alleen aangewend worden voor dit belang." ],
        [ sgpl:refersToConcept unesco:concept8849 ;
            sgpl:subjectText "Sociale huursector" ;
            sgpl:text_context "Het handelt over verhuurbaarheidsproblemen in de naoorlogse sociale huursector en de specifieke rol van de verhuurder daarin. Het onderzoek naar verhuurbaarheidsproblemen beperkt zich tot woningen in de sociale huursector in het bezit van woningcorporaties en gemeentelijke woningbedrijven, de zogenaamde 'toegelaten instellingen'. In de woningwet zijn voorwaarden vastgelegd waaronder corporaties kunnen worden 'toegelaten'." ],
        [ sgpl:refersToConcept unesco:concept5570 ;
            sgpl:subjectText "Verhuurbaarheidsproblemen" ;
            sgpl:text_context "Minder gewenste complexen kunnen, als gevolg hiervan, met verhuurbaarheidsproblemen te maken krijgen. Deze verhuurbaarheidsproblemen kunnen resulteren in een structurele leegstand en verloedering van een complex. Het betreft hier voornamelijk naoorlogse middelhoog- en hoogbouwcomplexen." ] ;
    sgpl:thesisID 237 .

sgpl:Thesis238 a sgpl:SGPLThesis ;
    dcterms:creator "ing. A.W.H. Erhardt" ;
    dcterms:issued 1992 ;
    dcterms:title "BESTUURLIJKE MODELLEN EN WONINGBOUWLOCATIES IN ZUIDOOST-BRABANT" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754447,
                geonames:2756253 ;
            sgpl:spatialText "het gebied tussen Eindhoven en Helmond" ;
            sgpl:text_context "De stadsregio wordt uitgebreid langs de vervoersas Eindhoven-Helmond. Dit zal een nadelig gevolg hebben op de ecologische structuur, temeer omdat het gebied tussen Eindhoven en Helmond een landschappelijk waardevol gebied is. Vooralsnog gaat de keuze van de vierde nota ruimtelijke ordening uit naar het opvullen van gaten in de bestaande steden." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Kempenland" ;
            sgpl:text_context "Hierbij kan gedacht worden aan bestuurlijke vormen, zoals een samenwerkingsverband tussen gemeenten of een regiobestuur, of aan annexatie of samenvoeging van kleine gemeenten. De regio Zuidoost-Brabant bevat de twee huidige samenwerkingsverbanden Kempenland (Eindhoven e.o.) en Helmond en bevat in totaal 32 gemeenten. De oppervlakten en inwonersaantallen van deze gemeenten staan weergegeven in bijlage 1." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "regio Zuidoost-Brabant" ;
            sgpl:text_context "Daarvoor is veel ruimte nodig. Ook in de regio Zuidoost-Brabant moeten de komende jaren veel woningen worden gebouwd. In dit onderzoek wordt bekeken hoe de belangen met betrekking tot nieuwe woningbouwlocaties binnen deze regio het best kunnen worden behartigd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "Tilburg" ;
            sgpl:text_context "Daarnaast bestaat er nog het gevaar dat bedrijven zich eerder gaan vestigen in steden waar meer groeimogelijkheden zijn, zoals Breda of Tilburg. Om aan de groei van de grote steden te kunnen voldoen dienen er buurgemeenten te worden geannexeerd. Dit is echter een moeizaam proces." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758401 ;
            sgpl:spatialText "Breda" ;
            sgpl:text_context "Daarnaast bestaat er nog het gevaar dat bedrijven zich eerder gaan vestigen in steden waar meer groeimogelijkheden zijn, zoals Breda of Tilburg. Om aan de groei van de grote steden te kunnen voldoen dienen er buurgemeenten te worden geannexeerd. Dit is echter een moeizaam proces." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "1.2 Probleemaanduiding en probleemstelling. De steden Helmond en Eindhoven zitten wat betreft hun uitbreidingsmogelijkheden aan hun grenzen. Om verder te kunnen groeien dienen of enkele buurgemeenten te worden geannexeerd of er dient een betere samenwerking met de buurgemeenten te komen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754447 ;
            sgpl:spatialText "Helmond" ;
            sgpl:text_context "1.2 Probleemaanduiding en probleemstelling. De steden Helmond en Eindhoven zitten wat betreft hun uitbreidingsmogelijkheden aan hun grenzen. Om verder te kunnen groeien dienen of enkele buurgemeenten te worden geannexeerd of er dient een betere samenwerking met de buurgemeenten te komen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Het betreft hier een stadsgeografisch onderzoek over een onderwerp dat momenteel zeer actueel is in het betreffende gebied. Nederland is met name na de Tweede Wereldoorlog behoorlijk vol geraakt. We moeten met z'n allen leven, wonen, werken en recreeren op betrekkelijk weinig grondgebied." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Zuid-Nederland" ;
            sgpl:text_context "Europees gezien zou Eindhoven/Helmond een middelgrote stad zijn. Voordeel van dit model zou kunnen zijn dat beide steden die nu moeilijk kunnen groeien doordat ze aan grenzen gebonden zijn, kunnen uitgroeien tot het economisch en cultureel middelpunt van Zuid-Nederland, waardoor Eindhoven/Helmond in de concurrentiestrijd met Den Bosch en Breda qua grootte oppermachtig zou worden. In dit model zouden de bestaande gemeenten gehandhaafd kunnen worden, al krijgen zij minder bevoegdheden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750821 ;
            sgpl:spatialText "gemeente Mierlo" ;
            sgpl:text_context "Rond het jaar 2000 is Helmond als gevolg van ruimtegebrek toe aan de ontwikkeling van een nieuwe woningbouwlocatie, Brandevoort genaamd. Dit is een gebied dat nu nog in handen is van de gemeente Mierlo. Het bestemmingsplan verschilt vooral juridisch van het streekplan en het structuurplan." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept1382 ;
            sgpl:subjectText "bestuurlijke modellen" ;
            sgpl:text_context "In dit onderzoek wordt bekeken hoe de belangen met betrekking tot nieuwe woningbouwlocaties binnen deze regio het best kunnen worden behartigd. Hierbij kan gedacht worden aan bestuurlijke vormen, zoals een samenwerkingsverband tussen gemeenten of een regiobestuur, of aan annexatie of samenvoeging van kleine gemeenten. De regio Zuidoost-Brabant bevat de twee huidige samenwerkingsverbanden Kempenland (Eindhoven e.o.) en Helmond en bevat in totaal 32 gemeenten." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "verstedelijkingsbeleid" ;
            sgpl:text_context "In de vierde nota over de ruimtelijke ordening wordt dit beleid voortgezet met een grotere nadruk op de leefomgeving in de steden. Het door de centrale overheid uitgestippelde verstedelijkingsbeleid geeft vanwege het voorgaande al een duidelijke richting aan de afweging van bouwlocaties, zowel op regionaal respectievelijk stadsgewestelijk als op locaal niveau. Dit komt tot uitdrukking in de reeds eerder genoemde prioriteit in de structuurschets en in de vierde nota aan het bouwen in de stad boven bouwen in uitbreidingsgebieden en op locaties buiten de stad." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "woningbouwlocaties" ;
            sgpl:text_context "Hiertoe dienen we niet alleen in gemeentelijk verband te kijken naar een goede afstemming, maar vooral ook, en steeds meer, in regionaal verband. Een van de belangrijkste onderdelen van de ruimtelijke ordening is de situering van woningbouwlocaties. Volgens de vierde nota ruimtelijke ordening (1988) moeten er zo'n twee miljoen woningen worden bijgebouwd tot het jaar 2015." ],
        [ sgpl:refersToConcept unesco:concept1382 ;
            sgpl:subjectText "bestuurlijke modellen" ;
            sgpl:text_context "In dit onderzoek wordt bekeken hoe de belangen met betrekking tot nieuwe woningbouwlocaties binnen deze regio het best kunnen worden behartigd. Hierbij kan gedacht worden aan bestuurlijke vormen, zoals een samenwerkingsverband tussen gemeenten of een regiobestuur, of aan annexatie of samenvoeging van kleine gemeenten. De regio Zuidoost-Brabant bevat de twee huidige samenwerkingsverbanden Kempenland (Eindhoven e.o.) en Helmond en bevat in totaal 32 gemeenten." ],
        [ sgpl:refersToConcept unesco:concept440 ;
            sgpl:subjectText "woningbouwlocaties" ;
            sgpl:text_context "Hiertoe dienen we niet alleen in gemeentelijk verband te kijken naar een goede afstemming, maar vooral ook, en steeds meer, in regionaal verband. Een van de belangrijkste onderdelen van de ruimtelijke ordening is de situering van woningbouwlocaties. Volgens de vierde nota ruimtelijke ordening (1988) moeten er zo'n twee miljoen woningen worden bijgebouwd tot het jaar 2015." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "verstedelijkingsbeleid" ;
            sgpl:text_context "In de vierde nota over de ruimtelijke ordening wordt dit beleid voortgezet met een grotere nadruk op de leefomgeving in de steden. Het door de centrale overheid uitgestippelde verstedelijkingsbeleid geeft vanwege het voorgaande al een duidelijke richting aan de afweging van bouwlocaties, zowel op regionaal respectievelijk stadsgewestelijk als op locaal niveau. Dit komt tot uitdrukking in de reeds eerder genoemde prioriteit in de structuurschets en in de vierde nota aan het bouwen in de stad boven bouwen in uitbreidingsgebieden en op locaties buiten de stad." ] ;
    sgpl:thesisID 238 .

sgpl:Thesis239 a sgpl:SGPLThesis ;
    dcterms:creator "Erik Fontijne" ;
    dcterms:issued 1992 ;
    dcterms:title "INDUSTRIËLE ONDERNEMINGEN UIT DE TOP-100 VAN NEDERLAND",
        "ONDERNEMINGSSTRATEGIE, FLEXIBILISERING VAN DE PRODUKTIE-ORGANISATIE EN LOCATIEPATROON" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam-Zuidoost" ;
            sgpl:text_context "1. DAF N.V. (hoofdkantoor en assemblage te Eindhoven); 2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht); 3. Volvo Car B.V. (hoofdkantoor te Helmond; assemblage te Born; produktie te Oss)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Ten geleide Erik Fontijne heeft in het kader van zijn studie Economische Geografie aan de Rijksuniversiteit Utrecht een onderzoek verricht naar de ondernemingsstrategieën en locatiepatronen van industriële ondernemingen uit de top-100 van Nederland. Gezien onze belangstelling voor de relaties tussen het bedrijfsleven en haar ruimtelijke omgeving is Erik Fontijne in de gelegenheid gesteld dit projekt in stageverband bij het Instituut voor Ruimtelijke Organisatie van TNO uit te voeren. De wereld van de grote ondernemingen en de omgeving van een professionele onderzoekorganisatie hebben Erik Fontijne mede gestimuleerd tot het tot stand brengen van het voor u liggende rapport, dat vele nieuwe inzichten biedt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6941548 ;
            sgpl:spatialText "Ypenburg" ;
            sgpl:text_context "1. DAF N.V. (hoofdkantoor en assemblage te Eindhoven); 2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht); 3. Volvo Car B.V. (hoofdkantoor te Helmond; assemblage te Born; produktie te Oss)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2744257 ;
            sgpl:spatialText "Woensdrecht" ;
            sgpl:text_context "1. DAF N.V. (hoofdkantoor en assemblage te Eindhoven); 2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht); 3. Volvo Car B.V. (hoofdkantoor te Helmond; assemblage te Born; produktie te Oss)." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Noordoosten en Zuidoosten" ;
            sgpl:text_context "Bij een streven naar dominantie betekent dit de mijding van grootstedelijke gebieden. In Nederland zijn de overzichtelijke en toegankelijke regio s buiten het Westen te vinden, met name m het Noordoosten en Zuidoosten. Zodoende zal in deze gebieden van Nederland flexibilisering van de produktie-organisatie waarin systeembepalende ondernemingen dominant zijn goed kunnen gedijen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "De Randstad" ;
            sgpl:text_context "Vandaar dat de top-managementfuncties van ondernemingen over het algemeen in een beperkt aantal belangrijke grootstedelijke gebieden van de hoogste orde zijn geconcentreerd, zoals New York, Londen, Parijs, Tokio en De Randstad. De meer routinematige dagelijkse bestuursfuncties zijn eveneens veelal in stedelijke gebieden geconcentreerd. De noodzaak om in de stedelijke gebieden van de hoogste orde te zijn gevestigd, is echter minder groot." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2749234 ;
            sgpl:spatialText "Oss" ;
            sgpl:text_context "2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht); 3. Volvo Car B.V. (hoofdkantoor te Helmond; assemblage te Born; produktie te Oss). De informatie uit de interviews is verwerkt in de vorm van case-studies." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748729,
                geonames:2756669 ;
            sgpl:spatialText "Dordrecht/Papendrecht" ;
            sgpl:text_context "1. DAF N.V. (hoofdkantoor en assemblage te Eindhoven); 2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht); 3. Volvo Car B.V. (hoofdkantoor te Helmond; assemblage te Born; produktie te Oss)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754447 ;
            sgpl:spatialText "Helmond" ;
            sgpl:text_context "2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht); 3. Volvo Car B.V. (hoofdkantoor te Helmond; assemblage te Born; produktie te Oss). De informatie uit de interviews is verwerkt in de vorm van case-studies." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:10173839 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "1. DAF N.V. (hoofdkantoor en assemblage te Eindhoven); 2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht); 3. Volvo Car B.V. (hoofdkantoor te Helmond; assemblage te Born; produktie te Oss)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2756253 ;
            sgpl:spatialText "Eindhoven" ;
            sgpl:text_context "Bij de volgende 3 produktgroepenondememingen zijn de interviews afgenomen: 1. DAF N.V. (hoofdkantoor en assemblage te Eindhoven); 2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht);" ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Born" ;
            sgpl:text_context "2. N.V. Koninklijke Nederlandse Vliegtuigenfabriek Fokker (met name Fokker Aircraft B.V.: hoofdkantoor te Amsterdam-Zuidoost; assemblage te Schiphol; produktie te Dordrecht/Papendrecht, Ypenburg en Woensdrecht); 3. Volvo Car B.V. (hoofdkantoor te Helmond; assemblage te Born; produktie te Oss). De informatie uit de interviews is verwerkt in de vorm van case-studies." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept607 ;
            sgpl:subjectText "Flexibilisering van de produktie-organisatie" ;
            sgpl:text_context "Ook in deze vorm is sprake van een sterke ruimtelijke concentratie van de produktie. Slechts op de flexibilisering van de produktie-organisatie waarin systeembepalende ondernemingen dominant zijn, wordt hier nader ingegaan. Dat gebeurt omdat in dit onderzoek deproduktgroepenondernemingen centraal staan." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Locatiepatroon" ;
            sgpl:text_context "Het blijkt dat de klassieke en moderne vestigingsplaatstheorieën waardevolle inzichten bieden ter verklaring van het ruimtelijk locatiepatroon van grote industriële ondernemingen. De theorieën gaan er teveel van uit dat de locatiekeuze van ondernemingen geïsoleerd plaatsvindt van andere ondernemingsbeslissingen. De locatiekeuze van ondernemingen is juist een uitvloeisel van investeringsbeslissingen omtrent de verschillende produkten en geografische markten." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "Ondernemingsstrategie" ;
            sgpl:text_context "Dit onderzoek is gedaan in het kader van de specialisatie Economische Geografie aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit te Utrecht. De keuze voor het onderwerp 'Industriële ondernemingen uit de top-100 van Nederland: ondernemingsstrategie, flexibilisering van de produktie-organisatie en locatiepatroon’ kwam tot stand nadat ik het door de Sector REOT gepubliceerde rapport ’Economisch-Technologische Vernieuwing en Ruimtelijke Organisatie’ (Machielse en De Ruijter, 1988) had gelezen. In dat rapport wordt aandacht geschonken aan het thema 'flexibilisering’ in grote industriële ondernemingen en de ruimtelijke aspecten daarvan." ],
        [ sgpl:refersToConcept unesco:concept441 ;
            sgpl:subjectText "Locatiepatroon" ;
            sgpl:text_context "Het blijkt dat de klassieke en moderne vestigingsplaatstheorieën waardevolle inzichten bieden ter verklaring van het ruimtelijk locatiepatroon van grote industriële ondernemingen. De theorieën gaan er teveel van uit dat de locatiekeuze van ondernemingen geïsoleerd plaatsvindt van andere ondernemingsbeslissingen. De locatiekeuze van ondernemingen is juist een uitvloeisel van investeringsbeslissingen omtrent de verschillende produkten en geografische markten." ],
        [ sgpl:refersToConcept unesco:concept7908 ;
            sgpl:subjectText "Ondernemingsstrategie" ;
            sgpl:text_context "Dit onderzoek is gedaan in het kader van de specialisatie Economische Geografie aan de Faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit te Utrecht. De keuze voor het onderwerp 'Industriële ondernemingen uit de top-100 van Nederland: ondernemingsstrategie, flexibilisering van de produktie-organisatie en locatiepatroon’ kwam tot stand nadat ik het door de Sector REOT gepubliceerde rapport ’Economisch-Technologische Vernieuwing en Ruimtelijke Organisatie’ (Machielse en De Ruijter, 1988) had gelezen. In dat rapport wordt aandacht geschonken aan het thema 'flexibilisering’ in grote industriële ondernemingen en de ruimtelijke aspecten daarvan." ],
        [ sgpl:refersToConcept unesco:concept607 ;
            sgpl:subjectText "Flexibilisering van de produktie-organisatie" ;
            sgpl:text_context "Ook in deze vorm is sprake van een sterke ruimtelijke concentratie van de produktie. Slechts op de flexibilisering van de produktie-organisatie waarin systeembepalende ondernemingen dominant zijn, wordt hier nader ingegaan. Dat gebeurt omdat in dit onderzoek deproduktgroepenondernemingen centraal staan." ] ;
    sgpl:thesisID 239 .

sgpl:Thesis24 a sgpl:SGPLThesis ;
    dcterms:creator "H.M. de Bruijn" ;
    dcterms:issued 1960 ;
    dcterms:title "DE GROTE STEDEN in het ZUIDOOSTEN van de VERENIGD STATEN" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6254928 ;
            sgpl:spatialText "Virginia" ;
            sgpl:text_context "Om verschillende redenen kan dit vijftal staten los worden gezien van de hen omringende gebieden. Virginia, lange tijd \"the northernmost of the Southern States\", wordt meer en meer het zuidelijk verlengstuk van de megalopolis aan de Noordatlantische kust. De bergketens der Appalachen vormen een meer dan strikt fysische scheidingsmuur naar de kant van de staten Tennessee en Kentucky." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4180439 ;
            sgpl:spatialText "Atlanta" ;
            sgpl:text_context "In de halfmiljoen-klasse verkeren de industriële agglomeratie van Birmingham, het handelsknooppunt Atlanta en het transportcentrum New Orleans. De steden Raleigh, Columbia, Atlanta, Jackson en Baton Rouge zijn hoofdstad van hun staat, behalve in het geval van Raleigh tellen de bijbehorende stedelijke gebieden meer dan 100.000 inwoners. Naast New Orleans vinden wij als havensteden Mobile, Savannah en Charleston." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4197000 ;
            sgpl:spatialText "Georgië" ;
            sgpl:text_context "De steden, die wij in deze scriptie aan een beschouwing zullen onderwerpen, liggen in de kern van het zuidoostelijk deel van de Verenigde Staten van Amerika. Zij beslaan daar de staten Noord-Carolina, Zuid-Carolina, Georgië, Alabama, Mississippi, en het deel van de staat Louisiana dat ten oosten van de rivier de Mississippi ligt. Het aldus bepaalde gebied valt niet met een van de definities, die aangaande het zuidoosten van de V.S. voor statistische doeleinden in gebruik zijn, samen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:4155751 ;
            sgpl:spatialText "Florida" ;
            sgpl:text_context "Florida ligt afzijdig van het gebied met de katoenverbouw, die voor de vroege ontwikkeling van de meeste van de eerder genoemde staten zo belangrijk is geweest. Hoewel hier door de Spanjaarden de eerste stad op het gebied van de Verenigde Staten werd gesticht - St. Augustine, in 1565 - is deze stad dan ook tot ver in de twintigste eeuw qua bevolkingsgrootte achtergebleven bij andere zuidoostelijke staten. Het inlopen van de achterstand dankt Florida vooral aan zijn ontwikkeling tot \"playground of the nation\"." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:4662168 ;
            sgpl:spatialText "Tennessee" ;
            sgpl:text_context "De bergketens der Appalachen vormen een meer dan strikt fysische scheidingsmuur naar de kant van de staten Tennessee en Kentucky. De stedelijke ontwikkeling van de laatste staat sluit aan bij die van het Midden-Westen; de nationale inspanningen in het kader van de ontwikkeling van de Tennesseevallei hebben de eerste staat een geheel eigen weg doen inslaan. De staat Arkansas en het overgrote deel van Louisiana, dat ten westen van de Mississippi ligt, worden ook wel tot het zuidoostelijk deel van de V.S. gerekend." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Zuid-Carolina" ;
            sgpl:text_context "De steden, die wij in deze scriptie aan een beschouwing zullen onderwerpen, liggen in de kern van het zuidoostelijk deel van de Verenigde Staten van Amerika. Zij beslaan daar de staten Noord-Carolina, Zuid-Carolina, Georgië, Alabama, Mississippi, en het deel van de staat Louisiana dat ten oosten van de rivier de Mississippi ligt. Het aldus bepaalde gebied valt niet met een van de definities, die aangaande het zuidoosten van de V.S. voor statistische doeleinden in gebruik zijn, samen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4482348 ;
            sgpl:spatialText "Noord-Carolina" ;
            sgpl:text_context "De steden, die wij in deze scriptie aan een beschouwing zullen onderwerpen, liggen in de kern van het zuidoostelijk deel van de Verenigde Staten van Amerika. Zij beslaan daar de staten Noord-Carolina, Zuid-Carolina, Georgië, Alabama, Mississippi, en het deel van de staat Louisiana dat ten oosten van de rivier de Mississippi ligt. Het aldus bepaalde gebied valt niet met een van de definities, die aangaande het zuidoosten van de V.S. voor statistische doeleinden in gebruik zijn, samen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4829764 ;
            sgpl:spatialText "Alabama" ;
            sgpl:text_context "De steden, die wij in deze scriptie aan een beschouwing zullen onderwerpen, liggen in de kern van het zuidoostelijk deel van de Verenigde Staten van Amerika. Zij beslaan daar de staten Noord-Carolina, Zuid-Carolina, Georgië, Alabama, Mississippi, en het deel van de staat Louisiana dat ten oosten van de rivier de Mississippi ligt. Het aldus bepaalde gebied valt niet met een van de definities, die aangaande het zuidoosten van de V.S. voor statistische doeleinden in gebruik zijn, samen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4331987 ;
            sgpl:spatialText "Louisiana" ;
            sgpl:text_context "De steden, die wij in deze scriptie aan een beschouwing zullen onderwerpen, liggen in de kern van het zuidoostelijk deel van de Verenigde Staten van Amerika. Zij beslaan daar de staten Noord-Carolina, Zuid-Carolina, Georgië, Alabama, Mississippi, en het deel van de staat Louisiana dat ten oosten van de rivier de Mississippi ligt. Het aldus bepaalde gebied valt niet met een van de definities, die aangaande het zuidoosten van de V.S. voor statistische doeleinden in gebruik zijn, samen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:12217079 ;
            sgpl:spatialText "Deep South" ;
            sgpl:text_context "Wel is dit deel het meest karakteristiek voor het \"Ouds Zuiden\", dat in de geschiedenis van de natie een zo vooraanstaande rol speelde, en dat als de \"Deep South\" bekend staat. Om verschillende redenen kan dit vijftal staten los worden gezien van de hen omringende gebieden. Virginia, lange tijd \"the northernmost of the Southern States\", wordt meer en meer het zuidelijk verlengstuk van de megalopolis aan de Noordatlantische kust." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4049979 ;
            sgpl:spatialText "Birmingham" ;
            sgpl:text_context "In de halfmiljoen-klasse verkeren de industriële agglomeratie van Birmingham, het handelsknooppunt Atlanta en het transportcentrum New Orleans. De steden Raleigh, Columbia, Atlanta, Jackson en Baton Rouge zijn hoofdstad van hun staat, behalve in het geval van Raleigh tellen de bijbehorende stedelijke gebieden meer dan 100.000 inwoners. Naast New Orleans vinden wij als havensteden Mobile, Savannah en Charleston." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6252001 ;
            sgpl:spatialText "Zuidoosten van de Verenigde Staten" ;
            sgpl:text_context "DE GROTE STEDEN in het ZUIDOOSTEN van de VERENIGDE STATEN. De steden, die wij in deze scriptie aan een beschouwing zullen onderwerpen, liggen in de kern van het zuidoostelijk deel van de Verenigde Staten van Amerika. Zij beslaan daar de staten Noord-Carolina, Zuid-Carolina, Georgië, Alabama, Mississippi, en het deel van de staat Louisiana dat ten oosten van de rivier de Mississippi ligt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4436296 ;
            sgpl:spatialText "Mississippi" ;
            sgpl:text_context "De steden, die wij in deze scriptie aan een beschouwing zullen onderwerpen, liggen in de kern van het zuidoostelijk deel van de Verenigde Staten van Amerika. Zij beslaan daar de staten Noord-Carolina, Zuid-Carolina, Georgië, Alabama, Mississippi, en het deel van de staat Louisiana dat ten oosten van de rivier de Mississippi ligt. Het aldus bepaalde gebied valt niet met een van de definities, die aangaande het zuidoosten van de V.S. voor statistische doeleinden in gebruik zijn, samen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:4335045 ;
            sgpl:spatialText "New Orleans" ;
            sgpl:text_context "In de halfmiljoen-klasse verkeren de industriële agglomeratie van Birmingham, het handelsknooppunt Atlanta en het transportcentrum New Orleans. De steden Raleigh, Columbia, Atlanta, Jackson en Baton Rouge zijn hoofdstad van hun staat, behalve in het geval van Raleigh tellen de bijbehorende stedelijke gebieden meer dan 100.000 inwoners. Naast New Orleans vinden wij als havensteden Mobile, Savannah en Charleston." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Verstedelijking" ;
            sgpl:text_context "De bevolking van de zuidoosthoek van de V.S. (fig.2) in 1950 bedroeg bijna 24 miljoen personen; de gemiddelde dichtheid van de bevolking was 25 per km2. De mate van verstedelijking van de zuidoostelijke staten vertoont een geheel ander patroon, waarbij het zo dun bevolkte Florida een stedelijk percentage blijkt te bezitten, dat hoger is dan het nationale gemiddelde; resp. 65,5, en 64,4. Voor de gezamenlijke staten vindt men een waarde van 44,7%." ],
        [ sgpl:refersToConcept unesco:concept12328 ;
            sgpl:subjectText "Textile Belt" ;
            sgpl:text_context "Daarvoor o.a. liggen Atlanta en Richmond (Virginia) te dicht aan weerszijden van de staat. De industrie in de Textile Belt, waarvan Noord-Carolina een belangrijk deel binnen zijn grenzen heeft, is meestal bij opzet gedecentraliseerd, en heeft daardoor niet rechtstreeks tot de groei van grote steden kunnen bijdragen. De ekonomische rijping van de staat sinds de tweede wereldoorlog is een stimulans voor de ontwikkeling van Charlotte tot een regionaal centrum en een ernstige konkurrent van Richmond." ],
        [ sgpl:refersToConcept unesco:concept12020 ;
            sgpl:subjectText "Beroepsbevolking" ;
            sgpl:text_context "Belangrijker is de beroepsstructuur van de eventueel in de SMA op te nemen aangrenzende county. De niet-agrarische beroepsbevolking moet er dan minstens 10.000 personen tellen, óf minstens 10% van de niet-agrarische beroepsbevolking van de eerste county (-ties) belopen. Slechts wanneer tenminste de helft van de bevolking van de county met een minimale dichtheid 60 personen per km2 aan de stad grenzende distrikten bewoont, is buiten deze eisen om sprake van een voldoend innige relatie." ],
        [ sgpl:refersToConcept unesco:concept12328 ;
            sgpl:subjectText "Textile Belt" ;
            sgpl:text_context "Daarvoor o.a. liggen Atlanta en Richmond (Virginia) te dicht aan weerszijden van de staat. De industrie in de Textile Belt, waarvan Noord-Carolina een belangrijk deel binnen zijn grenzen heeft, is meestal bij opzet gedecentraliseerd, en heeft daardoor niet rechtstreeks tot de groei van grote steden kunnen bijdragen. De ekonomische rijping van de staat sinds de tweede wereldoorlog is een stimulans voor de ontwikkeling van Charlotte tot een regionaal centrum en een ernstige konkurrent van Richmond." ],
        [ sgpl:refersToConcept unesco:concept12020 ;
            sgpl:subjectText "Beroepsbevolking" ;
            sgpl:text_context "Belangrijker is de beroepsstructuur van de eventueel in de SMA op te nemen aangrenzende county. De niet-agrarische beroepsbevolking moet er dan minstens 10.000 personen tellen, óf minstens 10% van de niet-agrarische beroepsbevolking van de eerste county (-ties) belopen. Slechts wanneer tenminste de helft van de bevolking van de county met een minimale dichtheid 60 personen per km2 aan de stad grenzende distrikten bewoont, is buiten deze eisen om sprake van een voldoend innige relatie." ],
        [ sgpl:refersToConcept unesco:concept11996 ;
            sgpl:subjectText "Verstedelijking" ;
            sgpl:text_context "De bevolking van de zuidoosthoek van de V.S. (fig.2) in 1950 bedroeg bijna 24 miljoen personen; de gemiddelde dichtheid van de bevolking was 25 per km2. De mate van verstedelijking van de zuidoostelijke staten vertoont een geheel ander patroon, waarbij het zo dun bevolkte Florida een stedelijk percentage blijkt te bezitten, dat hoger is dan het nationale gemiddelde; resp. 65,5, en 64,4. Voor de gezamenlijke staten vindt men een waarde van 44,7%." ] ;
    sgpl:thesisID 24 .

sgpl:Thesis240 a sgpl:SGPLThesis ;
    dcterms:creator "T. Gorsseling" ;
    dcterms:issued 1989 ;
    dcterms:title "DE GEVOLGEN VAN DE EUROPESE INTEGRATIE IN 1992 VOOR BEDRIJVEN IN DE MACHINE-INDUSTRIE",
        "VERSLAGEN VAN LEERONDERZOEK G & P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Duitse grensgebied" ;
            sgpl:text_context "De voorspelde toename van de concurrentie nadat de grenzen zijn weggevallen, zal in Twente door zijn geografische ligging aan het Duitse grensgebied, eerder en duidelijker voelbaar zijn. Voor een dergelijke grensstreek is anticipatie op de Europese integratie dus van cruciaal belang. Als onderzoekspopulatie is gekozen voor kleine en middelgrote bedrijven omdat deze een belangrijke rol spelen in de (regionale) economie en verwacht werd dat de voorbereiding op 1992 gering is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:6255148 ;
            sgpl:spatialText "Zuid Europa" ;
            sgpl:text_context "Economisch zwakke regio's in Nederland, zoals Oost Groningen en Twente met een hoge werkloosheid, zijn in het Europese geheel gezien rijke welvarende gebieden. De economisch zwakke regio's liggen nu in Zuid Europa. Subsidiestromen zullen veranderen en zich langzamerhand meer zuidwaarts richten." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2756071 ;
            sgpl:spatialText "Enschede" ;
            sgpl:text_context "DE GEVOLGEN VAN DE EUROPESE INTEGRATIE IN 1992 VOOR BEDRIJVEN IN DE MACHINE-INDUSTRIE. Enschede, juli 1989 T. Gorsseling. VERSLAGEN VAN LEERONDERZOEK G & P vakgroep toegepaste geografie en ruimtelijke planning." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Het rapport dat voor U ligt, is het resultaat van mijn doctoraalspecialisatie economische geografie aan de Rijksuniversiteit Utrecht. Het doctoraal onderzoek heb ik uit kunnen voeren bij het CIO! (Centrum voor Innovatief Ondernemerschap Twente), een organisatie die verbonden is aan de faculteit Bedrijfskunde van de Universiteit Twente. Ik ben het CIOT en alle medewerkers hiervoor zeer erkentelijk." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746058 ;
            sgpl:spatialText "Twente" ;
            sgpl:text_context "Ik ben het CIOT en alle medewerkers hiervoor zeer erkentelijk. Allereerst is er een algemeen literatuuronderzoek uitgevoerd waarbij naar de gevolgen van de Europese integratie voor Twente, Salland en Overijssel is gekeken. De resultaten van deze studie, die in een apart rapport gebundeld zijn, hebben aanleiding gegeven voor het tweede deel van het onderzoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2754394 ;
            sgpl:spatialText "Hengelo" ;
            sgpl:text_context "Dat 'Europa 1992' in toenemende mate in de belangstelling van het bedrijfsleven staat, blijkt ondermeer uit de ERBO-enqu6te over 1988 van de Kamer van Koophandel in Hengelo. Hieruit blijkt dat: 40% van de bedrijven in Twente en Salland zich voorbereidt op de Europese marktintegratie. Daarvan zegt ca. 50% de Europese ontwikkelingen op de voet te volgen;" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2921044 ;
            sgpl:spatialText "Duitsland" ;
            sgpl:text_context "Bedri jf 4 leent nu al goedkoper geld in Duitsland. Bedrijf 1 is argwanend om financi6le diensten in het buitenland af te sluiten, vanwege de 'kleine lettertjes'. De liberalisatie van de markt voor het kapitaalverkeer is met name voor bedrijven die exporteren van belang." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2748838 ;
            sgpl:spatialText "Overijssel" ;
            sgpl:text_context "Ik ben het CIOT en alle medewerkers hiervoor zeer erkentelijk. Allereerst is er een algemeen literatuuronderzoek uitgevoerd waarbij naar de gevolgen van de Europese integratie voor Twente, Salland en Overijssel is gekeken. De resultaten van deze studie, die in een apart rapport gebundeld zijn, hebben aanleiding gegeven voor het tweede deel van het onderzoek." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2747775 ;
            sgpl:spatialText "Salland" ;
            sgpl:text_context "Ik ben het CIOT en alle medewerkers hiervoor zeer erkentelijk. Allereerst is er een algemeen literatuuronderzoek uitgevoerd waarbij naar de gevolgen van de Europese integratie voor Twente, Salland en Overijssel is gekeken. De resultaten van deze studie, die in een apart rapport gebundeld zijn, hebben aanleiding gegeven voor het tweede deel van het onderzoek." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Dit onderzoek richt zich op de machine-industrie, die binnen de metaalindustrie valt, waar de voorbereiding op 1992 zoals bovenstaand blijkt gemiddeld is. Er is gekozen voor de machine-industrie omdat deze in de produktiestructuur van Twente oververtegenwoordigd t.o.v. Nederland (Gorsseling, 1988). Onderstaande tabel geeft het aantal arbeidsplaatsen, zowel absoluut als relatief." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept650 ;
            sgpl:subjectText "Machine-industrie" ;
            sgpl:text_context "Zelfs als het onderzoeksterrein beperkt wordt tot de gevolgen van de integratie voor één bepaalde branche zijn de verwachte gevolgen afhankelijk van een veelheid aan factoren. Dit onderzoek richt zich op de machine-industrie, die binnen de metaalindustrie valt, waar de voorbereiding op 1992 zoals bovenstaand blijkt gemiddeld is. Er is gekozen voor de machine-industrie omdat deze in de produktiestructuur van Twente oververtegenwoordigd t.o.v. Nederland (Gorsseling, 1988)." ],
        [ sgpl:refersToConcept unesco:concept935 ;
            sgpl:subjectText "Europese integratie" ;
            sgpl:text_context "Na enkele maanden literatuur bestuderen en onderzoek verrichten ben ik er achter gekomen dat het 'fijne weten' van dit brede en complexe gebied (bijna) onmogelijk is. Het terrein waar de Europese integratie zijn invloed doet gelden is zeer uitgebreid. Zelfs als het onderzoeksterrein beperkt wordt tot de gevolgen van de integratie voor één bepaalde branche zijn de verwachte gevolgen afhankelijk van een veelheid aan factoren." ],
        [ sgpl:refersToConcept unesco:concept5934 ;
            sgpl:subjectText "Concurrentiepositie" ;
            sgpl:text_context "Bijvoorbeeld de concurrentiepositie van het bedrijfsleven, werkgelegenheid, welvaart, welzijn, milieu etcetera. De Europese eenwording is van groot belang for de concurrentiepositie van het bedrijfsleven in Europa. Het creëren van de grootste uniforme thuismarkt ter wereld heeft vele positieve gevolgen voor het bedrijfsleven." ],
        [ sgpl:refersToConcept unesco:concept650 ;
            sgpl:subjectText "Machine-industrie" ;
            sgpl:text_context "Zelfs als het onderzoeksterrein beperkt wordt tot de gevolgen van de integratie voor één bepaalde branche zijn de verwachte gevolgen afhankelijk van een veelheid aan factoren. Dit onderzoek richt zich op de machine-industrie, die binnen de metaalindustrie valt, waar de voorbereiding op 1992 zoals bovenstaand blijkt gemiddeld is. Er is gekozen voor de machine-industrie omdat deze in de produktiestructuur van Twente oververtegenwoordigd t.o.v. Nederland (Gorsseling, 1988)." ],
        [ sgpl:refersToConcept unesco:concept5934 ;
            sgpl:subjectText "Concurrentiepositie" ;
            sgpl:text_context "Bijvoorbeeld de concurrentiepositie van het bedrijfsleven, werkgelegenheid, welvaart, welzijn, milieu etcetera. De Europese eenwording is van groot belang for de concurrentiepositie van het bedrijfsleven in Europa. Het creëren van de grootste uniforme thuismarkt ter wereld heeft vele positieve gevolgen voor het bedrijfsleven." ],
        [ sgpl:refersToConcept unesco:concept935 ;
            sgpl:subjectText "Europese integratie" ;
            sgpl:text_context "Na enkele maanden literatuur bestuderen en onderzoek verrichten ben ik er achter gekomen dat het 'fijne weten' van dit brede en complexe gebied (bijna) onmogelijk is. Het terrein waar de Europese integratie zijn invloed doet gelden is zeer uitgebreid. Zelfs als het onderzoeksterrein beperkt wordt tot de gevolgen van de integratie voor één bepaalde branche zijn de verwachte gevolgen afhankelijk van een veelheid aan factoren." ] ;
    sgpl:thesisID 240 .

sgpl:Thesis241 a sgpl:SGPLThesis ;
    dcterms:creator "R.M. Groeneweg" ;
    dcterms:issued 1992 ;
    dcterms:title "DE ATTRACTIVITEIT VAN SCHIPHOL: MOGELIJKE LIGGING VAN LUCHTHAVEN GEBONDEN BEDRIJFSLOCATIES VOOR NIET-LUCHTHAVEN GEBONDEN BEDRIJVIGHEID.",
        "Een onderzoek naar een bredere toepassing van projectgebonden kennis van de projecten: Plan van Aanpak Schiphol en Omgeving en de Nadere Uitwerking Randstad Internationaal." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Westelijk Havengebied" ;
            sgpl:text_context "In hoofdstuk 3 wordt de reden dat niet luchthavengebonden bedrijvigheid zich in de buurt van een luchthaven wil vestigen verklaard aan de hand van de rol dat het imago speelt in de locatiekeuze van bedrijvigheid. In hoofdstuk 4 zijn een aantal locaties beschreven met als doel te bezien in hoeverre deze locaties gekoppeld kunnen worden aan een Schiphol-imago. De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht Oudenrijn" ;
            sgpl:text_context "In hoofdstuk 3 wordt de reden dat niet luchthavengebonden bedrijvigheid zich in de buurt van een luchthaven wil vestigen verklaard aan de hand van de rol dat het imago speelt in de locatiekeuze van bedrijvigheid. In hoofdstuk 4 zijn een aantal locaties beschreven met als doel te bezien in hoeverre deze locaties gekoppeld kunnen worden aan een Schiphol-imago. De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Parijs" ;
            sgpl:text_context "De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere. In hoofdstuk 5 zijn drie buitenlandse luchthavens (Zaventem bij Brussel, Rhein-Main bij Frankfurt en Charles de Gaulle en Orly bij Parijs) en hun omgeving beschreven en is een vergelijking getrokken met de situatie rond Schiphol. Dit heeft tot doel te ontdekken of een stringent uitgiftebeleid van de bedrijfsterreinen rond Schiphol, rekening houdend met de mogelijkheden voor de benoeming van terreinen met een schiphol-imago op een grotere afstand van de luchthaven nadelige gevolgen zou kunnen hebben voor de concurrentiepositie van Schiphol ten opzichte van de andere luchthavens." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Marketing en promotie van dit grootstedelijk vestigingsmilieu. In de Vierde Nota van de Ruimtelijke Ordening (Extra) wordt een ruimtelijk ontwikkelingsperspectief geschetst, dat onder meer gericht is op het versterken van de internationale concurrentiepositie van Nederland. Voor een aantal van deze gewenste ontwikkelingen zijn nadere uitwerkingen voorgesteld." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6544259 ;
            sgpl:spatialText "Almere" ;
            sgpl:text_context "In hoofdstuk 3 wordt de reden dat niet luchthavengebonden bedrijvigheid zich in de buurt van een luchthaven wil vestigen verklaard aan de hand van de rol dat het imago speelt in de locatiekeuze van bedrijvigheid. In hoofdstuk 4 zijn een aantal locaties beschreven met als doel te bezien in hoeverre deze locaties gekoppeld kunnen worden aan een Schiphol-imago. De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Orly" ;
            sgpl:text_context "De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere. In hoofdstuk 5 zijn drie buitenlandse luchthavens (Zaventem bij Brussel, Rhein-Main bij Frankfurt en Charles de Gaulle en Orly bij Parijs) en hun omgeving beschreven en is een vergelijking getrokken met de situatie rond Schiphol. Dit heeft tot doel te ontdekken of een stringent uitgiftebeleid van de bedrijfsterreinen rond Schiphol, rekening houdend met de mogelijkheden voor de benoeming van terreinen met een schiphol-imago op een grotere afstand van de luchthaven nadelige gevolgen zou kunnen hebben voor de concurrentiepositie van Schiphol ten opzichte van de andere luchthavens." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Vanuit de wenselijkheid om een internationaal concurrerend vestigingsmilieu te stimuleren zal deze nadere uitwerking op basis van een kwalitatieve verkenning van het wonen, het werken, de infrastructuur en de relatie stad-land gericht zijn op de versterking van de functionele samenhang. In dit deel van hoofdstuk 2 wordt een samenvatting gegeven van de relevante hoofdpunten die afkomstig zijn van het concept eindrapport: Randstad Internationaal, Eenheid in verscheidenheid d.d. 30 Augustus 1991. Het motto van een nadere uitwerking is: samenwerking bij planvorming en uitvoering." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2925533 ;
            sgpl:spatialText "Rhein-Main" ;
            sgpl:text_context "De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere. In hoofdstuk 5 zijn drie buitenlandse luchthavens (Zaventem bij Brussel, Rhein-Main bij Frankfurt en Charles de Gaulle en Orly bij Parijs) en hun omgeving beschreven en is een vergelijking getrokken met de situatie rond Schiphol. Dit heeft tot doel te ontdekken of een stringent uitgiftebeleid van de bedrijfsterreinen rond Schiphol, rekening houdend met de mogelijkheden voor de benoeming van terreinen met een schiphol-imago op een grotere afstand van de luchthaven nadelige gevolgen zou kunnen hebben voor de concurrentiepositie van Schiphol ten opzichte van de andere luchthavens." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2800866 ;
            sgpl:spatialText "Brussel" ;
            sgpl:text_context "De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere. In hoofdstuk 5 zijn drie buitenlandse luchthavens (Zaventem bij Brussel, Rhein-Main bij Frankfurt en Charles de Gaulle en Orly bij Parijs) en hun omgeving beschreven en is een vergelijking getrokken met de situatie rond Schiphol. Dit heeft tot doel te ontdekken of een stringent uitgiftebeleid van de bedrijfsterreinen rond Schiphol, rekening houdend met de mogelijkheden voor de benoeming van terreinen met een schiphol-imago op een grotere afstand van de luchthaven nadelige gevolgen zou kunnen hebben voor de concurrentiepositie van Schiphol ten opzichte van de andere luchthavens." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2925533 ;
            sgpl:spatialText "Frankfurt" ;
            sgpl:text_context "De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere. In hoofdstuk 5 zijn drie buitenlandse luchthavens (Zaventem bij Brussel, Rhein-Main bij Frankfurt en Charles de Gaulle en Orly bij Parijs) en hun omgeving beschreven en is een vergelijking getrokken met de situatie rond Schiphol. Dit heeft tot doel te ontdekken of een stringent uitgiftebeleid van de bedrijfsterreinen rond Schiphol, rekening houdend met de mogelijkheden voor de benoeming van terreinen met een schiphol-imago op een grotere afstand van de luchthaven nadelige gevolgen zou kunnen hebben voor de concurrentiepositie van Schiphol ten opzichte van de andere luchthavens." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2759794 ;
            sgpl:spatialText "Amsterdam-Zuid" ;
            sgpl:text_context "In hoofdstuk 3 wordt de reden dat niet luchthavengebonden bedrijvigheid zich in de buurt van een luchthaven wil vestigen verklaard aan de hand van de rol dat het imago speelt in de locatiekeuze van bedrijvigheid. In hoofdstuk 4 zijn een aantal locaties beschreven met als doel te bezien in hoeverre deze locaties gekoppeld kunnen worden aan een Schiphol-imago. De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:6296680 ;
            sgpl:spatialText "Schiphol" ;
            sgpl:text_context "In hoofdstuk 4 zijn een aantal locaties beschreven met als doel te bezien in hoeverre deze locaties gekoppeld kunnen worden aan een Schiphol-imago. In hoofdstuk 5 zijn drie buitenlandse luchthavens (Zaventem bij Brussel, Rhein-Main bij Frankfurt en Charles de Gaulle en Orly bij Parijs) en hun omgeving beschreven en is een vergelijking getrokken met de situatie rond Schiphol. Dit heeft tot doel te ontdekken of een stringent uitgiftebeleid van de bedrijfsterreinen rond Schiphol, rekening houdend met de mogelijkheden voor de benoeming van terreinen met een schiphol-imago op een grotere afstand van de luchthaven nadelige gevolgen zou kunnen hebben voor de concurrentiepositie van Schiphol ten opzichte van de andere luchthavens." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2751773 ;
            sgpl:spatialText "Leiden" ;
            sgpl:text_context "In hoofdstuk 3 wordt de reden dat niet luchthavengebonden bedrijvigheid zich in de buurt van een luchthaven wil vestigen verklaard aan de hand van de rol dat het imago speelt in de locatiekeuze van bedrijvigheid. In hoofdstuk 4 zijn een aantal locaties beschreven met als doel te bezien in hoeverre deze locaties gekoppeld kunnen worden aan een Schiphol-imago. De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Charles de Gaulle" ;
            sgpl:text_context "De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere. In hoofdstuk 5 zijn drie buitenlandse luchthavens (Zaventem bij Brussel, Rhein-Main bij Frankfurt en Charles de Gaulle en Orly bij Parijs) en hun omgeving beschreven en is een vergelijking getrokken met de situatie rond Schiphol. Dit heeft tot doel te ontdekken of een stringent uitgiftebeleid van de bedrijfsterreinen rond Schiphol, rekening houdend met de mogelijkheden voor de benoeming van terreinen met een schiphol-imago op een grotere afstand van de luchthaven nadelige gevolgen zou kunnen hebben voor de concurrentiepositie van Schiphol ten opzichte van de andere luchthavens." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2783310 ;
            sgpl:spatialText "Zaventem" ;
            sgpl:text_context "De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere. In hoofdstuk 5 zijn drie buitenlandse luchthavens (Zaventem bij Brussel, Rhein-Main bij Frankfurt en Charles de Gaulle en Orly bij Parijs) en hun omgeving beschreven en is een vergelijking getrokken met de situatie rond Schiphol. Dit heeft tot doel te ontdekken of een stringent uitgiftebeleid van de bedrijfsterreinen rond Schiphol, rekening houdend met de mogelijkheden voor de benoeming van terreinen met een schiphol-imago op een grotere afstand van de luchthaven nadelige gevolgen zou kunnen hebben voor de concurrentiepositie van Schiphol ten opzichte van de andere luchthavens." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept5887 ;
            sgpl:subjectText "vestigingsplaatskeuzeproces" ;
            sgpl:text_context "Dergelijke onderzoeken geven de voorwaarden aan waar potentiële locaties aan dienen te voldoen om deze bedrijvigheid te kunnen vestigen. Ze geven echter niet precies aan hoe het vestigingsplaatskeuzeproces van bedrijven zal verlopen: welke afwegingen er gemaakt worden, welke belangen prioriteit hebben en hoe uiteindelijk de knoop doorgehakt wordt. Daarvoor moet een beroep worden gedaan op de achterliggende vestigingsplaatstheoriën." ],
        [ sgpl:refersToConcept unesco:concept8420 ;
            sgpl:subjectText "Schiphol-imago" ;
            sgpl:text_context "De reden dat niet luchthavengebonden bedrijvigheid zich in de buurt van een luchthaven wil vestigen wordt in hoofdstuk 3 verklaard aan de hand van de rol dat het imago speelt in de locatiekeuze van bedrijvigheid. In hoofdstuk 4 zijn een aantal locaties beschreven met als doel te bezien in hoeverre deze locaties gekoppeld kunnen worden aan een Schiphol-imago. De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere." ],
        [ sgpl:refersToConcept unesco:concept1567 ;
            sgpl:subjectText "luchthavengebonden bedrijvigheid" ;
            sgpl:text_context "Het onderzoek is gebaseerd op een stelling die in de eindrapporten van PASO en NURI wordt onderschreven, namelijk: \"de aanwezigheid van een goede internationale luchthaven is een vestigingsplaatsfactor van de eerste orde\". De stelling blijkt, zo wordt in PASO en NURI vermeld, niet alleen op te gaan voor luchthavengebonden bedrijvigheid: ook niet luchthavengebonden bedrijvigheid wil zich graag vestigen in de nabije omgeving van een luchthaven. In beide eindrapporten wordt het echter als een ongewenste situatie gezien indien de luchthaven beperkt wordt in haar functioneren doordat zij ingesloten ligt tussen bebouwing of onbereikbaar wordt vanwege de extra gegenereerde vervoersstromen van en naar deze bedrijven." ],
        [ sgpl:refersToConcept unesco:concept5887 ;
            sgpl:subjectText "vestigingsplaatskeuzeproces" ;
            sgpl:text_context "Dergelijke onderzoeken geven de voorwaarden aan waar potentiële locaties aan dienen te voldoen om deze bedrijvigheid te kunnen vestigen. Ze geven echter niet precies aan hoe het vestigingsplaatskeuzeproces van bedrijven zal verlopen: welke afwegingen er gemaakt worden, welke belangen prioriteit hebben en hoe uiteindelijk de knoop doorgehakt wordt. Daarvoor moet een beroep worden gedaan op de achterliggende vestigingsplaatstheoriën." ],
        [ sgpl:refersToConcept unesco:concept1567 ;
            sgpl:subjectText "luchthavengebonden bedrijvigheid" ;
            sgpl:text_context "Het onderzoek is gebaseerd op een stelling die in de eindrapporten van PASO en NURI wordt onderschreven, namelijk: \"de aanwezigheid van een goede internationale luchthaven is een vestigingsplaatsfactor van de eerste orde\". De stelling blijkt, zo wordt in PASO en NURI vermeld, niet alleen op te gaan voor luchthavengebonden bedrijvigheid: ook niet luchthavengebonden bedrijvigheid wil zich graag vestigen in de nabije omgeving van een luchthaven. In beide eindrapporten wordt het echter als een ongewenste situatie gezien indien de luchthaven beperkt wordt in haar functioneren doordat zij ingesloten ligt tussen bebouwing of onbereikbaar wordt vanwege de extra gegenereerde vervoersstromen van en naar deze bedrijven." ],
        [ sgpl:refersToConcept unesco:concept8420 ;
            sgpl:subjectText "Schiphol-imago" ;
            sgpl:text_context "De reden dat niet luchthavengebonden bedrijvigheid zich in de buurt van een luchthaven wil vestigen wordt in hoofdstuk 3 verklaard aan de hand van de rol dat het imago speelt in de locatiekeuze van bedrijvigheid. In hoofdstuk 4 zijn een aantal locaties beschreven met als doel te bezien in hoeverre deze locaties gekoppeld kunnen worden aan een Schiphol-imago. De locaties zijn Amsterdam-Zuid, het Westelijk Havengebied/Teleport, de Stationslocatie in Leiden, Utrecht Oudenrijn en de bedrijventerreinen van Almere." ] ;
    sgpl:thesisID 241 .

sgpl:Thesis242 a sgpl:SGPLThesis ;
    dcterms:creator "Marcel Reinartz",
        "Richard Hoving" ;
    dcterms:issued 1992 ;
    dcterms:title "CONSUMENTENONDERZOEK TILBURG",
        "VERSLAGEN VAN LEERONDERZOEK G&P" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Hel merendeel van de bevolking wilde \"de grote stad\" ontvluchten en zich vestigen in de randgemeenten of de groene buitenwijken van middelgrote steden. Hierdoor werden met name de vier grote steden (A’dam, R’dam, Den Haag en Utrecht), maar ook de middelgrote steden in Nederland met een grote leegloop geconfronteerd. De stad lijkt zich in de jaren tachtig goed hersteld te hebben van het negatieve imago dal in hel voorgaande decennium heeft geleid tot omvangrijke uitgaande verhuisstromen van zowel bevolking als werkgelegenheid (Van Beetz e.a., 1989)." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Heuvelhof" ;
            sgpl:text_context "Dit is in de definitieve enquete ondervangen door het kemwinkelapparaat in een aantal segmenten op te delen en de respondent per segment naar de waarde- ring te vragen. Op basis van het vooronderzoek is een indeling van het kemwinkelapparaat in zes segmenten tot stand gekomen: Schouwburgpromenade, Heuvelstraat, Heuvelhof, Katterug, Citycenler en Heuvelpoorl (zie figuur 2.1). Omdat het uiteindelijk de bedoeling is de diverse segmenten, voor zover mogelijk, met elkaar te vergelijken, komt een aantal waarderingsvragen bij elk segment terug." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2754121 ;
            sgpl:spatialText "Heuvelstraat" ;
            sgpl:text_context "Het westelijk deel van de Heuvelstraat strekt zich uit van de Katterug tot de Nieuwlandslraal. Binnen het centrumwinkelgebied van Tilburg is de Heuvelstraat de langste en tevens belangrijkste winkelstraat. Deze straat is in feite de \"navelstreng\" van het kernwinkelapparaat van Tilburg." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "binnenstad van Tilburg" ;
            sgpl:text_context "Om deze reden zullen de bewoners geen vragen worden voorgelegd, waarbij hel winkelaanbod in Tilburg wordt vergeleken met hel aanbod in andere, concurrerende steden. Uit de doelstelling en de onderzoeksvragen blijkt dal het onderzoek in twee delen uiteen valt: enerzijds een passantentelling in de binnenstad van Tilburg en anderzijds een toetsing van de mening van consumenten ten aanzien van het kernwinkelapparaal van Tilburg. Omdat de beide deelonderzoeken na elkaar zullen worden uitgevoerd, kan het onderzoek worden gezien als een twee-lraps raket." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Katterug" ;
            sgpl:text_context "Dit is in de definitieve enquete ondervangen door het kemwinkelapparaat in een aantal segmenten op te delen en de respondent per segment naar de waarde- ring te vragen. Op basis van het vooronderzoek is een indeling van het kemwinkelapparaat in zes segmenten tot stand gekomen: Schouwburgpromenade, Heuvelstraat, Heuvelhof, Katterug, Citycenler en Heuvelpoorl (zie figuur 2.1). Omdat het uiteindelijk de bedoeling is de diverse segmenten, voor zover mogelijk, met elkaar te vergelijken, komt een aantal waarderingsvragen bij elk segment terug." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Citycenter" ;
            sgpl:text_context "Dit is in de definitieve enquete ondervangen door het kemwinkelapparaat in een aantal segmenten op te delen en de respondent per segment naar de waarde- ring te vragen. Op basis van het vooronderzoek is een indeling van het kemwinkelapparaat in zes segmenten tot stand gekomen: Schouwburgpromenade, Heuvelstraat, Heuvelhof, Katterug, Citycenler en Heuvelpoorl (zie figuur 2.1). Omdat het uiteindelijk de bedoeling is de diverse segmenten, voor zover mogelijk, met elkaar te vergelijken, komt een aantal waarderingsvragen bij elk segment terug." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "Tilburg" ;
            sgpl:text_context "Sinds et midden van de jaren tachtig hebben veel gemeenten hun ruimtelijke ordeningsbeleid loegcspitst op het verbeteren van de aantrekkelijkheid de binnenstad in het algemeen en het kcrnwinkelapparaat in het bijzonder. De stad Tilburg is als case voor de studie gehanteerd. De gemeente Tilburg heeft in hel kader van hel compacte stadbeleid de laatste jaren de nodige veranderingen in het kernwinkelapparaal doorgevoerd." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Schouwburgpromenade" ;
            sgpl:text_context "Voor wal betreft de winkelfunctie omvatte het actieprogramma de volgende elementen: a. versterken van het aanbod in omvang en kwaliteit; b. verbeteren van de winkelrouting; c. stedebouwkundige verbeteringen; d. verbeteren van de bereikbaarheid en de parkeergelegenheid; e. herinrichting van de aanloopstralen naar het centrumwinkelgebied. Het in de Compacte Stadplannen opgenomen actieprogramma heeft de laatste jaren geresulteerd in onder meer de totstandkoming van de Schouwburgpromenade (\"herinrichlen van aanloopstralen\"), de implementatie van de \"versmarkt\" in de Heuvelpoort (\"versterken van omvang en kwaliteit\") en, recentelijk, de oplevering van de Emmapassage (\"verbetering van de winkelrouting\"). Als gevolg van deze ingrepen is het aanbod van winkelvoorzieningen in omvang en kwaliteit verder uitgebreid." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Heuvelpoort" ;
            sgpl:text_context "Dit is in de definitieve enquete ondervangen door het kemwinkelapparaat in een aantal segmenten op te delen en de respondent per segment naar de waarde- ring te vragen. Op basis van het vooronderzoek is een indeling van het kemwinkelapparaat in zes segmenten tot stand gekomen: Schouwburgpromenade, Heuvelstraat, Heuvelhof, Katterug, Citycenler en Heuvelpoorl (zie figuur 2.1). Omdat het uiteindelijk de bedoeling is de diverse segmenten, voor zover mogelijk, met elkaar te vergelijken, komt een aantal waarderingsvragen bij elk segment terug." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2746301 ;
            sgpl:spatialText "Gemeente Tilburg" ;
            sgpl:text_context "Voor de totstandkoming van dit rapport willen wij in het bijzonder Drs. J. Borchert van de vakgroep Geografie & Planning bedanken voor zijn inspirerende begeleiding. Voorts willen we de gemeente Tilburg cn de ondernemersfederatie Tilburg bedanken voor de financiering van het onderzoek en het verstrekken van de steekproefgegevens. Onze dank gaat daarbij vooral uit naar de heer J. Engelen van de afdeling Economische Zaken." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "consumentengedrag" ;
            sgpl:text_context "De gemeente kan echter niet alle aspecten die van invloed zijn op het consumentengedrag beïnvloeden. Om te achterhalen hoe een gemeente de aantrekkelijkheid van een kernwinkelapparaat zou kunnen vergroten, moet eerst worden bekeken welke factoren van invloed zijn op dit consumentengedrag. Timmermans (1981) beschrijft de relatie tussen ruimtelijke, distributieve structuur en ruimtelijk gedrag als volgt: \"Ruimtelijke structuur en ruimtelijk gedrag zijn wederzijds afhankelijk.\"" ],
        [ sgpl:refersToConcept unesco:concept1408 ;
            sgpl:subjectText "compacte stadbeleid" ;
            sgpl:text_context "Mede geïnspireerd door deze nota ontwikkelden veel middelgrote en grote steden een visie op de mogelijkheden om te profiteren van de toenemende belangstelling voor de binnenstad. Deze visie werd veelal in de vorm van een \"compacte stadbeleid\" gepresenteerd. De stad moest weer een smeltkroes van activiteiten (wonen, werken, recreëren en winkelen) worden." ],
        [ sgpl:refersToConcept unesco:concept1497 ;
            sgpl:subjectText "kernwinkelapparaat" ;
            sgpl:text_context "Deze rapportage vormt de verslaglegging van het onderzoek naar de waardering van het mede door de beleidsmaatregelen veranderde kernwinkelapparaat. Onderzocht is enerzijds hoe de bevolking van Tilburg het kernwinkelapparaat in de huidige situatie waardeert, en anderzijds of men van mening is dat de ingrepen in het kernwinkelapparaat tot verbeteringen hebben geleid. Op basis van de resultaten van het onderzoek worden daarnaast suggesties voor de verdere verbetering van het Tilburgse kernwinkelapparaat aan de hand gedaan." ],
        [ sgpl:refersToConcept unesco:concept1408 ;
            sgpl:subjectText "compacte stadbeleid" ;
            sgpl:text_context "Mede geïnspireerd door deze nota ontwikkelden veel middelgrote en grote steden een visie op de mogelijkheden om te profiteren van de toenemende belangstelling voor de binnenstad. Deze visie werd veelal in de vorm van een \"compacte stadbeleid\" gepresenteerd. De stad moest weer een smeltkroes van activiteiten (wonen, werken, recreëren en winkelen) worden." ],
        [ sgpl:refersToConcept unesco:concept6377 ;
            sgpl:subjectText "consumentengedrag" ;
            sgpl:text_context "De gemeente kan echter niet alle aspecten die van invloed zijn op het consumentengedrag beïnvloeden. Om te achterhalen hoe een gemeente de aantrekkelijkheid van een kernwinkelapparaat zou kunnen vergroten, moet eerst worden bekeken welke factoren van invloed zijn op dit consumentengedrag. Timmermans (1981) beschrijft de relatie tussen ruimtelijke, distributieve structuur en ruimtelijk gedrag als volgt: \"Ruimtelijke structuur en ruimtelijk gedrag zijn wederzijds afhankelijk.\"" ],
        [ sgpl:refersToConcept unesco:concept1497 ;
            sgpl:subjectText "kernwinkelapparaat" ;
            sgpl:text_context "Deze rapportage vormt de verslaglegging van het onderzoek naar de waardering van het mede door de beleidsmaatregelen veranderde kernwinkelapparaat. Onderzocht is enerzijds hoe de bevolking van Tilburg het kernwinkelapparaat in de huidige situatie waardeert, en anderzijds of men van mening is dat de ingrepen in het kernwinkelapparaat tot verbeteringen hebben geleid. Op basis van de resultaten van het onderzoek worden daarnaast suggesties voor de verdere verbetering van het Tilburgse kernwinkelapparaat aan de hand gedaan." ] ;
    sgpl:thesisID 242 .

sgpl:Thesis243 a sgpl:SGPLThesis ;
    dcterms:creator "Victor Klein" ;
    dcterms:issued 1992 ;
    dcterms:title "Een onderzoek naar het koopgedrag van huishoudens in Spijkenisse en de gevolgen van veranderingen in de huishoudensopbouw voor het winkelapparaat.",
        "Huishoudensdifferentiatie en koopgedrag." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "Maaswijk" ;
            sgpl:text_context "Maaswijk biedt perspectieven voor de bouw van een wijkwinkelcentrum zoals de Akkerhof. Zeker wanneer de uitbreiding van de noord-zuid verbinding plaatsvindt zal er de mogelijkheid zijn voor de ontwikkeling van een bedrijfsterrein met kantoren en een stadsdeelcentrum. In Maaswijk, de laatste uitbreidingswijk, zullen ééngezinswoningen aan de bestaande woningvoorraad worden toegevoegd, terwijl de bouw van seniorwoningen zich toespitst op het centrum." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Rijksuniversiteit te Utrecht" ;
            sgpl:text_context "Het onderzoek is verricht in het kader van het doktoraalprogramma van de vakgroep Toegepaste Geografie en Planologie van de faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit te Utrecht. De uitvoering vond plaats in de periode september 1990 - juli 1991. De telefonische enquête is uitgevoerd van half november tot half december 1990." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746931 ;
            sgpl:spatialText "de gemeente Spijkenisse" ;
            sgpl:text_context "Voor U ligt het verslag van het onderzoek naar het kooppatronen van huishoudens in de gemeente Spijkenisse. Het onderzoek is verricht in het kader van het doktoraalprogramma van de vakgroep Toegepaste Geografie en Planologie van de faculteit der Ruimtelijke Wetenschappen van de Rijksuniversiteit te Utrecht. De uitvoering vond plaats in de periode september 1990 - juli 1991." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Figuur 1: De bevolkingsopbouw van Nederland, groeikernen en de grote steden in 2000. In de stedelijke bevolkingsopbouw treden de laatste twintig jaar enkele belangrijke verschuivingen op. Ontwikkelingen die daarbij een rol spelen zijn onder meer vergrijzing, veranderde patronen in huishoudensvorming en relatie-ontbinding." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753666 ;
            sgpl:spatialText "Hoogvliet" ;
            sgpl:text_context "Het merendeel van de respondenten komt uit Rotterdam en Hoogvliet. Onder de huishoudens zijn er acht van Spijkenisser oorsprong. In tabel 33 wordt het vestigingsjaar van de respondenten en hun huishoudens in Spijkenisse getoond." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2747891 ;
            sgpl:spatialText "Rotterdam" ;
            sgpl:text_context "Het percentage tweeverdieners in Nederland steeg van 42% in 1982 naar 47% in 1988. De mogelijkheid om in de regio, en met name Rotterdam, een geschikte arbeidsplaats te vinden zal groter zijn. Het ligt dan ook voor de hand te veronderstellen dat een groot deel van de Spijkenisser inwoonsters elders werkzaam is." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2758012 ;
            sgpl:spatialText "Capelle aan de IJssel" ;
            sgpl:text_context "Voor de aankopen van aardappelen, groente en fruit, vlees en vleeswaren en voor brood en banket gaan Spijkenisser huishoudens ook regelmatig naar winkels in Capelle aan de IJssel, Geervliet, Klaaswaal, Brielle en andere kleinere gemeenten, vooral vanwege de prijs of omdat men bekend is met de winkel. Het kooppatroon van huishoudens wordt ook nog onderscheiden naar frequentie van het boodschappen doen, het tijdstip waarop men meestal de inkopen doet en het autogebruik." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746932 ;
            sgpl:spatialText "Spijkenisse" ;
            sgpl:text_context "Deze veranderingen concentreerden zich in eerste instantie in de grote steden van ons land. Spijkenisse is een groeikern waar een hoogwaardig woonmilieu is gerealiseerd met een daarbij behorend voorzieningenniveau en een gunstige werkgelegenheidsontwikkeling. Door autonome ontwikkelingen en de status van een groeikern met een verhoogde taakstelling wordt de regionale positie van Spijkenisse versterkt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2746932 ;
            sgpl:spatialText "het centrum van Spijkenisse" ;
            sgpl:text_context "Gezien de resultaten van het kooppatroon van ouderen is het centrum van Spijkenisse de aangewezen plek voor seniorwoningen. De winkels in het centrum hebben een dusdanige reikwijdte dat ook anderen uit de gemeente hier hun dagelijkse boodschappen doen en ze niet te lijden zullen hebben van de lagere bestedingsniveaus van oudere huishoudens. In andere wijken zal als gevolg van ontgroening, vergrijzing en huishoudensverdunning het draagvlak van winkels meer teruglopen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:spatialText "de Akkers" ;
            sgpl:text_context "Tabel 3.9: Het centrum en de Akkers als eerste en tweede aankoopplaats voor mensen uit andere wijken. Bij een vergelijking valt op dat winkels in de Akkers aan aantrekkingskracht voor personen uit andere wijken nauwelijks onderdoen voor het centrum. Het centrum trekt vooral bezoekers die drogisterij en parfumerie artikelen nodig hebben, terwijl men voor de Akkers bezoekt voor de aankopen van dranken, aardappelen, groente en fruit en kruidenierswaren en zuivelprodukten." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept10308 ;
            sgpl:subjectText "winkelapparaat" ;
            sgpl:text_context "Iedere groep huishoudens heeft een specifiek koopgedrag. Verschuivingen in de stedelijke huishoudensopbouw door sociaal-demografische of -economische veranderingen kunnen een daling van de koopkrachtbinding met het winkelapparaat betekenen. Dit is het uitgangspunt voor het conceptueel model (figuur 4) waarop de probleemstelling is gebaseerd." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "koopgedrag" ;
            sgpl:text_context "Waar en wanneer men inkomen doet is eveneens afhankelijk van huishoudenskenmerken die bepalen hoeveel tijd men heeft en of men bekend is met de winkelomgeving. Iedere groep huishoudens heeft een specifiek koopgedrag. Verschuivingen in de stedelijke huishoudensopbouw door sociaal-demografische of -economische veranderingen kunnen een daling van de koopkrachtbinding met het winkelapparaat betekenen." ],
        [ sgpl:refersToConcept unesco:concept10702 ;
            sgpl:subjectText "huishoudensdifferentiatie" ;
            sgpl:text_context "De verschillen in de leeftijdsopbouw van de bevolking en verschillen in sociaal-culturele en sociaal-economische groepen tussen groeigemeenten en de grote en middelgrote steden worden kleiner, zo blijkt uit onderzoek. In de grote steden heeft de huishoudensdifferentiatie al een grotere vlucht genomen. In Spijkenisse speelt men al sinds het begin van de jaren tachtig in op veranderingen in de bevolkingsstructuur, met name met het volkshuisvestingsbeleid waarbij men de woningvoorraad aanpast aan de mogelijke toekomstige behoefte van inwoners binnen de eigen gemeente." ],
        [ sgpl:refersToConcept unesco:concept10702 ;
            sgpl:subjectText "huishoudensdifferentiatie" ;
            sgpl:text_context "De verschillen in de leeftijdsopbouw van de bevolking en verschillen in sociaal-culturele en sociaal-economische groepen tussen groeigemeenten en de grote en middelgrote steden worden kleiner, zo blijkt uit onderzoek. In de grote steden heeft de huishoudensdifferentiatie al een grotere vlucht genomen. In Spijkenisse speelt men al sinds het begin van de jaren tachtig in op veranderingen in de bevolkingsstructuur, met name met het volkshuisvestingsbeleid waarbij men de woningvoorraad aanpast aan de mogelijke toekomstige behoefte van inwoners binnen de eigen gemeente." ],
        [ sgpl:refersToConcept unesco:concept386 ;
            sgpl:subjectText "koopgedrag" ;
            sgpl:text_context "Waar en wanneer men inkomen doet is eveneens afhankelijk van huishoudenskenmerken die bepalen hoeveel tijd men heeft en of men bekend is met de winkelomgeving. Iedere groep huishoudens heeft een specifiek koopgedrag. Verschuivingen in de stedelijke huishoudensopbouw door sociaal-demografische of -economische veranderingen kunnen een daling van de koopkrachtbinding met het winkelapparaat betekenen." ],
        [ sgpl:refersToConcept unesco:concept10308 ;
            sgpl:subjectText "winkelapparaat" ;
            sgpl:text_context "Iedere groep huishoudens heeft een specifiek koopgedrag. Verschuivingen in de stedelijke huishoudensopbouw door sociaal-demografische of -economische veranderingen kunnen een daling van de koopkrachtbinding met het winkelapparaat betekenen. Dit is het uitgangspunt voor het conceptueel model (figuur 4) waarop de probleemstelling is gebaseerd." ] ;
    sgpl:thesisID 243 .

sgpl:Thesis244 a sgpl:SGPLThesis ;
    dcterms:creator "A.T. Konijnendijk" ;
    dcterms:issued 1992 ;
    dcterms:title "Een onderzoek naar vervangbaarheid van woon-werk autoverplaatsingen door het huidige streekvervoernetwerk in de vervoerregio Utrecht.",
        "HET STREEKVERVOER ALS ALTERNATIEF VOOR DE AUTO." ;
    sgpl:hasSpatialReference [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stad Utrecht" ;
            sgpl:text_context "Allereerst wordt getracht een gebied af te bakenen dat voor de stad Utrecht en omgeving als vervoerregio kan dienen. Vervolgens wordt een antwoord gegeven op de vraag in hoeverre het huidige netwerk van de streekvervoerbedrijven in (het stadsgewest) Utrecht in staat is woon-werkverplaatsingen per auto over te nemen. Dit wordt enerzijds bekeken vanuit de vraagzijde: is het voor automobilisten binnen gestelde criteria mogelijk de woon-werk trip per bus of sneltram te maken?" ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2759821 ;
            sgpl:spatialText "Amersfoort" ;
            sgpl:text_context "Deze centra hebben bepaalde invloedsgebieden. Voor de regio Utrecht geldt, dat het invloedsgebied van Amersfoort bijna helemaal binnen dat van Utrecht valt. Daarom is Amersfoort bij Utrecht gevoegd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Groene Hart" ;
            sgpl:text_context "Bij de inrichting van stadsgewesten moet rekening gehouden worden met de ruimtelijke kwaliteit en de internationale positie van Nederland. Ten tweede zal er geen instraling in het Groene Hart plaatsvinden. Woningbouw wordt geconcentreerd op de ring van de Randstad." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2745431,
                geonames:2757295 ;
            sgpl:spatialText "Vleuten/De Meem" ;
            sgpl:text_context "Woningbouw wordt geconcentreerd op de ring van de Randstad. Concreet betekent dit voor de ontwikkeling van het stadsgewest Utrecht dat er tussen 1995 en 2015 circa 50000 woningen bij de woningvoorraad gevoegd worden. Samengevat ziet de ontwikkeling van het stadsgewest er in de periode 1995-2005 als volgt uit: - circa 5000 woningen in Utrecht als gevolg van herstructurering en verdichting; - ontwikkeling van woningen in Houten, Vleuten/De Meem; - versterking van het openbaar vervoer: sneltram CS-Uithof en CS-Vleuten/De Meem-Maarssen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "stadsgewest Utrecht" ;
            sgpl:text_context "In hoofdstuk 5 is een beeld geschetst van de opbouw van het lijnennet van het stadsvervoer in Utrecht en de streekvervoerbedrijven. Hoofdstuk 6 geeft de analyse van de woon-werk verplaatsingen per auto die in het stadsgewest Utrecht onderscheiden kunnen worden. In hoofdstuk 7 de reismogelijkheden per bus en sneltram en de daarbij behorende reistijden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "Ten tweede zal er geen instraling in het Groene Hart plaatsvinden. Woningbouw wordt geconcentreerd op de ring van de Randstad. Concreet betekent dit voor de ontwikkeling van het stadsgewest Utrecht dat er tussen 1995 en 2015 circa 50000 woningen bij de woningvoorraad gevoegd worden." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Vooral bet toegenomen autobezit en -gebruik is hiervan de oorzaak. De totale mobiliteit in Nederland tussen 1960 en 1987 steeg van 41 naar bijna 152 miljard reizigerskilometers. De auto nam hiervan het leeuwedeel voor zijn rekening: van 23 naar 130 miljard reizigerskilometers." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750325 ;
            sgpl:spatialText "Nieuwegein" ;
            sgpl:text_context "Zonder overstap kan Utrecht CS bereikt worden vanuit de richting Houten, Nieuwegein, Vianen, IJsselstein, De Meem. Ten tijde van de tellingen onderhield Wn 3 tangentiele lijnen, nu zijn dat er 4 (lijn 280, 281, 282, 284). Deze lopen vanuit plaatsen uit de regio naar de Uithof, AZU en Rijnsweerd." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753557 ;
            sgpl:spatialText "Houten" ;
            sgpl:text_context "Woningbouw wordt geconcentreerd op de ring van de Randstad. Concreet betekent dit voor de ontwikkeling van het stadsgewest Utrecht dat er tussen 1995 en 2015 circa 50000 woningen bij de woningvoorraad gevoegd worden. Samengevat ziet de ontwikkeling van het stadsgewest er in de periode 1995-2005 als volgt uit: - circa 5000 woningen in Utrecht als gevolg van herstructurering en verdichting; - ontwikkeling van woningen in Houten, Vleuten/De Meem; - versterking van het openbaar vervoer: sneltram CS-Uithof en CS-Vleuten/De Meem-Maarssen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "vervoerregio Utrecht" ;
            sgpl:text_context "In hoofdstuk 3 geeft weer hoe in diverse nota’s en structuurschema’s het regeringsbeleid verwoord wordt. In hoofdstuk 4 komt aan de orde wat de grenzen van de Utrechtse vervoerregio kunnen zijn. In hoofdstuk 5 is een beeld geschetst van de opbouw van het lijnennet van het stadsvervoer in Utrecht en de streekvervoerbedrijven." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept12861 ;
            sgpl:subjectText "streekvervoer" ;
            sgpl:text_context "Opvallend is overigens dat de stadsdiensten doorgaans de gemeentegrenzen niet overschreden. Het streekvervoer heeft haar vervoersaanbod in stedelijke gebieden aanzienlijk uitgebreid. Met name op het platteland, in de avonduren en op zondagen is de dienstverlening aanzienlijk ingekrompen (M.A. de Jong, CVS 1990, pag 527,528)." ],
        [ sgpl:refersToConcept unesco:concept5884 ;
            sgpl:subjectText "woon-werkverkeer" ;
            sgpl:text_context "Het beleidsvoornemen van het Tweede Structuurschema Verkeer en Vervoer (deel a) is gericht op een evenwichtige afstemming tussen bereikbaarheid, leefbaarheid en individuele vrijheid. De overstap van auto naar het openbaar vervoer zou met name in het woon-werkverkeer plaats moeten vinden. Om het zakelijk personenverkeer en goederenvervoer de nodige ruimte te geven moet een hierarchisch vervoersnetwerk ontwikkeld worden." ],
        [ sgpl:refersToConcept unesco:concept661 ;
            sgpl:subjectText "verplaatsingstijdfactor" ;
            sgpl:text_context "Hierop wordt in deze studie de aandacht gevestigd. De vergelijking van reistijd per auto en openbaar vervoer komt tot uitdrukking in de verplaatsingstijdfactor (VF). Deze wordt als volgt berekend: verplaatsingstijd per openbaar vervoer / verplaatsingstijd per auto = VF." ],
        [ sgpl:refersToConcept unesco:concept12861 ;
            sgpl:subjectText "streekvervoer" ;
            sgpl:text_context "Opvallend is overigens dat de stadsdiensten doorgaans de gemeentegrenzen niet overschreden. Het streekvervoer heeft haar vervoersaanbod in stedelijke gebieden aanzienlijk uitgebreid. Met name op het platteland, in de avonduren en op zondagen is de dienstverlening aanzienlijk ingekrompen (M.A. de Jong, CVS 1990, pag 527,528)." ],
        [ sgpl:refersToConcept unesco:concept5884 ;
            sgpl:subjectText "woon-werkverkeer" ;
            sgpl:text_context "Het beleidsvoornemen van het Tweede Structuurschema Verkeer en Vervoer (deel a) is gericht op een evenwichtige afstemming tussen bereikbaarheid, leefbaarheid en individuele vrijheid. De overstap van auto naar het openbaar vervoer zou met name in het woon-werkverkeer plaats moeten vinden. Om het zakelijk personenverkeer en goederenvervoer de nodige ruimte te geven moet een hierarchisch vervoersnetwerk ontwikkeld worden." ],
        [ sgpl:refersToConcept unesco:concept661 ;
            sgpl:subjectText "verplaatsingstijdfactor" ;
            sgpl:text_context "Hierop wordt in deze studie de aandacht gevestigd. De vergelijking van reistijd per auto en openbaar vervoer komt tot uitdrukking in de verplaatsingstijdfactor (VF). Deze wordt als volgt berekend: verplaatsingstijd per openbaar vervoer / verplaatsingstijd per auto = VF." ] ;
    sgpl:thesisID 244 .

sgpl:Thesis245 a sgpl:SGPLThesis ;
    dcterms:creator "Bart de Rijke" ;
    dcterms:issued 1992 ;
    dcterms:title "Blik in de binnenstad",
        "Ontwikkelingen in het binnenstedelijk goederenvervoer" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2988507 ;
            sgpl:spatialText "Parijs" ;
            sgpl:text_context "De schaal waarop dit centrum kan opereren is echter dermate groot, dat elke vergelijking met Nederlandse steden mank gaat. Bovendien zijn de prijzen van de goederen in Parijs sindsdien zeer hoog, waardoor de exploitatie dekkend is gemaakt. In Nederland wordt ernaar gestreefd een oplossing te zoeken die kostendekkend is." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Utrecht" ;
            sgpl:text_context "Voorwoord. Loop op een willekeurige doordeweekse dag over de Oude Gracht in het centrum van de stad Utrecht en je gaat je onderzoek naar binnenstedelijk goederenvervoer zien als een wetenschappelijke missie: belangrijk, maar niet waardevrij. In dit spanningsveld tussen objectiviteit en betrokkenheid heb ik mij van september 1990 tot juni 1992, soms meer en soms minder intensief bezig gehouden met dit onderwerp." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750405 ;
            sgpl:spatialText "Nederland" ;
            sgpl:text_context "Maar de historische binnensteden van Nederland kunnen de stroom mensen en voertuigen niet meer aan. Congestie, milieuverontreiniging en geluidsoverlast nemen buitenproportionele vormen aan. Investeringen in de fysieke infrastructuur van de grote steden in ons land zijn mede onder invloed van de economische recessie en het 'Nederland-is-af-gevoel' achterop geraakt." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "het Utrechtse werfkeldergebied" ;
            sgpl:text_context "In het onderzoek dat voor de Kamer van Koophandel Utrecht is uitgevoerd inzake bevoorrading van het werfkeldergebied van Utrecht (De Rijke, 1991) en dat als empirisch deel van deze scriptie dient, is reeds een beter inzicht verschaft in de kwantitatieve aspecten van stadsdistributiecentra. Het ligt in de bedoeling met dit aanvullende deel een meer kwalitatieve benadering van het fenomeen SDC te geven, waarbij een aantal ontwikkelingen aan bod komt die mijns inziens tot nu toe in de discussie rond binnenstedelijk goederenvervoer onvoldoende belicht zijn. Ook wordt over het voorgestelde alternatief heengekeken naar een aantal verbeteringen in c.q. aanvullingen op het concept." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "het centrum van de stad Utrecht" ;
            sgpl:text_context "Voorwoord. Loop op een willekeurige doordeweekse dag over de Oude Gracht in het centrum van de stad Utrecht en je gaat je onderzoek naar binnenstedelijk goederenvervoer zien als een wetenschappelijke missie: belangrijk, maar niet waardevrij. In dit spanningsveld tussen objectiviteit en betrokkenheid heb ik mij van september 1990 tot juni 1992, soms meer en soms minder intensief bezig gehouden met dit onderwerp." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751283 ;
            sgpl:spatialText "Maastricht" ;
            sgpl:text_context "Inmiddels is uit vier proefgemeenten waar een haalbaarheidsstudie is uitgevoerd de gemeente Maastricht gekozen en na rapportage over het plan van aanpak in januari 1992 wordt ernaar gestreefd om begin volgend jaar te beginnen met bevoorrading van de binnenstad via een of meer SDC's. De rapportages van Coopers kregen echter de laatste maanden veel kritiek van verschillende zijden. Deze kritiek betrof vooral de gebrekkige cijfermatige onderbouwing van de huidige situatie in binnenstedelijke bevoorrading." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2751282 ;
            sgpl:spatialText "gemeente Maastricht" ;
            sgpl:text_context "Inmiddels is uit vier proefgemeenten waar een haalbaarheidsstudie is uitgevoerd de gemeente Maastricht gekozen en na rapportage over het plan van aanpak in januari 1992 wordt ernaar gestreefd om begin volgend jaar te beginnen met bevoorrading van de binnenstad via een of meer SDC's. De rapportages van Coopers kregen echter de laatste maanden veel kritiek van verschillende zijden. Deze kritiek betrof vooral de gebrekkige cijfermatige onderbouwing van de huidige situatie in binnenstedelijke bevoorrading." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2944388 ;
            sgpl:spatialText "Bremen" ;
            sgpl:text_context "Uit het buitenland zijn veel voorbeelden van problemen maar slechts van een klein aantal mogelijke oplossingen bekend. Zo bestaat in Duitsland een succesvol 'Guterverkehrszentrum' in Bremen. Het betreft hier een multimodaal overslagpunt voor goederen." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:7279861 ;
            sgpl:spatialText "Randstad" ;
            sgpl:text_context "De Randstad als economisch centrum van Nederland mag weer aandacht krijgen. Een goede bereikbaarheid van deze regio is daarom een vereiste, maar deze bereikbaarheid mag niet ten koste gaan van een te grote aanslag op de dagelijkse leefomgeving. In het Tweede Structuurschema Verkeer en Vervoer worden de begrippen bereikbaarheid en leefbaarheid gebruikt als basis voor het streven naar een duurzame samenleving." ] ;
    sgpl:hasSubjectReference [ sgpl:refersToConcept unesco:concept14074 ;
            sgpl:subjectText "Stadsdistributiecentrum" ;
            sgpl:text_context "Toch krijgen de problemen pas recentelijk enige aandacht. De discussie rond een oplossing voor deze problemen wordt momenteel voornamelijk gevoerd rond de kwantitatieve haalbaarheid van een door de overheid gekozen alternatieve bevoorradingsmethode, het Stadsdistributiecentrum. Nadat deze haalbaarheid reeds in het Kamer-rapport werd aangevochten, is dit verslag bedoeld als een kritische kanttekening en aanvulling op de kwalitatieve argumenten in de discussie." ],
        [ sgpl:refersToConcept unesco:concept5888 ;
            sgpl:subjectText "binnenstedelijk goederenvervoer" ;
            sgpl:text_context "Nadat deze haalbaarheid reeds in het Kamer-rapport werd aangevochten, is dit verslag bedoeld als een kritische kanttekening en aanvulling op de kwalitatieve argumenten in de discussie. In de eerste plaats is een aantal maatschappelijke en logistieke ontwikkelingen genoemd die van invloed zijn op binnenstedelijk goederenvervoer en dus ook op een mogelijk alternatief hiervoor. Van belang hierbij is de ruimtelijke context van het onderwerp, namelijk de (binnen)stad zelf, die een eigen dynamiek vertoont." ],
        [ sgpl:refersToConcept unesco:concept8751 ;
            sgpl:subjectText "regio-knooppunten" ;
            sgpl:text_context "In het licht van deze nieuwe fase in het logistieke denkproces, kan ook het in modelvorm besproken alternatief worden gezien, waarbij het bundelen van goederenstromen op een eerder moment in de fysieke distributieketen plaatsvindt dan bij het SDC-concept het geval is. Uit de modelberekening blijkt dat dit plan van regio-knooppunten aanzienlijke kostenvoordelen kan opleveren in vergelijking met de huidige en de SDC-situatie van bevoorrading. Verder onderzoek op korte termijn is echter nodig om dit alternatief te kunnen presenteren als vervanging van, danwel aanvulling op het SDC-concept, vooral nu dit concept al een grote mate van politieke concensus geniet." ],
        [ sgpl:refersToConcept unesco:concept14074 ;
            sgpl:subjectText "Stadsdistributiecentrum" ;
            sgpl:text_context "Toch krijgen de problemen pas recentelijk enige aandacht. De discussie rond een oplossing voor deze problemen wordt momenteel voornamelijk gevoerd rond de kwantitatieve haalbaarheid van een door de overheid gekozen alternatieve bevoorradingsmethode, het Stadsdistributiecentrum. Nadat deze haalbaarheid reeds in het Kamer-rapport werd aangevochten, is dit verslag bedoeld als een kritische kanttekening en aanvulling op de kwalitatieve argumenten in de discussie." ],
        [ sgpl:refersToConcept unesco:concept8751 ;
            sgpl:subjectText "regio-knooppunten" ;
            sgpl:text_context "In het licht van deze nieuwe fase in het logistieke denkproces, kan ook het in modelvorm besproken alternatief worden gezien, waarbij het bundelen van goederenstromen op een eerder moment in de fysieke distributieketen plaatsvindt dan bij het SDC-concept het geval is. Uit de modelberekening blijkt dat dit plan van regio-knooppunten aanzienlijke kostenvoordelen kan opleveren in vergelijking met de huidige en de SDC-situatie van bevoorrading. Verder onderzoek op korte termijn is echter nodig om dit alternatief te kunnen presenteren als vervanging van, danwel aanvulling op het SDC-concept, vooral nu dit concept al een grote mate van politieke concensus geniet." ],
        [ sgpl:refersToConcept unesco:concept5888 ;
            sgpl:subjectText "binnenstedelijk goederenvervoer" ;
            sgpl:text_context "Nadat deze haalbaarheid reeds in het Kamer-rapport werd aangevochten, is dit verslag bedoeld als een kritische kanttekening en aanvulling op de kwalitatieve argumenten in de discussie. In de eerste plaats is een aantal maatschappelijke en logistieke ontwikkelingen genoemd die van invloed zijn op binnenstedelijk goederenvervoer en dus ook op een mogelijk alternatief hiervoor. Van belang hierbij is de ruimtelijke context van het onderwerp, namelijk de (binnen)stad zelf, die een eigen dynamiek vertoont." ] ;
    sgpl:thesisID 245 .

sgpl:Thesis247 a sgpl:SGPLThesis ;
    dcterms:creator "F.H. Schumacher" ;
    dcterms:issued 1992 ;
    dcterms:title "BEDRIJFSLOKATIEBELEID IN STADSGEWEST UTRECHT; een toetsing van bestaande en toekomstige lokaties aan het door de rijksoverheid gewenste bedrijfslokatiebeleid" ;
    sgpl:hasSpatialReference [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2750324 ;
            sgpl:spatialText "Gemeente Nieuwegein" ;
            sgpl:text_context "Hierbij wil ik de onderstaande personen bedanken voor de beschik- baar gestelde informatie en tijd: Gemeente Maarssen. Gemeente Nieuwegein. Gemeente Utrecht." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Doornkade" ;
            sgpl:text_context "Uit toetsing van 26 geselekteerde werkgelegenheidslokaties komen twee ca- tegorieën naar voren die beter kunnen worden afgestemd. Bij de eerste categorie (Park Voorn, Doornkade, Kosterij land, Poort van Nieuwegein en Rijnhuizen) is verbetering van het openbaar vervoer gewenst, bijvoorbeeld door het inzetten van spitsbussen naar de dichtstbijzijnde NS- stations. Voor de tweede categorie (Industriegebied-Zuid, Rembrandtlaan, Odijkerweg, Den Dolder, Fornheselaan en IJsseloever) is geleidelijke herstructurering (intensivering grondgebruik) de beste oplossing." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:spatialText "Gemeente Vleuten-De Meern" ;
            sgpl:text_context "Hierbij wil ik de onderstaande personen bedanken voor de beschik- baar gestelde informatie en tijd: Gemeente Vianen. Gemeente Vleuten-De Meern. Gemeente IJsselstein." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2749037 ;
            sgpl:spatialText "Oudenrijn" ;
            sgpl:text_context "De elf pijplijn-plannen in het stadsgewest zijn niet allemaal in overeen- stemming met het lokatiebeleid. Enkele lokaties (Hoogland, Nieuwraven en Oudenrijn) lopen het risico verkeerd ingevuld te worden indien er niet ge- zorgd wordt voor ontsluiting via hoogwaardig openbaar vervoer. Gefaseerde uitgifte is hier aan te bevelen: zolang er nog geen sneltram rijdt moet er nog geen grond worden uitgegeven voor kantoorontwikeling." ],
        [ a sgpl:SpatialMentionReference ;
            sgpl:refersToPlace geonames:2753556 ;
            sgpl:spatialText "Gemeente Houten" ;
            sgpl:text_context "Hierbij wil ik de onderstaande personen bedanken voor de beschik- baar gestelde informatie en tijd: Gemeente De Bilt. Gemeente Houten. Gemeente Maarssen." ],
        [ a sgpl:SpatialExtentReference ;
            sgpl:refersToPlace geonames:2745912 ;
            sgpl:spatialText "Stadsgewest Utrecht" ;
            sgpl:text_context "F.H. SCHUMACHER BEDRIJFSLOKATIEBELEID IN STADSGEWEST UTRECHT; een toetsing van bestaande en toekomstige iokaties aan het door de rijksoverheid gewenste bedrijfslokatiebeleid. UNIVERSITEITSBIBLIOTHEEK UTRECHT VAKGROEP TOEGEPASTI EN PLANOLOGEE." ],
