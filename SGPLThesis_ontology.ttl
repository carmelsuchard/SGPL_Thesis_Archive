@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#hasSpatialReference
:hasSpatialReference rdf:type owl:ObjectProperty ;
                     rdfs:domain :SGPLThesis ;
                     rdfs:range :SpatialReference .


###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#refersToPlace
:refersToPlace rdf:type owl:ObjectProperty ;
               rdfs:domain :SpatialReference ;
               rdfs:range schema:Place .

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#hasSubjectReference
:hasSubjectReference rdf:type owl:ObjectProperty ;
                     rdfs:domain :SGPLThesis ;
                     rdfs:range :SubjectReference .

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#refersToConcept
:refersToConcept rdf:type owl:ObjectProperty ;
               rdfs:domain :SubjectReference ;
               rdfs:range skos:Concept .

#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/issued
dcterms:issued rdfs:domain :SGPLThesis .

###  http://purl.org/dc/terms/title
dcterms:title rdfs:domain :SGPLThesis .

###  http://purl.org/dc/terms/creator
dcterms:creator rdfs:domain :SGPLThesis ;
                rdfs:range xsd:string .

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#SpatialText
:SpatialText rdf:type owl:DatatypeProperty ;
             rdfs:domain :SpatialReference ;
             rdfs:range xsd:string .

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#textContext
:textContext rdf:type owl:DatatypeProperty .

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#SubjectText
:SubjectText rdf:type owl:DatatypeProperty ;
             rdfs:domain :SubjectReference ;
             rdfs:range xsd:string .

#################################################################
#    Classes
#################################################################

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#SGPLThesis
:SGPLThesis rdf:type owl:Class ;
            rdfs:subClassOf bibo:Thesis ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty <http://purl.org/dc/terms/issued> ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:gYear
                            ] .

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#SpatialReference
:SpatialReference rdf:type owl:Class .


###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#SpatialReferenceFocus
:SpatialReferenceFocus rdf:type owl:Class ;
                      rdfs:subClassOf :SpatialReference .


###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#SpatialReferenceMention
:SpatialReferenceMention rdf:type owl:Class ;
                        rdfs:subClassOf :SpatialReference .

###  https://carmelsuchard.github.io/SGPL_Thesis_Archive/SGPLThesis_ontology#SubjectReference
:SubjectReference rdf:type owl:Class .


